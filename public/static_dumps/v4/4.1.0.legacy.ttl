<https://homosaurus.org/v4/homoit0003774> a skos:Concept;
  dc:identifier "homoit0003774";
  dc:issued "2024-10-30"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "The process of lessening or removing laws, regulations, and/or criminal penalties targeting the practice, solicitation, and/or facilitation of sex work. Decriminalization efforts may variously address the actions of sex workers, their clients, third parties, and/or other individuals who work in proximity to or seek to aid sex workers.";
  skos:altLabel "Sex work decriminalization",
    "Decriminalization of prostitution",
    "Prostitution decriminalization";
  skos:broader <https://homosaurus.org/v4/homoit0000339>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000702>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Decriminalization of sex work",
    "Decriminalisation of sex work";
  skos:related <https://homosaurus.org/v4/homoit0003772>,
    <https://homosaurus.org/v4/homoit0003773>,
    <https://homosaurus.org/v4/homoit0003775>,
    <https://homosaurus.org/v4/homoit0003776>,
    <https://homosaurus.org/v4/homoit0003777> .

<https://homosaurus.org/v4/homoit0003777> a skos:Concept;
  dc:identifier "homoit0003777";
  dc:issued "2024-10-30"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "A movement to abolish sex work through a variety of different means, including supporting \"end demand\" laws, the Nordic model, or the broader criminalization of sex work; organizing and speaking vocally against sex work as inherently exploitative; and rejecting efforts to recognize sex work as labor.";
  skos:altLabel "Abolition movement (Sex work)",
    "Sex work abolitionism",
    "Sex work abolition movement";
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0003777>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v4/homoit0003776>;
  skos:prefLabel "Sex work abolition";
  skos:related <https://homosaurus.org/v4/homoit0003773>,
    <https://homosaurus.org/v4/homoit0003774>,
    <https://homosaurus.org/v4/homoit0003765>,
    <https://homosaurus.org/v4/homoit0003775> .

