<https://homosaurus.org/v4/homoit0003507> a skos:Concept;
  dc:identifier "homoit0003507";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "A genre focusing on the romantic or sexual relationships between female characters in anime, dramas, comics, novels, and movies. The term is usually used to describe media originating from Asia.";
