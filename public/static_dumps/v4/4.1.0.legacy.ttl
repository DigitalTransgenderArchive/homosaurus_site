  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000652>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Gender equality",
    "Igualdad de género";
  skos:related <https://homosaurus.org/v4/homoit0000437>,
    <https://homosaurus.org/v4/homoit0000438> .

