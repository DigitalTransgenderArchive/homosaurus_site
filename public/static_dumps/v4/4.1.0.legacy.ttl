<https://homosaurus.org/v4/homoit0002340> a skos:Concept;
  dc:identifier "homoit0002340";
  dc:issued "2022-12-13"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Lesbians who are fathers. This includes non-binary people who have children and identify as fathers, as well as trans women who had children before transitioning and still identify as fathers to those children. Do not use to describe lesbian parents unless they self-identify as fathers.",
    "Lesbianas que son padres. Esto incluye a las personas no binarias que tienen hijos y se autoidentifican como padres, así como a las mujeres trans que tuvieron hijos antes de transicionar y aún se autoidentifican como padres de esos niños. No debe utilizarse para describir a padres lesbianos a menos que se autoidentifiquen como padres.";
  skos:altLabel "Lesbian dads",
    "Papás lesbianos";
  skos:broader <https://homosaurus.org/v4/homoit0002337>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000421>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Lesbian fathers",
    "Padres lesbianos" .

<https://homosaurus.org/v4/homoit0002341> a skos:Concept;
