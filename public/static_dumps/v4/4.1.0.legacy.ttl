<https://homosaurus.org/v4/homoit0003985> a skos:Concept;
  dc:identifier "homoit0003985";
  dc:issued "2025-04-23"^^xsd:date;
  dc:modified "2025-04-23"^^xsd:date;
  rdfs:comment "Term used to describe the ways in which human lives and experiences are expected to follow specific, linear patterns over time in conformity with normative frameworks. This includes expectations regarding how long and what hours people work, with the aim of achieving maximum productivity, as well as expectations for people to reach life milestones, such as graduating high school, getting married, and having children, at specific ages and in a particular order.";
  skos:altLabel "Normative time";
  skos:broader <https://homosaurus.org/v4/homoit0001323>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001323>;
  skos:inScheme <https://homosaurus.org/v4>;
  skos:narrower <https://homosaurus.org/v4/homoit0003988>;
  skos:prefLabel "Chrononormativity";
  skos:related <https://homosaurus.org/v4/homoit0003986>,
    <https://homosaurus.org/v4/homoit0003987> .

<https://homosaurus.org/v4/homoit0003989> a skos:Concept;
  dc:identifier "homoit0003989";
  dc:issued "2025-04-23"^^xsd:date;
  dc:modified "2025-04-23"^^xsd:date;
  rdfs:comment "Term coined by Adrienne Rich in 1980 to describe the idea that heterosexuality is assumed of and enforced upon people in patriarchal societies to ensure the continued subjugation of women. Thus, heterosexuality and, particularly, women's sexual interest in men, is not always natural but instead is ingrained as a social requirement from an early age.";
  skos:altLabel "Comphet";
  skos:broader <https://homosaurus.org/v4/homoit0001323>,
    <https://homosaurus.org/v4/homoit0001365>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001323>;
  skos:inScheme <https://homosaurus.org/v4>;
  skos:prefLabel "Compulsory heterosexuality";
  skos:related <https://homosaurus.org/v4/homoit0000619>,
    <https://homosaurus.org/v4/homoit0000620> .

<https://homosaurus.org/v4/homoit0003999> a skos:Concept;
  dc:identifier "homoit0003999";
  dc:issued "2025-04-23"^^xsd:date;
  dc:modified "2025-04-23"^^xsd:date;
  rdfs:comment "Umbrella term for the depiction of Two-Spirit people and communities in different forms of creative activity and cultural production, including literature, visual art, and popular media. Use more specific terms if possible.";
