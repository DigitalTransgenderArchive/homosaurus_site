<https://homosaurus.org/v4/homoit0003655> a skos:Concept;
  dc:identifier "homoit0003655";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-04-17"^^xsd:date;
  rdfs:comment "The recognition and celebration of transgender people and culture, thereby affirming the visibility, dignity, and diversity of transgender communities.";
  skos:altLabel "Trans pride";
  skos:broader <https://homosaurus.org/v4/homoit0003653>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0003653>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Transgender pride" .

<https://homosaurus.org/v4/homoit0003658> a skos:Concept;
  dc:identifier "homoit0003658";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Social, psychological, behavioral, and medical interventions designed to support and affirm individuals belonging to the intersex community. Intersex-affirming care includes but is not limited to equal access to health care facilities, access to medical records and information about one's intersex status and traits, and informed consent regarding medical procedures or treatments related to intersex traits.";
  skos:altLabel "Intersex affirming care";
  skos:broader <https://homosaurus.org/v4/homoit0003657>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000614>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Intersex-affirming care" .

<https://homosaurus.org/v4/homoit0003659> a skos:Concept;
  dc:identifier "homoit0003659";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Social, psychological, behavioral, and medical interventions designed to support and affirm a transgender individual's gender identity. Transgender-affirming care includes but is not limited to equal access to health care facilities, counseling, puberty blockers, hormone therapy, and gender-affirming surgeries. It can also include resources to aid in social transition, such as affirming policies regarding name and pronoun changes, access to non-gendered restrooms and facilities, etc.";
  skos:altLabel "Trans-affirming care",
    "Transgender affirming care",
    "Trans affirming care";
  skos:broader <https://homosaurus.org/v4/homoit0003657>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000614>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Transgender-affirming care" .

