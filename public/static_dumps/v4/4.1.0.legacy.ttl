  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Butch-femme relationships",
    "Relaciones marimacha-femme";
  skos:related <https://homosaurus.org/v4/homoit0000231>,
    <https://homosaurus.org/v4/homoit0000440>,
    <https://homosaurus.org/v4/homoit0001241>,
    <https://homosaurus.org/v4/homoit0001295>,
    <https://homosaurus.org/v4/homoit0001340> .

<https://homosaurus.org/v4/homoit0000254> a skos:Concept;
  dc:identifier "homoit0000254";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/childCustody>;
  rdfs:comment "Legal term for the guardianship of a child, or the legal and practical relationship between a parent and a child in their care. Typically used to describe legal custody, which is the right to make decisions about the child, as well as physical custody, which is the right and duty to house, provide, and care for the child.",
    "Término legal para la tutela de un niño, o la relación legal y práctica entre un padre y un niño bajo su cuidado. Normalmente se utiliza para describir la custodia legal, que es el derecho a tomar decisiones sobre el niño, así como la custodia física, que es el derecho y el deber de albergar, proveer y cuidar del niño.";
  skos:altLabel "Guardianship",
    "Parental custody",
    "Tutelage",
    "Tutela",
    "Custodia parental";
  skos:changeNote "Version 4.1.0";
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85034952>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000254>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Child custody",
    "Custodia de niños";
  skos:related <https://homosaurus.org/v4/homoit0000255>,
    <https://homosaurus.org/v4/homoit0000809>,
    <https://homosaurus.org/v4/homoit0000854>,
    <https://homosaurus.org/v4/homoit0000870>,
