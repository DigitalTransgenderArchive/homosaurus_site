<https://homosaurus.org/v4/homoit0001756> a skos:Concept;
  dc:identifier "homoit0001756";
  dc:issued "2021-11-23"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Term used to describe people, typically children, who do not conform to traditional gender norms and instead creatively interweave their internal and external experiences to understand their gender identity and expression. May also be used to describe a way of raising children outside of traditional gender norms.",
    "Término utilizado para describir a personas, generalmente niños, que no se ajustan a las normas de género tradicionales y, en cambio, entrelazan creativamente sus experiencias internas y externas para comprender su identidad y expresión de género. También puede utilizarse para describir una forma de criar a los niños fuera de las normas tradicionales de género.";
  skos:broader <https://homosaurus.org/v4/homoit0000568>,
    <https://homosaurus.org/v4/homoit0000571>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000560>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Gender creative",
    "Género creativo";
  skos:related <https://homosaurus.org/v4/homoit0000047>,
    <https://homosaurus.org/v4/homoit0000256>,
    <https://homosaurus.org/v4/homoit0000562>,
    <https://homosaurus.org/v4/homoit0000574>,
    <https://homosaurus.org/v4/homoit0000577>,
    <https://homosaurus.org/v4/homoit0001521>,
    <https://homosaurus.org/v4/homoit0001922>,
    <https://homosaurus.org/v4/homoit0002222> .

