  skos:prefLabel "Transgender health care bans";
  skos:related <https://homosaurus.org/v4/homoit0000561>,
    <https://homosaurus.org/v4/homoit0000614> .

<https://homosaurus.org/v4/homoit0003505> a skos:Concept;
  dc:identifier "homoit0003505";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "A slang term to describe a gathering of friends for the purpose of chatting and gossiping. The term evolved out of the 1990s ballroom scene in New York City and was further popularized by the 2012 song \"Let's Have a Kiki\" by the Scissor Sisters. Do not conflate with the term \"Ky-ky (Gender role),\" sometimes also spelled \"Kiki,\" which refers to lesbians who do not identify as either butches or femmes.";
  skos:altLabel "Kikiing (Social gathering)",
    "Kiking (Social gathering)";
  skos:broader <https://homosaurus.org/v4/homoit0001317>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001317>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Kiki (Social Gathering)";
  skos:related <https://homosaurus.org/v4/homoit0000092>,
    <https://homosaurus.org/v4/homoit0000455> .

<https://homosaurus.org/v4/homoit0003506> a skos:Concept;
  dc:identifier "homoit0003506";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "A slang term that emerged in the 1940s to describe lesbians who do not identify as butch or femme. Do not conflate with the term \"Kiki (Social gathering), which refers to a gathering of friends.";
  skos:altLabel "Kiki (Gender role)",
    "Kyky (Gender role)";
  skos:broader <https://homosaurus.org/v4/homoit0000577>,
    <https://homosaurus.org/v4/homoit0001295>,
    <https://homosaurus.org/v4/homoit0001304>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001241>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Ky-ky (Gender role)" .

<https://homosaurus.org/v4/homoit0003509> a skos:Concept;
