<https://homosaurus.org/v4/homoit0002374> a skos:Concept;
  dc:identifier "homoit0002374";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "A practice in which law enforcement agents or agents of the state coerce an LGBTQ+ person to commit a \"crime\" they would have otherwise been unlikely or unwilling to commit. Legal definitions of entrapment vary widely depending on the jurisdiction, but the term is often used colloquially to refer to police acting dishonestly or in bad faith, as well as policing focused on anticipating and inducing crime, rather than responding to reports of crime.",
    "Práctica mediante la cual la policía induce a personas LGBTQ+ a cometer acciones consideradas delitos que de otro modo no se habrían cometido o que era poco probable que se hubieran cometido.";
  skos:altLabel "Atrapamiento policial de personas LGBTQ+";
  skos:broader <https://homosaurus.org/v4/homoit0001120>,
    <https://homosaurus.org/v4/homoit0002373>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000611>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Police entrapment of LGBTQ+ people",
    "Aprisionamiento policial de personas LGBTQ+" .

<https://homosaurus.org/v4/homoit0002380> a skos:Concept;
  dc:identifier "homoit0002380";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2026-02-11"^^xsd:date;
  rdfs:comment "Criminalization of acts considered to be sexual or romantic between individuals perceived as being of the same gender category in a given sociocultural context.",
    "La criminalización de actos considerados sexuales o románticos entre personas percibidas como de la misma categoría de género en un determinado contexto sociocultural.";
  skos:altLabel "Criminalization of same-gender relations",
    "Criminalization of same-sex relations",
    "Criminalización de las relación del mismo género",
    "Criminalización de las relación del mismo sexo";
  skos:broader <https://homosaurus.org/v4/homoit0002379>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000702>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Criminalization of homosexuality",
    "Criminalización de la homosexualidad";
  skos:related <https://homosaurus.org/v4/homoit0001326> .

<https://homosaurus.org/v4/homoit0002382> a skos:Concept;
  dc:identifier "homoit0002382";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Unexpected and unannounced entry into and searches of bathouses, saunas, or spas owned or frequented by LGBTQ+ people by law enforcement officers with the aim of using surprise to seize evidence or arrest suspects. Police raids may be undertaken legally using a search warrant or through exigent circumstances, such as probable cause, though the latter is highly subjective and civilians often have little resources to appeal illegal raids.",
    "Redadas policiales en baños, saunas, spas, etc. afiliados o relacionados con comunidades o identidades LGBTQ+.";
  skos:altLabel "Redadas policiales en casas de baño LGBTQ+";
  skos:broader <https://homosaurus.org/v4/homoit0002381>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000611>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Police raids on LGBTQ+ bathhouses",
    "Redadas policiales en saunas LGBTQ+";
  skos:related <https://homosaurus.org/v4/homoit0000475> .

<https://homosaurus.org/v4/homoit0002384> a skos:Concept;
  dc:identifier "homoit0002384";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Unexpected and unannounced entry into and searches of drinking establishments owned or frequented by LGBTQ+ people by law enforcement officers with the aim of using surprise to seize evidence or arrest suspects. Police raids may be undertaken legally using a search warrant or through exigent circumstances, such as probable cause, though the latter is highly subjective and civilians often have little resources to appeal illegal raids.",
    "Redadas policiales en bares afiliados o relacionados con comunidades e identidades LGBTQ+.";
  skos:broader <https://homosaurus.org/v4/homoit0002381>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000611>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Police raids on LGBTQ+ bars",
    "Redadas policiales en bares LGBTQ+";
  skos:related <https://homosaurus.org/v4/homoit0000100> .

<https://homosaurus.org/v4/homoit0002385> a skos:Concept;
  dc:identifier "homoit0002385";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Unexpected and unannounced entry into and searches of nightclubs owned or frequented by LGBTQ+ people by law enforcement officers with the aim of using surprise to seize evidence or arrest suspects. Police raids may be undertaken legally using a search warrant or through exigent circumstances, such as probable cause, though the latter is highly subjective and civilians often have little resources to appeal illegal raids.",
    "Redadas policiales en clubes nocturnos afiliados o relacionados con comunidades o identidades LGBTQ+";
  skos:broader <https://homosaurus.org/v4/homoit0002381>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000611>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Police raids on LGBTQ+ nightclubs",
    """Redadas policiales en clubs LGBTQ+|| 
Redadas policiales en clubes nocturnos LGBTQ+""";
  skos:related <https://homosaurus.org/v4/homoit0000909> .

