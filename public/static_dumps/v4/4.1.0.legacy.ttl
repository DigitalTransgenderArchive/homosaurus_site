<https://homosaurus.org/v4/homoit0000607> a skos:Concept;
  dc:identifier "homoit0000607";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/halloween>;
  rdfs:comment "The celebration of Halloween, often called Gay Christmas, by LGBTQ+ people. Typically involves dressing in drag or elaborate costumes as a form of gender play and attending large parties in LGBTQ+ neighborhoods or establishments.",
    "La celebración de Halloween, a menudo llamada Navidad Gay, por personas LGBTQ+. Por lo general, implica vestirse en drag o disfraces elaborados como forma de jugar con el género y asistir a grandes fiestas en vecindarios o establecimientos LGBTQ+.";
  skos:altLabel "Gay Christmas",
    "Gay Halloween",
    "Navidad gay",
    "Halloween gay";
  skos:broader <https://homosaurus.org/v4/homoit0000861>;
  skos:changeNote "Version 4.1.0";
  skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85058475>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000861>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Halloween (LGBTQ+ culture)",
    "Halloween (Cultura LGBTQ+)";
  skos:related <https://homosaurus.org/v4/homoit0001808> .

<https://homosaurus.org/v4/homoit0000624> a skos:Concept;
  dc:identifier "homoit0000624";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/heterosexualIdentity>;
  rdfs:comment "Term used to describe the sexual identity of individuals who are romantically and/or sexually attracted to people assigned the “opposite” sex at birth.",
    "Término utilizado para describir la identidad sexual de las personas que se sienten atraídas romántica y/o sexualmente por personas asignadas al sexo “opuesto” al nacer.";
  skos:broader <https://homosaurus.org/v4/homoit0001295>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001295>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Heterosexual identity",
    "Identidad heterosexual";
  skos:related <https://homosaurus.org/v4/homoit0000627> .

<https://homosaurus.org/v4/homoit0000628> a skos:Concept;
  dc:identifier "homoit0000628";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/heterosociality>;
  rdfs:comment "In sociology, this term is used to describe social relations and bonds between members of the opposite sex or gender in a given culture. Typically excludes romantic and sexual relationships.",
    "En la sociología, este término se utiliza para describir las relaciones sociales y los vínculos entre miembros del sexo o género opuesto en una cultura determinada. Normalmente excluye las relaciones románticas y sexuales.";
  skos:altLabel "Heterosexual social relationships",
    "Heterosocial bonds",
    "Relaciones sociales heterosexuales",
    "Vínculos heterosociales";
  skos:broader <https://homosaurus.org/v4/homoit0001237>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001237>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Heterosociality",
    "Heterosocialidad";
  skos:related <https://homosaurus.org/v4/homoit0000649> .

<https://homosaurus.org/v4/homoit0000634> a skos:Concept;
  dc:identifier "homoit0000634";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/HIVTests>;
  rdfs:comment "Medical tests used to determine the presence of HIV antibodies or antigens in an individual's blood, saliva, or urine.",
    "Pruebas médicas utilizadas para determinar la presencia de anticuerpos o antígenos del VIH en la sangre, la saliva o la orina de una persona.";
  skos:altLabel "Exámenes de VIH";
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000634>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "HIV tests",
    "Pruebas de VIH";
  skos:related <https://homosaurus.org/v4/homoit0000005> .

<https://homosaurus.org/v4/homoit0000637> a skos:Concept;
  dc:identifier "homoit0000637";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/seroconversion>;
  rdfs:comment "Term used to describe the period of time between exposure to a virus and when antibodies for the virus are detectable; often used in reference to HIV testing when a test changes from HIV negative to HIV positive.",
    "Término utilizado para describir el período de tiempo entre la exposición a un virus y el momento en que los anticuerpos contra el virus son detectables; a menudo se utiliza en referencia a la prueba del VIH cuando una prueba cambia de VIH negativa a VIH positiva.";
  skos:altLabel "HIV-seroconversion",
    "Seroconversión-VIH";
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000637>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Seroconversion",
    "Seroconversión";
  skos:related <https://homosaurus.org/v4/homoit0000005> .

