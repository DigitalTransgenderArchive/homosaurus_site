<https://homosaurus.org/v4/homoit0002591> a skos:Concept;
  dc:identifier "homoit0002591";
  dc:issued "2023-04-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "The phenomenon in which lesbians internalize or adopt lesbophobic beliefs (i.e., negative perceptions of and intolerance toward lesbians and lesbianism) as a result of being raised or socialized within a lesbophobic environment or culture.",
    "El fenómeno a través del cual las lesbianas internalizan o adoptan creencias lesbofóbicas (es decir, percepciones negativas e intolerancia hacia las lesbianas y el lesbianismo) como resultado de haber sido criadas o socializadas dentro de un entorno o una cultura lesbofóbica.";
  skos:broader <https://homosaurus.org/v4/homoit0000803>,
    <https://homosaurus.org/v4/homoit0002590>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000920>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v4/homoit0003092>;
  skos:prefLabel "Internalized lesbophobia",
    "Lesbofobia internalizada" .

