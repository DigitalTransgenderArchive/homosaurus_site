  skos:hasTopConcept <https://homosaurus.org/v4/homoit0002619>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v4/homoit0002618>;
  skos:prefLabel "Assisted reproductive technology ",
    "Tecnología de reproducción asistida" .

