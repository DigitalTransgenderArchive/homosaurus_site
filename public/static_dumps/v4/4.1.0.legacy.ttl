  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Queer joy",
    "Alegría queer";
  skos:related <https://homosaurus.org/v4/homoit0001170>,
    <https://homosaurus.org/v4/homoit0002256>,
    <https://homosaurus.org/v4/homoit0003708> .

