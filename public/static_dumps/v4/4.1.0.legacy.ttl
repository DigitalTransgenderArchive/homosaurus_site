<https://homosaurus.org/v4/homoit0003769> a skos:Concept;
  dc:identifier "homoit0003769";
  dc:issued "2024-10-30"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Short for \"webcam models,\" this term refers to sex workers who exchange sexual services, performances, or companionship via online video calls and livestreams. ";
