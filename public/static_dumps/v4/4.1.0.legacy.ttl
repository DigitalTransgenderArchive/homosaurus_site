  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Efforts to change the gender identity of a transgender or non-binary person to meet cisgender norms, typically under the belief that their identity is dangerous and/or the result of mental illness or trauma. The processes involved in conversion therapy include visualization training, spiritual interventions, and other aversion treatments. ";
  skos:altLabel "Conversion therapy for gender",
    "Conversion therapy for trans people",
    "Conversion therapy for transgender people",
    "Gender reorientation therapy",
    "Trans conversion therapy",
    "Transgender conversion therapy";
  skos:broader <https://homosaurus.org/v4/homoit0000303>;
  skos:changeNote "Version 4.1.0";
  skos:closeMatch <http://id.loc.gov/authorities/subjects/sh2006004076>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001004>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Gender conversion therapy" .

