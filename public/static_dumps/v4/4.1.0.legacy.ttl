<https://homosaurus.org/v4/homoit0001813> a skos:Concept;
  dc:identifier "homoit0001813";
  dc:issued "2022-01-24"^^xsd:date;
  dc:modified "2026-02-23"^^xsd:date;
  rdfs:comment "Special collections that hold materials primarily pertaining to LGBTQ+ people or intended for use by LGBTQ+ people. Special collections tend to be a blend of institutional types (e.g., an archives with a museum component). This term should be applied to institutions that refer to themselves as special collections; otherwise, use the term \"LGBTQ+ cultural heritage institutions.\"",
    "Colecciones especiales que contienen materiales principalmente relacionados con personas LGBTQ+ o destinados a ser utilizados por personas LGBTQ+. Las colecciones especiales tienden a ser una combinación de tipos institucionales (por ejemplo, archivos con un componente de museo). Este término debe aplicarse a instituciones que se refieran a sí mismas como colecciones especiales; de lo contrario, utilícese el término \"instituciones de patrimonio cultural LGBTQ+\".";
  skos:altLabel "Hidden collections (LGBTQ)",
    "LGBTQ+ hidden collections",
    "Special collections (LGBTQ)",
    "Colecciones especiales LGBTQ",
    "Colecciones especiales (LGBTQ)",
    "Colecciones ocultas (LGBTQ)";
  skos:broader <https://homosaurus.org/v4/homoit0001755>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001755>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "LGBTQ+ special collections",
    "Colecciones especiales LGBTQ+";
  skos:related <https://homosaurus.org/v4/homoit0000968>,
    <https://homosaurus.org/v4/homoit0001030>,
    <https://homosaurus.org/v4/homoit0001363>,
    <https://homosaurus.org/v4/homoit0003547> .

