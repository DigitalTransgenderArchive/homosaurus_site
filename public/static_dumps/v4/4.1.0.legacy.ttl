<https://homosaurus.org/v4/homoit0003503> a skos:Concept;
  dc:identifier "homoit0003503";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2025-03-20"^^xsd:date;
  rdfs:comment "Laws or policies instituted to prevent trans and non-binary people from changing the gender marker on their birth certificate, driver's license, passport, or other legal documents.";
