    <https://homosaurus.org/v4/homoit0001285>,
    <https://homosaurus.org/v4/homoit0001305> .

<https://homosaurus.org/v4/homoit0003445> a skos:Concept;
  dc:identifier "homoit0003445";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "A term used to describe the phenomena of heterosexual or hetero-presenting individuals expressing curiosity about exploring sexual relationships or experiences with other people of the same gender.";
  skos:altLabel "Bi-curiosity",
    "Bi-curious",
    "Bicurious";
  skos:broader <https://homosaurus.org/v4/homoit0000204>;
