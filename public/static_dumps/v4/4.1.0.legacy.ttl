<https://homosaurus.org/v4/homoit0001115> a skos:Concept;
  dc:identifier "homoit0001115";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-03-20"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/pinching>;
  rdfs:comment "Form of manual stimulation involving gripping, pulling, or putting tension on parts of one’s body or another person's body for sexual stimulation, arousal, or pleasure.",
