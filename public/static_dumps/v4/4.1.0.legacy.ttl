<https://homosaurus.org/v4/homoit0001974> a skos:Concept;
  dc:identifier "homoit0001974";
  dc:issued "2022-05-11"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Lesbians who belong to one or more of the various Indigenous peoples of Australia; do not use to refer to the Indigenous people of the Torres Strait Islands, who are considered ethnically and culturally distinct. Only use to describe people who identify as Aboriginal Australian.",
    "Lesbianas que pertenecen a uno o más de los diversos pueblos indígenas de Australia; no para referirse a los pueblos indígenas de las Islas del Estrecho de Torres, que se consideran étnica y culturalmente distintos. Utilícese únicamente para describir a las personas que se autoidentifiquen como aborígenes australianos.";
  skos:altLabel "Aboriginal lesbians",
    "Lesbian aboriginal Australians",
    "Lesbianas aborígenes australianas",
    "Aborígenes australianas lesbianas";
  skos:broader <https://homosaurus.org/v4/homoit0000002>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000915>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Aboriginal Australian lesbians",
    "Lesbianas aborígenes australianas" .

