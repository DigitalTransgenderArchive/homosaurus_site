  dc:replaces <http://homosaurus.org/v2/tom>;
  rdfs:comment "In Thailand, this term is used to describe people assigned female at birth who exhibit masculine traits, often partnering with feminine dees; similar to a butch in U.S. lesbian culture.",
    "En Tailandia, este término se utiliza para describir a las personas asignadas al sexo femenino al nacer y que exhiben rasgos masculinos, a menudo, emparejándose con dees femeninos; similar a una marimacha en la cultura lésbica estadounidense.";
  skos:broader <https://homosaurus.org/v4/homoit0000322>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000560>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Tom";
  skos:related <https://homosaurus.org/v4/homoit0000340>,
    <https://homosaurus.org/v4/homoit0000687> .

<https://homosaurus.org/v4/homoit0001377> a skos:Concept;
  dc:identifier "homoit0001377";
