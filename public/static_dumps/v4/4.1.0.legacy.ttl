  skos:related <https://homosaurus.org/v4/homoit0003768> .

<https://homosaurus.org/v4/homoit0003775> a skos:Concept;
  dc:identifier "homoit0003775";
  dc:issued "2024-10-30"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "The creation of a set of laws and regulations intended to legalize the practice and solicitation of sex work, particularly street sex work and other forms of \"direct,\" visible sex work, within certain parameters. This may variously include legalizing the actions of sex workers, their clients, third parties, and/or other individuals who work in proximity to or seek to aid sex workers. Individuals operating outside of these laws and regulations remain subject to penalties.";
  skos:altLabel "Sex work legalization",
    "Legalization of prostitution",
    "Prostitution legalization";
  skos:broader <https://homosaurus.org/v4/homoit0003772>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000702>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Legalization of sex work",
    "Legalisation of sex work";
  skos:related <https://homosaurus.org/v4/homoit0003774>,
    <https://homosaurus.org/v4/homoit0003773>,
    <https://homosaurus.org/v4/homoit0003777> .

<https://homosaurus.org/v4/homoit0003776> a skos:Concept;
  dc:identifier "homoit0003776";
  dc:issued "2024-10-30"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "A legislative approach to sex work first instituted in Sweden in 1999 and then in Norway in 2009 that centers on the criminalization of clients, third parties, and many of the ways sex workers operate. The Nordic model is a form of sex work abolition predicated on the idea that no person can consent to engage in commercial sexual services and that sex workers must therefore be educated and reformed. Sex workers and activists have heavily criticized and opposed the Nordic model.";
  skos:altLabel "End demand (Sex work)",
    "Equality model (Sex work)",
    "Neo-abolition movement (Sex work)",
    "Nordic and Swedish model (Sex work)",
    "Swedish model (Sex work)";
  skos:broader <https://homosaurus.org/v4/homoit0003772>,
    <https://homosaurus.org/v4/homoit0003777>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000702>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Nordic model (Sex work)";
  skos:related <https://homosaurus.org/v4/homoit0003773>,
    <https://homosaurus.org/v4/homoit0003774> .

<https://homosaurus.org/v4/homoit0003779> a skos:Concept;
