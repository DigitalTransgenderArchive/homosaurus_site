  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000011>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Street sex work" .

<https://homosaurus.org/v4/homoit0003781> a skos:Concept;
  dc:identifier "homoit0003781";
  dc:issued "2024-10-30"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "A form of sex work performed in lieu of other employment or in order to meet immediate needs, such as shelter, food, clothing, familial care, etc. Use only for sex work that is self-described as survival.";
  skos:altLabel "Survival prostitution";
  skos:broader <https://homosaurus.org/v4/homoit0001276>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000011>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Survival sex work" .

<https://homosaurus.org/v4/homoit0003783> a skos:Concept;
  dc:identifier "homoit0003783";
  dc:issued "2024-10-30"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "People who mediate between sex workers and clients. This term has historically been used to describe women but can be used for individuals of any gender based on their preference. Follow the individual's preference for \"Madams,\" \"Pimps,\" or \"Sex work concierges\" whenever possible.";
  skos:altLabel "Procuresses";
  skos:broader <https://homosaurus.org/v4/homoit0003782>;
  skos:changeNote "Version 4.1.0";
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85107177>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0003782>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Madams (Sex work)" .

<https://homosaurus.org/v4/homoit0003784> a skos:Concept;
  dc:identifier "homoit0003784";
  dc:issued "2024-10-30"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "People who mediate between sex workers and clients. Since the 20th century, this term has been used as a derogatory way of describing urban, working-class Black American men, regardless of their involvement in the facilitation of sex work. While some Black Americans--including women--have embraced an evolved version of the word \"pimp,\" often stripped of its association with sex work facilitation, it still carries racist and classist connotations and should be used with caution. Follow the individual's preference for \"Pimps,\" \"Madams,\" or \"Sex work concierges\" whenever possible.";
  skos:altLabel "Procurers";
  skos:broader <https://homosaurus.org/v4/homoit0003782>;
  skos:changeNote "Version 4.1.0";
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85102185>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0003782>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Pimps" .

<https://homosaurus.org/v4/homoit0003785> a skos:Concept;
  dc:identifier "homoit0003785";
  dc:issued "2024-10-30"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "People who mediate between sex workers and clients. Follow the individual's preference for \"Sex work concierges,\" \"Pimps,\" or \"Madams\" whenever possible.";
  skos:broader <https://homosaurus.org/v4/homoit0003782>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0003782>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Sex work concierges" .

<https://homosaurus.org/v4/homoit0003797> a skos:Concept;
  dc:identifier "homoit0003797";
  dc:issued "2024-10-30"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "LGBTQ+ sex workers who undress to music while using a pole to perform dance moves, whether in a venue like a strip club or by hire at private parties. For stripping performed by amateurs in private settings, use \"Stripping.\"";
  skos:altLabel "Strippers (LGBTQ)",
    "LGBTQ+ stripteasers",
    "Stripteasers (LGBTQ)",
    "LGBTQ+ pole dancers",
    "Pole dancers (LGBTQ)",
    "LGBTQ+ peelers",
    "Peelers (LGBTQ)",
    "LGBTQ+ exotic dancers",
    "Exotic dancers (LGBTQ)";
  skos:broader <https://homosaurus.org/v4/homoit0001277>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0003758>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "LGBTQ+ strippers" .

<https://homosaurus.org/v4/homoit0003800> a skos:Concept;
  dc:identifier "homoit0003800";
  dc:issued "2024-10-30"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Partitioned car garages found in a few countries in Europe that are designed to allow and facilitate sex work in cars. Sex drive-ins are often created by local authorities to help regulate where sex work occurs.";
  skos:altLabel "Sex boxes";
  skos:broader <https://homosaurus.org/v4/homoit0003799>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000011>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Sex drive-ins" .

