<https://homosaurus.org/v4/homoit0002273> a skos:Concept;
  dc:identifier "homoit0002273";
  dc:issued "2022-11-08"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Acronym used to refer to queer and trans people of color as a group. Typically used to acknowledge the particularities of queer and trans people of color's experiences and the intersections of queerphobia, transphobia, and racism as directed towards queer and trans people of color.",
    "Acrónimo utilizado para referirse a personas de color queer y trans como grupo. Normalmente se utiliza para reconocer las particularidades de las experiencias de las personas queer y trans de color y las intersecciones de la queerfobia, la transfobia y el racismo dirigidas hacia las personas queer y trans de color.";
  skos:altLabel "Queer and trans people of color",
    "Personas queer y trans de color";
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0002273>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "QTPOC";
  skos:related <https://homosaurus.org/v4/homoit0001892>,
    <https://homosaurus.org/v4/homoit0001928>,
    <https://homosaurus.org/v4/homoit0001101> .

<https://homosaurus.org/v4/homoit0002274> a skos:Concept;
