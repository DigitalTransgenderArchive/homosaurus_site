<https://homosaurus.org/v4/homoit0002590> a skos:Concept;
  dc:identifier "homoit0002590";
  dc:issued "2023-04-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "The phenomenon in which someone in a marginalized group internalizes or adopts oppressive beliefs (i.e., negative perceptions of and intolerance toward any marginalized identities they hold) as a result of being raised or socialized within an oppressive environment or culture.",
    "El fenómeno a través del cual una persona de un grupo marginado internaliza o adopta creencias opresivas (es decir, percepciones negativas e intolerancia hacia cualquier identidad marginada que habite) como resultado de haber sido criada o socializada dentro de un entorno o una cultura opresiva.";
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0002590>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v4/homoit0000391>,
    <https://homosaurus.org/v4/homoit0002591>,
    <https://homosaurus.org/v4/homoit0002592>,
    <https://homosaurus.org/v4/homoit0002593>,
    <https://homosaurus.org/v4/homoit0002594>,
    <https://homosaurus.org/v4/homoit0002595>;
  skos:prefLabel "Internalized oppression",
    "Opresión internalizada";
  skos:related <https://homosaurus.org/v4/homoit0000345>,
    <https://homosaurus.org/v4/homoit0000920>,
    <https://homosaurus.org/v4/homoit0000936>,
    <https://homosaurus.org/v4/homoit0003091> .

