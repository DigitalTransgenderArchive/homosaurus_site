  skos:related <https://homosaurus.org/v4/homoit0000632> .

<https://homosaurus.org/v4/homoit0000685> a skos:Concept;
  dc:identifier "homoit0000685";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/kabuki>;
  rdfs:comment "A form of theatre in Japan that often features crossdressing actors. Historically, female performers played both male and female roles, but women were later banned from performing and were replaced with male performers who played both male and female roles.",
    "Un tipo de teatro en Japón donde a menudo figuran actores transformistas. Históricamente, actrices asumían los roles masculinos y femeninos, pero eventualmente se le prohibió a las mujeres presentarse en el escenario y fueron reemplazadas por actores que asumían los roles masculinos y femeninos.";
  skos:broader <https://homosaurus.org/v4/homoit0001363>;
  skos:changeNote "Version 4.1.0";
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85071224>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001363>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Kabuki";
  skos:related <https://homosaurus.org/v4/homoit0000318> .

<https://homosaurus.org/v4/homoit0000688> a skos:Concept;
  dc:identifier "homoit0000688";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/khusra>;
  rdfs:comment "A term used in Pakistan and Northern India to describe third-gender people, typically people assigned male at birth who identify as female.",
    "Término utilizado en Pakistán y el norte de la India para describir a personas del tercer género, normalmente personas asignadas al sexo masculino al nacer y que se autoidentifican como mujeres.";
  skos:broader <https://homosaurus.org/v4/homoit0000322>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000560>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Khusra";
  skos:related <https://homosaurus.org/v4/homoit0000632> .

<https://homosaurus.org/v4/homoit0000690> a skos:Concept;
  dc:identifier "homoit0000690";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/kinnar>;
  rdfs:comment "A variant term for hijra used in northern India.",
    "Variante del término \"hijra\" utilizado en el norte de India.";
  skos:broader <https://homosaurus.org/v4/homoit0000322>;
