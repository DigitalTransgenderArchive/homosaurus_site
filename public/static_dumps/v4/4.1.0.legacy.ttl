  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v4/homoit0000372>,
    <https://homosaurus.org/v4/homoit0000374>;
  skos:prefLabel "Drag families",
    "Familias drag";
  skos:related <https://homosaurus.org/v4/homoit0000094>,
    <https://homosaurus.org/v4/homoit0000373>,
    <https://homosaurus.org/v4/homoit0000375> .

