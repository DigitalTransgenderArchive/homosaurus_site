    "Sex wars",
    "Guerras del porno",
    "Guerra del sexo";
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0003121>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Feminist sex wars",
    "Guerras del Sexo" .

