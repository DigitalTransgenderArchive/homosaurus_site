<https://homosaurus.org/v4/homoit0001240> a skos:Concept;
  dc:identifier "homoit0001240";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/ritualHomosexuality>;
  rdfs:comment "Non-reciprocal genital contact, typically fellatio, between younger and older men that takes place during initiation rituals practiced by the Sambari people of Papua New Guinea. This term was developed by Western outsiders and has been strongly criticized by the affected community.",
    "Contacto genital no recíproco, típicamente felación, entre hombres jóvenes y mayores que ocurre durante los rituales de iniciación practicados por el pueblo simbari de Papúa Nueva Guinea. Este término fue desarrollado por extranjeros occidentales y ha sido fuertemente criticado por la comunidad afectada.";
  skos:broader <https://homosaurus.org/v4/homoit0000647>,
    <https://homosaurus.org/v4/homoit0001299>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001298>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Ritual homosexuality",
    "Homosexualidad ritual";
  skos:related <https://homosaurus.org/v4/homoit0000886> .

