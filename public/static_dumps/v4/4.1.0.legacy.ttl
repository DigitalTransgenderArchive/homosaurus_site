<https://homosaurus.org/v4/homoit0001090> a skos:Concept;
  dc:identifier "homoit0001090";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/passingGender>;
  rdfs:comment "An individual's ability to \"pass,\" or be accepted or regarded as a member of the gender they identify with. \"Passing\" has historically been used to describe an individual's ability to \"pass\" as a certain race or ethnicity, though the term was later appropriated by the LGBTQ+ community.",
    "La capacidad de una persona para \"pasar\", ser aceptada o considerada como miembro del género con el que se identifica. \"Pasar\" se ha utilizado históricamente para describir la capacidad de una persona de \"pasar\" como una determinada raza o etnia, aunque eventualmente la comunidad LGBTQ+ se apropió del término.";
  skos:altLabel "Pasando",
    "Pasar desapercibido";
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001090>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Passing (Gender)",
    "Passing (género)";
  skos:related <https://homosaurus.org/v4/homoit0000288>,
    <https://homosaurus.org/v4/homoit0000316>,
    <https://homosaurus.org/v4/homoit0000560>,
    <https://homosaurus.org/v4/homoit0001140>,
    <https://homosaurus.org/v4/homoit0001233>,
    <https://homosaurus.org/v4/homoit0001378>,
    <https://homosaurus.org/v4/homoit0001781>,
    <https://homosaurus.org/v4/homoit0001901> .

<https://homosaurus.org/v4/homoit0001251> a skos:Concept;
