    <https://homosaurus.org/v4/homoit0001278> .

<https://homosaurus.org/v4/homoit0003593> a skos:Concept;
  dc:identifier "homoit0003593";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Organized efforts to secure reproductive rights, including the legal, social, and ethical principles of freedom around reproductive healthcare and decision-making.";
