<https://homosaurus.org/v4/homoit0003001> a skos:Concept;
  dc:identifier "homoit0003001";
  dc:issued "2023-10-27"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Demisexual people whose brains process, learn, and/or behave differently from what is considered typical by society. Some of these neurological differences can present as learning disabilities, medical disorders, and other conditions.",
