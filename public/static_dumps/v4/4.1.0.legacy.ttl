  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000614>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Health care for transgender children and youth";
  skos:related <https://homosaurus.org/v4/homoit0001400>,
    <https://homosaurus.org/v4/homoit0001452>,
    <https://homosaurus.org/v4/homoit0003502> .

<https://homosaurus.org/v4/homoit0003519> a skos:Concept;
  dc:identifier "homoit0003519";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "A cultural system in which positions of dominance and privilege are held by men, while women and other gender minorities are largely excluded from access to power.";
