<https://homosaurus.org/v4/homoit0003765> a skos:Concept;
  dc:identifier "homoit0003765";
  dc:issued "2024-10-30"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "A form of feminism that alleges that sex work is inherently coercive and exploitative. Although not all sex workers are women and not all clients are men, anti-sex work feminism largely centers this gender dynamic, viewing sex work as a result and reinforcement of the patriarchy.";
  skos:altLabel "Anti sex work feminism",
    "Anti-sex-work feminism";
  skos:broader <https://homosaurus.org/v4/homoit0000437>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000437>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Anti-sex work feminism";
  skos:related <https://homosaurus.org/v4/homoit0003766>,
    <https://homosaurus.org/v4/homoit0003777> .

<https://homosaurus.org/v4/homoit0003786> a skos:Concept;
  dc:identifier "homoit0003786";
  dc:issued "2024-10-30"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "The unjust or prejudicial treatment of sex workers due to their work or identity as a sex worker; may include the denial of legal rights, employment, and housing.";
  skos:altLabel "Discrimination against sex workers",
    "Anti sex worker discrimination",
    "Anti-prostitute discrimination",
    "Anti prostitute discrimination",
    "Discrimination against prostitutes";
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0003786>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Anti-sex worker discrimination";
  skos:related <https://homosaurus.org/v4/homoit0003787>,
    <https://homosaurus.org/v4/homoit0003788> .

<https://homosaurus.org/v4/homoit0003788> a skos:Concept;
