  skos:prefLabel "Solicitation of sex work";
  skos:related <https://homosaurus.org/v4/homoit0000278> .

<https://homosaurus.org/v4/homoit0003792> a skos:Concept;
  dc:identifier "homoit0003792";
  dc:issued "2024-10-30"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "A form of sex work in which companionship and sexual services are exchanged for money, gifts, and other material benefits. Generally but not always sugaring describes a relationship between an older client and a younger sex worker.";
