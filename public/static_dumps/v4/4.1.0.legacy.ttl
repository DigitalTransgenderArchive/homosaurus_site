<https://homosaurus.org/v4/homoit0001282> a skos:Concept;
  dc:identifier "homoit0001282";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/sexualAbstinence>;
  rdfs:comment "Practice of abstaining or not participating in some or all forms of sexual activity, whether for medical, psychological, social, moral, or religious reasons. Sexual abstinence may be voluntary or involuntary. ",
    "Práctica de abstenerse o no participar en algunas o todas las formas de actividad sexual, ya sea por razones médicas, psicológicas, sociales, morales o religiosas. La abstinencia sexual puede ser voluntaria o involuntaria.";
  skos:broader <https://homosaurus.org/v4/homoit0001267>;
  skos:changeNote "Version 4.1.0";
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85120718>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001267>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v4/homoit0001493>;
  skos:prefLabel "Sexual abstinence",
    "Abstinencia sexual";
  skos:related <https://homosaurus.org/v4/homoit0000004>,
    <https://homosaurus.org/v4/homoit0000244>,
    <https://homosaurus.org/v4/homoit0001306> .

<https://homosaurus.org/v4/homoit0001283> a skos:Concept;
