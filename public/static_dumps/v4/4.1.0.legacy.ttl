<https://homosaurus.org/v4/homoit0001625> a skos:Concept;
  dc:identifier "homoit0001625";
  dc:issued "2020-12-11"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/DADTRelationships>;
  rdfs:comment "Abbreviation for \"don’t ask don’t tell relationships,\" where partners agree that they have each have multiple romantic and/or sexual relationships as long as they do not discuss it with their primary partner or let it interfere with their partner’s daily life.",
    "Abreviatura de \"relaciones de no preguntar, no decir\" o \"don't ask, don't tell\" en inglés, donde las parejas acuerdan que cada una tiene múltiples relaciones románticas y/o sexuales, siempre y cuando no lo hablen con su pareja principal ni dejen que interfiera con la vida diaria de su pareja. .";
  skos:broader <https://homosaurus.org/v4/homoit0001651>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001636>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "DADT relationships",
    "Relaciones DADT";
  skos:related <https://homosaurus.org/v4/homoit0001629> .

<https://homosaurus.org/v4/homoit0001628> a skos:Concept;
