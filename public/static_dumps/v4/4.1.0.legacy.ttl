  skos:related <https://homosaurus.org/v4/homoit0001297> .

<https://homosaurus.org/v4/homoit0000653> a skos:Concept;
  dc:identifier "homoit0000653";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/sexualSterilisation>;
  rdfs:comment "Refers to any type of medical treatment that intentionally leaves an individual sterile or unable to reproduce. This term encompasses both voluntary and involuntary sterilization.",
    "Se refiere a cualquier tipo de tratamiento médico que intencionalmente deja a una persona estéril o incapaz de reproducirse. Este término abarca tanto la esterilización voluntaria como la involuntaria.";
  skos:changeNote "Version 4.1.0";
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85128029>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000653>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Sexual sterilization",
    "Esterilización sexual",
    "Sexual sterilisation";
  skos:related <https://homosaurus.org/v4/homoit0000430> .

<https://homosaurus.org/v4/homoit0000684> a skos:Concept;
  dc:identifier "homoit0000684";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/jogappa>;
  rdfs:comment "In India, this term is used to describe people assigned male at birth who become genderfluid in a spiritual conversion.",
    "En India, este término se utiliza para describir a las personas asignadas al sexo masculino al nacer y que asumen un género fluido a través de una conversión espiritual.";
  skos:broader <https://homosaurus.org/v4/homoit0000322>;
  skos:changeNote "Version 4.1.0";
