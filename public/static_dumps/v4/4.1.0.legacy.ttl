  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "AIDS memorial quilts",
    "Colchas conmemorativas del SIDA";
  skos:related <https://homosaurus.org/v4/homoit0000005>,
    <https://homosaurus.org/v4/homoit0000901> .

<https://homosaurus.org/v4/homoit0000032> a skos:Concept;
  dc:identifier "homoit0000032";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/AIDSPhobia>;
  rdfs:comment "Antagonism or disgust directed toward individuals with HIV/AIDS or behaviors perceived as putting oneself at risk for contracting HIV/AIDS. AIDS phobia may include isolation, stereotypes, verbal harassment, and physical violence.",
    "Antagonismo o disgusto dirigido hacia personas con VIH/SIDA o hacia comportamientos percibidos como riesgosos en relación a la contracción de VIH/SIDA. La fobia al SIDA puede incluir el aislamiento, los estereotipos, el acoso verbal y la violencia física.";
  skos:altLabel "AIDSphobia",
    "Fear of AIDS",
    "Fobia al SIDA",
    "AIDSfobia",
    "Miedo al SIDA",
    "Sidafobia",
    "Sidofobia";
  skos:changeNote "Version 4.1.0";
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh88004490>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000032>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "AIDS phobia",
    "Serofobia";
  skos:related <https://homosaurus.org/v4/homoit0000005>,
    <https://homosaurus.org/v4/homoit0000920> .

