<https://homosaurus.org/v4/homoit0002184> a skos:Concept;
  dc:identifier "homoit0002184";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "The fandom trope in which cisgender men can become pregnant. This term should not be used to describe pregnant trans men.",
