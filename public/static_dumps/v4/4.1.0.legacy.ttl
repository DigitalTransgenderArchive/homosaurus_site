<https://homosaurus.org/v4/homoit0001666> a skos:Concept;
  dc:identifier "homoit0001666";
  dc:issued "2021-06-30"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/relationshipAnarchy>;
  rdfs:comment "A type of non-monogamy characterized by application of anarchist principles (such as autonomy, anti-normativity, anti-hierarchical practices, refusal of state governance) to relationships. Often contrasted with hierarchical polyamory.",
    "Un tipo de no monogamia caracterizada por la aplicación de principios anarquistas (como la autonomía, la antinormatividad, las prácticas antijerárquicas, el rechazo de la gobernanza estatal) a las relaciones. A menudo, se contrasta con el poliamor jerárquico.";
  skos:broader <https://homosaurus.org/v4/homoit0001651>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001636>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Relationship anarchy",
    "Anarquía relacional";
  skos:related <https://homosaurus.org/v4/homoit0001665> .

