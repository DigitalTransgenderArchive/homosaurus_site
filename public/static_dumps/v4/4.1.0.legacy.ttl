<https://homosaurus.org/v4/homoit0003262> a skos:Concept;
  dc:identifier "homoit0003262";
  dc:issued "2024-05-24"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "The practice of traveling with the intention of soliciting sex work, typically to allow LGBTQ+ or curious people to explore sexual encounters that are illegal or stigmatized in their home countries. Sex tourism often presents ethical concerns, such as the economic gap between tourists and residents, differences in age of consent laws globally, and the selective enforcement of anti-sex work laws by police.";
  skos:altLabel "Sex tourism (LGBTQ)";
  skos:broader <https://homosaurus.org/v4/homoit0000956>,
    <https://homosaurus.org/v4/homoit0001275>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000956>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "LGBTQ+ sex tourism";
  skos:related <https://homosaurus.org/v4/homoit0001277> .

<https://homosaurus.org/v4/homoit0003365> a skos:Concept;
  dc:identifier "homoit0003365";
