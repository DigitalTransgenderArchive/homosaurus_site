<https://homosaurus.org/v4/homoit0000694> a skos:Concept;
  dc:identifier "homoit0000694";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/kothi>;
  rdfs:comment "In South Asia, this term is used to describe people who are assigned male at birth who exhibit feminine characteristics. Please note that not all kothis identify as hijra or transgender.",
    "En el sur de Asia, este término se utiliza para describir a las personas asignadas al sexo masculino al nacer que presentan características femeninas. No todas las kothis se autoidentifican como hijra o transgénero.";
  skos:broader <https://homosaurus.org/v4/homoit0000322>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000560>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Kothis";
  skos:related <https://homosaurus.org/v4/homoit0000632> .

