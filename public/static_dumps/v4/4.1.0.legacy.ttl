  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v4/homoit0002220>;
  skos:prefLabel "Yuri fandom",
    "Fandom yuri";
  skos:related <https://homosaurus.org/v4/homoit0002162>,
    <https://homosaurus.org/v4/homoit0002203> .

<https://homosaurus.org/v4/homoit0002229> a skos:Concept;
  dc:identifier "homoit0002229";
  dc:issued "2022-07-19"^^xsd:date;
  dc:modified "2025-04-24"^^xsd:date;
  rdfs:comment "LGBTQ+ people who use substances (that are typically deemed harmful or are subject to legal restriction, such as drugs or alcohol) in order to manage pain and other symptoms related to a medical condition or disability.",
    "Personas LGBTQ+ que utilizan sustancias (que suelen ser consideradas nocivas o están sujetas a restricciones legales, como las drogas o el alcohol) para controlar el dolor y otros síntomas relacionados con una enfermedad o discapacidad.";
  skos:altLabel "People who use substances for medical purposes (LGBTQ)",
    "Personas que utilizan sustancias con fines médicos (LGBTQ)";
  skos:broader <https://homosaurus.org/v4/homoit0000379>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000915>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "LGBTQ+ people who use substances for medical purposes",
    "Personas LGBTQ+ que utilizan sustancias con fines médicos";
  skos:related <https://homosaurus.org/v4/homoit0000380>,
    <https://homosaurus.org/v4/homoit0001854>,
    <https://homosaurus.org/v4/homoit0001879>,
    <https://homosaurus.org/v4/homoit0004226> .

<https://homosaurus.org/v4/homoit0002230> a skos:Concept;
  dc:identifier "homoit0002230";
  dc:issued "2022-07-20"^^xsd:date;
  dc:modified "2025-03-20"^^xsd:date;
  rdfs:comment "Pejorative term used chiefly in North America to describe gay men (or men assumed to be gay) and insult their perceived femininity. Some gay men have reclaimed this term and use it to describe themselves. Not to be confused with Faeries, the queer spiritual group.",
    "Término peyorativo utilizado principalmente en Norteamérica para describir a los hombres gay (o a los hombres que se asume que son gay) e insultar su feminidad percibida. Algunos hombres gay han recuperado este término y lo utilizan para describirse a sí mismos. No debe confundirse con \"Faeries\", el grupo espiritual queer.";
  skos:altLabel "Fairy (Gay culture)",
    "Hadas";
  skos:broader <https://homosaurus.org/v4/homoit0000878>,
    <https://homosaurus.org/v4/homoit0001559>,
    <https://homosaurus.org/v4/homoit0001560>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000878>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Fairies (Gay culture)",
    "Faeries (cultura gay)";
  skos:related <https://homosaurus.org/v4/homoit0000487>,
    <https://homosaurus.org/v4/homoit0000535> .

