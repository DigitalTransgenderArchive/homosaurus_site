<https://homosaurus.org/v4/homoit0002180> a skos:Concept;
  dc:identifier "homoit0002180";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Fans' personal interpretations of media properties and texts, particularly relating to the personalities and behaviors of characters. Use to describe headcanons that certain characters or relationships are LGBTQ+, as well as headcanons about other LGBTQ+ people and issues in the universe of the text.",
    "Interpretaciones personales de los fanáticos de las propiedades y textos de los medios, particularmente en relación con las personalidades y comportamientos de los personajes. Utilícese para describir cánones principales de que ciertos personajes o relaciones son LGBTQ+, así como cánones principales sobre otras personas y problemas LGBTQ+ en el universo del texto.";
  skos:altLabel "Headcanons (LGBTQ)";
  skos:broader <https://homosaurus.org/v4/homoit0001149>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001149>;
