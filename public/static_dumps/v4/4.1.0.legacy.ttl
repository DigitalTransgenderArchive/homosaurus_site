<https://homosaurus.org/v4/homoit0003789> a skos:Concept;
  dc:identifier "homoit0003789";
  dc:issued "2024-10-30"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "A set of practical strategies and ideas aimed at reducing the negative impacts of sex work on sex workers, as well as a social justice movement advocating for the rights of sex workers.";
