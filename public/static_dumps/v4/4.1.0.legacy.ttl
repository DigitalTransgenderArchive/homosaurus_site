<https://homosaurus.org/v4/homoit0002226> a skos:Concept;
  dc:identifier "homoit0000251",
    "homoit0000378",
    "homoit0001533",
    "homoit0001536",
    "homoit0002226";
  dc:isReplacedBy <https://homosaurus.org/v3/homoit0002226>;
  dc:issued "2019-05-14"^^xsd:date,
    "2020-06-02"^^xsd:date,
    "2022-07-19"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date,
    "2025-04-24"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/substanceAbuse>,
    <http://homosaurus.org/v2/drugAbuse>,
    <http://homosaurus.org/v2/cocaineAddiction>,
    <http://homosaurus.org/v2/crystalMethAddiction>;
  rdfs:comment "Abuse of or dependence on addictive substances such as drugs or alcohol.",
    "Dependence upon cocaine or crack; characterized by the experience of withdrawal symptoms upon cessation.",
    "LGBTQ+ people who have been diagnosed with or regard themselves as having a substance use disorder, a medical condition that involves a pattern of substance use that is difficult to control, negatively impacts the individual's life, and results in withdrawal symptoms upon cessation. Only use to refer to individuals who describe themselves as having a substance use disorder. Follow the individual's preference for \"use disorder\" or \"addiction\" whenever possible.",
    "Personas LGBTQ+ que han sido diagnosticadas o que ellas mismas consideran que padecen de un trastorno por uso de sustancias, una condición médica que implica un patrón de uso de sustancias que es difícil de controlar, afecta negativamente la vida de la persona y provoca síntomas de abstinencia al dejar de usarlas. Utilícese únicamente para referirse a personas que se describen a sí mismas como padeciendo de un trastorno por uso de sustancias. Siga la preferencia de la persona sobre el uso de \"trastorno por consumo\" o \"adicción\" siempre que sea posible.";
  skos:altLabel "Chemical dependency",
    "Drug addiction",
    "Drug dependence",
    "Cocaine abuse",
    "Cocaine misuse",
    "Cocaine use disorder",
    "Crack abuse",
    "Crack addiction",
    "Crystal meth misuse",
    "Crystal meth abuse",
    "Methamphetamine misuse",
    "Methamphetamine abuse",
    "Drug addicts (LGBTQ)",
    "LGBTQ+ drug addicts",
    "LGBTQ+ people with drug addictions",
    "People with substance abuse disorders (LGBTQ)";
  skos:broader <https://homosaurus.org/v4/homoit0002226>,
    <https://homosaurus.org/v4/homoit0000915>,
    <https://homosaurus.org/v4/homoit0001550>;
  skos:changeNote "Version 4.1.0";
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85129539>,
    <http://id.loc.gov/authorities/subjects/sh85039675>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0002226>,
    <https://homosaurus.org/v4/homoit0000915>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v4/homoit0002226>;
  skos:prefLabel "Substance abuse",
    "Drug abuse",
    "Cocaine addiction",
    "Crystal meth addiction",
    "LGBTQ+ people with substance use disorders",
    "Personas LGBTQ+ con trastornos por uso de sustancias";
  skos:related <https://homosaurus.org/v4/homoit0000379>,
    <https://homosaurus.org/v4/homoit0000380>,
    <https://homosaurus.org/v4/homoit0001235>,
    <https://homosaurus.org/v4/homoit0002227>,
