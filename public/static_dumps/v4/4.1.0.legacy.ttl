<https://homosaurus.org/v4/homoit0003502> a skos:Concept;
  dc:identifier "homoit0003502";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Laws or policies instituted that prevent trans and non-binary youth and children from seeking and/or obtaining medical treatment or gender-affirming care, including but not limited to surgery, hormone treatment, and mental health care. ";
  skos:broader <https://homosaurus.org/v4/homoit0003499>;
