<https://homosaurus.org/v4/homoit0001973> a skos:Concept;
  dc:identifier "homoit0001973";
  dc:issued "2022-05-11"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Intersex people who are part of an Indigenous people, or culturally distinct ethnic group whose members are directly descended from the earliest known inhabitants of a particular region and, to some extent, maintain the language and culture of those people. Only use to describe people who identify as Indigenous; use more specific terms whenever possible.",
    "Personas intersexuales que forman parte de un pueblo indígena o grupo étnico culturalmente distinto cuyos miembros descienden directamente de los primeros habitantes conocidos de una región en particular y, hasta cierto punto, mantienen el idioma y la cultura de ese pueblo. Utilícese únicamente para describir a personas que se autoidentifiquen como indígenas; utilícese términos más específicos siempre que sea posible.";
  skos:altLabel "Intersex Indigenous people",
    "Personas indígenas intersex",
    "Personas intersex indígenas";
  skos:broader <https://homosaurus.org/v4/homoit0000886>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000915>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v4/homoit0001942>,
    <https://homosaurus.org/v4/homoit0001961>,
    <https://homosaurus.org/v4/homoit0002964>;
  skos:prefLabel "Indigenous intersex people",
    "Personas intersexuale indígenas" .

