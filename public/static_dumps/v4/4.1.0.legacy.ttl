<https://homosaurus.org/v4/homoit0003619> a skos:Concept;
  dc:identifier "homoit0003619";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Two-Spirit people whose profession involves managing information by collecting, organizing, storing and disseminating it. This can include but is not limited to librarians, archivists, metadata and IT workers, web developers, and chief information officers. Use more specific terms when possible.";
  skos:altLabel "Two Spirit information professionals",
    "Two-Spirited information professionals",
    "Two Spirited information professionals",
    "2s information professionals";
  skos:broader <https://homosaurus.org/v4/homoit0001480>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000560>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v4/homoit0003556>,
    <https://homosaurus.org/v4/homoit0003627>;
  skos:prefLabel "Two-Spirit information professionals";
  skos:related <https://homosaurus.org/v4/homoit0003617> .

<https://homosaurus.org/v4/homoit0003651> a skos:Concept;
  dc:identifier "homoit0003651";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-04-23"^^xsd:date;
  rdfs:comment "Events that recognize and celebrate LGBTQ+ people and culture, thereby affirming the visibility, dignity, and diversity of LGBTQ+ communities.";
  skos:altLabel "LGBTQ+ pride events";
  skos:broader <https://homosaurus.org/v4/homoit0000861>;
  skos:changeNote "Version 4.1.0";
  skos:closeMatch <http://id.loc.gov/authorities/subjects/sh2010013029>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000861>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v4/homoit0003652>,
    <https://homosaurus.org/v4/homoit0003654>;
  skos:prefLabel "Pride events";
  skos:related <https://homosaurus.org/v4/homoit0002386> .

<https://homosaurus.org/v4/homoit0003654> a skos:Concept;
  dc:identifier "homoit0003654";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "A period of public recognition and celebration of LGBTQ+ people and culture, usually organized over the course of a month with local events, parades, marches, and rallies. Pride occurs at different times during the year in different places but is typically held in June in the United States to commemorate the Stonewall uprising.";
  skos:altLabel "LGBTQ+ Pride Month";
  skos:broader <https://homosaurus.org/v4/homoit0003653>,
    <https://homosaurus.org/v4/homoit0003651>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0003653>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v4/homoit0000523>;
  skos:prefLabel "Pride Month";
  skos:related <https://homosaurus.org/v4/homoit0003656> .

<https://homosaurus.org/v4/homoit0003657> a skos:Concept;
  dc:identifier "homoit0003657";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2026-02-23"^^xsd:date;
  rdfs:comment "Social, psychological, behavioral, and medical interventions designed to support and affirm an individual's gender identity. Gender-affirming care includes but is not limited to equal access to health care facilities, counseling, puberty blockers, hormone therapy, and gender-affirming surgeries. It can also include resources to aid in social transition, such as affirming policies regarding name and pronoun changes, access to non-gendered restrooms and facilities, etc.";
  skos:altLabel "Gender affirming care";
  skos:broader <https://homosaurus.org/v4/homoit0000614>;
  skos:changeNote "Version 4.1.0";
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh2023000451>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000614>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v4/homoit0000561>,
    <https://homosaurus.org/v4/homoit0003658>,
    <https://homosaurus.org/v4/homoit0003659>;
  skos:prefLabel "Gender-affirming care" .

<https://homosaurus.org/v4/homoit0003692> a skos:Concept;
  dc:identifier "homoit0003692";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "A discriminatory practice in which financial services are withheld from neighborhoods that have significant numbers of racial and ethnic minorities. Redlining includes but is not limited to denial of credit, insurance, and healthcare; inflated mortgage and interest rates; and the development of food deserts. The term has its roots in the New Deal when color-coded maps were made of metropolitan areas in the United States to indicate where it was considered safe to insure mortgages. Black neighborhoods and surrounding areas were colored red to indicate mortgages should not be insured there.";
  skos:altLabel "Red lining",
    "Credit card redlining";
  skos:changeNote "Version 4.1.0";
  skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85038399>,
    <http://id.loc.gov/authorities/subjects/sh85038383>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0003692>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Redlining";
  skos:related <https://homosaurus.org/v4/homoit0002257>,
    <https://homosaurus.org/v4/homoit0002038>,
    <https://homosaurus.org/v4/homoit0003691> .

<https://homosaurus.org/v4/homoit0003693> a skos:Concept;
  dc:identifier "homoit0003693";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Public spaces designated as safe for, or accepting and affirming of, LGBTQ+ people, often by allies. LGBTQ+ safe spaces are sometimes identified through the display of stickers or placards.";
  skos:altLabel "Safe spaces (LGBTQ)",
    "Safe places (LGBTQ)",
    "LGBTQ+ safe places",
    "LGBTQ+ safe zones",
    "Safe zones (LGBTQ)";
  skos:broader <https://homosaurus.org/v4/homoit0003699>;
  skos:changeNote "Version 4.1.0";
  skos:closeMatch <http://id.loc.gov/authorities/subjects/sh2023000011>;
