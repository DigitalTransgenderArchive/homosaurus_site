<https://homosaurus.org/v4/homoit0000646> a skos:Concept;
  dc:identifier "homoit0000646";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/homophobia>;
  rdfs:comment "Antagonism or disgust directed towards homosexuality as an identity or men who are perceived to be or are actually gay. Homophobia can include denial of the existence of homosexuality, stereotypes, verbal harassment, and physical violence. This term is often used colloquially to encompass all LGBTQ+ phobia.",
    "Antagonismo o disgusto dirigido hacia la homosexualidad como identidad o hacia los hombres que son percibidos como o que realmente son gay. La homofobia puede incluir la negación de la existencia de la homosexualidad, los estereotipos, el acoso verbal y la violencia física. Este término se utiliza a menudo de forma coloquial para abarcar toda la fobia LGBTQ+.";
  skos:broader <https://homosaurus.org/v4/homoit0000920>;
  skos:changeNote "Version 4.1.0";
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh88006552>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000920>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v4/homoit0000391>,
    <https://homosaurus.org/v4/homoit0002174>;
  skos:prefLabel "Homophobia",
    "Homofobia";
  skos:related <https://homosaurus.org/v4/homoit0000055>,
    <https://homosaurus.org/v4/homoit0000056>,
    <https://homosaurus.org/v4/homoit0000506>,
    <https://homosaurus.org/v4/homoit0000619> .

