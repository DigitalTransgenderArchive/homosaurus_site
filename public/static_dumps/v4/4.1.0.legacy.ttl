<https://homosaurus.org/v4/homoit0001995> a skos:Concept;
  dc:identifier "homoit0001995";
  dc:issued "2022-05-11"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Asexual people who have experienced bullying due to their sexual identity and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible.",
    "Personas asexuales que han sufrido acoso por su identidad sexual y pueden o no haber sobrevivido; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"supervivientes\" siempre que sea posible.";
  skos:broader <https://homosaurus.org/v4/homoit0001989>,
    <https://homosaurus.org/v4/homoit0003474>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000915>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Asexual victims of bullying",
    "Víctimas asexuales de acoso" .

<https://homosaurus.org/v4/homoit0002017> a skos:Concept;
  dc:identifier "homoit0002017";
  dc:issued "2022-05-11"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Gay men of Mexican descent born in the United States; only use to describe people who self-identify as Chicano, Chicana, or Chicanx. Do not conflate with Latino/a/x or Hispanic people.",
    "Hombres gay de ascendencia mexicana nacidos en Estados Unidos; utilícese únicamente para describir a personas que se autoidentifiquen como chicanas. No se debe confundir con latinos/a/x o hispanos.";
  skos:altLabel "Chicano gay men",
    "Chicanx gay men",
    "Gay Chicanos",
    "Gay Chicanx men",
    "Gay Chicanxs",
    "Chicanos gay",
    "Gays chicanos";
  skos:broader <https://homosaurus.org/v4/homoit0002007>;
  skos:changeNote "Version 4.1.0";
  skos:closeMatch <http://id.loc.gov/authorities/subjects/sh91001712>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000915>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Chicano/a/x gay men",
    "Hombres gay chicanos";
  skos:related <https://homosaurus.org/v4/homoit0000095> .

<https://homosaurus.org/v4/homoit0002035> a skos:Concept;
  dc:identifier "homoit0002035";
