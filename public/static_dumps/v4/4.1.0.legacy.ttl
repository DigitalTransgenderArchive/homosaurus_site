  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/sexualAddiction>;
  rdfs:comment "LGBTQ+ people experiencing addiction to or dependency upon sexual activities. Only use to refer to individuals who describe themselves as having sexual addictions, not individuals whose sexual practices are perceived as promiscuous or unsafe by others.",
    "Personas LGBTQ+ que experimentan una adicción o dependencia a actividades sexuales. Utilícese únicamente para referirse a personas que se describen a sí mismas como adictas sexuales, no a personas cuyas prácticas sexuales son percibidas como promiscuas o inseguras por otras personas.";
  skos:altLabel "LGBTQ+ people with sex addictions";
  skos:broader <https://homosaurus.org/v4/homoit0001550>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000915>;
