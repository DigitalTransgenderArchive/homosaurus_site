<https://homosaurus.org/v4/homoit0003974> a skos:Concept;
  dc:identifier "homoit0003974";
  dc:issued "2025-04-23"^^xsd:date;
  dc:modified "2025-04-23"^^xsd:date;
  rdfs:comment "Amongst the Canelos-Quichua, one of the indigenous Kichwa peoples of the Ecuadorian Amazon, this term is used to refer to people who were assigned male at birth but have the ability to transition between feminine and masculine. ";
  skos:broader <https://homosaurus.org/v4/homoit0000322>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000560>;
  skos:inScheme <https://homosaurus.org/v4>;
  skos:prefLabel "Warmipangui";
  skos:related <https://homosaurus.org/v4/homoit0003293> .

<https://homosaurus.org/v4/homoit0003986> a skos:Concept;
  dc:identifier "homoit0003986";
  dc:issued "2025-04-23"^^xsd:date;
  dc:modified "2025-04-23"^^xsd:date;
  rdfs:comment "Term used to describe the ways in which disabled and chronically ill people experience and relate to time differently than is socially expected. According to Alison Kafer, quoted in a paper published by Ellen Samuels, \"rather than bend disabled bodies and minds to meet the clock, crip time bends the clock to meet disabled bodies and minds.\"";
  skos:altLabel "Crip temporality";
  skos:broader <https://homosaurus.org/v4/homoit0001891>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001317>;
  skos:inScheme <https://homosaurus.org/v4>;
  skos:prefLabel "Crip time";
  skos:related <https://homosaurus.org/v4/homoit0003985> .

<https://homosaurus.org/v4/homoit0003987> a skos:Concept;
  dc:identifier "homoit0003987";
  dc:issued "2025-04-23"^^xsd:date;
  dc:modified "2025-04-23"^^xsd:date;
  rdfs:comment "Term used to describe the ways in which queer people experience and relate to time differently than is socially expected. This may include delayed or non-linear development before coming out, disrupted life trajectories, and a sense of impending mortality, particularly during the AIDS epidemic. ";
  skos:altLabel "Queer temporality";
  skos:broader <https://homosaurus.org/v4/homoit0001219>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001365>;
  skos:inScheme <https://homosaurus.org/v4>;
  skos:prefLabel "Queer time";
  skos:related <https://homosaurus.org/v4/homoit0003985> .

<https://homosaurus.org/v4/homoit0003988> a skos:Concept;
  dc:identifier "homoit0003988";
  dc:issued "2025-04-23"^^xsd:date;
  dc:modified "2025-04-23"^^xsd:date;
  rdfs:comment "Term used to describe the racialization of time in a white supremacist society, which results in unequal temporal access to institutions, resources, power, etc. This term also references the ways in which non-white people are expected to conform to specific, linear patterns over time, as well as the calculation of time and history through white, Western expectations for progress and productivity.";
  skos:altLabel "White temporality",
    "White temporal imaginary",
    "Racialization of time",
    "Racial time";
  skos:broader <https://homosaurus.org/v4/homoit0003985>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001323>;
  skos:inScheme <https://homosaurus.org/v4>;
  skos:prefLabel "White time";
  skos:related <https://homosaurus.org/v4/homoit0001902> .

