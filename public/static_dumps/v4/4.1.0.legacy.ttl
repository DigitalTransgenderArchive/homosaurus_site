<https://homosaurus.org/v4/homoit0002375> a skos:Concept;
  dc:identifier "homoit0002375";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Any of various forms of inappropriate conduct, illegal actions, or abuses of power undertaken by law enforcement agents or agents of the state against LGBTQ+ members of the public. This includes but is not limited to racial, ethnic, and other forms of profiling; unwarranted surveillance, searches, and seizure; selective enforcement; excessive use of force; sexual misconduct; intimidation and witness tampering; falsification of evidence; coerced confessions; false arrests and imprisonment; and bribing or lobbying.",
    "Cualquiera de las diversas formas de conducta inapropiada, acciones ilegales o abusos de poder que violentan directa o indirectamente a las personas LGBTQ+, incluidas, entre otras, confesiones forzadas, intimidación, arrestos y encarcelamientos falsos, falsificación de pruebas, perjurio policial, manipulación de testigos, brutalidad y corrupción policial, elaboración de caracterizaciones raciales, étnicos y de otro tipo, vigilancia injustificada, registros o incautación de propiedad, soborno o cabildeo para obtener poder o estatus excesivo o para evitar consecuencias, aplicación selectiva de la ley y conducta sexual inapropiada.";
  skos:altLabel " Mistreatment of LGBTQ+ people by police",
    "Harassment of LGBTQ+ people by police",
    "Police brutality toward LGBTQ+ people",
    "Police misconduct toward LGBTQ+ people",
    "Police mistreatment of LGBTQ+ people",
    "Maltrato hacia personas LGBTQ+ por la policía",
    "Acoso de personas LGBtQ+ por la policía",
    "Brutalidad policial hacia personas LGBTQ+",
    "Mala conducta policial hacia personas LGBTQ+",
    "Maltrato policial contra personas LGBTQ+";
  skos:broader <https://homosaurus.org/v4/homoit0001121>,
    <https://homosaurus.org/v4/homoit0002373>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000611>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v4/homoit0002376>,
    <https://homosaurus.org/v4/homoit0002377>;
  skos:prefLabel "Police harassment of LGBTQ+ people",
    "Acoso policial a personas LGBTQ+" .

