  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/reciprocalInVitroFertilisation>;
  rdfs:comment "A medical procedure in which the egg of one partner is fertilized with donor sperm and then transferred to the uterus of the other partner to bring to term.",
    "Un procedimiento médico en el que el óvulo de una pareja se fertiliza con esperma de un donante y luego se transfiere al útero de la otra pareja para llevarlo a término.";
  skos:altLabel "Shared motherhood",
    "Maternidad compartida";
  skos:broader <https://homosaurus.org/v4/homoit0000659>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000864>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Reciprocal in vitro fertilization",
    "Fertilización in vitro recíproca",
    "Reciprocal in vitro fertilisation" .

