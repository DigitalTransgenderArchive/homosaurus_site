<https://homosaurus.org/v4/homoit0002192> a skos:Concept;
  dc:identifier "homoit0002192";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Purposeful subtextual coding of a character or relationship in a piece of media as queer. Queer coding is distinct from the practice of queerbaiting in that the queer codes are intentionally present rather than falsely implied and are not typically used as a marketing tactic.",
    "Codificación subtextual intencionada de un personaje o de una relación en una pieza mediática como queer. La codificación queer se diferencia de la práctica del queerbaiting en que los códigos queer están presentes intencionalmente en lugar de implícitos falsamente y no suelen utilizarse como táctica de marketing.";
  skos:altLabel "Queercoding";
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0002192>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Queer coding",
    "Codificación queer";
  skos:related <https://homosaurus.org/v4/homoit0000609>,
    <https://homosaurus.org/v4/homoit0000972>,
    <https://homosaurus.org/v4/homoit0001233>,
    <https://homosaurus.org/v4/homoit0001900>,
    <https://homosaurus.org/v4/homoit0002191> .

