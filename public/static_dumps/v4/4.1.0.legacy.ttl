<https://homosaurus.org/v4/homoit0003615> a skos:Concept;
  dc:identifier "homoit0003615";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "A school of ecology that seeks to understand nature, biology, and sexuality through the framing of queer theory. Queer ecology rejects the presumption of heterosexuality and cisgenderedness as natural, as well as notions of human exceptionalism and anthropocentrism.";
  skos:altLabel "Queer ecologies";
  skos:broader <https://homosaurus.org/v4/homoit0001219>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001365>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Queer ecology" .

<https://homosaurus.org/v4/homoit0003616> a skos:Concept;
  dc:identifier "homoit0003616";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "A school of thought that rejects Eurocentric knowledge hierarchies and ways of being, including the presumed superiority of white Western culture.";
  skos:altLabel "Decoloniality",
    "Decolonizing theory",
    "Postcolonial theory",
    "Postcolonialism";
  skos:broader <https://homosaurus.org/v4/homoit0001365>;
  skos:changeNote "Version 4.1.0";
  skos:closeMatch <http://id.loc.gov/authorities/subjects/sh97007835>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001365>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Decolonial theory" .

