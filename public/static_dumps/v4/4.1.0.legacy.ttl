<https://homosaurus.org/v4/homoit0002217> a skos:Concept;
  dc:identifier "homoit0002217";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Japanese word used by English-speaking anime and manga fans to describe explicit or pornographic works featuring male-male couples that are typically created by heterosexual female authors for heterosexual female readers. Note that the Japanese meaning and usage of \"yaoi\" and related terms differ considerably.",
    "Palabra japonesa utilizada por los fanáticos del anime y el manga de habla inglesa para describir obras explícitas o pornográficas que presentan parejas de hombres y que generalmente son creadas por autoras heterosexuales para lectoras heterosexuales. Tenga en cuenta que el significado y el uso japonés de \"yaoi\" y términos relacionados difieren considerablemente.";
  skos:broader <https://homosaurus.org/v4/homoit0002218>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v4/homoit0002197>,
    <https://homosaurus.org/v4/homoit0002214>;
  skos:prefLabel "Yaoi";
  skos:related <https://homosaurus.org/v4/homoit0000493>,
    <https://homosaurus.org/v4/homoit0001598>,
    <https://homosaurus.org/v4/homoit0002172>,
    <https://homosaurus.org/v4/homoit0002188>,
    <https://homosaurus.org/v4/homoit0002204> .

