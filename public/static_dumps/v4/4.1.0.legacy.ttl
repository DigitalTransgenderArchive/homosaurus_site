<https://homosaurus.org/v4/homoit0000645> a skos:Concept;
  dc:identifier "homoit0000645";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2026-02-24"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/homophiles>;
  rdfs:comment "Outdated term for lesbians and gay men. The use of the word began to disappear with the emergence of the gay liberation movement of the late 1960s and early 1970s.",
    "Término obsoleto para lesbianas y hombres gay. El uso de la palabra comenzó a desaparecer con el surgimiento del movimiento de liberación gay a finales de la década de los sesenta y principios de los setenta.";
  skos:broader <https://homosaurus.org/v4/homoit0000878>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000878>;
