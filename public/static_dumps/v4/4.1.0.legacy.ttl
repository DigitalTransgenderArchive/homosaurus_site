<https://homosaurus.org/v4/homoit0002203> a skos:Concept;
  dc:identifier "homoit0002203";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "The fan community that focuses on, incorporates, or details relationships between two characters of the same sex or gender (usually fictional, with \"Real person fiction\" as an exception). Historically used for male-male couples only, but is now used more broadly; includes femslash fandom.",
    "La comunidad de fans que se centra sobre, incorpora o detalla las relaciones entre dos personajes del mismo sexo o género (normalmente ficticios, con la excepción de \"ficción de personas reales\"). Históricamente se utilizaba únicamente para parejas de hombres, pero ahora se utiliza de forma más amplia; incluye fandom de femslash.";
  skos:altLabel "Slash fan community",
    "Comunidad fan slash",
    "Comunidad de fans slash";
  skos:broader <https://homosaurus.org/v4/homoit0002156>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v4/homoit0002200>,
    <https://homosaurus.org/v4/homoit0002202>,
    <https://homosaurus.org/v4/homoit0002204>,
    <https://homosaurus.org/v4/homoit0002205>,
    <https://homosaurus.org/v4/homoit0002208>;
  skos:prefLabel "Slash fandom",
    "Fandom slash";
  skos:related <https://homosaurus.org/v4/homoit0002221> .

