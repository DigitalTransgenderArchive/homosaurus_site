  skos:related <https://homosaurus.org/v4/homoit0003460> .

<https://homosaurus.org/v4/homoit0003504> a skos:Concept;
  dc:identifier "homoit0003504";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2026-02-26"^^xsd:date;
  rdfs:comment "Laws or policies instituted to prevent trans and non-binary individuals from seeking medical treatment or gender-affirming care, including but not limited to surgery, hormone treatment, and mental health care. ";
  skos:broader <https://homosaurus.org/v4/homoit0003499>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000702>;
