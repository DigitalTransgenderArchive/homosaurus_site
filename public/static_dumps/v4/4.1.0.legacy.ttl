  dc:issued "2022-11-08"^^xsd:date;
  dc:modified "2025-02-28"^^xsd:date;
  rdfs:comment "As defined by Emi Koyama, transfeminism is a movement by and for trans woman who view the liberation of trans women as essential to the liberation of all women.",
    "Como lo define Emi Koyama, el transfeminismo es un movimiento por y para mujeres trans que ven la liberación de las mujeres trans como esencial para la liberación de todas las mujeres.";
  skos:altLabel "Trans feminism",
    "Trans feminismo";
  skos:broader <https://homosaurus.org/v4/homoit0000437>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000437>;
