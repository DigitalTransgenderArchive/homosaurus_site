<https://homosaurus.org/v4/homoit0001232> a skos:Concept;
  dc:identifier "homoit0001232";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/rainbowFlags>;
  rdfs:comment "Rainbow-striped flags that symbolize LGBTQ+ pride and LGBTQ+ social movements. The first rainbow pride flag, which had eight colors, was created by Gilbert Baker, Lynn Segerblom, and others in San Francisco, California in 1978. Due to difficulties obtaining hot pink fabric and a desire for an even number of stripes, Baker modified his design in 1979 to contain six colors. The six-color version of the flag has been the most popular design since then.",
    "Banderas con franjas arcoíris que simbolizan el orgullo LGBTQ+ y los movimientos sociales LGBTQ+. La primera bandera arcoíris de orgullo fue creada por Gilbert Baker en 1978.";
  skos:altLabel "Baker flags";
  skos:broader <https://homosaurus.org/v4/homoit0003246>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000954>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Rainbow flags",
    "Banderas arcoíris" .

<https://homosaurus.org/v4/homoit0001234> a skos:Concept;
  dc:identifier "homoit0001234";
