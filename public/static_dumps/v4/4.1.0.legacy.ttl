<https://homosaurus.org/v4/homoit0003444> a skos:Concept;
  dc:identifier "homoit0003444";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "A term used in gender studies and feminist writing to describe a setting or culture in which sexual violence is pervasive and normalized due to attitudes about gender and sexuality.";
