<https://homosaurus.org/v4/homoit0002396> a skos:Concept;
  dc:identifier "homoit0002396";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2026-02-27"^^xsd:date;
  rdfs:comment "LGBTQ+ activism undertaken by police organizations and institutions which intends to increase the social capital of such institutions, rather than to actually serve LGBTQ+ communities.",
    "Activismo LGBTQ+ emprendido por organizaciones e instituciones policiales que pretende aumentar el capital social de dichas instituciones, en lugar de servir realmente a las comunidades LGBTQ+.";
  skos:altLabel "Gay copaganda",
    "LGBTQ+ copaganda",
    "Pinkwashing by police officers",
    "Pride patches on police uniforms",
    "Rainbow colored patrol cars",
    "Rainbow hate crime cars",
    "Rainbow-hued police cars",
    "Rainbow-painted police cars",
    "Rainbow-washing by police officers",
    "Copaganda gay",
    "Copaganda LGBTQ+";
  skos:broader <https://homosaurus.org/v4/homoit0002373>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0002373>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Performative LGBTQ+ activism by police",
    "Activismo performativo LGBTQ+ de la policía";
  skos:related <https://homosaurus.org/v4/homoit0000006> .

