<https://homosaurus.org/v4/homoit0001981> a skos:Concept;
  dc:identifier "homoit0001981";
  dc:issued "2022-05-11"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Treatment that involves the use of three or more drugs in combination to treat HIV infection by preventing the virus from making copies of itself in the body; can lessen the damage to the immune system caused by HIV, slow down the development of AIDS, and prevent the transmission of HIV to others.",
    "Tratamiento que implica el uso de tres o más medicamentos en combinación para tratar la infección por VIH evitando que el virus se replique en el cuerpo; puede disminuir el daño al sistema inmunológico causado por el VIH, retardar el desarrollo del SIDA y prevenir la transmisión del VIH a otras personas.";
  skos:altLabel "Combination Anti-Retroviral Therapy",
    "Combination Antiretroviral Therapy",
    "HAART",
    "Highly Active Anti-Retroviral Therapy",
    "Highly Active Antiretroviral Therapy",
    "cART";
  skos:broader <https://homosaurus.org/v4/homoit0001007>;
  skos:changeNote "Version 4.1.0";
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh2008003832>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001004>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "HAART (Highly Active Antiretroviral Therapy)",
    "TARGA (Terapia Antirretroviral de Gran Actividad)";
  skos:related <https://homosaurus.org/v4/homoit0000005> .

