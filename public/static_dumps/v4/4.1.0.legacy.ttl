<https://homosaurus.org/v4/homoit0001906> a skos:Concept;
  dc:identifier "homoit0001906";
  dc:issued "2022-03-29"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Performers who dress and/or use makeup to produce, emphasize, and/or exaggerate traits associated with a certain gender, which may or may not be the gender the performer primarily identifies with.",
    "Artistas que se visten y/o utilizan maquillaje para producir, enfatizar y/o exagerar rasgos asociados con un determinado género, que puede o no ser el género con el que el artista se identifica principalmente.";
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001906>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Drag performers",
    "Intérpretes de drag";
  skos:related <https://homosaurus.org/v4/homoit0000367>,
    <https://homosaurus.org/v4/homoit0000370>,
