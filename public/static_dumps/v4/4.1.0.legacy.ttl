<https://homosaurus.org/v4/homoit0002383> a skos:Concept;
  dc:identifier "homoit0002383";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Unexpected and unannounced entry into and searches of meeting places owned or frequented by LGBTQ+ people, including individuals' residences, businesses, and other institutions, by law enforcement officers with the aim of using surprise to seize evidence or arrest suspects. Police raids may be undertaken legally using a search warrant or through exigent circumstances, such as probable cause, though the latter is highly subjective and civilians often have little resources to appeal illegal raids.",
    "Redadas policiales en lugares de encuentro afiliados o relacionados con comunidades o identidades LGBTQ+, ya sea la residencia de una persona, un negocio u otra institución.";
  skos:broader <https://homosaurus.org/v4/homoit0002381>;
  skos:changeNote "Version 4.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000611>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Police raids on LGBTQ+ meeting places",
    "Redadas policiales en espacios de encuentro LGBTQ+" .

