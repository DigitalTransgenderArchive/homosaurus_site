    <https://homosaurus.org/v4/homoit0003508>;
  skos:prefLabel "Girls’ Love (Genre)";
  skos:related <https://homosaurus.org/v4/homoit0000742> .

<https://homosaurus.org/v4/homoit0003514> a skos:Concept;
  dc:identifier "homoit0003514";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Organized measures taken for the maintenance or improvement of health via the prevention, diagnosis, and/or treatment of physical and mental health issues faced by transgender children and youth. This includes but is not limited to access to safe, legal therapy and counseling, hormone treatment, and gender-affirming surgery.";
  skos:altLabel "Health care for trans children and youth",
    "Trans health care for children and youth",
    "Transgender health care for children and youth";
  skos:broader <https://homosaurus.org/v4/homoit0000614>;
