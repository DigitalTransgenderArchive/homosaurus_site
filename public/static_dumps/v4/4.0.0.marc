  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">People who participate in leather communities and identify as leathergirls.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas que participan en comunidades de cuero y se autoidentifican como leathergirls.</subfield>
  </datafield>
