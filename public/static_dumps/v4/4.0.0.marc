    <subfield code="a">Creators of written or spoken verse who identify as aromantic.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Creators of written or spoken verse who identify as demisexual.</subfield>
  </datafield>
