  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Businesses owned by gay people.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Empresas pertenecientes a hombres gay.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Businesses owned by bisexual people.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Empresas pertenecientes a personas bisexuales.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Businesses owned by transgender people.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Empresas pertenecientes a personas transg&#xE9;nero.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Businesses owned by queer people.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Empresas pertenecientes a personas queer.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Businesses focusing on LGBTQ+ clientele and products related to LGBTQ+ communities.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Empresas enfocadas en clientela LGBTQ+ y productos relacionados con comunidades LGBTQ+.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Businesses focusing on lesbian clientele and products related to lesbian communities.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Empresas enfocadas en clientela l&#xE9;sbica y productos relacionados con comunidades l&#xE9;sbicas.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Businesses focusing on gay clientele and products related to gay communities.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Empresas enfocadas en clientela gay y productos relacionados con las comunidades gay.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Businesses focusing on bisexual clientele and products related to bisexual communities.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Empresas enfocadas en clientela bisexual y productos relacionados con comunidades bisexuales.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Businesses focusing on transgender clientele and products related to transgender communities.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Empresas enfocadas en clientela transg&#xE9;nero y productos relacionados con comunidades transg&#xE9;nero.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Businesses focusing on queer clientele and products related to queer communities.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Empresas enfocadas en clientela queer y productos relacionados con comunidades queer.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Asexual creators of written works.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Creadores de obras escritas conocidos por ser asexuales.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Aromantic creators of written works.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Creadores de obras escritas conocidos por ser arrom&#xE1;nticos.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Intersex creators of written works.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Creadores de obras escritas conocidos por ser intersex.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Two-Spirit creators of written works.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Creadoras de obras escritas conocidas por ser dos esp&#xED;ritus.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Written works describing imagined events or people; use in reference to fictional works focusing on Two-Spirit characters or themes.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Obras de ficci&#xF3;n escritas donde figuran personajes dos esp&#xED;ritus o se abordan temas dos esp&#xED;ritus.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Written works of fiction featuring intersex characters or addressing intersex themes.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Obras escritas de ficci&#xF3;n que presentan personajes intersex o abordan temas intersex.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Written works describing imagined events or people; use in reference to fictional works focusing on aromantic characters or themes.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Obras escritas que describen eventos o personas imaginadas; util&#xED;cese en referencia a obras de ficci&#xF3;n que se centran en personajes o temas arrom&#xE1;nticos.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Written works describing imagined events or people; use in reference to fictional works focusing on asexual characters or themes.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Obras de ficci&#xF3;n escritas donde figuran personajes asexuales o se abordan temas asexuales.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">A broad grouping term for galleries, libraries, archives, museums, and special collections (GLAMS) that hold materials primarily pertaining to LGBTQ+ people or intended for use by LGBTQ+ people.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Un t&#xE9;rmino amplio para agrupar a galer&#xED;as, bibliotecas, archivos, museos y colecciones especiales (GLAMS, por sus siglas en ingl&#xE9;s) que contienen materiales principalmente relacionados con personas LGBTQ+ o destinados a ser utilizados por personas LGBTQ+.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Term used to describe people, typically children, who do not conform to traditional gender norms and instead creatively interweave their internal and external experiences to understand their gender identity and expression. May also be used to describe a way of raising children outside of traditional gender norms.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">T&#xE9;rmino utilizado para describir a personas, generalmente ni&#xF1;os, que no se ajustan a las normas de g&#xE9;nero tradicionales y, en cambio, entrelazan creativamente sus experiencias internas y externas para comprender su identidad y expresi&#xF3;n de g&#xE9;nero. Tambi&#xE9;n puede utilizarse para describir una forma de criar a los ni&#xF1;os fuera de las normas tradicionales de g&#xE9;nero.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Families, whether biological, adoptive, or chosen, in which one or more individuals identify as aromantic.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Familias, ya sean biol&#xF3;gicas, adoptivas o elegidas, en las que una o m&#xE1;s personas se autoidentifican como arrom&#xE1;nticas.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Families, whether biological, adoptive, or chosen, in which one or more individuals identify as asexual.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Familias, ya sean biol&#xF3;gicas, adoptivas o elegidas, en las que una o m&#xE1;s personas se autoidentifican como asexuales.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Families, whether biological, adoptive, or chosen, in which one or more individuals are intersex.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Familias, ya sean biol&#xF3;gicas, adoptivas o elegidas, en las que una o m&#xE1;s personas son intersex.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Families, whether biological, adoptive, or chosen, in which one or more individuals identify as Two-Spirit.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Familias, ya sean biol&#xF3;gicas, adoptivas o elegidas, en las que una o m&#xE1;s personas se autoidentifican como dos esp&#xED;ritus.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Parents who are aromantic.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Padres y/o madres que son arrom&#xE1;nticos. </subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Parents who are asexual.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Padres y/o madres que son asexuales. </subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Parents who are intersex.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Padres y/o madres que son intersex.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Two-Spirit people who are parents.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Padres y/o madres que son dos esp&#xED;ritus.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Children who have one or more aromantic parent.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Hijos o hijas que tienen uno o m&#xE1;s padres arom&#xE1;nticos.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Children who have one or more asexual parent.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Hijos o hijas que tienen uno o m&#xE1;s madres o padres asexuales.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Children who have one or more intersex parent.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Hijos o hijas que tienen uno o m&#xE1;s madres o padres intersexuales.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Children who have one or more Two-Spirit parent.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Hijos o hijas que tienen uno o m&#xE1;s madres o padres de dos esp&#xED;ritus.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Behavior involving physical force intended to harm or kill Two-Spirit people on the basis of their identity. </subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Comportamiento que involucra fuerza f&#xED;sica destinada a hacer da&#xF1;o o a matar a personas Dos Esp&#xED;ritus por su identidad.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Behavior involving physical force intended to harm or kill intersex people because they are intersex.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Comportamiento que involucra fuerza f&#xED;sica destinada a hacer da&#xF1;o o a matar a personas intersexuales por su identidad.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">LGBTQ+ people who are trained, professional cooks, typically holding a leadership role in the kitchen in which they are employed.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas LGBTQ+ que son cocineros profesionales capacitados y que generalmente desempe&#xF1;an un papel de liderazgo en la cocina en la que trabajan.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Lesbians who are trained, professional cooks, typically holding a leadership role in the kitchen in which they are employed.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Lesbianas que son cocineras profesionales capacitadas y que normalmente desempe&#xF1;an un papel de liderazgo en la cocina en la que trabajan.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Gay men who are trained, professional cooks, typically holding a leadership role in the kitchen in which they are employed.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Hombres gay que son cocineros profesionales entrenados y que generalmente desempe&#xF1;an un papel de liderazgo en la cocina en la que trabajan.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Bisexual people who are trained, professional cooks, typically holding a leadership role in the kitchens in which they are employed.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas bisexuales que son cocineras profesionales y capacitadas, quienes normalmente desempe&#xF1;an un papel de liderazgo en las cocinas en las que trabajan.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Transgender people who are trained, professional cooks, typically holding a leadership role in the kitchen in which they are employed.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas transg&#xE9;nero que son cocineras profesionales capacitadas y que normalmente desempe&#xF1;an un papel de liderazgo en la cocina en la que trabajan.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Queer people who are trained, professional cooks, typically holding a leadership role in the kitchen in which they are employed.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas queer que son cocineras profesionales y capacitadas, que normalmente desempe&#xF1;an un papel de liderazgo en la cocina en la que trabajan.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Intersex people who are trained, professional cooks, typically holding a leadership role in the kitchen in which they are employed.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas intersex que son cocineras profesionales y capacitadas, que normalmente desempe&#xF1;an un papel de liderazgo en la cocina en la que trabajan.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Two-Spirit people who are trained, professional cooks, typically holding a leadership role in the kitchen in which they are employed.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas dos esp&#xED;ritus que son cocineras profesionales capacitadas y que normalmente desempe&#xF1;an un papel de liderazgo en la cocina en la que trabajan.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Slang term for individuals who alternate between being the giving partner and the receiving partner in sexual encounters; typically used as an adjective (e.g., "They're vers.").</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">T&#xE9;rmino de la jerga para personas que alternan entre ser la pareja que da y la que recibe en encuentros sexuales; normalmente se utiliza como adjetivo (por ejemplo, "Ella es vers").</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Abbreviated form of the phrase "trans for trans," a label used to describe trans people who prioritize engaging in romantic, sexual, or other relationships with other trans people.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Forma abreviada de la frase en ingl&#xE9;s "trans for trans", traducida como "trans para trans", una etiqueta utilizada para describir a las personas trans que priorizan entablar relaciones rom&#xE1;nticas, sexuales o de otro tipo con otras personas trans.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Slang term for the act of identifying (or clocking) someone in public as trans, crossdressing, or in drag when that person is intending to pass or be read by others as cisgender, typically for their personal safety. Clocking is often understood to be a threat (of violence or public outing) against the person being clocked. Use the term "Reading (Gender)" to refer to shared identification or recognized kinship between two individuals who are both gender minorities.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">T&#xE9;rmino de la jerga para el acto de identificar (o fichar) a alguien en p&#xFA;blico como trans, trasformista o drag cuando esa persona tiene la intenci&#xF3;n de pasar o ser interpretada por otros como cisg&#xE9;nero, generalmente por su seguridad personal. A menudo se entiende que el fichaje es una amenaza (de violencia o salida p&#xFA;blica) contra la persona que est&#xE1; siendo fichada. Util&#xED;cese el t&#xE9;rmino "Fichaje (G&#xE9;nero)" para referirse a la identificaci&#xF3;n compartida o el parentesco reconocido entre dos personas que pertenecen a minor&#xED;as de g&#xE9;nero.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Black queer people who recognize their queer identity as salient to their Blackness and vice versa; only use to describe individuals who identify as Blaqueer or BlaQ.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas negras queer que reconocen su identidad queer como imprescindible para su negritud y viceversa; util&#xED;cese para describir a personas que se autoidentifican como Blaqueer o BlaQ.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">LGBTQ+ people who do not identify as such to others.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas LGBTQ+ que no se autoidentifican como tales ante los dem&#xE1;s.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Transgender people who do not identify as such to others.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas transg&#xE9;nero que no se autoidentifican como tales ante los dem&#xE1;s.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Queer people who do not identify as such to others.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas queer que no se autoidentifican como tales ante los dem&#xE1;s.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Intersex people who do not disclose the fact that they are intersex to others.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas intersexuales que no revelan a los dem&#xE1;s el hecho de que son intersex.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Two-Spirit people who do not identify as such to others.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas de dos esp&#xED;ritus que no se autoidentifican como tales ante los dem&#xE1;s.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Individuals who pose as the date or partner of someone they are not in a relationship with, typically to prevent that person's sexuality from becoming public knowledge; most commonly used to refer to a woman pretending to be dating a gay man.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Abbreviation used to describe Two-Spirit people, lesbians, gay men, bisexual people, transgender people, queer people, and other gender and sexual minorities as a group; commonly used in Canada to emphasize the particularities of Indigenous people's experiences.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Abreviatura utilizada para describir a las personas dos esp&#xED;ritus, lesbiana, gay, bisexuales, transg&#xE9;nero, queer y otras minor&#xED;as sexuales y de g&#xE9;nero como grupo; com&#xFA;nmente utilizada en Canad&#xE1; para situar y centrar las experiencias particulares de las personas ind&#xED;genas.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Padding or phallic objects designed to be worn in the front of an individual's pants or underwear to give the appearance of having a bulge.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Objetos acolchados o f&#xE1;licos dise&#xF1;ados para usarse en la parte delantera de los pantalones o la ropa interior de una persona para dar la apariencia de tener un protuberancia.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">A romantic orientation characterized by the occurrence of romantic attraction or desire in a frequent and consistent manner, often alongside sexual attraction.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Una orientaci&#xF3;n rom&#xE1;ntica caracterizada por la atracci&#xF3;n o el deseo rom&#xE1;ntico de manera frecuente y constante, a menudo junto con la atracci&#xF3;n sexual.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">A romantic orientation characterized by the occurrence of romantic attraction or desire in a frequent and consistent manner toward more than one sex or gender.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Orientaci&#xF3;n rom&#xE1;ntica caracterizada por la atracci&#xF3;n o el deseo rom&#xE1;ntico de forma frecuente y constante hacia m&#xE1;s de un sexo o g&#xE9;nero.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">A romantic orientation characterized by the occurrence of romantic attraction or desire in a frequent and consistent manner toward members of the same sex or gender.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Una orientaci&#xF3;n rom&#xE1;ntica caracterizada por la ocurrencia de atracci&#xF3;n o deseo rom&#xE1;ntico de manera frecuente y consistente hacia miembros del mismo sexo o g&#xE9;nero.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">A romantic orientation characterized by the occurrence of romantic attraction or romantic desire in a frequent and consistent manner toward members of the opposite sex or gender.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Una orientaci&#xF3;n rom&#xE1;ntica caracterizada por la ocurrencia de atracci&#xF3;n rom&#xE1;ntica o deseo rom&#xE1;ntico de manera frecuente y consistente hacia miembros del sexo o g&#xE9;nero opuesto.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">A romantic orientation characterized by the occurrence of romantic attraction or romantic desire in a frequent and consistent manner irrespective of sex or gender.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Una orientaci&#xF3;n rom&#xE1;ntica caracterizada por la ocurrencia de atracci&#xF3;n rom&#xE1;ntica o deseo rom&#xE1;ntico de manera frecuente y consistente, independientemente del sexo o g&#xE9;nero.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Lesbians who belong to two or more racial groups. Only use to describe people who self-identify as biracial.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Lesbianas que pertenecen a dos o m&#xE1;s grupos raciales. Util&#xED;cese &#xFA;nicamente para personas que se autoidentifiquen como birraciales.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Gay men who belong to two or more racial groups. Only use to describe people who self-identify as biracial.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Hombres gay que pertenecen a dos o m&#xE1;s grupos raciales. Util&#xED;cese &#xFA;nicamente para personas que se autoidentifiquen como birraciales.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Bisexual people who belong to two or more racial groups. Only use to describe people who self-identify as biracial.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas bisexuales que pertenecen a dos o m&#xE1;s grupos raciales. Util&#xED;cese &#xFA;nicamente para personas que se autoidentifiquen como birraciales.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Transgender people who belong to two or more racial groups. Only use to describe people who self-identify as biracial.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas transg&#xE9;nero que pertenecen a dos o m&#xE1;s grupos raciales. Util&#xED;cese &#xFA;nicamente para personas que se autoidentifiquen como birraciales.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Queer people who belong to two or more racial groups. Only use to describe people who self-identify as biracial.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas queer que pertenecen a dos o m&#xE1;s grupos raciales. Util&#xED;cese &#xFA;nicamente para personas que se autoidentifiquen como birraciales.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Lesbians who belong to two or more racial groups.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Lesbianas que pertenecen a dos o m&#xE1;s grupos raciales. Util&#xED;cese &#xFA;nicamente para personas que se autoidentifiquen como multirraciales.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Gay men who belong to two or more racial groups.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Hombres gay que pertenecen a dos o m&#xE1;s grupos raciales. Util&#xED;cese &#xFA;nicamente para personas que se autoidentifiquen como multirraciales.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Bisexual people who belong to two or more racial groups.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas bisexuales que pertenecen a dos o m&#xE1;s grupos raciales. Util&#xED;cese &#xFA;nicamente para personas que se autoidentifiquen como multirraciales.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Transgender people who belong to two or more racial groups.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas transg&#xE9;nero que pertenecen a dos o m&#xE1;s grupos raciales. Util&#xED;cese &#xFA;nicamente para personas que se autoidentifiquen como multirraciales.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Queer people who belong to two or more racial groups.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas queer que pertenecen a dos o m&#xE1;s grupos raciales. Util&#xED;cese &#xFA;nicamente para personas que se autoidentifiquen como multirraciales.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Sexual attraction or erotic desire between members of the same sex or gender; typically used to describe temporary, latent, or unfulfilled desire rather than a more permanent sexual identity or orientation.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Atracci&#xF3;n sexual o deseo er&#xF3;tico entre miembros del mismo sexo o g&#xE9;nero; normalmente se utiliza para describir un deseo temporal, latente o insatisfecho en lugar de una identidad u orientaci&#xF3;n sexual m&#xE1;s permanente.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Statements used to caution individuals that materials may be disturbing or offensive. Includes warnings assigned to fanworks (usually by the creator) that give information about possibly upsetting, triggering, or controversial elements within a work.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Declaraciones utilizadas para advertir a personas que los materiales pueden ser perturbadores u ofensivos. Incluye advertencias asignadas a obras de fanwork (generalmente por el creador) que brindan informaci&#xF3;n sobre elementos posiblemente perturbadores, desencadenantes o controversiales dentro de una obra.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Sets of clothing worn to emulate a particular person, place, thing, or time period.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Conjuntos de ropa que se usan para emular a una persona, lugar, cosa o per&#xED;odo de tiempo particular.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Indigenous queer people who recognize their queer identity as salient to their Indigenous identity and vice versa; some but not all Indigiqueer people also identify as Two-Spirit; only use to describe individuals who self-identify as Indigiqueer.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas ind&#xED;genas queer que reconocen su identidad queer como parte importante de su identidad ind&#xED;gena y viceversa; algunas, pero no todas, las personas indigequeer tambi&#xE9;n se identifican como dos esp&#xED;ritus; util&#xED;cese &#xFA;nicamente para describir a personas que se autoidentifiquen como indigequeer.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Term used to describe the identity of people who are both Indigenous and queer and view those identities as inherently related and interconnected.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">T&#xE9;rmino utilizado para describir la identidad de personas que son tanto ind&#xED;genas como queer y ven esas identidades como inherentemente relacionadas e interconectadas.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">A group of Two-Spirit people united by their shared identity.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Grupos de personas que comparten la experiencia de la identidad dos esp&#xED;ritus.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">LGBTQ+ people who identify as both Pacific Islanders (or of Pacific Islander ancestry) and American.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas LGBTQ+ que se identifican a la vez como isle&#xF1;as del Pac&#xED;fico (o de ascendencia isle&#xF1;a del Pac&#xED;fico) y estadounidenses.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Special collections that hold materials primarily pertaining to LGBTQ+ people or intended for use by LGBTQ+ people. Special collections tend to be a blend of institutional types (e.g., an archives with a museum component). This term should be applied to institutions that refer to themselves as special collections; otherwise, use the term "LGBTQ+ cultural heritage institutions."</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Colecciones especiales que contienen materiales principalmente relacionados con personas LGBTQ+ o destinados a ser utilizados por personas LGBTQ+. Las colecciones especiales tienden a ser una combinaci&#xF3;n de tipos institucionales (por ejemplo, archivos con un componente de museo). Este t&#xE9;rmino debe aplicarse a instituciones que se refieran a s&#xED; mismas como colecciones especiales; de lo contrario, util&#xED;cese el t&#xE9;rmino "instituciones de patrimonio cultural LGBTQ+".</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Individuals who express fetishistic interest in and pursue sexual encounters with others based solely on their affiliation with a (typically marginalized) group that the chaser does not belong to. Often coupled with other terms to identify the type of chaser.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas que expresan inter&#xE9;s fetichista y buscan encuentros sexuales con otros bas&#xE1;ndose &#xFA;nicamente en su afiliaci&#xF3;n con un grupo (normalmente marginado) al que el perseguidor no pertenece. A menudo se combina con otros t&#xE9;rminos para identificar el tipo de perseguidor.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">LGBTQ+ people who have moved to another country.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas LGBTQ+ que se han mudado a otro pa&#xED;s.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Behaviors, acts, or forms of expression that contradict or do not conform to a given culture's norms surrounding gender.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Comportamientos, actos o formas de expresi&#xF3;n que contradicen o no se conforman a las normas de una cultura determinada en torno al g&#xE9;nero.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Individuals whose gender identities and practices differ from those of the dominant culture. Use the term "Sexual minorities" for individuals whose sexual identities, orientations, and practices differ from those of the dominant culture.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas cuyas identidades y pr&#xE1;cticas de g&#xE9;nero difieren de las de la cultura dominante. Util&#xED;cese el t&#xE9;rmino "minor&#xED;as sexuales" para personas cuyas identidades, orientaciones y pr&#xE1;cticas sexuales difieren de las personas de la cultura dominante.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">The practice or policy of providing equal access and support to trans people.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">La pr&#xE1;ctica o pol&#xED;tica de brindar igualdad de acceso y apoyo a las personas trans.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">The practice or policy of denying equal access and support to trans people.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">La pr&#xE1;ctica o pol&#xED;tica de negar la igualdad de acceso y apoyo a las personas trans.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Masculine-aligned identities or practices of trans people.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Identidades o pr&#xE1;cticas masculinas de personas trans.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Feminine-aligned identities or practices of trans people.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Identidades o pr&#xE1;cticas alineadas con lo femenino de personas trans.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">A term originating from Greek mythology that refers to beings that are both fully female and fully male. The term was once adopted in the medical realm to describe people with intersex variations generally (and later to describe someone with both ovarian and testicular tissue specifically), but it is now recognized to be stigmatizing, imprecise, and misleading. Many people in the intersex community consider the use of this term to be pathologizing and deeply offensive, while other intersex people have chosen to reclaim the term to describe themselves and their bodies. Do not use this term to describe an individual unless they explicitly identify with it and have chosen to use it.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">T&#xE9;rmino originado en la mitolog&#xED;a griega que se refiere a seres que son tanto completamente femeninos como completamente masculinos. El t&#xE9;rmino fue adoptado alguna vez en el &#xE1;mbito m&#xE9;dico para describir a personas con variaciones intersex en general (y m&#xE1;s tarde para describir a alguien con tejido tanto ov&#xE1;rico como testicular espec&#xED;ficamente), pero ahora se reconoce como estigmatizante, impreciso y enga&#xF1;oso. Muchas personas de la comunidad intersex consideran que el uso de este t&#xE9;rmino es patologizante y profundamente ofensivo, mientras que otras personas intersex han optado por reclamar el t&#xE9;rmino para describirse a s&#xED; mismas y a sus cuerpos. No utilice este t&#xE9;rmino para describir a una persona a menos que se identifique expl&#xED;citamente con &#xE9;l y haya elegido utilizarlo.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Individuals who experience romantic attraction or desire in a frequent and consistent manner, often alongside sexual attraction.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas que experimentan atracci&#xF3;n o deseo rom&#xE1;ntico de manera frecuente y constante, a menudo junto con la atracci&#xF3;n sexual.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Individuals who experience romantic attraction or desire in a frequent and consistent manner toward people of more than one sex or gender.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas que experimentan atracci&#xF3;n o deseo rom&#xE1;ntico de forma frecuente y constante hacia personas de m&#xE1;s de un sexo o g&#xE9;nero.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Individuals who experience romantic attraction or desire in a frequent and consistent manner toward members of the same sex or gender.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas que experimentan atracci&#xF3;n o deseo rom&#xE1;ntico de manera frecuente y constante hacia miembros del mismo sexo o g&#xE9;nero.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Individuals who experience romantic attraction or romantic desire in a frequent and consistent manner toward members of the opposite sex or gender.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas que experimentan atracci&#xF3;n rom&#xE1;ntica o deseo rom&#xE1;ntico de manera frecuente y consistente hacia miembros del sexo o g&#xE9;nero opuesto.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Individuals who experience romantic attraction or romantic desire toward others in a frequent and consistent manner irrespective of sex or gender.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas que experimentan atracci&#xF3;n rom&#xE1;ntica o deseo rom&#xE1;ntico hacia otras personas de manera frecuente y consistente, independientemente de su sexo o g&#xE9;nero.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">The direction or nature of an individual's romantic attraction toward others.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">La direcci&#xF3;n o naturaleza de la atracci&#xF3;n rom&#xE1;ntica de una personas hacia otras.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Individuals whose romantic orientations and/or practices differ from those of the dominant culture.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas cuyas orientaciones y/o pr&#xE1;cticas rom&#xE1;nticas difieren de las de la cultura dominante.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Publications or serials by or about LGBTQ+ people; use a more specific term if possible.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Publicaciones o series escritas por o sobre personas LGBTQ+; util&#xED;cese un t&#xE9;rmino m&#xE1;s espec&#xED;fico de ser posible.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Cultural experiences shared by members of LGBTQ+ communities or products of LGBTQ+ culture (e.g., art and media created by and for LGBTQ+ culture, activism focused on LGBTQ+ issues, slang commonly used in LGBTQ+ communities, etc.). Use a more specific term if possible.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Experiencias culturales compartidas por miembros de comunidades LGBTQ+ o productos de la cultura LGBTQ+ (por ejemplo, arte y medios creados por y para la cultura LGBTQ+, activismo centrado en cuestiones LGBTQ+, jerga com&#xFA;nmente utilizada en comunidades LGBTQ+, etc.). Util&#xED;cese un t&#xE9;rmino m&#xE1;s espec&#xED;fico de ser posible.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Cultural experiences shared by members of queer communities or products of queer culture (e.g., art and media created by and for queer people, activism focused on queer issues, slang commonly used in queer communities, etc.).</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Experiencias culturales compartidas por miembros de comunidades queer o productos de la cultura queer (por ejemplo, arte y medios creados por y para personas queer, activismo centrado en cuestiones queer, jerga com&#xFA;nmente utilizada en comunidades queer, etc.).</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Use to describe cultural experiences shared by members of bisexual communities or products of bisexual culture (e.g., art and media created by and for bisexual people, activism focused on bisexual issues, slang commonly used in bisexual communities, etc.).</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Util&#xED;cese para describir experiencias culturales compartidas por miembros de comunidades bisexuales o productos de la cultura bisexual (p. ej., arte y medios creados por y para personas bisexuales, activismo centrado en cuestiones bisexuales, jerga com&#xFA;nmente utilizada en comunidades bisexuales, etc.).</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Ceasing or reversing the process of gender transition for any reason, including personal safety, stigma, costs associated with transitioning, health concerns, to regain fertility, etc.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Cesar o revertir el proceso de transici&#xF3;n de g&#xE9;nero por cualquier motivo, incluida la seguridad personal, el estigma, los costos asociados con la transici&#xF3;n, problemas de salud, para recuperar la fertilidad, etc.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Restarting the process of gender transition after a period of detransitioning.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Reiniciar el proceso de transici&#xF3;n de g&#xE9;nero despu&#xE9;s de un per&#xED;odo de detransici&#xF3;n.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">No longer identifying as transgender, or, more broadly, no longer identifying as some particular gender.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Ya no identificarse como transg&#xE9;nero o, en t&#xE9;rminos m&#xE1;s generales, ya no identificarse con alg&#xFA;n g&#xE9;nero en particular.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Any of various surgeries that involve modifying the face or facial features to affirm the patient's gender.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Cualquiera de las diversas cirug&#xED;as que implican modificar el rostro o los rasgos faciales para afirmar el g&#xE9;nero del paciente.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Any of various surgeries undertaken to masculinize the face or facial features.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Cualquiera de las diversas cirug&#xED;as realizadas para masculinizar el rostro o los rasgos faciales.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Any of various surgeries undertaken to feminize the face or facial features.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Cualquiera de las diversas cirug&#xED;as realizadas para feminizar el rostro o los rasgos faciales.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Colloquial term for gender-affirming surgical alterations of the chest.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">T&#xE9;rmino coloquial para las alteraciones quir&#xFA;rgicas del t&#xF3;rax que afirman el g&#xE9;nero.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Reconstruction of the chest, typically following a mastectomy, to give the chest a more masculine appearance.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Reconstrucci&#xF3;n del t&#xF3;rax, generalmente despu&#xE9;s de una mastectom&#xED;a, para darle al t&#xF3;rax una apariencia m&#xE1;s masculina.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Any of various surgical procedures undertaken to feminize the voice.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Cualquiera de los diversos procedimientos quir&#xFA;rgicos realizados para feminizar la voz.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Any of various surgical procedures undertaken to masculinize the voice.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Cualquiera de los diversos procedimientos quir&#xFA;rgicos realizados para masculinizar la voz.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Surgical construction of the clitoris, often undertaken as a form of gender affirming surgery.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Construcci&#xF3;n quir&#xFA;rgica del cl&#xED;toris, a menudo realizada como una forma de cirug&#xED;a de afirmaci&#xF3;n de g&#xE9;nero.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Surgical construction of the labia.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Construcci&#xF3;n quir&#xFA;rgica de la labia</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Surgical procedure in which the urethra is elongated and placed along a neophallus, typically to allow for standing urination.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Procedimiento quir&#xFA;rgico en el que la uretra se alarga y se coloca a lo largo de un neofalo, generalmente para permitir orinar de pie.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Surgical construction of the scrotum.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Construcci&#xF3;n quir&#xFA;rgica del escroto.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Surgical removal of the vagina.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Extirpaci&#xF3;n quir&#xFA;rgica de la vagina.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">A surgery in which the laryngeal prominence, colloquially referred to as the Adam's apple, is reduced in size, often as part of facial feminization surgery for transfeminine people. Cisgender men and cisgender women may also undergo tracheal shaves if they feel their laryngeal prominence is too prominent.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Una cirug&#xED;a en la que se reduce de tama&#xF1;o la prominencia lar&#xED;ngea, coloquialmente conocida como la nuez de Ad&#xE1;n, a menudo como parte de una cirug&#xED;a de feminizaci&#xF3;n facial para personas transfemeninas. Los hombres y las mujeres cisg&#xE9;nero tambi&#xE9;n pueden someterse a un afeitado traqueal si sienten que su prominencia lar&#xED;ngea es demasiado prominente.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Surgical construction of the penis.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Construcci&#xF3;n quir&#xFA;rgica del pene.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Surgical construction of the vagina.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Construcci&#xF3;n quir&#xFA;rgica de la vagina.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Devices designed to allow individuals to pee while standing up; often used by trans men or transmasculine people to pee in public urinals without risking their safety.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">LGBTQ+ people who have left their home countries and are seeking protection from persecution and/or human rights violations in other countries but have not yet been legally recognized as refugees.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas LGBTQ+ que han abandonado sus pa&#xED;ses de origen y buscan protecci&#xF3;n en otros pa&#xED;ses contra la persecuci&#xF3;n y/o violaciones de derechos humanos, pero que a&#xFA;n no han sido reconocidas legalmente como refugiadas.</subfield>
  </datafield>
