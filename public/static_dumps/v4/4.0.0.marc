  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Personas bisexuales que son roman&#xED;es o parte del pueblo indoeuropeo tradicionalmente n&#xF3;mada.</subfield>
  </datafield>
