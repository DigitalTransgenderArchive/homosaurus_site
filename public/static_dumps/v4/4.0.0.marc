  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Opposition to various practices or fantasies involving sadomasochism or power exchange.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Accessories or devices used to restrict or confine the genitalia.</subfield>
