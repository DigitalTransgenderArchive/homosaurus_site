e":"en","@value":"Organized measures taken for the maintenance, treatment, or improvement of physical health or conditions of the body; use in reference to physical health care addressing the particular needs of LGBTQ+ individuals or communities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000614"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000614"},"dc:replaces":{"@id":"http://homosaurus.org/v2/physicalHealthCareForLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001360","dc:identifier":"homoit0001360","skos:prefLabel":{"@language":"en","@value":"Terminal care (AIDS)"},"rdfs:comment":{"@language":"en","@value":"End-of-life care for those with AIDS and their families; aimed at optimizing quality of life and mitigating suffering."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000614"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000848"},{"@id":"https://homosaurus.org/v3/homoit0002258"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85134007"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000614"},"dc:replaces":{"@id":"http://homosaurus.org/v2/terminalCareAIDS"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003361","dc:identifier":"homoit0003361","skos:prefLabel":{"@language":"en","@value":"Reproductive health care for LGBTQ+ people"},"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ reproductive health care"},{"@language":"en","@value":"Reproductive health care (LGBTQ)"},{"@language":"en","@value":"Reproductive healthcare for LGBTQ+ people"}],"rdfs:comment":{"@language":"en","@value":"Access to and experiences with reproductive health care for LGBTQ+ people. Reproductive health care includes birth control, abortion, assisted reproduction, and prenatal and obstetric care."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000614"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0003362"},{"@id":"https://homosaurus.org/v3/homoit0003363"},{"@id":"https://homosaurus.org/v3/homoit0003365"},{"@id":"https://homosaurus.org/v3/homoit0003366"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0003366"},{"@id":"https://homosaurus.org/v3/homoit0003368"},{"@id":"https://homosaurus.org/v3/homoit0003369"},{"@id":"https://homosaurus.org/v3/homoit0003593"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000614"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-19"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003514","dc:identifier":"homoit0003514","skos:prefLabel":{"@language":"en","@value":"Health care for transgender children and youth"},"skos:altLabel":[{"@language":"en","@value":"Health care for trans children and youth"},{"@language":"en","@value":"Trans health care for children and youth"},{"@language":"en","@value":"Transgender health care for children and youth"}],"rdfs:comment":{"@language":"en","@value":"Organized measures taken for the maintenance or improvement of health via the prevention, diagnosis, and/or treatment of physical and mental health issues faced by transgender children and youth. This includes but is not limited to access to safe, legal therapy and counseling, hormone treatment, and gender-affirming surgery."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000614"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001400"},{"@id":"https://homosaurus.org/v3/homoit0001452"},{"@id":"https://homosaurus.org/v3/homoit0003502"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000614"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000876","dc:identifier":"homoit0000876","skos:prefLabel":[{"@language":"en-us","@value":"LGBTQ+ health care centers"},{"@language":"en-gb","@value":"LGBTQ+ health care centres"}],"rdfs:comment":{"@language":"en","@value":"Institutions providing health services for LGBTQ+ people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000830"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000614"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQHealthCareCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003694","dc:identifier":"homoit0003694","skos:prefLabel":{"@language":"en","@value":"Impact of COVID-19 pandemic on LGBTQ+ people"},"skos:altLabel":[{"@language":"en","@value":"COVID-19 pandemic impact on LGBTQ+ people"},{"@language":"en","@value":"Impact of pandemic on LGBTQ+ people"},{"@language":"en","@value":"Pandemic impact on LGBTQ+ people"},{"@language":"en","@value":"COVID-19 pandemic and LGBTQ+ people"},{"@language":"en","@value":"COVID-19 and LGBTQ+ people"}],"rdfs:comment":{"@language":"en","@value":"The particular impact of the COVID-19 pandemic on LGBTQ+ people and communities, including changes in access to health care, intimate relationship dynamics and safer sex practices, financial stability, social connectedness, and mental health."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000614"},{"@id":"https://homosaurus.org/v3/homoit0000947"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0003694"},"dc:issued":{"@ty