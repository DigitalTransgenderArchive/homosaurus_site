oit0003737"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000356"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-17"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001893","dc:identifier":"homoit0001893","skos:prefLabel":{"@language":"en","@value":"Anti-intersex discrimination"},"rdfs:comment":{"@language":"en","@value":"The unjust or prejudicial treatment of intersex people due to the fact that they are intersex; may include the denial of legal rights, employment, and housing."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000356"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000112"},{"@id":"https://homosaurus.org/v3/homoit0000666"},{"@id":"https://homosaurus.org/v3/homoit0003737"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2016001192"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000356"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-28"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002899","dc:identifier":"homoit0002899","skos:prefLabel":{"@language":"en","@value":"Anti-asexual discrimination"},"rdfs:comment":{"@language":"en","@value":"The unjust or prejudicial treatment of asexual people due to their sexual identity; may include the denial of legal rights, employment, and housing."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000356"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000112"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000356"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-29"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000113","dc:id