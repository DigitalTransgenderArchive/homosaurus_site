1891","dc:identifier":"homoit0001891","skos:prefLabel":{"@language":"en","@value":"Crip"},"rdfs:comment":{"@language":"en","@value":"A shortened form of the word \"cripple\" that has been reclaimed by disabled people to express pride and identify their political and community ties. Only use in reference to individuals or organizations that self-identify as crip. Because of the many intersections between crip theory/culture and queer theory/culture, the two are often but not always viewed as related."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001559"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001149"},{"@id":"https://homosaurus.org/v3/homoit0001854"},{"@id":"https://homosaurus.org/v3/homoit0001878"},{"@id":"https://homosaurus.org/v3/homoit0001879"},{"@id":"https://homosaurus.org/v3/homoit0002577"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001317"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002042","dc:identifier":"homoit0002042","skos:prefLabel":{"@language":"en","@value":"Queer gaze"},"rdfs:comment":{"@language":"en","@value":"A term used to describe the ways LGBTQ+ people create and engage with media and art, in contrast to the male gaze, female gaze, or straight gaze."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001219"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001149"},{"@id":"https://homosaurus.org/v3/homoit0002040"},{"@id":"https://homosaurus.org/v3/homoit0002041"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002577","dc:identifier":"homoit0002577","skos:prefLabel":{"@language":"en","@value":"Queercrip"},"skos:altLabel":{"@language":"en","@value":"Cripqueer"},"rdfs:comment":{"@language":"en","@value":"A portmanteau of two reclaimed terms (queer and crip) used to indicate that a person or a thing belongs to both queer and crip communities, often used to indicate unity or shared struggles. This term may also appear as \"cripqueer\" to emphasize the crip identity before the queer one.\t\t\t\t"},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001559"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001149"},{"@id":"https://homosaurus.org/v3/homoit0001195"},{"@id":"https://homosaurus.org/v3/homoit0001854"},{"@id":"https://homosaurus.org/v3/homoit0001879"},{"@id":"https://homosaurus.org/v3/homoit0001891"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001317"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001178","dc:identifier":"homoit0001178","skos:prefLabel":{"@language":"en","@value":"Queer identity"},"rdfs:comment":{"@language":"en","@value":"Identity term that can be used to describe several not-necessarily-mutually-exclusive understandings of queerness. Queerness can describe identities that exist outside of or between different identities, and also identities that actively resist normative understandings of sexuality and/or gender. This term should only be used for those who self-identify as queer."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001295"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001167"},{"@id":"https://homosaurus.org/v3/homoit0001195"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date