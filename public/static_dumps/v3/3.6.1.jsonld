853"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPetitions"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000935","dc:identifier":"homoit0000935","skos:prefLabel":[{"@language":"en-us","@value":"LGBTQ+ self-defense"},{"@language":"en-gb","@value":"LGBTQ+ self-defence"}],"rdfs:comment":{"@language":"en","@value":"Countermeasures taken by an LGBTQ+ person to protect their own health or well being from harm."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000853"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSelfDefence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001255","dc:identifier":"homoit0001255","skos:prefLabel":{"@language":"en","@value":"Same-sex divorce"},"rdfs:comment":{"@language":"en","@value":"A legal proceeding undertaken to dissolve a marriage between two individuals of the same sex."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000854"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005000375"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sameSexDivorce"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001285","dc:identifier":"homoit0001285","skos:prefLabel":{"@language":"en","@value":"Sexual assault"},"rdfs:comment":{"@language":"en","@value