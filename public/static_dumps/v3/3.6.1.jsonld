abel":[{"@language":"en","@value":"Fan fic"},{"@language":"en","@value":"Fan fiction"},{"@language":"en","@value":"Fanfic"}],"rdfs:comment":{"@language":"en","@value":"Written works of fiction created by fans that use the characters, settings, and/or plots of other media properties in a transformative way."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002161"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002160"},{"@id":"https://homosaurus.org/v3/homoit0002179"},{"@id":"https://homosaurus.org/v3/homoit0002205"},{"@id":"https://homosaurus.org/v3/homoit0002210"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000443"},{"@id":"https://homosaurus.org/v3/homoit0002155"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006002523"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002179","dc:identifier":"homoit0002179","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ fanfiction"},"skos:altLabel":[{"@language":"en","@value":"Fan fic (LGBTQ)"},{"@language":"en","@value":"Fan fics (LGBTQ)"},{"@language":"en","@value":"Fan fiction (LGBTQ)"},{"@language":"en","@value":"Fanfiction (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ fan fics"},{"@language":"en","@value":"LGBTQ+ fan fiction"},{"@language":"en","@value":"LGBTQ+ fanfics"}],"rdfs:comment":{"@language":"en","@value":"Fanfiction that primarily focuses on LGBTQ+ people, communities, and relationships, often using characters who are not stated to be LGBTQ+ in canon."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002159"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000443"},{"@id":"https://homosaurus.org/v3/homoit0001522"},{"@id":"https://homosaurus.org/v3/homoit0001723"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002180","dc:identifier":"homoit0002180","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ headcanons"},"skos:altLabel":{"@language":"en","@value":"Headcanons (LGBTQ)"},"rdfs:comment":{"@language":"en","@value":"Fans' personal interpretations of media properties and texts, particularly relating to the personalities and behaviors of characters. Use to describe headcanons that certain characters or relationships are LGBTQ+, as well as headcanons about other LGBTQ+ people and issues in the universe of the text."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001149"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000443"},{"@id":"https://homosaurus.org/v3/homoit0002199"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001149"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002188","dc:identifier":"homoit0002188","skos:prefLabel":{"@language":"en","@value":"Original slash fiction"},"rdfs:comment":{"@language":"en","@value":"Original works of creative fiction that focus on same-sex or same-gender relationships and incorporate tropes from fanfiction; includes femslash fiction."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002205"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000443"},{"@id":"https://homosaurus.org/v3/homoit0000859"},{"@id":"https://homosaurus.org/v3/homoit0002217"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-31"},"@type