l":[{"@language":"en","@value":"Indigenous nonbinary people"},{"@language":"en","@value":"Non-binary Indigenous people"},{"@language":"en","@value":"Nonbinary Indigenous people"}],"rdfs:comment":{"@language":"en","@value":"Non-binary people who are part of an Indigenous people, or culturally distinct ethnic group whose members are directly descended from the earliest known inhabitants of a particular region and, to some extent, maintain the language and culture of those people. Only use to describe people who identify as Indigenous; use more specific terms whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000886"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002377","dc:identifier":"homoit0002377","skos:prefLabel":{"@language":"en","@value":"Police harassment of Indigenous LGBTQ+ people"},"rdfs:comment":{"@language":"en","@value":"Any of various forms of inappropriate conduct, illegal actions, or abuses of power undertaken by law enforcement agents or agents of the state against Indigenous LGBTQ+ members of the public. This includes but is not limited to racial, ethnic, and other forms of profiling; unwarranted surveillance, searches, and seizure; selective enforcement; excessive use of force; sexual misconduct; intimidation and witness tampering; falsification of evidence; coerced confessions; false arrests and imprisonment; and bribing or lobbying."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002375"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000886"},{"@id":"https://homosaurus.org/v3/homoit0002397"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000611"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000924","dc:identifier":"homoit0000924","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ prisoners of conscience"},"skos:altLabel":[{"@language":"en","@value":"Prisoners of conscience (LGBTQ)"},{"@language":"en","@value":"LGBTQ prisoners of conscience"}],"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who are imprisoned because of their sexual or gender identities; may also be used to describe LGBTQ+ individuals imprisoned because of their race, religion, or political views."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000887"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPrisonersOfConscience"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000890","dc:identifier":"homoit0000890","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ Judaism"},"skos:altLabel":{"@language":"en","@value":"LGBTQ Judaism"},"rdfs:comment":{"@language":"en","@value":"Jewish religion and culture as practiced by LGBTQ+ people"},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000928"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000046"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000682"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000928"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000682"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQJudaism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-10-04"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000892","dc:identifier":"homoit0000892","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ literary salons"},"skos:altLabel":{"@language":"en","@value":"LGBTQ literary salons"},"rdfs:comment":{"@language":"en","@value":"Social gatherings, typically hosted by a notable public figure, for discussing literature or other shared topics; use in reference to literary salons with primarily LGBTQ+ membership or literary salons focused on works featuring LGBTQ+ characters and themes."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000909"},{"@id":"https://homosaurus.org/v3/homoit0000972"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000892"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQLiterarySalons"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000921","dc:identifier":"homoit0000921","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ platonic love"},"skos:altLabel":[{"@language":"en","@value":"LGBTQ platonic love"},{"@language":"en","@value":"Queerplatonic"}],"rdfs:comment":{"@language":"en","@value":"Deep feelings of affection between two or more LGBTQ+ people that is neither sexual nor romantic."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000894"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0003592"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPlatonicLove"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000957","dc:identifier":"homoit0000957","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ unrequited love"},"skos:altLabel":{"@language":"en","@value":"LGBTQ unrequited love"},"rdfs:comment":{"@language":"