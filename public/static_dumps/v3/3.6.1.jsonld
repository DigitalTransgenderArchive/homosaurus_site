"Two-Spirit information centres"},{"@language":"en","@value":"Two-Spirited information centers"}],"rdfs:comment":{"@language":"en","@value":"Institutions providing education, support, and information about Two-Spirit issues and Two-Spirit communities to Two-Spirit people."},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000660"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002696"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000877","dc:identifier":"homoit0000877","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ health education"},"skos:altLabel":{"@language":"en","@value":"LGBTQ health education"},"rdfs:comment":{"@language":"en","@value":"Instruction about health for LGBTQ+ people, including topics such as gender-affirming healthcare and safer sex practices. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000661"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000661"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQHealthEducation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003617","dc:identifier":"homoit0003617","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ information professionals"},"skos:altLabel":{"@language":"en","@value":"Information professionals (LGBTQ+)"},"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people whose profession involves managing information by collecting, organizing, storing and disseminating it. This can include but is not limited to librarians, archivists, metadata and IT workers, web developers, and chief information officers. Use more specific terms when possible."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0003547"},{"@id":"https://homosaurus.org/v3/homoit0003618"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000661"},{"@id":"https://homosaurus.org/v3/homoit0000825"},{"@id":"https://homosaurus.org/v3/homoit0003619"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0003617"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000665","dc:identifier":"homoit0000665","skos:prefLabel":{"@language":"en","@value":"Internet forums"},"rdfs:comment":{"@language":"en","@value":"Websites designed to facilitate discussion amongst users through posted messages."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001321"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000888"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97004057"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001321"},"dc:replaces":{"@id":"http://homosaurus.org/v2/internetForums"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000888","dc:identifier":"homoit0000888","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ Internet forums"},"skos:altLabel":{"@language":"en","@value":"LGBTQ Internet forums"},"rdfs:comment":{"@language":"en","@value":"Websites that facilitate online conversations between LGBTQ+ people, often about LGBQ+ issues."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000665"},{"@id":"https://homosaurus.org/v3/homoit0000946"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000962"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001321"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQInternetForums"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002595","dc:identifier":"homoit0002595","skos:prefLabel":{"@language":"en","@value":"Internalized intersexphobia"},"skos:altLabel":{"@language":"en","@value":"Internalized interphobia"},"rdfs:comment":{"@language":"en","@value":"The phenomenon in which intersex people internalize or adopt intersexphobic beliefs (i.e., negative perceptions of and intolerance toward intersex people and intersex variations) as a result of being raised or socialized within a intersexphobic environment or culture."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000666"},{"@id":"https://homosaurus.org/v3/homoit0002590"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0003097"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002272","dc:identifier":"homoit0002272","skos:prefLabel":{"@language":"en","@value":"Womanism"},"skos:altLabel":{"@language":"en","@value":"Womanist theory"},"rdfs:comment":{"@language":"en","@value":"A social theory based on the history and everyday experiences of Black women. Womanism grew out of the perceived indifference of the feminist movement towards the needs of Black women, who are often excluded from the categories of \"female\" and \"femininity\" as understood by white feminists. At the core of womanism is the idea that mainstream feminism is a movement led by white women to serve white women's goals, which can be indifferent or even oppositional to the needs of Black women."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001365"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000667"},{"@id":"https://homosaurus.org/v3/homoit0002038"},{"@id":"https://homosaurus.org/v3/homoit0002270"},{"@id":"https://homosaurus.org/v3/homoit0002271"},{"@id":"https://homosaurus.org/v3/homoit0003176"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006001576"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-08"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000692","dc:identifier":"homoit0000692","skos:prefLabel":{"@language":"en","@value":"Klinefelter syndrome"},"skos:altLabel":{"@language":"en","@value":"47XXY"},"rdfs:comment":{"@language":"en","@value":"People with Klinefelter syndrome develop with an extra copy of the X chromosome, resulting in a 47XXY pattern (instead of the typical 46XY). These individuals might have smaller-than-typical testes that produce lower amounts of testosterone and/or sperm, and they may start puberty later than typical (or may not go through puberty without hormone therapy). They may grow taller than usual, may develop breast tissue, and often experience infertility. This variation often does not cause obvious physical differences, and many people do not realize they have it."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85072641"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/klinefelterSyndrome"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001014","dc:identifier":"homoit0001014","skos:prefLabel":{"@language":"en","@value":"Micropenis"},"skos:altLabel":{"@language":"en","@value":"Microphallus"},"rdfs:comment":{"@language":"en","@value":"A person born with a micropenis has a penis that is smaller than the typical size range for an infant. People may also develop a micropenis as a result of several different intersex variations. The size of a person’s penis does not generally affect its functionality."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/micropenis"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001020","dc:identifier":"homoit0001020","skos:prefLabel":{"@language":"en","@value":"Mosaicism involving \"sex\" chromosomes"},"rdfs:comment":{"@language":"en","@value":"People with mosaic chromosomes have different chromosome patterns in some cells of their body than in others. Mosaicism results from random differences in how cells divide while an embryo is growing, resulting in different numbers of chromosomes in different cells (such as 45X/46XX or 45X/46XY, which are both variants of Turner syndrome, or 46XY/47XXY or 46XX/47XXY, which are both variants of Klinefelter syndrome). If someone specifically has 46XX chromosomes in some cells and 46XY in others, their variation is probably chimerism instead of mosaicism. Having mosaic chromosomes can cause someone to develop variations in their genitals, gonads, or hormone function. For example, if they have at least one Y chromosome, they may have both ovarian and testicular tissue, or genital differences like hypospadias, or they may develop some secondary sex characteristics at puberty that are not expected for the sex they were assigned. People who have mosaicism without a Y chromosome (e.g., 45X/46XX, or 46XX/47XXX) may have streak gonads or ovaries that stop functioning at an earlier age than typical, which can affect development during puberty and fertility. Other people may not have any noticeable signs of their mosaicism at all."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85087417"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mosaicismInvolvingSexChromosomes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001066","dc:identifier":"homoit0001066","skos:prefLabel":{"@language":"en","@value":"Ovo-testes"},"skos:altLabel":[{"@language":"en","@value":"True hermaphroditism"},{"@language":"en","@value":"\"Ovotesticular DSD \""}],"rdfs:comment":{"@language":"en","@value":"People with this variation are born with both ovarian and testicular tissue. A person can develop one testis and one ovary, or they may develop one or more ovo-testes, which means that a single gonad is made up of both ovarian and testicular cells. The levels of hormones they produce can vary and how their genitals and secondary sex characteristics develop will depend partially on the levels of estrogen and testosterone that their bodies make. In adolescence, people with ovo-testes may develop features associated with either a typical estrogen puberty or a typical testosterone puberty, or they may develop some of each. Sometimes a person with an ovary and a testis or with ovo-testes can produce viable sperm and viable eggs."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ovoTestes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001134","dc:identifier":"homoit0001134","skos:prefLabel":{"@language":"en","@value":"Progestin induced virilization"},"rdfs:comment":{"@language":"en","@value":"People born with progestin-induced virilization have XX chromosomes and may have visible genital variations at birth such as a larger-than-typical clitoris, sometimes also with fused or partially fused labia. They usually have a typical uterus, ovaries, and fallopian tubes, though their vagina may or may not have differences. This variation develops in utero as a result of the individual's parent taking progestin medication while pregnant. Being exposed to these additional hormones before birth can change how someone’s genitals develop, but it generally will not change how their own body will produce or respond to hormones later on. This means that someone born with progestin-induced virilization will usually develop features associated with a typical estrogen puberty."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/progestinInducedVirilization"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001354","dc:identifier":"homoit0001354","skos:prefLabel":{"@language":"en","@value":"Swyer syndrome"},"skos:altLabel":{"@language":"en","@value":"XY Gonadal dysgenesis"},"rdfs:comment":{"@language":"en","@value":"Swyer syndrome occurs when a person is born with XY chromosomes, but their gonads have not developed into testes. It is a form of gonadal dysgenesis, meaning that a person with this variation will have streak gonads that do not produce hormones. Since they do not produce testosterone, their body does not develop a penis and usually develops a vulva and vagina instead. Since they do not produce another hormone known as anti-Müllerian hormone (AMH), people with Swyer syndrome often develop a uterus and fallopian tubes as well. They will not usually start puberty or begin menstruating, but some people with Swyer syndrome do menstruate (without ovulating) if they receive estrogen therapy."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/swyerSyndrome"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001478","dc:identifier":"homoit0001478","skos:prefLabel":{"@language":"en","@value":"Turner syndrome"},"rdfs:comment":{"@language":"en","@value":"Turner syndrome is a variation in which a person is born with a 45X chromosome pattern (sometimes called 45XO) rather than the typical 46XX. People with Turner syndrome often share specific physical features such as short stature, a webbed neck and broad chest, and heart issues. They can also develop variations in their other sex characteristics, such as smaller-than-typical ovaries that may stop producing hormones at a younger age than typical, and they might not menstruate or experience pubertal changes."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85138930"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/turnerSyndrome"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002818","dc:identifier":"homoit0002818","skos:prefLabel":{"@language":"en","@value":"17-beta hydroxysteroid dehydrogenase 3 deficiency"},"skos:altLabel":{"@language":"en","@value":"17-beta"},"rdfs:comment":{"@language":"en","@value":"People with 17-beta hydroxysteroid dehydrogenase 3 deficiency, abbreviated as \"17-beta,\" have XY chromosomes and testes, but their bodies do not have one of the enzymes needed to synthesize testosterone. Most people with 17-beta are born with a vulva and vagina, and their testes are most often undescended. Some people with 17-beta will be born with genitals that do not clearly resemble a typical penis or a typical vulva. Some will have a penis that may be smaller than typical (known as a micropenis), and the urethra may open on the underside of the penis rather than at the tip (known as hypospadias). In adolescence, people with 17-beta will often develop some secondary sex characteristics associated with a typical testosterone puberty."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002819","dc:identifier":"homoit0002819","skos:prefLabel":{"@language":"en","@value":"Ambiguous genitalia"},"rdfs:comment":{"@language":"en","@value":"A term used to describe a birth variation in which the outer genitals do not have the typical appearance of those associated with either boys or girls. This is often the first sign many doctors and parents see that indicate their child has an intersex variation. Ambiguous genitalia can be caused by a variety of variations and rarely require immediate surgical intervention as long as the child is able to excrete and urinate without complications. Many intersex people find this term stigmatizing, so it should not be used unless the individual uses it to describe themselves."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002821","dc:identifier":"homoit0002821","skos:prefLabel":{"@language":"en","@value":"Anorchia"},"rdfs:comment":{"@language":"en","@value":"A person with anorchia has 46 XY chromosomes and is born without testes. As a result, they do not produce typical levels of testosterone. Someone with anorchia will usually have a typical-appearing penis and scrotum because these organs are already formed by the stage of fetal development when the testes disappear."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002822","dc:identifier":"homoit0002822","skos:prefLabel":{"@language":"en","@value":"Aromatase deficiency"},"rdfs:comment":{"@language":"en","@value":"People with aromatase deficiency do not have the enzyme responsible for converting androgens into estrogen. At birth, someone with aromatase deficiency and XX chromosomes may have a larger-than-typical clitoris and partially or completely fused labia (resembling the appearance of a scrotum). At puberty, they may not develop breasts, may not begin menstruating, and may develop some secondary sex characteristics associated with a typical testosterone puberty. They may also develop multiple cysts on their ovaries. People with XY chromosomes can also have aromatase deficiency, but they do not typically experience variations in their sex characteristics, though they may grow taller than is typical because estrogen is usually responsible for closing the bone growth plates."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002823","dc:identifier":"homoit0002823","skos:prefLabel":{"@language":"en","@value":"Aromatase excess syndrome"},"skos:altLabel":[{"@language":"en","@value":"Familial gynecomastia"},{"@language":"en","@value":"Hyperestrogenism "}],"rdfs:comment":{"@language":"en","@value":"People with aromatase excess have increased production of aromatase, which converts androgens (like testosterone) into estrogen. People with XY chromosomes and aromatase excess syndrome will therefore have more active estrogen in their bodies than is typical. As a result, they will often stop growing at a shorter height and/or develop breasts in adolescence along with features associated with a typical testosterone puberty. People with XX chromosomes can also have aromatase excess, but it doesn't usually cause their sex characteristics to vary from what is considered typical for those assigned female at birth, though they may also experience breast enlargement and short stature, along with menstrual irregularities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002824","dc:identifier":"homoit0002824","skos:prefLabel":{"@language":"en","@value":"Bladder exstrophy"},"rdfs:comment":{"@language":"en","@value":"People with bladder exstrophy are born with their urinary bladder exposed (through an open abdominal wall) or outside of the body. They may also have an open pelvis (resulting from the pubic bones not joining together), which causes genital differences. People with bladder exstrophy and XY chromosomes often have a shorter-than-typical penis with epispadias (meaning the urethra opens on the top surface of the penis instead of at the tip) and undescended testes. People with XX chromosomes and bladder exstrophy often have a urethra that is placed higher than usual, widely spaced labia (due to the wide spacing of their pubic bones), and a clitoris formed in two halves with a split in the middle."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85014741"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002826","dc:identifier":"homoit0002826","skos:prefLabel":{"@language":"en","@value":"Chimerism"},"rdfs:comment":{"@language":"en","@value":"Term used to describe the variation in which a person is born with two or more different sets of DNA. This can occur when multiple zygotes (such as fraternal twins) combine and develop into one fetus. Sex-chromosome discordant chimerism occurs when at least one embryo with XX chromosomes fuses with at least one embryo with XY chromosomes. A person who develops this way would have sets of both XX and XY chromosomes, or a chromosome pattern of 46XX/46XY, and could have a wide variety of different possible sex characteristics. Many people with chimerism and XX/XY chromosomes have both ovarian and testicular tissue, while others have only testes or only ovaries, and still others have gonadal dysgenesis. Some have noticeable genital differences and others do not."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2011001809"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002828","dc:identifier":"homoit0002828","skos:prefLabel":{"@language":"en","@value":"Cloacal exstrophy"},"rdfs:comment":{"@language":"en","@value":"People born with cloacal exstrophy are born with an open abdominal wall exposing their colon, bladder, and sometimes other abdominal organs. Their organs may also be positioned outside of the body at birth. The bladder is often split into two halves, and the colon and bladder may be connected. The anal opening may be blocked or not have been formed. The pubic bones do not join together, resulting in an open pelvis with noticeable genital differences. People with XY chromosomes and cloacal exstrophy may have a smaller-than-typical penis that is flat or split into two halves with an epispadic urethra (opening on the top of the penis rather than at the tip) and undescended testes. Someone with XX chromosomes and cloacal exstrophy usually has a clitoris that is split into two halves, and they may have two vaginal openings."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh90003339"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002829","dc:identifier":"homoit0002829","skos:prefLabel":{"@language":"en","@value":"Complete androgen insensitivity syndrome"},"skos:altLabel":{"@language":"en","@value":"CAIS"},"rdfs:comment":{"@language":"en","@value":"People with complete androgen insensitivity syndrome (CAIS) have no response to androgens and are born with a vulva and clitoris, as well as a shorter-than-typical vagina and undescended testes. In adolescence, they will develop breasts and other features associated with a typical estrogen puberty due to the body’s natural conversion of testosterone to estrogen. However, people with CAIS do not menstruate because they do not have a uterus or ovaries."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002831","dc:identifier":"homoit0002831","skos:prefLabel":{"@language":"en","@value":"Congenital chordee"},"rdfs:comment":{"@language":"en","@value":"People born with congenital chordee have a penis that curves upward or downward or bends to one side, usually due to bands of fibrous tissue that pull the penis in a particular direction. People with congenital chordee often have hypospadias, meaning that their urethral opening is not at the tip of the penis."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002832","dc:identifier":"homoit0002832","skos:prefLabel":{"@language":"en","@value":"Cryptorchidism"},"skos:altLabel":[{"@language":"en","@value":"Undescended testes"},{"@language":"en","@value":"Undescended testicles"}],"rdfs:comment":{"@language":"en","@value":"An intersex variation in which one or both of the testes do not descend from the abdomen into the scrotum. If both testes are undescended, this is known as \"bilateral cryptorchidism,\" whereas \"unilateral cryptorchidism\" occurs when only one the testes does not descend."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85034467"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002833","dc:identifier":"homoit0002833","skos:prefLabel":{"@language":"en","@value":"De la Chapelle syndrome"},"skos:altLabel":{"@language":"en","@value":"XX male syndrome"},"rdfs:comment":{"@language":"en","@value":"De la Chapelle syndrome causes people with XX chromosomes to be born with a penis and testes. This usually happens because a particular gene typically seen on Y chromosomes (known as the SRY gene) ends up on one of their X chromosomes and causes their genitals and internal reproductive organs to develop as they typically would in someone with XY chromosomes. People with de la Chapelle might have testes that are smaller than typical or that are undescended, and they are often infertile. In adolescence, they may experience breast growth, and they might not develop the characteristics that are usually associated with a typical testosterone puberty."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002836","dc:identifier":"homoit0002836","skos:prefLabel":{"@language":"en","@value":"Epispadias"},"skos:altLabel":{"@language":"en","@value":"Anaspadias"},"rdfs:comment":{"@language":"en","@value":"People with epispadias are born with a urinary opening located on the upper surface of their penis rather than at the tip (similar to the more common variation hypospadias). People with vulvas can also be born with epispadias, in which case the urethral opening is wider and located higher than typical. The clitoris may also be split into two halves. Epispadias is usually present whenever bladder exstrophy or cloacal exstrophy develop, but epispadias can also occur by itself."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85044450"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002837","dc:identifier":"homoit0002837","skos:prefLabel":{"@language":"en","@value":"Estrogen insensitivity syndrome"},"skos:altLabel":{"@language":"en","@value":"EIS"},"rdfs:comment":{"@language":"en","@value":"People with estrogen insensitivity syndrome (EIS) have a genetic variation in which their bodies do not respond to estrogen. People with XX chromosomes and EIS are usually born with a vulva and vagina, may have a small uterus and enlarged ovaries that later develop multiple cysts, and may produce very high levels of estrogen that their bodies do not recognize. In adolescence, they will most likely not experience the changes associated with a typical estrogen puberty such as breast development or menstruation. They may instead develop pubic hair and acne due to the influence of androgens. People with XY chromosomes can also be born with EIS, and they may or may not experience variations in their other hormone production, testicular development, and development of secondary sex characteristics as a result."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002838","dc:identifier":"homoit0002838","skos:prefLabel":{"@language":"en","@value":"Follicle-stimulating hormone insensitivity"},"skos:altLabel":[{"@language":"en","@value":"FSH "},{"@language":"en","@value":"FSH insensitivity"}],"rdfs:comment":{"@language":"en","@value":"People with follicle-stimulating hormone (FSH) insensitivity have a genetic variation where their bodies do not respond to FSH. People with XX chromosomes and FSH insensitivity will usually be born with a vulva, vagina, and ovaries. Their ovaries may produce lower amounts of estrogen than is considered typical, and they may not produce fertile follicles (eggs). In adolescence, they may not develop secondary sex characteristics associated with a typical estrogen puberty and may not menstruate. People with XY chromosomes and FSH insensitivity may develop smaller-than-typical testes, may produce fewer sperm than usual, and may not be fertile."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002839","dc:identifier":"homoit0002839","skos:prefLabel":{"@language":"en","@value":"Fraser syndrome"},"rdfs:comment":{"@language":"en","@value":"People with Fraser syndrome are usually born with differences in the development of their eyelids, fingers, and toes. They may also have variations in their sex characteristics, such as a larger-than-typical clitoris or undescended testes. They may develop without one or both kidneys, and other parts of the urinary system can additionally be affected."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002842","dc:identifier":"homoit0002842","skos:prefLabel":{"@language":"en","@value":"Hyperandrogenism"},"rdfs:comment":{"@language":"en","@value":"People with hyperandrogenism have higher-than-typical levels of testosterone and/or other androgens. In people with XX chromosomes, hyperandrogenism can result in the development of secondary sex characteristics that are associated with the influence of testosterone (such as facial and body hair) to varying degrees. Hyperandrogenism may or may not be the result of an underlying intersex variation, but it is common in several variations (including CAH and PCOS). People with hyperandrogenism who aren’t intersex will nonetheless often have many experiences in common with intersex people, such as encountering exclusion and discrimination in sex-segregated contexts like sports."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97002310"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002843","dc:identifier":"homoit0002843","skos:prefLabel":{"@language":"en","@value":"Hypogonadism"},"rdfs:comment":{"@language":"en","@value":"People with hypogonadism produce lower-than-typical levels of hormones like testosterone and estrogen, or none at all. This can affect how a person’s secondary sex characteristics develop as well as their fertility. Hypogonadism can be a result of a difference in how someone’s brain signals for their gonads to produce (or not produce) hormones, or it can be a feature of their gonads directly. Hypogonadism is not always caused by an intersex variation, but can be related to Klinefelter syndrome, Turner syndrome, and several other variations."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85063790"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002848","dc:identifier":"homoit0002848","skos:prefLabel":{"@language":"en","@value":"Isolated 17,20-lyase deficiency"},"skos:altLabel":{"@language":"en","@value":"ILD"},"rdfs:comment":{"@language":"en","@value":"People with isolated 17,20-lyase deficiency (ILD) have one of several specific variations in their genes that cause their bodies to make lower-than-typical amounts of testosterone. They may be born with genitals that do not appear quite like a typical penis, and their testes may be descended or undescended. In adolescence, they may not experience all of the changes related to a typical testosterone puberty because their variation impacts their hormone production."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002861","dc:identifier":"homoit0002861","skos:prefLabel":{"@language":"en","@value":"Jacobs syndrome"},"skos:altLabel":[{"@language":"en","@value":"47XYY"},{"@language":"en","@value":"XYY syndrome"}],"rdfs:comment":{"@language":"en","@value":"People with Jacobs syndrome develop with an extra Y chromosome. They might not have any obvious physical variations as a result, or they may be taller than usual or have other identifiable differences that do not relate to sex characteristics. Some people with Jacobs syndrome may also have a smaller-than-typical penis or scrotum, hypospadias, and/or undescended testicles."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002862","dc:identifier":"homoit0002862","skos:prefLabel":{"@language":"en","@value":"Kallmann syndrome"},"skos:altLabel":{"@language":"en","@value":"Hypogonadotropic hypogonadism"},"rdfs:comment":{"@language":"en","@value":"Kallmann syndrome can occur in people with XX or XY chromosomes and is a form of hypogonadism. People with Kallmann syndrome and XY chromosomes are often born with a smaller-than-typical penis and undescended testes. In adolescence, most people with Kallmann syndrome will either start puberty later than usual or not experience typical pubertal changes (such as developing facial hair and a deeper voice for people with XY chromosomes or developing breasts and starting to menstruate for people with XX chromosomes) unless they receive hormone therapy. Kallmann syndrome also affects someone’s sense of smell."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002863","dc:identifier":"homoit0002863","skos:prefLabel":{"@language":"en","@value":"Leydig cell hypoplasia"},"skos:altLabel":{"@language":"en","@value":"LCH"},"rdfs:comment":{"@language":"en","@value":"People with Leydig cell hypoplasia (LCH) have XY chromosomes and a genetic insensitivity to luteinizing hormone. LCH can be either complete (known as LCH Type 1) or partial (known as LCH Type 2). Luteinizing hormone is typically responsible for the development of Leydig cells in the testicles and for signaling for those cells to produce androgens like testosterone. Someone with LCH will develop few or no Leydig cells and therefore will produce less testosterone than is typical."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002879"},{"@id":"https://homosaurus.org/v3/homoit0002881"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002864","dc:identifier":"homoit0002864","skos:prefLabel":{"@language":"en","@value":"Luteinizing hormone insensitivity"},"rdfs:comment":{"@language":"en","@value":"People with XY chromosomes and luteinizing hormone insensitivity develop the variation Leydig cell hypoplasiae. Because people with XX chromosomes do not typically produce Leydig cells to begin with, someone with XX chromosomes who has a genetic insensitivity to luteinizing hormone will not be affected in the same way. A person with XX chromosomes whose body does not respond to luteinizing hormone will not usually have any noticeable differences at birth, but their ovaries may not produce fertile follicles (eggs), and they may not menstruate."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002865","dc:identifier":"homoit0002865","skos:prefLabel":{"@language":"en","@value":"Mayer-Rokitansky-Küster-Hauser syndrome"},"skos:altLabel":[{"@language":"en","@value":"MRKH syndrome "},{"@language":"en","@value":"Müllerian agenesis"},{"@language":"en","@value":"Müllerian duct anomalies"},{"@language":"en","@value":"Müllerian duct variations"}],"rdfs:comment":{"@language":"en","@value":"Mayer-Rokitansky-Küster-Hauser (MRKH) syndrome occurs when a person's Müllerian ducts, which typically become the uterus and upper portion of the vagina during fetal development, do not develop in the typical way. People with MRKH have XX chromosomes and are usually born with a vulva and either a vagina that is shorter than typical or no vagina. They usually do not have a cervix and may have a partial uterus (uterine remnant) or no uterus. They often do not mensturate but may experience cyclic pain if they have a uterine remnant with endometrial lining, and they can develop menstruation-related conditions like endometriosis."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002880"},{"@id":"https://homosaurus.org/v3/homoit0002882"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-10-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002870","dc:identifier":"homoit0002870","skos:prefLabel":{"@language":"en","@value":"Penoscrotal transposition"},"rdfs:comment":{"@language":"en","@value":"People with penoscrotal transposition are born with a different genital configuration than typical, with their penis located below or in the middle of their scrotum instead of above it. Their scrotum might be bifid (split into two halves), and they may also have hypospadias and/or chordee."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002871","dc:identifier":"homoit0002871","skos:prefLabel":{"@language":"en","@value":"Persistent Müllerian duct syndrome"},"skos:altLabel":{"@language":"en","@value":"PMDS"},"rdfs:comment":{"@language":"en","@value":"People with Persistent Müllerian duct syndrome (PMDS) have XY chromosomes, male-typical reproductive organs and external genitalia, and some component(s) of a female-typical reproductive tract, such as a uterus, fallopian tubes, and/or upper vaginal canal. PMDS occurs when the Müllerian ducts—internal structures that ordinarily break down in an XY fetus—remain and develop as they would in an XX fetus. PMDS is ordinarily not diagnosed at birth, and individuals with this variation often have a male gender identity."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002872","dc:identifier":"homoit0002872","skos:prefLabel":{"@language":"en","@value":"Polycystic ovary syndrome"},"skos:altLabel":[{"@language":"en","@value":"PCOD"},{"@language":"en","@value":"PCOS"},{"@language":"en","@value":"Polycystic ovarian disease"},{"@language":"en","@value":"Polycystic ovarian syndrome"}],"rdfs:comment":{"@language":"en","@value":"People with this variation have XX chromosomes and are generally born with a vulva and vagina, a uterus, and ovaries. Later in life, their ovaries often produce higher-than-typical levels of androgens like testosterone. Polycystic ovary syndrome (PCOS) can also result in the development of characteristics such as facial and body hair, and it can interfere with the process of ovulation. This in turn can cause irregular periods or no periods, and people with PCOS may struggle to become pregnant. Some people with PCOS have small cysts (fluid-filled sacs) on their ovaries, but some do not. Signs of PCOS generally will not show up until a person starts menstruating, or later in life."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002873","dc:identifier":"homoit0002873","skos:prefLabel":{"@language":"en","@value":"Pseudohermaphroditism"},"skos:altLabel":[{"@language":"en","@value":"Female pseudohermaphroditism"},{"@language":"en","@value":"Male pseudohermaphroditism"}],"rdfs:comment":{"@language":"en","@value":"A term previously used in medical contexts to refer to different groups of intersex variations, usually divided into categories of “male pseudohermaphroditism” and “female pseudohermaphroditism” on the basis of the person’s chromosomes. People may still find these terms used in their medical records or in medical journal articles when researching their variation, but they are often considered highly stigmatizing in addition to being vague and inaccurate. Do not use this term to describe a person's variation unless they do so themselves."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002875","dc:identifier":"homoit0002875","skos:prefLabel":{"@language":"en","@value":"Sex reversal syndrome"},"rdfs:comment":{"@language":"en","@value":"A term sometimes used in medical contexts to refer to different variations in which a person is born with XY chromosomes and a vulva and vagina or XX chromosomes and a penis."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002878","dc:identifier":"homoit0002878","skos:prefLabel":{"@language":"en","@value":"Trisomy X"},"skos:altLabel":{"@language":"en","@value":"Triple XXX syndrome"},"rdfs:comment":{"@language":"en","@value":"People with Trisomy X are born with 47XXX chromosomes rather than the typical 46XX. If they receive the additional X chromosome from their parent's original sperm or egg cell, they will have 47XXX chromosomes in all their cells. If the additional chromosome appears during the embryo's development process, however, only some cells will have 47XXX chromosomes and the person will be born with a mosaic chromosome pattern. Most people with 47XXX chromosomes do not develop any variations in their other sex characteristics but some may have ovaries that stop producing hormones at an earlier-than-typical age and some may not menstruate."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002883","dc:identifier":"homoit0002883","skos:prefLabel":{"@language":"en","@value":"Vaginal atresia"},"rdfs:comment":{"@language":"en","@value":"People with this variation may be born without a vaginal opening, a shallow “dimple” where an opening would typically be, or a vaginal opening that is fused or blocked by fibrous tissue. People with vaginal atresia often have a typical upper vaginal canal (along with a typical uterus, cervix, fallopian tubes, and ovaries) with differences in the lower portion of the vagina only."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002885","dc:identifier":"homoit0002885","skos:prefLabel":{"@language":"en","@value":"XXYY syndrome"},"rdfs:comment":{"@language":"en","@value":"People with XXYY syndrome are born with an extra copy of both an X and Y chromosome, resulting in an 48XXYY chromosome pattern instead of the typical 46XY. People with XXYY chromosomes may have undescended testes and produce lower-than-typical amounts of testosterone, which can cause them to start puberty at a later age than typical and develop less pronounced secondary sex characteristics like muscle tone and facial hair. They may also experience breast growth. People with XXYY syndrome often have other physical features that are similar to those developed by people with Klinefelter syndrome (47XXY)."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001646","dc:identifier":"homoit0001646","skos:prefLabel":{"@language":"en","@value":"Assigned X at birth"},"skos:altLabel":[{"@language":"en","@value":"AXAB"},{"@language":"en","@value":"Designated X at birth"},{"@language":"en","@value":"DXAB"},{"@language":"en","@value":"X assigned at birth"},{"@language":"en","@value":"XAAB"}],"rdfs:comment":{"@language":"en","@value":"The assignment of an \"X\" gender marker or \"X\" sex designation shortly after birth. It is uncommon for intersex people to be assigned intersex or X at birth.\r\n"},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001268"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000669"},{"@id":"https://homosaurus.org/v3/homoit0001646"},{"@id":"https://homosaurus.org/v3/homoit0002884"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/assignedXAtBirth"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000675","dc:identifier":"homoit0000675","skos:prefLabel":{"@language":"en","@value":"Intimate partner violence"},"skos:altLabel":{"@language":"en","@value":"Intimate partner abuse"},"rdfs:comment":{"@language":"en","@value":"Acts of violence or abuse directed against an individual by their current or former partner in a romantic, sexual, or play relationship."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000855"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000918"},{"@id":"https://homosaurus.org/v3/homoit0001133"},{"@id":"https://homosaurus.org/v3/homoit0001293"},{"@id":"https://homosaurus.org/v3/homoit0001311"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2009000032"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intimatePartnerViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000676","dc:identifier":"homoit0000676","skos:prefLabel":{"@language":"en","@value":"Inuit LGBTQ+ people"},"skos:altLabel":[{"@language":"en","@value":"Inuit (LGBTQ)"},{"@language":"en","@value":"Inuit people (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ Inuit"},{"@language":"en","@value":"LGBTQ+ Inuit people"}],"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who are Inuit, or part of several Indigenous peoples inhabiting the Inuit homeland in the Arctic and subarctic regions of Greenland, Canada, and Alaska. Only use for people who identify as Inuit."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000886"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001962"},{"@id":"https://homosaurus.org/v3/homoit0001963"},{"@id":"https://homosaurus.org/v3/homoit0001964"},{"@id":"https://homosaurus.org/v3/homoit0001965"},{"@id":"https://homosaurus.org/v3/homoit0001966"},{"@id":"https://homosaurus.org/v3/homoit0001967"},{"@id":"https://homosaurus.org/v3/homoit0002923"},{"@id":"https://homosaurus.org/v3/homoit0003410"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001809"},{"@id":"https://homosaurus.org/v3/homoit0001810"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQInuit"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001962","dc:identifier":"homoit0001962","skos:prefLabel":{"@language":"en","@value":"Inuit lesbians"},"skos:altLabel":[{"@language":"en","@value":"Lesbian Inuit people"},{"@language":"en","@value":"Lesbian Inuits"}],"rdfs:comment":{"@language":"en","@value":"Lesbians who are Inuit, or part of several Indigenous peoples inhabiting the Inuit homeland in the Arctic and subarctic regions of Greenland, Canada, and Alaska. Only use for people who identify as Inuit."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000676"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001963","dc:identifier":"homoit0001963","skos:prefLabel":{"@language":"en","@value":"Inuit gay men"},"skos:altLabel":[{"@language":"en","@value":"Gay Inuit men"},{"@language":"en","@value":"Gay Inuits"},{"@language":"en","@value":"Inuit gays"}],"rdfs:comment":{"@language":"en","@value":"Gay men who are Inuit, or part of several Indigenous peoples inhabiting the Inuit homeland in the Arctic and subarctic regions of Greenland, Canada, and Alaska. Only use for people who identify as Inuit."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000676"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001964","dc:identifier":"homoit0001964","skos:prefLabel":{"@language":"en","@value":"Inuit bisexual people"},"skos:altLabel":[{"@language":"en","@value":"Bisexual Inuit people"},{"@language":"en","@value":"Bisexual Inuits"}],"rdfs:comment":{"@language":"en","@value":"Bisexual people who are Inuit, or part of several Indigenous peoples inhabiting the Inuit homeland in the Arctic and subarctic regions of Greenland, Canada, and Alaska. Only use for people who identify as Inuit."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000676"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001965","dc:identifier":"homoit0001965","skos:prefLabel":{"@language":"en","@value":"Inuit transgender people"},"skos:altLabel":[{"@language":"en","@value":"Transgender Inuit people"},{"@language":"en","@value":"Transgender Inuits"}],"rdfs:comment":{"@language":"en","@value":"Transgender people who are Inuit, or part of several Indigenous peoples inhabiting the Inuit homeland in the Arctic and subarctic regions of Greenland, Canada, and Alaska. Only use for people who identify as Inuit."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000676"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001966","dc:identifier":"homoit0001966","skos:prefLabel":{"@language":"en","@value":"Inuit queer people"},"skos:altLabel":[{"@language":"en","@value":"Queer Inuit people"},{"@language":"en","@value":"Queer Inuits"}],"rdfs:comment":{"@language":"en","@value":"Queer people who are Inuit, or part of several Indigenous peoples inhabiting the Inuit homeland in the Arctic and subarctic regions of Greenland, Canada, and Alaska. Only use for people who identify as Inuit."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000676"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001967","dc:identifier":"homoit0001967","skos:prefLabel":{"@language":"en","@value":"Inuit intersex people"},"skos:altLabel":[{"@language":"en","@value":"Intersex Inuit people"},{"@language":"en","@value":"Intersex Inuits"}],"rdfs:comment":{"@language":"en","@value":"Intersex people who are Inuit, or part of several Indigenous peoples inhabiting the Inuit homeland in the Arctic and subarctic regions of Greenland, Canada, and Alaska. Only use for people who identify as Inuit."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000676"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002923","dc:identifier":"homoit0002923","skos:prefLabel":{"@language":"en","@value":"Inuit asexual people"},"rdfs:comment":{"@language":"en","@value":"Asexual people who are Inuit, or part of several Indigenous peoples inhabiting the Inuit homeland in the Arctic and subarctic regions of Greenland, Canada, and Alaska. Only use for people who identify as Inuit."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000676"},{"@id":"https://homosaurus.org/v3/homoit0002922"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2023-11-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003410","dc:identifier":"homoit0003410","skos:prefLabel":{"@language":"en","@value":"Inuit non-binary people"},"skos:altLabel":[{"@language":"en","@value":"Inuit nonbinary people"},{"@language":"en","@value":"Non-binary Inuit people"},{"@language":"en","@value":"Non-binary Inuit"},{"@language":"en","@value":"Nonbinary Inuit people"},{"@language":"en","@value":"Nonbinary Inuit"}],"rdfs:comment":{"@language":"en","@value":"Non-binary people who are Inuit, or part of several Indigenous peoples inhabiting the Inuit homeland in the Arctic and subarctic regions of Greenland, Canada, and Alaska. Only use for people who identify as Inuit."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000676"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-11"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000677","dc:identifier":"homoit0000677","skos:prefLabel":{"@language":"en","@value":"Inverts"},"skos:altLabel":{"@language":"en","@value":"Sexual inverts"},"rdfs:comment":{"@language":"en","@value":"Outdated, historical term used for LGBTQ+ people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000878"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001296"},{"@id":"https://homosaurus.org/v3/homoit0001297"},{"@id":"https://homosaurus.org/v3/homoit0001564"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/inverts"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001564","dc:identifier":"homoit0001564","skos:prefLabel":{"@language":"en","@value":"Uranism"},"skos:altLabel":[{"@language":"en","@value":"Uranismus"},{"@language":"en","@value":"Congenital sexual inversion"},{"@language":"en","@value":"Urningism"},{"@language":"en","@value":"Uraniadism"},{"@language":"en","@value":"Uranianism"}],"rdfs:comment":{"@language":"en","@value":"Historical term originating from the German \"Uranismus\" coined by Karl Heinrich Ulrichs as an umbrella term for what are now referred to as gender and sexual minorities; use only in historical contexts."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000878"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000677"},{"@id":"https://homosaurus.org/v3/homoit0001296"},{"@id":"https://homosaurus.org/v3/homoit0001484"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/uranism"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000679","dc:identifier":"homoit0000679","skos:prefLabel":{"@language":"en","@value":"Jealousy"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000858"},{"@id":"https://homosaurus.org/v3/homoit0001237"},{"@id":"https://homosaurus.org/v3/homoit0001649"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85069852"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000679"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001658"},"dc:replaces":{"@id":"http://homosaurus.org/v2/jealousy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-10-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000858","dc:identifier":"homoit0000858","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ emotions"},"skos:altLabel":{"@language":"en","@value":"LGBTQ emotions"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000858"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000889"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQEmotions"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-10-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001649","dc:identifier":"homoit0001649","skos:prefLabel":{"@language":"en","@value":"Compersion"},"rdfs:comment":{"@language":"en","@value":"The positive emotion an individual may experience in regards to their partner's relationship with another partner. Often defined as the opposite of jealousy."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001651"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001649"},"dc:replaces":{"@id":"http://homosaurus.org/v2/compersion"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001658","dc:identifier":"homoit0001658","skos:prefLabel":{"@language":"en","@value":"Non-consensual non-monogamy"},"rdfs:comment":{"@language":"en","@value":"Practice of engaging in romantic or sexual relationships with more than one person simultaneously without each partner's consent."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001659"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nonConsensualNonMonogamy"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:mod