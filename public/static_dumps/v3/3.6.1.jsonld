":"https://homosaurus.org/v3/homoit0001117"},{"@id":"https://homosaurus.org/v3/homoit0002191"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000899"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQMarketing"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002191","dc:identifier":"homoit0002191","skos:prefLabel":{"@language":"en","@value":"Queerbaiting"},"skos:altLabel":{"@language":"en","@value":"Queer baiting"},"rdfs:comment":{"@language":"en","@value":"Marketing tactic in which creators of a piece of media purposefully hint at but do not explicitly depict or follow through with queer relationships or queer representation. Queerbaiting is distinct from queer coding in that queer coding is not typically used as a marketing tactic."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000899"},{"@id":"https://homosaurus.org/v3/homoit0002192"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002191"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001408","dc:identifier":"homoit0001408","skos:prefLabel":{"@language":"en","@value":"Transgender Day of Remembrance"},"skos:altLabel":[{"@language":"en","@value":"TDOR"},{"@language":"en","@value":"TDoR"},{"@language":"en","@value":"Trans Day of Remembrance"}],"rdfs:comment":{"@language":"en","@value":"International day of observance recognized annually on November 20 to honor the memory and lives of trans people who were murdered in the previous 12 months and to draw attention to the continued violence against trans people. Transgender Day of Remembrance (abbreviated TDoR) was founded in 1999 by a small group of trans people, i