de the argument that race is a social construct with no biological basis and that racism and disparate racial outcomes are the result of complex, changing, and often subtle social and institutional dynamics, rather than individuals' explicit and intentional prejudices."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001365"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001903"},{"@id":"https://homosaurus.org/v3/homoit0002038"},{"@id":"https://homosaurus.org/v3/homoit0002257"},{"@id":"https://homosaurus.org/v3/homoit0002269"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2020008165"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003616","dc:identifier":"homoit0003616","skos:prefLabel":{"@language":"en","@value":"Decolonial theory"},"skos:altLabel":[{"@language":"en","@value":"Decoloniality"},{"@language":"en","@value":"Decolonizing theory"},{"@language":"en","@value":"Postcolonial theory"},{"@language":"en","@value":"Postcolonialism"}],"rdfs:comment":{"@language":"en","@value":"A school of thought that rejects Eurocentric knowledge hierarchies and ways of being, including the presumed superiority of white Western culture."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001365"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97007835"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001369","dc:identifier":"homoit0001369","skos:prefLabel":{"@language":"en","@value":"Third gender people"},"rdfs:comme