"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002169","dc:identifier":"homoit0002169","skos:prefLabel":{"@language":"en","@value":"Fursuits"},"rdfs:comment":{"@language":"en","@value":"Costumes worn by furries that represent their fursonas (i.e., anthropomorphized animal versions of themselves)."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002165"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000289"},{"@id":"https://homosaurus.org/v3/homoit0001241"},{"@id":"https://homosaurus.org/v3/homoit0001242"},{"@id":"https://homosaurus.org/v3/homoit0001808"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003066","dc:identifier":"homoit0003066","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ fashion"},"rdfs:comment":{"@language":"en","@value":"Fashion, clothing, and accessories associated with LGBTQ+ subcultures and expression."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000307"},{"@id":"https://homosaurus.org/v3/homoit0001246"},{"@id":"https://homosaurus.org/v3/homoit0003100"},{"@id":"https://homosaurus.org/v3/homoit0003111"},{"@id":"https://homosaurus.org/v3/homoit0003112"},{"@id":"https://homosaurus.org/v3/homoit0003117"},{"@id":"https://homosaurus.org/v3/homoit0003146"},{"@id":"https://homosaurus.org/v3/homoit0003178"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000289"},{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0001816"},{"@id":"https://homosaurus.org/v3/homoit0003059"},{"@id":"https://homosaurus.org/v3/homoit0003063"}],"skos:hasTopConcept":{"@id":"https://ho