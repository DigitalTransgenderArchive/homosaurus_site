ual African American people"},{"@language":"en","@value":"Asexual African Americans"}],"rdfs:comment":{"@language":"en","@value":"Asexual people of African descent born in the United States or asexual people born in African countries who live in or have a strong connection to the United States. Use for individuals who self-identity as African American. Follow the individual’s preference for African American or Black whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000015"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002935","dc:identifier":"homoit0002935","skos:prefLabel":{"@language":"en","@value":"African American intersex people"},"skos:altLabel":[{"@language":"en","@value":"Intersex African American people"},{"@language":"en","@value":"Intersex African Americans"}],"rdfs:comment":{"@language":"en","@value":"Intersex people of African descent born in the United States or intersex people born in African countries who live in or have a strong connection to the United States. Use for individuals who self-identity as African American. Follow the individual’s preference for African American or Black whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000015"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003558","dc:identifier":"homoit0003558","skos:prefLabel":{"@language":"en","@value":"African American non-binary people"},"skos:altLabel":[{"@language":"en","@value":"Non-binary African Americans"},{"@language":"en","@value":"Non-binary African American people"},{"@language":"en","@value":"African American nonbinary people"},{"@language":"en","@value":"Nonbinary African American people"},{"@language":"en","@value":"Nonbinary African Americans"}],"rdfs:comment":{"@language":"en","@value":"Non-binary people of African descent born in the United States or non-binary people born in African countries who live in or have a strong connection to the United States. Use for individuals who self-identity as African American. Follow the individual’s preference for African American or Black whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000015"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000095","dc:identifier":"homoit0000095","skos:prefLabel":{"@language":"en","@value":"Banjees"},"rdfs:comment":{"@language":"en","@value":"Term from the 1980s (or earlier) that describes a certain type of young Latin American or African American man who has sex with men and who dresses in stereotypical masculine urban fashion."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000878"},{"@id":"https://homosaurus.org/v3/homoit0001295"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000015"},{"@id":"https://homosaurus.org/v3/homoit0000092"},{"@id":"https://homosaurus.org/v3/homoit0000253"},{"@id":"https://homosaurus.org/v3/homoit0000978"},{"@id":"https://homosaurus.org/v3/homoit0001009"},{"@id":"https://homosaurus.org/v3/homoit0002017"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/banjees"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001254","dc:identifier":"homoit0001254","skos:prefLabel":{"@language":"en","@value":"Same-gender-loving"},"skos:altLabel":{"@language":"en","@value":"SGL"},"rdfs:comment":{"@language":"en","@value":"Culturally affirming term for sexual identity that is often used to describe African American homosexual people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001295"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000015"},{"@id":"https://homosaurus.org/v3/homoit0001009"},{"@id":"https://homosaurus.org/v3/homoit0001510"},{"@id":"https://homosaurus.org/v3/homoit0002278"},{"@id":"https://homosaurus.org/v3/homoit0002279"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sameGenderLoving"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002333","dc:identifier":"homoit0002333","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ people of the African diaspora"},"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people of native African ancestry living outside of the continent of Africa. While this term is commonly used to describe descendants of Africans who were enslaved and forcibly transported to the Americas via the transatlantic slave trade between the 16th and 19th centuries, it can also be used to refer to descendants of Africans who voluntarily immigrated to other parts of the world. Do not conflate with Black LGBTQ+ people or African American LGBTQ+ people. Follow the individual's preference whenever possible."},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000015"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002333"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-15"},"dc:modified":{"@type