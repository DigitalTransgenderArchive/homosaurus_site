pted as a result of being raised or socialized within a homophobic environment or culture."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000391"},{"@id":"https://homosaurus.org/v3/homoit0003091"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000392","dc:identifier":"homoit0000392","skos:prefLabel":{"@language":"en","@value":"Ego-dystonic sexual orientation"},"skos:altLabel":{"@language":"en","@value":"Ego-dystonic homosexuality"},"rdfs:comment":{"@language":"en","@value":"Internal conflict caused by having a sexual identity or attraction that is at odds with one’s idealized self-image."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001011"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000303"},{"@id":"https://homosaurus.org/v3/homoit0000391"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ego-dystonicSexualOrientation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001011","dc:identifier":"homoit0001011","skos:prefLabel":{"@language":"en","@value":"Mental disorders"},"skos:altLabel":[{"@language":"en","@value":"Mental illnesses"},{"@language":"en","@value":"Psychiatric disorders"}],"rdfs:comment":{"@language":"en","@value":"Medical conditions defined by changes or disturbances in an individual's thinking, feeling, mood, and behavior."},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000392"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85083643"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mentalDisorders"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000393","dc:identifier":"homoit0000393","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ older people"},"skos:altLabel":[{"@language":"en","@value":"Elderly (LGBTQ)"},{"@language":"en","@value":"Senior citizens (LGBTQ)"},{"@language":"en","@value":"Seniors (LGBTQ)"},{"@language":"en","@value":"Older people (LGBTQ)"}],"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who are advanced in age, typically defined as older than 60 years of age."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000915"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001054"},{"@id":"https://homosaurus.org/v3/homoit0001055"},{"@id":"https://homosaurus.org/v3/homoit0001056"},{"@id":"https://homosaurus.org/v3/homoit0001057"},{"@id":"https://homosaurus.org/v3/homoit0001058"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000856"},{"@id":"https://homosaurus.org/v3/homoit0000931"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2004011614"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/olderPeopleLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001055","dc:identifier":"homoit0001055","skos:prefLabel":{"@language":"en","@value":"Older gay men"},"rdfs:comment":{"@language":"en","@value":"Gay men who are advanced in age, typically over 60 years of age."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000393"},{"@id":"https://homosaurus.org/v3/homoit0000506"}],"skos:exac