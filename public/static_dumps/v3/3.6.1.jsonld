":"homoit0001644","skos:prefLabel":{"@language":"en","@value":"Aromanticism"},"skos:altLabel":{"@language":"en","@value":"Aromantic"},"rdfs:comment":{"@language":"en","@value":"A romantic orientation generally characterized by a lack of romantic attraction or desire."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001828"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000004"},{"@id":"https://homosaurus.org/v3/homoit0000067"},{"@id":"https://homosaurus.org/v3/homoit0001791"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001828"},"dc:replaces":{"@id":"http://homosaurus.org/v2/aromanticism"},"dc:issued":{"@type":"xsd:date","@value":"2021-03-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000005","dc:identifier":"homoit0000005","skos:prefLabel":{"@language":"en","@value":"HIV/AIDS"},"skos:altLabel":[{"@language":"en","@value":"Acquired immune deficiency syndrome"},{"@language":"en","@value":"AIDS"},{"@language":"en","@value":"Acquired immunodeficiency syndrome"},{"@language":"en","@value":"HIV"},{"@language":"en","@value":"Human immunodeficiency virus"}],"rdfs:comment":{"@language":"en","@value":"Abbreviation for human immunodeficiency virus (HIV) and acquired immunodeficiency syndrome (AIDS)."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001308"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000033"},{"@id":"https://homosaurus.org/v3/homoit0001980"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000024"},{"@id":"https://homosaurus.org/v3/homoit0000025"},{"@id":"https://homosaurus.org/v3/homoit0000026"},{"@id":"https://homosaurus.org/v3/homoit0000027"},{"@id":"https://homosaurus.org/v3/homoit0000028"},{"@id":"https://homosaurus.org/v3/homoit0000029"},{"@id":"https://homosaurus.org/v3/homoit0000030"},{"@id":"https://homosaurus.org/v3/homoit0000031"},{"@id":"https://homo