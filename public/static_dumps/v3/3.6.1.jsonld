s:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001925","dc:identifier":"homoit0001925","skos:prefLabel":{"@language":"en","@value":"Cisgender identity"},"skos:altLabel":{"@language":"en","@value":"Cis identity"},"rdfs:comment":{"@language":"en","@value":"Term used to describe the identity of people who identify with the sex or gender they were assigned at birth."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000571"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000270"},{"@id":"https://homosaurus.org/v3/homoit0000271"},{"@id":"https://homosaurus.org/v3/homoit0000272"},{"@id":"https://homosaurus.org/v3/homoit0001924"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002281","dc:identifier":"homoit0002281","skos:prefLabel":{"@language":"en","@value":"Cisgender youth"},"skos:altLabel":[{"@language":"en","@value":"Cis youth"},{"@language":"en","@value":"Cisgender adolescents"},{"@language":"en","@value":"Cisgender teenagers"},{"@language":"en","@value":"Cisgender teens"}],"rdfs:comment":{"@language":"en","@value":"Cisgender people who are between the ages of childhood and adulthood."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000271"},{"@id":"https://homosaurus.org/v3/homoit0001520"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002282"},{"@id":"https://homosaurus.org/v3/homoit0002283"},{"@id":"https://homosaurus.org/v3/homoit0002284"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000271"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-10"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000273","dc:identifier":"homoit0000273","skos:prefLabel":{"@language":"en","@value":"Cissexual people"},"rdfs:comment":{"@language":"en","@value":"Individuals whose sex matches the sex or gender they were assigned at birth. Whereas cisgender refers to people who are not transgender, cissexual refers to people who are not transsexual."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000271"},{"@id":"https://homosaurus.org/v3/homoit0001381"},{"@id":"https://homosaurus.org/v3/homoit0001924"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000273"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cissexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001652","dc:identifier":"homoit0001652","skos:prefLabel":{"@language":"en","@value":"Demigirls"},"skos:altLabel":[{"@language":"en","@value":"Demiwomen"},{"@language":"en","@value":"Demiwoman"},{"@language":"en","@value":"Demigirl"},{"@language":"en","@value":"Demilady"},{"@language":"en","@value":"Demiladies"},{"@language":"en","@value":"Demifemale people"}],"rdfs:comment":{"@language":"en","@value":"People who partially, but not fully, identify women or girls irrespective of their assigned genders. Used by cisgender, transgender, transfeminine, or nonbinary people who feel more strongly aligned with women physically or socially, but not strongly enough to identify solely as one."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000342"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000271"},{"@id":"https://homosaurus.org/v3/homoit0001048"},{"@id":"https://homosaurus.org/v3/homoit0001382"},{"@id":"https://homosaurus.org/v3/homoit0001653"},{"@id":"https://homosaurus.org/v3/homoit0001821"},{"@id":"https://homosaurus.org/v3/homoit0001923"},{"@id":"https://homosaurus.org/v3/homoit0002043"}],"skos