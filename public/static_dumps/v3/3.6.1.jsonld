es of freedom or entitlement held by intersex people. Often used to refer to intersex people's right to bodily autonomy and, specifically, their right to delay or decline unnecessary medical interventions."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000652"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000276"},{"@id":"https://homosaurus.org/v3/homoit0000618"},{"@id":"https://homosaurus.org/v3/homoit0000670"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000652"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-28"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002723","dc:identifier":"homoit0002723","skos:prefLabel":{"@language":"en","@value":"Two-Spirit rights"},"skos:altLabel":[{"@language":"en","@value":"2S rights"},{"@language":"en","@value":"Two Spirit rights"},{"@language":"en","@value":"Two Spirited rights"},{"@language":"en","@value":"Two-Spirited rights"}],"rdfs:comment":{"@language":"en","@value":"Legal, social, or ethical principles of freedom or entitlement held by Two-Spirit people."},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000276"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002723"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000278","dc:identifier":"homoit0000278","skos:prefLabel":{"@language":"en","@value":"Prostitutes' clients"},"skos:altLabel":[{"@language":"en","@value":"Clients of prostitutes"},{"@language":"en","@value":"Johns"},{"@language":"en","@value":"Tricks"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001136"},{"@id":"https://homosaurus.org/v3/homoit0001277"}],"skos:exactMatch