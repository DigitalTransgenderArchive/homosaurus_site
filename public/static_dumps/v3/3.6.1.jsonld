 kept secret; use in reference to LGBTQ+ individuals who conceal their (or others’) identities, whether out of preference or for safety reasons."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000285"},{"@id":"https://homosaurus.org/v3/homoit0000286"},{"@id":"https://homosaurus.org/v3/homoit0000287"},{"@id":"https://homosaurus.org/v3/homoit0000288"},{"@id":"https://homosaurus.org/v3/homoit0000295"},{"@id":"https://homosaurus.org/v3/homoit0000365"},{"@id":"https://homosaurus.org/v3/homoit0001065"},{"@id":"https://homosaurus.org/v3/homoit0001783"},{"@id":"https://homosaurus.org/v3/homoit0001784"},{"@id":"https://homosaurus.org/v3/homoit0001785"},{"@id":"https://homosaurus.org/v3/homoit0001786"},{"@id":"https://homosaurus.org/v3/homoit0001787"},{"@id":"https://homosaurus.org/v3/homoit0001788"},{"@id":"https://homosaurus.org/v3/homoit0002905"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85119431"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001261"},"dc:replaces":{"@id":"http://homosaurus.org/v2/secrecy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001784","dc:identifier":"homoit0001784","skos:prefLabel":{"@language":"en","@value":"Closeted transgender people"},"skos:altLabel":{"@language":"en","@value":"Closeted trans people"},"rdfs:comment":{"@language":"en","@value":"Transgender people who do not identify as such to others."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001783"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000285"},{"@id":"https://homosaurus.org/v3/homoit0000286"},{"@id":"https://homosaurus.org/v3/homoit0000287"},{"@id":"https://homosaurus.org/v3/homoit0000288"},{"@id":"https://homosaurus.org/v3/homoit0000295"},{"@id":"https://homosaurus.org/v3/homoit0001065"},{"@id":"https://homosaurus.org/v3/homoit0001261"},{"@id":"https://homosaurus.org/v3/homoit0001785"},{"@id":"https://homosaurus.org/v3/homoit0002905"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-08"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001785","dc:identifier":"homoit0001785","skos:prefLabel":{"@language":"en","@value":"Closeted queer people"},"rdfs:comment":{"@language":"en","@value":"Queer people who do not identify as such to others."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001195"},{"@id":"https://homosaurus.org/v3/homoit0001783"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000285"},{"@id":"https://homosaurus.org/v3/homoit0000286"},{"@id":"https://homosaurus.org/v3/homoit0000287"},{"@id":"https://homosaurus.org/v3/homoit0000288"},{"@id":"https://homosaurus.org/v3/homoit0000295"},{"@id":"https://homosaurus.org/v3/homoit0000365"},{"@id":"https://homosaurus.org/v3/homoit0001065"},{"@id":"https://homosaurus.org/v3/homoit0001261"},{"@id":"https://homosaurus.org/v3/homoit0001784"},{"@id":"https://homosaurus.org/v3/homoit0002905"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-08"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001090","dc:identifier":"homoit0001090","skos:prefLabel":{"@language":"en","@value":"Passing (Gender)"},"rdfs:comment":{"@language":"en","@value":"An individual's ability to \"pass,\" or be accepted or regarded as a member of the gender they identify with. \"Passing\" has historically been used to describe an individual's ability to \"pass\" as a certain race or ethnicity, though the term was later appropriated by the LGBTQ+ community."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000288"},{"@id":"https://homosaurus.org/v3/homoit0000316"},{"@id":"https://homosaurus.org/v3/homoit0000560"},{"@id":"https://homosaurus.org/v3/homoit0001140"},{"@id":"https://homosaurus.org/v3/homoit0001233"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001781"},{"@id":"https://homosaurus.org/v3/homoit0001901"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001090"},"dc:replaces":{"@id":"http://homosaurus.org/v2/passingGender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001781","dc:identifier":"homoit0001781","skos:prefLabel":{"@language":"en","@value":"Clocking (Gender)"},"skos:altLabel":[{"@language":"en","@value":"Clocking (Transgender)"},{"@language":"en","@value":"Clocking"}],"rdfs:comment":{"@language":"en","@value":"Slang term for the act of identifying (or clocking) someone in public as trans, crossdressing, or in drag when that person is intending to pass or be read by others as cisgender, typically for their personal safety. Clocking is often understood to be a threat (of violence or public outing) against the person being clocked. Use the term \"Reading (Gender)\" to refer to shared identification or recognized kinship between two individuals who are both gender minorities."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000288"},{"@id":"https://homosaurus.org/v3/homoit0000316"},{"@id":"https://homosaurus.org/v3/homoit0001090"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001381"},{"@id":"https://homosaurus.org/v3/homoit0001470"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001781"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-07"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001786","dc:identifier":"homoit0001786","skos:prefLabel":{"@language":"en","@value":"Closeted intersex people"},"rdfs:comment":{"@language":"en","@value":"Intersex people who do not disclose the fact that they are intersex to others."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001783"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000288"},{"@id":"https://homosaurus.org/v3/homoit0000295"},{"@id":"https://homosaurus.org/v3/homoit0000365"},{"@id":"https://homosaurus.org/v3/homoit0001065"},{"@id":"https://homosaurus.org/v3/homoit0001261"},{"@id":"https://homosaurus.org/v3/homoit0002905"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-08"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001787","dc:identifier":"homoit0001787","skos:prefLabel":{"@language":"en","@value":"Closeted Two-Spirit people"},"skos:altLabel":[{"@language":"en","@value":"Closeted 2S people"},{"@language":"en","@value":"Closeted Two Spirit people"},{"@language":"en","@value":"Closeted Two Spirited people"},{"@language":"en","@value":"Closeted Two-Spirited people"}],"rdfs:comment":{"@language":"en","@value":"Two-Spirit people who do not identify as such to others."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001480"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000288"},{"@id":"https://homosaurus.org/v3/homoit0000295"},{"@id":"https://homosaurus.org/v3/homoit0000365"},{"@id":"https://homosaurus.org/v3/homoit0001065"},{"@id":"https://homosaurus.org/v3/homoit0001261"},{"@id":"https://homosaurus.org/v3/homoit0001783"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-08"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000289","dc:identifier":"homoit0000289","skos:prefLabel":{"@language":"en","@value":"Clothing"},"rdfs:comment":{"@language":"en","@value":"Items worn on the body for protection, insulation, and self-expression; typically made of fabric or textiles."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000568"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000970"},{"@id":"https://homosaurus.org/v3/homoit0001808"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000316"},{"@id":"https://homosaurus.org/v3/homoit0000318"},{"@id":"https://homosaurus.org/v3/homoit0000366"},{"@id":"https://homosaurus.org/v3/homoit0000367"},{"@id":"https://homosaurus.org/v3/homoit0001895"},{"@id":"https://homosaurus.org/v3/homoit0002169"},{"@id":"https://homosaurus.org/v3/homoit0003063"},{"@id":"https://homosaurus.org/v3/homoit0003066"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh99005081"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/clothing"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000970","dc:identifier":"homoit0000970","skos:prefLabel":{"@language":"en","@value":"Lingerie"},"rdfs:comment":{"@language":"en","@value":"Category of clothing that includes bras, underwear, hosiery, and robes; typically refers to undergarments and sleepwear designed to be sexually appealing and worn in erotic contexts."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000289"},{"@id":"https://homosaurus.org/v3/homoit0000367"},{"@id":"https://homosaurus.org/v3/ho