erm for masturbation that is commonly used in the United States."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000988"},{"@id":"https://homosaurus.org/v3/homoit0001000"},{"@id":"https://homosaurus.org/v3/homoit0001109"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001500"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/wackingOff"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001500","dc:identifier":"homoit0001500","skos:prefLabel":{"@language":"en","@value":"Wanking"},"rdfs:comment":{"@language":"en","@value":"Slang term for masturbation commonly used in the United Kingdom and Ireland; typically refers to the manual stimulation of the penis. "},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000988"},{"@id":"https://homosaurus.org/v3/homoit0001109"},{"@id":"https://homosaurus.org/v3/homoit0001498"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/wanking"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000994","dc:identifier":"homoit0000994","skos:prefLabel":{"@language":"en","@value":"Married people"},"rdfs:comment":{"@language":"en","@value":"Individuals who are currently married, or part of a legal union involving two or more people in a personal relationship that may or may not grant certain economic, legal, and social rights."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000989"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081522"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/marriedPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001483","dc:identifier":"homoit0001483","skos:prefLabel":{"@language":"en","@value":"Unmarried couples"},"rdfs:comment":{"@language":"en","@value":"Romantic and/or sexual partnerships of two people who are unmarried."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000989"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85141186"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/unmarriedCouples"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001504","dc:identifier":"homoit0001504","skos:prefLabel":{"@language":"en","@value":"Widowed people"},"skos:altLabel":[{"@language":"en","@value":"Widowers"},{"@language":"en","@value":"Widows"}],"rdfs:comment":{"@language":"en","@value":"People whose spouses or partners have died."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000989"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/widowedPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000991","dc:identifier":"homoit0000991","skos:prefLabel":{"@language":"en","@value":"Marriage certificates"},"rdfs:comment":{"@language":"en","@value":"Government-issued documents that serve as official records of marriages; can be used in reference to LGBT