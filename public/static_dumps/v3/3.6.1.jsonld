ture that seeks to create spaces that critique normative conceptions of gender and sexuality."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0002601"},{"@id":"https://homosaurus.org/v3/homoit0001219"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003615","dc:identifier":"homoit0003615","skos:prefLabel":{"@language":"en","@value":"Queer ecology"},"skos:altLabel":{"@language":"en","@value":"Queer ecologies"},"rdfs:comment":{"@language":"en","@value":"A school of ecology that seeks to understand nature, biology, and sexuality through the framing of queer theory. Queer ecology rejects the presumption of heterosexuality and cisgenderedness as natural, as well as notions of human exceptionalism and anthropocentrism."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001219"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003707","dc:identifier":"homoit0003707","skos:prefLabel":{"@language":"en","@value":"Decolonial queer theory"},"skos:altLabel":[{"@language":"en","@value":"Queer decoloniality"},{"@language":"en","@value":"Postcolonial queer theory"},{"@language":"en","@value":"Queer decolonial theory"},{"@language":"en","@value":"Queer postcolonial theory"}],"rdfs:comment":{"@language":"en","@value":"The intersection of decolonial and queer theory, which critiques Eurocentric conceptions of gender and sexuality as a tool of colonization."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001219"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-23"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001225","dc:identifier":"homoit0001225","skos:prefLabel":{"@language":"en","@value":"Queer victims' rights"},"rdfs:comment":{"@language":"en","@value":"Queer people’s legal rights to be informed, present, and heard within the criminal justice system after having been harmed or injured as the result of a crime, accident, or other event."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001492"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerVictimsRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002594","dc:identifier":"homoit0002594","skos:prefLabel":{"@language":"en","@value":"Internalized queerphobia"},"rdfs:comment":{"@language":"en","@value":"The phenomenon in which queer people internalize or adopt queerphobic beliefs (i.e., negative perceptions of and intolerance toward queer people and queerness) as a result of being raised or socialized within a queerphobic environment or culture."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001229"},{"@id":"https://homosaurus.org/v3/homoit0002590"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0003096"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001441","dc:identifier":"homoit0001441","skos:prefLabel":{"@language":"en","@value":"Transgender radio"},"rdfs:comment":{"@language":"en","@value":"Auditory content broadcast on the radio (analog or digital) about transgender people and transgender issues."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001231"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001231"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderRadio"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002806","dc:identifier":"homoit0002806","skos:prefLabel":{"@language":"en","@value":"Asexual radio"},"rdfs:comment":{"@language":"en","@value":"Auditory content broadcast on the radio (analog or digital) about asexual people and asexual issues."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001231"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001231"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002938","dc:identifier":"homoit0002938","skos:prefLabel":{"@language":"en","@value":"Intersex radio"},"rdfs:comment":{"@language":"en","@value":"Auditory content broadcast on the radio (analog or digital) about intersex people and intersex issues."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001231"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001231"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002721","dc:identifier":"homoit0002721","skos:prefLabel":{"@language":"en","@value":"Two-Spirit radio"},"skos:altLabel":[{"@language":"en","@value":"2S radio"},{"@language":"e