.org/v3/homoit0001237"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000242"},{"@id":"https://homosaurus.org/v3/homoit0000976"},{"@id":"https://homosaurus.org/v3/homoit0001019"},{"@id":"https://homosaurus.org/v3/homoit0001124"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000050"},{"@id":"https://homosaurus.org/v3/homoit0000344"},{"@id":"https://homosaurus.org/v3/homoit0000458"},{"@id":"https://homosaurus.org/v3/homoit0000895"},{"@id":"https://homosaurus.org/v3/homoit0001080"},{"@id":"https://homosaurus.org/v3/homoit0001081"},{"@id":"https://homosaurus.org/v3/homoit0001300"},{"@id":"https://homosaurus.org/v3/homoit0001632"},{"@id":"https://homosaurus.org/v3/homoit0001633"},{"@id":"https://homosaurus.org/v3/homoit0001636"},{"@id":"https://homosaurus.org/v3/homoit0001916"},{"@id":"https://homosaurus.org/v3/homoit0001917"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualRelationships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001306","dc:identifier":"homoit0001306","skos:prefLabel":{"@language":"en","@value":"Sexuality"},"rdfs:comment":{"@language":"en","@value":"Term used to describe the ways in which individuals experience and express themselves sexually, including the types of people and practices they are sexually interested in."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000263"},{"@id":"https://homosaurus.org/v3/homoit0001061"},{"@id":"https://homosaurus.org/v3/homoit0003613"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000050"},{"@id":"https://homosaurus.org/v3/homoit0000242"},{"@id":"https://homosaurus.org/v3/homoit0000325"},{"@id":"https://homosaurus.org/v3/homoit0000404"},{"@id":"https://homosaurus.org/v3/homoit0000579"},{"@id":"https://homosau