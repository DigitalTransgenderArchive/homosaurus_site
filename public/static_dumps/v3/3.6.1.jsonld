hū poetry"},"skos:altLabel":{"@language":"haw","@value":"Mahu poetry"},"rdfs:comment":{"@language":"en","@value":"Literary work, typically written in verse, that focuses on Māhū characters, themes, or identity."},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001118"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002630"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-23"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002642","dc:identifier":"homoit0002642","skos:prefLabel":{"@language":"en","@value":"Two-Spirit poetry"},"skos:altLabel":[{"@language":"en","@value":"2S poetry "},{"@language":"en","@value":"Two Spirit poetry "},{"@language":"en","@value":"Two Spirited poetry "},{"@language":"en","@value":"Two-Spirited poetry "}],"rdfs:comment":{"@language":"en","@value":"Literary work, typically written in verse, that focuses on Two-Spirit characters, themes, or identity."},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001118"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002642"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-23"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001119","dc:identifier":"homoit0001119","skos:prefLabel":{"@language":"en","@value":"Police"},"skos:altLabel":{"@language":"en","@value":"Cops"},"rdfs:comment":{"@language":"en","@value":"A civil force empowered by the state to enforce the law and maintain public order."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001120"},{"@id":"https://homosaurus.org/v3/homoit0001122"},{"@id":"https://homosaurus.org/v3/homoit0002390"},{"@id":"https://homosaurus.org/v3/homoit0002391"},{"@id":"https://homosaurus.org/v3/homoit0002397"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85104183"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001119"},"dc:replaces":{"@id":"http://homosaurus.org/v2/police"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001122","dc:identifier":"homoit0001122","skos:prefLabel":{"@language":"en","@value":"Police raids"},"skos:altLabel":[{"@language":"en","@value":"Dawn raids"},{"@language":"en","@value":"No-knock raids"}],"rdfs:comment":{"@language":"en","@value":"Unexpected and unannounced entry into and searches of residences or establishments by law enforcement officers with the aim of using surprise to seize evidence or arrest suspects. Police raids may be undertaken legally using a search warrant or through exigent circumstances, such as probable cause, though the latter is highly subjective and civilians often have little resources to appeal illegal raids."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001121"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002381"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001119"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000611"},"dc:replaces":{"@id":"http://homosaurus.org/v2/policeRaids"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002390","dc:identifier":"homoit0002390","skos:prefLabel":{"@language":"en","@value":"Defund the police movement"},"skos:altLabel":[{"@language":"en","@value":"Defund the Police"},{"@language":"en","@value":"Movement to defund police"}],"rdfs:comment":{"@language":"en","@value":"Primarily a U.S. American and Canadian movement which supports divesting funds from, or abolition of, police departments (and often police structures generally) and reallocating them to non-policing forms of public safety and community support, such as social services, youth services, housing, education, healthcare and other community resources."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001322"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001119"},{"@id":"https://homosaurus.org/v3/homoit0002391"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001322"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002391","dc:identifier":"homoit0002391","skos:prefLabel":{"@language":"en","@value":"Police abolitionist movement"},"skos:altLabel":{"@language":"en","@value":"Abolishing the police movement"},"rdfs:comment":{"@language":"en","@value":"A primarily U.S. American and Canadian political movement that advocates replacing policing with other systems of public safety. Police abolitionists believe that policing, as a system, is inherently flawed and cannot be reformed—a view that rejects the ideology of police reformists. While reformists seek to address the ways in which policing occurs, abolitionists seek to transform policing altogether through a process of disbanding, disempowering, and disarming the police. Abolitionists argue that the institution of policing is deeply rooted in a history of white supremacy and settler colonialism and that it is inseparable from a pre-existing racial capitalist order, and thus believe a reformist approach to policing will always fail."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001322"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001119"},{"@id":"https://homosaurus.org/v3/homoit0002390"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001322"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002397","dc:identifier":"homoit0002397","skos:prefLabel":{"@language":"en","@value":"White supremacy in policing "},"skos:altLabel":[{"@language":"en","@value":"Far-right presence in police forces"},{"@language":"en","@value":"Infiltration of police by white supremacists"},{"@language":"en","@value":"Law enforcement and white supremacy"},{"@language":"en","@value":"Police and right-wing extremism"},{"@language":"en","@value":"Police officer ties with white supremacists"},{"@language":"en","@value":"Police with far-right ties"}],"rdfs:comment":{"@language":"en","@value":"Historical and contemporary linkages between white supremacist ideologies and modern policing institutions, primarily discussed within the context of the countries of Canada and the United States."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001119"},{"@id":"https://homosaurus.org/v3/homoit0002376"},{"@id":"https://homosaurus.org/v3/homoit0002377"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002397"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002374","dc:identifier":"homoit0002374","skos:prefLabel":{"@language":"en","@value":"Police entrapment of LGBTQ+ people"},"rdfs:comment":{"@language":"en","@value":"A practice in which law enforcement agents or agents of the state coerce an LGBTQ+ person to commit a \"crime\" they would have otherwise been unlikely or unwilling to commit. Legal definitions of entrapment vary widely depending on the jurisdiction, but the term is often used colloquially to refer to police acting dishonestly or in bad faith, as well as policing focused on anticipating and inducing crime, rather than responding to reports of crime."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001120"},{"@id":"https://homosaurus.org/v3/homoit0002373"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000611"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002375","dc:identifier":"homoit0002375","skos:prefLabel":{"@language":"en","@value":"Police harassment of LGBTQ+ people"},"skos:altLabel":[{"@language":"en","@value":" Mistreatment of LGBTQ+ people by police"},{"@language":"en","@value":"Harassment of LGBTQ+ people by police"},{"@language":"en","@value":"Police brutality toward LGBTQ+ people"},{"@language":"en","@value":"Police misconduct toward LGBTQ+ people"},{"@language":"en","@value":"Police mistreatment of LGBTQ+ people"}],"rdfs:comment":{"@language":"en","@value":"Any of various forms of inappropriate conduct, illegal actions, or abuses of power undertaken by law enforcement agents or agents of the state against LGBTQ+ members of the public. This includes but is not limited to racial, ethnic, and other forms of profiling; unwarranted surveillance, searches, and seizure; selective enforcement; excessive use of force; sexual misconduct; intimidation and witness tampering; falsification of evidence; coerced confessions; false arrests and imprisonment; and bribing or lobbying."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001121"},{"@id":"https://homosaurus.org/v3/homoit0002373"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002376"},{"@id":"https://homosaurus.org/v3/homoit0002377"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000611"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002381","dc:identifier":"homoit0002381","skos:prefLabel":{"@language":"en","@value":"Police raids on LGBTQ+-related establishments"},"skos:altLabel":[{"@language":"en","@value":"Anti-LGBTQ+ police raids"},{"@language":"en","@value":"Police raids on LGBTQ+ establishments"},{"@language":"en","@value":"Police raids on LGBTQ+ venues"},{"@language":"en","@value":"Police raids to LGBTQ+ venues"}],"rdfs:comment":{"@language":"en","@value":"Unexpected and unannounced entry into and searches of establishments owned or frequented by LGBTQ+ people by law enforcement officers with the aim of using surprise to seize evidence or arrest suspects. Police raids may be undertaken legally using a search warrant or through exigent circumstances, such as probable cause, though the latter is highly subjective and civilians often have little resources to appeal illegal raids."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001122"},{"@id":"https://homosaurus.org/v3/homoit0002378"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002382"},{"@id":"https://homosaurus.org/v3/homoit0002383"},{"@id":"https://homosaurus.org/v3/homoit0002384"},{"@id":"https://homosaurus.org/v3/homoit0002385"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001735"},{"@id":"https://homosaurus.org/v3/homoit0001741"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000611"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001651","dc:identifier":"homoit0001651","skos:prefLabel":{"@language":"en","@value":"Consensual non-monogamy"},"skos:altLabel":{"@language":"en","@value":"Ethical Non-monogamy"},"rdfs:comment":{"@language":"en","@value":"Practice of romantic or sexual relationships with more than one person simultaneously and with all the consent of all partners involved."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001659"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001625"},{"@id":"https://homosaurus.org/v3/homoit0001641"},{"@id":"https://homosaurus.org/v3/homoit0001665"},{"@id":"https://homosaurus.org/v3/homoit0001666"},{"@id":"https://homosaurus.org/v3/homoit0003278"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001554"},{"@id":"https://homosaurus.org/v3/homoit0001649"},{"@id":"https://homosaurus.org/v3/homoit0001662"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/consensualNonMonogamy"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001554","dc:identifier":"homoit0001554","skos:prefLabel":{"@language":"en","@value":"Metamours"},"rdfs:comment":{"@language":"en","@value":"In polyamory or open relationships, metamours are the partners of an individual's partner, with whom the individual does not have a direct sexual or romantic relationship."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001660"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001638"},{"@id":"https://homosaurus.org/v3/homoit0001651"},{"@id":"https://homosaurus.org/v3/homoit0001662"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/metamours"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001629","dc:identifier":"homoit0001629","skos:prefLabel":{"@language":"en","@value":"Hierarchical non-monogamy"},"skos:altLabel":[{"@language":"en","@value":"Hierarchical polyamory"},{"@language":"en","@value":"Hierarchical nonmonogamy"}],"rdfs:comment":{"@language":"en","@value":"A form of consensual non-monogamy in which a person has multiple partners who are not \"equal\" to one another in terms of time, emotional intensity, financial, or scheduling matters."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001659"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001641"},{"@id":"https://homosaurus.org/v3/homoit0001656"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001625"},{"@id":"https://homosaurus.org/v3/homoit0001635"},{"@id":"https://homosaurus.org/v3/homoit0001638"},{"@id":"https://homosaurus.org/v3/homoit0001645"},{"@id":"https://homosaurus.org/v3/homoit0001657"},{"@id":"https://homosaurus.org/v3/homoit0001664"},{"@id":"https://homosaurus.org/v3/homoit0002255"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hierarchicalNonmonogamy"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001662","dc:identifier":"homoit0001662","skos:prefLabel":{"@language":"en","@value":"Paramours"},"rdfs:comment":{"@language":"en","@value":"In polyamory contexts, paramours are the partners of an individual's partner, typically as part of a relationship the primary partner is unaware of. In other contexts, this term is used broadly as a synonym for lovers."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001660"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001554"},{"@id":"https://homosaurus.org/v3/homoit0001638"},{"@id":"https://homosaurus.org/v3/homoit0001651"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006001642"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/paramours"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001645","dc:identifier":"homoit0001645","skos:prefLabel":{"@language":"en","@value":"Anchor partners"},"rdfs:comment":{"@language":"en","@value":"A term used in non-monogamous communities to refer to a long-term partner with multiple commitments. Often used in place of language that is seen as hierarchical (e.g., primary/secondary partner)."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001660"},{"@id":"https://homosaurus.org/v3/homoit0002365"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001629"},{"@id":"https://homosaurus.org/v3/homoit0001657"},{"@id":"https://homosaurus.org/v3/homoit0001663"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001637"},"dc:replaces":{"@id":"http://homosaurus.org/v2/anchorPartners"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001657","dc:identifier":"homoit0001657","skos:prefLabel":{"@language":"en","@value":"Nesting partners"},"rdfs:comment":{"@language":"en","@value":"A term used in non-monogamous communities to refer to partners an individual lives with. Often used in place of language that is seen as hierarchical (e.g., primary partner, secondary partner)."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001660"},{"@id":"https://homosaurus.org/v3/homoit0002365"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001629"},{"@id":"https://homosaurus.org/v3/homoit0001645"},{"@id":"https://homosaurus.org/v3/homoit0001663"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001637"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nestingPartners"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001661","dc:identifier":"homoit0001661","skos:prefLabel":{"@language":"en","@value":"NRE (New Relationship Energy)"},"rdfs:comment":{"@language":"en","@value":"A strong, almost giddy feeling of excitement and infatuation common in the beginning of a new romantic relationship. Often used in polyamory contexts."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001655"},{"@id":"https://homosaurus.org/v3/homoit0001663"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001661"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nre"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001663","dc:identifier":"homoit0001663","skos:prefLabel":{"@language":"en","@value":"Polyamorous people"},"rdfs:comment":{"@language":"en","@value":"People who engage in romantic, sexual, or play relationships with more than one person simultaneously, with the knowledge and consent of all parties involved."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001637"},{"@id":"https://homosaurus.org/v3/homoit0001660"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001645"},{"@id":"https://homosaurus.org/v3/homoit0001657"},{"@id":"https://homosaurus.org/v3/homoit0001661"},{"@id":"https://homosaurus.org/v3/homoit0003229"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001637"},"dc:replaces":{"@id":"http://homosaurus.org/v2/polyamorousPeople"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001664","dc:identifier":"homoit0001664","skos:prefLabel":{"@language":"en","@value":"Polyfidelity"},"rdfs:comment":{"@language":"en","@value":"In polyamory circles, this term refers to the practice of engaging in multiple-partner relationships that are \"closed off\" to new participants per the agreement of those involved."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001629"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001664"},"dc:replaces":{"@id":"http://homosaurus.org/v2/polyfidelity"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001281","dc:identifier":"homoit0001281","skos:prefLabel":{"@language":"en","@value":"Sexting"},"rdfs:comment":{"@language":"en","@value":"Act of sending sexually explicit messages or photographs, primarily between mobile phones."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001267"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001128"},{"@id":"https://homosaurus.org/v3/homoit0001306"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2012000622"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexting"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.