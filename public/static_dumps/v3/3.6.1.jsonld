who either study or have expert knowledge in one of the fields of the physical and/or natural sciences, including but not limited to chemists, biologists, physicists, psychologists, and multidisciplinary researchers."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0003637"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003652","dc:identifier":"homoit0003652","skos:prefLabel":{"@language":"en","@value":"Pride parades"},"skos:altLabel":{"@language":"en","@value":"LGBTQ+ pride parades"},"rdfs:comment":{"@language":"en","@value":"Public parades that recognize and celebrate LGBTQ+ people and culture, thereby affirming the visibility, dignity, and diversity of LGBTQ+ communities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0003651"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006020042"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000861"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003658","dc:identifier":"homoit0003658","skos:prefLabel":{"@language":"en","@value":"Intersex-affirming care"},"skos:altLabel":{"@language":"en","@value":"Intersex affirming care"},"rdfs:comment":{"@language":"en","@value":"Social, psychological, behavioral, and medical interventions designed to support and affirm individuals belonging to the intersex community. Intersex-affirming care includes but is not limited to equal access to health care facilities, access to medical records and information about one's intersex status and traits, and informed consent regarding medical procedures or treatments related to intersex traits."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0003657"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000614"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003659","dc:identifier":"homoit0003659","skos:prefLabel":{"@language":"en","@value":"Transgender-affirming care"},"skos:altLabel":[{"@language":"en","@value":"Trans-affirming care"},{"@language":"en","@value":"Transgender affirming care"},{"@language":"en","@value":"Trans affirming care"}],"rdfs:comment":{"@language":"en","@value":"Social, psychological, behavioral, and medical interventions designed to support and affirm a transgender individual's gender identity. Transgender-affirming care includes but is not limited to equal access to health care facilities, counseling, puberty blockers, hormone therapy, and gender-affirming surgeries. It can also include resources to aid in social transition, such as affirming policies regarding name and pronoun changes, access to non-gendered restrooms and facilities, etc."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0003657"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000614"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003664","dc:identifier":"homoit0003664","skos:prefLabel":{"@language":"en","@value":"Lesbian poets"},"rdfs:comment":{"@language":"en","@value":"Creators of written or spoken verse who identify as lesbian."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0003663"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@t