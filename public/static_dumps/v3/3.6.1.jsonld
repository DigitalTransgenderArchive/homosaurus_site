0000512","skos:prefLabel":{"@language":"en","@value":"Gay Muslims"},"rdfs:comment":{"@language":"en","@value":"Gay men who are Muslim."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001032"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2009009639"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayMuslims"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-03-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000513","dc:identifier":"homoit0000513","skos:prefLabel":{"@language":"en","@value":"Native American gay men"},"skos:altLabel":[{"@language":"en","@value":"American Indian gay men"},{"@language":"en","@value":"Gay American Indians"},{"@language":"en","@value":"Gay Native Americans"}],"rdfs:comment":{"@language":"en","@value":"People who are part of the Native peoples of the continental United States and Canada (excluding Inuit people) and self-identity as gay men. Use more specific terms when available."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001037"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayNativeAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-25"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000514","dc:identifier":"homoit0000514","skos:prefLabel":{"@language":"en","@value":"Gay newsletters"},"rdfs:comment":{"@language":"en","@value":"Serialized print or digital periodicals created by or for gay men, often with the purpose of sharing news and information related to gay communities and issues."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000521"},{"@id":"https://homosaurus.org/v3/homoi