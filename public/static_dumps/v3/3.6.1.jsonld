/homosaurus.org/v3/homoit0001846"},{"@id":"https://homosaurus.org/v3/homoit0001847"},{"@id":"https://homosaurus.org/v3/homoit0001848"},{"@id":"https://homosaurus.org/v3/homoit0001894"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93000114"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-15"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001851","dc:identifier":"homoit0001851","skos:prefLabel":{"@language":"en","@value":"Vaginoplasty"},"skos:altLabel":[{"@language":"en","@value":"Intestinal vaginoplasty"},{"@language":"en","@value":"Penile inversion vaginoplasty"},{"@language":"en","@value":"Phallus-preserving vaginoplasty"},{"@language":"en","@value":"Zero depth vaginoplasty"}],"rdfs:comment":{"@language":"en","@value":"Surgical construction of the vagina."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000584"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001040"},{"@id":"https://homosaurus.org/v3/homoit0001465"},{"@id":"https://homosaurus.org/v3/homoit0001488"},{"@id":"https://homosaurus.org/v3/homoit0001497"},{"@id":"https://homosaurus.org/v3/homoit0001844"},{"@id":"https://homosaurus.org/v3/homoit0001845"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-15"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002840","dc:identifier":"homoit0002840","skos:prefLabel":{"@language":"en","@value":"Gonadectomy"},"rdfs:comment":{"@language":"en","@value":"Surgical procedure to remove the gonads, including testes and ovaries."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000584"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85020752"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-09-14"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002847","dc:identifier":"homoit0002847","skos:prefLabel":{"@language":"en","@value":"Intersex surgery"},"rdfs:comment":{"@language":"en","@value":"Non-lifesaving cosmetic procedures intended to change and \"normalize\" natural variations in genital appearance and/or reproductive anatomy. Intersex surgery was first developed in the early 20th century, with doctors making unresearched claims about an \"urgent need\" for these operations."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000670"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000584"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000670"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-09-14"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001497","dc:identifier":"homoit0001497","skos:prefLabel":{"@language":"en","@value":"Vulva"},"rdfs:comment":{"@language":"en","@value":"External genitalia surrounding the vagina."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000585"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001845"},{"@id":"https://homosaurus.org/v3/homoit0001848"},{"@id":"https://homosaurus.org/v3/homoit0001851"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85144473"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/vulva"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000586","dc:identifier":"homoit0000586","skos:prefLabel":{"@language":"en","@value":"Gerontophilia"},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000442"},{"@id":"https://homosaurus.org/v3/homoit0001300"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000393"},{"@id":"https://homosaurus.org/v3/homoit0000663"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000404"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000442"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gerontophilia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-11-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000623","dc:identifier":"homoit0000623","skos:prefLabel":{"@language":"en","@value":"Heterosexual girls"},"skos:altLabel":{"@language":"en","@value":"Straight girls"},"rdfs:comment":{"@language":"en","@value":"Girls (typically children or youth younger than 18) who are heterosexual."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000590"},{"@id":"https://homosaurus.org/v3/homoit0000630"},{"@id":"https://homosaurus.org/v3/homoit0002285"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexualGirls"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002284","dc:identifier":"homoit0002284","skos:prefLabel":{"@language":"en","@value":"Cisgender girls"},"skos:altLabel":{"@language":"en","@value":"Cis girls"},"rdfs:comment":{"@language":"en","@value":"Girls (typically children or youth younger than 18) who are cisgender."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000590"},{"@id":"https://homosaurus.org/v3/homoit0002281"},{"@id":"https://homosaurus.org/v3/homoit0002282"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-10"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000691","dc:identifier":"homoit0000691","skos:prefLabel":{"@language":"en","@value":"Kissing"},"rdfs:comment":{"@language":"en","@value":"Touching or pressing one's lips to another person or an object to communicate a greeting, affection, reverence, love, or sexual desire."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000593"},{"@id":"https://homosaurus.org/v3/homoit0001112"},{"@id":"https://homosaurus.org/v3/homoit0001267"},{"@id":"https://homosaurus.org/v3/homoit0001299"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85072549"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/kissing"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000703","dc:identifier":"homoit0000703","skos:prefLabel":{"@language":"en","@value":"LBT"},"rdfs:comment":{"@language":"en","@value":"Acronym used to describe lesbians, bisexuals, and transgender people as a group."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000594"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000805"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LBT"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-09"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000596","dc:identifier":"homoit0000596","skos:prefLabel":