ate","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003080","dc:identifier":"homoit0003080","skos:prefLabel":{"@language":"en","@value":"Leather and kink conventions"},"rdfs:comment":{"@language":"en","@value":"Leather and kink conventions typically take place annually at a hotel, resort, or other venue. They usually include parties, performances, title contests, vendors, play spaces, and classes and workshops on kink, sex, relationships, activism, and related topics."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000861"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000705"},{"@id":"https://homosaurus.org/v3/homoit0001272"},{"@id":"https://homosaurus.org/v3/homoit0003079"},{"@id":"https://homosaurus.org/v3/homoit0003106"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000861"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003106","dc:identifier":"homoit0003106","skos:prefLabel":{"@language":"en","@value":"Title contests"},"skos:altLabel":[{"@language":"en","@value":"Leather contests"},{"@language":"en","@value":"Leather pageants"},{"@language":"en","@value":"Titleholders"}],"rdfs:comment":{"@language":"en","@value":"An annual event in leather and kink communities where contestants compete for a title. Contestants are judged on qualities including their stage presence, appearance, charisma, and ability to be a leader and activist in the community for the length of their title year."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000818"},{"@id":"https://homosaurus.org/v3/homoit0000861"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000705"},{"@id":"https://homosaurus.org/v3/homoit0003080"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000818"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001074","dc:identifier":"homoit0001074","skos:prefLabel":{"@language":"en","@value":"Parental rights"},"rdfs:comment":{"@language":"en","@value":"The legal parent-child relationship that may be established by biological relations, at birth, or through adoption. These rights may include child custody and visitation, decision-making authority, and informational access. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000712"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000914"},{"@id":"https://homosaurus.org/v3/homoit0000918"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/parentalRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-02-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001082","dc:identifier":"homoit0001082","skos:prefLabel":{"@language":"en","@value":"Partner rights"},"rdfs:comment":{"@language":"en","@value":"Legal, economic, social, and cultural rights afforded to individuals who are in long-term partnerships (e.g., marriage, domestic partnership, civil union) that can include shared health insurance, life insurance benefits, adoption rights, and the authority to make medical and financial decisions on behalf of one's partner."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000712"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001311"},{"@id":"https://homosaurus.org/v3/homoit0002365"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnerRights"},"dc:issued":{"@type":"xsd:date","@val