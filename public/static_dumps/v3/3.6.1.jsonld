homoit0000642","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ monuments"},"skos:altLabel":[{"@language":"en","@value":"Homomonuments"},{"@language":"en","@value":"Monuments (LGBTQ)"}],"rdfs:comment":{"@language":"en","@value":"Public monuments designed to commemorate LGBTQ+ people who have been persecuted because of their gender and/or sexual identities."},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh99004297"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000642"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000901"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homomonuments"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-09"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001117","dc:identifier":"homoit0001117","skos:prefLabel":{"@language":"en","@value":"Pinkwashing"},"rdfs:comment":{"@language":"en","@value":"A variety of marketing and political strategies aimed at promoting products, countries, people, or entities to LGBTQ+ people; using LGBTQ+-related symbols in order to be perceived as progressive, modern, and tolerant; and/or utilizing concern for LGBTQ+ people and rights to justify or deviate attention from settler-colonialism, genocide, invasion, and intervention in other countries."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000643"},{"@id":"https://homosaurus.org/v3/homoit0000873"},{"@id":"https://homosaurus.org/v3/homoit0000899"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001117"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pinkwashing"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000645","dc:identifier":"homoit0000645","skos:prefLabel":{"@language":"en","@value":"Homophiles"},"rdfs:comment":{"@language":"en","@value":"Outdated term for lesbians and gay men. The use of the word began to disappear with the emergence of the gay liberation movement of the late 1960s and early 1970s."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000878"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001297"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homophiles"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002174","dc:identifier":"homoit0002174","skos:prefLabel":{"@language":"en","@value":"Homophobia in fandom"},"rdfs:comment":{"@language":"en","@value":"Issues and discussions about the presence of homophobia in fan spaces and works."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000646"},{"@id":"https://homosaurus.org/v3/homoit0002171"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0002181"},{"@id":"https://homosaurus.org/v3/homoit0002194"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001240","dc:identifier":"homoit0001240","skos:prefLabel":{"@language":"en","@value":"Ritual homosexuality"},"rdfs:comment":{"@language":"en","@value":"Non-reciprocal genital contact, typically fellatio, between younger and older men that takes place during initiation rituals practiced by the Sambari people of Papua New Guinea. This term was developed by Western outsiders and has been strongly criticized by the affected community."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000647"},{"@id":"https://homosaurus.org/v3/homoit0001299"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000886"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ritualHomosexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-02-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000648","dc:identifier":"homoit0000648","skos:prefLabel":{"@language":"en","@value":"Homosexuals"},"rdfs:comment":{"@language":"en","@value":"Outdated term for lesbians and gay men."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000878"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001297"},{"@id":"https://homosaurus.org/v3/homoit0001531"},{"@id":"https://homosaurus.org/v3/homoit0001915"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85061795"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homosexuals"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000981","dc:identifier":"homoit0000981","skos:prefLabel":{"@language":"en","@value":"Male bonding"},"rdfs:comment":{"@language":"en","@value":"Friendship and connection between two or more male-identified people."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000649"},{"@id":"https://homosaurus.org/v3/homoit0000982"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000981"},"dc:replaces":{"@id":"http://homosaurus.org/v2/maleBonding"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001138","dc:identifier":"homoit0001138","skos:prefLabel":{"@language":"en","@value":"Puberty blockers"},"rdfs:comment":{"@language":"en","@value":"Group of medications used to inhibit puberty."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000650"},{"@id":"https://homosaurus.org/v3/homoit0001007"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001400"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pubertyBlockers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002876","dc:identifier":"homoit0002876","skos:prefLabel":{"@language":"en","@value":"Steroidogenic factor 1 protein"},"skos:altLabel":{"@language":"en","@value":"SF-1 protein"},"rdfs:comment":{"@language":"en","@value":"The steroidogenic factor 1 (SF-1) protein is a transcription factor involved in sex determination. The SF-1 protein controls the activity of genes related to the gonads and adrenal glands."},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000651"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002876"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-09-14"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001377","dc:identifier":"homoit0001377","skos:prefLabel":{"@language":"en","@value":"Toxic masculinity"},"rdfs:comment":{"@language":"en","@value":"Set of attitudes, behaviors, and cultural norms stereotypically associated with or expected of men and which are regarded as having a negative impact on men and society at large."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000995"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000655"},{"@id":"https://homosaurus.org/v3/homoit0001133"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/toxicMasculinity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000656","dc:identifier":"homoit0000656","skos:prefLabel":{"@language":"en","@value":"Hypersexuality"},"skos:altLabel":[{"@language":"en","@value":"Nymphomania"},{"@language":"en","@value":"Satyriasis"},{"@language":"en","@value":"Andromania"},{"@language":"en","@value":"Clitoromania"},{"@language":"en","@value":"Don Juan syndrome"},{"@language":"en","@value":"Don Juanism"},{"@language":"en","@value":"Estromania"},{"@language":"en","@value":"Excessive sex drive"},{"@language":"en","@value":"Furor amatorius"},{"@language":"en","@value":"Furor uterinus"},{"@language":"en","@value":"Hyper-sexuality"},{"@language":"en","@value":"Hyperactive sexual desire disorder"},{"@language":"en","@value":"Hyperaesthesia"},{"@language":"en","@value":"Hypereroticism"},{"@language":"en","@value":"Hyperlibido"},{"@language":"en","@value":"Hyperphilia"},{"@language":"en","@value":"Hypersensuality"},{"@language":"en","@value":"Hypersexual disorder"},{"@language":"en","@value":"Messalina syndrome"},{"@language":"en","@value":"Œstromania"},{"@language":"en","@value":"Oversexuality"},{"@language":"en","@value":"Satyrism"},{"@language":"en","@value":"Satyromania"},{"@language":"en","@value":"Sexual hyperesthesia"},{"@language":"en","@value":"Sexual hyperversion"}],"rdfs:comment":{"@language":"en","@value":"Term used to describe a level or frequency of sexual desire that is perceived as excessive within a given culture. Though the medical community has not reached a consensus as to whether hypersexuality should be included as a clinical diagnosis, doctors and psychologists have historically diagnosed LGBTQ+ people with hypersexuality (or other related labels) in order to wrongly treat their identities and desires as medical disorders. Should only be used in a historical context or if an individual self-identifies with the term."},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001284"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001283"},{"@id":"https://homosaurus.org/v3/homoit0001306"},{"@id":"https://homosaurus.org/v3/homoit0001538"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000656"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hypersexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001538","dc:identifier":"homoit0001538","skos:prefLabel":{"@language":"en","@value":"Erotomania"},"skos:altLabel":[{"@language":"en","@value":"Clinical erotomania"},{"@language":"en","@value":"De Clérambault syndrome"},{"@language":"en","@value":"De Clérambault's syndrome"},{"@language":"en","@value":"Obsessional erotomania"},{"@language":"en","@value":"Primary erotomania"}],"rdfs:comment":{"@language":"en","@value":"Condition characterized by an individual's persistent and often mistaken belief that another person is infatuated or in love with them. Can also be used to describe a level or frequency of sexual desire perceived as excessive within a given culture. Medical doctors and psychologists have historically diagnosed LGBTQ+ people with erotomania in order to wrongly treat their identities and desires as medical disorders. Should only be used in a historical context or if an individual self-identifies with the term."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000656"},{"@id":"https://homosaurus.org/v3/homoit0001283"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97003456"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001538"},"dc:replaces":{"@id":"http://homosaurus.org/v2/erotomania"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2022-11-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000657","dc:identifier":"homoit0000657","skos:prefLabel":{"@language":"en","@value":"Hypospadias"},"rdfs:comment":{"@language":"en","@value":"People with hypospadias are born with their urinary opening located somewhere other than the tip of the penis. In \"distal hypospadias,\" the urinary opening is elsewhere on the glans (head) of the penis, whereas in \"proximal hypospadias,\" it is on the underside of the penis and sometimes further back near the scrotum. Hypospadias is one of the most common and visible genital variations. People with hypospadias often have additional variations like chordee (a bend in the penis) or cryptorchidism (undescended testicles)."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85063812"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hypospadias"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000659","dc:identifier":"homoit0000659","skos:prefLabel":[{"@language":"en-us","@value":"In vitro fertilization"},{"@language":"en-gb","@value":"In vitro fertilisation"}],"skos:altLabel":{"@language":"en","@value":"IVF"},"rdfs:comment":{"@language":"en","@value":"Medical practice of achieving fertilization by combining sperm and eggs in laboratory settings to induce pregnancy."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000843"},{"@id":"https://homosaurus.org/v3/homoit0002618"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001234"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002629"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85047905"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000864"},"dc:replaces":{"@id":"http://homosaurus.org/v2/inVitroFertilisation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-10-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001234","dc:identifier":"homoit0001234","skos:prefLabel":[{"@language":"en-us","@value":"Reciprocal in vitro fertilization"},{"@language":"en-gb","@value":"Reciprocal in vitro fertilisation"}],"skos:altLabel":{"@language":"en","@value":"Shared motherhood"},"rdfs:comment":{"@language":"en","@value":"A medical procedure in which the egg of one partner is fertilized with donor sperm and then transferred to the uterus of the other partner to bring to term."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000659"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000864"},"dc:replaces":{"@id":"http://homosaurus.org/v2/reciprocalInVitroFertilisation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000737","dc:identifier":"homoit0000737","skos:prefLabel":[{"@language":"en-us","@value":"Lesbian information centers"},{"@language":"en-gb","@value":"Lesbian information centres"}],"rdfs:comment":{"@language":"en","@value":"Institutions providing education, support, and information about lesbian identity and lesbian communities to lesbians."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000660"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000753"},"skos:hasTopConcep