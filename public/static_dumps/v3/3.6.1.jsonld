sues associated with them and may carry stigmatized medical associations (such as terms like gigantomastia and macromastia). These terms have more specific medical meanings but should not be used outside of those specific contexts."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001623"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000222"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001623"},"dc:replaces":{"@id":"http://homosaurus.org/v2/largeBreasts"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001631","dc:identifier":"homoit0001631","skos:prefLabel":{"@language":"en","@value":"Mastectomy"},"skos:altLabel":{"@language":"en","@value":"Breast amputation"},"rdfs:comment":{"@language":"en","@value":"A surgical procedure aimed at removing the breast or as much breast tissue as possible; often undergone as part of \"top surgery\" for transgender men or nonbinary people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001840"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000222"},{"@id":"https://homosaurus.org/v3/homoit0001622"},{"@id":"https://homosaurus.org/v3/homoit0001841"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081984"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mastectomy"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-25"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001639","dc:identifier":"homoit0001639","skos:prefLabel":{"@language":"en","@value":"Small breasts"},"skos:altLabel":[{"@language":"en","@value":"Breast hypoplasia"},{"@language":"en","@value":"Underdeveloped breasts"}],"rdfs:comment":{"@language":"en","@value":"Breasts considered small within a given cultural context. In certain situations, medical professionals may refer to such breasts as \"underdeveloped\" or \"hypoplastic.\" These terms can be considered offensive and should not be used outside of specific medical contexts. The alternate labels included here are intended to aid search tools only and should not be used in other contexts."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001623"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000222"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001623"},"dc:replaces":{"@id":"http://homosaurus.org/v2/smallBreasts"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003132","dc:identifier":"homoit0003132","skos:prefLabel":{"@language":"en","@value":"Breast play"},"rdfs:comment":{"@language":"en","@value":"Any sexual activity involving the breasts, including fondling/groping, kissing, licking, rubbing, pinching, or squeezing/constricting."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001267"},{"@id":"https://homosaurus.org/v3/homoit0001299"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001046"},{"@id":"https://homosaurus.org/v3/homoit0003130"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000222"},{"@id":"https://homosaurus.org/v3/homoit0001621"},{"@id":"https://homosaurus.org/v3/homoit0003118"},{"@id":"https://homosaurus.org/v3/homoit0003131"},{"@id":"https://homosaurus.org/v3/homoit0003133"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001267"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003133","dc:identifier":"homoit0003133","skos:prefLabel":{"@language":"en","@value":"Chest play"},"rdfs:comment":{"@language":"en","@value":"A gender-inclusive term for any sexual activity involving the the upper area of the torso, including fondling/groping, kissing, licking, rubbing, pinching, or squeezing/constricting."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001267"},{"@id":"https://homosaurus.org/v3/homoit0001299"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001046"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000222"},{"@id":"https://homosaurus.org/v3/homoit0003118"},{"@id":"https://homosaurus.org/v3/homoit0003132"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001267"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000223","dc:identifier":"homoit0000223","skos:prefLabel":{"@language":"en","@value":"Brothels"},"skos:altLabel":{"@language":"en","@value":"Bordellos"},"rdfs:comment":{"@language":"en","@value":"Establishments where clients pay to engage in sexual activity with sex workers. Brothels may be illegal, decriminalized, or legal operations."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001276"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005004145"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000223"},"dc:replaces":{"@id":"http://homosaurus.org/v2/brothels"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000224","dc:identifier":"homoit0000224","skos:prefLabel":{"@language":"en","@value":"Brotherboys"},"skos:altLabel":{"@language":"en","@value":"Brothaboys"},"rdfs:comment":{"@language":"en","@value":"Indigenous Australian term for people who transition from female to male."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000436"},{"@id":"https://homosaurus.org/v3/homoit0001314"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/brotherboys"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000480","dc:identifier":"homoit0000480","skos:prefLabel":{"@language":"en","@value":"Gay Buddhists"},"rdfs:comment":{"@language":"en","@value":"Gay men who are Buddhist."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000225"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2011004972"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayBuddhists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-03-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000728","dc:identifier":"homoit0000728","skos:prefLabel":{"@language":"en","@value":"Lesbian Buddhists"},"rdfs:comment":{"@language":"en","@value":"Lesbians who are Buddhist."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000225"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianBuddhists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-09"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001165","dc:identifier":"homoit0001165","skos:prefLabel":{"@language":"en","@