":"LGBTQ social processes"},"rdfs:comment":{"@language":"en","@value":"Forms of social interaction that occur repeatedly; use to describe the ways in which LGBTQ+ people interact and establish social relationships."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000500"},{"@id":"https://homosaurus.org/v3/homoit0000538"},{"@id":"https://homosaurus.org/v3/homoit0000575"},{"@id":"https://homosaurus.org/v3/homoit0000748"},{"@id":"https://homosaurus.org/v3/homoit0000857"},{"@id":"https://homosaurus.org/v3/homoit0000960"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000080"},{"@id":"https://homosaurus.org/v3/homoit0001273"},{"@id":"https://homosaurus.org/v3/homoit0001301"},{"@id":"https://homosaurus.org/v3/homoit0001303"},{"@id":"https://homosaurus.org/v3/homoit0003694"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000947"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSocialProcesses"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001323","dc:identifier":"homoit0001323","skos:prefLabel":{"@language":"en","@value":"Social norms"},"rdfs:comment":{"@language":"en","@value":"Group-held beliefs about how members of that group should behave in a given context."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000620"},{"@id":"https://homosaurus.org/v3/homoit0000644"},{"@id":"https://homosaurus.org/v3/homoit0001532"},{"@id":"https://homosaurus.org/v3/homoit0001535"},{"@id":"https://homosaurus.org/v3/homoit0001555"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000080"},{"@id":"https://homosaurus.org/v3/homoit0000643"},{"@id":"https://homosaurus.org/v3/homoit0001241"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85123980"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001323"},"dc:replaces":