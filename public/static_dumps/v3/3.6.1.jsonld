 victims of crime"},"skos:altLabel":[{"@language":"en","@value":"Crime victims (LGBTQ)"},{"@language":"en","@value":"LGBTQ victims of crime"}],"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who have experienced crimes and may or may not have survived; follow the individual's preference for “victims” or “survivors” whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000915"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000613"},{"@id":"https://homosaurus.org/v3/homoit0000958"},{"@id":"https://homosaurus.org/v3/homoit0000959"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001492"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQVictimsOfCrime"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000313","dc:identifier":"homoit0000313","skos:prefLabel":{"@language":"en","@value":"Criminal law"},"rdfs:comment":{"@language":"en","@value":"Body of law relating to crime that prescribes the legality and consequences of conduct perceived as threatening, harmful, or endangering to the property, health, safety, and/or moral welfare of oneself and others. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000702"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000314"},{"@id":"https://homosaurus.org/v3/homoit0000339"},{"@id":"https://homosaurus.org/v3/homoit0001289"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85034058"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/criminalLaw"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000314","dc:identifier":"homoit0000314","skos:prefLabel":[{"@language":"en-us","@value":"Criminalization"},{"@language":"en-gb","@value":"Criminalisation"}],"rdfs:comment":{"@language":"en","@value":"The process by which behaviors and individuals are framed as and come to be known as criminal."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000313"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002379"},{"@id":"https://homosaurus.org/v3/homoit0002388"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000339"},{"@id":"https://homosaurus.org/v3/homoit0001139"},{"@id":"https://homosaurus.org/v3/homoit0003499"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/criminalisation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002379","dc:identifier":"homoit0002379","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ criminalization"},"skos:altLabel":{"@language":"en","@value":"Criminalization of LGBTQ+ people"},"rdfs:comment":{"@language":"en","@value":"Criminalization of existing or identifying as an LGBTQ+ person, being perceived as LGBTQ+, or engaging in any of various actions considered to be linked to LGBTQ+ status."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000314"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002380"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000356"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002388","dc:identifier":"homoit0002388","