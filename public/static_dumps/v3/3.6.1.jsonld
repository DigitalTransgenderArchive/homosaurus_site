r."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000204"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000620"},{"@id":"https://homosaurus.org/v3/homoit0000631"},{"@id":"https://homosaurus.org/v3/homoit0003509"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001298"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000647","dc:identifier":"homoit0000647","skos:prefLabel":{"@language":"en","@value":"Homosexuality"},"rdfs:comment":{"@language":"en","@value":"Sexual orientation with sexual and/or romantic attraction to individuals of the same sex."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001298"},{"@id":"https://homosaurus.org/v3/homoit0001556"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001240"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000204"},{"@id":"https://homosaurus.org/v3/homoit0000506"},{"@id":"https://homosaurus.org/v3/homoit0000556"},{"@id":"https://homosaurus.org/v3/homoit0000631"},{"@id":"https://homosaurus.org/v3/homoit0000799"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85061780"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homosexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000799","dc:identifier":"homoit0000799","skos:prefLabel":{"@language":"en","@value":"Lesbianism"},"rdfs:comment":{"@language":"en","@value":"Sexual orientation of women and femmes who are sexually and/or romantically attracted to other women and femmes. However, not all lesbians are women, and gender non-conforming people who belong to lesbian communities have often identified as lesbian."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001298"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000204"},{"@id":"https://homosaurus.org/v3/homoit0000556"},{"@id":"https://homosaurus.org/v3/homoit0000647"},{"@id":"https://homosaurus.org/v3/homoit0001669"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85076157"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000205","dc:identifier":"homoit0000205","skos:prefLabel":{"@language":"bug","@value":"Bissu"},"rdfs:comment":{"@language":"en","@value":"Mentally and physically androgynous shamans in Bugis (Indonesia) culture."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bissu"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000206","dc:identifier":"homoit0000206","skos:prefLabel":{"@language":"en","@value":"Biting"},"rdfs:comment":{"@language":"en","@value":"Biting, or applying pressure with one's teeth, for the purposes of sexual arousal."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000593"},{"@id":"https://homosaurus.org/v3/homoit0001299"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000211"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/biting"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000211","dc:identifier":"homoit0000211","skos:prefLabel":{"@language":"en","@value":"Vampirism (Sex)"},"skos:altLabel":[{"@language":"en","@value":"Blood sports"},{"@language":"en","@value":"Vampire sex"}],"rdfs:comment":{"@language":"en","@value":"Sexual practices or fetishes centering around the \"vampire lifestyle\"; can be a subset of BDSM communities and include roleplay, the consumption of blood, etc. "},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000442"},{"@id":"https://homosaurus.org/v3/homoit0001299"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000206"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/vampirism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000207","dc:identifier":"homoit0000207","skos:prefLabel":{"@language":"zap","@value":"Biza'ah"},"rdfs:comment":{"@language":"en","@value":"Among the Zapotec in Teotitlán del Valle, Mexico, this term refers to people assigned male at birth who exhibit feminine characteristics."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bizaah"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000477","dc:identifier":"homoit0000477","skos:prefLabel":{"@language":"en","@value":"Black gay men"},"skos:altLabel":{"@language":"en","@value":"Gay Black men"},"rdfs:comment":{"@language":"en","@value":"Black men who are gay. Use only for individuals who self-identity as Black. Follow the individual’s preference for African American or Black whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000208"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2004002160"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayBlackPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-11-03"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000726","dc:identifier":"homoit0000726","skos:prefLabel":{"@language":"en","@value":"Black lesbians"},"rdfs:comment":{"@language":"en","@value":"Black people who are lesbians. Use only for individuals who self-identity as Black. Follow the individual’s preference for African American or Black whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000208"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2013002418"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianBlackPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-11-03"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001163","dc:identifier":"homoit0001163","skos:prefLabel":{"@language":"en","@value":"Black queer people"},"skos:altLabel":{"@language":"en","@value":"Queer Black people"},"rdfs:comment":{"@language":"en","@value":"Black people who are queer. Use only for individuals who self-identity as Black. Follow the individual’s preference for African American or Black whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000208"},"skos:related":{"@id":"ht