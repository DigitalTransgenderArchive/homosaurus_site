te","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002606","dc:identifier":"homoit0002606","skos:prefLabel":{"@language":"en","@value":"Two-Spirit erotic art "},"skos:altLabel":[{"@language":"en","@value":"2S erotic art "},{"@language":"en","@value":"Two Spirit erotic art "},{"@language":"en","@value":"Two Spirited erotic art "},{"@language":"en","@value":"Two-Spirited erotic art "}],"rdfs:comment":{"@language":"en","@value":"Erotic art, created by Two-Spirit artists, depicting Two-Spirit people, or that are regarded as important within Two-Spirit culture."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002597"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002579"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002597"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002580","dc:identifier":"homoit0002580","skos:prefLabel":{"@language":"en","@value":"Appropriation of Indigenous identity"},"skos:altLabel":{"@language":"en","@value":"Pretendians"},"rdfs:comment":{"@language":"en","@value":"A form of cultural appropriation and race shifting involving false claims of citizenship, belonging, and/or descent from Indigenous people in North America. Not to be confused with disconnected or reconnecting descendants."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002582"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002581"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002582"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002582","dc:identifier":"homoit0002582","skos:prefLabel":{"@language":"en","@value":"Appropriation of marginalized identities"},"rdfs:comment":{"@language":"en","@value":"Falsely claiming belonging to a marginalized group (including, but not limited to: disability, ethnicity, race, and sexuality)."},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002580"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002582"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003091","dc:identifier":"homoit0003091","skos:prefLabel":{"@language":"en","@value":"Lateral oppression"},"skos:altLabel":{"@language":"en","@value":"Lateral violence"},"rdfs:comment":{"@language":"en","@value":"The phenomenon in which someone in a marginalized group displaces violence or oppression onto other members of their own group, often by acting on internalized oppressive beliefs (i.e., negative perceptions of and intolerance toward any marginalized identities they hold) adopted as a result of being raised or socialized within an oppressive environment or culture."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0003092"},{"@id":"https://homosaurus.org/v3/homoit0003093"},{"@id":"https://homosaurus.org/v3/homoit0003094"},{"@id":"https://homosaurus.org/v3/homoit0003095"},{"@id":"https://homosaurus.org/v3/homoit0003096"},{"@id":"https://homosaurus.org/v3/homoit0003097"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002590"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0003091"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003092","dc:identifier":"homoit0003092","skos:prefLabel":{"@language":"en","@value":"Lateral lesbophobia"},"rdfs:comment":{"@language":"en","@value":"The phenomenon in which lesbians displace violence or oppression onto other lesbians, often by acting on internalized lesbophobic beliefs (i.e., negative perceptions of and intolerance toward lesbians and lesbianism) adopted as a result of being raised or socialized within a lesbophobic environment or culture."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0002591"},{"@id":"https://homosaurus.org/v3/homoit0003091"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003094","dc:identifier":"homoit0003094","skos:prefLabel":{"@language":"en","@value":"Lateral biphobia"},"rdfs:comment":{"@language":"en","@value":"The phenomenon in which bisexual people displace violence or oppression onto other bisexual people, often by acting on internalized biphobic beliefs (i.e., negative perceptions of and intolerance toward bisexual people and bisexuality) adopted as a result of being raised or socialized within a biphobic environment or culture."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0002592"},{"@id":"https://homosaurus.org/v3/homoit0003091"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003095","dc:identifier":"homoit0003095","skos:prefLabel":{"@language":"en","@value":"Lateral transphobia"},"rdfs:comment":{"@language":"en","@value":"The phenomenon in which transgender people displace violence or oppression onto other transgender people, often by acting on internalized transphobic beliefs (i.e., negative perceptions of and intolerance toward transgender people and trans identities) adopted as a result of being raised or socialized within transphobic environment or culture."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0002593"},{"@id":"https://homosaurus.org/v3/homoit0003091"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003096","dc:identifier":"homoit0003096","skos:prefLabel":{"@language":"en","@value":"Lateral queerphobia"},"rdfs:comment":{"@language":"en","@value":"The phenomenon in which queer people displace violence or oppression onto other queer people, often by acting on internalized queerphobic beliefs (i.e., negative perceptions of and intolerance toward queer people and queer identity) adopted as a result of being raised or socialized within a queerphobic environment or culture."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0002594"},{"@id":"https://homosaurus.org/v3/homoit0003091"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003097","dc:identifier":"homoit0003097","skos:prefLabel":{"@language":"en","@value":"Lateral intersexphobia"},"skos:altLabel":{"@language":"en","@value":"Lateral interphobia"},"rdfs:comment":{"@language":"en","@value":"The phenomenon in which intersex people displace violence or oppression onto other intersex people, often by acting on internalized intersexphobic beliefs (i.e., negative perceptions of and intolerance toward intersex people and intersex variations) adopted as a result of being raised or socialized within a intersexphobic environment or culture."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0002595"},{"@id":"https://homosaurus.org/v3/homoit0003091"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002619","dc:identifier":"homoit0002619","skos:prefLabel":{"@language":"en","@value":"Assisted reproductive technology "},"skos:altLabel":[{"@language":"en","@value":"ART"},{"@language":"en","@value":"Assisted reproductive technologies"}],"rdfs:comment":{"@language":"en","@value":"An umbrella term used to describe all methods of conception beyond sexual intercourse, including but not limited to donor insemination, artificial insemination, surrogacy, egg donation, and IVF."},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002618"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88005587"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002619"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-10-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002622","dc:identifier":"homoit0002622","skos:prefLabel":{"@language":"en","@value":"Egg donation "},"rdfs:comment":{"@language":"en","@value":"The process by which a person donates their eggs for reproduction."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002618"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002627"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002619"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-10-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003005","dc:identifier":"homoit0003005","skos:prefLabel":{"@language":"en","@value":"Non-binary neurodivergent people"},"skos:altLabel":{"@language":"en","@value":"Neurodivergent non-binary people"},"rdfs:comment":{"@language":"en","@value":"Non-binary people whose brains process, learn, and/or behave differently from what is considered typical by society. Some of these neurological differences can present as learning disabilities, medical disorders, and other conditions."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002652"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002673"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003011","dc:identifier":"homoit0003011","skos:prefLabel":{"@language":"en","@value":"Non-binary blind people"},"skos:altLabel":[{"@language":"en","@value":"Blind non-binary people"},{"@language":"en","@value":"Nonbinary blind people"}],"rdfs:comment":{"@language":"en","@value":"Non-binary people with significant or total loss of vision."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002652"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003016","dc:identifier":"homoit0003016","skos:prefLabel":{"@language":"en","@value":"Non-binary hard of hearing people"},"skos:altLabel":[{"@language":"en","@value":"Hearing impaired non-binary people"},{"@language":"en","@value":"HoH Non-binary people"},{"@language":"en","@value":"Non-bi