":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001669","dc:identifier":"homoit0001669","skos:prefLabel":{"@language":"en","@value":"Tribadism"},"skos:altLabel":{"@language":"en","@value":"Tribbing"},"rdfs:comment":{"@language":"en","@value":"A mostly antiquated term used either to refer to scissoring, to any sexual activity between women, or to the general concept of being a lesbian (\"lesbianism\")."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000878"},{"@id":"https://homosaurus.org/v3/homoit0001267"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000799"},{"@id":"https://homosaurus.org/v3/homoit0001472"},{"@id":"https://homosaurus.org/v3/homoit0001667"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tribadism"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000800","dc:identifier":"homoit0000800","skos:prefLabel":{"@language":"en","@value":"Lesbians in the military"},"rdfs:comment":{"@language":"en","@value":"Lesbians serving in state and national armed forces."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001100"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbiansInTheMilitary"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000801","dc:identifier":"homoit0000801","skos:prefLabel":[{"@language":"en-us","@value":"Lesbians of color"},{"@language":"en-gb","@value":"Lesbians of colour"}],