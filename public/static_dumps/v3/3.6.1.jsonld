ps://homosaurus.org/v3/homoit0002036","dc:identifier":"homoit0002036","skos:prefLabel":{"@language":"en","@value":"Intersex people in the workplace"},"rdfs:comment":{"@language":"en","@value":"The presence of intersex people in the workplace, including acceptance of and issues faced by intersex workers."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002029"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001717"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002037","dc:identifier":"homoit0002037","skos:prefLabel":{"@language":"en","@value":"Asexual people in the workplace"},"rdfs:comment":{"@language":"en","@value":"The presence of asexual people in the workplace, including acceptance of and issues faced by asexual workers."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002029"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001717"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002194","dc:identifier":"homoit0002194","skos:prefLabel":{"@language":"en","@value":"Racism in fandom"},"rdfs:comment":{"@language":"en","@value":"Issues and discussions about the presence of racism in fan spaces and works."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0002038"},{"@id":"https://homosaurus.org/v3/homoit0002156"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0002174"},{"@id":"https://homosaurus.org/v3/homoit0002183"},{"@id":"https://homosaurus.org/v3/homoit0002212"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002038"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003692","dc:identifier":"homoit0003692","skos:prefLabel":{"@language":"en","@value":"Redlining"},"skos:altLabel":[{"@language":"en","@value":"Red lining"},{"@language":"en","@value":"Credit card redlining"}],"rdfs:comment":{"@language":"en","@value":"A discriminatory practice in which financial services are withheld from neighborhoods that have significant numbers of racial and ethnic minorities. Redlining includes but is not limited to denial of credit, insurance, and healthcare; inflated mortgage and interest rates; and the development of food deserts. The term has its roots in the New Deal when color-coded maps were made of metropolitan areas in the United States to indicate where it was considered safe to insure mortgages. Black neighborhoods and surrounding areas were colored red to indicate mortgages should not be insured there."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0002257"},{"@id":"https://homosaurus.org/v3/homoit0002038"},{"@id":"https://homosaurus.org/v3/homoit0003691"}],"skos:closeMatch":[{"@id":"http://id.loc.gov/authorities/subjects/sh85038399"},{"@id":"http://id.loc.gov/authorities/subjects/sh85038383"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0003692"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002040","dc:identifier":"homoit0002040","skos:prefLabel":{"@language":"en","@value":"Female gaze"},"rdfs:comment":{"@language":"en","@value":"A term used to describe the depiction of women in media and the arts as subjects with agency and whose perspective a text may be presented from. Often used in contrast to the male gaze."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002039"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002042"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002041","dc:identifier":"homoit0002041","skos:prefLabel":{"@language":"en","@value":"Male gaze"},"rdfs:comment":{"@language":"en","@value":"A term used to describe the sexualized and objectified depiction of women in media and the arts from the perspective of and for the pleasure of the heterosexual man/male viewer. Originally used solely to describe the heterosexual, cisgender gaze but has since been expanded."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002039"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002042"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002045","dc:identifier":"homoit0002045","skos:prefLabel":{"@language":"en","@value":"South Asian lesbians"},"skos:altLabel":[{"@language":"en","@value":"Lesbian South Asian people"},{"@language":"en","@value":"Lesbian South Asians"}],"rdfs:comment":{"@language":"en","@value":"Lesbians who belong to or are descended from the ethnolinguistic groups of South Asia."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002044"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002046","dc:identifier":"homoit0002046","skos:prefLabel":{"@language":"en","@value":"