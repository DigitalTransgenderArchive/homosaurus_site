{"@id":"https://homosaurus.org/v3/homoit0000356"},{"@id":"https://homosaurus.org/v3/homoit0000580"},{"@id":"https://homosaurus.org/v3/homoit0000701"},{"@id":"https://homosaurus.org/v3/homoit0000927"},{"@id":"https://homosaurus.org/v3/homoit0001482"},{"@id":"https://homosaurus.org/v3/homoit0001560"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001108"},"dc:replaces":{"@id":"http://homosaurus.org/v2/persecutionsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001293","dc:identifier":"homoit0001293","skos:prefLabel":{"@language":"en","@value":"Sexual harassment"},"rdfs:comment":{"@language":"en","@value":"Unwelcome behavior of a sexual nature, including unwanted advances or requests for sexual favors."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000611"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000059"},{"@id":"https://homosaurus.org/v3/homoit0000675"},{"@id":"https://homosaurus.org/v3/homoit0001278"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120735"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000611"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualHarassment"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001305","dc:identifier":"homoit0001305","skos:prefLabel":{"@language":"en","@value":"Sexual violence"},"rdfs:comment":{"@language":"en","@value":"Sexual acts or attempts to coerce sexual acts that involve the use of non-consensual violence. This term encompasses sexual assault, rape, and sexual abuse."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000306"},{"@id":"https://homosaurus.org/v3/homoit0000855"},{"@id":"https://homosaurus.org/v3/homoit0000938"},{"@id":"https://homosaurus.org/v3/homoit0000958"},{"@id":"https://homosaurus.org/v3/homoit0001285"},{"@id":"https://homosaurus.org/v3/homoit0003433"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000059"},{"@id":"https://homosaurus.org/v3/homoit0002195"},{"@id":"https://homosaurus.org/v3/homoit0003444"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120572"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001305"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001348","dc:identifier":"homoit0001348","skos:prefLabel":{"@language":"en","@value":"Survivors of anti-LGBTQ+ violence"},"skos:altLabel":{"@language":"en","@value":"Survivors of anti-LGBTQ violence"},"rdfs:comment":{"@language":"en","@value":"People who have experienced and survived anti-LGBTQ+ violence; follow individuals’ preference for “victims” or “survivors” whenever possible."},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000059"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001348"},"dc:replaces":{"@id":"http://homosaurus.org/v2/survivorsOfAntiLGBTQViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000060","dc:identifier":"homoit0000060","skos:prefLabel":{"@language":"en","@value":"Anti-queer discrimination"},"rdfs:comment":{"@language":"en","@value":"The unjust or prejudicial treatment of queer people due to their identity; may include the denial of legal rights, employment, and housing."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000356"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001229"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000356"},"dc:replaces":{"@id":"http://homosaurus.org/v2/antiQueerDiscrimination"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001229","dc:identifier":"homoit0001229","skos:prefLabel":{"@language":"en","@value":"Queerphobia"},"rdfs:comment":{"@language":"en","@value":"Antagonism or disgust directed towards queerness as an identity or queer people due to their identity, perceived or actual. Queerphobia can include denial of the existence of queerness, stereotypes, verbal harassment, and physical violence."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000920"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002594"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000060"},{"@id":"https://homosaurus.org/v3/homoit0000061"},{"@id":"https://homosaurus.org/v3/homoit0000619"},{"@id":"https://homosaurus.org/v3/homoit0001195"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerphobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000062","dc:identifier":"homoit0000062","skos:prefLabel":{"@language":"en","@value":"Anti-transgender discrimination"},"rdfs:comment":{"@language":"en","@value":"The unjust or prejudicial treatment of transgender people (or others perceived to be transgressing gender norms) due to their gender identity and/or expression; may include the denial of legal rights, employment, and housing."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000356"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000336"},{"@id":"https://homosaurus.org/v3/homoit0001819"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001006"},{"@id":"https://homosaurus.org/v3/homoit0001139"},{"@id":"https://homosaurus.org/v3/homoit0001140"},{"@id":"https://homosaurus.org/v3/homoit0001141"},{"@id":"https://homosaurus.org/v3/homoit0001467"},{"@id":"https://homosaurus.org/v3/homoit0001516"},{"@id":"https://homosaurus.org/v3/homoit0001892"},{"@id":"https://homosaurus.org/v3/homoit0001903"},{"@id":"https://homosaurus.org/v3/homoit0003158"},{"@id":"https://homosaurus.org/v3/homoit0003499"},{"@id":"https://homosaurus.org/v3/homoit0003737"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2010012303"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000356"},"dc:replaces":{"@id":"http://homosaurus.org/v2/antiTransgenderDiscrimination"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000336","dc:identifier":"homoit0000336","skos:prefLabel":{"@language":"en","@value":"Deadnaming"},"rdfs:comment":{"@language":"en","@value":"The act of using or referring to a person’s assigned name rather than their chosen name, commonly with malicious intent."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000062"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000264"},{"@id":"https://homosaurus.org/v3/homoit0000592"},{"@id":"https://homosaurus.org/v3/homoit0001016"},{"@id":"https://homosaurus.org/v3/homoit0001065"},{"@id":"https://homosaurus.org/v3/homoit0001560"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000356"},"dc:replaces":{"@id":"http://homosaurus.org/v2/deadnaming"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001819","dc:identifier":"homoit0001819","skos:prefLabel":{"@language":"en","@value":"Trans exclusivity"},"skos:altLabel":[{"@language":"en","@value":"Trans exclusion"},{"@language":"en","@value":"Trans exclusive"},{"@language":"en","@value":"Trans-exclusive"}],"rdfs:comment":{"@language":"en","@value":"The practice or policy of denying equal access and support to trans people."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000062"},{"@id":"https://homosaurus.org/v3/homoit0002291"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001139"},{"@id":"https://homosaurus.org/v3/homoit0001467"},{"@id":"https://homosaurus.org/v3/homoit0001516"},{"@id":"https://homosaurus.org/v3/homoit0003499"},{"@id":"https://homosaurus.org/v3/homoit0003737"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000356"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001006","dc:identifier":"homoit0001006","skos:prefLabel":[{"@language":"en-us","@value":"Medicalization"},{"@language":"en-gb","@value":"Medicalisation"}],"rdfs:comment":{"@language":"en","@value":"Process by which human conditions and experiences come to be defined and treated as medical conditions and thus become the subject of medical study, diagnosis, prevention, and/or treatment. Use in reference to non-medical problems, such as LGBTQ+ identities and practices, that have been wrongly treated as medical issues."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001004"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000395"},{"@id":"https://homosaurus.org/v3/homoit0000572"},{"@id":"https://homosaurus.org/v3/homoit0000669"},{"@id":"https://homosaurus.org/v3/homoit0001296"},{"@id":"https://homosaurus.org/v3/homoit0001463"},{"@id":"https://homosaurus.org/v3/homoit0001468"},{"@id":"https://homosaurus.org/v3/homoit0001469"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000062"},{"@id":"https://homosaurus.org/v3/homoit0000357"},{"@id":"https://homosaurus.org/v3/homoit0000567"},{"@id":"https://homosaurus.org/v3/homoit0001268"},{"@id":"https://homosaurus.org/v3/homoit0001320"},{"@id":"https://homosaurus.org/v3/homoit0002835"},{"@id":"https://homosaurus.org/v3/homoit0002841"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2016000450"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/medicalisation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001139","dc:identifier":"homoit0001139","skos:prefLabel":{"@language":"en","@value":"Bathroom bans"},"skos:altLabel":[{"@language":"en","@value":"Changing room bans"},{"@language":"en","@value":"Locker room bans"},{"@language":"en","@value":"Restroom bans"}],"rdfs:comment":{"@language":"en","@value":"Laws or policies instituted to prevent trans and non-binary individuals from using public bathrooms and facilities, such as locker rooms, shower rooms, changing rooms, and other sex-segregated spaces, on the basis of their gender identity."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0003499"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000248"},{"@id":"https://homosaurus.org/v3/homoit0000975"},{"@id":"https://homosaurus.org/v3/homoit0001140"},{"@id":"https://homosaurus.org/v3/homoit0001141"},{"@id":"https://homosaurus.org/v3/homoit0001143"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/publicBathroomBills"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001140","dc:identifier":"homoit0001140","skos:prefLabel":{"@language":"en","@value":"Public bathrooms"},"skos:altLabel":[{"@language":"en","@value":"Public restrooms"},{"@language":"en","@value":"Toilets"}],"rdfs:comment":{"@language":"en","@value":"Rooms or small buildings with one or more toilets (or urinals) available for use by the general public or by customers or employees of a business."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001141"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000595"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000062"},{"@id":"https://homosaurus.org/v3/homoit0000308"},{"@id":"https://homosaurus.org/v3/homoit0001090"},{"@id":"https://homosaurus.org/v3/homoit0001139"},{"@id":"https://homosaurus.org/v3/homoit0001358"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85108627"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001141"},"dc:replaces":{"@id":"http://homosaurus.org/v2/publicBathrooms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001467","dc:identifier":"homoit0001467","skos:prefLabel":{"@language":"en","@value":"Transphobia"},"rdfs:comment":{"@language":"en","@value":"Antagonism or disgust directed toward trans individuals (or others perceived to be transgressing gender norms) due to their gender identity and/or expression. Transphobia can include denial of the existence of trans identities, stereotypes, verbal harassment, and physical violence."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000920"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002212"},{"@id":"https://homosaurus.org/v3/homoit0002593"},{"@id":"https://homosaurus.org/v3/homoit0003158"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000062"},{"@id":"https://homosaurus.org/v3/homoit0000063"},{"@id":"https://homosaurus.org/v3/homoit0000619"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001819"},{"@id":"https://homosaurus.org/v3/homoit0001892"},{"@id":"https://homosaurus.org/v3/homoit0001903"},{"@id":"https://homosaurus.org/v3/homoit0003499"},{"@id":"https://homosaurus.org/v3/homoit0003737"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2010012303"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transphobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001516","dc:identifier":"homoit0001516","skos:prefLabel":{"@language":"en","@value":"Womyn"},"rdfs:comment":{"@language":"en","@value":"A spelling of \"woman\" or \"women\" that first appeared in print in 1976 and is used in certain feminist circles to avoid having the suffix of \"men.\"  Some contemporary transgender activists have criticized use of the word \"womyn\" due to its prevalence in trans-exclusionary radical feminist (TERF) circles following the exclusion of trans women from the Michigan Womyn’s Music Festival."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000062"},{"@id":"https://homosaurus.org/v3/homoit0000437"},{"@id":"https://homosaurus.org/v3/homoit0001230"},{"@id":"https://homosaurus.org/v3/homoit0001505"},{"@id":"https://homosaurus.org/v3/homoit0001509"},{"@id":"https://homosaurus.org/v3/homoit0001515"},{"@id":"https://homosaurus.org/v3/homoit0001819"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85147274"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001516"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womyn"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-03-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001892","dc:identifier":"homoit0001892","skos:prefLabel":{"@language":"en","@value":"Transmisogyny"},"rdfs:comment":{"@language":"en","@value":"The intersection of transphobia and misogyny as directed toward trans women and transfeminine people."},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0003158"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000062"},{"@id":"https://homosaurus.org/v3/homoit0000112"},{"@id":"https://homosaurus.org/v3/homoit0001017"},{"@id":"https://homosaurus.org/v3/homoit0001467"},{"@id":"https://homosaurus.org/v3/homoit0001903"},{"@id":"https://homosaurus.org/v3/homoit0001904"},{"@id":"https://homosaurus.org/v3/homoit0002273"},{"@id":"https://homosaurus.org/v3/homoit0002274"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001892"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001903","dc:identifier":"homoit0001903","skos:prefLabel":{"@language":"en","@value":"Transmisogynoir"},"rdfs:comment":{"@language":"en","@value":"Term coined by coined by Trudy of the womanist blog Gradient Lair to describe the intersection of transphobia, misogyny, and anti-Black racism as directed toward Black trans women."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000062"},{"@id":"https://homosaurus.org/v3/homoit0000112"},{"@id":"https://homosaurus.org/v3/homoit0001017"},{"@id":"https://homosaurus.org/v3/homoit0001467"},{"@id":"https://homosaurus.org/v3/homoit0001892"},{"@id":"https://homosaurus.org/v3/homoit0001902"},{"@id":"https://homosaurus.org/v3/homoit0001904"},{"@id":"https://homosaurus.org/v3/homoit0002038"},{"@id":"https://homosaurus.org/v3/homoit0002257"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001903"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003158","dc:identifier":"homoit0003158","skos:prefLabel":{"@language":"en","@value":"Trans-exclusionary radical feminism"},"skos:altLabel":[{"@language":"en","@value":"Gender critical feminism"},{"@language":"en","@value":"TERF ideology"},{"@language":"en","@value":"Trans-exclusionary feminism"}],"rdfs:comment":{"@language":"en","@value":"A transphobic and transantagonistic ideology that rejects trans and gender diverse identities and rights, and believes that recognition of these identities and rights constitutes discrimination and oppression towards cisgender women. Though originally considered a fringe offshoot of feminism, trans-exclusionary radical feminist groups have formed alliances with right-wing, far-right extremists, and anti-feminist organizations in order to spread misinformation and further anti-trans sentiment and legislation. "},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000115"},{"@id":"https://homosaurus.org/v3/homoit0000565"},{"@id":"https://homosaurus.org/v3/homoit0001467"},{"@id":"https://homosaurus.org/v3/homoit0001892"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000062"},{"@id":"https://homosaurus.org/v3/homoit0000437"},{"@id":"https://homosaurus.org/v3/homoit0001260"},{"@id":"https://homosaurus.org/v3/homoit0001885"},{"@id":"https://homosaurus.org/v3/homoit0003157"},{"@id":"https://homosaurus.org/v3/homoit0003737"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-02"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003499","dc:identifier":"homoit0003499","skos:prefLabel":{"@language":"en","@value":"Anti-transgender legislation"},"skos:altLabel":[{"@language":"en","@value":"Anti-trans law-making"},{"@language":"en","@value":"Anti-trans legislation"},{"@language":"en","@value":"Anti-transgender law-making"}],"rdfs:comment":{"@language":"en","@value":"Efforts to propose, enact, amend, or strike down laws as a means of restricting the legal rights of transgender people. This includes legislation regarding access to gender-affirming healthcare, participation in sporting events, administrative and judicial procedures such as sex and name registration, and policies affecting the medical treatment, education, and mental health care of transgender youth."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000702"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001139"},{"@id":"https://homosaurus.org/v3/homoit0003502"},{"@id":"https://homosaurus.org/v3/homoit0003503"},{"@id":"https://homosaurus.org/v3/homoit0003504"},{"@id":"https://homosaurus.org/v3/homoit0003510"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000062"},{"@id":"https://homosaurus.org/v3/homoit0000314"},{"@id":"https://homosaurus.org/v3/homoit0001467"},{"@id":"https://homosaurus.org/v3/homoit0001819"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003737","dc:identifier":"homoit0003737","skos:prefLabel":{"@language":"en","@value":"Anti-gender movement"},"skos:altLabel":{"@language":"en","@value":"Gender critical movement"},"rdfs:comment":{"@language":"en","@value":"A movement that opposes what is referred to as \"gender ideology,\" or the belief that gender is a social construct that exists on a spectrum. Members of the anti-gender movement oppose the visibility, acceptance, and civil and reproductive rights of trans, non-binary, intersex, Two-Spirit, gender diverse, and gender non-conforming people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001322"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0003158"},{"@id":"https://homosaurus.org/v3/homoit0001819"},{"@id":"https://homosaurus.org/v3/homoit0001467"},{"@id":"https://homosaurus.org/v3/homoit0000062"},{"@id":"https://homosaurus.org/v3/homoit0001893"},{"@id":"https://homosaurus.org/v3/homoit0001885"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001322"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-23"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000064","dc:identifier":"homoit0000064","skos:prefLabel":{"@language":"en","@value":"Aphallia"},"skos:altLabel":{"@language":"en","@value":"Penile agenesis"},"rdfs:comment":{"@language":"en","@value":"People with aphallia have XY chromosomes, testes, and are born without a penis. They produce typical levels of testosterone, and they develop secondary sex characteristics associated with a typical testosterone puberty during adolescence."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/aphallia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000065","dc:identifier":"homoit0000065","skos:prefLabel":{"@language":"ta","@value":"Aravani"},"skos:altLabel":{"@language":"ta","@value":"Aruvani"},"rdfs:comment":{"@language":"en","@value":"Indian term for people who identify as women trapped in male bodies; many prefer other terms, such as hijra or thirunangai."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000632"},{"@id":"https://homosaurus.org/v3/homoit0001370"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/aravani"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000632","dc:identifier":"homoit0000632","skos:prefLabel":{"@language":"hil","@value":"Hijras"},"skos:altLabel":{"@language":"en","@value":"Jagappa"},"rdfs:comment":{"@language":"en","@value":"Hindi word used in South Asia to refer to people assigned male at birth who identify as women or “not-men.”"},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000065"},{"@id":"https://homosaurus.org/v3/homoit0000240"},{"@id":"https://homosaurus.org/v3/homoit0000246"},{"@id":"https://homosaurus.org/v3/homoit0000684"},{"@id":"https://homosaurus.org/v3/homoit0000688"},{"@id":"https://homosaurus.org/v3/homoit0000689"},{"@id":"https://homosaurus.org/v3/homoit0000690"},{"@id":"https://homosaurus.org/v3/homoit0000694"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hijra"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001370","dc:identifier":"homoit0001370","skos:prefLabel":{"@language":"ta","@value":"Thirunangai"},"rdfs:comment":{"@language":"en","@value":"Regional term in Tamil Nadu, India for people assigned male at birth who identify as women."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000065"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/thirunangai"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000066","dc:identifier":"homoit0000066","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ archives"},"skos:altLabel":[{"@language":"en","@value":"LGBTQ archives"},{"@language":"en","@value":"Archives (LGBTQ)"}],"rdfs:comment":{"@language":"en","@value":"Collections of records and materials relating to LGBTQ+ people or LGBTQ+ communities; can include a variety of organizations and institutions from community to government archives."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001755"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000128"},{"@id":"https://homosaurus.org/v3/homoit0000469"},{"@id":"https://homosaurus.org/v3/homoit0000719"},{"@id":"https://homosaurus.org/v3/homoit0001156"},{"@id":"https://homosaurus.org/v3/homoit0001389"},{"@id":"https://homosaurus.org/v3/homoit0002759"},{"@id":"https://homosaurus.org/v3/homoit0002776"},{"@id":"https://homosaurus.org/v3/homoit0003608"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000968"},{"@id":"https://homosaurus.org/v3/homoit0002677"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/archivesLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001755","dc:identifier":"