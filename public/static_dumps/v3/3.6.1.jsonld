https://homosaurus.org/v3/homoit0000568"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cubs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000267","dc:identifier":"homoit0000267","skos:prefLabel":{"@language":"en","@value":"Chubs (Gay culture)"},"skos:altLabel":[{"@language":"en","@value":"Chubs (Gay men)"},{"@language":"en","@value":"Chubs"}],"rdfs:comment":{"@language":"en","@value":"Slang term used in gay communities (primarily in the United States) to describe larger or heavy-set gay men."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000487"},{"@id":"https://homosaurus.org/v3/homoit0001295"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000105"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/chubsGayMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000598","dc:identifier":"homoit0000598","skos:prefLabel":{"@language":"en","@value":"Goldilocks (Gay culture)"},"skos:altLabel":{"@language":"en","@value":"Goldilocks"},"rdfs:comment":{"@language":"en","@value":"US slang term for heterosexual women who are friends with gay men in the bear community and socialize in bear spaces."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000629"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000105"},{"@id":"https://homosaurus.org/v3/homoit0000381"},{"@id":"https://homosaurus.org/v3/homoit0000416"},{"@id":"https://homosaurus.org/v3/homoit0000455"},{"@id":"https://homosaurus.org/v3/homoit0001133"},{"@id":"https://homosaurus.org/v3/homoit0001788"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000627"},"dc:replaces":{"@id":"http://homosaurus.org/v2/goldilocks"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001063","dc:identifier":"homoit0001063","skos:prefLabel":{"@language":"en","@value":"Otters (Gay culture)"},"skos:altLabel":[{"@language":"en","@value":"Otter men"},{"@language":"en","@value":"Otters"}],"rdfs:comment":{"@language":"en","@value":"U.S. slang term term for gay men who blend the physical and social traits of bears and twinks."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000487"},{"@id":"https://homosaurus.org/v3/homoit0000506"},{"@id":"https://homosaurus.org/v3/homoit0000577"},{"@id":"https://homosaurus.org/v3/homoit0001295"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000105"},{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0001145"},{"@id":"https://homosaurus.org/v3/homoit0001508"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/otters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-18"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001145","dc:identifier":"homoit0001145","skos:prefLabel":{"@language":"en","@value":"Pups (Roleplay)"},"skos:altLabel":[{"@language":"en","@value":"Puppers"},{"@language":"en","@value":"Puppies"}],"rdfs:comment":{"@language":"en","@value":"Individuals who take on the pup or puppy role in puppy play, a form of animal roleplay that is often but not always associated with BDSM and kink communities."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000487"},{"@id":"https://homosaurus.org/v3/homoit0000506"},{"@id":"https://homosaurus.org/v3/homoit0000705"},{"@id":"https://homosaurus.org/v3/homoit0001242"},{"@id":"https://homosaurus.org/v3/homoit0001295"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000105"},{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0001063"},{"@id":"https://homosaurus.org/v3/homoit0003083"},{"@id":"https://homosaurus.org/v3/homoit0003086"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pups"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001508","dc:identifier":"homoit0001508","skos:prefLabel":{"@language":"en","@value":"Wolves (Gay culture)"},"skos:altLabel":{"@language":"en","@value":"Wolves"},"rdfs:comment":{"@language":"en","@value":"U.S. slang term for heavy-set, masculine gay men who are often characterized as having hairy bodies and facial hair; typically used for individuals who are more aggressive and overtly masculine than bears."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000487"},{"@id":"https://homosaurus.org/v3/homoit0000506"},{"@id":"https://homosaurus.org/v3/homoit0000577"},{"@id":"https://homosaurus.org/v3/homoit0001295"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000321"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000105"},{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0000995"},{"@id":"https://homosaurus.org/v3/homoit0001063"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/wolves"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-18"},"@type":"skos:Concept","skos:inScheme":{"@id":"https: