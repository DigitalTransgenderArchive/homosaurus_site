.org/v3/homoit0000375","dc:identifier":"homoit0000375","skos:prefLabel":{"@language":"en","@value":"Drag queens"},"rdfs:comment":{"@language":"en","@value":"Performers, often people assigned male at birth, who dress in stereotypically feminine attire and enact feminine personas for the purpose of entertainment."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001148"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000316"},{"@id":"https://homosaurus.org/v3/homoit0000367"},{"@id":"https://homosaurus.org/v3/homoit0000370"},{"@id":"https://homosaurus.org/v3/homoit0000371"},{"@id":"https://homosaurus.org/v3/homoit0000372"},{"@id":"https://homosaurus.org/v3/homoit0000373"},{"@id":"https://homosaurus.org/v3/homoit0000374"},{"@id":"https://homosaurus.org/v3/homoit0000431"},{"@id":"https://homosaurus.org/v3/homoit0001906"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2021001445"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragQueens"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000396","dc:identifier":"homoit0000396","skos:prefLabel":{"@language":"en","@value":"Eonist people"},"rdfs:comment":{"@language":"en","@value":"Historical term for people assigned male at birth who adopt feminine behaviors."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000878"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000316"},{"@id":"https://homosaurus.org/v3/homoit0000395"},{"@id":"https://homosaurus.org/v3/homoit0001378"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/eonistPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001076","dc:identifier":"homoit0001076","skos:prefLabel":{"@language":"en","@value":"Parents of crossdressers"},"rdfs:comment":{"@language":"en","@value":"People who act as parents to one or more crossdresser. Only use to describe the parents of someone who self-identifies as a crossdresser."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002372"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000316"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/parentsOfCrossdressers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001085","dc:identifier":"homoit0001085","skos:prefLabel":{"@language":"en","@value":"Partners of crossdressers"},"rdfs:comment":{"@language":"en","@value":"People whose sexual, romantic, or play partner is a crossdresser. Only use to describe individuals whose partners self-identify as crossdressers."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002365"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000316"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnersOfCrossdressers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001470","dc:identifier":"homoit0001470","skos:prefLabel":{"@language":"en","@value":"Transvestites"},"rdfs:comment":{"@language":"en","@value":"U.S. historical term used to describe individuals who wear clothes associated with a gender other than their gender assigned at birth; generally considered to be a derogatory term; use only in historical contexts."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000878"},{"@id":"https://homosaurus.org/v3/homoit0001817"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000316"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001781"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transvestites"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000317","dc:identifier":"homoit0000317","skos:prefLabel":{"@language":"en","@value":"Hormone therapy (Gender)"},"skos:altLabel":[{"@language":"en","@value":"Cross-gender hormone therapy"},{"@language":"en","@value":"Hormone reassignment therapy"},{"@language":"en","@value":"Hormone replacement therapy"}],"rdfs:comment":{"@language":"en","@value":"The process of altering one's sex hormones using hormone blockers and/or doses of testosterone, estrogen, or progesterone."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001366"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000407"},{"@id":"https://homosaurus.org/v3/homoit0000650"},{"@id":"https://homosaurus.org/v3/homoit0001362"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001007"},{"@id":"https://homosaurus.org/v3/homoit0001047"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0002820"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2020000101"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hormoneTherapyGender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000407","dc:identifier":"homoit0000407","skos:prefLabel":{"@language":"en","@value":"Estrogen"},"rdfs:comment":{"@language":"en","@value":"A category of steroid hormones including estrone, estradiol, estriol, and estetrol. Estrogens are commonly utilized in feminizing hormone therapy regimens. Estrogens are produced mainly in the ovaries, in addition to the adrenal glands and fat cells. Responsible for certain secondary sexual characteristics, including breast growth, thickening of the endometrium, menstrual cycle regulation, and sperm maturation."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000317"},{"@id":"https://homosaurus.org/v3/homoit0000651"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000986"},{"@id":"https://homosaurus.org/v3/homoit0001642"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85045012"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/estrogen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000650","dc:identifier":"homoit0000650","skos:prefLabel":{"@language":"en","@value":"Hormone blockers"},"rdfs:comment":{"@language":"en","@value":"Medications used to block the body from producing certain hormones in order to replace or supplement them with other types of hormones."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000317"},{"@id":"https://homosaurus.org/v3/homoit0001007"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001138"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85061977"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hormoneBlockers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001362","dc:identifier":"homoit0001362","skos:prefLabel":{"@language":"en","@value":"Testosterone"},"rdfs:comment":{"@language":"en","@value":"A steroid hormone that is produced in the testes, ovaries, and adrenal cortex. Testosterone is commonly utilized in masculinizing hormone therapy regimens for certain secondary sexual characteristics, such as increased muscle mass and growth of body hair."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000317"},{"@id":"https://homosaurus.org/v3/homoit0000651"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000436"},{"@id":"https://homosaurus.org/v3/homoit0001643"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85134159"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/testosterone"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001007","dc:identifier":"homoit0001007","skos:prefLabel":{"@language":"en","@value":"Medication"},"skos:altLabel":{"@language":"en","@value":"Pharmaceuticals"},"rdfs:comment":{"@language":"en","@value":"Non-recreational drugs as used by members of the LGBTQ+ community."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001366"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000399"},{"@id":"https://homosaurus.org/v3/homoit0000650"},{"@id":"https://homosaurus.org/v3/homoit0001091"},{"@id":"https://homosaurus.org/v3/homoit0001130"},{"@id":"https://homosaurus.org/v3/homoit0001138"},{"@id":"https://homosaurus.org/v3/homoit0001981"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000317"},{"@id":"https://homosaurus.org/v3/homoit0000380"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85039719"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/medication"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001047","dc:identifier":"homoit0001047","skos:prefLabel":{"@language":"en","@value":"No hormone identity"},"rdfs:comment":{"@language":"en","@value":"Individuals who have not undergone hormone treatment; typically used to describe trans people who have not undergone and/or do not plan to undergo hormone treatment."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001464"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000317"},{"@id":"https://homosaurus.org/v3/homoit0000617"},{"@id":"https://homosaurus.org/v3/homoit0001049"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001381"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001465"},"dc:replaces":{"@id":"http://homosaurus.org/v2/noHormoneIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002820","dc:identifier":"homoit0002820","skos:prefLabel":{"@language":"en","@value":"Androgens"},"rdfs:comment":{"@language":"en","@value":"A term that encompasses testosterone, dihydrotestosterone, and other hormones primarily produced in the testes but also in the ovaries and adrenal glands."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000651"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000317"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000395","dc:identifier":"homoit0000395","skos:prefLabel":{"@language":"en","@value":"Eonism"},"rdfs:comment":{"@language":"en","@value":"Historical term used to describe people assigned male at birth who adopt feminine behaviors."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0000878"},{"@id":"https://homosaurus.org/v3/homoit0001006"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000318"},{"@id":"https://homosaurus.org/v3/homoit0000396"},{"@id":"https://homosaurus.org/v3/homoit0001296"},{"@id":"https://homosaurus.org/v3/homoit0001463"},{"@id":"https://homosaurus.org/v3/homoit0001468"},{"@id":"https://homosaurus.org/v3/homoit0001469"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/eonism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000685","dc:identifier":"homoit0000685","skos:prefLabel":{"@language":"ja","@value":"Kabuki"},"rdfs:comment":{"@language":"en","@value":"A form of theatre in Japan that often features crossdressing actors. Historically, female performers played both male and female roles, but women were later banned from performing and were replaced with male performers who played both male and female roles."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001363"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000318"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85071224"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001363"},"dc:replaces":{"@id":"http://homosaurus.org/v2/kabuki"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001233","dc:identifier":"homoit0001233","skos:prefLabel":{"@language":"en","@value":"Reading (Gender)"},"skos:altLabel":{"@language":"en","@value":"Reading (Transgender)"},"rdfs:comment":{"@language":"en","@value":"Slang term for the act of identifying (or reading) someone in public as trans, non-binary, crossdressing, or in drag. Unlike Clocking (Gender), which is typically understood as a threat (of violence or outing) against the person being clocked or read, Reading (Gender) refers to shared identification or recognized kinship between two individuals who are both gender minorities."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000318"},{"@id":"https://homosaurus.org/v3/homoit0001090"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001900"},{"@id":"https://homosaurus.org/v3/homoit0002192"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001233"},"dc:replaces":{"@id":"http://homosaurus.org/v2/readingTransgender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001469","dc:identifier":"homoit0001469","skos:prefLabel":{"@language":"en","@value":"Transvestism"},"rdfs:comment":{"@language":"en","@value":"U.S. historical term used to describe the practices of individuals who wear clothes associated with a gender other than their gender assigned at birth; generally considered to be a derogatory term; use only in historical contexts."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0001006"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000318"},{"@id":"https://homosaurus.org/v3/homoit0000395"},{"@id":"https://homosaurus.org/v3/homoit0001563"},{"@id":"https://homosaurus.org/v3/homoit0001895"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transvestism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003126","dc:identifier":"homoit0003126","skos:prefLabel":{"@language":"en","@value":"Dollification"},"skos:altLabel":{"@language":"en","@value":"Rubber dolling"},"rdfs:comment":{"@language":"en","@value":"A practice of dressing and acting like a living doll (through makeup, dressing, etc.) for aesthetic or sexual gratification."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000318"},{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0001246"},{"@id":"https://homosaurus.org/v3/homoit0003070"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0003126"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000320","dc:identifier":"homoit0000320","skos:prefLabel":{"@language":"en","@value":"Crystal meth"},"skos:altLabel":{"@language":"en","@value":"Tina"},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000290"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001536"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000380"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000380"},"dc:replaces":{"@id":"http://homosaurus.org/v2/crystalMeth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001536","dc:identifier":"homoit0001536","skos:prefLabel":{"@language":"en","@value":"Crystal meth addiction"},"skos:altLabel":[{"@language":"en","@value":"Crystal meth misuse"},{"@language":"en","@value":"Crystal meth abuse"},{"@language":"en","@value":"Methamphetamine misuse"},{"@language":"en","@value":"Methamphetamine abuse"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001551"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001536"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0002226"},"dc:replaces":{"@id":"http://homosaurus.org/v2/crystalMethAddiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000340","dc:identifier":"homoit0000340","skos:prefLabel":{"@language":"tha","@value":"Dee"},"rdfs:comment":{"@language":"en","@value":"In Thailand, cisgender women who conform to feminine gender norms and who often partner with masculine-identified toms; similar to a femme in U.S. lesbian culture."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000687"},{"@id":"https://homosaurus.org/v3/homoit0001373"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dee"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000350","dc:identifier":"homoit0000350","skos:prefLabel":{"@language":"bn","@value":"Dhurani"},"rdfs:comment":{"@language":"en","@value":"Bengali term for third sex people, often referring to feminine people who were assigned male at birth."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dhurani"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000353","dc:identifier":"homoit0000353","skos:prefLabel":{"@language":"nv","@value":"Dilbaa"},"rdfs:comment":{"@language":"en","@value":"Navajo term for a person assigned female at birth who takes on the role of a boy in childhood and a man in adulthood."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001035"},{"@id":"https://homosaurus.org/v3/homoit0001480"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dilbaa"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000413","dc:identifier":"homoit0000413","skos:prefLabel":{"@language":"smo","@value":"Fa'afafine"},"rdfs:comment":{"@language":"en","@value":"In New Zealand, Samoan people who were assigned male at birth but behave in feminine ways and may consider themselves women."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000322"},{"@id":"https://homosaurus.org/v3/homoit0002653"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000414"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/faafafine"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000414","dc:identifier":"homoit0000414","skos:prefLabel":{"@language":"smo","@value":"Fa'afatama"},"rdfs:comment":{"@language":"en","@value":"In New Zealand, Samoan people who were assigned female at birth but behave in masculine ways and may consider themselves men."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000413"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/faafatama"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000419","dc:identifier":"homoit0000419","skos:prefLabel":{"@language":"ton","@value":"Fakaleitī"},"skos:altLabel":{"@language":"ton","@value":"Fakaleiti"},"rdfs:comment":{"@language":"en","@value":"Tongan people assigned male at birth who behave in an effeminate manner."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000322"},{"@id":"https://homosaurus.org/v3/homoit0002653"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fakaleiti"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000441","dc:identifier":"homoit0000441","skos:prefLabel":{"@language":"nap","@value":"Femminiello"},"rdfs:comment":{"@language":"en","@value":"In Italy, this is a Neapolitan term for homosexual men with feminine gender expression. Often considered a third gender; associated with good luck."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/femminiello"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000461","dc:identifier":"homoit0000461","skos:prefLabel":{"@language":"lat","@value":"Galli"},"rdfs:comment":{"@language":"en","@value":"A term originating in Ancient Rome that describes eunuch priestesses who were voluntarily castrated as part of an annual celebration."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/galli"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000604","dc:identifier":"homoit0000604","skos:prefLabel":{"@language":"es","@value":"Güevedoce"},"skos:altLabel":{"@language":"es","@value":"Guevedoche"},"rdfs:comment":{"@language":"en","@value":"In the Dominican Republic, this term refers to people who have undifferentiated genitalia and who are generally raised as female until puberty; may be considered a third gender."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/guevedoche"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000616","dc:identifier":"homoit0000616","skos:prefLabel":{"@language":"chy","@value":"Hemaneh"},"rdfs:comment":{"@language":"en","@value":"Cheyenne term for a half-man, half-woman persona."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hemaneh"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000678","dc:identifier":"homoit0000678","skos:prefLabel":{"@language":"pa","@value":"Jankha"},"rdfs:comment":{"@language":"en","@value":"In India, this term is used to describe people assigned male at birth who take on female dress and characteristics but who do not elect to receive castration."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/jankha"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000684","dc:identifier":"homoit0000684","skos:prefLabel":{"@language":"kn","@value":"Jogappa"},"rdfs:comment":{"@language":"en","@value":"In India, this term is used to describe people assigned male at birth who become genderfluid in a spiritual conversion."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000632"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/jogappa"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000687","dc:identifier":"homoit0000687","skos:prefLabel":{"@language":"tha","@value":"Katoey"},"skos:altLabel":[{"@language":"en","@value":"Ladyboy"},{"@language":"tha","@value":"Kathoey"}],"rdfs:comment":{"@language":"en","@value":"In Thailand, this term refers to a range of people of non-normative gender expressions, including intersex people, transgender women, and effeminate gay men. Some regard this term as outdated and offensive, while others self-identify with it. Only use to describe people who self-identify as katoey."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000322"},{"@id":"https://homosaurus.org/v3/homoit0001297"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000340"},{"@id":"https://homosaurus.org/v3/homoit0001373"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/katoey"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000688","dc:identifier":"homoit0000688","skos:prefLabel":{"@language":"pa","@value":"Khusra"},"rdfs:comment":{"@language":"en","@value":"A term used in Pakistan and Northern India to describe third-gender people, typically people assigned male at birth who identify as female."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000632"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/khusra"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000689","dc:identifier":"homoit0000689","skos:prefLabel":{"@language":"ur","@value":"Khawaja sara"},"rdfs:comment":{"@language":"en","@value":"Urdu term used in Southeast Asia to describe transgender people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000632"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/khawajaSara"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000690","dc:identifier":"homoit0000690","skos:prefLabel":{"@language":"hil","@value":"Kinnar"},"rdfs:comment":{"@language":"en","@value":"A variant term for hijra used in northern India."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000632"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/kinnar"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000693","dc:identifier":"homoit0000693","skos:prefLabel":{"@language":"tr","@value":"Köçek"},"rdfs:comment":{"@language":"en","@value":"Turkish term for male dancers who crossdress in feminine attire for entertainment purposes."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/köçek"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000694","dc:identifier":"homoit0000694","skos:prefLabel":{"@language":"hil","@value":"Kothis"},"rdfs:comment":{"@language":"en","@value":"In South Asia, this term is used to describe people who are assigned male at birth who exhibit feminine characteristics. Please note that not all kothis identify as hijra or transgender."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000632"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/kothi"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000695","dc:identifier":"homoit0000695","skos:prefLabel":{"@language":"km","@value":"Khteuy"},"skos:altLabel":{"@language":"km","@value":"Kteuy"},"rdfs:comment":{"@language":"en","@value":"Khmer term for third sex people. Can be considered outdated and offensive."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000322"},{"@id":"https://homosaurus.org/v3/homoit0001560"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001253"},{"@id":"https://homosaurus.org/v3/homoit0001338"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/kteuy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000697","dc:identifier":"homoit0000697","skos:prefLabel":{"@language":"ceb","@value":"Lakin-on"},"rdfs:comment":{"@language":"en","@value":"Cebuano term for women who are attracted to women and take on male personas and cultural work."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lakinOn"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000898","dc:identifier":"homoit0000898","skos:prefLabel":{"@language":"mi","@value":"Takatāpui"},"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ Māori people"},{"@language":"en","@value":"Māori (LGBTQ)"},{"@language":"en","@value":"Māori LGBTQ+ people"}],"rdfs:comment":{"@language":"en","@value":"Term used by the Māori people, or people who are part of the Indigenous Polynesian people of mainland Aotearoa (New Zealand), that was historically used to describe an \"intimate companion of the same sex.\" In the 1980s, the term was reclaimed for use by lesbian, gay, bisexual, transgender, queer, intersex people, and other members of Rainbow communities. Only use to refer to individuals who identify as Takatāpui."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000322"},{"@id":"https://homosaurus.org/v3/homoit0000886"},{"@id":"https://homosaurus.org/v3/homoit0001297"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001810"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/takatapui"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000966","dc:identifier":"homoit0000966","skos:prefLabel":{"@language":"zun","@value":"Lhamana"},"rdfs:comment":{"@language":"en","@value":"Native American Zuni people assigned male at birth who exhibit mixed gender traits."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001480"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lhamana"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000979","dc:identifier":"homoit0000979","skos:prefLabel":{"@language":"haw","@value":"Māhū"},"skos:altLabel":{"@language":"haw","@value":"Mahu"},"rdfs:comment":{"@language":"en","@value":"Term used in Hawaiian and Tahitian cultures for third gender people who blend genders and often hold spiritual roles."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000322"},{"@id":"https://homosaurus.org/v3/homoit0002653"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002654"},{"@id":"https://homosaurus.org/v3/homoit0002655"},{"@id":"https://homosaurus.org/v3/homoit0003231"},{"@id":"https://homosaurus.org/v3/homoit0003256"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001955"},{"@id":"https://homosaurus.org/v3/homoit0001959"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mahu"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000980","dc:identifier":"homoit0000980","skos:prefLabel":{"@language":"ms","@value":"Mak nyahs"},"rdfs:comment":{"@language":"en","@value":"Term used in Malaysia for transgender women."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/makNyah"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000987","dc:identifier":"homoit0000987","skos:prefLabel":{"@language":"zmw","@value":"Mangaiko"},"rdfs:comment":{"@language":"en","@value":"Mbo term for third gender people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mangaiko"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000996","dc:identifier":"homoit0000996","skos:prefLabel":{"@language":"sw","@value":"Mashoga"},"rdfs:comment":{"@language":"en","@value":"Swahili term for people assigned male at birth who engage in sex with men and who may dress as women."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mashoga"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001013","dc:identifier":"homoit0001013","skos:prefLabel":{"@language":"ne","@value":"Metis"},"rdfs:comment":{"@language":"en","@value":"Officially recognized third gender in Nepal; predominantly used to refer to transgender women."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/metis"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001029","dc:identifier":"homoit0001029","skos:prefLabel":{"@language":"ar","@value":"Mukhannathun"},"skos:altLabel":{"@language":"ar","@value":"Mukhannaths"},"rdfs:comment":{"@language":"en","@value":"A term used in classical Arabic to refer to men who are perceived as effeminate."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mukhannathun"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001034","dc:identifier":"homoit0001034","skos:prefLabel":{"@language":"zap","@value":"Muxe"},"rdfs:comment":{"@language":"en","@value":"In Zapotec cultures of Oaxaca (southern Mexico), this term refers to people assigned male at birth who dress and behave in feminine ways; sometimes considered a third gender."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/muxe"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001035","dc:identifier":"homoit0001035","skos:prefLabel":{"@language":"nv","@value":"Nádleehi"},"rdfs:comment":{"@language":"en","@value":"Term used in Native American Navajo tribes to describe people assigned male at birth who take on the role of girls in childhood and women in adulthood."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000353"},{"@id":"https://homosaurus.org/v3/homoit0001480"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nadleehi"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":