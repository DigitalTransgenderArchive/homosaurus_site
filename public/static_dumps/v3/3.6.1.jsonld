; only use to describe individuals who self-identify as Indigiqueer."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000886"},{"@id":"https://homosaurus.org/v3/homoit0001195"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000002"},{"@id":"https://homosaurus.org/v3/homoit0000676"},{"@id":"https://homosaurus.org/v3/homoit0000913"},{"@id":"https://homosaurus.org/v3/homoit0001037"},{"@id":"https://homosaurus.org/v3/homoit0001480"},{"@id":"https://homosaurus.org/v3/homoit0001810"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-01-19"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-25"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001810","dc:identifier":"homoit0001810","skos:prefLabel":{"@language":"en","@value":"Indigiqueer"},"rdfs:comment":{"@language":"en","@value":"Term used to describe the identity of people who are both Indigenous and queer and view those identities as inherently related and interconnected."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000002"},{"@id":"https://homosaurus.org/v3/homoit0000676"},{"@id":"https://homosaurus.org/v3/homoit0000898"},{"@id":"https://homosaurus.org/v3/homoit0000913"},{"@id":"https://homosaurus.org/v3/homoit0001037"},{"@id":"https://homosaurus.org/v3/homoit0001480"},{"@id":"https://homosaurus.org/v3/homoit0001809"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-01-19"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-25"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000915","dc:identifier":"homoit0000915","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ people"},"skos:altLabel":[{"@language":"en","@value":"Gay people"},{"@language":