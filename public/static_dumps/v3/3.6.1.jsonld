s"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001955","dc:identifier":"homoit0001955","skos:prefLabel":{"@language":"en","@value":"Kānaka Maoli LGBTQ+ people"},"skos:altLabel":[{"@language":"en","@value":"Indigenous Hawaiian LGBTQ+ people"},{"@language":"en","@value":"Indigenous Hawaiians (LGBTQ)"},{"@language":"en","@value":"Kānaka Maoli (LGBTQ)"},{"@language":"en","@value":"Kānaka Maoli people (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ Indigenous Hawaiians"},{"@language":"en","@value":"LGBTQ+ Kānaka Maoli"},{"@language":"en","@value":"LGBTQ+ Kānaka ʻŌiwi"},{"@language":"en","@value":"LGBTQ+ Native Hawaiians"},{"@language":"en","@value":"Native Hawaiian LGBTQ+ people"},{"@language":"en","@value":"Native Hawaiians (LGBTQ)"}],"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who are part of the Indigenous people of Mokupuni o Hawai‘i, or the Hawaiian Islands; only use to refer to people who identify as Kanaka Maoli."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000886"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001956"},{"@id":"https://homosaurus.org/v3/homoit0001957"},{"@id":"https://homosaurus.org/v3/homoit0001958"},{"@id":"https://homosaurus.org/v3/homoit0001959"},{"@id":"https://homosaurus.org/v3/homoit0001960"},{"@id":"https://homosaurus.org/v3/homoit0001961"},{"@id":"https://homosaurus.org/v3/homoit0002924"},{"@id":"https://homosaurus.org/v3/homoit0003413"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000979"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001968","dc:identifier":"