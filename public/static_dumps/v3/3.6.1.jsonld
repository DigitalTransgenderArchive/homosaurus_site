8"},{"@id":"https://homosaurus.org/v3/homoit0001219"},{"@id":"https://homosaurus.org/v3/homoit0001320"},{"@id":"https://homosaurus.org/v3/homoit0001902"},{"@id":"https://homosaurus.org/v3/homoit0002039"},{"@id":"https://homosaurus.org/v3/homoit0002272"},{"@id":"https://homosaurus.org/v3/homoit0003515"},{"@id":"https://homosaurus.org/v3/homoit0003520"},{"@id":"https://homosaurus.org/v3/homoit0003616"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/theories"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000108","dc:identifier":"homoit0000108","skos:prefLabel":{"@language":"en","@value":"Bi+ people"},"rdfs:comment":{"@language":"en","@value":"Individuals who are not exclusively sexually and/or romantically attracted to individuals of a single biological sex (includes bisexual, queer, pansexual, and fluid identities)."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000915"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000170"},{"@id":"https://homosaurus.org/v3/homoit0001073"},{"@id":"https://homosaurus.org/v3/homoit0001195"},{"@id":"https://homosaurus.org/v3/homoit0001919"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001297"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bi+People"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000170","dc:identifier":"homoit0000170","skos:prefLabel":{"@language":"en","@value":"Bisexual people"},"skos:altLabel":{"@language":"en","@value":"Bisexuals"},"rdfs:comment":{"@language":"en","@value":"Individuals who are romantically and/or sexually attracted to more than one gender and who identify as bisexual; do not use to describe pansexual or polysexual people unless they also use the term bisexual."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000108"},{"@id":"https://homosaurus.org/v3/homoit0000915"},{"@id":"https://homosaurus.org/v3/homoit0001297"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000140"},{"@id":"https://homosaurus.org/v3/homoit0000160"},{"@id":"https://homosaurus.org/v3/homoit0000169"},{"@id":"https://homosaurus.org/v3/homoit0000192"},{"@id":"https://homosaurus.org/v3/homoit0000202"},{"@id":"https://homosaurus.org/v3/homoit0000285"},{"@id":"https://homosaurus.org/v3/homoit0001054"},{"@id":"https://homosaurus.org/v3/homoit0003035"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000117"},{"@id":"https://homosaurus.org/v3/homoit0000133"},{"@id":"https://homosaurus.org/v3/homoit0000134"},{"@id":"https://homosaurus.org/v3/homoit0000136"},{"@id":"https://homosaurus.org/v3/homoit0000139"},{"@id":"https://homosaurus.org/v3/homoit0000143"},{"@id":"https://homosaurus.org/v3/homoit0000144"},{"@id":"https://homosaurus.org/v3/homoit0000150"},{"@id":"https://homosaurus.org/v3/homoit0000153"},{"@id":"https://homosaurus.org/v3/homoit0000173"},{"@id":"https://homosaurus.org/v3/homoit0000204"},{"@id":"https://homosaurus.org/v3/homoit0001073"},{"@id":"https://homosaurus.org/v3/homoit0001103"},{"@id":"https://homosaurus.org/v3/homoit0001531"},{"@id":"https://homosaurus.org/v3/homoit0002150"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93003390"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit00010