r contracting HIV/AIDS. AIDS phobia may include isolation, stereotypes, verbal harassment, and physical violence."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000005"},{"@id":"https://homosaurus.org/v3/homoit0000920"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88004490"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000032"},"dc:replaces":{"@id":"http://homosaurus.org/v2/AIDSPhobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000034","dc:identifier":"homoit0000034","skos:prefLabel":{"@language":"en","@value":"Red ribbons (AIDS)"},"skos:altLabel":[{"@language":"en","@value":"AIDS ribbons"},{"@language":"en","@value":"Red ribbons"}],"rdfs:comment":{"@language":"en","@value":"Red ribbon that acts as an international symbol for HIV and AIDS awareness; first adopted in the early 1990s for the Red Ribbon Project."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000954"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000005"},{"@id":"https://homosaurus.org/v3/homoit0000025"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000954"},"dc:replaces":{"@id":"http://homosaurus.org/v2/redRibbons"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000226","dc:identifier":"homoit0000226","skos:prefLabel":{"@language":"en","@value":"Buddy care for LGBTQ+ people"},"skos:altLabel":[{"@language":"en","@value":"Buddies"},{"@language":"en","@value":"Buddy care for LGBTQ people"}],"rdfs:comment":{"@language":"en","@value":"A peer-to-peer form of healthcare support for LGBTQ+ people in which volunteers (buddies) attend clinical visits with patie