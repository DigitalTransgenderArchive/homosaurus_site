/homosaurus.org/v3/homoit0001299"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000974"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gloryHoles"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001358","dc:identifier":"homoit0001358","skos:prefLabel":{"@language":"en","@value":"Tearooms (Gay culture)"},"skos:altLabel":{"@language":"en","@value":"Tearooms"},"rdfs:comment":{"@language":"en","@value":"U.S. slang term for public bathrooms that are used as locations for sexual encounters."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000974"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000595"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000308"},{"@id":"https://homosaurus.org/v3/homoit0001140"},{"@id":"https://homosaurus.org/v3/homoit0001357"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008001734"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000974"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tearooms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001142","dc:identifier":"homoit0001142","skos:prefLabel":{"@language":"en","@value":"Public sex"},"rdfs:comment":{"@language":"en","@value":"Sex in public places such as beaches, parks, cottages, etc."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001299"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000309"},{"@id":"https://homosaurus.org/v3/homoit0000319"},{"@id":"https://homosaurus.org/v3/homoit0000412"},{"@id":"https://homosaurus.org/v3/homoit0000475"},{"@id":"https://homosaurus.org/v3/homoit0000900"},{"@id":"https://homosaurus.org/v3/homo