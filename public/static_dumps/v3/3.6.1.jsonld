t","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001912","dc:identifier":"homoit0001912","skos:prefLabel":{"@language":"en","@value":"Queer witches"},"skos:altLabel":{"@language":"en","@value":"Queer Wiccans"},"rdfs:comment":{"@language":"en","@value":"Queer practitioners of Wicca or other Pagan religions who self-identify as witches."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001907"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000596"},{"@id":"https://homosaurus.org/v3/homoit0001193"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001913","dc:identifier":"homoit0001913","skos:prefLabel":{"@language":"en","@value":"Intersex witches"},"skos:altLabel":{"@language":"en","@value":"Intersex Wiccans"},"rdfs:comment":{"@language":"en","@value":"Intersex practitioners of Wicca or other Pagan religions who self-identify as witches."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001907"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000596"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000599","dc:identifier":"homoit0000599","skos:prefLabel":{"@language":"en","@value":"Gonadal dysgenesis"},"rdfs:comment":{"@language":"en","@value":"A term that refers to a group of different variations that affect the development of the gonads before birth."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002867"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85138930"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gonadalDysgenesis"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002867","dc:identifier":"homoit0002867","skos:prefLabel":{"@language":"en","@value":"Mixed gonadal dysgenesis"},"skos:altLabel":{"@language":"en","@value":"Partial gonadal dysgenesis"},"rdfs:comment":{"@language":"en","@value":"People with mixed gonadal dysgenesis are born with a mosaic (usually 45X/46XY) chromosome pattern and may develop some gonadal streak tissue and testicular tissue. They may be born with a vulva or penis, or with visible genital variations. They usually have a partially or completely developed uterus, and they may have combinations of internal reproductive structures such as a fallopian tube and a vas deferens on opposite sides of the body. In adolescence, people with mixed gonadal dysgenesis may develop some secondary sex characteristics associated with a typical testosterone puberty, depending on the amount of hormone-producing testicular tissue they have."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000599"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-09-14"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000600","dc:identifier":"homoit0000600","skos:prefLabel":{"@language":"en","@value":"Gonads"},"rdfs:comment":{"@language":"en","@value":"A general term used to describe testes, ovaries, or ovotestes."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001269"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001361"},{"@id":"https://homosaurus.org/v3/homoit0002877"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001268"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85055840"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gonads"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002877","dc:identifier":"homoit0002877","skos:prefLabel":{"@language":"en","@value":"Streak gonads"},"rdfs:comment":{"@language":"en","@value":"Minimally developed gonadal tissue that is present in place of either testes or ovaries. Streak gonads are more common in certain intersex variations such as Swyer syndrome."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000600"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-09-14"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002356","dc:identifier":"homoit0002356","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ grandchildren"},"skos:altLabel":{"@language":"en","@value":"Grandchildren (LGBTQ)"},"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who are grandchildren."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000601"},{"@id":"https://homosaurus.org/v3/homoit0000915"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002357","dc:identifier":"homoit0002357","skos:prefLabel":{"@language":"en","@value":"Grandchildren of LGBTQ+ people"},"rdfs:comment":{"@language":"en","@value":"People who have one or more LGBTQ+ grandparent. For grandchildren who are themselves LGBTQ+, use the term \"LGBTQ+ grandchildren.\""},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000601"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002358","dc:identifier":"homoit0002358","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ grandparents"},"skos:altLabel":{"@language":"en","@value":"Grandparents (LGBTQ)"},"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who are grandparents."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000602"},{"@id":"https://homosaurus.org/v3/homoit0000915"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002586"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002359","dc:identifier":"homoit0002359","skos:prefLabel":{"@language":"en","@value":"Grandparents of LGBTQ+ people"},"rdfs:comment":{"@language":"en","@value":"People who have one or more LGBTQ+ grandchild. For grandparents who are themselves LGBTQ+, use the term \"LGBTQ+ grandparents.\""},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000602"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000605","dc:identifier":"homoit0000605","skos:prefLabel":{"@language":"en","@value":"Hair"},"rdfs:comment":{"@language":"en","@value":"Threadlike strands of keratin growing out of the skin on the body. Use in reference to hair as a secondary sex characteristic or as a form of self expression."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001259"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002287"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85058305"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hair"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002287","dc:identifier":"homoit0002287","skos:prefLabel":[{"@language":"en-us","@value":"Mustaches"},{"@language":"en-gb","@value":"Moustaches"}],"rdfs:comment":{"@language":"en","@value":"Facial hair on the upper lip. Includes false or drag mustaches as well as naturally grown hair."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000605"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002288"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85089102"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-10"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003049","dc:identifier":"homoit0003049","skos:prefLabel":{"@language":"en","@value":"Wax play"},"rdfs:comment":{"@language":"en","@value":"Application of liquid wax to the body for erotic or sensual play."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0003054"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000606"},{"@id":"https://homosaurus.org/v3/homoit0003055"},{"@id":"https://homosaurus.org/v3/homoit0003056"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000404"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-15"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000607","dc:identifier":"homoit0000607","skos:prefLabel":{"@language":"en","@value":"Halloween (LGBTQ+ culture)"},"skos:altLabel":[{"@language":"en","@value":"Gay Christmas"},{"@language":"en","@value":"Gay Halloween"}],"rdfs:comment":{"@language":"en","@value":"The celebration of Halloween, often called Gay Christmas, by LGBTQ+ people. Typically involves dressing in drag or elaborate costumes as a form of gender play and attending large parties in LGBTQ+ neighborhoods or establishments."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000861"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001808"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85058475"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000861"},"dc:replaces":{"@id":"http://homosaurus.org/v2/halloween"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-11-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000608","dc:identifier":"homoit0000608","skos:prefLabel":{"@language":"en","@value":"Handcuffs"},"skos:altLabel":{"@language":"en","@value":"Handcuff restraints"},"rdfs:comment":{"@language":"en","@value":"A restraint device designed to secure an individual’s wrists."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0003117"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85058662"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/handcuffs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002192","dc:identifier":"homoit0002192","skos:prefLabel":{"@language":"en","@value":"Queer coding"},"skos:altLabel":{"@language":"en","@value":"Queercoding"},"rdfs:comment":{"@language":"en","@value":"Purposeful subtextual coding of a character or relationship in a piece of media as queer. Queer coding is distinct from the practice of queerbaiting in that the queer codes are intentionally present rather than falsely implied and are not typically used as a marketing tactic."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000609"},{"@id":"https://homosaurus.org/v3/homoit0000972"},{"@id":"https://homosaurus.org/v3/homoit0001233"},{"@id":"https://homosaurus.org/v3/homoit0001900"},{"@id":"https://homosaurus.org/v3/homoit0002191"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002192"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001121","dc:identifier":"homoit0001121","skos:prefLabel":{"@language":"en","@value":"Police harassment"},"skos:altLabel":[{"@language":"en","@value":"Harrassment by police"},{"@language":"en","@value":"Misconduct by police"},{"@language":"en","@value":"Mistreatment by police"},{"@language":"en","@value":"Police misconduct"},{"@language":"en","@value":"Police mistreatment"}],"rdfs:comment":{"@language":"en","@value":"Any of various forms of inappropriate conduct, illegal actions, or abuses of power undertaken by law enforcement agents or agents of the state against members of the public. This includes but is not limited to racial, ethnic, and other forms of profiling; unwarranted surveillance, searches, and seizure; selective enforcement; excessive use of force; sexual misconduct; intimidation and witness tampering; falsification of evidence; coerced confessions; false arrests and imprisonment; and bribing or lobbying."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000611"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001120"},{"@id":"https://homosaurus.org/v3/homoit0001122"},{"@id":"https://homosaurus.org/v3/homoit0002375"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh95010616"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000611"},"dc:replaces":{"@id":"http://homosaurus.org/v2/policeHarassment"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000792","dc:identifier":"homoit0000792","skos:prefLabel":{"@language":"en","@value":"Lesbian victims of hate crimes"},"rdfs:comment":{"@language":"en","@value":"Lesbians who have experienced hate crimes and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000613"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000782"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianVictimsOfHateCrimes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001221","dc:identifier":"homoit0001221","skos:prefLabel":{"@language":"en","@value":"Queer victims of hate crimes"},"rdfs:comment":{"@language":"en","@value":"Queer people who have experienced hate crimes and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000613"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001211"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerVictimsOfHateCrimes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001456","dc:identifier":"homoit0001456","skos:prefLabel":{"@language":"en","@value":"Transgender victims of hate crimes"},"rdfs:comment":{"@language":"en","@value":"Transgender people who have experienced hate crimes and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000613"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001448"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderVictimsOfHateCrimes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002895","dc:identifier":"homoit0002895","skos:prefLabel":{"@language":"en","@value":"Asexual victims of hate crimes"},"rdfs:comment":{"@language":"en","@value":"Asexual people who have experienced hate crimes and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000613"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-29"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","