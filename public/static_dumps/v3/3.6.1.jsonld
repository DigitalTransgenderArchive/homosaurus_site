000376"},{"@id":"https://homosaurus.org/v3/homoit0000816"},{"@id":"https://homosaurus.org/v3/homoit0001031"},{"@id":"https://homosaurus.org/v3/homoit0001755"},{"@id":"https://homosaurus.org/v3/homoit0001813"},{"@id":"https://homosaurus.org/v3/homoit0002731"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001363"},"dc:replaces":{"@id":"http://homosaurus.org/v2/theatreLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000195","dc:identifier":"homoit0000195","skos:prefLabel":{"@language":"en","@value":"Bisexual theology"},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001364"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001364"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001218"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualTheology"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-22"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001364","dc:identifier":"homoit0001364","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ theology"},"skos:altLabel":{"@language":"en","@value":"Theology (LGBTQ)"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001218"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000928"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001364"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001218"},"dc:replaces":{"@id":"http://homosaurus.org/v2/theologyLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-11-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001218","dc:identifier":"homoit0001218","skos:prefLabel":{"@language":"en","@value":"Queer theology"},"skos:altLabel":[{"@language":"en","@value":"Gay theology"},{"@language":"en","@value":"LGBTQ+ theology"},{"@language":"en","@value":"Lesbian theology"}],"rdfs:comment":{"@language":"en","@value":"A theological method that developed out of queer theory. Queer theology, which encompasses the previously commonly used terms gay theology and lesbian theology, can variously be understood as (1) theology done by, with, and for LGBTQ+ people according to their needs; (2) theology that purposefully opposes social and cultural norms surrounding gender and sexuality; and (3) theology that broadly challenges and deconstructs harmful historical boundaries."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000928"},{"@id":"https://homosaurus.org/v3/homoit0000948"},{"@id":"https://homosaurus.org/v3/homoit0001219"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2010014738"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001218"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerTheology"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000961","dc:identifier":"homoit0000961","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ victims of war"},"skos:altLabel":[{"@language":"en","@value":"LGBTQ war victims"},{"@language":"en","@value":"Victims of war (LGBTQ)"}],"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who have experienced war and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000915"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000199"},{"@id":"https://homosaurus.org/v3/homoit0000553"},{"@id":"https://homosaurus.org/v3/homoit0000795"},{"@id":"https: