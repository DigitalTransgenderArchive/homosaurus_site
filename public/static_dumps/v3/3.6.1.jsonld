00878"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000506"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/seaQueens"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000507","dc:identifier":"homoit0000507","skos:prefLabel":{"@language":"en","@value":"Gay men in the military"},"rdfs:comment":{"@language":"en","@value":"Gay men serving in state and national armed forces."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001100"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006000714"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayMenInTheMilitary"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000508","dc:identifier":"homoit0000508","skos:prefLabel":[{"@language":"en-us","@value":"Gay men of color"},{"@language":"en-gb","@value":"Gay men of colour"}],"rdfs:comment":{"@language":"en","@value":"Primarily used in the United States, this term refers to gay men who are not white and who identify as people of color."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001101"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayMenOfColour"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000549","dc:identifier":"homoit0000549","skos:prefLabel":{"@language":"en","@value":"Gay tra