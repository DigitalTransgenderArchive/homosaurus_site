dentifier":"homoit0000624","skos:prefLabel":{"@language":"en","@value":"Heterosexual identity"},"rdfs:comment":{"@language":"en","@value":"Term used to describe the sexual identity of individuals who are romantically and/or sexually attracted to people assigned the “opposite” sex at birth."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001295"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000627"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexualIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-02-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000625","dc:identifier":"homoit0000625","skos:prefLabel":{"@language":"en","@value":"Heterosexual marriage"},"rdfs:comment":{"@language":"en","@value":"The legally and formally recognized union of a heterosexual man and woman as partners in a personal relationship."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000990"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexualMarriage"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001915","dc:identifier":"homoit0001915","skos:prefLabel":{"@language":"en","@value":"Monosexual people"},"skos:altLabel":{"@language":"en","@value":"Monosexuals"},"rdfs:comment":{"@language":"en","@value":"Individuals who are attracted to only one gender; includes gay people and straight people."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000627"},{"@id":"https://homosaurus.org/v3/homoit0000648"},{"@id":"https://homosaurus.org/v3/homoit0001295"},{"@id":"https://homosaurus.org/v3/homoi