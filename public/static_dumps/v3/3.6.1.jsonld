ma"},"rdfs:comment":{"@language":"en","@value":"A type of cancer that causes lesions to grow in the skin, lymph nodes, internal organs, and mucous membranes; often affects people with immune deficiencies, such as AIDS."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000005"},{"@id":"https://homosaurus.org/v3/homoit0000033"},{"@id":"https://homosaurus.org/v3/homoit0001980"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85071562"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000686"},"dc:replaces":{"@id":"http://homosaurus.org/v2/kaposisSarcoma"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001091","dc:identifier":"homoit0001091","skos:prefLabel":{"@language":"en","@value":"Passive immune therapy"},"rdfs:comment":{"@language":"en","@value":"A medical treatment in which a person receives laboratory-made antibodies to help fight an infection or disease."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001007"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000005"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/passiveImmuneTherapy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001130","dc:identifier":"homoit0001130","skos:prefLabel":{"@language":"en","@value":"PrEP"},"skos:altLabel":{"@language":"en","@value":"Pre-exposure prophylaxis"},"rdfs:comment":{"@language":"en","@value":"Medication taken to prevent the contraction of HIV."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001007"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000005"},"skos:exactM