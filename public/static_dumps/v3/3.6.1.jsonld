"}},{"@id":"https://homosaurus.org/v3/homoit0002825","dc:identifier":"homoit0002825","skos:prefLabel":{"@language":"en","@value":"Chimeras"},"skos:altLabel":{"@language":"en","@value":"Human chimeras"},"rdfs:comment":{"@language":"en","@value":"Chimeras, or people with chimerism, have two different sets of DNA. This happens when a person is pregnant with fraternal twins, but the embryos combine into one fetus."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000618"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-09-14"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003039","dc:identifier":"homoit0003039","skos:prefLabel":{"@language":"en","@value":"Intersex college students"},"rdfs:comment":{"@language":"en","@value":"Intersex people who are attending college."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000618"},{"@id":"https://homosaurus.org/v3/homoit0003041"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0003032"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-05"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003225","dc:identifier":"homoit0003225","skos:prefLabel":{"@language":"en","@value":"Pregnant intersex people"},"rdfs:comment":{"@language":"en","@value":"Pregnant people who are intersex."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000618"},{"@id":"https://homosaurus.org/v3/homoit0003364"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-05-24"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id"