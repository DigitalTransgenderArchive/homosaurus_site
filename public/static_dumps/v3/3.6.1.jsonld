us.org/v3/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000227","dc:identifier":"homoit0000227","skos:prefLabel":{"@language":"en","@value":"Sodomites"},"skos:altLabel":{"@language":"en","@value":"Buggers"},"rdfs:comment":{"@language":"en","@value":"Pejorative historical term for individuals who engage in sexual activities that are characterized as unnatural or immoral; commonly applied to gay men engaging in anal sex. Only use in historical contexts."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000878"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001297"},{"@id":"https://homosaurus.org/v3/homoit0001325"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sodomites"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001325","dc:identifier":"homoit0001325","skos:prefLabel":{"@language":"en","@value":"Sodomy"},"rdfs:comment":{"@language":"en","@value":"Historical term for \"unnatural\" sexual acts unrelated to procreation, including oral sex and anal sex."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000878"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000227"},{"@id":"https://homosaurus.org/v3/homoit0001095"},{"@id":"https://homosaurus.org/v3/homoit0001267"},{"@id":"https://homosaurus.org/v3/homoit0001299"},{"@id":"https://homosaurus.org/v3/homoit0001326"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85124275"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sodomy"},"dc:issued":{"@type":