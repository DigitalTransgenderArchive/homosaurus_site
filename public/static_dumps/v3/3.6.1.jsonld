Spirit characters or themes."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002710"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0003488"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002710"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002809","dc:identifier":"homoit0002809","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ politicians"},"skos:altLabel":{"@language":"en","@value":"LGBTQ+ public officials"},"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who are candidates for public office, are currently holding public office, or have held political positions. Politicians can be elected by public election or otherwise appointed."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002810"},{"@id":"https://homosaurus.org/v3/homoit0002811"},{"@id":"https://homosaurus.org/v3/homoit0002812"},{"@id":"https://homosaurus.org/v3/homoit0002813"},{"@id":"https://homosaurus.org/v3/homoit0002814"},{"@id":"https://homosaurus.org/v3/homoit0002815"},{"@id":"https://homosaurus.org/v3/homoit0002816"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002817"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2015000368"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002809"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002810","dc:identifier":"homoit0002810","skos:prefLabel":{"@language":"en","@value":"Gay politicians"},"skos:altLabel":{"@language":"en","@value":"Gay public officials"},"rdfs:comment":{"@language":"en","@value":"Gay men or mascs who are candidates for public office, are currently holding public office, or have held political positions. Politicians can be elected by public election or otherwise appointed."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002809"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh91002560"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002809"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002811","dc:identifier":"homoit0002811","skos:prefLabel":{"@language":"en","@value":"Lesbian politicians"},"skos:altLabel":{"@language":"en","@value":"Lesbian public officials"},"rdfs:comment":{"@language":"en","@value":"Lesbians who are candidates for public office, are currently holding public office, or have held political positions. Politicians can be elected by public election or otherwise appointed."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002809"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002809"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002812","dc:identifier":"homoit0002812","skos:prefLabel":{"@language":"en","@value":"Bisexual politicians"},"skos:altLabel":{"@language":"en","@value":"Bisexual public officials"},"rdfs:comment":{"@language":"en","@value":"Bisexual people who are candidates for public office, are currently holding public office, or have held political positions. Politicians can be elected by public election or otherwise appointed."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002809"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002809"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002813","dc:identifier":"homoit0002813","skos:prefLabel":{"@language":"en","@value":"Queer politicians"},"skos:altLabel":{"@language":"en","@value":"Queer public officials"},"rdfs:comment":{"@language":"en","@value":"Queer people who are candidates for public office, are currently holding public office, or have held political positions. Politicians can be elected by public election or otherwise appointed."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002809"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002809"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002814","dc:identifier":"homoit0002814","skos:prefLabel":{"@language":"en","@value":"Transgender politicians"},"skos:altLabel":{"@language":"en","@value":"Transgender public officials"},"rdfs:comment":{"@language":"en","@value":"Transgender people who are candidates for public office, are currently holding public office, or have held political positions. Politicians can be elected by public election or otherwise appointed."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002809"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002809"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002815","dc:identifier":"homoit0002815","skos:prefLabel":{"@language":"en","@value":"Intersex politicians"},"skos:altLabel":{"@language":"en","@value":"Intersex public officials"},"rdfs:comment":{"@language":"en","@value":"Intersex people who are candidates for public office, are currently holding public office, or have held political positions. Politicians can be elected by public election or otherwise appointed."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002809"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002809"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002816","dc:identifier":"homoit0002816","skos:prefLabel":{"@language":"en","@value":"Asexual politicians"},"skos:altLabel":{"@language":"en","@value":"Asexual public officials"},"rdfs:comment":{"@language":"en","@value":"Asexual people who are candidates for public office, are currently holding public office, or have held political positions. Politicians can be elected by public election or otherwise appointed."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002809"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002809"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002874","dc:identifier":"homoit0002874","skos:prefLabel":{"@language":"en","@value":"Salt-wasting congenital adrenal hyperplasia"},"rdfs:comment":{"@language":"en","@value":"People who have salt-wasting congenital adrenal hyperplasia (CAH), a subtype of classical CAH, experience \"salt-wasting,\" a dangerous scenario a person's low levels of aldosterone cause their body to lose too much sodium. They may experience life-threatening adrenal crises, especially when their body is under stress."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002827"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-09-14"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002846","dc:identifier":"homoit0002846","skos:prefLabel":{"@language":"en","@value":"Intersexual"},"skos:altLabel":{"@language":"en","@value":"Intersex "},"rdfs:comment":{"@language":"en","@value":"This term is not common in the English language as to not confuse intersex with a gender identity or sex orientation by adding \"ual\" but it is used in other languages such as Spanish to mean \"intersex.\" "},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002846"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000352"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002879","dc:identifier":"homoit0002879","skos:prefLabel":{"@language":"en","@value":"Type 1 Leydig cell hypoplasia"},"skos:altLabel":{"@language":"en","@value":"Type 1 LCH"},"rdfs:comment":{"@language":"en","@value":"People with Type 1 Leydig cell hypoplasia (LCH) produce almost no testosterone and will usually be born with a vulva and vagina and undescended testes. They are usually assigned female at birth, often without their variation being recognized until adolescence, at which point they generally will not develop any secondary sex characteristics or experience other changes typically associated with puberty."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002863"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-09-14"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002881","dc:identifier":"homoit0002881","skos:prefLabel":{"@language":"en","@value":"Type 2 Leydig cell hypoplasia"},"skos:altLabel":{"@language":"en","@value":"Type 2 LCH"},"rdfs:comment":{"@language":"en","@value":"People with Type 2 Leydig cell hypoplasia (LCH) have some response to luteinizing hormone and produce lower-than-typical amounts of testosterone, but more than people with Type 1 LCH. At birth, their testes may be descended or undescended, and they may have a smaller-than-typical penis, often with other noticeable differences such as hypospadias. In adolescence, they will often develop some characteristics associated with a typical testosterone puberty."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002863"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-09-14"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002880","dc:identifier":"homoit0002880","skos:prefLabel":{"@language":"en","@value":"Type 1 Mayer-Rokitansky-Küster-Hauser syndrome"},"skos:altLabel":{"@language":"en","@value":"Type 1 MRKH"},"rdfs:comment":{"@language":"en","@value":"People with Type 1 Mayer-Rokitansky-Küster-Hauser (MRKH) syndrome typically have only the differences associated with MRKH syndrome."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002865"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-10-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002882","dc:identifier":"homoit0002882","skos:prefLabel":{"@language":"en","@value":"Type 2 Mayer-Rokitansky-Küster-Hauser syndrome"},"skos:altLabel":{"@language":"en","@value":"Type 2 MRKH"},"rdfs:comment":{"@language":"en","@value":"People with Type 2 Mayer-Rokitansky-Küster-Hauser (MRKH) syndrome have both the differences associated with MRKH syndrome and additional differences in other parts of their body, such as their fallopian tubes, kidneys, spine, or heart. A specific example of Type 2 MRKH known as Müllerian agenesis, Renal agenesis, Cervicothoracic Somite (MURCS) association, occurs when someone’s kidneys do not develop typically. They may have scoliosis or fused vertebrae in addition to the usual features of MRKH. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002865"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-10-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002868","dc:identifier":"homoit0002868","skos:prefLabel":{"@language":"en","@value":"Müllerian duct variations"},"skos:altLabel":[{"@language":"en","@value":"MRKH "},{"@language":"en","@value":"Müllerian agenesis"},{"@language":"en","@value":"Müllerian duct anomalies"}],"rdfs:comment":{"@language":"en","@value":"People with XX chromosomes can have a broad range of variations in how their Müllerian ducts (which typically form the uterus, fallopian tubes, cervix, and upper portion of the vagina) develop. They might have a variation that causes their uterus to develop with a different shape than typical, or to be doubled. Others may have vaginal variations such as a “hemivagina” (where one side of the vagina is obstructed, which can sometimes block menstrual blood from exiting), or a band of tissue dividing the vaginal canal (known as a vaginal septum). Müllerian duct variations usually don’t cause someone to have any variations in their ovaries or hormone production."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0002865"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002887","dc:identifier":"homoit0002887","skos:prefLabel":{"@language":"en","@value":"Gay operas"},"rdfs:comment":{"@language":"en","@value":"Operas created by gay directors, depicting gay men, or that are regarded as important within gay culture."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002886"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002888","dc:identifier":"homoit0002888","skos:prefLabel":{"@language":"en","@value":"Bisexual operas"},"rdfs:comment":{"@language":"en","@value":"Operas created by bisexual directors, depicting bisexual individuals, or that are regarded as important within bisexual culture."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002886"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002889","dc:identifier":"homoit0002889","skos:prefLabel":{"@language":"en","@value":"Transgender operas"},"rdfs:comment":{"@language":"en","@value":"Operas created by transgender directors, depicting transgender individuals, or that are regarded as important within transgender culture."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002886"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0003168"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@