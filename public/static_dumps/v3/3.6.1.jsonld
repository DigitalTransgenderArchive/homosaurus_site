/authorities/subjects/sh85078720"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lubricants"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002654","dc:identifier":"homoit0002654","skos:prefLabel":{"@language":"haw","@value":"Māhūkāne"},"skos:altLabel":{"@language":"haw","@value":"Mahukane"},"rdfs:comment":{"@language":"en","@value":"A term coined by the Kānaka Maoli (Native Hawaiian) queer community in the early 2000s that blends the term Māhū (for third gender indigenous people of Hawai'i and Tahiti who blend genders and often hold spiritual roles) and kāne (man)."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000979"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2023-10-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002655","dc:identifier":"homoit0002655","skos:prefLabel":{"@language":"haw","@value":"Māhūwahine"},"skos:altLabel":{"@language":"haw","@value":"Mahuwahine"},"rdfs:comment":{"@language":"en","@value":"A term coined by the Kānaka Maoli (Native Hawaiian) queer community in the early 2000s that blends the term Māhū (for third gender indigenous people of Hawai'i and Tahiti who blend genders and often hold spiritual roles) and wahine (woman)."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000979"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2023-10-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homo