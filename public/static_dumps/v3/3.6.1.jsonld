https://homosaurus.org/v3/homoit0001509"},{"@id":"https://homosaurus.org/v3/homoit0000886"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nonEuroAmericanGenderAndSexualIdentities"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000560","dc:identifier":"homoit0000560","skos:prefLabel":{"@language":"en","@value":"Gender"},"rdfs:comment":{"@language":"en","@value":"A socially constructed system that gives meaning to masculinity and femininity and that unevenly distributes power and opportunity according to cultural interpretations of sex. As an element of personal identity, a gender is developed through the interaction of social roles and expectations, one’s response to those expectations, one’s physiology, and one’s internal sense of self. Gender is culturally specific, meaning that different cultures have different understandings of what gender means and how many genders should be recognized."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000078"},{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0000571"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000288"},{"@id":"https://homosaurus.org/v3/homoit0000561"},{"@id":"https://homosaurus.org/v3/homoit0000563"},{"@id":"https://homosaurus.org/v3/homoit0000565"},{"@id":"https://homosaurus.org/v3/homoit0000566"},{"@id":"https://homosaurus.org/v3/homoit0000575"},{"@id":"https://homosaurus.org/v3/homoit0000578"},{"@id":"https://homosaurus.org/v3/homoit0000579"},{"@id":"https://homosaurus.org/v3/homoit0000580"},{"@id":"https://homosaurus.org/v3/homoit0001090"},{"@id":"https://homosaurus.org/v3/homoit0001269"},{"@id":"https://homosaurus.org/v3/homoit0001463"},{"@id":"https://homosaurus.org/v3/homoit0001816"},{"@i