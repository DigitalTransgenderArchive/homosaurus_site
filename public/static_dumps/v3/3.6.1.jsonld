n","@value":"Use in reference to laws and regulations concerning the name assigned to an individual at birth."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000918"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000119"},{"@id":"https://homosaurus.org/v3/homoit0000247"},{"@id":"https://homosaurus.org/v3/homoit0000377"},{"@id":"https://homosaurus.org/v3/homoit0001053"},{"@id":"https://homosaurus.org/v3/homoit0001092"},{"@id":"https://homosaurus.org/v3/homoit0003503"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/legalName"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001005","dc:identifier":"homoit0001005","skos:prefLabel":{"@language":"en","@value":"Medical practitioners' statements"},"rdfs:comment":{"@language":"en","@value":"Official documents from medical practitioners (e.g., doctors, nurses, therapists) diagnosing a patient's gender dysphoria and, typically, recommending gender-affirming healthcare; sometimes required for an individual's gender-affirming healthcare to be covered under insurance or for an individual to legally change their name or gender marker."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001053"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000119"},{"@id":"https://homosaurus.org/v3/homoit0000377"},{"@id":"https://homosaurus.org/v3/homoit0000573"},{"@id":"https://homosaurus.org/v3/homoit0001004"},{"@id":"https://homosaurus.org/v3/homoit0001465"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/medicalPractitionersStatements"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001324","dc:identifier":"homoit0001324","skos:prefLabel":{"@language":"en","@value":"Social security cards"},"rdfs:comment":{"@language":"en","@value":"Official documents issued by governments that ascribe unique numeral identifiers to citizens to track their income and determine retirement benefits. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001053"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000119"},{"@id":"https://homosaurus.org/v3/homoit0000247"},{"@id":"https://homosaurus.org/v3/homoit0000377"},{"@id":"https://homosaurus.org/v3/homoit0000573"},{"@id":"https://homosaurus.org/v3/homoit0001465"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/socialSecurityCards"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000271","dc:identifier":"homoit0000271","skos:prefLabel":{"@language":"en","@value":"Cisgender people"},"skos:altLabel":{"@language":"en","@value":"Cis people"},"rdfs:comment":{"@language":"en","@value":"Individuals whose gender identity matches the gender or sex they were assigned at birth."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000270"},{"@id":"https://homosaurus.org/v3/homoit0000272"},{"@id":"https://homosaurus.org/v3/homoit0002281"},{"@id":"https://homosaurus.org/v3/homoit0002282"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000120"},{"@id":"https://homosaurus.org/v3/homoit0000273"},{"@id":"https://homosaurus.org/v3/homoit0000322"},{"@id":"https://homosaurus.org/v3/homoit0000571"},{"@id":"https://homosaurus.org/v3/homoit0001008"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001509"},{"@id":"https://homosaurus.org/v3/homoit0001652"},{"@id":"https://homosaurus.org/v3/homoit0001653"},{"@id":"https://homosaurus.org/v3/homoit0001925"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2016000684"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000271"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cisgenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000567","dc:identifier":"homoit0000567","skos:prefLabel":{"@language":"en","@value":"Gender dysphoria"},"rdfs:comment":{"@language":"en","@value":"A psychological diagnosis (replacing the outdated and offensive \"gender identity disorder\") used to describe the sense of unease or dissatisfaction an individual feels as a result of incongruence between their gender identity and their assigned gender, gender expression, and/or the way their gender is perceived by others. This term is also used colloquially by individuals to describe the discomfort and distress they experience as a result of this incongruence. Though gender dysphoria is often associated with trans people, people of any identity may experience gender dysphoria when they do not feel \"right\" in their body or the way their gender is being expressed."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002699"},{"@id":"https://homosaurus.org/v3/homoit0002700"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000120"},{"@id":"https://homosaurus.org/v3/homoit0000567"},{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0000571"},{"@id":"https://homosaurus.org/v3/homoit0000572"},{"@id":"https://homosaurus.org/v3/homoit0001006"},{"@id":"https://homosaurus.org/v3/homoit0002256"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000567"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderDysphoria"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002256","dc:identifier":"homoit0002256","skos:prefLabel":{"@language":"en","@value":"Gender euphoria"},"rdfs:comment":{"@language":"en","@value":"The powerful feeling of joy and comfort an individual experiences when their assigned gender, gender expression, and/or the way their gender is perceived by themselves and others aligns with their gender identity. Though gender euphoria is often associated with trans people, people of any identity may experience gender euphoria when they feel that their gender has been seen and affirmed, or when they feel \"right\" in their body and the way their gender is being expressed."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000120"},{"@id":"https://homosaurus.org/v3/homoit0000567"},{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0000571"},{"@id":"https://homosaurus.org/v3/homoit0002699"},{"@id":"https://homosaurus.org/v3/homoit0002700"},{"@id":"https://homosaurus.org/v3/homoit0003193"},{"@id":"https://homosaurus.org/v3/homoit0003708"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002256"},"dc:issued":{"@type":"xsd:date","@value":"2022-09-09"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000821","dc:identifier":"homoit0000821","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ birth parents"},"skos:altLabel":{"@language":"en","@value":"LGBTQ birth parents"},"rdfs:comment":{"@language":"en","@value":"In an adoption context, biological or genetic parents who are LGBTQ+ people."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000121"},{"@id":"https://homosaurus.org/v3/homoit0000809"},{"@id":"https://homosaurus.org/v3/homoit0001075"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQBirthParents"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000147","dc:identifier":"homoit0000147","skos:prefLabel":[{"@language":"en-us","@value":"Bisexual information centers"},{"@language":"en-gb","@value":"Bisexual information centres"}],"rdfs:comment":{"@language":"en","@value":"Institutions providing education, support, and information about bisexuality and bisexual communities to bisexual people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000660"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000122"},{"@id":"https://homosaurus.org/v3/homoit0000162"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualInformationCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000162","dc:identifier":"homoit0000162","skos:prefLabel":{"@language":"en","@value":"Bisexual movement"},"rdfs:comment":{"@language":"en","@value":"Umbrella term for activism focused on the rights of bisexual people and issues faced by bisexual communities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001026"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000122"},{"@id":"https://homosaurus.org/v3/homoit0000147"},{"@id":"https://homosaurus.org/v3/homoit0000177"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualMovement"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc: