uage":"en","@value":"Gender confirming surgery"}],"rdfs:comment":{"@language":"en","@value":"Any of various surgeries undertaken to affirm an individual's gender. Most often applied to transgender people, but may also refer to certain procedures undergone by cisgender and intersex people."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001004"},{"@id":"https://homosaurus.org/v3/homoit0003657"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000584"},{"@id":"https://homosaurus.org/v3/homoit0001040"},{"@id":"https://homosaurus.org/v3/homoit0001837"},{"@id":"https://homosaurus.org/v3/homoit0001840"},{"@id":"https://homosaurus.org/v3/homoit0001842"},{"@id":"https://homosaurus.org/v3/homoit0001843"},{"@id":"https://homosaurus.org/v3/homoit0001894"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000560"},{"@id":"https://homosaurus.org/v3/homoit0001049"},{"@id":"https://homosaurus.org/v3/homoit0001129"},{"@id":"https://homosaurus.org/v3/homoit0001131"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001381"},{"@id":"https://homosaurus.org/v3/homoit0001464"},{"@id":"https://homosaurus.org/v3/homoit0001465"},{"@id":"https://homosaurus.org/v3/homoit0003504"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2020000651"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderConfirmingSurgery"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000565","dc:identifier":"homoit0000565","skos:prefLabel":{"@language":"en","@value":"Genderism"},"skos:altLabel":{"@language":"en","@value":"Gender discrimination"},"rdfs:comment":{"@language":"en","@value":"The systematic belief that there are only two genders (men and women) and that individuals must conform to the gender they were assigned at or shortly after birth."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000920"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0003158"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000560"},{"@id":"https://homosaurus.org/v3/homoit0000571"},{"@id":"https://homosaurus.org/v3/homoit0001278"},{"@id":"https://homosaurus.org/v3/homoit0003519"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000578","dc:identifier":"homoit0000578","skos:prefLabel":{"@language":"en","@value":"Gender segregation"},"rdfs:comment":{"@language":"en","@value":"Physical, legal, cultural, or rhetorical separation of people according to their gender."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000560"},{"@id":"https://homosaurus.org/v3/homoit0000563"},{"@id":"https://homosaurus.org/v3/homoit0000575"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000578"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderSegregation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-11-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000580","dc:identifier":"homoit0000580","skos:prefLabel":{"@language":"en","@value":"Gendercide"},"rdfs:comment":{"@language":"en","@value":"The systematic killing of members of a specific gender for their gender."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000560"},{"@id":"https://homosaurus.org/v3/homoit0000571"},{"@id":"https://homosaurus.org/v3/homoit0001108"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000580"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gendercide"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001816","dc:identifier":"homoit0001816","skos:prefLabel":{"@language":"en","@value":"Gender transgression"},"rdfs:comment":{"@language":"en","@value":"Behaviors, acts, or forms of expression that contradict or do not conform to a given culture's norms surrounding gender."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000568"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000560"},{"@id":"https://homosaurus.org/v3/homoit0000562"},{"@id":"https://homosaurus.org/v3/homoit0000577"},{"@id":"https://homosaurus.org/v3/homoit0000581"},{"@id":"https://homosaurus.org/v3/homoit0001817"},{"@id":"https://homosaurus.org/v3/homoit0003066"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001899","dc:identifier":"homoit0001899","skos:prefLabel":{"@language":"en","@value":"Gender ambiguity"},"rdfs:comment":{"@language":"en","@value":"Gender expression that does not conform to a single, distinct gender identity."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000568"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000560"},{"@id":"https://homosaurus.org/v3/homoit0000577"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003657","dc:identifier":"homoit0003657","skos:prefLabel":{"@language":"en","@value":"Gender-affirming care"},"skos:altLabel":{"@language":"en","@value":"Gender affirming care"},"rdfs:comment":{"@language":"en","@value":"Social, psychological, behavioral, and medical interventions designed to support and affirm an individual's gender identity. Gender-affirming care includes but is not limited to equal access to health care facilities, counseling, puberty blockers, hormone therapy, and gender-affirming surgeries. It can also include resources to aid in social transition, such as affirming policies regarding name and pronoun changes, access to non-gendered restrooms and facilities, etc."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000614"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000561"},{"@id":"https://homosaurus.org/v3/homoit0003658"},{"@id":"https://homosaurus.org/v3/homoit0003659"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2023000451"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000614"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000584","dc:identifier":"homoit0000584","skos:prefLabel":{"@language":"en","@value":"Bottom surgery"},"skos:altLabel":{"@language":"en","@value":"Genital reconstruction surgery"},"rdfs:comment":{"@language":"en","@value":"Colloquial term for gender-affirming surgical alterations of the genitalia and/or reproductive organs."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000561"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000658"},{"@id":"https://homosaurus.org/v3/homoit0001060"},{"@id":"https://homosaurus.org/v3/homoit0001097"},{"@id":"https://homosaurus.org/v3/homoit0001844"},{"@id":"https://homosaurus.org/v3/homoit0001845"},{"@id":"https://homosaurus.org/v3/homoit0001846"},{"@id":"https://homosaurus.org/v3/homoit0001847"},{"@id":"https://homosaurus.org/v3/homoit0001848"},{"@id":"https://homosaurus.org/v3/homoit0001850"},{"@id":"https://homosaurus.org/v3/homoit0001851"},{"@id":"https://homosaurus.org/v3/homoit0002840"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001465"},{"@id":"https://homosaurus.org/v3/homoit0001840"},{"@id":"https://homosaurus.org/v3/homoit0002847"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genitalReconstructionSurgery"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001040","dc:identifier":"homoit0001040","skos:prefLabel":{"@language":"en","@value":"Neovagina"},"rdfs:comment":{"@language":"en","@value":"A surgically constructed vagina; typically made using tissue grafted from other parts of the body."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000561"},{"@id":"https://homosaurus.org/v3/homoit0001488"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001844"},{"@id":"https://homosaurus.org/v3/homoit0001845"},{"@id":"https://homosaurus.org/v3/homoit0001851"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/neovagina"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001837","dc:identifier":"homoit0001837","skos:prefLabel":{"@language":"en","@value":"Facial gender affirming surgery"},"skos:altLabel":[{"@language":"en","@value":"Facial gender affirmation surgery"},{"@language":"en","@value":"Facial gender confirmation surgery"},{"@language":"en","@value":"Facial gender confirming surgery"}],"rdfs:comment":{"@language":"en","@value":"Any of various surgeries that involve modifying the face or facial features to affirm the patient's gender."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000561"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001838"},{"@id":"https://homosaurus.org/v3/homoit0001839"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001464"},{"@id":"https://homosaurus.org/v3/homoit0001465"},{"@id":"https://homosaurus.org/v3/homoit0001849"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001842","dc:identifier":"homoit0001842","skos:prefLabel":{"@language":"en","@value":"Feminizing vocal surgery"},"skos:altLabel":[{"@language":"en","@value":"VFS"},{"@language":"en","@value":"Vocal feminization surgery"},{"@language":"en","@value":"Voice feminization surgery"}],"rdfs:comment":{"@language":"en","@value":"Any of various surgical procedures undertaken to feminize the voice."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000561"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001465"},{"@id":"https://homosaurus.org/v3/homoit0001495"},{"@id":"https://homosaurus.org/v3/homoit0001496"},{"@id":"https://homosaurus.org/v3/homoit0001843"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001843","dc:identifier":"homoit0001843","skos:prefLabel":{"@language":"en","@value":"Masculinizing vocal surgery"},"skos:altLabel":[{"@language":"en","@value":"Masculinization laryngoplasty"},{"@language":"en","@value":"Vocal masculinization surgery"},{"@language":"en","@value":"Voice masculinization surgery"}],"rdfs:comment":{"@language":"en","@value":"Any of various surgical procedures undertaken to masculinize the voice."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000561"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001465"},{"@id":"https://homosaurus.org/v3/homoit0001495"},{"@id":"https://homosaurus.org/v3/homoit0001496"},{"@id":"https://homosaurus.org/v3/homoit0001842"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001894","dc:identifier":"homoit0001894","skos:prefLabel":{"@language":"en","@value":"Neophallus"},"rdfs:comment":{"@language":"en","@value":"A surgically constructed penis; typically made using tissue grafts from other parts of the body."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000561"},{"@id":"https://homosaurus.org/v3/homoit0001099"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001465"},{"@id":"https://homosaurus.org/v3/homoit0001846"},{"@id":"https://homosaurus.org/v3/homoit0001847"},{"@id":"https://homosaurus.org/v3/homoit0001848"},{"@id":"https://homosaurus.org/v3/homoit0001850"},{"@id":"https://homosaurus.org/v3/homoit0001852"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001049","dc:identifier":"homoit0001049","skos:prefLabel":{"@language":"en","@value":"Non-operative"},"rdfs:comment":{"@language":"en","@value":"The medical status of individuals who do not plan to undertake a surgical procedure. Commonly used to describe trans people who have not and do not plan to undertake gender affirming surgery."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001464"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000561"},{"@id":"https://homosaurus.org/v3/homoit0000617"},{"@id":"https://homosaurus.org/v3/homoit0001047"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001381"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001465"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nonOperative"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001129","dc:identifier":"homoit0001129","skos:prefLabel":{"@language":"en","@value":"Post-operative"},"rdfs:comment":{"@language":"en","@value":"Individuals who have recently undergone a surgical operation; commonly used to describe trans people who have undergone gender affirming surgery."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001464"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000561"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001381"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85105563"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001465"},"dc:replaces":{"@id":"http://homosaurus.org/v2/postOperative"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001131","dc:identifier":"homoit0001131","skos:prefLabel":{"@language":"en","@value":"Pre-operative"},"rdfs:comment":{"@language":"en","@value":"The medical status of individuals who plan to undertake a surgical procedure but have not yet done so. Commonly used to describe trans people who have not yet undergone gender affirming surgery but plan to do so."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001464"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000561"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001381"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85106377"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001465"},"dc:replaces":{"@id":"http://homosaurus.org/v2/preOperative"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001464","dc:identifier":"homoit0001464","skos:prefLabel":{"@language":"en","@value":"Transitioning status"},"rdfs:comment":{"@language":"en","@value":"Term used to describe a person’s current status in their gender transition."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001465"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001047"},{"@id":"https://homosaurus.org/v3/homoit0001049"},{"@id":"https://homosaurus.org/v3/homoit0001129"},{"@id":"https://homosaurus.org/v3/homoit0001131"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000561"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001381"},{"@id":"https://homosaurus.org/v3/homoit0001834"},{"@id":"https://homosaurus.org/v3/homoit0001835"},{"@id":"https://homosaurus.org/v3/homoit0001836"},{"@id":"https://homosaurus.org/v3/homoit0001837"},{"@id":"https://homosaurus.org/v3/homoit0001838"},{"@id":"https://homosaurus.org/v3/homoit0001839"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001465"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transitioningStatus"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003504","dc:identifier":"homoit0003504","skos:prefLabel":{"@language":"en","@value":"Transgender health care bans"},"rdfs:comment":{"@language":"en","@value":"Laws or policies instituted to prevent trans and non-binary individuals from seeking medical treatment or gender-affirming care, including but not limited to surgery, hormone treatment, and mental health care. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0003499"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000561"},{"@id":"https://homosaurus.org/v3/homoit0000614"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002589","dc:identifier":"homoit0002589","skos:prefLabel":{"@language":"en","@value":"Gender role stereotypes"},"skos:altLabel":{"@language":"en","@value":"Gender stereotypes"},"rdfs:comment":{"@language":"en","@value":"Widely held but oversimplified and often offensive ideas regarding gender roles, which are socially-determined rules or standards for gendered behaviors. Use the term \"Gender roles\" to describe gender roles as a whole, rather than stereotypes related to them."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000577"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000563"},{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0000575"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001241"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000564","dc:identifier":"homoit0000564","skos:prefLabel":{"@language":"en","@value":"Gender blending"},"rdfs:comment":{"@language":"en","@value":"Gender expression that involves blending dress and behaviors associated with different genders. Do not use to describe the identities of genderqueer or non-binary people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000568"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderBlending"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001278","dc:identifier":"homoit0001278","skos:prefLabel":{"@language":"en","@value":"Sexism"},"rdfs:comment":{"@language":"en","@value":"Discrimination, prejudice, or bias directed against a particular sex or gender based on the assumption that this sex or gender is intrinsically inferior to another."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000565"},{"@id":"https://homosaurus.org/v3/homoit0000619"},{"@id":"https://homosaurus.org/v3/homoit0001293"},{"@id":"https://homosaurus.org/v3/homoit0002183"},{"@id":"https://homosaurus.org/v3/homoit0002259"},{"@id":"https://homosaurus.org/v3/homoit0003519"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120678"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001278"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002700","dc:identifier":"homoit0002700","skos:prefLabel":{"@language":"en","@value":"Gender dysphoria in youth"},"skos:altLabel":[{"@language":"en","@value":"Gender dysphoria in adolescence"},{"@language":"en","@value":"Gender dysphoria in adolescents"}],"rdfs:comment":{"@language":"en","@value":"A psychological diagnosis (replacing the outdated and offensive \"gender identity disorder\") used to describe the sense of unease or dissatisfaction an individual feels as a result of incongruence between their gender identity and their assigned gender, gender expression, and/or the way their gender is perceived by others. This term is also used colloquially by individuals to describe the discomfort and distress they experience as a result of this incongruence. Though gender dysphoria is often associated with trans people, people of any identity may experience gender dysphoria when they do not feel \"right\" in their body or the way their gender is being expressed. Use this particular term for works about adolescents (people between the ages of childhood and adulthood) who experience or have experience gender dysphoria."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000567"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0000571"},{"@id":"https://homosaurus.org/v3/homoit0001521"},{"@id":"https://homosaurus.org/v3/homoit0002256"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000567"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000572","dc:identifier":"homoit0000572","skos:prefLabel":{"@language":"en","@value":"Gender identity disorder"},"rdfs:comment":{"@language":"en","@value":"An obsolete psychological diagnosis that medicalizes trans identities and practices; only use in historical contexts."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001006"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000567"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001381"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85053731"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderIdentityDisorder"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000576","dc:identifier":"homoit0000576","skos:prefLabel":{"@language":"en","@value":"Gender swapping"},"skos:altLabel":{"@language":"en","@value":"Gender roleplay"},"rdfs:comment":{"@language":"en","@value":"A media trope (commonly used in fanfiction and fanart) in which one or more characters switch binary sexes (e.g., a cisgender man transforms into a cisgender woman), often temporarily."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0001242"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000577"},{"@id":"https://homosaurus.org/v3/homoit0002160"},{"@id":"https://homosaurus.org/v3/homoit0002162"},{"@id":"https://homosaurus.org/v3/homoit0002171"},{"@id":"https://homosaurus.org/v3/homoit0002184"},{"@id":"https://homosaurus.org/v3/homoit0002210"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderSwapping"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000606","dc:identifier":"homoit0000606","skos:prefLabel":{"@language":"en","@value":"Hair removal"},"skos:altLabel":[{"@language":"en","@value":"Shaving"},{"@language":"en","@value":"Waxing"}],"rdfs:comment":{"@language":"en","@value":"The process of removing hair from the body through shaving, waxing, depilatories, laser hair removal, etc. May have a social component related to gender identity and/or have an erotic component."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000568"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001465"},{"@id":"https://homosaurus.org/v3/homoit0003049"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85058312"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hairRemoval"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001476","dc:identifier":"homoit0001476","skos:prefLabel":{"@language":"en","@value":"Tucking (Phallus)"},"skos:altLabel":{"@language":"en","@value":"Tucking"},"rdfs:comment":{"@language":"en","@value":"Slang term describing various methods used to visually conceal the penis to give a flatter appearance in clothing."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000568"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001099"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tucking"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001496","dc:identifier":"homoit0001496","skos:prefLabel":{"@language":"en","@value":"Voice therapy (Gender)"},"skos:altLabel":[{"@language":"en","@value":"Voice therapy (Transgender)"},{"@language":"en","@value":"Voice therapy"}],"rdfs:comment":{"@language":"en","@value":"Any non-surgical technique used to make the human voice sound either more feminine or masculine."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0001366"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001465"},{"@id":"https://homosaurus.org/v3/homoit0001468"},{"@id":"https://homosaurus.org/v3/homoit0001842"},{"@id":"https://homosaurus.org/v3/homoit0001843"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/voiceTherapyTransgender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001790","dc:identifier":"homoit0001790","skos:prefLabel":{"@language":"en","@value":"Packers (Phallus)"},"rdfs:comment":{"@language":"en","@value":"Padding or phallic objects designed to be worn in the front of an individual's pants or underwear to give the appearance of having a bulge."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000568"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001067"},{"@id":"https://homosaurus.org/v3/homoit0001099"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001820","dc:identifier":"homoit0001820","skos:prefLabel":{"@language":"en","@value":"Transmasculinity"},"rdfs:comment":{"@language":"en","@value":"Masculine-aligned identities or practices of trans people."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0000995"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001466"},{"@id":"https://homosaurus.org/v3/homoit0001643"},{"@id":"https://homosaurus.org/v3/homoit0001653"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-18"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000581","dc:identifier":"homoit0000581","skos:prefLabel":{"@language":"en","@value":"Genderfuck"},"rdfs:comment":{"@language":"en","@value":"A form of gender expression that seeks to subvert the gender binary or gender roles by mixing and messing with (or \"fucking with\") traditionally masculine and feminine components. Typically used to describe gender practices and presentation, though some people identify as \"genderfuck\" or as \"genderfuckers.\" Only use to describe people and the practices of people who self-identify with genderfuck."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0001816"},{"@id":"https://homosaurus.org/v3/homoit0001817"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000581"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderfuck"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001071","dc:identifier":"homoit0001071","skos:prefLabel":{"@language":"en","@value":"Pangender identity"},"rdfs:comment":{"@language":"en","@value":"Gender identity that encompasses multiple or all genders."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000571"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001072"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pangenderIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001415","dc:identifier":"homoit0001415","skos:prefLabel":{"@language":"en","@value":"Transgender identity"},"rdfs:comment":{"@language":"en","@value":"Identity term used to describe people who cross or transgress the  gender they were assigned at birth."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000571"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001400"},{"@id":"https://homosaurus.org/v3/homoit0001563"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007005095"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001473","dc:identifier":"homoit0001473","skos:prefLabel":{"@language":"en","@value":"Trigender identity"},"rdfs:comment":{"@language":"en","@value":"Gender identity including three genders, typically male, female, and a third (often non-binary) gender."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000571"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001474"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/trigenderIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001670","dc:identifier":"homoit0001670","skos:prefLabel":{"@language":"en","@value":"Xenogender identity"},"rdfs:comment":{"@language":"en","@value":"Non-binary gender identity that is not defined in relation to human understandings of gender (i.e., female or male, woman or man), but instead in relation to animals, plants, or other things"},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000571"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001048"},{"@id":"https://homosaurus.org/v3/homoit0001671"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/xenogender"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001918","dc:identifier":"homoit0001918","skos:prefLabel":{"@language":"en","@value":"Transgenderqueer identity"},"skos:altLabel":{"@language":"en","@value":"Transgenderqueerness"},"rdfs:comment":{"@language":"en","@value":"Identity term used to describe the intersection of trans identity and genderqueer identity."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000571"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001668"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001920","dc:identifier":"homoit0001920","skos:prefLabel":{"@language":"en","@value":"Non-binary identity"},"skos:altLabel":{"@language":"en","@value":"Nonbinary identity"},"rdfs:comment":{"@language":"en","@value":"Gender identity that exists outside of the gender binary; may be used as a specific gender identity or as an umbrella term in the Euro-American gender system for gender identities outside of the gender binary."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000571"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001048"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001921","dc:identifier":"homoit0001921","skos:prefLabel":{"@language":"en","@value":"Genderqueer identity"},"skos:altLabel":{"@language":"en","@value":"Genderqueerness"},"rdfs:comment":{"@language":"en","@value":"Gender identity that does not conform to the gender binary and emphasizes alignment with queer politics."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000571"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000582"},{"@id":"https://homosaurus.org/v3/homoit0001195"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001668"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001922","dc:identifier":"homoit0001922","skos:prefLabel":{"@language":"en","@value":"Gender non-conforming identity"},"skos:altLabel":[{"@language":"en","@value":"Gender nonconforming identity"},{"@language":"en","@value":"Gender-nonconforming identity"}],"rdfs:comment":{"@language":"en","@value":"Gender identity that does not conform to the gender binary, not to be confused with gender non-conforming practices engaged in by cisgender people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000571"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000574"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001756"},{"@id":"https://homosaurus.org/v3/homoit0002388"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007003716"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001563","dc:identifier":"homoit0001563","skos:prefLabel":{"@language":"en","@value":"Trans"},"skos:altLabel":{"@language":"en","@value":"Trans*"},"rdfs:comment":{"@language":"en","@value":"Umbrella term used to describe individuals who \"trans\" gender regardless of their identification; sometimes used as a way to historicize non-binary identities."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000571"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001415"},{"@id":"https://homosaurus.org/v3/homoit0001463"},{"@id":"https://homosaurus.org/v3/homoit0001468"},{"@id":"https://homosaurus.org/v3/homoit0001469"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001563"},"dc:replaces":{"@id":"http://homosaurus.org/v2/trans"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001671","dc:identifier":"homoit0001671","skos:prefLabel":{"@language":"en","@value":"Xenogender people"},"rdfs:comment":{"@language":"en","@value":"A person who identifies their gender in relation to non-human understandings of gender and relates to animals, plants, or other things."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000571"},{"@id":"https://homosaurus.org/v3/homoit0001048"},{"@id":"https://homosaurus.org/v3/homoit0001670"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001671"},"dc:replaces":{"@id":"http://homosaurus.org/v2/xenogenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002884","dc:identifier":"homoit0002884","skos:prefLabel":{"@language":"en","@value":"X gender markers"},"rdfs:comment":{"@language":"en","@value":"Gender markers that indicate a person is NOT cisgender. X gender markers may be assigned to or adopted by intersex people or transgender people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000573"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001646"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000712"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-09-14"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000574","dc:identifier":"homoit0000574","skos:prefLabel":{"@language":"en","@value":"Gender non-conforming people"},"rdfs:comment":{"@language":"en","@value":"People who identify outside, transgress, or do not conform to a given culture's gender roles or expectations. Only use in reference to people who self-identity as gender non-conforming. Do not use to describe cisgender people whose dress or behaviors do not conform to gender roles or expectations."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001817"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001756"},{"@id":"https://homosaurus.org/v3/homoit0001922"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2017004882"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001817"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderNonConformingPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000778","dc:identifier":"homoit0000778","skos:prefLabel":{"@language":"en","@value":"Lesbian separatism"},"rdfs:comment":{"@language":"en","@value":"Ideological, social, cultural, and physical separation between men and women or between lesbians and heterosexual women."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000746"},{"@id":"https://homosaurus.org/v3/homoit0000757"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000575"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2009003403"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000778"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianSeparatism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002160","dc:identifier":"homoit0002160","skos:prefLabel":{"@language":"en","@value":"Fanfiction tropes and genres"},"skos:altLabel":{"@language":"en","@value":"Fanfic tropes and genres"},"rdfs:comment":{"@language":"en","@value":"Tropes and genres commonly used in fanfiction. Examples include \"there was only one bed\" and \"enemies to lovers\" romance plots."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002159"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002143"},{"@id":"https://homosaurus.org/v3/homoit0002153"},{"@id":"https://homosaurus.org/v3/homoit0002176"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000576"},{"@id":"https://homosaurus.org/v3/homoit0002187"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002162","dc:identifier":"homoit0002162","skos:prefLabel":{"@language":"en","@value":"Femslash"},"skos:altLabel":[{"@language":"en","@value":"Altfic"},{"@language":"en","@value":"F/F slash"},{"@language":"en","@value":"Femmeslash"},{"@language":"en","@value":"Girlslash"},{"@language":"en","@value":"Ladyslash"}],"rdfs:comment":{"@language":"en","@value":"A genre of fanworks in which two or more women are placed in a sexual or romantic situation with one another. Works of femslash are commonly erotic or pornographic. In recognition of the fact that the term \"slash\" has recently been broadened to include LGBTQ+ relationships other than those between two men, slash terms (e.g., Slash art, Slash roleplay, Slash vidding) should be used to describe specific types of femslash."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002200"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000742"},{"@id":"https://homosaurus.org/v3/homoit0001597"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000576"},{"@id":"https://homosaurus.org/v3/homoit0002220"},{"@id":"https://homosaurus.org/v3/homoit0002221"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002171","dc:identifier":"homoit0002171","skos:prefLabel":{"@language":"en","@value":"Gender in fandom"},"rdfs:comment":{"@language":"en","@value":"Issues and discussions about gender in fan spaces and works."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002156"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002174"},{"@id":"https://homosaurus.org/v3/homoit0002175"},{"@id":"https://homosaurus.org/v3/homoit0002182"},{"@id":"https://homosaurus.org/v3/homoit0002183"},{"@id":"https://homosaurus.org/v3/homoit0002185"},{"@id":"https://homosaurus.org/v3/homoit0002211"},{"@id":"https://homosaurus.org/v3/homoit0002212"},{"@id":"https://homosaurus.org/v3/homoit0002213"},{"@id":"https://homosaurus.org/v3/homoit0002216"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000576"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002184","dc:identifier":"homoit0002184","skos:prefLabel":{"@language":"en","@value":"Mpreg"},"skos:altLabel":{"@language":"en","@value":"M-preg"},"rdfs:comment":{"@language":"en","@value":"The fandom trope in which cisgender men can become pregnant. This term should not be used to describe pregnant trans men."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002186"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000576"},{"@id":"https://homosaurus.org/v3/homoit0000859"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002210","dc:identifier":"homoit0002210","skos:prefLabel":{"@language":"en","@value":"Transfic"},"rdfs:comment":{"@language":"en","@value":"Term used to describe fanfiction about trans characters, typically characters who are not stated to be transgender, transsexual, or gender diverse in the canon text"},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002159"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000576"},{"@id":"https://homosaurus.org/v3/homoit0001414"},{"@id":"https://homosaurus.org/v3/homoit0002143"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000655","dc:identifier":"homoit0000655","skos:prefLabel":{"@language":"en","@value":"Machismo"},"rdfs:comment":{"@language":"en","@value":"Term originating in the early 1930s and 40s to describe a man's responsibility and pride in providing for, protecting, and defending his family. It is unclear whether the term originates in Spain or Portugal. Though there are positive sides of machismo and it remains an important part of Iberian and Latin American cultures, the concept has also been criticized for its perceived role in perpetuating misogyny, harmful gender roles, and domestic and sexual violence."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000577"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000978"},{"@id":"https://homosaurus.org/v3/homoit0000995"},{"@id":"https://homosaurus.org/v3/homoit0001377"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88006590"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001241"},"dc:replaces":{"@id":"http://homosaurus.org/v2/machismo"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003506","dc:identifier":"homoit0003506","skos:prefLabel":{"@language":"en","@value":"Ky-ky (Gender role)"},"skos:altLabel":[{"@language":"en","@value":"Kiki (Gender role)"},{"@language":"en","@value":"Kyky (Gender role)"}],"rdfs:comment":{"@language":"en","@value":"A slang term that emerged in the 1940s to describe lesbians who do not identify as butch or femme. Do not conflate with the term \"Kiki (Social gathering), which refers to a gathering of friends."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000577"},{"@id":"https://homosaurus.org/v3/homoit0001295"},{"@id":"https://homosaurus.org/v3/homoit0001304"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001241"},"dc:issued":{"@type":"xs