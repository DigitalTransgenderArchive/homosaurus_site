Boob"},{"@language":"en","@value":"Breasts"},{"@language":"en","@value":"Tit"},{"@language":"en","@value":"Titty"}],"rdfs:comment":{"@language":"en","@value":"One of the two soft, protruding organs on an individual's chest."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000401"},{"@id":"https://homosaurus.org/v3/homoit0001259"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000114"},{"@id":"https://homosaurus.org/v3/homoit0001620"},{"@id":"https://homosaurus.org/v3/homoit0001621"},{"@id":"https://homosaurus.org/v3/homoit0001622"},{"@id":"https://homosaurus.org/v3/homoit0001623"},{"@id":"https://homosaurus.org/v3/homoit0001630"},{"@id":"https://homosaurus.org/v3/homoit0001631"},{"@id":"https://homosaurus.org/v3/homoit0001639"},{"@id":"https://homosaurus.org/v3/homoit0003118"},{"@id":"https://homosaurus.org/v3/homoit0003130"},{"@id":"https://homosaurus.org/v3/homoit0003132"},{"@id":"https://homosaurus.org/v3/homoit0003133"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85016677"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000401"},"dc:replaces":{"@id":"http://homosaurus.org/v2/breasts"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-25"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000436","dc:identifier":"homoit0000436","skos:prefLabel":{"@language":"en","@value":"FtMs"},"skos:altLabel":[{"@language":"en","@value":"Females transitioning to males"},{"@language":"en","@value":"FtM transsexuals"},{"@language":"en","@value":"F2Ms"},{"@language":"en","@value":"Transsexual men"},{"@language":"en","@value":"Female-to-male"}],"rdfs:comment":{"@language":"en","@value":"FtM (female-to-male) is a mostly historical term which has been largely replaced by “trans men.” This is due in part to the term's role in the medicalization of transgender people and the assumption that trans men were previously “female” and have become “male” (typically through hormones and/or surgery)."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000878"},{"@id":"https://homosaurus.org/v3/homoit0001381"},{"@id":"https://homosaurus.org/v3/homoit0001643"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000114"},{"@id":"https://homosaurus.org/v3/homoit0000224"},{"@id":"https://homosaurus.org/v3/homoit0000457"},{"@id":"https://homosaurus.org/v3/homoit0000986"},{"@id":"https://homosaurus.org/v3/homoit0001027"},{"@id":"https://homosaurus.org/v3/homoit0001362"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/FtMs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001840","dc:identifier":"homoit0001840","skos:prefLabel":{"@language":"en","@value":"Top surgery"},"rdfs:comment":{"@language":"en","@value":"Colloquial term for gender-affirming surgical alterations of the chest."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000561"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001620"},{"@id":"https://homosaurus.org/v3/homoit0001631"},{"@id":"https://homosaurus.org/v3/homoit0001841"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000114"},{"@id":"https://homosaurus.org/v3/homoit0000584"},{"@id":"https://homosaurus.org/v3/homoit0001465"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001852","dc:identifier":"homoit0001852","skos:prefLabel":{"@language":"en","@value":"Stand-to-Pee devices"},"skos:altLabel":[{"@language":"en","@value":"STP devices"},{"@language":"en","@value":"STPs"},{"@language":"en","@value":"Stand to pee devices"}],"rdfs:comment":{"@language":"en","@value":"Devices designed to allow individuals to pee while standing up; often used by trans men or transmasculine people to pee in public urinals without risking their safety."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000568"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000114"},{"@id":"https://homosaurus.org/v3/homoit0001846"},{"@id":"https://homosaurus.org/v3/homoit0001894"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-15"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003118","dc:identifier":"homoit0003118","skos:prefLabel":{"@language":"en","@value":"Chest"},"rdfs:comment":{"@language":"en","@value":"A gender-inclusive term for the upper area of the torso, can be used if the person has breasts or not."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000401"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000114"},{"@id":"https://homosaurus.org/v3/homoit0000222"},{"@id":"https://homosaurus.org/v3/homoit0001621"},{"@id":"https://homosaurus.org/v3/homoit0001841"},{"@id":"https://homosaurus.org/v3/homoit0003132"},{"@id":"https://homosaurus.org/v3/homoit0003133"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000401"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000115","dc:identifier":"homoit0000115","skos:prefLabel":{"@language":"en","@value":"Essentialism"},"skos:altLabel":{"@language":"en","@value":"Biological essentialism"},"rdfs:comment":{"@language":"en","@value":"The practice of defining certain categories through a set of supposed universal or fixed characteristics or traits (e.g., defining women in terms of \"female\" genitalia)."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001365"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0003158"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001219"},{"@id":"https://homosaurus.org/v3/homoit0001295"},{"@id":"https://homosaurus.org/v3/homoit0001320"},{"@id":"https://homosaurus.org/v3/homoit0003519"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85044919"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/essentialism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001219","dc:identifier":"homoit0001219","skos:prefLabel":{"@language":"en","@value":"Queer theory"},"rdfs:comment":{"@language":"en","@value":"Field of critical theory that emerged in the 1990s out of queer studies and women's studies. Queer theory involves the study and theorization of gender and sexual practices and identities that exist outside of heterosexuality and which challenge heteronormativity and essentialism."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001365"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002042"},{"@id":"https://homosaurus.org/v3/homoit0003614"},{"@id":"https://homosaurus.org/v3/homoit0003615"},{"@id":"https://homosaurus.org/v3/homoit0003707"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000115"},{"@id":"https://homosaurus.org/v3/homoit0000579"},{"@id":"https://homosaurus.org/v3/homoit0001149"},{"@id":"https://homosaurus.org/v3/homoit0001210"},{"@id":"https://homosaurus.org/v3/homoit0001218"},{"@id":"https://homosaurus.org/v3/homoit0001320"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006001835"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerTheory"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001320","dc:identifier":"homoit0001320","skos:prefLabel":{"@language":"en","@value":"Social constructionism"},"rdfs:comment":{"@language":"en","@value":"Belief or theory that categories of gender, sexual orientation, and ethnicity are cultural constructs rather than intrinsic categories of nature."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001365"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000115"},{"@id":"https://homosaurus.org/v3/homoit0001006"},{"@id":"https://homosaurus.org/v3/homoit0001219"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2009007835"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/socialConstructionism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003519","dc:identifier":"homoit0003519","skos:prefLabel":{"@language":"en","@value":"Patriarchy"},"skos:altLabel":{"@language":"en","@value":"Andocracy"},"rdfs:comment":{"@language":"en","@value":"A cultural system in which positions of dominance and privilege are held by men, while women and other gender minorities are largely excluded from access to power."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000115"},{"@id":"https://homosaurus.org/v3/homoit0000565"},{"@id":"https://homosaurus.org/v3/homoit0001278"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85098727"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0003519"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000116","dc:identifier":"homoit0000116","skos:prefLabel":{"@language":"en","@value":"Biological parenthood"},"rdfs:comment":{"@language":"en","@value":"The experience of being a biological parent to a child. This relationship can be genetic, gestational, or both."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000819"},{"@id":"https://homosaurus.org/v3/homoit0000914"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000583"},{"@id":"https://homosaurus.org/v3/homoit0000587"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000121"},{"@id":"https://homosaurus.org/v3/homoit0000364"},{"@id":"https://homosaurus.org/v3/homoit0000451"},{"@id":"https://homosaurus.org/v3/homoit0001001"},{"@id":"https://homosaurus.org/v3/homoit0001093"},{"@id":"https://homosaurus.org/v3/homoit0002621"},{"@id":"https://homosaurus.org/v3/homoit0002623"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/biologicalParenthood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000819","dc:identifier":"homoit0000819","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ biological parents"},"skos:altLabel":{"@language":"en","@value":"LGBTQ biological parents"},"rdfs:comment":{"@language":"en","@value":"Biological or genetic parents who are LGBTQ+ people. For adoption contexts, use LGBTQ+ birth parents."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000420"},{"@id":"https://homosaurus.org/v3/homoit0001075"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000116"},{"@id":"https://homosaurus.org/v3/homoit0000583"},{"@id":"https://homosaurus.org/v3/homoit0000587"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000121"},{"@id":"https://homosaurus.org/v3/homoit0000864"},{"@id":"https://homosaurus.org/v3/homoit0000914"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQBiologicalParents"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-02-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000583","dc:identifier":"homoit0000583","skos:prefLabel":{"@language":"en","@value":"Genetic parenthood"},"rdfs:comment":{"@language":"en","@value":"The experience of parenthood as felt by parents who passed on genetic material to their child or children."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000116"},{"@id":"https://homosaurus.org/v3/homoit0000819"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000364"},{"@id":"https://homosaurus.org/v3/homoit0000390"},{"@id":"https://homosaurus.org/v3/homoit0000587"},{"@id":"https://homosaurus.org/v3/homoit0000914"},{"@id":"https://homosaurus.org/v3/homoit0002621"},{"@id":"https://homosaurus.org/v3/homoit0002623"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/geneticParenthood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000587","dc:identifier":"homoit0000587","skos:prefLabel":{"@language":"en","@value":"Gestational parenthood"},"rdfs:comment":{"@language":"en","@value":"The experience of parenthood as felt by a person whose uterus was utilized to nurture and develop an embryo into a baby."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000116"},{"@id":"https://homosaurus.org/v3/homoit0000819"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000121"},{"@id":"https://homosaurus.org/v3/homoit0001347"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000583"},{"@id":"https://homosaurus.org/v3/homoit0002627"},{"@id":"https://homosaurus.org/v3/homoit0002628"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gestationalParenthood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000364","dc:identifier":"homoit0000364","skos:prefLabel":{"@language":"en","@value":"Donors"},"rdfs:comment":{"@language":"en","@value":"Individuals who donate their own biological materials, typically gametes (e.g., sperm or eggs), organs, or blood."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000390"},{"@id":"https://homosaurus.org/v3/homoit0000824"},{"@id":"https://homosaurus.org/v3/homoit0001336"},{"@id":"https://homosaurus.org/v3/homoit0002616"},{"@id":"https://homosaurus.org/v3/homoit0002624"},{"@id":"https://homosaurus.org/v3/homoit0002625"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000116"},{"@id":"https://homosaurus.org/v3/homoit0000583"},{"@id":"https://homosaurus.org/v3/homoit0000843"},{"@id":"https://homosaurus.org/v3/homoit0000918"},{"@id":"https://homosaurus.org/v3/homoit0001004"},{"@id":"https://homosaurus.org/v3/homoit0002621"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000364"},"dc:replaces":{"@id":"http://homosaurus.org/v2/donors"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/