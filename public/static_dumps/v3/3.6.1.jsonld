 Jewish."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000682"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2003011466"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayJews"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-03-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000499","dc:identifier":"homoit0000499","skos:prefLabel":{"@language":"en","@value":"Lesbian-gay relations"},"skos:altLabel":{"@language":"en","@value":"Gay-lesbian relations"},"rdfs:comment":{"@language":"en","@value":"Connections between individuals and communities of lesbians and gay men, including historic and ongoing solidarity, advocacy, and activism."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000575"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000506"},{"@id":"https://homosaurus.org/v3/homoit0000556"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh95007084"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000947"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbian-gayRelations"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000575","dc:identifier":"homoit0000575","skos:prefLabel":{"@language":"en","@value":"Gender relations"},"rdfs:comment":{"@language":"en","@value":"The culturally specific rights, responsibilities, and connections afforded to individuals or communities of one gender by individuals or communities of another gender."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000947"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000499"},"skos:related":[{"@id":"https://homosaurus.org/