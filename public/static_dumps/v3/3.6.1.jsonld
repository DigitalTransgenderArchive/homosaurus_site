"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001828"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001626"},{"@id":"https://homosaurus.org/v3/homoit0001987"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001828"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001987","dc:identifier":"homoit0001987","skos:prefLabel":{"@language":"en","@value":"Greyromantic people"},"skos:altLabel":[{"@language":"en","@value":"Gray-romantic people"},{"@language":"en","@value":"Grayromantic people"},{"@language":"en","@value":"Grayromantics"},{"@language":"en","@value":"Grey-romantic people"},{"@language":"en","@value":"Greyromantics"}],"rdfs:comment":{"@language":"en","@value":"Individuals who experience rare, infrequent, or low-intensity romantic attraction."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001829"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0003038"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001627"},{"@id":"https://homosaurus.org/v3/homoit0001988"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001829"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001659","dc:identifier":"homoit0001659","skos:prefLabel":{"@language":"en","@value":"Non-monogamy"},"skos:altLabel":[{"@language":"en","@value":"Nonmono"},{"@language":"en","@value":"Nonmonogamy"}],"rdfs:comment":{"@language":"en","@value":"Practice of engaging in romantic or sexual relationships with more than one person simultaneously. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001636"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001629"},{"@id":"https://homosaurus.org/v3/homoit0001651"},{"@id":"https://homosaurus.org/v3/homoit0001658"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002255"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh00003586"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nonMonogamy"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001656","dc:identifier":"homoit0001656","skos:prefLabel":{"@language":"en","@value":"Monogamish"},"rdfs:comment":{"@language":"en","@value":"Term used to describe relationships that are mostly monogamous with occasional exceptions made for sexual play."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001629"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001641"},{"@id":"https://homosaurus.org/v3/homoit0001916"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/monogamish"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001635","dc:identifier":"homoit0001635","skos:prefLabel":{"@language":"en","@value":"Primary partners"},"rdfs:comment":{"@language":"en","@value":"A term used in hierarchical polyamory to refer to the partner whose interests and desires come before those of any secondary partner(s)."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002365"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001629"},{"@id":"https://homosaurus.org/v3/homoit0001638"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/primaryPartners"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003042","dc:identifier":"homoit0003042","skos:prefLabel":{"@language":"en","@value":"Megasexual college students"},"rdfs:comment":{"@language":"en","@value":"Megasexual people who are attending college."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001633"},{"@id":"https://homosaurus.org/v3/homoit0003041"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0003032"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001297"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-05"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003229","dc:identifier":"homoit0003229","skos:prefLabel":{"@language":"en","@value":"Polycules"},"rdfs:comment":{"@language":"en","@value":"Networks of polyamorous people who are connected by their or their partners' romantic and/or sexual relationships. Polycule members are not necessarily romantically and/or sexually involved with every member of the group. For example, Member A might be connected to Member B in that Member B is in a relationship with Member A's partner."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001636"},{"@id":"https://homosaurus.org/v3/homoit0001660"},{"@id":"https://homosaurus.org/v3/homoit0001663"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0003229"},"dc:issued":{"@type":"xsd:date","@value":"2024-05-24"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001665","dc:identifier":"homoit0001665","skos:prefLabel":{"@language":"en","@value":"Relationship anarchists"},"rdfs:comment":{"@language":"en","@value":"People who practice a type of non-monogamy characterized by application of anarchist principles (such as autonomy, anti-normativity, anti-hierarchical practices, refusal of state governance) to relationships. Often contrasted with hierarchical polyamory."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001637"},{"@id":"https://homosaurus.org/v3/homoit0001651"},{"@id":"https://homosaurus.org/v3/homoit0001660"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001666"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001637"},"dc:replaces":{"@id":"http://homosaurus.org/v2/relationshipAnarchists"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001791","dc:identifier":"homoit0001791","skos:prefLabel":{"@language":"en","@value":"Alloromanticism"},"rdfs:comment":{"@language":"en","@value":"A romantic orientation characterized by the occurrence of romantic attraction or desire in a frequent and consistent manner, often alongside sexual attraction."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001828"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001792"},{"@id":"https://homosaurus.org/v3/homoit0001793"},{"@id":"https://homosaurus.org/v3/homoit0001794"},{"@id":"https://homosaurus.org/v3/homoit0001795"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001644"},{"@id":"https://homosaurus.org/v3/homoit0001823"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001828"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001647","dc:identifier":"homoit0001647","skos:prefLabel":{"@language":"en","@value":"Cheating"},"skos:altLabel":[{"@language":"en","@value":"Straying"},{"@language":"en","@value":"Adultery"},{"@language":"en","@value":"Infidelity"},{"@language":"en","@value":"Affairs"},{"@language":"en","@value":"Stepping out"}],"rdfs:comment":{"@language":"en","@value":"A violation of a couple's assumed or stated contract regarding emotional and/or sexual exclusivity. Should not be used to refer to non-monogamy in general, as cheating is possible in both monogamous and non-monogamous relationships."},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85001045"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001647"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001658"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cheating"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2022-10-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001666","dc:identifier":"homoit0001666","skos:prefLabel":{"@language":"en","@value":"Relationship anarchy"},"rdfs:comment":{"@language":"en","@value":"A type of non-monogamy characterized by application of anarchist principles (such as autonomy, anti-normativity, anti-hierarchical practices, refusal of state governance) to relationships. Often contrasted with hierarchical polyamory."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001651"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001665"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/relationshipAnarchy"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003278","dc:identifier":"homoit0003278","skos:prefLabel":{"@language":"en","@value":"Open marriage"},"rdfs:comment":{"@language":"en","@value":"A form of consensual non-monogamy in which spouses agree to engage in sexual and/or romantic relationships with individuals other than their marriage partner, without regarding this as infidelity."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001651"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2003007086"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001636"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001655","dc:identifier":"homoit0001655","skos:prefLabel":{"@language":"en","@value":"Honeymooning"},"rdfs:comment":{"@language":"en","@value":"A period of time in a relationship characterized by passionate love as well as intense feelings of attraction and ecstasy, sometimes accompanied by idealization of a partner or the shared relationship."},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001661"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001655"},"dc:replaces":{"@id":"http://homosaurus.org/v2/honeymooning"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-22"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001717","dc:identifier":"homoit0001717","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ employment"},"skos:altLabel":{"@language":"en","@value":"Employment (LGBTQ)"},"rdfs:comment":{"@language":"en","@value":"Employment of LGBTQ+ individuals."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001718"},{"@id":"https://homosaurus.org/v3/homoit0001719"},{"@id":"https://homosaurus.org/v3/homoit0001720"},{"@id":"https://homosaurus.org/v3/homoit0001721"},{"@id":"https://homosaurus.org/v3/homoit0001722"},{"@id":"https://homosaurus.org/v3/homoit0002029"}