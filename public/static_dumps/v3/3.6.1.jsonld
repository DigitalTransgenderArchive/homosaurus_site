3/homoit0003059"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000077","dc:identifier":"homoit0000077","skos:prefLabel":{"@language":"en","@value":"Assigned female at birth"},"skos:altLabel":[{"@language":"en","@value":"AFAB"},{"@language":"en","@value":"Assigned F at birth"},{"@language":"en","@value":"Designated female at birth"},{"@language":"en","@value":"DFAB"},{"@language":"en","@value":"Female assigned at birth"},{"@language":"en","@value":"FAAB"}],"rdfs:comment":{"@language":"en","@value":"The assignment of a female gender marker or a female sex designation shortly after birth.\r\n"},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000078"},{"@id":"https://homosaurus.org/v3/homoit0001268"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000272"},{"@id":"https://homosaurus.org/v3/homoit0001643"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/assignedFemaleAtBirth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000078","dc:identifier":"homoit0000078","skos:prefLabel":{"@language":"en","@value":"Assigned gender"},"rdfs:comment":{"@language":"en","@value":"The gender, typically \"girl\" or \"boy,\" ascribed to a child at birth or adolescence based on the child's perceived sex."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000560"},{"@id":"https://homosaurus.org/v3/homoit0000571"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000077"},{"@id":"https://homosaurus.org/v3/homoit0000079"},{"@id":"https://homosaurus.org/v3/homoit0000120"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000118"},{"@id":"https://homosaurus.org/v3/homoit0000266"},{"@id":"https://homosaurus.org/v3/homoit0000288"},{"@id":"https://homosaurus.org/v3/homoit0001465"},{"@id":"https://homosaurus.org/v3/homoit0001648"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/assignedGender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001268","dc:identifier":"homoit0001268","skos:prefLabel":{"@language":"en","@value":"Sex assigned at birth"},"skos:altLabel":[{"@language":"en","@value":"Birth sex"},{"@language":"en","@value":"Birth-assigned sex"},{"@language":"en","@value":"Natal sex"},{"@language":"en","@value":"Sex at birth"},{"@language":"en","@value":"Sex reported at birth"},{"@language":"en","@value":"ASAB "},{"@language":"en","@value":"SAAB"}],"rdfs:comment":{"@language":"en","@value":"The process of determining an individual’s sex relatively shortly after birth, usually documented on official records, such as a birth certificate. Determination is usually based on the appearance of external genitalia but may use other methodologies. In practice, sex assigned at birth is often culturally variable; the term “gender assigned at birth” is often more applicable or accurate."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001648"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000077"},{"@id":"https://homosaurus.org/v3/homoit0000079"},{"@id":"https://homosaurus.org/v3/homoit0001646"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000120"},{"@id":"https://homosaurus.org/v3/homoit0000585"},{"@id":"https://homosaurus.org/v3/homoit0000600"},{"@id":"https://homosaurus.org/v3/homoit0000668"},{"@id":"https://homosaurus.org/v3/homoit0000669"},{"@id":"https://homosaurus.org/v3/homoit0000670"},{"@id":"https://homosaurus.org/v3/homoit0001006"},{"@id":"https://homosaurus.org/v3/homoit0001099"},{"@id":"https://homosaurus.org/v3/homoit0001488"},{"@id":"https://homosaurus.org/v3/homoit0001896"},{"@id":"https://homosaurus.org/v3/homoit0001897"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexAssignedAtBirth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000272","dc:identifier":"homoit0000272","skos:prefLabel":{"@language":"en","@value":"Cisgender women"},"rdfs:comment":{"@language":"en","@value":"Women whose gender identity matches the sex or gender they were assigned at birth. "},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000271"},{"@id":"https://homosaurus.org/v3/homoit0001509"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000077"},{"@id":"https://homosaurus.org/v3/homoit0001925"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000271"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cisgenderWomen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001643","dc:identifier":"homoit0001643","skos:prefLabel":{"@language":"en","@value":"Trans men"},"skos:altLabel":[{"@language":"en","@value":"Transgender men"},{"@language":"en","@value":"Transmen"},{"@language":"en","@value":"Trans-men"}],"rdfs:comment":{"@language":"en","@value":"Men whose gender assigned at birth was not male. Do not use for intersex people unless the intersex person identifies as a trans man."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001008"},{"@id":"https://homosaurus.org/v3/homoit0001378"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000436"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000077"},{"@id":"https://homosaurus.org/v3/homoit0000114"},{"@id":"https://homosaurus.org/v3/homoit0001362"},{"@id":"https://homosaurus.org/v3/homoit0001820"},{"@id":"https://homosaurus.org/v3/homoit0002061"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2018002395"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transMen"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000079","dc:identifier":"homoit0000079","skos:prefLabel":{"@language":"en","@value":"Assigned male at birth"},"skos:altLabel":[{"@language":"en","@value":"AMAB"},{"@language":"en","@value":"Assigned M at birth"},{"@language":"en","@value":"Designated male at birth"},{"@language":"en","@value":"DMAB"},{"@language":"en","@value":"Male assigned at birth"},{"@language":"en","@value":"MAAB"}],"rdfs:comment":{"@language":"en","@value":"The assignment of a male gender marker or a male sex designation shortly after birth.\r\n"},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000078"},{"@id":"https://homosaurus.org/v3/homoit0001268"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000270"},{"@id":"https://homosaurus.org/v3/homoit0001642"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/assignedMaleAtBirth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000120","dc:identifier":"homoit0000120","skos:prefLabel":{"@language":"en","@value":"Gender assigned at birth"},"skos:altLabel":[{"@language":"en","@value":"Birth gender"},{"@language":"en","@value":"Natal gender"},{"@language":"en","@value":"GAAB"},{"@language":"en","@value":"Assigned gender at birth"},{"@language":"en","@value":"AGAB"},{"@language":"en","@value":"Designated gender at birth"},{"@language":"en","@value":"DGAB"},{"@language":"en","@value":"Gender at birth"}],"rdfs:comment":{"@language":"en","@value":"The legal gender marker recorded in birth-related certifications and registries. Often but not always used synonymously with “sex assigned at birth.\" Also used in reference to the gendered roles and expectations associated with said gender marker."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000078"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000118"},{"@id":"https://homosaurus.org/v3/homoit0000119"},{"@id":"https://homosaurus.org/v3/homoit0000271"},{"@id":"https://homosaurus.org/v3/homoit0000567"},{"@id":"https://homosaurus.org/v3/homoit0000573"},{"@id":"https://homosaurus.org/v3/homoit0001268"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0002256"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderAssignedAtBirth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-28"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000118","dc:identifier":"homoit0000118","skos:prefLabel":{"@language":"en","@value":"Birth certificate amendments"},"rdfs:comment":{"@language":"en","@value":"Formal changes to an individual's birth certificate, typically to reflect a change to the individual's legal name or gender or sex marker."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000119"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000078"},{"@i