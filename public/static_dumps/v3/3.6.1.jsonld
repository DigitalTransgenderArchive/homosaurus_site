18"},{"@id":"https://homosaurus.org/v3/homoit0001759"},{"@id":"https://homosaurus.org/v3/homoit0001763"},{"@id":"https://homosaurus.org/v3/homoit0002745"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2021-11-23"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002583","dc:identifier":"homoit0002583","skos:prefLabel":{"@language":"en","@value":"Queerspawn "},"rdfs:comment":{"@language":"en","@value":"People with one or more queer parent or caregiver, usually for self-identification. Queerspawn is believed to have been coined in 1995 or 1996 by Stefan Lynch for use in zine published by COLAGE, a U.S. based organization dedicated to supporting people with one or more LGBTQ+ caregiver."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000260"},{"@id":"https://homosaurus.org/v3/homoit0001317"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000262"},{"@id":"https://homosaurus.org/v3/homoit0001176"},{"@id":"https://homosaurus.org/v3/homoit0001194"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-25"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002584","dc:identifier":"homoit0002584","skos:prefLabel":{"@language":"en","@value":"Bothies"},"rdfs:comment":{"@language":"en","@value":"People who have two or more LGBTQ+ parents or caregivers. Includes individuals born to or adopted by people in a heterosexual relationship who later came out as LGBTQ+, as well as individuals born to or adopted by LGBTQ+ people who came together to create their own families, such as lesbian couples who choose to conceive with friends who are gay men. For use in a Canadian and United States context."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000260"},{"@id":"https://homosaurus.org/v3/homoit0001317"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000420"},{"@id":"https://homosaurus.org/v3/homoit0001075"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-25"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002585","dc:identifier":"homoit0002585","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ children of LGBTQ+ parents"},"skos:altLabel":{"@language":"en","@value":"Second generation (LGBTQ+ families)"},"rdfs:comment":{"@language":"en","@value":"Term used to describe people who are LGBTQ+ and have at least one LGBTQ+ parent or caregiver."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000260"},{"@id":"https://homosaurus.org/v3/homoit0000915"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000420"},{"@id":"https://homosaurus.org/v3/homoit0000752"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002586","dc:identifier":"homoit0002586","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ family generations"},"rdfs:comment":{"@language":"en","@value":"Refers to families with LGBTQ+ individuals in multiple generations."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000420"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000260"},{"@id":"https://homosaurus.org/v3/homoit0001075"},{"@id":"https://homosaurus.org/v3/homoit0001430"},{"@id":"https://homosaurus.org/v3/homoit0002358"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000420