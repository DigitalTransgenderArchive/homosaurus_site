22-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-22"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002363","dc:identifier":"homoit0002363","skos:prefLabel":{"@language":"en","@value":"Gay children"},"skos:altLabel":{"@language":"en","@value":"Gay kids"},"rdfs:comment":{"@language":"en","@value":"Gay people who have not yet reached the age of adolescence."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000256"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000479"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-22"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002699","dc:identifier":"homoit0002699","skos:prefLabel":{"@language":"en","@value":"Gender dysphoria in children"},"rdfs:comment":{"@language":"en","@value":"A psychological diagnosis (replacing the outdated and offensive \"gender identity disorder\") used to describe the sense of unease or dissatisfaction an individual feels as a result of incongruence between their gender identity and their assigned gender, gender expression, and/or the way their gender is perceived by others. This term is also used colloquially by individuals to describe the discomfort and distress they experience as a result of this incongruence. Though gender dysphoria is often associated with trans people, people of any identity may experience gender dysphoria when they do not feel \"right\" in their body or the way their gender is being expressed. Use this particular term for works about children who experience or have experienced gender dysphoria."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000567"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000256"},{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0000571"},{"@id":"https://homosaurus.org/v3/homoit0002256"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000567"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001330","dc:identifier":"homoit0001330","skos:prefLabel":{"@language":"en","@value":"Sons of bisexual people"},"rdfs:comment":{"@language":"en","@value":"Sons who have one or more bisexual parent. For sons who are themselves bisexual, use the term \"Bisexual sons.\""},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000257"},{"@id":"https://homosaurus.org/v3/homoit0002355"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sonsOfBisexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000258","dc:identifier":"homoit0000258","skos:prefLabel":{"@language":"en","@value":"Children of gay men"},"rdfs:comment":{"@language":"en","@value":"Children who have one or more gay father."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000260"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001331"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000491"},{"@id":"https://homosaurus.org/v3/homoit0000492"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85023551"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/childrenOfGayMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@