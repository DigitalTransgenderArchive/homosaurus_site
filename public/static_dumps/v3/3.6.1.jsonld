.org/v2/LGBTQEthnicGroups"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000498","dc:identifier":"homoit0000498","skos:prefLabel":{"@language":"en","@value":"Latino/a/x gay men"},"skos:altLabel":[{"@language":"en","@value":"Gay Latine"},{"@language":"en","@value":"Gay Latinos"},{"@language":"en","@value":"Gay Latinx"},{"@language":"en","@value":"Latine gay men"},{"@language":"en","@value":"Latino gay men"},{"@language":"en","@value":"Latinx gay men"}],"rdfs:comment":{"@language":"en","@value":"Latin American men who are gay; only use to describe individuals who self-identify as Latino, Latina, or Latinx. Do not conflate with Chicano/a/x or Hispanic."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000253"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayLatinos"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000747","dc:identifier":"homoit0000747","skos:prefLabel":{"@language":"en","@value":"Latino/a/x lesbians"},"skos:altLabel":[{"@language":"en","@value":"Latina lesbians"},{"@language":"en","@value":"Latine lesbians"},{"@language":"en","@value":"Latino lesbians"},{"@language":"en","@value":"Latinx lesbians"},{"@language":"en","@value":"Lesbian Latinas"},{"@language":"en","@value":"Lesbian Latine"},{"@language":"en","@value":"Lesbian Latinos"}],"rdfs:comment":{"@language":"en","@value":"Latin American people who are lesbians; only use to describe individuals who self-identify as Latino, Latina, or Latinx. Do not conflate with Chicano/a/x or Hispanic."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000253"},"skos:ha