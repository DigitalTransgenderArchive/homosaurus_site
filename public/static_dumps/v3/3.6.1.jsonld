,"@value":"Chest wall reconstruction"},"rdfs:comment":{"@language":"en","@value":"Reconstruction of the chest, typically following a mastectomy, to give the chest a more masculine appearance."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001840"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001465"},{"@id":"https://homosaurus.org/v3/homoit0001631"},{"@id":"https://homosaurus.org/v3/homoit0003118"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001849","dc:identifier":"homoit0001849","skos:prefLabel":{"@language":"en","@value":"Tracheal shave"},"skos:altLabel":[{"@language":"en","@value":"Adam's apple reduction"},{"@language":"en","@value":"Chondrolaryngoplasty"},{"@language":"en","@value":"TCR"},{"@language":"en","@value":"Thyroid cartilage reduction"},{"@language":"en","@value":"Trache shave"},{"@language":"en","@value":"Trachea shave"}],"rdfs:comment":{"@language":"en","@value":"A surgery in which the laryngeal prominence, colloquially referred to as the Adam's apple, is reduced in size, often as part of facial feminization surgery for transfeminine people. Cisgender men and cisgender women may also undergo tracheal shaves if they feel their laryngeal prominence is too prominent."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001839"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001465"},{"@id":"https://homosaurus.org/v3/homoit0001837"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-15"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002212","dc:identifier":"homoit0002212","skos:prefLabel":{"@language":"en","@value":"Transphobia in fandom"},"rdfs:comment":{"@language":"en","@value":"Issues and discussions about the presence of transphobia in fan spaces and works."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001467"},{"@id":"https://homosaurus.org/v3/homoit0002171"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0002181"},{"@id":"https://homosaurus.org/v3/homoit0002194"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002593","dc:identifier":"homoit0002593","skos:prefLabel":{"@language":"en","@value":"Internalized transphobia"},"rdfs:comment":{"@language":"en","@value":"The phenomenon in which transgender people internalize or adopt transphobic beliefs (i.e., negative perceptions of and intolerance toward transgender people and trans identities) as a result of being raised or socialized within a transphobic environment or culture."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001467"},{"@id":"https://homosaurus.org/v3/homoit0002590"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0003095"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001750","dc:identifier":"homoit0001750","skos:prefLabel":{"@language":"en","@value":"Two-Spirit authors"},"skos:altLabel":[{"@language":"en","@value":"2S authors"},{"@language":"en","@value":"2S writers"},{"@language":"en","@value":"Two Spirit authors"},{"@language":"en","@value":"Two Spirit writers"},{"@language":"en","@value":"Two Spirited authors"},{"@lang