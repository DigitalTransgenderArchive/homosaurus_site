al sports players who self-identify as transgender."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001929"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0003510"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2011001968"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-03"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001934","dc:identifier":"homoit0001934","skos:prefLabel":{"@language":"en","@value":"Queer athletes"},"skos:altLabel":[{"@language":"en","@value":"Queer sports players"},{"@language":"en","@value":"Queer sportspeople"},{"@language":"en","@value":"Queer sportspersons"}],"rdfs:comment":{"@language":"en","@value":"Professional or recreational sports players who self-identify as queer."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001929"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001935","dc:identifier":"homoit0001935","skos:prefLabel":{"@language":"en","@value":"Intersex athletes"},"skos:altLabel":[{"@language":"en","@value":"Intersex sports players"},{"@language":"en","@value":"Intersex sportspeople"},{"@language":"en","@value":"Intersex sportspersons"}],"rdfs:comment":{"@language":"en","@value":"Professional or amateur sports players who are intersex."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001929"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003443","dc:identifier":"homoit0003443","skos:prefLabel":{"@language":"en","@value":"Non-binary athletes"},"skos:altLabel":[{"@language":"en","@value":"Non-binary sports players"},{"@language":"en","@value":"Non-binary sportspeople"},{"@language":"en","@value":"Non-binary sportspersons"},{"@language":"en","@value":"Nonbinary athletes"},{"@language":"en","@value":"Nonbinary sports players"},{"@language":"en","@value":"Nonbinary sportspeople"},{"@language":"en","@value":"Nonbinary sportspersons"}],"rdfs:comment":{"@language":"en","@value":"Professional or amateur/recreational sports players who are non-binary."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001929"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003510","dc:identifier":"homoit0003510","skos:prefLabel":{"@language":"en","@value":"Sports bans"},"skos:altLabel":{"@language":"en","@value":"Sport bans"},"rdfs:comment":{"@language":"en","@value":"Laws or policies instituted to prevent trans and non-binary individuals from participating in gendered sports leagues or competitions, typically to force players to compete as their sex assigned at birth rather than as their gender. This ranges from criminalizing schools and programs that allow trans and non-binary youth participation to banning players, particularly trans women, from competing in gendered leagues or competitions."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0003499"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001933"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@t