3/homoit0001267"},{"@id":"https://homosaurus.org/v3/homoit0001299"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0003052"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000404"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-02"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001814","dc:identifier":"homoit0001814","skos:prefLabel":{"@language":"en","@value":"Chasers"},"rdfs:comment":{"@language":"en","@value":"Individuals who express fetishistic interest in and pursue sexual encounters with others based solely on their affiliation with a (typically marginalized) group that the chaser does not belong to. Often coupled with other terms to identify the type of chaser."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000442"},{"@id":"https://homosaurus.org/v3/homoit0001300"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000404"},"dc:issued":{"@type":"xsd:date","@value":"2022-01-24"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003709","dc:identifier":"homoit0003709","skos:prefLabel":{"@language":"en","@value":"Sensation play"},"skos:altLabel":[{"@language":"en","@value":"Sensual play"},{"@language":"en","@value":"Sensory play"}],"rdfs:comment":{"@language":"en","@value":"The act of engaging one's or one's partner(s) senses in various ways to heighten erotic pleasure."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000442"},{"@id":"https://homosaurus.org/v3/homoit0001299"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000404"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-23"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaur