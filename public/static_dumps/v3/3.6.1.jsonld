ugAbuse"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000379","dc:identifier":"homoit0000379","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ people who use substances"},"skos:altLabel":[{"@language":"en","@value":"Drug users (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ people who drink"},{"@language":"en","@value":"LGBTQ+ people who use drugs"},{"@language":"en","@value":"Substance users (LGBTQ)"}],"rdfs:comment":{"@language":"en","@value":"Umbrella term for LGBTQ+ people who use substances (that are typically deemed harmful or are subject to legal restriction, such as drugs or alcohol) for any reason. Apply more specific terms if possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000915"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001235"},{"@id":"https://homosaurus.org/v3/homoit0001540"},{"@id":"https://homosaurus.org/v3/homoit0001550"},{"@id":"https://homosaurus.org/v3/homoit0002229"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/drugUsers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001540","dc:identifier":"homoit0001540","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ people with alcohol use disorders"},"skos:altLabel":[{"@language":"en","@value":"Alcoholics (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ alcoholics"}],"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who have been diagnosed with or regard themselves as having an alcohol use disorder, a medical condition that involves a pattern of alcohol use that is difficult to control, negatively impacts the individual's life, and results in withdrawal symptoms upon cessation. Only use to refer to individuals who describe themselves as having an alcohol use disorder. Follow the individual's preference for \"use disorder\" or \"addiction\" whenever possible."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000379"},{"@id":"https://homosaurus.org/v3/homoit0001550"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001549"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQAlcoholics"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-09"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001550","dc:identifier":"homoit0001550","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ people with addictions"},"skos:altLabel":{"@language":"en","@value":"LGBTQ people with addictions"},"rdfs:comment":{"@language":"en","@value":"Umbrella term for LGBTQ+ people experiencing addictions, dependencies, or use disorders of some kind. Only use to refer to individuals who describe themselves as having addictions. Apply more specific terms if possible."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000379"},{"@id":"https://homosaurus.org/v3/homoit0000380"},{"@id":"https://homosaurus.org/v3/homoit0000915"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001283"},{"@id":"https://homosaurus.org/v3/homoit0001540"},{"@id":"https://homosaurus.org/v3/homoit0002226"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPeopleWithAddictions"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002229","dc:identifier":"homoit0002229","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ people who use substances for medical purposes"},"skos:altLabel":{"@language":"en","@value":"People who use substances for medical purposes (LGBTQ)"},"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who use substances (that are typically deemed harmful or are subject to legal restriction, such as drugs or alcohol) in order to manage pain and other symptoms related to a medical condition or disability."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000379"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000380"},{"@id":"https://homosaurus.org/v3/homoit0001854"},{"@id":"https://homosaurus.org/v3/homoit0001879"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-19"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001125","dc:identifier":"homoit0001125","skos:prefLabel":{"@language":"en","@value":"Poppers"},"skos:altLabel":{"@language":"en","@value":"Tape head cleaner"},"rdfs:comment":{"@language":"en","@value":"A slang term commonly used in LGBTQ+ subcultures to describe alkyl nitrites, a class of drug that produces a high when inhaled. Poppers are often associated with gay nightlife because they can be used to facilitate anal sex by relaxining the anal muscles."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001317"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000380"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001317"},"dc:replaces":{"@id":"http://homosaurus.org/v2/poppers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-25"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001549","dc:identifier":"homoit0001549","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ people in recovery"},"skos:altLabel":{"@language":"en","@value":"LGBTQ people in recovery"},"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people currently in recovery from use disorders, conditions, or addictions. Follow the individual's preference for \"recovery\" or \"sobriety\" whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000915"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000380"},{"@id":"https://homosaurus.org/v3/homoit0001540"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPeopleInRecovery"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000381","dc:identifier":"homoit0000381","skos:prefLabel":{"@language":"en","@value":"Dutch boys"},"skos:altLabel":{"@language":"en","@value":"Lesbros"},"rdfs:comment":{"@language":"en","@value":"Slang for heterosexual men who are friends with lesbians and socialize in lesbian spaces."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000626"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000416"},{"@id":"https://homosaurus.org/v3/homoit0000455"},{"@id":"https://homosaurus.org/v3/homoit0000598"},{"@id":"https://homosaurus.org/v3/homoit0001133"},{"@id":"https://homosaurus.org/v3/homoit0001788"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000627"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dutchBoys"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000626","dc:identifier":"homoit0000626","skos:prefLabel":{"@language":"en","@value":"Heterosexual men"},"skos:altLabel":{"@language":"en","@value":"Straight men"},"rdfs:comment":{"@language":"en","@value":"Men who identify as heterosexual, or straight."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000627"},{"@id":"https://homosaurus.org/v3/homoit0001008"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000381"},{"@id":"https://homosaurus.org/v3/homoit0000417"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93003542"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000627"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexualMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000416","dc:identifier":"homoit0000416","skos:prefLabel":{"@language":"en","@value":"Fag hags"},"rdfs:comment":{"@language":"en","@value":"Slang for heterosexual women who are friends with gay men and socialize in gay spaces."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000629"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000381"},{"@id":"https://homosaurus.org/v3/homoit0000455"},{"@id":"https://homosaurus.org/v3/homoit0000598"},{"@id":"https://homosaurus.org/v3/homoit0001133"},{"@id":"https://homosaurus.org/v3/homoit0001788"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000627"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fagHags"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001831","dc:identifier":"homoit0001831","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ culture"},"rdfs:comment":{"@language":"en","@value":"Cultural experiences shared by members of LGBTQ+ communities or products of LGBTQ+ culture (e.g., art and media created by and for LGBTQ+ culture, activism focused on LGBTQ+ issues, slang commonly used in LGBTQ+ communities, etc.). Use a more specific term if possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001345"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000382"},{"@id":"https://homosaurus.org/v3/homoit0000487"},{"@id":"https://homosaurus.org/v3/homoit0000816"},{"@id":"https://homosaurus.org/v3/homoit0000972"},{"@id":"https://homosaurus.org/v3/homoit0001406"},{"@id":"https://homosaurus.org/v3/homoit0001832"},{"@id":"https://homosaurus.org/v3/homoit0001833"},{"@id":"https://homosaurus.org/v3/homoit0002788"},{"@id":"https://homosaurus.org/v3/homoit0002970"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001755"},{"@id":"https://homosaurus.org/v3/homoit0003698"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000385","dc:identifier":"homoit0000385","skos:prefLabel":{"@language":"en","@value":"Dykes on bikes"},"rdfs:comment":{"@language":"en","@value":"A chartered motorcycle club with many loosely affiliated chapters that are comprised of lesbian members who identify as dykes; known for their participation in gay pride events."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000382"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000906"},{"@id":"https://homosaurus.org/v3/homoit0003104"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dykesOnBikes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000730","dc:identifier":"homoit0000730","skos:prefLabel":{"@language":"en","@value":"Lesbian choruses"},"skos:altLabel":{"@language":"en","@value":"Lesbian choirs"},"rdfs:comment":{"@language":"en","@value":"Organized groups of lesbians who sing together."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000382"},{"@id":"https://homosaurus.org/v3/homoit0000833"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000482"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianChoruses"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000755","dc:identifier":"homoit0000755","skos:prefLabel":{"@language":"en","@value":"Women's music"},"skos:altLabel":[{"@language":"en","@value":"Lesbian music"},{"@language":"en","@value":"Wimmin's music"},{"@language":"en","@value":"Women-identified music"},{"@language":"en","@value":"Womyn's music"}],"rdfs:comment":{"@language":"en","@value":"Genre of music by women, for women, and about women that emerged in the 1960s and 1970s as a form of musical expression of the second-wave feminist movement."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000382"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001515"},{"@id":"https://homosaurus.org/v3/homoit0003166"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93005222"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womensMusic"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001832","dc:identifier":"homoit0001832","skos:prefLabel":{"@language":"en","@value":"Queer culture"},"rdfs:comment":{"@language":"en","@value":"Cultural experiences shared by members of queer communities or products of queer culture (e.g., art and media created by and for queer people, activism focused on queer issues, slang commonly used in queer communities, etc.)."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001831"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002588"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000382"},{"@id":"https://homosaurus.org/v3/homoit0000487"},{"@id":"https://homosaurus.org/v3/homoit0001406"},{"@id":"https://homosaurus.org/v3/homoit0001833"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001833","dc:identifier":"homoit0001833","skos:prefLabel":{"@language":"en","@value":"Bisexual culture"},"rdfs:comment":{"@language":"en","@value":"Use to describe cultural experiences shared by members of bisexual communities or products of bisexual culture (e.g., art and media created by and for bisexual people, activism focused on bisexual issues, slang commonly used in bisexual communities, etc.)."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001831"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000382"},{"@id":"https://homosaurus.org/v3/homoit0000487"},{"@id":"https://homosaurus.org/v3/homoit0001406"},{"@id":"https://homosaurus.org/v3/homoit0001832"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000383","dc:identifier":"homoit0000383","skos:prefLabel":{"@language":"en","@value":"Dyke marches"},"rdfs:comment":{"@language":"en","@value":"Marches, rallies, and other public gatherings focused on lesbian visibility, rights, and issues. This term should only be used to describe marches explicitly for dykes or marches centered on the dyke identity and politics. Otherwise, use the more general term \"Lesbian pride.\""},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0003651"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000767"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000861"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dykeMarches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003651","dc:identifier":"homoit0003651","skos:prefLabel":{"@language":"en","@value":"Pride events"},"skos:altLabel":{"@language":"en","@value":"LGBTQ+ pride events"},"rdfs:comment":{"@language":"en","@value":"Events that recognize and celebrate LGBTQ+ people and culture, thereby affirming the visibility, dignity, and diversity of LGBTQ+ communities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000861"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001379"},{"@id":"https://homosaurus.org/v3/homoit0000383"},{"@id":"https://homosaurus.org/v3/homoit0003652"},{"@id":"https://homosaurus.org/v3/homoit0003654"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002386"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2010013029"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000861"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000767","dc:identifier":"homoit0000767","skos:prefLabel":{"@language":"en","@value":"Lesbian pride"},"rdfs:comment":{"@language":"en","@value":"The recognition and celebration of lesbians and lesbian culture, thereby affirming the visibility, dignity, and diversity of lesbian communities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0003653"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0003653"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianPride"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001559","dc:identifier":"homoit0001559","skos:prefLabel":{"@language":"en","@value":"Reclaimed terms"},"rdfs:comment":{"@language":"en","@value":"Terms that have been or are currently used in derogatory ways but have been reclaimed by certain groups or in certain circumstances."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001317"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000384"},{"@id":"https://homosaurus.org/v3/homoit0000418"},{"@id":"https://homosaurus.org/v3/homoit0001195"},{"@id":"https://homosaurus.org/v3/homoit0001891"},{"@id":"https://homosaurus.org/v3/homoit0002230"},{"@id":"https://homosaurus.org/v3/homoit0002577"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001208"},{"@id":"https://homosaurus.org/v3/homoit0001560"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001317"},"dc:replaces":{"@id":"http://homosaurus.org/v2/reclaimedTerms"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-25"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003719","dc:identifier":"homoit0003719","skos:prefLabel":{"@language":"en","@value":"Dyke bars"},"rdfs:comment":{"@language":"en","@value":"Drinking establishments that primarily cater to dykes. For establishments that cater to lesbians more bro