s:prefLabel":{"@language":"en","@value":"Metropolitan Community Church"},"skos:altLabel":{"@language":"en","@value":"MCC"},"rdfs:comment":{"@language":"en","@value":"Christian church founded in 1968 by Troy Perry as a welcoming spiritual gathering place for LGBT Christians; MCC is now an international denomination"},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000530"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001137"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000530"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000530"},"dc:replaces":{"@id":"http://homosaurus.org/v2/metropolitanCommunityChurch"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003223","dc:identifier":"homoit0003223","skos:prefLabel":{"@language":"en","@value":"Pregnant men"},"rdfs:comment":{"@language":"en","@value":"Pregnant people who are trans or intersex men. For the fandom trope in which cisgender men can become pregnant, use the term \"Mpreg.\""},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001008"},{"@id":"https://homosaurus.org/v3/homoit0003364"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2004009893"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-05-24"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002182","dc:identifier":"homoit0002182","skos:prefLabel":{"@language":"en","@value":"Men in fandom"},"rdfs:comment":{"@language":"en","@value":"The participation and inclusion of men in fan communities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002171"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002170"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001008"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001010","dc:identifier":"homoit0001010","skos:prefLabel":{"@language":"en","@value":"Men's movement"},"rdfs:comment":{"@language":"en","@value":"Movement that began in the 1960s and 1970s (primarily in the United States, United Kingdom, and Australia) in response to the women's movement. Consists of groups and organizations of men and their allies working to address gender issues and their impact on men. Different men's movement groups vary significantly in how they frame their relationship to the women's movement and society at large. Not to be confused with the men's or father's rights movement, which focuses on perceived inequalities faced by men and seeks to maintain patriarchal values."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001322"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh92002382"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mensMovement"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001135","dc:identifier":"homoit0001135","skos:prefLabel":{"@language":"en","@value":"Pronouns"},"skos:altLabel":{"@language":"en","@value":"Personal pronouns"},"rdfs:comment":{"@language":"en","@value":"Words used in place of a noun. Typically used in the context of \"personal pronouns,\" or pronouns used to describe people (e.g., she, he, they, ze)."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001673"}