type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001072","dc:identifier":"homoit0001072","skos:prefLabel":{"@language":"en","@value":"Pangender people"},"rdfs:comment":{"@language":"en","@value":"People who identify as multiple or all genders."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000322"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001817"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001071"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pangenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001147","dc:identifier":"homoit0001147","skos:prefLabel":{"@language":"qu","@value":"Quariwarmi"},"rdfs:comment":{"@language":"en","@value":"North American Inca term for people assigned male at birth who fulfill a third gender role that is often spiritual in nature."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001480"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/quariwarmi"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001253","dc:identifier":"homoit0001253","skos:prefLabel":{"@language":"km","@value":"Sak veng"},"rdfs:comment":{"@language":"en","@value":"Term used in Cambodia for people assigned male at birth who identify as women; translates to \"long hairs.\""},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000695"},{"@id":"https://homosaurus.org/v3/homoit0001338"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sakVeng"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001256","dc:identifier":"homoit0001256","skos:prefLabel":{"@language":"he","@value":"Saris"},"rdfs:comment":{"@language":"en","@value":"In Jewish culture, this term is used to refer to individuals who were assigned male at birth but later developed feminine characteristics.."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/saris"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001263","dc:identifier":"homoit0001263","skos:prefLabel":{"@language":"egy","@value":"Sekhet"},"skos:altLabel":{"@language":"egy","@value":"Sht"},"rdfs:comment":{"@language":"en","@value":"Egyptian term that refers to a range of people of non-normative gender and sexual identities, including gay people, eunuchs, trans people, etc. Only use to describe people who self-identify as sekhet. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sekhet"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001264","dc:identifier":"homoit0001264","skos:prefLabel":{"@language":"mg","@value":"Sekrata"},"rdfs:comment":{"@language":"en","@value":"In Madagascar, this term refers to people of a third gender who were assigned male at birth and present feminine characteristics."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sekrata"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001309","dc:identifier":"homoit0001309","skos:prefLabel":{"@language":"hil","@value":"Shiv-Shakthis"},"rdfs:comment":{"@language":"en","@value":"Term used in the Andhra Pradesh region of India to describe transgender people who are considered to be married to the gods (particularly Shiva). They often serve as astrologers and spiritual healers and their community is guarded by gurus who induct disciples and train them."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/shivShakthis"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001316","dc:identifier":"homoit0001316","skos:prefLabel":{"@language":"ru","@value":"Skoptsy"},"rdfs:comment":{"@language":"en","@value":"A sect within the larger Spiritual Christianity movement in the Russian Empire that emerged in the 18th century. This sect is most commonly known for conducting castrations and mastectomies in order to suppress sexual desire."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85123228"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/skoptsy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001338","dc:identifier":"homoit0001338","skos:prefLabel":{"@language":"km","@value":"Srey sros"},"rdfs:comment":{"@language":"en","@value":"Term used in Cambodia for people assigned male at birth who identify as women; translates to \"charming girls.\""},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000695"},{"@id":"https://homosaurus.org/v3/homoit0001253"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sreySros"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001368","dc:identifier":"homoit0001368","skos:prefLabel":{"@language":"en","@value":"Third gender"},"rdfs:comment":{"@language":"en","@value":"Social category present in societies that recognize three or more genders."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001369"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/thirdGender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001371","dc:identifier":"homoit0001371","skos:prefLabel":{"@language":"ta","@value":"Thirunambi"},"rdfs:comment":{"@language":"en","@value":"Regional term in Tamil Nadu, India for people assigned female at birth who identify as men."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/thirunambi"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001372","dc:identifier":"homoit0001372","skos:prefLabel":{"@language":"wba","@value":"Tida wena"},"rdfs:comment":{"@language":"en","@value":"In Venezuela's indigenous Warao culture, this term refers to people assigned male at birth who are thought to possess two spirits and often assume a spiritual role; translates to \"twisted women.\""},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001480"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tidaWena"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001373","dc:identifier":"homoit0001373","skos:prefLabel":{"@language":"tha","@value":"Tom"},"rdfs:comment":{"@language":"en","@value":"In Thailand, this term is used to describe people assigned female at birth who exhibit masculine traits, often partnering with feminine dees; similar to a butch in U.S. lesbian culture."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000340"},{"@id":"https://homosaurus.org/v3/homoit0000687"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tom"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001471","dc:identifier":"homoit0001471","skos:prefLabel":{"@language":"es","@value":"Travestis"},"skos:altLabel":{"@language":"es","@value":"Travesti"},"rdfs:comment":{"@language":"en","@value":"Spanish term for people assigned male at birth who have a feminine gender identity; commonly used in South America."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/travesti"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001474","dc:identifier":"homoit0001474","skos:prefLabel":{"@language":"en","@value":"Trigender people"},"rdfs:comment":{"@language":"en","@value":"People whose gender continually moves between or among three gender identities, typically male, female, and a third gender."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000322"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001817"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001473"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/trigenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001475","dc:identifier":"homoit0001475","skos:prefLabel":{"@language":"hil","@value":"Tritiya-Prakriti"},"rdfs:comment":{"@language":"en","@value":"Ancient Hindu term for a third gender that is typically described as fluid and/or continuously transformative."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tritiyaPrakriti"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001477","dc:identifier":"homoit0001477","skos:prefLabel":{"@language":"he","@value":"Tumtum"},"rdfs:comment":{"@language":"en","@value":"Term originating in Rabbinic Judaism to refer to someone with an unknown sex; literally translates to \"hidden.\" Used historically to refer to intersex variations where the genitals were covered by skin. Only use for individuals who are Jewish and who self-identify as Tumtum."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tumtum"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001501","dc:identifier":"homoit0001501","skos:prefLabel":{"@language":"id","@value":"Waria"},"rdfs:comment":{"@language":"en","@value":"Third gender people in Indonesia who are assigned male at birth but who express femininity and may identify as women."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/waria"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001502","dc:identifier":"homoit0001502","skos:prefLabel":{"@language":"mi","@value":"Whakawāhine"},"skos:altLabel":{"@language":"mi","@value":"Whakawahine"},"rdfs:comment":{"@language":"en","@value":"In Māori culture in New Zealand, this term is used to describe people assigned male at birth who pursue traditionally female roles."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000322"},{"@id":"https://homosaurus.org/v3/homoit0002653"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001499"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/whakawahine"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001506","dc:identifier":"homoit0001506","skos:prefLabel":{"@language":"lkt","@value":"Winkté"},"skos:altLabel":{"@language":"en","@value":"Winkte"},"rdfs:comment":{"@language":"en","@value":"North American Lakota word referring to people assigned male at birth who adopt feminine roles; translates to \"to be like a woman.\""},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001480"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/winkte"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001517","dc:identifier":"homoit0001517","skos:prefLabel":{"@language":"ar","@value":"Khaniths"},"skos:altLabel":[{"@language":"ar","@value":"Khanith"},{"@language":"ar","@value":"Xanith"},{"@language":"ar","@value":"Xaniths"}],"rdfs:comment":{"@language":"en","@value":"Arabic word used in Oman for people who assigned male at birth who adopt feminine mannerisms and/or roles."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/xanith"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001518","dc:identifier":"homoit0001518","skos:prefLabel":{"@language":"ja","@value":"X-jendā"},"rdfs:comment":{"@language":"en","@value":"Japanese term for people who do not fit within the categories of man or woman; includes individuals born intersex, female, or male, and is often abbreviated using FTX, MTX, or XTX to describe individuals' transitions; some definitions equate the term to genderqueer or beyond the binary identities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000457"},{"@id":"https://homosaurus.org/v3/homoit0001027"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/XJenda"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001519","dc:identifier":"homoit0001519","skos:prefLabel":{"@language":"zh","@value":"Yīnyángrén"},"skos:altLabel":[{"@language":"zh","@value":"Jiānxìngrén"},{"@language":"zh","@value":"Yin-yang ren"},{"@language":"zh","@value":"Yinyang ren"},{"@language":"zh","@value":"Yinyangren"}],"rdfs:comment":{"@language":"en","@value":"Chinese word for individuals who are both female (yin) and male (yang)."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/yinyangRen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001523","dc:identifier":"homoit0001523","skos:prefLabel":{"@language":"hil","@value":"Zenanas"},"rdfs:comment":{"@language":"en","@value":"In northern India and Pakistan, this term is used to refer to effeminate people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/zenanas"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002286","dc:identifier":"homoit0002286","skos:prefLabel":{"@language":"mzk","@value":"Yan daudu"},"rdfs:comment":{"@language":"en","@value":"Nigerian term that directly translates to \"feminine men\" but cannot be easily understood through Euro-American understandings of gender. The term has been used to describe people who may identify variously as feminine men, gay men, both male and female (or third gender), and/or trans. While some people self-identify as yan daudu, others consider the term a slur. Only use to describe individuals who self-identify as yan daudu."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-10"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosau