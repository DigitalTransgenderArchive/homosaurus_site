0001337","skos:prefLabel":{"@language":"en","@value":"Spreader bar"},"rdfs:comment":{"@language":"en","@value":"A type of bondage device consisting of a wooden or metal bar with cuffs at either end that are used to keep an individual's arms or legs apart."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001238"},{"@id":"https://homosaurus.org/v3/homoit0001266"},{"@id":"https://homosaurus.org/v3/homoit0003059"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0003117"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/spreaderBars"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003115","dc:identifier":"homoit0003115","skos:prefLabel":{"@language":"en","@value":"Straitjacket"},"skos:altLabel":{"@language":"en","@value":"Strait-jacket"},"rdfs:comment":{"@language":"en","@value":"A type of jacket used to restrain the upper body."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001238"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001287","dc:identifier":"homoit0001287","skos:prefLabel":[{"@language":"en-us","@value":"Sexual behavior change"},{"@language":"en-gb","@value":"Sexual behaviour change"}],"rdfs:comment":{"@language":"en","@value":"Term used to describe changes in behavior related to safer sexual practices (e.g., condom use, STI testing)."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001239"},{"@id":"https://homosaurus.org/v3/homoit0001251"},{"@id":"https://homosaurus.org/v3/homoit0001300"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001287"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualBehaviourChange"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002165","dc:identifier":"homoit0002165","skos:prefLabel":{"@language":"en","@value":"Furries"},"rdfs:comment":{"@language":"en","@value":"Individuals who are interested in anthropomorphized animals, as well as fiction and artwork featuring anthropomorphized animals. Many furries identify with anthropomorphized animal versions of themselves, which are called fursonas."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002167"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002168"},{"@id":"https://homosaurus.org/v3/homoit0002169"},{"@id":"https://homosaurus.org/v3/homoit0002219"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001241"},{"@id":"https://homosaurus.org/v3/homoit0001242"},{"@id":"https://homosaurus.org/v3/homoit0003082"},{"@id":"https://homosaurus.org/v3/homoit0003123"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2017004178"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002168","dc:identifier":"homoit0002168","skos:prefLabel":{"@language":"en","@value":"Fursonas"},"rdfs:comment":{"@language":"en","@value":"Anthropomorphized animal versions of people. Fursonas, which are created by members of the furry fandom, are not necessarily animals with fur; they can also be reptiles, birds, or fictional animals, for example."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002165"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001241"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002207","dc:identifier":"homoit0002207","skos:prefLabel":{"@language":"en","@value":"Slash roleplay"},"skos:altLabel":{"@language":"en","@value":"Slash role play"},"rdfs:comment":{"@language":"en","@value":"The act of pretending to be and behaving as a character in a sexual or romantic relationship with another character of the same sex or gender, sometimes to generate ideas for fanworks. Typically erotic or pornographic in nature. Historically used for male-male couples only, but is now used more broadly; includes femslash roleplay."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002204"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001241"},{"@id":"https://homosaurus.org/v3/homoit0001242"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001243","dc:identifier":"homoit0001243","skos:prefLabel":{"@language":"en","@value":"Rope play"},"skos:altLabel":{"@language":"en","@value":"Shibari"},"rdfs:comment":{"@language":"en","@value":"Bondage involving the use of rope for sexual stimulation."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001266"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ropePlay"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://hom