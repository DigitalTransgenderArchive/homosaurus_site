ttps://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002694","dc:identifier":"homoit0002694","skos:prefLabel":{"@language":"en","@value":"Two-Spirit people with chronic illnesses"},"skos:altLabel":[{"@language":"en","@value":"2S people with chronic illnesses"},{"@language":"en","@value":"Chronically ill 2S people"},{"@language":"en","@value":"Chronically ill Two Spirit people"},{"@language":"en","@value":"Chronically ill Two Spirited people"},{"@language":"en","@value":"Chronically ill Two-Spirited people"},{"@language":"en","@value":"Two Spirit people with chronic illnesses"},{"@language":"en","@value":"Two Spirited people with chronic illnesses"},{"@language":"en","@value":"Two-Spirited people with chronic illnesses"}],"rdfs:comment":{"@language":"en","@value":"Two-Spirit people who have long-term health conditions that require continued medical attention and/or significantly impact or limit daily life; some but not all people with chronic illnesses consider themselves disabled."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001879"},{"@id":"https://homosaurus.org/v3/homoit0002682"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002694"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002038","dc:identifier":"homoit0002038","skos:prefLabel":{"@language":"en","@value":"Racism"},"rdfs:comment":{"@language":"en","@value":"The belief that groups of human beings possess different inherent behavioral traits that correspond to inherited attributes and can be divided based on the superiority of one race over another. This term also encompasses prejudice, discrimination, and antagonism (whether personal or systematic) directed against other people because of their race and its perceived inferiority."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002194"},{"@id":"https://homosaurus.org/v3/homoit0002257"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001902"},{"@id":"https://homosaurus.org/v3/homoit0001903"},{"@id":"https://homosaurus.org/v3/homoit0001904"},{"@id":"https://homosaurus.org/v3/homoit0002269"},{"@id":"https://homosaurus.org/v3/homoit0002270"},{"@id":"https://homosaurus.org/v3/homoit0002271"},{"@id":"https://homosaurus.org/v3/homoit0002272"},{"@id":"https://homosaurus.org/v3/homoit0003691"},{"@id":"https://homosaurus.org/v3/homoit0003692"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85110266"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002038"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002257","dc:identifier":"homoit0002257","skos:prefLabel":{"@language":"en","@value":"Anti-Blackness"},"skos:altLabel":{"@language":"en","@value":"Anti Blackness"},"rdfs:comment":{"@language":"en","@value":"Term used to acknowledge the particularities of racism as directed toward Black people. Anti-Blackness includes the belief that Black people possess different inherent behavioral traits that correspond to inherited attributes and are inferior to those of other races--particularly white people. Anti-Blackness also encompasses prejudice, discrimination, and antagonism (whether personal or systematic) directed toward Black people because of their race and its perceived inferiority."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002038"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001902"},{"@id":"https://homosaurus.org/v3/homoit0001903"},{"@id":"https://homosaurus.org/v3/homoit0001904"},{"@id":"https://homosaurus.org/v3/homoit0002376"},{"@id":"https://homosaurus.org/v3/homoit0003691"},{"@id":"https://homosaurus.org/v3/homoit0003692"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002038"},"dc:issued":{"@type":"xsd:date","@value":"2022-09-09"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002269","dc:identifier":"homoit0002269","skos:prefLabel":{"@language":"en","@value":"Anti-racism"},"skos:altLabel":{"@language":"en","@value":"Antiracism"},"rdfs:comment":{"@language":"en","@value":"Umbrella term used to describe a range of ideas, policies, and political actions that are intended to actively challenge, reject, or oppose racism and racial oppression (whether personal or systemic), as well as advocate for racial equity."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001902"},{"@id":"https://homosaurus.org/v3/homoit0002038"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007000043"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002269"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-08"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002985","dc:identifier":"homoit0002985","skos:prefLabel":{"@language":"en","@value":"Asexual witches"},"skos:altLabel":{"@language":"en","@value":"Asexual Wiccans"},"rdfs:comment":{"@language":"en","@value":"Asexual practitioners of Wicca or other Pagan religions who self-identify as witches."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001907"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:in