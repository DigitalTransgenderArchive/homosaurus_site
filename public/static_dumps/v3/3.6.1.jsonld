g/v3/homoit0000851"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQActionCampaigns"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000851","dc:identifier":"homoit0000851","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ demonstrations"},"skos:altLabel":[{"@language":"en","@value":"LGBTQ political marches"},{"@language":"en","@value":"LGBTQ protests"},{"@language":"en","@value":"LGBTQ rallies"},{"@language":"en","@value":"LGBTQ demonstrations"}],"rdfs:comment":{"@language":"en","@value":"Action taken by large groups of people in protest of the discrimination of or in support for LGBTQ+ individuals, communities, topics, or rights; typically includes marches and rallies with speakers."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000808"},{"@id":"https://homosaurus.org/v3/homoit0000853"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001905"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000932"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQDemonstrations"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000905","dc:identifier":"homoit0000905","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ motherhood"},"skos:altLabel":[{"@language":"en","@value":"LGBTQ motherhood"},{"@language":"en","@value":"Maternity (LGBTQ)"},{"@language":"en","@value":"Motherhood (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ maternity"}],"rdfs:comment":{"@language":"en","@value":"Motherhood experiences, as experienced by LGBTQ+ people."},"skos:broad