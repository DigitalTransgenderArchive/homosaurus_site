omoit0001171","dc:identifier":"homoit0001171","skos:prefLabel":[{"@language":"en-us","@value":"Queer community centers"},{"@language":"en-gb","@value":"Queer community centres"}],"rdfs:comment":{"@language":"en","@value":"Spaces in which people from queer communities meet for social, education, recreational, or organizing activities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000298"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerCommunityCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001404","dc:identifier":"homoit0001404","skos:prefLabel":[{"@language":"en-us","@value":"Transgender community centers"},{"@language":"en-gb","@value":"Transgender community centres"}],"rdfs:comment":{"@language":"en","@value":"Spaces in which people from transgender communities meet for social, education, recreational, or organizing activities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000298"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001378"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderCommunityCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001512","dc:identifier":"homoit0001512","skos:prefLabel":[{"@language":"en-us","@value":"Women's community centers"},{"@language":"en-gb","@value":"Women's community centres"}],"rdfs:comment":{"@language":"en","@value":"Spaces in which women meet for social, educational, recreational, and organizing activities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000298"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womensCommunityCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002775","dc:identifier":"homoit0002775","skos:prefLabel":[{"@language":"en","@value":"Asexual community centers"},{"@language":"en","@value":"Asexual community centres"}],"rdfs:comment":{"@language":"en","@value":"Spaces in which people from asexual communities meet for social, education, recreational, or organizing activities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000298"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000830"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002968","dc:identifier":"homoit0002968","skos:prefLabel":{"@language":"en","@value":"Intersex community centers"},"skos:altLabel":{"@language":"en","@value":"Intersex community centres"},"rdfs:comment":{"@language":"en","@value":"Spaces in which people from intersex communities meet for social, education, recreational, or organizing activities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000298"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000830"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002689","dc:identifier":"homoit0002689","skos:prefLabel":{"@language":"en","@value":"Two-Spirit community centers"},"skos:altLabel":[{"@language":"en","@value":"2S community centers"},{"@language":"en","@value":"Two Spirit community centers"},{"@language":"en","@value":"Two Spirited community centers"},{"@language":"en","@value":"Two-Spirit community centres"},{"@language":"en","@value":"Two-Spirited community centers"}],"rdfs:comment":{"@language":"en","@value":"Spaces in which people from Two-Spirit communities meet for social, education, recreational, or organizing activities."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000298"},{"@id":"https://homosaurus.org/v3/homoit0001480"},{"@id":"https://homosaurus.org/v3/homoit0001811"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002689"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000299","dc:identifier":"homoit0000299","skos:prefLabel":{"@language":"en","@value":"Condoms"},"skos:altLabel":[{"@language":"en","@value":"Prophylactics"},{"@language":"en","@value":"Rubbers"}],"rdfs:comment":{"@language":"en","@value":"Latex contraceptives used to cover penises during sexual activity for the purposes of preventing STIs and/or pregnancy."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001266"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001251"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85030795"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/condoms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000300","dc:identifier":"homoit0000300","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ Confucianists"},"skos:altLabel":[{"@language":"en","@value":"Confucianists (LGBTQ)"},{"@language":"en","@value":"LGBTQ Confucianists"}],"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who are Confucianists."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000928"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQConfucianists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000301","dc:identifier":"homoit0000301","skos:prefLabel":{"@language":"en","@value":"Congenital adrenal hyperplasia"},"skos:altLabel":{"@language":"en","@value":"CAH"},"rdfs:comment":{"@language":"en","@value":"Congenital adrenal hyperplasia (CAH) is a group of different but related genetic variations that affect the enzymes that allow the adrenal glands to make hormones that regulate the body’s functions. People with CAH do not consistently produce the amount of cortisol or aldosterone they need, but they may naturally produce higher-than-typical levels of androgens such as testosterone to help the body compensate. Someone with CAH can be born with XX or XY chromosomes. People with CAH and XY chromosomes are usually not considered to have a variation in sex characteristics since an increased amount of androgens will not cause the development of any characteristics that are not considered typical for people assigned male at birth. In people with XX chromosomes and CAH, the increase in androgen production can result in genital differences such as a larger-than-typical clitoris, fused labia, and the fusion of the urethra and vaginal canal to form a single opening. They may also develop some characteristics like body and facial hair or increased muscle mass during childhood or puberty."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002827"},{"@id":"https://homosaurus.org/v3/homoit0002869"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85001014"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/congenitalAdrenalHyperplasia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002827","dc:identifier":"homoit0002827","skos:prefLabel":{"@language":"en","@value":"Classical congenital adrenal hyperplasia"},"rdfs:comment":{"@language":"en","@value":"People who have classical congenital adrenal hyperplasia (CAH), a subtype of CAH, have more pronounced issues with cortisol and/or aldosterone production. This variation is likely to be noticed at birth or shortly after."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000301"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002874"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-09-14"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002869","dc:identifier":"homoit0002869","skos:prefLabel":{"@language":"en","@value":"Non-classical congenital adrenal hyperplasia"},"skos:altLabel":{"@language":"en","@value":"Late-onset congenital adrenal hyperplasia"},"rdfs:comment":{"@language":"en","@value":"Non-classical congenital adrenal hyperplasia (CAH), a subtype of CAH, does not usually become apparent until later in childhood, adolescence, or even young adulthood."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000301"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-09-14"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002844","dc:identifier":"homoit0002844","skos:prefLabel":{"@language":"en","@value":"Informed consent"},"rdfs:comment":{"@language":"en","@value":"The practice of weighing all options and considering evidence, alternatives, and potential risks in order to make a truly informed medical decision. Such decisions are best made over a period of time rather than under pressure."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000302"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001004"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000302"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-09-14"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000938","dc:identifier":"homoit0000938","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ sexual abuse"},"skos:altLabel":{"@language":"en","@value":"LGBTQ sexual abuse"},"rdfs:comment":{"@language":"en","@value":"Acts of sexual abuse and violence directed towards LGBTQ+ people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001305"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000302"},{"@id":"https://homosaurus.org/v3/homoit0000855"},{"@id":"https://homosaurus.org/v3/homoit0000959"},{"@id":"https://homosaurus.org/v3/homoit0001351"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001305"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSexualAbuse"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001123","dc:identifier":"homoit0001123","skos:prefLabel":{"@language":"en","@value":"Polyamory"},"rdfs:comment":{"@language":"en","@value":"Practice of engaging in romantic, sexual, or play relationships with more than one person simultaneously, with the knowledge and consent of all parties involved."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001651"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001554"},{"@id":"https://homosaurus.org/v3/homoit0001629"},{"@id":"https://homosaurus.org/v3/homoit0001662"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000302"},{"@id":"https://homosaurus.org/v3/homoit0000603"},{"@id":"https://homosaurus.org/v3/homoit0001124"},{"@id":"https://homosaurus.org/v3/homoit0001295"},{"@id":"https://homosaurus.org/v3/homoit0001558"},{"@id":"https://homosaurus.org/v3/homoit0001645"},{"@id":"https://homosaurus.org/v3/homoit0001649"},{"@id":"https://homosaurus.org/v3/homoit0001657"},{"@id":"https://homosaurus.org/v3/homoit0001661"},{"@id":"https://homosaurus.org/v3/homoit0001663"},{"@id":"https://homosaurus.org/v3/homoit0001664"},{"@id":"https://homosaurus.org/v3/homoit0002255"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/polyamory"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001124","dc:identifier":"homoit0001124","skos:prefLabel":{"@language":"en","@value":"Polygamy"},"rdfs:comment":{"@language":"en","@value":"The practice of engaging in romantic, sexual, or play relationships where the dominant partner has multiple spouses, though these marriages are not always recognized by law or within society."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001081"},{"@id":"https://homosaurus.org/v3/homoit0001302"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000302"},{"@id":"https://homosaurus.org/v3/homoit0000603"},{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001295"},{"@id":"https://homosaurus.org/v3/homoit0002255"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85104627"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001300"},"dc:replaces":{"@id":"http://homosaurus.org/v2/polygamy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-02-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002195","dc:identifier":"homoit0002195","skos:prefLabel":{"@language":"en","@value":"Rape/non-con (Content warning)"},"skos:altLabel":[{"@language":"en","@value":"Non-consensual (Content warning)"},{"@language":"en","@value":"Rape (Content warning)"}],"rdfs:comment":{"@language":"en","@value":"A content warning applied to fanworks to signal the presence of rape, non-consensual sexual encounters, or dubiously consensual sexual encounters."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001807"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000302"},{"@id":"https://homosaurus.org/v3/homoit0000958"},{"@id":"https://homosaurus.org/v3/homoit0000959"},{"@id":"https://homosaurus.org/v3/homoit0001305"},{"@id":"https://homosaurus.org/v3/homoit0001350"},{"@id":"https://homosaurus.org/v3/homoit0001351"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003512","dc:identifier":"homoit0003512","skos:prefLabel":{"@language":"en","@value":"Gender conversion therapy"},"skos:altLabel":[{"@language":"en","@value":"Conversion therapy for gender"},{"@language":"en","@value":"Conversion therapy for trans people"},{"@language":"en","@value":"Conversion therapy for transgender people"},{"@language":"en","@value":"Gender reorientation therapy"},{"@language":"en","@value":"Trans conversion therapy"},{"@language":"en","@value":"Transgender conversion therapy"}],"rdfs:comment":{"@language":"en","@value":"Efforts to change the gender identity of a transgender or non-binary person to meet cisgender norms, typically under the belief that their identity is dangerous and/or the result of mental illness or trauma. The processes involved in conversion therapy include visualization training, spiritual interventions, and other aversion treatments. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000303"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006004076"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000304","dc:identifier":"homoit0000304","skos:prefLabel":{"@language":"en","@value":"Second parent adoption"},"skos:altLabel":{"@language":"en","@value":"Co-parent adoption"},"rdfs:comment":{"@language":"en","@value":"An adoption process by which a legal child-parent relationship is established by granting the “second” parent the same rights as the “first” parent without the “first” or legal parent relinquishing any parental rights. A second or co-parent adoption can be important for LGBTQ+ parents to protect their parental rights as the relationship of the non-biological parent may not be recognized in some jurisdictions without such an adoption."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000809"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000918"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000864"},"dc:replaces":{"@id":"http://homosaurus.org/v2/secondParentAdoption"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-02-17"},"@type":