protestantsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-03-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000928","dc:identifier":"homoit0000928","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ religious people"},"skos:altLabel":{"@language":"en","@value":"LGBTQ+ religions"},"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who belong to a religion or hold religious beliefs. For LGBTQ+ people who hold spiritual beliefs or engage in spiritual practices but do not belong to an organized religion, use the term \"LGBTQ+ spiritual people.\""},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000225"},{"@id":"https://homosaurus.org/v3/homoit0000265"},{"@id":"https://homosaurus.org/v3/homoit0000300"},{"@id":"https://homosaurus.org/v3/homoit0000633"},{"@id":"https://homosaurus.org/v3/homoit0000682"},{"@id":"https://homosaurus.org/v3/homoit0000939"},{"@id":"https://homosaurus.org/v3/homoit0000940"},{"@id":"https://homosaurus.org/v3/homoit0000955"},{"@id":"https://homosaurus.org/v3/homoit0001032"},{"@id":"https://homosaurus.org/v3/homoit0001069"},{"@id":"https://homosaurus.org/v3/homoit0003347"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000082"},{"@id":"https://homosaurus.org/v3/homoit0000948"},{"@id":"https://homosaurus.org/v3/homoit0001218"},{"@id":"https://homosaurus.org/v3/homoit0003609"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQReligions"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000969","dc:identifier":"homoit0000969","skos:prefLabel":{"@language":"en","@value":"Licking"},"rdfs:comment":{"@language":"en","@value":"To touch or pass over with the tongue to moisten or taste; use to describe licking associated in the context of sexual practices or sexual arousal. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000593"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000049"},{"@id":"https://homosaurus.org/v3/homoit0000239"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/licking"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-18"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000593","dc:identifier":"homoit0000593","skos:prefLabel":{"@language":"en","@value":"Oral sex"},"skos:altLabel":[{"@language":"en","@value":"Giving head"},{"@language":"en","@value":"Going down"}],"rdfs:comment":{"@language":"en","@value":"Sexual activities performed using the mouth."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001267"},{"@id":"https://homosaurus.org/v3/homoit0001299"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000206"},{"@id":"https://homosaurus.org/v3/homoit0000212"},{"@id":"https://homosaurus.org/v3/homoit0000239"},{"@id":"https://homosaurus.org/v3/homoit0000691"},{"@id":"https://homosaurus.org/v3/homoit0000969"},{"@id":"https://homosaurus.org/v3/homoit0002578"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000049"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85095239"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/oralSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000050","dc:identifier":"homoit0000050","skos:prefLabel":{"@language":"en","@value":"Anonymous sex"},"rdfs:comment":{"@language":"en","@value":"Sexual encounters between two or more people who do not know one another, typically with no expectation of future communication or interaction."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001299"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000242"},{"@id":"https://homosaurus.org/v3/homoit0000309"},{"@id":"https://homosaurus.org/v3/homoit0000319"},{"@id":"https://homosaurus.org/v3/homoit0000974"},{"@id":"https://homosaurus.org/v3/homoit0001302"},{"@id":"https://homosaurus.org/v3/homoit0001306"},{"@id":"https://homosaurus.org/v3/homoit0001357"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001299"},"dc:replaces":{"@id":"http://homosaurus.org/v2/anonymousSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000242","dc:identifier":"homoit0000242","skos:prefLabel":{"@language":"en","@value":"Casual sex"},"skos:altLabel":{"@language":"en","@value":"Promiscuity"},"rdfs:comment":{"@language":"en","@value":"Intermittent or isolated sexual encounters between two or more people, typically occurring outside of romantic relationships or other forms of commitment, emotional attachment, or familiarity."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001299"},{"@id":"https://homosaurus.org/v3/homoit0001302"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000050"},{"@id":"https://homosaurus.org/v3/homoit0000319"},{"@id":"https://homosaurus.org/v3/homoit0000603"},{"@id":"https://homosaurus.org/v3/homoit0001272"},{"@id":"https://homosaurus.org/v3/homoit0001300"},{"@id":"https://homosaurus.org/v3/homoit0001306"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001299"},"dc:replaces":{"@id":"http://homosaurus.org/v2/casualSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:mo