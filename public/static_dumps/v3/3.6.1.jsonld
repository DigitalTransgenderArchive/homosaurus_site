oit0000208"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-07"},"dc:modified":{"@type":"xsd:date","@value":"2022-11-03"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002334","dc:identifier":"homoit0002334","skos:prefLabel":{"@language":"en","@value":"Black asexual people"},"skos:altLabel":[{"@language":"en","@value":"Asexual Black people"},{"@language":"en","@value":"Black ace people"}],"rdfs:comment":{"@language":"en","@value":"Black people who are asexual. Use only for individuals who self-identity as Black. Follow the individual’s preference for African American or Black whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000208"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002893"},{"@id":"https://homosaurus.org/v3/homoit0002894"},{"@id":"https://homosaurus.org/v3/homoit0002896"},{"@id":"https://homosaurus.org/v3/homoit0002898"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002764","dc:identifier":"homoit0002764","skos:prefLabel":{"@language":"en","@value":"Black intersex people"},"skos:altLabel":{"@language":"en","@value":"Intersex Black people"},"rdfs:comment":{"@language":"en","@value":"Black people who are intersex. Use only for individuals who self-identity as Black. Follow the individual’s preference for African American or Black whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000208"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002957"},{"@id":"https://homosaurus.org/v3/homoit0002958"},{"@id":"https://homosaurus.org/v3/homoit0002959"},{"@id":"https://homosaurus.org/v3/homoit0002960"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003400","dc:identifier":"homoit0003400","skos:prefLabel":{"@language":"en","@value":"Black non-binary people"},"skos:altLabel":[{"@language":"en","@value":"Black nonbinary people"},{"@language":"en","@value":"Non-binary Black people"},{"@language":"en","@value":"Nonbinary Black people"}],"rdfs:comment":{"@language":"en","@value":"Black people who are non-binary. Use only for individuals who self-identity as Black. Follow the individual’s preference for African American or Black whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000208"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-11"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001928","dc:identifier":"homoit0001928","skos:prefLabel":{"@language":"en","@value":"BIPOC"},"skos:altLabel":[{"@language":"en","@value":"Black, Indigenous, and people of color"},{"@language":"en","@value":"Black, Indigenous, and people of colour"}],"rdfs:comment":{"@language":"en","@value":"Acronym primarily used in the United States to describe Black, Indigenous, and people of color as a group, while also centering the specific experiences of Black and Indigenous people."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000208"},{"@id":"https://homosaurus.org/v3/homoit0001101"},{"@id":"https://homosaurus.org/v3/homoit0002273"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001928"},"dc:issued":{"@type":"xsd:date","@value":"2022-04-18"},"dc:modified":{"@type":"xsd:date","@value":"2023-10-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002376","dc:identifier":"homoit0002376","skos:prefLabel":{"@language":"en","@value":"Police harassment of Black LGBTQ+ people"},"rdfs:comment":{"@language":"en","@value":"Any of various forms of inappropriate conduct, illegal actions, or abuses of power undertaken by law enforcement agents or agents of the state against Black LGBTQ+ members of the public. This includes but is not limited to racial, ethnic, and other forms of profiling; unwarranted surveillance, searches, and seizure; selective enforcement; excessive use of force; sexual misconduct; intimidation and witness tampering; falsification of evidence; coerced confessions; false arrests and imprisonment; and bribing or lobbying."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002375"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000208"},{"@id":"https://homosaurus.org/v3/homoit0002257"},{"@id":"https://homosaurus.org/v3/homoit0002397"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000611"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002398","dc:identifier":"homoit0002398","skos:prefLabel":{"@language":"en","@value":"Black Lives Matter movement "},"skos:altLabel":[{"@language":"en","@value":"BLM"},{"@language":"en","@value":"Black Lives Matter"},{"@language":"en","@value":"BlackLivesMatter"},{"@language":"en","@value":"Movement for Black Lives"}],"rdfs:comment":{"@language":"en","@value":"A primarily U.S. American and Canadian decentralized political and social movement advocating for non-violent civil disobedience in protest against incidents of police brutality and all racially motivated violence against Black people. The broader movement and its related organizations typically advocate against police violence towards Black people, as well as for various other policy changes considered to be related to Black liberation."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001322"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002399"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000208"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2016001442"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001322"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002399","dc:identifier":"homoit0002399","skos:prefLabel":{"@language":"en","@value":"Black Trans Lives Matter movement "},"skos:altLabel":[{"@language":"en","@value":"BTLM Movement"},{"@language":"en","@value":"BTLM"}],"rdfs:comment":{"@language":"en","@value":"A part of the Black Lives Matter movement which specifically advocates for Black trans people (especially Black trans women) and fights for racial equity and Black liberation."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002398"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000208"},{"@id":"https://homosaurus.org/v3/homoit0001396"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001322"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000209","dc:identifier":"homoit0000209","skos:prefLabel":{"@language":"en","@value":"Blindfolds"},"rdfs:comment":{"@language":"en","@value":"An accessory used to cover the eyes, traditionally a piece of cloth tied around one’s head to eliminate or limit vision."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001266"},{"@id":"https://homosaurus.org/v3/homoit0003059"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0003146"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2003009027"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/blindfolds"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000210","dc:identifier":"homoit0000210","skos:prefLabel":{"@language":"en","@value":"Blogs"},"rdfs:comment":{"@language":"en","@value":"Websites or webpages, typically run by individuals or small groups, that are written in an informal or conversational style."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001321"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000823"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2003004628"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001321"},"dc:replaces":{"@id":"http://homosaurus.org/v2/blogs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001321","dc:identifier":"homoit0001321","skos:prefLabel":{"@language":"en","@value":"Social media"},"rdfs:comment":{"@language":"en","@value":"Web-based and mobile technologies used to turn communication into interactive dialogues."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000210"},{"@id":"https://homosaurus.org/v3/homoit0000250"},{"@id":"https://homosaurus.org/v3/homoit0000328"},{"@id":"https://homosaurus.org/v3/homoit0000329"},{"@id":"https://homosaurus.org/v3/homoit0000665"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000324"},{"@id":"https://homosaurus.org/v3/homoit0000946"}],"skos:exact