ate","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000343","dc:identifier":"homoit0000343","skos:prefLabel":{"@language":"en","@value":"Demisexuality"},"rdfs:comment":{"@language":"en","@value":"A sexual orientation generally characterized by the lack of sexual attraction to other people unless or until emotional connections have been formed."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001298"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000344"},{"@id":"https://homosaurus.org/v3/homoit0001535"},{"@id":"https://homosaurus.org/v3/homoit0001923"},{"@id":"https://homosaurus.org/v3/homoit0001986"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/demisexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-18"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000344","dc:identifier":"homoit0000344","skos:prefLabel":{"@language":"en","@value":"Demisexual people"},"rdfs:comment":{"@language":"en","@value":"Individuals who do not experience sexual attraction unless they have first formed a strong emotional connection with a person."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001295"},{"@id":"https://homosaurus.org/v3/homoit0001297"},{"@id":"https://homosaurus.org/v3/homoit0001300"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0003036"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000343"},{"@id":"https://homosaurus.org/v3/homoit0001302"},{"@id":"https://homosaurus.org/v3/homoit0001535"},{"@id":"https://homosaurus.org/v3/homoit0001985"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/demisexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001986","dc:identifier":"homoit0001986","skos:prefLabel":{"@language":"en","@value":"Demiromanticism"},"skos:altLabel":[{"@language":"en","@value":"Demi-romantic"},{"@language":"en","@value":"Demiromantic"}],"rdfs:comment":{"@language":"en","@value":"Romantic orientation in which romantic attraction to other people is only experienced after forming emotional bonds."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001828"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000343"},{"@id":"https://homosaurus.org/v3/homoit0001985"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001828"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-18"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003036","dc:identifier":"homoit0003036","skos:prefLabel":{"@language":"en","@value":"Demisexual college students"},"rdfs:comment":{"@language":"en","@value":"Demisexual people who are attending college."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000344"},{"@id":"https://homosaurus.org/v3/homoit0003041"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0003032"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001295"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-05"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001985","dc:identifier":"homoit0001985","skos:prefLabel":{"@language":"en","@value":"Demiromantic people"},"skos:altLabel":{"@language":"en","@value":"Demi-romantic people"},"rdfs:comment":{"@language":"en","@value":"Individuals who experience romantic attraction to other people only after forming emotional bonds."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001829"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000344"},{"@id":"https://homosaurus.org/v3/homoit0001986"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001829"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000345","dc:identifier":"homoit0000345","skos:prefLabel":{"@language":"en","@value":"Denial of sexual orientation"},"rdfs:comment":{"@language":"en","@value":"Refusal to acknowledge or affirm one's own sexual identity, or the sexual identity of another individual."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000391"},{"@id":"https://homosaurus.org/v3/homoit0000699"},{"@id":"https://homosaurus.org/v3/homoit0000936"},{"@id":"https://homosaurus.org/v3/homoit0001298"},{"@id":"https://homosaurus.org/v3/homoit0002590"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/denialOfSexualOrientation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000391","dc:identifier":"homoit0000391","skos:prefLabel":[{"@language":"en-us","@value":"Internalized homophobia"},{"@language":"en-gb","@value":"Internalised homophobia"}],"skos:altLabel":{"@language":"en","@value":"Ego-dystonic homophobia"},"rdfs:comment":{"@language":"en","@value":"This term is often used to describe internalized oppression held by and about LGBTQ+ people in general. It can also describe the more specific phenomenon in which gay men internalize or adopt homophobic beliefs (i.e., negative perceptions of and intolerance toward gay men and homosexuality) as a result of being raised or socialized within a homophobic environment or culture. "},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000646"},{"@id":"https://homosaurus.org/v3/homoit0002590"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0003093"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000345"},{"@id":"https://homosaurus.org/v3/homoit0000392"},{"@id":"https://homosaurus.org/v3/homoit0000699"},{"@id":"https://homosaurus.org/v3/homoit0000936"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005020575"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/internalisedHomophobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000699","dc:identifier":"homoit0000699","skos:prefLabel":{"@language":"en","@value":"Latent homosexuality"},"rdfs:comment":{"@language":"en","@value":"Term coined by Sigmund Freud to describe erotic attraction towards members of the same sex or gender that is not (and may never be) consciously experienced or expressed openly."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000345"},{"@id":"https://homosaurus.org/v3/homoit0000391"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000699"},"dc:replaces":{"@id":"http://homosaurus.org/v2/latentHomosexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000936","dc:identifier":"homoit0000936","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ self-repression"},"skos:altLabel":{"@language":"en","@value":"LGBTQ self-repression"},"rdfs:comment":{"@language":"en","@value":"Restraint or denial of one’s own thoughts, wishes, feelings or identity, as experienced by LGBTQ+ people."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000345"},{"@id":"https://homosaurus.org/v3/homoit0000391"},{"@id":"https://homosaurus.org/v3/homoit0002590"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000936"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSelfRepression"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002590","dc:identifier":"homoit0002590","skos:prefLabel":{"@language":"en","@value":"Internalized oppression"},"rdfs:comment":{"@language":"en","@value":"The phenomenon in which someone in a marginalized group internalizes or adopts oppressive beliefs (i.e., negative perceptions of and intolerance toward any marginalized identities they hold) as a result of being raised or socialized within an oppressive environment or culture."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000391"},{"@id":"https://homosaurus.org/v3/homoit0002591"},{"@id":"https://homosaurus.org/v3/homoit0002592"},{"@id":"https://homosaurus.org/v3/homoit0002593"},{"@id":"https://homosaurus.org/v3/homoit0002594"},{"@id":"https://homosaurus.org/v3/homoit0002595"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000345"},{"@id":"https://homosaurus.org/v3/homoit0000920"},{"@id":"https://homosaurus.org/v3/homoit0000936"},{"@id":"https://homosaurus.org/v3/homoit0003091"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002590"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000346","dc:identifier":"homoit0000346","skos:prefLabel":{"@language":"en","@value":"Dental dams"},"skos:altLabel":{"@language":"en","@value":"Latex barriers"},"rdfs:comment":{"@language":"en","@value":"A square sheet of latex or polyurethane used to create a barrier between the mouth and the vagina or anus during oral sex."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001266"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001251"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85035617"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dentalDams"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000349","dc:identifier":"homoit0000349","skos:prefLabel":{"@language":"en","@value":"Detention of LGBTQ+ people under a hospital order"},"skos:altLabel":{"@language":"en","@value":"Detention of LGBTQ people under a hospital order"},"rdfs:comment":{"@language":"en","@value":"Physical and legal confinement of LGBTQ+ people in hospitals or medical institutions, typically to receive evaluation and treatment ordered by a court or other such authority. Can be used to describe both short-term or long-term institutionalization."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000348"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000394"},{"@id":"https://homosaurus.org/v3/homoit0001012"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000348"},"dc:replaces":{"@id":"http://homosaurus.org/v2/detentionOfLGBTQPeopleUnderAHospital"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000884","dc:identifier":"homoit0000884","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ imprisonment"},"skos:altLabel":{"@language":"en","@value":"LGBTQ imprisonment"},"rdfs:comment":{"@language":"en","@value":"Confinement, including physical and/or legal restraint, of LGBTQ+ people by an institution or authority. Typically used to describe confinement to a public or private prison that is sentenced by a court within a penal system."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000348"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000887"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000348"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQImprisonment"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000883","dc:identifier":"homoit0000883","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ immigration rights"},"skos:altLabel":{"@language":"en","@value":"LGBTQ immigration rights"},"rdfs:comment":{"@language":"en","@value":"Legal and social entitlement to freedom, equality, and protection held by LGBTQ+ immigrants."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000712"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000348"},{"@id":"https://homosaurus.org/v3/homoit0000927"},{"@id":"https://homosaurus.org/v3/homoit0001053"},{"@id":"https://homosaurus.org/v3/homoit0001092"},{"@id":"https://homosaurus.org/v3/homoit0001482"},{"@id":"https://homosaurus.org/v3/homoit0001815"},{"@id":"https://homosaurus.org/v3/homoit0001853"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQImmigrationRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000887","dc:identifier":"homoit0000887","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ prisoners"},"skos:altLabel":[{"@language":"en","@value":"LGBTQ inmates"},{"@language":"en","@value":"Prisoners (LGBTQ)"},{"@language":"en","@value":"LGBTQ prisoners"}],"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who are deprived of their liberty against their will by an institution or authority. Typically used to describe individuals sentenced to confinement in a public or private prison by a court within a penal system, but may also include people forcibly confined to hospitals and other institutions."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000915"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000924"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000348"},{"@id":"https://homosaurus.org/v3/homoit0000884"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPrisoners"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000394","dc:identifier":"homoit0000394","skos:prefLabel":{"@language":"en","@value":"Electroshock therapy"},"skos:altLabel":[{"@language":"en","@value":"Electric shock therapy"},{"@language":"en","@value":"Electroconvulsive therapy"}],"rdfs:comment":{"@language":"en","@value":"A form of psychiatric treatment for major depression, bipolar depression, and other mental health conditions that usually consists of brief electrical pulses to the brain through electrodes on the head that induce controlled seizures. Electroshock therapy has historically been used as an attempt to \"cure\" homosexuality and other non-normative sexualities and sexual practices."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001366"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000349"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85041999"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/electroshockTherapy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001012","dc:identifier":"homoit0001012","skos:prefLabel":{"@language":"en","@value":"Mental health care for LGBTQ+ people"},"skos:altLabel":{"@language":"en","@value":"Mental health care for LGBTQ people"},"rdfs:comment":{"@language":"en","@value":"Organized measures taken for the diagnosis, maintenance, treatment, or improvement of mental health or psychological well being; use in reference to mental health care addressing the particular needs of LGBTQ+ individuals or communities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000614"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000953"},{"@id":"https://homosaurus.org/v3/homoit0001551"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000349"},{"@id":"https://homosaurus.org/v3/homoit0000351"},{"@id":"https://homosaurus.org/v3/homoit0000952"},{"@id":"https://homosaurus.org/v3/homoit0001366"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000614"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mentalHealthCareForLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000351","dc:identifier":"homoit0000351","skos:prefLabel":{"@language":"en","@value":"DSM (Diagnostic and Statistical Manual of Mental Disorders)"},"skos:altLabel":[{"@language":"en","@value":"DSM"},{"@language":"en","@value":"Diagnostic and Statistical Manual of Mental Disorders"}],"rdfs:comment":{"@language":"en","@value":"The Diagnostic and Statistical Manual of Mental Disorders, produced by the American Psychiatric Association; can be used in reference to the DSM's historical or present day descriptions of LGBTQ+ identities and practices."},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001012"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000351"},"dc:replaces":{"@id":"http://homosaurus.org/v2/DSM"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000352","dc:identifier":"homoit0000352","skos:prefLabel":{"@language":"en","@value":"Intersex"},"skos:altLabel":[{"@language":"en","@value":"Differences in sex development"},{"@language":"en","@value":"Divergences in sex development"},{"@language":"en","@value":"DSDs"},{"@language":"en","@value":"Hermaphroditism"},{"@language":"en","@value":"Intersexuality"},{"@language":"en","@value":"Variations in sex development"},{"@language":"en","@value":"VSDs"},{"@language":"es","@value":"Intersexual"}],"rdfs:comment":{"@language":"en","@value":"An umbrella term used to refer to people born with variations in their physical sex characteristics--including genitals, gonads, chromosomes, and hormonal factors--that do not fit typical definitions of male or female bodies."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001269"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000357"},{"@id":"https://homosaurus.org/v3/homoit0000669"},{"@id":"https://homosaurus.org/v3/homoit0002835"},{"@id":"https://homosaurus.org/v3/homoit0002841"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000618"},{"@id":"https://homosaurus.org/v3/homoit0000666"},{"@id":"https://homosaurus.org/v3/homoit0000670"},{"@id":"https://homosaurus.org/v3/homoit0000671"},{"@id":"https://homosaurus.org/v3/homoit0000672"},{"@id":"https://homosaurus.org/v3/homoit0001822"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000357","dc:identifier":"homoit0000357","skos:prefLabel":{"@language":"en","@value":"Disorders of sexual development"},"skos:altLabel":{"@language":"en","@value":" Disorders of sex development"},"rdfs:comment":{"@language":"en","@value":"Term used within medical contexts to refer to a wide range of variations in sex characteristics. Many people with intersex variations consider these terms to be stigmatizing and pathologizing, though they often still encounter them in their medical records."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000352"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001006"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120728"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/disordersOfSexualDevelopment"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002835","dc:identifier":"homoit0002835","skos:prefLabel":{"@language":"en","@value":"Early genital surgery model"},"skos:altLabel":{"@language":"en","@value":"John Money model"},"rdfs:comment":{"@language":"en","@value":"Patient care model developed by John Money, a New Zealand psychologist who theorized that gender was completely dependent on \"nurture.\" This model advocates for performing genital surgery on intersex infants and raising them as girls. Money's theories have resulted in many surgically misgendered children who have had to deal with life-long gender dysphoria, depression, sexual dysfunction, bowel and urinary incontinence, and nerve pain. A patient-centered model, in which the intersex child is allowed to grow up and make their own choices regarding their gender and surgical option, is now preferred."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000352"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001006"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002841","dc:identifier":"homoit0002841","skos:prefLabel":{"@language":"en","@value":"Hopkins model"},"skos:altLabel":{"@language":"en","@value":"Concealment centered model"},"rdfs:comment":{"@language":"en","@value":"A patient care model that gained popular usage in the 1950s. In this model, parents are used to quickly decide on a gender assignment for their intersex baby, under the assumption that the child would identify with whichever gender their parents raised them as. If a child later deviated from the assigned gender, parents were encouraged to verbally and physically \"correct\" the child and enforce gender norms. In practice, this resulted in life-altering, unnecessary genital surgeries, irreversible hormone treatments, and dishonesty on the parent's part. A patient-centered model, in which the intersex child is allowed to grow up and make their own choices regarding their gender and surgical option, is now preferred. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000352"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001006"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000666","dc:identifier":"homoit0000666","skos:prefLabel":{"@language":"en","@value":"Intersexphobia"},"skos:altLabel":{"@language":"en","@value":"Interphobia"},"rdfs:comment":{"@language":"en","@value":"Antagonism or disgust directed toward intersex people or intersex variations. Intersexphobia can include the denial of the existence of intersex people, insistence that intersex variations should be forcibly \"corrected,\" stereotypes, verbal harassment, and physical violence."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000920"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002595"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000352"},{"@id":"https://homosaurus.org/v3/homoit0000619"},{"@id":"https://homosaurus.org/v3/homoit0000670"},{"@id":"https://homosaurus.org/v3/homoit0001770"},{"@id":"https://homosaurus.org/v3/homoit0001893"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexphobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000671","dc:identifier":"homoit0000671","skos:prefLabel":{"@language":"en","@value":"Intersex identity"},"rdfs:comment":{"@language":"en","@value":"Used to describe the experience of selfhood of intersex people. Intersex identity is not gender identity, sexual identity, nor sexual orientation. For the subject of intersex variations, use \"intersex variations\" or \"intersex\". For the subject of intersex people, use \"intersex people\". Do not use in place of gender-identity-related terms such as non-binary identity or genderfluid identity."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000352"},{"@id":"https://homosaurus.org/v3/homoit0000618"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007005480"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000671"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000672","dc:identifier":"homoit0000672","skos:prefLabel":{"@language":"en","@value":"Intersex movement"},"rdfs:comment":{"@language":"en","@value":"Umbrella term for activism focused on the rights of intersex people and issues faced by intersex communities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001026"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000352"},{"@id":"https://homosaurus.org/v3/homoit0000618"},{"@id":"https://homosaurus.org/v3/homoit0000805"},{"@id":"https://homosaurus.org/v3/homoit0000807"},{"@id":"https://homosaurus.org/v3/homoit0000882"},{"@id":"https://homosaurus.org/v3/homoit0001322"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexMovement"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001822","dc:identifier":"homoit0001822","skos:prefLabel":{"@language":"en","@value":"Hermaphrodites"},"rdfs:comment":{"@language":"en","@value":"A term originating from Greek mythology that refers to beings that are both fully female and fully male. The term was once adopted in the medical realm to describe people with intersex variations generally (and later to describe someone with both ovarian and testicular tissue specifically), but it is now recognized to be stigmatizing, imprecise, and misleading. Many people in the intersex community consider the use of this term to be pathologizing and deeply offensive, while other intersex people have chosen to reclaim the term to describe themselves and their bodies. Do not use this term to describe an individual unless they explicitly identify with it and have chosen to use it."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000878"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000352"},{"@id":"https://homosaurus.org/v3/homoit0000618"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000355","dc:identifier":"homoit0000355","skos:prefLabel":{"@language":"en","@value":"Dildos"},"rdfs:comment":{"@language":"en","@value":"A sex toy, often explicitly (although not necessarily) phallic in appearance, intended for sexual penetration or other sexual activity during masturbation or with sex partners."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001266"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000354"},{"@id":"https://homosaurus.org/v3/homoit0001099"},{"@id":"https://homosaurus.org/v3/homoit0001342"},{"@id":"https://homosaurus.org/v3/homoit0001491"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007007162"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dildos"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-09"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001067","dc:identifier":"homoit0001067","skos:prefLabel":{"@language":"en","@value":"Packing (Phallus)"},"rdfs:comment":{"@language":"en","@value":"The act of wearing padding or a phallic object in the front of the pants or underwear to give the appearance of having a bulge."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000568"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000354"},{"@id":"https://homosaurus.org/v3/homoit0001099"},{"@id":"https://homosaurus.org/v3/homoit0001790"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/packingPhallus"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-09"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001342","dc:identifier":"homoit0001342","skos:prefLabel":{"@language":"en","@value":"Strap-on sex"},"rdfs:comment":{"@language":"en","@value":"Sexual intercourse in which a dildo attached to a harness is used for either vaginal or anal penetration."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001267"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000354"},{"@id":"https://homosaurus.org/v3/homoit0000355"},{"@id":"https://homosaurus.org/v3/homoit0000662"},{"@id":"https://homosaurus.org/v3/homoit0001099"},{"@id":"https://homosaurus.org/v3/homoit0001510"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007007163"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/strapOnSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001491","dc:identifier":"homoit0001491","skos:prefLabel":{"@language":"en","@value":"Vibrators"},"rdfs:comment":{"@language":"en","@value":"Electric-powered sex toys that produce different levels of vibrations or pulses to aid in sexual stimulation and pleasure."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001266"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000355"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2002004287"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/vibrators"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-09"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000701","dc:identifier":"homoit0000701","skos:prefLabel":{"@language":"en","@value":"Lavender Scare"},"rdfs:comment":{"@language":"en","@value":"Term used to describe the mid-20th century purge of lesbians and gay men in the U.S. government as a result of moral panic incited by Joseph McCarthy and others."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000356"},{"@id":"https://homosaurus.org/v3/homoit0001108"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000701"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lavenderScare"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001555","dc:identifier":"homoit0001555","skos:prefLabel":{"@language":"en","@value":"Mononormativity"},"rdfs:comment":{"@language":"en","@value":"The belief that all people share a desire for monogamous relationships and that this is a preferential life goal."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001323"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000356"},{"@id":"https://homosaurus.org/v3/homoit0001019"},{"@id":"https://homosaurus.org/v3/homoit0001556"},{"@id":"https://homosaurus.org/v3/homoit0001915"},{"@id":"https://homosaurus.org/v3/homoit0001916"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001323"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mononormativity"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003691","dc:identifier":"homoit0003691","skos:prefLabel":{"@language":"en","@value":"Gentrification"},"rdfs:comment":{"@language":"en","@value":"A process of economic and demographic change within a historically disinvested neighborhood by means of real estate investment and an influx of new, higher-income residents, typically resulting in the displacement of long-time, lower-income residents."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000356"},{"@id":"https://homosaurus.org/v3/homoit0002257"},{"@id":"https://homosaurus.org/v3/homoit0003140"},{"@id":"https://homosaurus.org/v3/homoit0002038"},{"@id":"https://homosaurus.org/v3/homoit0003692"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85053952"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0003691"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000358","dc:identifier":"homoit0000358","skos:prefLabel":{"@language":"en","@value":"Diversity"},"rdfs:comment":{"@language":"en","@value":"Diversity in characteristics of people in age, gender, religion, ethnicity, sexual orientation, lifestyle, etc."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000566"},{"@id":"https://homosaurus.org/v3/homoit0001290"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000667"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85103571"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000358"},"dc:replaces":{"@id":"http://homosaurus.org/v2/diversity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000566","dc:identifier":"homoit0000566","skos:prefLabel":{"@language":"en","@value":"Gender diversity"},"rdfs:comment":{"@language":"en","@value":"An umbrella term encompassing a range of gender identities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000358"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000560"},{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0000571"},{"@id":"https://homosaurus.org/v3/homoit0001048"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001817"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000358"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderDiversity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001290","dc:identifier":"homoit0001290","skos:prefLabel":{"@language":"en","@value":"Sexual diversity"},"rdfs:comment":{"@language":"en","@value":"Diversity of sexual orientation or sexuality among members of a group or within a given society."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000358"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001558"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000807"},{"@id":"https://homosaurus.org/v3/homoit0001292"},{"@id":"https://homosaurus.org/v3/homoit0001295"},{"@id":"https://homosaurus.org/v3/homoit0001298"},{"@id":"https://homosaurus.org/v3/homoit0001300"},{"@id":"https://homosaurus.org/v3/homoit0001556"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000358"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualDiversity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000667","dc:identifier":"homoit0000667","skos:prefLabel":{"@language":"en","@value":"Intersectionality"},"rdfs:comment":{"@language":"en","@value":"A theoretical framework first conceptualized by Kimberlé Crenshaw to describe how different facets of social identity (such as gender, race, ethnicity, disability, socioeconomic class, religion, and sexual identity) overlap and intersect, often compounding the individual's experiences with inequality and discrimination."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000358"},{"@id":"https://homosaurus.org/v3/homoit0000860"},{"@id":"https://homosaurus.org/v3/homoit0001133"},{"@id":"https://homosaurus.org/v3/homoit0002270"},{"@id":"https://homosaurus.org/v3/homoit0002271"},{"@id":"https://homosaurus.org/v3/homoit0002272"},{"@id":"https://homosaurus.org/v3/homoit0002274"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2017003056"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000667"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersectionality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-10-28"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000359","dc:identifier":"homoit0000359","skos:prefLabel":{"@language":"en","@value":"Divorced people"},"rdfs:comment":{"@language":"en","@value":"People whose marriages have been legally dissolved. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000989"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000854"},{"@id":"https://homosaurus.org/v3/homoit0001312"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85038648"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/divorcedPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000989","dc:identifier":"homoit0000989","skos:prefLabel":{"@language":"en","@value":"Marital status"},"rdfs:comment":{"@language":"en","@value":"A person's state of being single, married, separated, divorced, or widowed, as defined by a government or legal authority."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000990"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000359"},{"@id":"https://homosaurus.org/v3/homoit0000994"},{"@id":"https://homosaurus.org/v3/homoit0001312"},{"@id":"https://homosaurus.org/v3/homoit0001483"},{"@id":"https://homosaurus.org/v3/homoit0001504"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000712"},{"@id":"https://homosaurus.org/v3/homoit0000937"},{"@id":"https://homosaurus.org/v3/homoit0000992"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081304"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/maritalStatus"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001312","dc:identifier":"homoit0001312","skos:prefLabel":{"@language":"en","@value":"Single people"},"skos:altLabel":{"@language":"en","@value":"Singles"},"rdfs:comment":{"@language":"en","@value":"People who are not involved in any committed sexual or romantic relationships, including marriages, civil unions, or other established partnerships."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000989"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000944"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000359"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85122849"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/singlePeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000360","dc:identifier":"homoit0000360","skos:prefLabel":{"@language":"en","@value":"Domestic partnership contracts"},"rdfs:comment":{"@language":"en","@value":"Agreements, legal or otherwise, between two unmarried people in a domestic partnership that define property rights and support obligations if the relationship ends or if one partner dies."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001053"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000361"},{"@id":"https://homosaurus.org/v3/homoit0000362"},{"@id":"https://homosaurus.org/v3/homoit0000918"},{"@id":"https://homosaurus.org/v3/homoit0000963"},{"@id":"https://homosaurus.org/v3/homoit0000973"},{"@id":"https://homosaurus.org/v3/homoit0000990"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/domesticPartnershipContracts"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000361","dc:identifier":"homoit0000361","skos:prefLabel":{"@language":"en","@value":"Domestic partnership retirement benefits"},"skos:altLabel":{"@language":"en","@value":"Same-sex pension benefits"},"rdfs:comment":{"@language":"en","@value":"Employee benefit plans for people in domestic partnerships that can be accessed upon retirement."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000360"},{"@id":"https://homosaurus.org/v3/homoit0000918"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97004494"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000361"},"dc:replaces":{"@id":"http://homosaurus.org/v2/domesticPartnershipRetirementBenefits"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000963","dc:identifier":"homoit0000963","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ weddings"},"skos:altLabel":[{"@language":"en","@value":"LGBTQ weddings"},{"@language":"en","@value":"Weddings (LGBTQ)"}],"rdfs:comment":{"@language":"en","@value":"Marriage ceremonies and the accompanying festivities; use to describe weddings in which both partners are LGBTQ+."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000360"},{"@id":"https://homosaurus.org/v3/homoit0000990"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000963"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQWeddings"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001311","dc:identifier":"homoit0001311","skos:prefLabel":{"@language":"en","@value":"Significant others"},"rdfs:comment":{"@language":"en","@value":"An individual's partner or partners in an established, ongoing romantic or sexual relationship."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000362"},{"@id":"https://homosaurus.org/v3/homoit0000675"},{"@id":"https://homosaurus.org/v3/homoit0000855"},{"@id":"https://homosaurus.org/v3/homoit0000895"},{"@id":"https://homosaurus.org/v3/homoit0001080"},{"@id":"https://homosaurus.org/v3/homoit0001081"},{"@id":"https://homosaurus.org/v3/homoit0001082"},{"@id":"https://homosaurus.org/v3/homoit0001237"},{"@id":"https://homosaurus.org/v3/homoit0001300"},{"@id":"https://homosaurus.org/v3/homoit0002365"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001311"},"dc:replaces":{"@id":"http://homosaurus.org/v2/significantOthers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002990","dc:identifier":"homoit0002990","skos:prefLabel":{"@language":"en","@value":"Asexual dominatrices"},"rdfs:comment":{"@language":"en","@value":"Women who take a dominant role in BDSM activities; use for dominatrices who identify as asexual."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000363"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001637"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000390","dc:identifier":"homoit0000390","skos:prefLabel":{"@language":"en","@value":"Egg donors"},"rdfs:comment":{"@language":"en","@value":"Individuals of any gender who donate their own eggs for the purpose of inducing pregnancy."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000364"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000583"},{"@id":"https://homosaurus.org/v3/homoit0000864"},{"@id":"https://homosaurus.org/v3/homoit0001347"},{"@id":"https://homosaurus.org/v3/homoit0002627"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005007904"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000364"},"dc:replaces":{"@id":"http://homosaurus.org/v2/eggDonors"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000824","dc:identifier":"homoit0000824","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ blood donors"},"skos:altLabel":{"@language":"en","@value":"LGBTQ blood donors"},"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who give blood for transfusion and medical purposes."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000364"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000364"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQBloodDonors"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002616","dc:identifier":"homoit0002616","skos:prefLabel":{"@language":"en","@value":"Anonymous donors (Reproduction) "},"rdfs:comment":{"@language":"en","@value":"People who donated their gametes with the understanding that their identity would remain unknown by any potential offspring."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000364"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002618"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000364"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-10-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002624","dc:identifier":"homoit0002624","skos:prefLabel":{"@language":"en","@value":"Known donors (Reproduction) "},"rdfs:comment":{"@language":"en","@value":"Donors whose identities are known by the people to whom they donated gametes and/or the offspring born of that donation."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000364"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000364"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002625","dc:identifier":"homoit0002625","skos:prefLabel":{"@language":"en","@value":"Open identity donors (Reproduction) "},"skos:altLabel":[{"@language":"en","@value":"Identity release donors"},{"@language":"en","@value":"Willing-to-be-known donors"}],"rdfs:comment":{"@language":"en","@value":"Donors who donated their gametes with the understanding that their identity and/or contact information would be released to any offspring born of that donation. The age at which the offspring receives this information varies, following the donor's preference."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000364"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000364"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001788","dc:identifier":"homoit0001788","skos:prefLabel":{"@language":"en","@value":"Beards (Gay culture)"},"skos:altLabel":{"@language":"en","@value":"Beards"},"rdfs:comment":{"@language":"en","@value":"Individuals who pose as the date or partner of someone they are not in a relationship with, typically to prevent that person's sexuality from becoming public knowledge; most commonly used to refer to a woman pretending to be dating a gay man."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000487"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000365"},{"@id":"https://homosaurus.org/v3/homoit0000381"},{"@id":"https://homosaurus.org/v3/homoit0000416"},{"@id":"https://homosaurus.org/v3/homoit0000598"},{"@id":"https://homosaurus.org/v3/homoit0001261"},{"@id":"https://homosaurus.org/v3/homoit0001783"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-08"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002278","dc:identifier":"homoit0002278","skos:prefLabel":{"@language":"en","@value":"MLM (Men Loving Men)"},"skos:altLabel":[{"@language":"en","@value":"Man loving man"},{"@language":"en","@value":"Men loving men"}],"rdfs:comment":{"@language":"en","@value":"Slang term used to describe men who have romantic and/or sexual relationships with other men; often used as an alternative to the term \"Men who have sex with men.\" Can be used to describe men who are exclusively or primarily interested in men, as well as men who are also interested in people of other or all genders. Only use to describe people who self-identify as MLM."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000915"},{"@id":"https://homosaurus.org/v3/homoit0001008"},{"@id":"https://homosaurus.org/v3/homoit0001297"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000365"},{"@id":"https://homosaurus.org/v3/homoit0001254"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-08"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003245","dc:identifier":"homoit0003245","skos:prefLabel":{"@language":"en","@value":"Drag television programs"},"skos:altLabel":[{"@language":"en","@value":"Drag TV programmes"},{"@language":"en","@value":"Drag TV programs"},{"@language":"en","@value":"Drag TV shows"},{"@language":"en","@value":"Drag television programmes"},{"@language":"en","@value":"Drag television shows"},{"@language":"en","@value":"Drag television"}],"rdfs:comment":{"@language":"en","@value":"Television programs that feature drag queens and/or drag kings and drag performances."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000367"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001359"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2021001448"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-05-24"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001906","dc:identifier":"homoit0001906","skos:prefLabel":{"@language":"en","@value":"Drag performers"},"rdfs:comment":{"@language":"en","@value":"Performers who dress and/or use makeup to produce, emphasize, and/or exaggerate traits associated with a certain gender, which may or may not be the gender the performer primarily identifies with."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000367"},{"@id":"https://homosaurus.org/v3/homoit0000370"},{"@id":"https://homosaurus.org/v3/homoit0000373"},{"@id":"https://homosaurus.org/v3/homoit0000375"},{"@id":"https://homosaurus.org/v3/homoit0003359"},{"@id":"https://homosaurus.org/v3/homoit0003360"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001906"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003359","dc:identifier":"homoit0003359","skos:prefLabel":{"@language":"en","@value":"Drag shows"},"skos:altLabel":{"@language":"en","@value":"Drag performances"},"rdfs:comment":{"@language":"en","@value":"Performances by a single drag performer or a group of drag performers, which often include singing or lip syncing, dance routines, and comedy skits."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000861"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000367"},{"@id":"https://homosaurus.org/v3/homoit0000369"},{"@id":"https://homosaurus.org/v3/homoit0001906"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006003334"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000861"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-19"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003360","dc:identifier":"homoit0003360","skos:prefLabel":{"@language":"en","@value":"Drag pageants"},"rdfs:comment":{"@language":"en","@value":"Events styled after traditional beauty pageants or contests in which contestants, typically drag queens, female impersonators, and trans women, compete in a range of categories to win a prize or title."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000861"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000367"},{"@id":"https://homosaurus.org/v3/homoit0000369"},{"@id":"https://homosaurus.org/v3/homoit0001906"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000861"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-19"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000861","dc:identifier":"homoit0000861","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ events"},"skos:altLabel":{"@language":"en","@value":"LGBTQ events"},"rdfs:comment":{"@language":"en","@value":"Organized public or social occasions for LGBTQ+ people and communities."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000368"},{"@id":"https://homosaurus.org/v3/homoit0000607"},{"@id":"https://homosaurus.org/v3/homoit0000949"},{"@id":"https://homosaurus.org/v3/homoit0003080"},{"@id":"https://homosaurus.org/v3/homoit0003106"},{"@id":"https://homosaurus.org/v3/homoit00