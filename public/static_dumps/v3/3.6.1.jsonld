.org/v3/homoit0000670"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexGenitalMutilation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000585","dc:identifier":"homoit0000585","skos:prefLabel":{"@language":"en","@value":"Genitals"},"skos:altLabel":{"@language":"en","@value":"Genitalia"},"rdfs:comment":{"@language":"en","@value":"General term for erogenous and/or reproductive organs (e.g., vagina, clitoris, penis)."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001269"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000282"},{"@id":"https://homosaurus.org/v3/homoit0001099"},{"@id":"https://homosaurus.org/v3/homoit0001361"},{"@id":"https://homosaurus.org/v3/homoit0001488"},{"@id":"https://homosaurus.org/v3/homoit0001497"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000401"},{"@id":"https://homosaurus.org/v3/homoit0001268"},{"@id":"https://homosaurus.org/v3/homoit0003110"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85053822"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genitals"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000460","dc:identifier":"homoit0000460","skos:prefLabel":{"@language":"en","@value":"G-spot"},"rdfs:comment":{"@language":"en","@value":"Commonly characterized as an erogenous area of the front anterior wall of the vagina that, when stimulated, can lead to sexual arousal, orgasms, and/or ejaculation."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000282"},{"@id":"https://homosaurus.org/v3/homoit0001488"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001062"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002802"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000401"},"dc:replaces":{"@id":"http://homosaurus.org/v2/g-spot"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001844","dc:identifier":"homoit0001844","skos:prefLabel":{"@language":"en","@value":"Clitoroplasty"},"rdfs:comment":{"@language":"en","@value":"Surgical construction of the clitoris, often undertaken as a form of gender affirming surgery."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000584"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000282"},{"@id":"https://homosaurus.org/v3/homoit0001040"},{"@id":"https://homosaurus.org/v3/homoit0001465"},{"@id":"https://homosaurus.org/v3/homoit0001845"},{"@id":"https://homosaurus.org/v3/homoit0001851"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001848","dc:identifier":"homoit0001848","skos:prefLabel":{"@language":"en","@value":"Vaginectomy"},"rdfs:comment":{"@language":"en","@value":"Surgical removal of the vagina."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000584"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000282"},{"@id":"https://homosaurus.org/v3/homoit0001465"},{"@id":"https://homosaurus.org/v3/homoit0001488"},{"@id":"https://homosaurus.org/v3/homoit0001497"},{"@id":"https://homosaurus.org/v3/homoit0001846"},{"@id":"https://homosaurus.org/v3/homoit0001847"},{"@id":"https://homosaurus.org/v3/homoit0001850"},{"@id":"https://homosaurus.org/v3/homoit0001894"}],"