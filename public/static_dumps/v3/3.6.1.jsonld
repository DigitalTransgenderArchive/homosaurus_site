ated":[{"@id":"https://homosaurus.org/v3/homoit0000078"},{"@id":"https://homosaurus.org/v3/homoit0000266"},{"@id":"https://homosaurus.org/v3/homoit0001896"},{"@id":"https://homosaurus.org/v3/homoit0001897"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/assignedSex"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-28"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000270","dc:identifier":"homoit0000270","skos:prefLabel":{"@language":"en","@value":"Cisgender men"},"rdfs:comment":{"@language":"en","@value":"Men whose gender identity matches the sex or gender they were assigned at birth."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000271"},{"@id":"https://homosaurus.org/v3/homoit0001008"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000079"},{"@id":"https://homosaurus.org/v3/homoit0001925"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000271"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cisgenderMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001642","dc:identifier":"homoit0001642","skos:prefLabel":{"@language":"en","@value":"Trans women"},"skos:altLabel":[{"@language":"en","@value":"Transgender women"},{"@language":"en","@value":"Transwomen"},{"@language":"en","@value":"Trans-women"}],"rdfs:comment":{"@language":"en","@value":"Women whose gender assigned at birth was not female. Do not use for intersex people unless the intersex person identifies as a trans woman."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001509"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit00