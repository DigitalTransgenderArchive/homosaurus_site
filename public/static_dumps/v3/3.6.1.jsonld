"@value":"Transsexuals"}],"rdfs:comment":{"@language":"en","@value":"Individuals who transition from female to male or male to female. Generally refers to individuals who transition their physical bodies to align with their gender identities. Though this term was popular in the 20th century and is still in use today, it has been largely replaced by \"transgender people\" and \"trans people.\" Some but not all people regard this term as outdated and offensive. Only use to describe people who self-identify as transsexual."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001378"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000436"},{"@id":"https://homosaurus.org/v3/homoit0000986"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000273"},{"@id":"https://homosaurus.org/v3/homoit0000561"},{"@id":"https://homosaurus.org/v3/homoit0000572"},{"@id":"https://homosaurus.org/v3/homoit0001047"},{"@id":"https://homosaurus.org/v3/homoit0001049"},{"@id":"https://homosaurus.org/v3/homoit0001073"},{"@id":"https://homosaurus.org/v3/homoit0001129"},{"@id":"https://homosaurus.org/v3/homoit0001131"},{"@id":"https://homosaurus.org/v3/homoit0001380"},{"@id":"https://homosaurus.org/v3/homoit0001464"},{"@id":"https://homosaurus.org/v3/homoit0001465"},{"@id":"https://homosaurus.org/v3/homoit0001468"},{"@id":"https://homosaurus.org/v3/homoit0001781"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85137086"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transsexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001924","dc:identifier":"homoit0001924","skos:prefLabel":{"@language":"en","@value":"Cissexuality"},"rdfs:comment":{"@language":"en","@value":"Term used to describe people who i