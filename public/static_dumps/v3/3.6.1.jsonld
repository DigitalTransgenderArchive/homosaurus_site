d":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000101","dc:identifier":"homoit0000101","skos:prefLabel":{"@language":"ceb","@value":"Bayot"},"rdfs:comment":{"@language":"en","@value":"Derogatory Cebuano term used in the Philippines to describe effeminate gay men or masculine women."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000322"},{"@id":"https://homosaurus.org/v3/homoit0001560"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000091"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bayot"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000092","dc:identifier":"homoit0000092","skos:prefLabel":{"@language":"en","@value":"Ball culture"},"skos:altLabel":[{"@language":"en","@value":"Ballroom community"},{"@language":"en","@value":"Ballroom culture"},{"@language":"en","@value":"Ballroom scene"},{"@language":"en","@value":"Drag ball culture"},{"@language":"en","@value":"House-ballroom culture"}],"rdfs:comment":{"@language":"en","@value":"A subculture that emerged in early 20th century New York City in which primarily African-American and Latin American LGBTQ+ people perform and compete for various prizes."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001345"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000094"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000095"},{"@id":"https://homosaurus.org/v3/homoit0000368"},{"@id":"https://homosaurus.org/v3/homoit0000370"},{"@id":"https://homosaurus.org/v3/homoit0001295"},{"@id":"https://homosaurus.org/v3/homoit0001494"},{"@id":"https://homosaurus.org/v3/homoit0001900"},{"@id":"https://homosaurus.org/v3/homoit0003505"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ballCulture"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000094","dc:identifier":"homoit0000094","skos:prefLabel":{"@language":"en","@value":"Ballroom families"},"skos:altLabel":{"@language":"en","@value":"Ballroom houses"},"rdfs:comment":{"@language":"en","@value":"In ball culture, ballroom families (or houses) are chosen families headed by and named after established community members (e.g., the House of Xtravaganza); heads of ballroom families are typically called \"mothers\" or \"fathers,\" while members are termed \"children\" and \"siblings.\""},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000092"},{"@id":"https://homosaurus.org/v3/homoit0000834"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000371"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ballroomFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-10-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000368","dc:identifier":"homoit0000368","skos:prefLabel":{"@language":"en","@value":"Drag balls"},"rdfs:comment":{"@language":"en","@value":"Events that are part of the drag ball subculture that emerged in early 20th-century New York City among primarily African-American and Latin American LGBTQ+ people. During a drag ball, individuals \"walk\" or perform for prizes."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000861"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000092"},{"@id":"https://homosaurus.org/v3/homoit0000367"},{"@id":"https://homosaurus.org/v3/homoit0000370"},{"@id":"https://homosaurus.org/v3/homoit0001494"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh94008099"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000861"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragBalls"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000370","dc:identifier":"homoit0000370","skos:prefLabel":{"@language":"en","@value":"Drag community"},"rdfs:comment":{"@language":"en","@value":"Groups of people (typically drag performers) with a shared interest in drag performances and culture."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000297"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000371"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000092"},{"@id":"https://homosaurus.org/v3/homoit0000367"},{"@id":"https://homosaurus.org/v3/homoit0000368"},{"@id":"https://homosaurus.org/v3/homoit0000369"},{"@id":"https://homosaurus.org/v3/homoit0000373"},{"@id":"https://homosaurus.org/v3/homoit0000375"},{"@id":"https://homosaurus.org/v3/homoit0001900"},{"@id":"https://homosaurus.org/v3/homoit0001906"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragCommunity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001494","dc:identifier":"homoit0001494","skos:prefLabel":{"@language":"en","@value":"Voguing"},"skos:altLabel":{"@language":"en","@value":"Vogueing"},"rdfs:comment":{"@language":"en","@value":"A highly stylized form of dance originating in the Harlem ballroom scene in the 1980s and 1990s."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000092"},{"@id":"https://homosaurus.org/v3/homoit0000367"},{"@id":"https://homosaurus.org/v3/homoit0000368"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002691"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001494"},"dc:replaces":{"@id":"http://homosaurus.org/v2/voguing"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001900","dc:identifier":"homoit0001900","skos:prefLabel":{"@language":"en","@value":"Reading (LGBTQ+ culture)"},"rdfs:comment":{"@language":"en","@value":"Slang term used in drag and ballroom communities to describe the act of playfully or wittily insulting someone's appearance or behavior; described by drag queen Dorian Corey as \"the art form of the insult.\" "},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000092"},{"@id":"https://homosaurus.org/v3/homoit0000370"},{"@id":"https://homosaurus.org/v3/homoit0001233"},{"@id":"https://homosaurus.org/v3/homoit0002192"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001900"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003505","dc:identifier":"homoit0003505","skos:prefLabel":{"@language":"en","@value":"Kiki (Social Gathering)"},"skos:altLabel":[{"@language":"en","@value":"Kikiing (Social gathering)"},{"@language":"en","@value":"Kiking (Social gathering)"}],"rdfs:comment":{"@language":"en","@value":"A slang term to describe a gathering of friends for the purpose of chatting and gossiping. The term evolved out of the 1990s ballroom scene in New York City and was further popularized by the 2012 song \"Let's Have a Kiki\" by the Scissor Sisters. Do not conflate with the term \"Ky-ky (Gender role),\" sometimes also spelled \"Kiki,\" which refers to lesbians who do not identify as either butches or femmes."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001317"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000092"},{"@id":"https://homosaurus.org/v3/homoit0000455"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001317"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000093","dc:identifier":"homoit0000093","skos:prefLabel":{"@language":"en","@value":"Ballgags"},"rdfs:comment":{"@language":"en","@value":"Silicone, rubber, or other types of balls that are strapped in a person’s mouth to prevent them from speaking, typically during sex."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001266"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ballgags"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000834","dc:identifier":"homoit0000834","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ chosen families"},"skos:altLabel":{"@language":"en","@value":"LGBTQ chosen families"},"rdfs:comment":{"@language":"en","@value":"Groups of LGBTQ+ people who have intentionally chosen to nurture, support, and love one another as family, whether or not they have biological or legal relationships."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000420"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000094"},{"@id":"https://homosaurus.org/v3/homoit0000371"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQChosenFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000371","dc:identifier":"homoit0000371","skos:prefLabel":{"@language":"en","@value":"Drag families"},"rdfs:comment":{"@language":"en","@value":"Groups of drag performers who share a community and typically live in close quarters with one another. Drag families are headed by drag mothers or drag fathers, with other members termed drag daughters and sons. Members of a drag family typically use the same last name as their drag mother or father (e.g., Xtravaganza) in social contexts or while performing."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000370"},{"@id":"https://homosaurus.org/v3/homoit0000420"},{"@id":"https://homosaurus.org/v3/homoit0000834"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000372"},{"@id":"https://homosaurus.org/v3/homoit0000374"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000094"},{"@id":"https://homosaurus.org/v3/homoit0000373"},{"@id":"https://homosaurus.org/v3/homoit0000375"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000878","dc:identifier":"homoit0000878","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ historical terms"},"skos:altLabel":{"@language":"en","@value":"LGBTQ historical terms"},"rdfs:comment":{"@language":"en","@value":"Historical terms for LGBTQ+ people, identities, and practices that are now considered outdated and/or offensive."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000095"},{"@id":"https://homosaurus.org/v3/homoit0000098"},{"@id":"https://homosaurus.org/v3/homoit0000218"},{"@id":"https://homosaurus.org/v3/homoit0000227"},{"@id":"https://homosaurus.org/v3/homoit0000284"},{"@id":"https://homosaurus.org/v3/homoit0000326"},{"@id":"https://homosaurus.org/v3/homoit0000395"},{"@id":"https://homosaurus.org/v3/homoit0000396"},{"@id":"https://homosaurus.org/v3/homoit0000418"},{"@id":"https://homosaurus.org/v3/homoit0000436"},{"@id":"https://homosaurus.org/v3/homoit0000454"},{"@id":"https://homosaurus.org/v3/homoit0000645"},{"@id":"https://homosaurus.org/v3/homoit0000648"},{"@id":"https://homosaurus.org/v3/homoit0000677"},{"@id":"https://homosaurus.org/v3/homoit0000986"},{"@id":"https://homosaurus.org/v3/homoit0001094"},{"@id":"https://homosaurus.org/v3/homoit0001095"},{"@id":"https://homosaurus.org/v3/homoit0001258"},{"@id":"https://homosaurus.org/v3/homoit0001296"},{"@id":"https://homosaurus.org/v3/homoit0001325"},{"@id":"https://homosaurus.org/v3/homoit0001470"},{"@id":"https://homosaurus.org/v3/homoit0001472"},{"@id":"https://homosaurus.org/v3/homoit0001484"},{"@id":"https://homosaurus.org/v3/homoit0001564"},{"@id":"https://homosaurus.org/v3/homoit0001669"},{"@id":"https://homosaurus.org/v3/homoit0001822"},{"@id":"https://homosaurus.org/v3/homoit0001895"},{"@id":"https://homosaurus.org/v3/homoit0001980"},{"@id":"https://homosaurus.org/v3/homoit0002230"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002260"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQHistoricalTerms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-28"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000978","dc:identifier":"homoit0000978","skos:prefLabel":{"@language":"en","@value":"Macho men"},"skos:altLabel":{"@language":"en","@value":"Machos"},"rdfs:comment":{"@language":"en","@value":"Subculture of gay men who display characteristics associated with machismo (e.g., masculine pride, self-reliance, physical strength). Though \"macho men\" can be used more broadly, this term refers to gay men who embrace machismo and traditional masculinity through their dress and behavior."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000506"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000095"},{"@id":"https://homosaurus.org/v3/homoit0000655"},{"@id":"https://homosaurus.org/v3/homoit0000995"},{"@id":"https://homosaurus.org/v3/homoit0002148"},{"@id":"https://homosaurus.org/v3/homoit0002149"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/machoMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001009","dc:identifier":"homoit0001009","skos:prefLabel":{"@language":"en","@value":"Men who have sex with men"},"skos:altLabel":{"@language":"en","@value":"MSM"},"rdfs:comment":{"@language":"en","@value":"Men who engage in sexual activity with other men, whether or not they identify as gay or bisexual."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000915"},{"@id":"https://homosaurus.org/v3/homoit0001008"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000095"},{"@id":"https://homosaurus.org/v3/homoit0000160"},{"@id":"https://homosaurus.org/v3/homoit0000365"},{"@id":"https://homosaurus.org/v3/homoit0000506"},{"@id":"https://homosaurus.org/v3/homoit0001254"},{"@id":"https://homosaurus.org/v3/homoit0001297"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/menWhoHaveSexWithMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002017","dc:identifier":"homoit0002017","skos:prefLabel":{"@language":"en","@value":"Chicano/a/x gay men"},"skos:altLabel":[{"@language":"en","@value":"Chicano gay men"},{"@language":"en","@value":"Chicanx gay men"},{"@language":"en","@value":"Gay Chicanos"},{"@language":"en","@value":"Gay Chicanx men"},{"@language":"en","@value":"Gay Chicanxs"}],"rdfs:comment":{"@language":"en","@value":"Gay men of Mexican descent born in the United States; only use to describe people who self-identify as Chicano, Chicana, or Chicanx. Do not conflate with Latino/a/x or Hispanic people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002007"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000095"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh91001712"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-11-04"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000096","dc:identifier":"homoit0000096","skos:prefLabel":{"@language":"tsg","@value":"Bantut"},"rdfs:comment":{"@language":"en","@value":"Filipino term for gay men who assume the clothes and/or mannerisms of women."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000322"},{"@id":"https://homosaurus.org/v3/homoit0001560"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bantut"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000097","dc:identifier":"homoit0000097","skos:p