"@language":"en","@value":"The recognition and celebration of transgender people and culture, thereby affirming the visibility, dignity, and diversity of transgender communities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0003653"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001379"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0003653"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001380","dc:identifier":"homoit0001380","skos:prefLabel":{"@language":"en","@value":"Transsexuality"},"skos:altLabel":{"@language":"en","@value":"Transexuality"},"rdfs:comment":{"@language":"en","@value":"Term used to describe the identity of people who transition from female to male or male to female. Generally refers to individuals who transition their physical bodies to align with their gender identities. Though this term was popular in the 20th century and is still in use today, it has been largely replaced by \"transgender identity\" and \"trans identity.\" Some but not all people regard this term as outdated and offensive. Only use to describe people who self-identify as transsexual."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001381"},{"@id":"https://homosaurus.org/v3/homoit0001468"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001380"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transsexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003502","dc:identifier":"homoit0003502","skos:prefLabel":{"@language":"en","@value":"Transgender health care bans for children and youth"},"rdfs:comment":{"@language":"en","@value":"Laws or policies instituted that prevent trans and non-binary youth and children from seeking and/or obtaining medical treatment or gender-affirming care, including but not limited to surgery, hormone treatment, and mental health care. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0003499"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001400"},{"@id":"https://homosaurus.org/v3/homoit0001452"},{"@id":"https://homosaurus.org/v3/homoit0003514"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003708","dc:identifier":"homoit0003708","skos:prefLabel":{"@language":"en","@value":"Trans joy"},"skos:altLabel":{"@language":"en","@value":"Transgender joy"},"rdfs:comment":{"@language":"en","@value":"A positive feeling connected to trans identity, being, community, activism, and/or culture that counters the impact of living in a discriminatory society. "},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0003193"},{"@id":"https://homosaurus.org/v3/homoit0002256"},{"@id":"https://homosaurus.org/v3/homoit0001403"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0003708"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-23"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002610","dc:identifier":"homoit0002610","skos:prefLabel":{"@language":"en","@value":"Transgender erotic art "},"rdfs:comment":{"@language":"en","@value":"Erotic art, created by transgender artists, depicting transgender people, or that are regarded as important within transgender culture."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002579"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001435"},{"@