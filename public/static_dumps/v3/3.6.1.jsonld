it0000055","dc:identifier":"homoit0000055","skos:prefLabel":{"@language":"en","@value":"Anti-gay discrimination"},"rdfs:comment":{"@language":"en","@value":"The unjust or prejudicial treatment of gay men due to their sexual identity; may include the denial of legal rights, employment, and housing."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000356"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000646"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88006552"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000356"},"dc:replaces":{"@id":"http://homosaurus.org/v2/antiGayDiscrimination"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000646","dc:identifier":"homoit0000646","skos:prefLabel":{"@language":"en","@value":"Homophobia"},"rdfs:comment":{"@language":"en","@value":"Antagonism or disgust directed towards homosexuality as an identity or men who are perceived to be or are actually gay. Homophobia can include denial of the existence of homosexuality, stereotypes, verbal harassment, and physical violence. This term is often used colloquially to encompass all LGBTQ+ phobia."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000920"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000391"},{"@id":"https://homosaurus.org/v3/homoit0002174"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000055"},{"@id":"https://homosaurus.org/v3/homoit0000056"},{"@id":"https://homosaurus.org/v3/homoit0000506"},{"@id":"https://homosaurus.org/v3/homoit0000619"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88006552"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homophobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc: