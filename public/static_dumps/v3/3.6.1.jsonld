ama consisting primarily of dialogue between characters and intended for theatrical performance; use in reference to plays focusing on LGBTQ+ characters or themes."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000376"},{"@id":"https://homosaurus.org/v3/homoit0000546"},{"@id":"https://homosaurus.org/v3/homoit0000788"},{"@id":"https://homosaurus.org/v3/homoit0000816"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000922"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPlays"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001723","dc:identifier":"homoit0001723","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ authors"},"skos:altLabel":{"@language":"en","@value":"Authors (LGBTQ)"},"rdfs:comment":{"@language":"en","@value":"Creators of written works who are known to be LGBTQ+."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001724"},{"@id":"https://homosaurus.org/v3/homoit0001725"},{"@id":"https://homosaurus.org/v3/homoit0001726"},{"@id":"https://homosaurus.org/v3/homoit0001727"},{"@id":"https://homosaurus.org/v3/homoit0001728"},{"@id":"https://homosaurus.org/v3/homoit0001747"},{"@id":"https://homosaurus.org/v3/homoit0001748"},{"@id":"https://homosaurus.org/v3/homoit0001749"},{"@id":"https://homosaurus.org/v3/homoit0002487"},{"@id":"https://homosaurus.org/v3/homoit0002505"},{"@id":"https://homosaurus.org/v3/homoit0002534"},{"@id":"https://homosaurus.org/v3/homoit0003663"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000376"},{"@id":"https://homosaurus.org/v3/homoit0000443"},{"@id":"https://homosaurus.org/v3/homoit0000827"},{"@id":"https://homosaurus.org/v3/homoit0000972"},{"@id":"https://homosaurus.org/v3/homoit0001118"},{"@id":"https://homosaurus.org/v3/homoit0001602"},{"@id":"https://homosaurus.org/v3/homoit0001729"},{"@id":"ht