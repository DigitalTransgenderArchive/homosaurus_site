618","skos:prefLabel":{"@language":"en","@value":"Assisted reproduction "},"rdfs:comment":{"@language":"en","@value":"The process by which a fetus is conceived through donor insemination, egg donation, surrogacy, IVF, and/or other reproductive technologies."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002619"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000659"},{"@id":"https://homosaurus.org/v3/homoit0001265"},{"@id":"https://homosaurus.org/v3/homoit0001347"},{"@id":"https://homosaurus.org/v3/homoit0002617"},{"@id":"https://homosaurus.org/v3/homoit0002620"},{"@id":"https://homosaurus.org/v3/homoit0002622"},{"@id":"https://homosaurus.org/v3/homoit0002626"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000069"},{"@id":"https://homosaurus.org/v3/homoit0002616"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88005587"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002619"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-10-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000864","dc:identifier":"homoit0000864","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ family planning"},"skos:altLabel":{"@language":"en","@value":"LGBTQ family planning"},"rdfs:comment":{"@language":"en","@value":"The practice of determining the shape of a family by LGBTQ+ people."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000809"},{"@id":"https://homosaurus.org/v3/homoit0000843"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000347"},{"@id":"https://homosaurus.org/v3/homoit0000390"},{"@id":"https://homosaurus.org/v3/homoit0000420"},{"@id":"https://homosaurus.org/v3/homoit0000811"},{"@id":"https://homosaurus.org/v3/homoit0000819"},{"@id":"https://homosaurus.org/v3/homoit0000871"},{"@id":"https://homosaurus.org/v3/homoit0000945"},{"@id":"https://homosaurus.org/v3/hom