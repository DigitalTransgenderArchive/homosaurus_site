{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dc":"http://purl.org/dc/terms/","rdfs":"http://www.w3.org/2000/01/rdf-schema#","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@id":"https://homosaurus.org/v3/homoit0000001","dc:identifier":"homoit0000001","skos:prefLabel":{"@language":"en","@value":"5-alpha reductase deficiency"},"skos:altLabel":{"@language":"en","@value":"5-ARD"},"rdfs:comment":{"@language":"en","@value":"People with 5-alpha reductase deficiency, abbreviated as 5-ARD, have XY chromosomes, testes, and typical levels of testosterone, but their bodies do not have the enzyme responsible for converting testosterone to the more powerful androgen dihydrotestosterone (DHT). This affects how an individual's external sex characteristics develop, and people born with 5-ARD often have genital differences that are noticed at birth. In adolescence, people with 5-ARD typically develop some features associated with testosterone puberty, and they may experience genital growth at this point."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/5AlphaReductaseDeficiency"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000669","dc:identifier":"homoit0000669","skos:prefLabel":{"@language":"en","@value":"Intersex variations"},"skos:altLabel":{"@language":"en","@value":"Intersex conditions"},"rdfs:comment":{"@language":"en","@value":"Term used to refer to a wide range of variations in sex characteristics. The term \"intersex conditions\" is a pathologizing term used to mean people born with variations in their physical sex characteristics also known as intersex traits."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000352"},{"@id":"https://homosaurus.org/v3/homoit0001006"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000001"},{"@id":"https://homosaurus.org/v3/homoit0000044"},{"@id":"https://homosaurus.org/v3/homoit0000064"},{"@id":"https://homosaurus.org/v3/homoit0000283"},{"@id":"https://homosaurus.org/v3/homoit0000301"},{"@id":"https://homosaurus.org/v3/homoit0000599"},{"@id":"https://homosaurus.org/v3/homoit0000657"},{"@id":"https://homosaurus.org/v3/homoit0000692"},{"@id":"https://homosaurus.org/v3/homoit0001014"},{"@id":"https://homosaurus.org/v3/homoit0001020"},{"@id":"https://homosaurus.org/v3/homoit0001066"},{"@id":"https://homosaurus.org/v3/homoit0001079"},{"@id":"https://homosaurus.org/v3/homoit0001134"},{"@id":"https://homosaurus.org/v3/homoit0001354"},{"@id":"https://homosaurus.org/v3/homoit0001478"},{"@id":"https://homosaurus.org/v3/homoit0002818"},{"@id":"https://homosaurus.org/v3/homoit0002819"},{"@id":"https://homosaurus.org/v3/homoit0002821"},{"@id":"https://homosaurus.org/v3/homoit0002822"},{"@id":"https://homosaurus.org/v3/homoit0002823"},{"@id":"https://homosaurus.org/v3/homoit0002824"},{"@id":"https://homosaurus.org/v3/homoit0002826"},{"@id":"https://homosaurus.org/v3/homoit0002828"},{"@id":"https://homosaurus.org/v3/homoit0002829"},{"@id":"https://homosaurus.org/v3/homoit0002831"},{"@id":"https://homosaurus.org/v3/homoit0002832"},{"@id":"https://homosaurus.org/v3/homoit0002833"},{"@id":"https://homosaurus.org/v3/homoit0002836"},{"@id":"https://homosaurus.org/v3/homoit0002837"},{"@id":"https://homosaurus.org/v3/homoit0002838"},{"@id":"https://homosaurus.org/v3/homoit0002839"},{"@id":"https://homosaurus.org/v3/homoit0002842"},{"@id":"https://homosaurus.org/v3/homoit0002843"},{"@id":"https://homosaurus.org/v3/homoit0002848"},{"@id":"https://homosaurus.org/v3/homoit0002861"},{"@id":"https://homosaurus.org/v3/homoit0002862"},{"@id":"https://homosaurus.org/v3/homoit0002863"},{"@id":"https://homosaurus.org/v3/homoit0002864"},{"@id":"https://homosaurus.org/v3/homoit0002865"},{"@id":"https://homosaurus.org/v3/homoit0002870"},{"@id":"https://homosaurus.org/v3/homoit0002871"},{"@id":"https://homosaurus.org/v3/homoit0002872"},{"@id":"https://homosaurus.org/v3/homoit0002873"},{"@id":"https://homosaurus.org/v3/homoit0002875"},{"@id":"https://homosaurus.org/v3/homoit0002878"},{"@id":"https://homosaurus.org/v3/homoit0002883"},{"@id":"https://homosaurus.org/v3/homoit0002885"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000618"},{"@id":"https://homosaurus.org/v3/homoit0001268"},{"@id":"https://homosaurus.org/v3/homoit0001646"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85060401"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexConditions"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001269","dc:identifier":"homoit0001269","skos:prefLabel":{"@language":"en","@value":"Sex (Body)"},"rdfs:comment":{"@language":"en","@value":"The category assigned to an individual to describe their body and its role in sexual reproduction, usually based on external anatomy, but also including chromosomes, gene expression, hormones, and internal and external reproductive/sexual organs. Although sex is often described as binary, it exists as a spectrum with significant variation in the biological attributes that comprise sex and the way it is defined in different cultural contexts."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000266"},{"@id":"https://homosaurus.org/v3/homoit0000352"},{"@id":"https://homosaurus.org/v3/homoit0000585"},{"@id":"https://homosaurus.org/v3/homoit0000600"},{"@id":"https://homosaurus.org/v3/homoit0000651"},{"@id":"https://homosaurus.org/v3/homoit0001259"},{"@id":"https://homosaurus.org/v3/homoit0001648"},{"@id":"https://homosaurus.org/v3/homoit0001896"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000560"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120560"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexBody"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000002","dc:identifier":"homoit0000002","skos:prefLabel":{"@language":"en","@value":"Aboriginal Australian LGBTQ+ people"},"skos:altLabel":[{"@language":"en","@value":"Aboriginal people (LGBTQ)"},{"@language":"en","@value":"Aboriginal Australian people (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ Aboriginal Australian people"},{"@language":"en","@value":"LGBTQ+ Aboriginal Australians"},{"@language":"en","@value":"LGBTQ+ Aboriginal people"},{"@language":"en","@value":"LGBTQ+ Aboriginals"}],"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who belong to one or more of the various Indigenous peoples of Australia; do not use to refer to the Indigenous people of the Torres Strait Islands, who are considered ethnically and culturally distinct. Only use to describe people who identify as Aboriginal Australian."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000886"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001974"},{"@id":"https://homosaurus.org/v3/homoit0001975"},{"@id":"https://homosaurus.org/v3/homoit0001976"},{"@id":"https://homosaurus.org/v3/homoit0001977"},{"@id":"https://homosaurus.org/v3/homoit0001978"},{"@id":"https://homosaurus.org/v3/homoit0001979"},{"@id":"https://homosaurus.org/v3/homoit0002892"},{"@id":"https://homosaurus.org/v3/homoit0003393"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001314"},{"@id":"https://homosaurus.org/v3/homoit0001809"},{"@id":"https://homosaurus.org/v3/homoit0001810"