icians who exist in the real world, usually men."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002196"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000908"},{"@id":"https://homosaurus.org/v3/homoit0001806"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000930","dc:identifier":"homoit0000930","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ restaurants"},"skos:altLabel":{"@language":"en","@value":"LGBTQ restaurants"},"rdfs:comment":{"@language":"en","@value":"Commercial establishments that prepare and serve food and drinks; use in reference to restaurants that cater primarily to LGBTQ+ people or are known to be frequented by LGBTQ+ people."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000909"},{"@id":"https://homosaurus.org/v3/homoit0000956"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000930"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQRestaurants"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002385","dc:identifier":"homoit0002385","skos:prefLabel":{"@language":"en","@value":"Police raids on LGBTQ+ nightclubs"},"rdfs:comment":{"@language":"en","@value":"Unexpected and unannounced entry into and searches of nightclubs owned or frequented by LGBTQ+ people by law enforcement officers with the aim of using surprise to seize evidence or arrest suspects. Police raids may be undertaken legally using a search warrant or through exigent circumstances, such as probable cause, though the latter is highly subjective and civilians often have little resources to appeal illegal raids."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002381"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000909"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000611"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001943","dc:identifier":"homoit0001943","skos:prefLabel":{"@language":"en","@value":"Papuan lesbians"},"skos:altLabel":{"@language":"en","@value":"Lesbian Papuans"},"rdfs:comment":{"@language":"en","@value":"Lesbians who are Papuan, or part of the Indigenous peoples of new Guinea; only use for people who identify as Papuan."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000913"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001944","dc:identifier":"homoit0001944","skos:prefLabel":{"@language":"en","@value":"Papuan gay men"},"skos:altLabel":[{"@language":"en","@value":"Gay Papuan men"},{"@language":"en","@value":"Gay Papuans"}],"rdfs:comment":{"@language":"en","@value":"Gay men who are Papuan, or part of the Indigenous peoples of new Guinea; only use for people who identify as Papuan."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000913"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001945","dc:identifier":"homoit0001945","skos:prefLabel":{"@language":"en","@value":"Papuan bisexual people"},"skos:altLabel":[{"@languag