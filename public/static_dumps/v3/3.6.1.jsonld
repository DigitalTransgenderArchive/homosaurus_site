","@value":"Real people fiction"},{"@language":"en","@value":"Real person slash"},{"@language":"en","@value":"Real person stories"}],"rdfs:comment":{"@language":"en","@value":"Fanfiction about real people, such as actors or musicians; often but not always used to describe fanfiction focusing on (real or imagined) same-sex or same-gender relationships between celebrities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002205"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002142"},{"@id":"https://homosaurus.org/v3/homoit0002147"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002143","dc:identifier":"homoit0002143","skos:prefLabel":{"@language":"en","@value":"Alternate universe settings (Fanfiction)"},"skos:altLabel":{"@language":"en","@value":"AU (Fanfiction)"},"rdfs:comment":{"@language":"en","@value":"Settings alternative to the canonical universe of a text in which fanfiction might take place."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002160"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002186"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002210"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002186","dc:identifier":"homoit0002186","skos:prefLabel":{"@language":"en","@value":"Omegaverse"},"skos:altLabel":[{"@language":"en","@value":"A/B/O"},{"@language":"en","@value":"ABO"},{"@language":"en","@value":"Alpha/Beta/Omega"}],"rdfs:comment":{"@language":"en","@value":"The alternate universe fanworks trope in which society is divided into three categories of people: alphas, betas, and omegas. Fanworks in the omegaverse often depict characters with genitalia and breeding behaviors (such as heat cycles) similar to wolves. Use to describe fanworks in the omegaverse that focus on LGBTQ+ people and issues."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002143"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002184"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002176"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002173","dc:identifier":"homoit0002173","skos:prefLabel":[{"@language":"en","@value":"Hentai fandom"},{"@language":"ja","@value":"Hentai fandom"}],"rdfs:comment":{"@language":"en","@value":"The fan community that focuses on, incorporates, or details the relationships of characters in hentai, or sexually explicit anime and manga."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002144"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002172"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002221","dc:identifier":"homoit0002221","skos:prefLabel":[{"@language":"en","@value":"Yuri fandom"},{"@language":"ja","@value":"Yuri fandom"}],"rdfs:comment":{"@language":"en","@value":"The fan community that focuses on, incorporates, or details the romantic or sexual relationships between female characters from anime and manga."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0002144"},{"@id":"https://homosaurus.org/v3/homoit0003507"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002220"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0002162"},{"@id":"https://homosaurus.org/v3/homoit0002203"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002214","dc:identifier":"homoit0002214","skos:prefLabel":{"@language":"ja","@value":"Uke (Yaoi)"},"rdfs:comment":{"@language":"en","@value":"Term used in yaoi and yaoi fan communities to describe the receiving or submissive partner in a fictional male-male relationship."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002217"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0002151"},{"@id":"https://homosaurus.org/v3/homoit0002152"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002218","dc:identifier":"homoit0002218","skos:prefLabel":[{"@language":"en","@value":"Yaoi fandom"},{"@language":"ja","@value":"Yaoi fandom"}],"rdfs:comment":{"@language":"en","@value":"The fan community that focuses on, incorporates, or details the sexual or romantic relationships between male characters from anime and manga."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002152"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002164"},{"@id":"https://homosaurus.org/v3/homoit0002217"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003500","dc:identifier":"homoit0003500","skos:prefLabel":{"@language":"en","@value":"Danmei"},"skos:altLabel":{"@language":"en","@value":"Dānměi"},"rdfs:comment":{"@language":"en","@value":"A genre focusing on the romantic or sexual relationships between male characters in Chinese novels, comics, movies, animation, and dramas."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002152"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002155","dc:identifier":"homoit0002155","skos:prefLabel":{"@language":"en","@value":"Fanart"},"skos:altLabel":{"@language":"en","@value":"Fan art"},"rdfs:comment":{"@language":"en","@value":"Art created by fans that relates to media properties or other subjects of fandom."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002161"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002201"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0002159"},{"@id":"https://homosaurus.org/v3/homoit0002204"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002204","dc:identifier":"homoit0002204","skos:prefLabel":{"@language":"en","@value":"Slash fanworks"},"skos:altLabel":{"@language":"en","@value":"Slash fan works"},"rdfs:comment":{"@language":"en","@value":"Works created by fans that focus on romantic or sexual relationships between characters of the same sex or gender. Typically erotic or pornographic in nature. Historically used for male-male couples only, but is now used more broadly; includes femslash fanworks."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0002161"},{"@id":"https://homosaurus.org/v3/homoit0002203"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002201"},{"@id":"https://homosaurus.org/v3/homoit0002205"},{"@id":"https://homosaurus.org/v3/homoit0002206"},{"@id":"https://homosaurus.org/v3/homoit0002207"},{"@id":"https://homosaurus.org/v3/homoit0002209"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0002155"},{"@id":"https://homosaurus.org/v3/homoit0002217"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002167","dc:identifier":"homoit0002167","skos:prefLabel":{"@language":"en","@value":"Furry fandom"},"skos:altLabel":[{"@language":"en","@value":"Furry community"},{"@language":"en","@value":"Furry fan community"}],"rdfs:comment":{"@language":"en","@value":"The fan community that focuses on, incorporates, or details anthropomorphized animals."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002156"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002165"},{"@id":"https://homosaurus.org/v3/homoit0002166"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2017003411"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002199","dc:identifier":"homoit0002199","skos:prefLabel":{"@language":"en","@value":"Shipping in fandom"},"rdfs:comment":{"@language":"en","@value":"Term used to describe fans' desire to see certain characters in sexual or romantic relationships, as well as the practice of pairing those characters in fanworks. The terms \"shipping\" and \"ship\" come from \"relationship.\""},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002156"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002189"},{"@id":"https://homosaurus.org/v3/homoit0002198"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002180"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002203","dc:identifier":"homoit0002203","skos:prefLabel":{"@language":"en","@value":"Slash fandom"},"skos:altLabel":{"@language":"en","@value":"Slash fan community"},"rdfs:comment":{"@language":"en","@value":"The fan community that focuses on, incorporates, or details relationships between two characters of the same sex or gender (usually fictional, with \"Real person fiction\" as an exception). Historically used for male-male couples only, but is now used more broadly; includes femslash fandom."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002156"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002200"},{"@id":"https://homosaurus.org/v3/homoit0002202"},{"@id":"https://homosaurus.org/v3/homoit0002204"},{"@id":"https://homosaurus.org/v3/homoit0002205"},{"@id":"https://homosaurus.org/v3/homoit0002208"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002221"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002176","dc:identifier":"homoit0002176","skos:prefLabel":{"@language":"en","@value":"Kink in fandom"},"skos:altLabel":{"@language":"en","@value":"Kink in fan communities"},"rdfs:comment":{"@language":"en","@value":"Representations of non-conventional or marginalized sexual practices in fanfiction."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002160"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0002181"},{"@id":"https://homosaurus.org/v3/homoit0002186"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002187","dc:identifier":"homoit0002187","skos:prefLabel":{"@language":"en","@value":"One true pairing"},"skos:altLabel":{"@language":"en","@value":"OTP"},"rdfs:comment":{"@language":"en","@value":"Slang term referring to a fan's primary \"ship\" or preferred relationship within a fandom."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002189"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0002160"},{"@id":"https://homosaurus.org/v3/homoit0002177"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002200","dc:identifier":"homoit0002200","skos:prefLabel":{"@language":"en","@value":"Slash (Genre)"},"rdfs:comment":{"@language":"en","@value":"A genre of fanworks in which two or more characters of the same sex or gender are placed in sexual or romantic situations with one another. Slash fanworks are commonly erotic or pornographic. While the term \"slash\" has historically been used for male/male couples only, it has been recently been broadened to include LGBTQ+ relationships other than those between two men."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002203"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002162"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002164","dc:identifier":"homoit0002164","skos:prefLabel":{"@language":"ja","@value":"Fujoshi"},"rdfs:comment":{"@language":"en","@value":"Japanese word that literally translates to \"rotten girl\" and is used to describe young women who enjoy media or fanworks focused on romantic or sexual relationships between men. Some fans self-identify as fujoshis, typically as a form of playful self-deprecation, but it can also be considered derogatory."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002218"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002198","dc:identifier":"homoit0002198","skos:prefLabel":{"@language":"en","@value":"Ship names in fandom"},"skos:altLabel":{"@language":"en","@value":"Pairing names in fandom"},"rdfs:comment":{"@language":"en","@value":"Names used to describe common pairings in fandom. Ship names are often portmanteaus of the names of two (or more) characters in the ship (e.g., Spirk for Spock and Kirk)."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002199"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0002177"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002206","dc:identifier":"homoit0002206","skos:prefLabel":{"@language":"en","@value":"Slash manips"},"rdfs:comment":{"@language":"en","@value":"Fan-created photo manipulations or deepfakes depicting sexual or romantic relationships between characters from various media properties. Typically erotic or pornographic in nature. Historically used for male-male couples only, but is now used more broadly; includes femslash manips."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002204"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002209","dc:identifier":"homoit0002209","skos:prefLabel":{"@language":"en","@value":"Slash vidding"},"rdfs:comment":{"@language":"en","@value":"Creating videos about sexual or romantic relationships between same-sex or -gender couples using scenes from television, movies, or video games. Historically used for male-male couples only, but is now used more broadly; includes femslash vidding."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002204"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0003662"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002225","dc:identifier":"homoit0002225","skos:prefLabel":{"@language":"en","@value":"Parents of non-binary people"},"skos:altLabel":[{"@language":"en","@value":"Non-binary people's parents"},{"@language":"en","@value":"Nonbinary people's parents"},{"@language":"en","@value":"Parents of nonbinary people"}],"rdfs:comment":{"@language":"en","@va