/homoit0003444"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001305"},"dc:replaces":{"@id":"http://homosaurus.org/v2/correctiveRape"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000783","dc:identifier":"homoit0000783","skos:prefLabel":{"@language":"en","@value":"Lesbian survivors of rape"},"rdfs:comment":{"@language":"en","@value":"Lesbians who have experienced and survived rape; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000793"},{"@id":"https://homosaurus.org/v3/homoit0001350"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000306"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianSurvivorsOfRape"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000793","dc:identifier":"homoit0000793","skos:prefLabel":{"@language":"en","@value":"Lesbian victims of rape"},"rdfs:comment":{"@language":"en","@value":"Lesbians who have experienced rape and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000958"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000783"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000306"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianVictimsOfRape"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"