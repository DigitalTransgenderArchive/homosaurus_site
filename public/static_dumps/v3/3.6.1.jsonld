tion centers"},{"@language":"en-gb","@value":"AIDS information centres"}],"rdfs:comment":{"@language":"en","@value":"Institutions dedicated to education, prevention, and treatment of HIV/AIDS; AIDS information centers often provide services like HIV counseling and testing services."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000660"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000005"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2021005736"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/AIDSInformationCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000027","dc:identifier":"homoit0000027","skos:prefLabel":{"@language":"en","@value":"AIDS education"},"rdfs:comment":{"@language":"en","@value":"Instruction about HIV/AIDS, including topics like the history of the AIDS epidemic, contraction, prevention, and treatment."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000661"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000005"},{"@id":"https://homosaurus.org/v3/homoit0001251"},{"@id":"https://homosaurus.org/v3/homoit0001271"},{"@id":"https://homosaurus.org/v3/homoit0001294"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2009114510"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000661"},"dc:replaces":{"@id":"http://homosaurus.org/v2/AIDSEducation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000028","dc:identifier":"homoit0000028","skos:prefLabel":{"@language":"en","@value":"AIDS memorial quilts"},"rdfs:comment":{"@language":"