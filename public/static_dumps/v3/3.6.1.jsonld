":{"@language":"en","@value":"Gay films"},"skos:altLabel":{"@language":"en","@value":"Gay movies"},"rdfs:comment":{"@language":"en","@value":"Motion pictures, or movies, created by gay directors, depicting gay men, or that are regarded as important within gay culture."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000869"},{"@id":"https://homosaurus.org/v3/homoit0002330"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000520"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005008640"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-15"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002608","dc:identifier":"homoit0002608","skos:prefLabel":{"@language":"en","@value":"Gay erotic art"},"rdfs:comment":{"@language":"en","@value":"Erotic art, created by gay artists, depicting gay people, or that are regarded as important within gay culture."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002579"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000520"},{"@id":"https://homosaurus.org/v3/homoit0002547"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002598"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002536"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002547","dc:identifier":"homoit0002547","skos:prefLabel":{"@language":"en","@value":"Gay erotic films "},"rdfs:comment":{"@language":"en","@value":"Erotic films or movies, created by gay directors, depicting gay people, or that are regarded as important within gay culture."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0002544"},{"@id":"https://homosaurus.org/v3/homoit0002608"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000520"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006001636"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003156","dc:identifier":"homoit0003156","skos:prefLabel":{"@language":"en","@value":"Gay zines"},"rdfs:comment":{"@language":"en","@value":"Independent, small-circulation publications usually reproduced via photocopier; use for zines created by gay people and/or focusing on gay identity, issues, or culture."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000521"},{"@id":"https://homosaurus.org/v3/homoit0000965"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001132"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-02"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000523","dc:identifier":"homoit0000523","skos:prefLabel":{"@language":"en","@value":"Gay Pride Week"},"skos:altLabel":[{"@language":"en","@value":"Pink Saturday"},{"@language":"en","@value":"Pink Week"},{"@language":"en","@value":"Pride Week"}],"rdfs:comment":{"@language":"en","@value":"A period of public recognition and celebration of LGBTQ+ people and culture, usually organized over the course of a week with local events, parades, marches, and rallies. Gay pride week occurs at different times during the year in different places but is typically held in June in the United States to commemorate the Stonewall uprising."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0003654"},"skos:closeMatch":{"@i