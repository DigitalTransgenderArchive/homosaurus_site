-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001027","dc:identifier":"homoit0001027","skos:prefLabel":{"@language":"en","@value":"MtXs"},"rdfs:comment":{"@language":"en","@value":"People who transition from male to unknown or not male."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001378"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000436"},{"@id":"https://homosaurus.org/v3/homoit0000457"},{"@id":"https://homosaurus.org/v3/homoit0000986"},{"@id":"https://homosaurus.org/v3/homoit0001518"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mtxs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000444","dc:identifier":"homoit0000444","skos:prefLabel":{"@language":"en","@value":"First-wave feminism"},"skos:altLabel":{"@language":"en","@value":"First wave feminism"},"rdfs:comment":{"@language":"en","@value":"Period of women's rights activism in the 19th and early 20th centuries that was primarily focused on legal rights such as women's right to vote."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000437"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0003172"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008001557"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000437"},"dc:replaces":{"@id":"http://homosaurus.org/v2/firstWaveFeminism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000622","dc:identifier":"homoit0000622","skos:prefLabel":{"@language":"en","@value":"Heterosexual feminism"},"rdfs:comment":{"@language":"en","@value":"A form of feminism that prioritizes the experiences of heterosexual women and focuses on securing equitable economic, political, and social rights for heterosexual women. Often discussed in juxtaposition to political lesbianism."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000437"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000741"},{"@id":"https://homosaurus.org/v3/homoit0001133"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000437"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexualFeminism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000741","dc:identifier":"homoit0000741","skos:prefLabel":{"@language":"en","@value":"Lesbian feminism"},"rdfs:comment":{"@language":"en","@value":"A cultural movement and critical perspective that arose in the 1970s and 1980s primarily in North America and Western Europe as a result of dissatisfaction with the women's liberation movement and the gay liberation movement. Lesbian feminism encourages women to focus their efforts, activities, and relationships toward other women rather than men, often advocating for lesbianism as the logical result of feminism."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000437"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000622"},{"@id":"https://homosaurus.org/v3/homoit0000753"},{"@id":"https://homosaurus.org/v3/homoit0003169"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93000705"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000437"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianFeminism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001230","dc:identifier":"homoit0001230","skos:prefLabel":{"@language":"en","@value":"Radical feminism"},"rdfs:comment":{"@language":"en","@value":"Perspective within feminism that calls for a radical reordering of society in which male supremacy is eliminated in all social and economic contexts."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000437"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001133"},{"@id":"https://homosaurus.org/v3/homoit0001516"},{"@id":"https://homosaurus.org/v3/homoit0003177"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000437"},"dc:replaces":{"@id":"http://homosaurus.org/v2/radicalFeminism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001260","dc:identifier":"homoit0001260","skos:prefLabel":{"@language":"en","@value":"Second-wave feminism"},"skos:altLabel":{"@language":"en","@value":"Second wave feminism"},"rdfs:comment":{"@language":"en","@value":"Period of feminist political activity (also referred to as women’s liberation) beginning in the early 1960s that critiqued male-dominated institutions and cultural practices in society."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000437"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0003158"},{"@id":"https://homosaurus.org/v3/homoit0003173"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008001560"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000437"},"dc:replaces":{"@id":"http://homosaurus.org/v2/secondWaveFeminism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002270","dc:identifier":"homoit0002270","skos:prefLabel":{"@language":"en","@value":"Black feminism"},"skos:altLabel":[{"@language":"en","@value":"Afro feminism"},{"@language":"en","@value":"Afro-feminism"}],"rdfs:comment":{"@language":"en","@value":"A form of feminism that developed in response to the failures of mainstream feminist and civil rights efforts to acknowledge the ways white supremacy and the patriarchy interact to inform the particular experiences of Black women."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000437"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000667"},{"@id":"https://homosaurus.org/v3/homoit0002038"},{"@id":"https://homosaurus.org/v3/homoit0002272"},{"@id":"https://homosaurus.org/v3/homoit0003170"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000437"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-08"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002271","dc:identifier":"homoit0002271","skos:prefLabel":{"@language":"en","@value":"White feminism"},"rdfs:comment":{"@language":"en","@value":"Term used to describe (and criticize) forms of feminism that focus on the needs of white women at the expense of women of color."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000437"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000667"},{"@id":"https://homosaurus.org/v3/homoit0001133"},{"@id":"https://homosaurus.org/v3/homoit0002038"},{"@id":"https://homosaurus.org/v3/homoit0002272"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2021008248"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000437"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-08"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002274","dc:identifier":"homoit0002274","skos:prefLabel":{"@language":"en","@value":"Transfeminism"},"skos:altLabel":{"@language":"en","@value":"Trans feminism"},"rdfs:comment":{"@language":"en","@value":"As defined by Emi Koyama, transfeminism is a movement by and for trans woman who view the liberation of trans women as essential to the liberation of all women."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000437"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000667"},{"@id":"https://homosaurus.org/v3/homoit0001642"},{"@id":"https://homosaurus.org/v3/homoit0001892"},{"@id":"https://homosaurus.org/v3/homoit0003175"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000437"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-08"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002275","dc:identifier":"homoit0002275","skos:prefLabel":{"@language":"en","@value":"Third-wave feminism"},"skos:altLabel":{"@language":"en","@value":"Third wave feminism"},"rdfs:comment":{"@language":"en","@value":"Period of feminist political activity beginning in the early 1990s that embraced diversity and individualism in women and sought to redefine what it meant to be a feminist. The third wave is characterized by the emergence of new feminist movements and theories such as intersectionality, sex positivity, ecofeminism, transfeminism, and postmodern feminism."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000437"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0003174"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008001561"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000437"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-08"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003101","dc:identifier":"homoit0003101","skos:prefLabel":{"@language":"en","@value":"Sex-positive feminism"},"skos:altLabel":{"@language":"en","@value":"Sex-positive movement"},"rdfs:comment":{"@language":"en","@value":"A broad feminist movement, usually compared against the anti-sex or anti-pornography feminist movement, that supports sexual liberation, sex workers, pornography, and freedom of sexual and gender expression."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000437"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001319"},{"@id":"https://homosaurus.org/v3/homoit0003121"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000437"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003121","dc:identifier":"homoit0003121","skos:prefLabel":{"@language":"en","@value":"Feminist Sex Wars"},"skos:altLabel":[{"@language":"en","@value":"Porn wars"},{"@language":"en","@value":"Sex wars"}],"rdfs:comment":{"@language":"en","@value":"A period of debates beginning in the 1970s between different schools and factions of feminist thought concerning sexual freedom, sex work, pornography, kink and sadomasochism, sex toys, butch/femme, and trans identities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000437"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0003101"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000437"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000438","dc:identifier":"homoit0000438","skos:prefLabel":{"@language":"en","@value":"Women's movement"},"skos:altLabel":{"@language":"en","@value":"Feminist movement"},"rdfs:comment":{"@language":"en","@value":"Social and political movement originating in the 1800s for reforms on women’s issues stemming from social, cultural, political, and economic inequality between men and women. Feminist issues include reproductive rights, women’s liberation, and equal pay. This term encompasses the women’s movement in its entirety, including different waves of feminist thought and activism."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001322"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000437"},{"@id":"https://homosaurus.org/v3/homoit0000753"},{"@id":"https://homosaurus.org/v3/homoit0002290"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85047741"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womensMovement"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001505","dc:identifier":"homoit0001505","skos:prefLabel":{"@language":"en","@value":"Wimmin"},"rdfs:comment":{"@language":"en","@value":"A way of spelling \"women\" that is used in certain feminist circles. First used by George P. Krapp (1872-1934) and then appeared in 19th century Black American English renderings before being used by feminists in the 20th century.\r\n"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000437"},{"@id":"https://homosaurus.org/v3/homoit0001509"},{"@id":"https://homosaurus.org/v3/homoit0001516"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001505"},"dc:replaces":{"@id":"http://homosaurus.org/v2/wimmin"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-03-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002039","dc:identifier":"homoit0002039","skos:prefLabel":{"@language":"en","@value":"Feminist theory"},"skos:altLabel":[{"@language":"en","@value":"Feminist philosophy"},{"@language":"en","@value":"Theory of feminism"}],"rdfs:comment":{"@language":"en","@value":"The extension of feminism into theoretical, fictional, or philosophical discourse, often seeking to understand the nature of gender inequity."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001365"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0002040"},{"@id":"https://homosaurus.org/v3/homoit0002041"},{"@id":"https://homosaurus.org/v3/homoit0003444"},{"@id":"https://homosaurus.org/v3/homoit0003706"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000437"},{"@id":"https://homosaurus.org/v3/homoit0000579"},{"@id":"https://homosaurus.org/v3/homoit0001210"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh90002282"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0002290","dc:identifier":"homoit0002290","skos:prefLabel":{"@language":"en","@value":"Gender equality"},"rdfs:comment":{"@language":"en","@value":"The state of equal ease of access to resources and opportunities regardless of gender, including economic participation and decision-making, as well as the state of valuing different behaviors, aspirations, and needs equally, regardless of gender."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000652"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000437"},{"@id":"https://homosaurus.org/v3/homoit0000438"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000652"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-10"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003157","dc:identifier":"homoit0003157","skos:prefLabel":{"@language":"en","@value":"Trans-exclusionary radical feminists"},"skos:altLabel":[{"@language":"en","@value":"Gender critical feminists"},{"@language":"en","@value":"TERFs"},{"@language":"en","@value":"Trans-exclusionary feminist"}],"rdfs:comment":{"@language":"en","@value":"A person who subscribes to a transphobic and transantagonistic ideology that rejects trans and gender diverse identities and rights, and believes that recognition of these identities and rights constitutes discrimination and oppression towards cisgender women. Though originally considered a fringe offshoot of feminism, trans-exclusionary radical feminist groups have formed alliances with right-wing, far-right extremists, and anti-feminist organizations in order to spread misinformation and further anti-trans sentiment and legislation. Use when resources are about trans-exclusionary radical feminists or when an individual identifies as such. "},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000437"},{"@id":"https://homosaurus.org/v3/homoit0003158"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0003157"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-02"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000753","dc:identifier":"homoit0000753","skos:prefLabel":{"@language":"en","@value":"Lesbian movement"},"skos:altLabel":[{"@language":"en","@value":"Lesbian organisations"},{"@language":"en","@value":"Lesbian organizations"}],"rdfs:comment":{"@language":"en","@value":"Umbrella term for activism focused on the rights of lesbians and issues faced by lesbian communities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001026"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000791"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000438"},{"@id":"https://homosaurus.org/v3/homoit0000500"},{"@id":"https://homosaurus.org/v3/homoit0000734"},{"@id":"https://homosaurus.org/v3/homoit0000737"},{"@id":"https://homosaurus.org/v3/homoit0000741"},{"@id":"https://homosaurus.org/v3/homoit0000746"},{"@id":"https://homosaurus.org/v3/homoit0000757"},{"@id":"https://homosaurus.org/v3/homoit0000766"},{"@id":"https://homosaurus.org/v3/homoit0000772"},{"@id":"https://homosaurus.org/v3/homoit0000787"},{"@id":"https://homosaurus.org/v3/homoit0003169"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianMovement"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000439","dc:identifier":"homoit0000439","skos:prefLabel":{"@language":"en","@value":"Feminists"},"rdfs:comment":{"@language":"en","@value":"People who support and advocate for defining, establishing, and defending equal political, economic, and social rights and opportunities for women. "},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001346"},{"@id":"https://homosaurus.org/v3/homoit0003169"},{"@id":"https://homosaurus.org/v3/homoit0003170"},{"@id":"https://homosaurus.org/v3/homoit0003171"},{"@id":"https://homosaurus.org/v3/homoit0003172"},{"@id":"https://homosaurus.org/v3/homoit0003173"},{"@id":"https://homosaurus.org/v3/homoit0003174"},{"@id":"https://homosaurus.org/v3/homoit0003175"},{"@id":"https://homosaurus.org/v3/homoit0003177"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85047761"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000439"},"dc:replaces":{"@id":"http://homosaurus.org/v2/feminists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001346","dc:identifier":"homoit0001346","skos:prefLabel":{"@language":"en","@value":"Suffragettes"},"rdfs:comment":{"@language":"en","@value":"Women who seek the right to vote, often through organized protest; typically used to describe members of political movements in the late 1800s and early 1900s focusing on women’s right to vote in the U.S. and Britain."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000439"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85129648"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000439"},"dc:replaces":{"@id":"http://homosaurus.org/v2/suffragettes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003169","dc:identifier":"homoit0003169","skos:prefLabel":{"@language":"en","@value":"Lesbian feminists"},"rdfs:comment":{"@language":"en","@value":"A person who subscribes to lesbian feminism, an ideology that encourages women to focus their efforts, activities, and relationships toward other women rather than men, often advocating for lesbianism as the logical result of feminism. Use when resources are about lesbian feminists or when an individual identifies as such."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000439"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000741"},{"@id":"https://homosaurus.org/v3/homoit0000753"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93000705"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000439"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-11"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003170","dc:identifier":"homoit0003170","skos:prefLabel":{"@language":"en","@value":"Black feminists"},"skos:altLabel":[{"@language":"en","@value":"Afro feminists"},{"@language":"en","@value":"Afro-feminists"}],"rdfs:comment":{"@language":"en","@value":"A person who subscribes to a form of feminism that developed in response to the failures of mainstream feminist and civil rights efforts to acknowledge the ways white supremacy and the patriarchy interact to inform the particular experiences of Black women. Use when resources are about Black feminists or when an individual identifies as such."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000439"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0002270"},{"@id":"https://homosaurus.org/v3/homoit0003176"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000439"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-11"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003172","dc:identifier":"homoit0003172","skos:prefLabel":{"@language":"en","@value":"First-wave feminists"},"skos:altLabel":{"@language":"en","@value":"First wave feminists"},"rdfs:comment":{"@language":"en","@value":"A person who was part of a period of women's rights activism in the 19th and early 20th centuries that was primarily focused on legal rights such as women's right to vote. Use when resources are about first-wave feminists."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000439"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000444"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000439"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-11"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003173","dc:identifier":"homoit0003173","skos:prefLabel":{"@language":"en","@value":"Second-wave feminists"},"skos:altLabel":{"@language":"en","@value":"Second wave feminists"},"rdfs:comment":{"@language":"en","@value":"A person who was part of or subscribes to beliefs developed during a period of feminist political activity (also referred to as women’s liberation) beginning in the early 1960s that critiqued male-dominated institutions and cultural practices in society. Use when resources are about second-wave feminists or when an individual identifies as such."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000439"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001260"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000439"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-11"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003174","dc:identifier":"homoit0003174","skos:prefLabel":{"@language":"en","@value":"Third-wave feminists"},"skos:altLabel":{"@language":"en","@value":"Third wave feminists"},"rdfs:comment":{"@language":"en","@value":"A person who was part of or subscribes to beliefs developed during a period of feminist political activity beginning in the early 1990s that embraced diversity and individualism in women and sought to redefine what it meant to be a feminist. The third-wave is characterized by the emergence of new feminist movements and theories such as intersectionality, sex positivity, ecofeminism, transfeminism, and postmodern feminism. Use when resources are about third-wave feminists or when an individual identifies as such."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000439"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002275"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000439"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-11"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003175","dc:identifier":"homoit0003175","skos:prefLabel":{"@language":"en","@value":"Transfeminists"},"rdfs:comment":{"@language":"en","@value":"A person who is part of or subscribes to beliefs developed as part of a movement by and for trans woman who view the liberation of trans women as essential to the liberation of all women. Use when resources are about transfeminists or when an individual identifies as such."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000439"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002274"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000439"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-11"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0003177","dc:identifier":"homoit0003177","skos:prefLabel":{"@language":"en","@value":"Radical feminists"},"rdfs:comment":{"@language":"en","@value":"A person who subscribes to a perspective within feminism that calls for a radical reordering of society in which male supremacy is eliminated in all social and economic contexts. Distinct from and not to be confused with trans-exclusionary radical feminists. Use for resources about radical feminists or for individuals who identify as such, unless trans-exclusionary radical feminists is a more appropriate term."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000439"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001230"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000439"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-11"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:i