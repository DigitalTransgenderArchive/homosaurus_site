/homoit0001363"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayTheatre"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000547","dc:identifier":"homoit0000547","skos:prefLabel":["Gay theater groups","Gay theatre groups"],"rdfs:comment":"Groups of theatrical performers comprised of gay men; may focus on performing works written by gay men or about gay issues.","skos:related":["https://homosaurus.org/v3/homoit0000546","https://homosaurus.org/v3/homoit0000789","https://homosaurus.org/v3/homoit0001031"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000547"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayTheatreGroups"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0000548","dc:identifier":"homoit0000548","skos:prefLabel":"Gay theology","skos:broader":"https://homosaurus.org/v3/homoit0001364","skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001364"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001218"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayTheology"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-22"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000549","dc:identifier":"homoit0000549","skos:prefLabel":"Gay trade union groups","rdfs:comment":"Organized groups of gay workers who are united to make decisions relating to the conditions affecting their labor.","skos:broader":"https://homosaurus.org/v3/homoit0000510","skos:relate