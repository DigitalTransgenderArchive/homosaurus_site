odified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000165","dc:identifier":"homoit0000165","skos:prefLabel":"Native American bisexual people","skos:altLabel":["American Indian bisexual people","Bisexual American Indians","Bisexual Native Americans"],"rdfs:comment":"People who are part of the Native peoples of the continental United States and Canada (excluding Inuit people) and self-identity as bisexual. Use more specific terms when available.","skos:broader":"https://homosaurus.org/v3/homoit0001037","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualNativeAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000166","dc:identifier":"homoit0000166","skos:prefLabel":"Bisexual newsletters","rdfs:comment":"Serialized print or digital periodicals created by or for bisexual people, often with the purpose of sharing news and information related to bisexual communities and bisexual issues.","skos:broader":["https://homosaurus.org/v3/homoit0000177","https://homosaurus.org/v3/homoit0001041"],"skos:related":"https://homosaurus.org/v3/homoit0000167","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualNewsletters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001132","dc:identifier":"homoit0001132","skos:prefLabel":"LGBTQ+ press","skos:altLabel":"Press (LGBTQ)","rdfs:comment":"Newspapers, magazines, or other publishing outlets aimed at LGBTQ+ audiences and/or operated by LGBTQ+ people.","skos:narrower":["https://homosaurus.org/v3/homoit0000177","https://homosaurus.org/v3/homoit0000521","https://homosaurus.org/v3/homoit0000766","https://homosaurus.org/v3/homoit0000896","https://homosaurus.org/v3/homoit0000923","https://homosaurus.org/v3/homoit0000965","https://homosaurus.org/v3/homoit0001041","https://homosaurus.org/v3/homoit0001042","https://homosaurus.org/v3/homoit0001200","https://homosaurus.org/v3/homoit0001436","https://homosaurus.org/v3/homoit0002804","https://homosaurus.org/v3/homoit0002936"],"skos:related":["https://homosaurus.org/v3/homoit0000031","https://homosaurus.org/v3/homoit0000216","https://homosaurus.org/v3/homoit0000827","https://homosaurus.org/v3/homoit0000972","https://homosaurus.org/v3/homoit0002719"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pressLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000167","dc:identifier":"homoit0000167","skos:prefLabel":"Bisexual newspapers","rdfs:comment":"Serialized print or digital publications about bisexuality or bisexual issues (and typically produced by bisexual people or organizations) that contain news, articles, columns, correspondence, and advertisements.","skos:broader":["https://homosaurus.org/v3/homoit0000177","https://homosaurus.org/v3/homoit0001042"],"skos:related":"https://homosaurus.org/v3/homoit0000166","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualNewspapers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000168","dc:identifier":"homoit0000168","skos:prefLabel":"Bisexual Pagans","rdfs:comment":"Bisexual people who are members of polytheistic religions or other religions outside of the dominant culture that typically incorporate nature worship and/or the sacred feminine, such as Wicca, Druidry, Heathenry, etc. Use to describe bisexual people who self-identify as Pagan.","skos:broader":"https://homosaurus.org/v3/homoit0001069","skos:related":"https://homosaurus.org/v3/homoit0001910","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualPagans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000169","dc:identifier":"homoit0000169","skos:prefLabel":"Bisexual parents","rdfs:comment":"Parents who are bisexual.","skos:broader":["https://homosaurus.org/v3/homoit0000170","https://homosaurus.org/v3/homoit0001075"],"skos:related":["https://homosaurus.org/v3/homoit0000150","https://homosaurus.org/v3/homoit0000257"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh98004191"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualParents"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000170","dc:identifier":"homoit0000170","skos:prefLabel":"Bisexual people","skos:altLabel":"Bisexuals","rdfs:comment":"Individuals who are romantically and/or sexually attracted to more than one gender and who identify as bisexual; do not use to describe pansexual or polysexual people unless they also use the term bisexual.","skos:broader":["https://homosaurus.org/v3/homoit0000108","https://homosaurus.org/v3/homoit0000915","https://homosaurus.org/v3/homoit0001297"],"skos:narrower":["https://homosaurus.org/v3/homoit0000140","https://homosaurus.org/v3/homoit0000160","https://homosaurus.org/v3/homoit0000169","https://homosaurus.org/v3/homoit0000192","https://homosaurus.org/v3/homoit0000202","https://homosaurus.org/v3/homoit0000285","https://homosaurus.org/v3/homoit0001054","https://homosaurus.org/v3/homoit0003035"],"skos:related":["https://homosaurus.org/v3/homoit0000117","https://homosaurus.org/v3/homoit0000133","https://homosaurus.org/v3/homoit0000134","https://homosaurus.org/v3/homoit0000136","https://homosaurus.org/v3/homoit0000139","https://homosaurus.org/v3/homoit0000143","https://homosaurus.org/v3/homoit0000144","https://homosaurus.org/v3/homoit0000150","https://homosaurus.org/v3/homoit0000153","https://homosaurus.org/v3/homoit0000173","https://homosaurus.org/v3/homoit0000204","https://homosaurus.org/v3/homoit0001073","https://homosaurus.org/v3/homoit0001103","https://homosaurus.org/v3/homoit0001531","https://homosaurus.org/v3/homoit0002150"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93003390"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000171","dc:identifier":"homoit0000171","skos:prefLabel":"Bisexual people in the military","rdfs:comment":"Bisexual individuals serving in state and national armed forces.","skos:broader":"https://homosaurus.org/v3/homoit0001100","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualPeopleInTheMilitary"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000172","dc:identifier":"homoit0000172","skos:prefLabel":["Bisexual people of color","Bisexual people of colour"],"rdfs:comment":"Primarily used in the United States, this term refers to bisexual people who are not white and who identify as people of color.","skos:broader":"https://homosaurus.org/v3/homoit0001101","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualPeopleOfColour"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000173","dc:identifier":"homoit0000173","skos:prefLabel":"Parents of bisexual people","skos:altLabel":"Bisexual people’s parents","rdfs:comment":"People who act as parents to one or more bisexual person. For parents who are themselves bisexual, use the term \"Bisexual parents.\"","skos:broader":"https://homosaurus.org/v3/homoit0002224","skos:related":"https://homosaurus.org/v3/homoit0000170","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/parentsOfBisexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000174","dc:identifier":"homoit0000174","skos:prefLabel":"Bisexual poetry","rdfs:comment":"Literary work, typically written in verse, that focuses on bisexual characters, themes, or identity.","skos:broader":"https://homosaurus.org/v3/homoit0001118","skos:related":["https://homosaurus.org/v3/homoit0000157","https://homosaurus.org/v3/homoit0001726"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualPoetry"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000175","dc:identifier":"homoit0000175","skos:prefLabel":"Bisexual political activists","rdfs:comment":"Bisexual individuals working to bring about political or social change through public organizing.","skos:broader":"https://homosaurus.org/v3/homoit0000007","skos:related":"https://homosaurus.org/v3/homoit0000122","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualPoliticalActivists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000176","dc:identifier":"homoit0000176","skos:prefLabel":"Bisexual porn films","rdfs:comment":"Erotic or sexually explicit films featuring bisexual people.","skos:broader":["https://homosaurus.org/v3/homoit0000013","https://homosaurus.org/v3/homoit0002609"],"skos:related":"https://homosaurus.org/v3/homoit0002548","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualPornFilms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000177","dc:identifier":"homoit0000177","skos:prefLabel":"Bisexual press","rdfs:comment":"Newspapers, magazines, or other publishing outlets aimed at bisexual audiences and/or operated by bisexual people.","skos:broader":"https://homosaurus.org/v3/homoit0001132","skos:narrower":["https://homosaurus.org/v3/homoit0000166","https://homosaurus.org/v3/homoit0000167"],"skos:related":["https://homosaurus.org/v3/homoit0000162","https://homosaurus.org/v3/homoit0000896"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualPress"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000178","dc:identifier":"homoit0000178","skos:prefLabel":"Bisexual sex workers","skos:altLabel":["Bisexual prostitutes","Bi sex workers","Bi prostitutes","Bisexual prostitution","Bisexual sex work"],"rdfs:comment":"Bisexual people who receive money or goods in exchange for sexual services, performances, or companionship. Use to describe bisexual people working across the broad spectrum of sex work.","skos:broader":"https://homosaurus.org/v3/homoit0001277","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003758"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualProstitutes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003758","dc:identifier":"homoit0003758","skos:prefLabel":"Sex workers","skos:altLabel":["Prostitutes","Hookers","Hustlers","Pros"],"rdfs:comment":"People who receive money or goods in exchange for sexual services or performances. Use to describe people working across the broad spectrum of sex work, and use more specific terms if possible.","skos:narrower":["https://homosaurus.org/v3/homoit0001277","https://homosaurus.org/v3/homoit0001111","https://homosaurus.org/v3/homoit0001343","https://homosaurus.org/v3/homoit0000433","https://homosaurus.org/v3/homoit0000236","https://homosaurus.org/v3/homoit0000406","https://homosaurus.org/v3/homoit0003761","https://homosaurus.org/v3/homoit0003762","https://homosaurus.org/v3/homoit0003769","https://homosaurus.org/v3/homoit0003793","https://homosaurus.org/v3/homoit0003801"],"skos:related":["https://homosaurus.org/v3/homoit0000494","https://homosaurus.org/v3/homoit0001276"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2017000417"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003758"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000179","dc:identifier":"homoit0000179","skos:prefLabel":"Bisexual Protestants","rdfs:comment":"Bisexual people who are members of the Protestant church.","skos:broader":"https://homosaurus.org/v3/homoit0001137","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualProtestants"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000180","dc:identifier":"homoit0000180","skos:prefLabel":"Bisexual publishers","rdfs:comment":"Companies and organizations that publish materials for bisexual communities or addressing bisexual issues.","skos:broader":"https://homosaurus.org/v3/homoit0001144","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001144"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualPublishers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001144","dc:identifier":"homoit0001144","skos:prefLabel":"LGBTQ+ publishers","skos:altLabel":"Publishers (LGBTQ)","rdfs:comment":"Publishers that publish materials for LGBTQ+ communities or materials addressing LGBTQ+ issues.","skos:narrower":["https://homosaurus.org/v3/homoit0000180","https://homosaurus.org/v3/homoit0000527","https://homosaurus.org/v3/homoit0000771","https://homosaurus.org/v3/homoit0001203","https://homosaurus.org/v3/homoit0001440","https://homosaurus.org/v3/homoit0002805","https://homosaurus.org/v3/homoit0002937"],"skos:related":["https://homosaurus.org/v3/homoit0001830","https://homosaurus.org/v3/homoit0002720"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001144"},"dc:replaces":{"@id":"http://homosaurus.org/v2/publishersLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000181","dc:identifier":"homoit0000181","skos:prefLabel":"Bisexual radio","rdfs:comment":"Auditory content broadcast on the radio (analog or digital) about bisexuality and bisexual issues.","skos:broader":"https://homosaurus.org/v3/homoit0001231","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001231"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualRadio"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-0