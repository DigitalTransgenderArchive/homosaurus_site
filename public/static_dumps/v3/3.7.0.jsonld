00289","skos:related":"https://homosaurus.org/v3/homoit0000114","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-11-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003816","dc:identifier":"homoit0003816","skos:prefLabel":"Female impersonation shows","skos:altLabel":["Female impersonator shows","Female impersonators' shows"],"rdfs:comment":"Theater or stage shows featuring female impersonators, a historical term used to describe performers, often male-identified people, who enact female personas for the purpose of entertainment, typically for straight audiences. Only use in historical contexts.","skos:broader":"https://homosaurus.org/v3/homoit0000878","skos:related":["https://homosaurus.org/v3/homoit0000431","https://homosaurus.org/v3/homoit0003359"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:issued":{"@type":"xsd:date","@value":"2024-11-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003817","dc:identifier":"homoit0003817","skos:prefLabel":"Male impersonation shows","skos:altLabel":["Male impersonator shows","Male impersonators' shows"],"rdfs:comment":"Theater or stage shows featuring male impersonators, a historical term used to describe performers, often female-identified people, who enact male personas for the purpose of entertainment, typically for straight audiences. Only use in historical contexts.","skos:broader":"https://homosaurus.org/v3/homoit0000878","skos:related":["https://homosaurus.org/v3/homoit0000983","https://homosaurus.org/v3/homoit0003359"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:issued":{"@type":"xsd:date","@value":"2024-11-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003818","dc:identifier":"homoit0003818","skos:prefLabel":"Hispanic non-binary people","skos:altLabel":["Hispanic nonbinary people","Non-binary Hispanic people","Nonbinary Hispanic people","Non-binary Hispanics","Nonbinary Hispanics"],"rdfs:comment":"Non-binary people who are from or descended from Spain or other regions formerly colonized by Spain that are primarily Spanish-speaking. Only use for individuals who self-identify as Hispanic; do not conflate with Latino/a/x or Chicano/a/x.","skos:broader":"https://homosaurus.org/v3/homoit0002022","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-11-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003819","dc:identifier":"homoit0003819","skos:prefLabel":"Hispanic asexual people","skos:altLabel":["Asexual Hispanic people","Asexual Hispanics"],"rdfs:comment":"Asexual people who are from or descended from Spain or other regions formerly colonized by Spain that are primarily Spanish-speaking. Only use for individuals who self-identify as Hispanic; do not conflate with Latino/a/x or Chicano/a/x.","skos:broader":"https://homosaurus.org/v3/homoit0002022","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-11-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003820","dc:identifier":"homoit0003820","skos:prefLabel":"Chicano/a/x asexual people","skos:altLabel":["Asexual Chicanas","Asexual Chicanos","Asexual Chicanx people","Asexual Chicanxs","Chicana asexual people","Chicano asexual people","Chicanx asexual people"],"rdfs:comment":"Asexual people of Mexican descent born in the United States; only use to describe people who self-identify as Chicano, Chicana, or Chicanx. Do not conflate with Latino/a/x or Hispanic people.","skos:broader":"https://homosaurus.org/v3/homoit0002007","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-12-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003821","dc:identifier":"homoit0003821","skos:prefLabel":"LGBTQ+ dating","skos:altLabel":"Dating (LGBTQ)","rdfs:comment":"Term used to describe people spending regular time together due to mutual romantic interest. Use to refer to dating between and/or as experienced by LGBTQ+ people.","skos:broader":"https://homosaurus.org/v3/homoit0001237","skos:related":["https://homosaurus.org/v3/homoit0000846","https://homosaurus.org/v3/homoit0000847"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001237"},"dc:issued":{"@type":"xsd:date","@value":"2024-12-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003822","dc:identifier":"homoit0003822","skos:prefLabel":"LGBTQ+ essays","skos:altLabel":["Essays (LGBTQ)","LGBTQ+ papers","Papers (LGBTQ)"],"rdfs:comment":"Short pieces of prose writing, typically analytical or interpretive, from an LGBTQ+ perspective or addressing LGBTQ+ issues.","skos:broader":"https://homosaurus.org/v3/homoit0000972","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-12-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003823","dc:identifier":"homoit0003823","skos:prefLabel":"Queer bodies","skos:altLabel":"Queered bodies","rdfs:comment":"Bodies that resist definition by defying social norms such as heteronormativity, cisnormativity, and other forms of essentialism, regardless of the individual's identity.","skos:broader":"https://homosaurus.org/v3/homoit0001219","skos:related":"https://homosaurus.org/v3/homoit0001195","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2024-12-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003824","dc:identifier":"homoit0003824","skos:prefLabel":"Neurogender","rdfs:comment":"Term used to describe the identity of neurodivergent people whose neurodivergence(s) greatly affect and cannot be unlinked from their gender. Only use to describe neurodivergent people who describe themselves as neurogender.","skos:broader":"https://homosaurus.org/v3/homoit0000560","skos:narrower":"https://homosaurus.org/v3/homoit0003825","skos:related":"https://homosaurus.org/v3/homoit0002658","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-12-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003825","dc:identifier":"homoit0003825","skos:prefLabel":"Autigender","rdfs:comment":"Term used to describe the identity of autistic people whose autism greatly affects and cannot be unlinked from their gender. Only use to describe autistic people who describe themselves as autigender. ","skos:broader":"https://homosaurus.org/v3/homoit0003824","skos:related":"https://homosaurus.org/v3/homoit0002667","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-12-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003826","dc:identifier":"homoit0003826","skos:prefLabel":"Queer desire","rdfs:comment":"Desire that resists definition by defying social norms such as heteronormativity, cisnormativity, and other forms of essentialism, regardless of the individual's identity.","skos:broader":"https://homosaurus.org/v3/homoit0001219","skos:narrower":["https://homosaurus.org/v3/homoit0001205","https://homosaurus.org/v3/homoit0000894"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2024-12-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003827","dc:identifier":"homoit0003827","skos:prefLabel":"Hispanic American LGBTQ+ people","skos:altLabel":["Hispanic Americans (LGBTQ)","Hispanic American people (LGBTQ)","LGBTQ+ Hispanic Americans","LGBTQ+ Hispanic American people"],"rdfs:comment":"LGBTQ+ people who were born in or currently reside in the United States and are descended from Spain or other regions formerly colonized by Spain that are primarily Spanish-speaking. Only use for individuals who self-identify as Hispanic American; do not conflate with Latino/a/x or Chicano/a/x.","skos:broader":"https://homosaurus.org/v3/homoit0002022","skos:narrower":["https://homosaurus.org/v3/homoit0003828","https://homosaurus.org/v3/homoit0003829","ht