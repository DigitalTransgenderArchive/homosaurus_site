4/homoit0001339","dc:identifier":"homoit0001339","skos:prefLabel":"Stature","rdfs:comment":"A person’s natural height in an upright position.","skos:broader":"https://homosaurus.org/v3/homoit0001259","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85127601"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/stature"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001340","dc:identifier":"homoit0001340","skos:prefLabel":"Stone butches","rdfs:comment":"Individuals whose gender expression and/or identity is masculine-presenting and who usually do not like to be sexually touched, though they will still provide their partners with sexual pleasure; commonly used in lesbian communities.","skos:broader":"https://homosaurus.org/v3/homoit0001295","skos:related":["https://homosaurus.org/v3/homoit0000230","https://homosaurus.org/v3/homoit0000231","https://homosaurus.org/v3/homoit0000440","https://homosaurus.org/v3/homoit0000556"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/stoneButches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001341","dc:identifier":"homoit0001341","skos:prefLabel":"Stonewall riots","skos:altLabel":"Stonewall uprising","rdfs:comment":"The series of spontaneous demonstrations and protests against the police raid that took place on June 28, 1969 at the Stonewall Inn in the Greenwich Village neighborhood of New York City.","skos:broader":"https://homosaurus.org/v3/homoit0000932","skos:related":"https://homosaurus.org/v3/homoit0000500","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh92005716"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000932"},"dc:replaces":{"@id":"http://homosaurus.org/v2/stonewallRiots"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001342","dc:identifier":"homoit0001342","skos:prefLabel":"Strap-on sex","rdfs:comment":"Sexual intercourse in which a dildo attached to a harness is used for either vaginal or anal penetration.","skos:broader":"https://homosaurus.org/v3/homoit0001267","skos:related":["https://homosaurus.org/v3/homoit0000354","https://homosaurus.org/v3/homoit0000355","https://homosaurus.org/v3/homoit0000662","https://homosaurus.org/v3/homoit0001099","https://homosaurus.org/v3/homoit0001510"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007007163"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/strapOnSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001343","dc:identifier":"homoit0001343","skos:prefLabel":"Strippers","skos:altLabel":["Stripteasers","Peelers","Pole-dancers","Pole dancers","Exotic dancers"],"rdfs:comment":"Sex workers who undress to music while using a pole to perform dance moves, whether in a venue like a strip club or by hire at private parties. For stripping performed by amateurs in private settings, use \"Stripping.\"","skos:broader":"https://homosaurus.org/v3/homoit0003758","skos:related":"https://homosaurus.org/v3/homoit0003764","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88005823"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003758"},"dc:replaces":{"@id":"http://homosaurus.org/v2/strippers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001344","dc:identifier":"homoit0001344","skos:prefLabel":"Striptease","rdfs:comment":"A form of erotic dance during which the performer gradually undresses in a seductive and sexually suggestive manner.","skos:broader":["https://homosaurus.org/v3/homoit0001299","https://homosaurus.org/v3/homoit0001363"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85129138"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001299"},"dc:replaces":{"@id":"http://homosaurus.org/v2/striptease"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001346","dc:identifier":"homoit0001346","skos:prefLabel":"Suffragettes","rdfs:comment":"Women who seek the right to vote, often through organized protest; typically used to describe members of political movements in the late 1800s and early 1900s focusing on women’s right to vote in the U.S. and Britain.","skos:broader":"https://homosaurus.org/v3/homoit0000439","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85129648"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000439"},"dc:replaces":{"@id":"http://homosaurus.org/v2/suffragettes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001347","dc:identifier":"homoit0001347","skos:prefLabel":"Surrogacy","rdfs:comment":"A method or agreement whereby a person consents to carry a pregnancy for another person or people who will become the child's parent(s) after birth.","skos:broader":["https://homosaurus.org/v3/homoit0000587","https://homosaurus.org/v3/homoit0000843","https://homosaurus.org/v3/homoit0002618"],"skos:narrower":"https://homosaurus.org/v3/homoit0002627","skos:related":"https://homosaurus.org/v3/homoit0000390","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88004707"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/surrogacy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001348","dc:identifier":"homoit0001348","skos:prefLabel":"Survivors of anti-LGBTQ+ violence","skos:altLabel":"Survivors of anti-LGBTQ violence","rdfs:comment":"People who have experienced and survived anti-LGBTQ+ violence; follow individuals’ preference for “victims” or “survivors” whenever possible.","skos:related":"https://homosaurus.org/v3/homoit0000059","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001348"},"dc:replaces":{"@id":"http://homosaurus.org/v2/survivorsOfAntiLGBTQViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001349","dc:identifier":"homoit0001349","skos:prefLabel":"LGBTQ+ survivors of hate crimes","skos:altLabel":"Survivors of hate crimes (LGBTQ)","rdfs:comment":"LGBTQ+ people who have experienced and survived hate crimes; follow the individual's preference for \"victims\" or \"survivors\" whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000613","skos:narrower":["https://homosaurus.org/v3/homoit0000188","https://homosaurus.org/v3/homoit0000540","https://homosaurus.org/v3/homoit0000782","https://homosaurus.org/v3/homoit0001211","https://homosaurus.org/v3/homoit0001448","https://homosaurus.org/v3/homoit0002850","https://homosaurus.org/v3/homoit0002942"],"skos:related":["https://homosaurus.org/v3/homoit0002373","https://homosaurus.org/v3/homoit0002726"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/survivorsOfHateCrimesLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001350","dc:identifier":"homoit0001350","skos:prefLabel":"LGBTQ+ survivors of rape","skos:altLabel":"Survivors of rape (LGBTQ)","rdfs:comment":"LGBTQ+ people who have experienced and survived rape; follow the individual's preference for \"victims\" or \"survivors\" whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000958","skos:narrower":["https://homosaurus.org/v3/homoit0000189","https://homosaurus.org/v3/homoit0000541","https://homosaurus.org/v3/homoit0000783","https://homosaurus.org/v3/homoit0001212","https://homosaurus.org/v3/homoit0001449","https://homosaurus.org/v3/homoit0002851","https://homosaurus.org/v3/homoit0002943"],"skos:related":["https://homosaurus.org/v3/homoit0002195","https://homosaurus.org/v3/homoit0002727"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/survivorsOfRapeLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001351","dc:identifier":"homoit0001351","skos:prefLabel":"LGBTQ+ survivors of sexual abuse","skos:altLabel":"Survivors of sexual abuse (LGBTQ)","rdfs:comment":"LGBTQ+ people who have experienced and survived sexual abuse; follow the individual's preference for \"victims\" or \"survivors\" whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000959","skos:narrower":["https://homosaurus.org/v3/homoit0000190","https://homosaurus.org/v3/homoit0000542","https://homosaurus.org/v3/homoit0000784","https://homosaurus.org/v3/homoit0001213","https://homosaurus.org/v3/homoit0001450","https://homosaurus.org/v3/homoit0002852","https://homosaurus.org/v3/homoit0002944"],"skos:related":["https://homosaurus.org/v3/homoit0000855","https://homosaurus.org/v3/homoit0000938","https://homosaurus.org/v3/homoit0002195","https://homosaurus.org/v3/homoit0002728"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/survivorsOfSexualAbuseLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001352","dc:identifier":"homoit0001352","skos:prefLabel":"LGBTQ+ survivors of war","skos:altLabel":"Survivors of war (LGBTQ)","rdfs:comment":"LGBTQ+ people who have experienced and survived war; follow the individual's preference for \"victims\" or \"survivors\" whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:narrower":["https://homosaurus.org/v3/homoit0000191","https://homosaurus.org/v3/homoit0000543","https://homosaurus.org/v3/homoit0000785","https://homosaurus.org/v3/homoit0001214","https://homosaurus.org/v3/homoit0001451","https://homosaurus.org/v3/homoit0002853","https://homosaurus.org/v3/homoit0002945"],"skos:related":["https://homosaurus.org/v3/homoit0000961","https://homosaurus.org/v3/homoit0002729"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/survivorsOfWarLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001353","dc:identifier":"homoit0001353","skos:prefLabel":"Switches (Sex)","skos:altLabel":"Switches","rdfs:comment":"Slang term for individuals who alternate between being the giving partner and the receiving partner in sexual encounters; typically used as a noun (e.g., \"They're a switch\").","skos:broader":["https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001304"],"skos:related":["https://homosaurus.org/v3/homoit0000103","https://homosaurus.org/v3/homoit0000219","https://homosaurus.org/v3/homoit0001376","https://homosaurus.org/v3/homoit0001779"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/switches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001354","dc:identifier":"homoit0001354","skos:prefLabel":"Swyer syndrome","skos:altLabel":"XY Gonadal dysgenesis","rdfs:comment":"Swyer syndrome occurs when a person is born with XY chromosomes, but their gonads have not developed into testes. It is a form of gonadal dysgenesis, meaning that a person with this variation will have streak gonads that do not produce hormones. Since they do not produce testosterone, their body does not develop a penis and usually develops a vulva and vagina instead. Since they do not produce another hormone known as anti-Müllerian hormone (AMH), people with Swyer syndrome often develop a uterus and fallopian tubes as well. They will not usually start puberty or begin menstruating, but some people with Swyer syndrome do menstruate (without ovulating) if they receive estrogen therapy.","skos:broader":"https://homosaurus.org/v3/homoit0000669","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/swyerSyndrome"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001355","dc:identifier":"homoit0001355","skos:prefLabel":"Sydney Gay and Lesbian Mardi Gras","rdfs:comment":"Annual gay pride parade and festival in Sydney, Australia","skos:broader":"https://homosaurus.org/v3/homoit0000522","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003653"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000861"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sydneyGayAndLesbianMardiGras"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-10-04"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001356","dc:identifier":"homoit0001356","skos:prefLabel":"Tattoos","rdfs:comment":"Body modifications in which permanent ink is inserted into the skin to form a design.","skos:broader":["https://homosaurus.org/v3/homoit0000214","https://homosaurus.org/v3/homoit0003076"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85132770"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000214"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tattoos"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001357","dc:identifier":"homoit0001357","skos:prefLabel":"Tearoom sex","rdfs:comment":"U.S. slang term that refers to anonymous sex in a public bathroom or the practice of cruising for sexual partners in public bathrooms.","skos:broader":"https://homosaurus.org/v3/homoit0001299","skos:related":["https://homosaurus.org/v3/homoit0000050","https://homosaurus.org/v3/homoit0000309","https://homosaurus.org/v3/homoit0000319","https://homosaurus.org/v3/homoit0001142","https://homosaurus.org/v3/homoit0001358"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008001734"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001299"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tearoomSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001358","dc:identifier":"homoit0001358","skos:prefLabel":"Tearooms (Gay culture)","skos:altLabel":"Tearooms","rdfs:comment":"U.S. slang term for public bathrooms that are used as locations for sexual encounters.","skos:broader":"https://homosaurus.org/v3/homoit0000974","skos:narrower":"https://homosaurus.org/v3/homoit0000595","skos:related":["https://homosaurus.org/v3/homoit0000308","https://homosaurus.org/v3/homoit0001140","https://homosaurus.org/v3/homoit0001357"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008001734"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000974"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tearooms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001360","dc:identifier":"homoit0001360","skos:prefLabel":"Terminal care (AIDS)","rdfs:comment":"End-of-life care for those with AIDS and their families; aimed at optimizing quality of life and mitigating suffering.","skos:broader":"https://homosaurus.org/v3/homoit0000614","skos:related":["https://homosaurus.org/v3/homoit0000848","https://homosaurus.org/v3/homoit0002258"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85134007"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000614"},"dc:replaces":{"@id":"http://homosaurus.org/v2/terminalCareAIDS"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001361","dc:identifier":"homoit0001361","skos:prefLabel":"Testicle","skos:altLabel":["Testicles","Balls","Nuts","Testes","Testis"],"rdfs:comment":"Reproductive gland or gonad that produces sperm and androgens, primarily testosterone.","skos:broader":["https://homosaurus.org/v3/homoit0000401","https://homosaurus.org/v3/homoit0000585","https://homosaurus.org/v3/homoit0000600"],"skos:related":["https://homosaurus.org/v3/homoit0001846","https://homosaurus.org/v3/homoit0001847"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85134157"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000401"},"dc:replaces":{"@id":"http://homosaurus.org/v2/testes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001362","dc:identifier":"homoit0001362","skos:prefLabel":"Testosterone","rdfs:comment":"A steroid hormone that is produced in the testes, ovaries, and adrenal cortex. Testosterone is commonly utilized in masculinizing hormone therapy regimens for certain secondary sexual characteristics, such as increased muscle mass and growth of body hair.","skos:broader":["https://homosaurus.org/v3/homoit0000317","https://homosaurus.org/v3/homoit0000651"],"skos:related":["https://homosaurus.org/v3/homoit0000436","https://homosaurus.org/v3/homoit0001643"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85134159"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/testosterone"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001366","dc:identifier":"homoit0001366","skos:prefLabel":"Therapies","rdfs:comment":"Treatments addressing impairments, illnesses, diseases, or disorders through counseling and rehabilitation.","skos:broader":"https://homosaurus.org/v3/homoit0001004","skos:narrower":["https://homosaurus.org/v3/homoit0000106","https://homosaurus.org/v3/homoit0000303","https://homosaurus.org/v3/homoit0000317","https://homosaurus.org/v3/homoit0000394","https://homosaurus.org/v3/homoit0000617","https://homosaurus.org/v3/homoit0001007","https://homosaurus.org/v3/homoit0001274","https://homosaurus.org/v3/homoit0001496"],"skos:related":"https://homosaurus.org/v3/homoit0001012","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85085490"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/therapies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001367","dc:identifier":"homoit0001367","skos:prefLabel":"Thigh harnesses","rdfs:comment":"Devices worn to attach a dildo to a person's thigh, typically so they can penetrate a partner's vagina or anus.","skos:broader":"https://homosaurus.org/v3/homoit0000612","skos:related":"https://homosaurus.org/v3/homoit0000354","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/thighHarnesses"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001368","dc:identifier":"homoit0001368","skos:prefLabel":"Third gender","rdfs:comment":"Social category present in societies that recognize three or more genders.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":"https://homosaurus.org/v3/homoit0001369","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/thirdGender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001369","dc:identifier":"homoit0001369","skos:prefLabel":"Third gender people","rdfs:comment":"Individuals who are categorized (by their will or by social consensus) as neither man nor woman.","skos:broader":"https://homosaurus.org/v3/homoit0001378","skos:related":"https://homosaurus.org/v3/homoit0001368","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/thirdGenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001370","dc:identifier":"homoit0001370","skos:prefLabel":"Thirunangai","rdfs:comment":"Regional term in Tamil Nadu, India for people assigned male at birth who identify as women.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":"https://homosaurus.org/v3/homoit0000065","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/thirunangai"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001371","dc:identifier":"homoit0001371","skos:prefLabel":"Thirunambi","rdfs:comment":"Regional term in Tamil Nadu, India for people assigned female at birth who identify as men.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/thirunambi"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001372","dc:identifier":"homoit0001372","skos:prefLabel":"Tida wena","rdfs:comment":"In Venezuela's indigenous Warao culture, this term refers to people assigned male at birth who are thought to possess two spirits and often assume a spiritual role; translates to \"twisted women.\"","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":"https://homosaurus.org/v3/homoit0001480","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tidaWena"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001373","dc:identifier":"homoit0001373","skos:prefLabel":"Tom","rdfs:comment":"In Thailand, this term is used to describe people assigned female at birth who exhibit masculine traits, often partnering with feminine dees; similar to a butch in U.S. lesbian culture.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":["https://homosaurus.org/v3/homoit0000340","https://homosaurus.org/v3/homoit0000687"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tom"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001374","dc:identifier":"homoit0001374","skos:prefLabel":"Tomboys","rdfs:comment":"Girls who exhibit some characteristics associated with gender expectations for boys.","skos:broader":["https://homosaurus.org/v3/homoit0000577","https://homosaurus.org/v3/homoit0000590"],"skos:related":["https://homosaurus.org/v3/homoit0000231","https://homosaurus.org/v3/homoit0002061"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2011002322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001241"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tomboys"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001375","dc:identifier":"homoit0001375","skos:prefLabel":"Tongzhi","skos:altLabel":"Tongzhis","rdfs:comment":"Contemporary term for LGBTQ+ people in China and Taiwan.","skos:broader":"https://homosaurus.org/v3/homoit0001297","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tongzhi"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001376","dc:identifier":"homoit0001376","skos:prefLabel":"Tops (Sex)","skos:altLabel":["Pitchers (Sex)","Pitchers","Tops"],"rdfs:comment":"Slang term for individuals who act as the giving partner in sexual encounters.","skos:broader":["https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001304"],"skos:narrower":"https://homosaurus.org/v3/homoit0001018","skos:related":["https://homosaurus.org/v3/homoit0000103","https://homosaurus.org/v3/homoit0000219","https://homosaurus.org/v3/homoit0000999","https://homosaurus.org/v3/homoit0001133","https://homosaurus.org/v3/homoit0001318","https://homosaurus.org/v3/homoit0001353","https://homosaurus.org/v3/homoit0001779","https://homosaurus.org/v3/homoit0002197","https://homosaurus.org/v3/homoit0003052","https://homosaurus.org/v3/homoit0003084"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tops"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001377","dc:identifier":"homoit0001377","skos:prefLabel":"Toxic masculinity","rdfs:comment":"Set of attitudes, behaviors, and cultural norms stereotypically associated with or expected of men and which are regarded as having a negative impact on men and society at large.","skos:broader":"https://homosaurus.org/v3/homoit0000995","skos:related":["https://homosaurus.org/v3/homoit0000655","https://homosaurus.org/v3/homoit0001133"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/toxicMasculinity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001378","dc:identifier":"homoit0001378","skos:prefLabel":"Transgender people","skos:altLabel":["Trans people","Transgendered people","Transpeople","Trans-people","Transgender-identified people","Trans-identified people","Trans* people"],"rdfs:comment":"Broad term for people who do not conform to their gender assigned at birth. Add more specific terms when possible.","skos:broader":["https://homosaurus.org/v3/homoit0000915","https://homosaurus.org/v3/homoit0001817"],"skos:narrower":["https://homosaurus.org/v3/homoit0000021","https://homosaurus.org/v3/homoit0000045","https://homosaurus.org/v3/homoit0000111","https://homosaurus.org/v3/homoit0000342","https://homosaurus.org/v3/homoit0000457","https://homosaurus.org/v3/homoit0000570","https://homosaurus.org/v3/homoit0001027","https://homosaurus.org/v3/homoit0001048","https://homosaurus.org/v3/homoit0001058","https://homosaurus.org/v3/homoit0001072","https://homosaurus.org/v3/homoit0001369","https://homosaurus.org/v3/homoit0001381","https://homosaurus.org/v3/homoit0001382","https://homosaurus.org/v3/homoit0001400","https://homosaurus.org/v3/homoit0001407","https://homosaurus.org/v3/homoit0001413","https://homosaurus.org/v3/homoit0001422","https://homosaurus.org/v3/homoit0001430","https://homosaurus.org/v3/homoit0001446","https://homosaurus.org/v3/homoit0001452","https://homosaurus.org/v3/homoit0001466","https://homosaurus.org/v3/homoit0001474","https://homosaurus.org/v3/homoit0001642","https://homosaurus.org/v3/homoit0001643","https://homosaurus.org/v3/homoit0001668","https://homosaurus.org/v3/homoit0001784","https://homosaurus.org/v3/homoit0003045","https://homosaurus.org/v3/homoit0003226"],"skos:related":["https://homosaurus.org/v3/homoit0000120","https://homosaurus.org/v3/homoit0000271","https://homosaurus.org/v3/homoit0000288","https://homosaurus.org/v3/homoit0000316","https://homosaurus.org/v3/homoit0000317","https://homosaurus.org/v3/homoit0000322","https://homosaurus.org/v3/homoit0000396","https://homosaurus.org/v3/homoit0000561","https://homosaurus.org/v3/homoit0000566","https://homosaurus.org/v3/homoit0000571","https://homosaurus.org/v3/homoit0000572","https://homosaurus.org/v3/homoit0000573","https://homosaurus.org/v3/homoit0000574","https://homosaurus.org/v3/homoit0000582","https://homosaurus.org/v3/homoit0001008","https://homosaurus.org/v3/homoit0001047","https://homosaurus.org/v3/homoit0001049","https://homosaurus.org/v3/homoit0001078","https://homosaurus.org/v3/homoit0001089","https://homosaurus.org/v3/homoit0001090","https://homosaurus.org/v3/homoit0001107","https://homosaurus.org/v3/homoit0001129","https://homosaurus.org/v3/homoit0001131","https://homosaurus.org/v3/homoit0001233","https://homosaurus.org/v3/homoit0001399","https://homosaurus.org/v3/homoit0001403","https://homosaurus.org/v3/homoit0001404","https://homosaurus.org/v3/homoit0001415","https://homosaurus.org/v3/homoit0001431","https://homosaurus.org/v3/homoit0001463","https://homosaurus.org/v3/homoit0001464","https://homosaurus.org/v3/homoit0001465","https://homosaurus.org/v3/homoit0001467","https://homosaurus.org/v3/homoit0001470","https://homosaurus.org/v3/homoit0001509","https://homosaurus.org/v3/homoit0001563","https://homosaurus.org/v3/homoit0001780","https://homosaurus.org/v3/homoit0001781","https://homosaurus.org/v3/homoit0001818","https://homosaurus.org/v3/homoit0001883","https://homosaurus.org/v3/homoit0001918","https://homosaurus.org/v3/homoit0001921","https://homosaurus.org/v3/homoit0001922","https://homosaurus.org/v3/homoit0002033","https://homosaurus.org/v3/homoit0002211"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007003708"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001379","dc:identifier":"homoit0001379","skos:prefLabel":"Trans marches","skos:altLabel":"Transgender marches","rdfs:comment":"Marches and gatherings focused on trans issues and rights.","skos:broader":"https://homosaurus.org/v3/homoit0003651","skos:related":"https://homosaurus.org/v3/homoit0003655","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000861"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transMarches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001380","dc:identifier":"homoit0001380","skos:prefLabel":"Transsexuality","skos:altLabel":"Transexuality","rdfs:comment":"Term used to describe the identity of people who transition from female to male or male to female. Generally refers to individuals who transition their physical bodies to align with their gender identities. Though this term was popular in the 20th century and is still in use today, it has been largely replaced by \"transgender identity\" and \"trans identity.\" Some but not all people regard this term as outdated and offensive. Only use to describe people who self-identify as transsexual.","skos:related":["https://homosaurus.org/v3/homoit0001381","https://homosaurus.org/v3/homoit0001468"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001380"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transsexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001381","dc:identifier":"homoit0001381","skos:prefLabel":"Transsexual people","skos:altLabel":["Transexuals","Transsexuals"],"rdfs:comment":"Individuals who transition from female to male or male to female. Generally refers to individuals who transition their physical bodies to align with their gender identities. Though this term was popular in the 20th century and is still in use today, it has been largely replaced by \"transgender people\" and \"trans people.\" Some but not all people regard this term as outdated and offensive. Only use to describe people who self-identify as transsexual.","skos:broader":"https://homosaurus.org/v3/homoit0001378","skos:narrower":["https://homosaurus.org/v3/homoit0000436","https://homosaurus.org/v3/homoit0000986"],"skos:related":["https://homosaurus.org/v3/homoit0000273","https://homosaurus.org/v3/homoit0000561","https://homosaurus.org/v3/homoit0000572","https://homosaurus.org/v3/homoit0001047","https://homosaurus.org/v3/homoit0001049","https://homosaurus.org/v3/homoit0001073","https://homosaurus.org/v3/homoit0001129","https://homosaurus.org/v3/homoit0001131","https://homosaurus.org/v3/homoit0001380","https://homosaurus.org/v3/homoit0001464","https://homosaurus.org/v3/homoit0001465","https://homosaurus.org/v3/homoit0001468","https://homosaurus.org/v3/homoit0001781"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85137086"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transsexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001382","dc:identifier":"homoit0001382","skos:prefLabel":"Transfeminine people","rdfs:comment":"People who identify partially or fully with a feminine gender identity and who were typically (but not always) assigned male at birth.","skos:broader":"https://homosaurus.org/v3/homoit0001378","skos:related":["https://homosaurus.org/v3/homoit0000389","https://homosaurus.org/v3/homoit0001652","https://homosaurus.org/v3/homoit0001821","https://homosaurus.org/v3/homoit0002043"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transfemininePeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001383","dc:identifier":"homoit0001383","skos:prefLabel":"Transgender activism","rdfs:comment":"Direct action and organizing to achieve political or social change and acceptance for transgender people.","skos:broader":"https://homosaurus.org/v3/homoit0000006","skos:related":"https://homosaurus.org/v3/homoit0001434","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderActivism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001384","dc:identifier":"homoit0001384","skos:prefLabel":"African American transgender people","skos:altLabel":["Transgender African American people","Transgender African Americans"],"rdfs:comment":"Transgender people of African descent born in the United States or transgender people born in African countries who live in or have a strong connection to the United States. Use for individuals who self-identity as African American. Follow the individual’s preference for African American or Black whenever possible.","skos:broader":["https://homosaurus.org/v3/homoit0000015","https://homosaurus.org/v3/homoit0001396"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2012000714"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderAfricanAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001385","dc:identifier":"homoit0001385","skos:prefLabel":"Afro-Canadian transgender people","skos:altLabel":["Transgender Afro-Canadian people","Transgender Afro-Canadians"],"rdfs:comment":"Transgender people of African descent born in Canada or transgender people born in African countries who live in or have a strong connection to Canada. Use for individuals who self-identify as Afro-Canadian.","skos:broader":["https://homosaurus.org/v3/homoit0000016","https://homosaurus.org/v3/homoit0001396"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderAfroCanadians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001386","dc:identifier":"homoit0001386","skos:prefLabel":"Afro-Caribbean transgender people","skos:altLabel":["Transgender Afro-Caribbean people","Transgender Afro-Caribbeans"],"rdfs:comment":"Transgender people of African descent born in the Caribbean or transgender people born in African countries who live in or have a strong connection to the Caribbean. Only use for individuals who self-identify as Afro-Caribbean.","skos:broader":["https://homosaurus.org/v3/homoit0000017","https://homosaurus.org/v3/homoit0001396"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderAfroCaribbeans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001387","dc:identifier":"homoit0001387","skos:prefLabel":"Afro-European transgender people","skos:altLabel":["Transgender Afro-European people","Transgender Afro-Europeans"],"rdfs:comment":"Transgender people of African descent born in European countries or transgender people born in African countries who live in or have a strong connection to Europe. Only use for individuals who self-identify as Afro-European.","skos:broader":["https://homosaurus.org/v3/homoit0000018","https://homosaurus.org/v3/homoit0001396"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderAfroEuropeans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001388","dc:identifier":"homoit0001388","skos:prefLabel":"Afro-Latin American transgender people","skos:altLabel":["Transgender Afro-Latin American people","Transgender Afro-Latin Americans"],"rdfs:comment":"Transgender people of African descent born in Latin American countries or transgender people born in African countries who live in or have a strong connection to Latin America. Only use for individuals who self-identify as Afro-Latin American.","skos:broader":["https://homosaurus.org/v3/homoit0000019","https://homosaurus.org/v3/homoit0001396"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderAfroLatinAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001389","dc:identifier":"homoit0001389","skos:prefLabel":"Transgender archives","rdfs:comment":"Collections of records and materials relating to transgender people or transgender communities; can include a variety of organizations and institutions from community to government archives.","skos:broader":"https://homosaurus.org/v3/homoit0000066","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderArchives"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001390","dc:identifier":"homoit0001390","skos:prefLabel":"Transgender artists","rdfs:comment":"Trans people who practice any of various creative arts.","skos:broader":"https://homosaurus.org/v3/homoit0000070","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2012003841"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderArtists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001391","dc:identifier":"homoit0001391","skos:prefLabel":"Asian American transgender people","skos:altLabel":["Transgender Asian American people","Transgender Asian Americans"],"rdfs:comment":"Transgender people of Asian heritage or descent born in the United States or born in Asian countries who live in or have a strong connection to the United States. Only use for individuals who self-identify as Asian American.","skos:broader":["https://homosaurus.org/v3/homoit0000073","https://homosaurus.org/v3/homoit0001392"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderAsianAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001392","dc:identifier":"homoit0001392","skos:prefLabel":"Asian transgender people","skos:altLabel":["Transgender Asian people","Transgender Asians"],"rdfs:comment":"Transgender people of Asian heritage or descent, living in Asia or part of the Asian diaspora. Only use for people who self-identify as Asian.","skos:broader":"https://homosaurus.org/v3/homoit0000074","skos:narrower":"https://homosaurus.org/v3/homoit0001391","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderAsians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001393","dc:identif