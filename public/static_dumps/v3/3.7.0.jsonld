05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000597","dc:identifier":"homoit0000597","skos:prefLabel":"Urine play","skos:altLabel":["Golden showers","Pissing sex","Undinism","Urolagnia","Clothes wetting","Omorashi","Piss play","Urophilia","Water sports","Watersports"],"rdfs:comment":"Use of urine and urination for sexual or erotic pleasure.","skos:broader":["https://homosaurus.org/v3/homoit0000442","https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001299"],"skos:related":["https://homosaurus.org/v3/homoit0000305","https://homosaurus.org/v3/homoit0003061","https://homosaurus.org/v3/homoit0003062"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/waterSports"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000598","dc:identifier":"homoit0000598","skos:prefLabel":"Goldilocks (Gay culture)","skos:altLabel":"Goldilocks","rdfs:comment":"US slang term for heterosexual women who are friends with gay men in the bear community and socialize in bear spaces.","skos:broader":"https://homosaurus.org/v3/homoit0000629","skos:related":["https://homosaurus.org/v3/homoit0000105","https://homosaurus.org/v3/homoit0000381","https://homosaurus.org/v3/homoit0000416","https://homosaurus.org/v3/homoit0000455","https://homosaurus.org/v3/homoit0001133","https://homosaurus.org/v3/homoit0001788"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000627"},"dc:replaces":{"@id":"http://homosaurus.org/v2/goldilocks"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"