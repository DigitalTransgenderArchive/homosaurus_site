elationships between male characters from anime and manga.","skos:broader":"https://homosaurus.org/v3/homoit0002152","skos:narrower":["https://homosaurus.org/v3/homoit0002164","https://homosaurus.org/v3/homoit0002217"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002219","dc:identifier":"homoit0002219","skos:prefLabel":"Yiff","rdfs:comment":"Slang term used by members of the furry fandom to describe the act of sex.","skos:broader":"https://homosaurus.org/v3/homoit0002165","skos:related":"https://homosaurus.org/v3/homoit0001267","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002220","dc:identifier":"homoit0002220","skos:prefLabel":"Yuri","rdfs:comment":"A genre focusing on the romantic or sexual relationships between female characters from anime and manga.","skos:broader":"https://homosaurus.org/v3/homoit0002221","skos:related":["https://homosaurus.org/v3/homoit0000742","https://homosaurus.org/v3/homoit0001597","https://homosaurus.org/v3/homoit0002162"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002221","dc:identifier":"homoit0002221","skos:prefLabel":"Yuri fandom","rdfs:comment":"The fan community that focuses on, i