ied":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000430","dc:identifier":"homoit0000430","skos:prefLabel":"Female genital mutilation","rdfs:comment":"The practice of cutting or removing the female genitals, sometimes to control sexual drive or punish lesbianism.","skos:narrower":"https://homosaurus.org/v3/homoit0000281","skos:related":"https://homosaurus.org/v3/homoit0000653","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002781"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000430"},"dc:replaces":{"@id":"http://homosaurus.org/v2/femaleGenitalMutilation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000282","dc:identifier":"homoit0000282","skos:prefLabel":"Clitoris","rdfs:comment":"Erogenous external organ that is capable of erection under sexual stimulation.","skos:broader":["https://homosaurus.org/v3/homoit0000401","https://homosaurus.org/v3/homoit0000585"],"skos:narrower":"https://homosaurus.org/v3/homoit0000460","skos:related":["https://homosaurus.org/v3/homoit0000279","https://homosaurus.org/v3/homoit0000280","https://homosaurus.org/v3/homoit0001844","https://homosaurus.org/v3/homoit0001848","https://homosaurus.org/v3/homoit0003736"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85027086"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000401"},"dc:replaces":{"@id":"http://homosaurus.org/v2/clitoris"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":