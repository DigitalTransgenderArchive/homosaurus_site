4/homoit0002614","dc:identifier":"homoit0002614","skos:prefLabel":"Asexual erotic art ","rdfs:comment":"Erotic art, created by asexual artists, depicting asexual people, or that are regarded as important within asexual culture.","skos:broader":"https://homosaurus.org/v3/homoit0002579","skos:narrower":["https://homosaurus.org/v3/homoit0002553","https://homosaurus.org/v3/homoit0002558"],"skos:related":"https://homosaurus.org/v3/homoit0002604","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002615","dc:identifier":"homoit0002615","skos:prefLabel":"Demisexual erotic art ","rdfs:comment":"Erotic art, created by demisexual artists, depicting demisexual people, or that are regarded as important within demisexual culture.","skos:broader":"https://homosaurus.org/v3/homoit0002579","skos:narrower":["https://homosaurus.org/v3/homoit0002554","https://homosaurus.org/v3/homoit0002559"],"skos:related":"https://homosaurus.org/v3/homoit0002605","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002616","dc:identifier":"homoit0002616","skos:prefLabel":"Anonymous donors (Reproduction) ","rdfs:comment":"People who donated their gametes with the understanding that their identity would remain unknown by any potential offspring.","skos:broader":"https://homosaurus.org/v3/homoit0000364","skos:related":"https://homosaurus.org/v3/homoit0002618","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000364"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002617","dc:identifier":"homoit0002617","skos:prefLabel":"Artificial insemination ","rdfs:comment":"The introduction of semen into the cervical opening, uterus, or fallopian tube using assistance from reproductive technology. Some choose not to use this term due to the implications of the word \"artificial.\"","skos:broader":["https://homosaurus.org/v3/homoit0000069","https://homosaurus.org/v3/homoit0002618"],"skos:related":["https://homosaurus.org/v3/homoit0001336","https://homosaurus.org/v3/homoit0003501"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85008176"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000864"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002618","dc:identifier":"homoit0002618","skos:prefLabel":"Assisted reproduction ","rdfs:comment":"The process by which a fetus is conceived through donor insemination, egg donation, surrogacy, IVF, and/or other reproductive technologies.","skos:broader":"https://homosaurus.org/v3/homoit0002619","skos:narrower":["https://homosaurus.org/v3/homoit0000659","https://homosaurus.org/v3/homoit0001265","https://homosaurus.org/v3/homoit0001347","https://homosaurus.org/v3/homoit0002617","https://homosaurus.org/v3/homoit0002620","https://homosaurus.org/v3/homoit0002622","https://homosaurus.org/v3/homoit0002626"],"skos:related":["https://homosaurus.org/v3/homoit0000069","https://homosaurus.org/v3/homoit0002616"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88005587"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002619"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002619","dc:identifier":"homoit0002619","skos:prefLabel":"Assisted reproductive technology ","skos:altLabel":["ART","Assisted reproductive technologies"],"rdfs:comment":"An umbrella term used to describe all methods of conception beyond sexual intercourse, including but not limited to donor insemination, artificial insemination, surrogacy, egg donation, and IVF.","skos:narrower":"https://homosaurus.org/v3/homoit0002618","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88005587"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002619"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002620","dc:identifier":"homoit0002620","skos:prefLabel":"Donor insemination ","rdfs:comment":"The process by which donated sperm is placed inside a person with a uterus to induce pregnancy.","skos:broader":["https://homosaurus.org/v3/homoit0000069","https://homosaurus.org/v3/homoit0002618"],"skos:narrower":"https://homosaurus.org/v3/homoit0001336","skos:related":"https://homosaurus.org/v3/homoit0002626","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85008176"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000864"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002621","dc:identifier":"homoit0002621","skos:prefLabel":"Donor siblings ","rdfs:comment":"People who are biologically related to one another through a shared donor.","skos:broader":"https://homosaurus.org/v3/homoit0001310","skos:related":["https://homosaurus.org/v3/homoit0000116","https://homosaurus.org/v3/homoit0000364","https://homosaurus.org/v3/homoit0000583"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002622","dc:identifier":"homoit0002622","skos:prefLabel":"Egg donation ","rdfs:comment":"The process by which a person donates their eggs for reproduction.","skos:broader":"https://homosaurus.org/v3/homoit0002618","skos:related":"https://homosaurus.org/v3/homoit0002627","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002619"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002623","dc:identifier":"homoit0002623","skos:prefLabel":"Half-siblings ","skos:altLabel":"Half siblings","rdfs:comment":"Siblings who are biologically related through one but not all of their parents.","skos:broader":"https://homosaurus.org/v3/homoit0001310","skos:related":["https://homosaurus.org/v3/homoit0000116","https://homosaurus.org/v3/homoit0000583","https://homosaurus.org/v3/homoit0002349"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002624","dc:identifier":"homoit0002624","skos:prefLabel":"Known donors (Reproduction) ","rdfs:comment":"Donors whose identities are known by the people to whom they donated gametes and/or the offspring born of that donation.","skos:broader":"https://homosaurus.org/v3/homoit0000364","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000364"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002625","dc:identifier":"homoit0002625","skos:prefLabel":"Open identity donors (Reproduction) ","skos:altLabel":["Identity release donors","Willing-to-be-known donors"],"rdfs:comment":"Donors who donated their gametes with the understanding that their identity and/or contact information would be released to any offspring born of that donation. The age at which the offspring receives this information varies, following the donor's preference.","skos:broader":"https://homosaurus.org/v3/homoit0000364","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000364"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002626","dc:identifier":"homoit0002626","skos:prefLabel":"Sperm donation ","rdfs:comment":"The process by which a person donates their sperm for reproduction.","skos:broader":"https://homosaurus.org/v3/homoit0002618","skos:related":["https://homosaurus.org/v3/homoit0001336","https://homosaurus.org/v3/homoit0002620"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002619"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002627","dc:identifier":"homoit0002627","skos:prefLabel":"Gestational surrogacy ","rdfs:comment":"The process by which a person becomes pregnant using a donated egg.","skos:broader":"https://homosaurus.org/v3/homoit0001347","skos:related":["https://homosaurus.org/v3/homoit0000390","https://homosaurus.org/v3/homoit0000587","https://homosaurus.org/v3/homoit0002622","https://homosaurus.org/v3/homoit0002628"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002628","dc:identifier":"homoit0002628","skos:prefLabel":"Surro babies ","skos:altLabel":["Surro baby","Surrogate babies"],"rdfs:comment":"People born through surrogacy.","skos:broader":"https://homosaurus.org/v3/homoit0000255","skos:related":["https://homosaurus.org/v3/homoit0000587","https://homosaurus.org/v3/homoit0002627"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2020000096"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002629","dc:identifier":"homoit0002629","skos:prefLabel":"Test tube babies ","skos:altLabel":"Test tube baby","rdfs:comment":"People who were conceived through IVF, or in vitro fertilization.","skos:broader":"https://homosaurus.org/v3/homoit0000255","skos:related":"https://homosaurus.org/v3/homoit0000659","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002630","dc:identifier":"homoit0002630","skos:prefLabel":"Māhū poetry","skos:altLabel":"Mahu poetry","rdfs:comment":"Literary work, typically written in verse, that focuses on Māhū characters, themes, or identity.","skos:related":"https://homosaurus.org/v3/homoit0001118","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002630"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-23"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002631","dc:identifier":"homoit0002631","skos:prefLabel":"Māhū comics","skos:altLabel":"Mahu comics","rdfs:comment":"Works consisting of sequential images often accompanied by text; use in reference to comics focusing on Māhū characters or themes.","skos:related":"https://homosaurus.org/v3/homoit0000841","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002631"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-23"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002632","dc:identifier":"homoit0002632","skos:prefLabel":"Māhū fiction","skos:altLabel":"Mahu fiction","rdfs:comment":"Written works describing imagined events or people; use in reference to fictional works focusing on Māhū characters or themes.","skos:related":"https://homosaurus.org/v3/homoit0000443","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002632"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-23"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id"