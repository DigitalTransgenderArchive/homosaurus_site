moit0002749","dc:identifier":"homoit0002749","skos:prefLabel":"Intersex literary criticism","rdfs:comment":"The study, evaluation, and interpretation of literary works focusing on intersex characters or themes; can also include interpretation of literature through the lens and frameworks of intersex studies.","skos:broader":"https://homosaurus.org/v3/homoit0001602","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001602"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002750","dc:identifier":"homoit0002750","skos:prefLabel":"Intersex literature","rdfs:comment":"Written literary works about intersex characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000972","skos:narrower":"https://homosaurus.org/v3/homoit0002953","skos:related":"https://homosaurus.org/v3/homoit0001749","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002751","dc:identifier":"homoit0002751","skos:prefLabel":"Intersex activism","rdfs:comment":"Direct action and organizing to achieve political or social change, bodily autonomy, and acceptance for intersex people.","skos:broader":"https://homosaurus.org/v3/homoit0000006","skos:narrower":"https://homosaurus.org/v3/homoit0002933","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000006"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002755","dc:identifier":"homoit0002755","skos:prefLabel":"Intersex people of color","skos:altLabel":"Intersex people of colour","rdfs:comment":"Primarily used in the United States, this term refers to intersex people who are not white and who identify as people of color.","skos:broader":"https://homosaurus.org/v3/homoit0001101","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002756","dc:identifier":"homoit0002756","skos:prefLabel":"Asian American intersex people","skos:altLabel":["Intersex Asian American people","Intersex Asian Americans"],"rdfs:comment":"Intersex people of Asian heritage or descent born in the United States or born in Asian countries who live in or have a strong connection to the United States. Only use for individuals who self-identify as Asian American.","skos:broader":"https://homosaurus.org/v3/homoit0000073","skos:related":"https://homosaurus.org/v3/homoit0002757","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002757","dc:identifier":"homoit0002757","skos:prefLabel":"Asian intersex people","skos:altLabel":["Intersex Asian people","Intersex Asians"],"rdfs:comment":"Intersex individuals of Asian heritage or descent, living in Asia or part of the Asian diaspora. Only use for people who self-identify as Asian.","skos:broader":"https://homosaurus.org/v3/homoit0000074","skos:related":"https://homosaurus.org/v3/homoit0002756","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002758","dc:identifier":"homoit0002758","skos:prefLabel":"Asexual activism","rdfs:comment":"Direct action and organizing to achieve political or social change and acceptance for asexual people.","skos:broader":"https://homosaurus.org/v3/homoit0000006","skos:narrower":"https://homosaurus.org/v3/homoit0002803","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000006"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002759","dc:identifier":"homoit0002759","skos:prefLabel":"Asexual archives","rdfs:comment":"Collections of records and materials relating to asexual people or asexual communities; can include a variety of organizations and institutions from community to government archives.","skos:broader":"https://homosaurus.org/v3/homoit0000066","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001755"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002760","dc:identifier":"homoit0002760","skos:prefLabel":"Asexual artists","rdfs:comment":"Asexual people who practice any of various creative arts.","skos:broader":"https://homosaurus.org/v3/homoit0000070","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"