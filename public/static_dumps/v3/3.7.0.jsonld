os:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002148","dc:identifier":"homoit0002148","skos:prefLabel":"Bara","rdfs:comment":"A genre of Japanese art created primarily by gay men for other gay men that emphasizes masculinity, muscles, body fat, and hair (similar to Bears and Gym subculture in the United States).","skos:broader":"https://homosaurus.org/v3/homoit0002149","skos:related":["https://homosaurus.org/v3/homoit0000105","https://homosaurus.org/v3/homoit0000978","https://homosaurus.org/v3/homoit0001654"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002149","dc:identifier":"homoit0002149","skos:prefLabel":"Bara fandom","rdfs:comment":"The fan community that focuses on, incorporates, or details the relationships of characters from bara manga and anime.","skos:broader":"https://homosaurus.org/v3/homoit0002144","skos:narrower":"https://homosaurus.org/v3/homoit0002148","skos:related":["https://homosaurus.org/v3/homoit0000105","https://homosaurus.org/v3/homoit0000978","https://homosaurus.org/v3/homoit0001654","https://homosaurus.org/v3/homoit0002170"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002150","dc:identifier":"homoit0002150","skos:prefLabel":"Bisexual people in fandom","skos:altLabel":"Bisexuals in fandom","rdfs:comment":"The participation and inclusion of bisexual people in fan communities.","skos:broader":"https://homosaurus.org/v3/homoit0002181","skos:related":["https://homosaurus.org/v3/homoit0000151","https://homosaurus.org/v3/homoit0000170","https://homosaurus.org/v3/homoit0001726","https://homosaurus.org/v3/homoit0001754","https://homosaurus.org/v3/homoit0002506","https://homosaurus.org/v3/homoit0002535"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002151","dc:identifier":"homoit0002151","skos:prefLabel":"Bishounen","rdfs:comment":"Japanese word that means \"beautiful boy\" and is used to describe a particular aesthetic of androgynous male beauty. While in Japanese \"bishounen\" refers specifically to youths under the age of twenty and \"biseinen\" is used to describe beautiful adult men, English-speaking anime and manga fan communities often use \"bishounen\" in reference to any good-looking male character, regardless of age.","skos:broader":"https://homosaurus.org/v3/homoit0002144","skos:related":["https://homosaurus.org/v3/homoit0001520","https://homosaurus.org/v3/homoit0002152","https://homosaurus.org/v3/homoit0002197","https://homosaurus.org/v3/homoit0002214"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002152","dc:identifier":"homoit0002152","skos:prefLabel":"Boys' Love (Genre)","skos:altLabel":["BL","Boys Love"],"rdfs:comment":"The manga and anime genre of fictional male-male romance created for a primarily female audience; sometimes used interchangeably with \"Yaoi\" in English (but not in Japanese).","skos:broader":"https://homosaurus.org/v3/homoit0002144","skos:narrower":["https://homosaurus.org/v3/homoit0002218","https://homosaurus.org/v3/homoit0003500"],"skos:related":"https://homosaurus.org/v3/homoit0000557","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002153","dc:identifier":"homoit0002153","skos:prefLabel":"Bury your gays","skos:altLabel":"Dead lesbian syndrome","rdfs:comment":"The trope in fiction that requires that LGBTQ+ characters die or meet some other type of unhappy ending. The trope is also known as \"dead lesbian syndrome\" due to the tendency for lesbian characters and bisexual female characters to be the targets. Transgender characters have also often been subjected to this trope.","skos:broader":"https://homosaurus.org/v3/homoit0002160","skos:related":"https://homosaurus.org/v3/homoit0000443","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002155","dc:identifier":"homoit0002155","skos:prefLabel":"Fanart","skos:altLabel":"Fan art","rdfs:comment":"Art created by fans that relates to media properties or other subjects of fandom.","skos:broader":"https://homosaurus.org/v3/homoit0002161","skos:narrower":"https://homosaurus.org/v3/homoit0002201","skos:related":["https://homosaurus.org/v3/homoit0002159","https://homosaurus.org/v3/homoit0002204"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002156","dc:identifier":"homoit0002156","skos:prefLabel":"Fandom","rdfs:comment":"Communities of people who are fans of a particular work or media property. Participation in fandom can include writing and reading fanfiction, creating and viewing fanart, attending conventions, cosplaying, and/or roleplaying.","skos:broader":"https://homosaurus.org/v3/homoit0001345","skos:narrower":["https://homosaurus.org/v3/homoit0002144","https://homosaurus.org/v3/homoit0002157","https://homosaurus.org/v3/homoit0002158","https://homosaurus.org/v3/homoit0002161","https://homosaurus.org/v3/homoit0002167","https://homosaurus.org/v3/homoit0002171","https://homosaurus.org/v3/homoit0002181","https://homosaurus.org/v3/homoit0002190","https://homosaurus.org/v3/homoit0002194","https://homosaurus.org/v3/homoit0002199","https://homosaurus.org/v3/homoit0002203"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002157","dc:identifier":"homoit0002157","skos:prefLabel":"Fandom conventions","skos:altLabel":["Fan cons","Fan conventions","Fandom cons"],"rdfs:comment":"Conventions dedicated to a particular fandom or fandom as a broad category.","skos:broader":"https://homosaurus.org/v3/homoit0002156","skos:narrower":["https://homosaurus.org/v3/homoit0002166","https://homosaurus.org/v3/homoit0002202"],"skos:related":["https://homosaurus.org/v3/homoit0000861","https://homosaurus.org/v3/homoit0000900"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002158","dc:identifier":"homoit0002158","skos:prefLabel":"Fandom terminology","skos:altLabel":["Fan terminology","Fan terms","Fandom terms"],"rdfs:comment":"Jargon or slang commonly used in fan communities, such as \"slash\" and \"shipping.\"","skos:broader":"https://homosaurus.org/v3/homoit0002156","skos:narrower":"https://homosaurus.org/v3/homoit0002208","skos:related":"https://homosaurus.org/v3/homoit0001317","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002159","dc:identifier":"homoit0002159","skos:prefLabel":"Fanfiction","skos:altLabel":["Fan fic","Fan fiction","Fanfic"],"rdfs:comment":"Written works of fiction created by fans that use the characters, settings, and/or plots of other media properties in a transformative way.","skos:broader":"https://homosaurus.org/v3/homoit0002161","skos:narrower":["https://homosaurus.org/v3/homoit0002160","https://homosaurus.org/v3/homoit0002179","https://homosaurus.org/v3/homoit0002205","https://homosaurus.org/v3/homoit0002210"],"skos:related":["https://homosaurus.org/v3/homoit0000443","https://homosaurus.org/v3/homoit0002155"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006002523"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002160","dc:identifier":"homoit0002160","skos:prefLabel":"Fanfiction tropes and genres","skos:altLabel":"Fanfic tropes and genres","rdfs:comment":"Tropes and genres commonly used in fanfiction. Examples include \"there was only one bed\" and \"enemies to lovers\" romance plots.","skos:broader":"https://homosaurus.org/v3/homoit0002159","skos:narrower":["https://homosaurus.org/v3/homoit0002143","https://homosaurus.org/v3/homoit0002153","https://homosaurus.org/v3/homoit0002176"],"skos:related":["https://homosaurus.org/v3/homoit0000576","https://homosaurus.org/v3/homoit0002187"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002161","dc:identifier":"homoit0002161","skos:prefLabel":"Fanworks","skos:altLabel":"Fan works","rdfs:comment":"Works, such as fanfiction or fanart, created by fans using characters, settings, and/or plots of other media properties.","skos:broader":"https://homosaurus.org/v3/homoit0002156","skos:narrower":["https://homosaurus.org/v3/homoit0001807","https://homosaurus.org/v3/homoit0002155","https://homosaurus.org/v3/homoit0002159","https://homosaurus.org/v3/homoit0002204"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002162","dc:identifier":"homoit0002162","skos:prefLabel":"Femslash","skos:altLabel":["Altfic","F/F slash","Femmeslash","Girlslash","Ladyslash"],"rdfs:comment":"A genre of fanworks in which two or more women are placed in a sexual or romantic situation with one another. Works of femslash are commonly erotic or pornographic. In recognition of the fact that the term \"slash\" has recently been broadened to include LGBTQ+ relationships other than those between two men, slash terms (e.g., Slash art, Slash roleplay, Slash vidding) should be used to describe specific types of femslash.","skos:broader":"https://homosaurus.org/v3/homoit0002200","skos:narrower":["https://homosaurus.org/v3/homoit0000742","https://homosaurus.org/v3/homoit0001597"],"skos:related":["https://homosaurus.org/v3/homoit0000576","https://homosaurus.org/v3/homoit0002220","https://homosaurus.org/v3/homoit0002221"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002164","dc:identifier":"homoit0002164","skos:prefLabel":"Fujoshi","rdfs:comment":"Japanese word that literally translates to \"rotten girl\" and is used to describe young women who enjoy media or fanworks focused on romantic or sexual relationships between men. Some fans self-identify as fujoshis, typically as a form of playful self-deprecation, but it can also be considered derogatory.","skos:broader":"https://homosaurus.org/v3/homoit0002218","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002165","dc:identifier":"homoit0002165","skos:prefLabel":"Furries","rdfs:comment":"Individuals who are interested in anthropomorphized animals, as well as fiction and artwork featuring anthropomorphized animals. Many furries identify with anthropomorphized animal versions of themselves, which are called fursonas.","skos:broader":"https://homosaurus.org/v3/homoit0002167","skos:narrower":["https://homosaurus.org/v3/homoit0002168","https://homosaurus.org/v3/homoit0002169","https://homosaurus.org/v3/homoit0002219"],"skos:related":["https://homosaurus.org/v3/homoit0001241","https://homosaurus.org/v3/homoit0001242","https://homosaurus.org/v3/homoit0003082","https://homosaurus.org/v3/homoit0003123"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2017004178"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002166","dc:identifier":"homoit0002166","skos:prefLabel":"Furry conventions","skos:altLabel":"Furry cons","rdfs:comment":"Conventions for furries that focus on furry fanworks.","skos:broader":["https://homosaurus.org/v3/homoit0002157","https://homosaurus.org/v3/homoit0002167"],"skos:related":["https://homosaurus.org/v3/homoit0000861","https://homosaurus.org/v3/homoit0000900"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002167","dc:identifier":"homoit0002167","skos:prefLabel":"Furry fandom","skos:altLabel":["Furry community","Furry fan community"],"rdfs:comment":"The fan community that focuses on, incorporates, or details anthropomorphized animals.","skos:broader":"https://homosaurus.org/v3/homoit0002156","skos:narrower":["https://homosaurus.org/v3/homoit0002165","https://homosaurus.org/v3/homoit0002166"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2017003411"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002168","dc:identifier":"homoit0002168","skos:prefLabel":"Fursonas","rdfs:comment":"Anthropomorphized animal versions of people. Fursonas, which are created by members of the furry fandom, are not necessarily animals with fur; they can also be reptiles, birds, or fictional animals, for example.","skos:broader":"https://homosaurus.org/v3/homoit0002165","skos:related":"https://homosaurus.org/v3/homoit0001241","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002169","dc:identifier":"homoit0002169","skos:prefLabel":"Fursuits","rdfs:comment":"Costumes worn by furries that represent their fursonas (i.e., anthropomorphized animal versions of themselves).","skos:broader":"https://homosaurus.org/v3/homoit0002165","skos:related":["https://homosaurus.org/v3/homoit0000289","https://homosaurus.org/v3/homoit0001241","https://homosaurus.org/v3/homoit0001242","https://homosaurus.org/v3/homoit0001808"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002170","dc:identifier":"homoit0002170","skos:prefLabel":"Gay men in fandom","rdfs:comment":"The participation and inclusion of gay men in fan communities.","skos:broader":["https://homosaurus.org/v3/homoit0002181","https://homosaurus.org/v3/homoit0002182"],"skos:related":["https://homosaurus.org/v3/homoit0000493","https://homosaurus.org/v3/homoit0000506","https://homosaurus.org/v3/homoit0001725","https://homosaurus.org/v3/homoit0002149"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002171","dc:identifier":"homoit0002171","skos:prefLabel":"Gender in fandom","rdfs:comment":"Issues and discussions about gender in fan spaces and works.","skos:broader":"https://homosaurus.org/v3/homoit0002156","skos:narrower":["https://homosaurus.org/v3/homoit0002174","https://homosaurus.org/v3/homoit0002175","https://homosaurus.org/v3/homoit0002182","https://homosaurus.org/v3/homoit0002183","https://homosaurus.org/v3/homoit0002185","https://homosaurus.org/v3/homoit0002211","https://homosaurus.org/v3/homoit0002212","https://homosaurus.org/v3/homoit0002213","https://homosaurus.org/v3/homoit0002216"],"skos:related":"https://homosaurus.org/v3/homoit0000576","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002172","dc:identifier":"homoit0002172","skos:prefLabel":"Hentai","rdfs:comment":"A genre of anime and manga characterized by explicit sexual content; can also include hentai video games.","skos:broader":["https://homosaurus.org/v3/homoit0001128","https://homosaurus.org/v3/homoit0002173"],"skos:related":["https://homosaurus.org/v3/homoit0000828","https://homosaurus.org/v3/homoit0000859","https://homosaurus.org/v3/homoit0000897","https://homosaurus.org/v3/homoit0002217"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000011"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002173","dc:identifier":"homoit0002173","skos:prefLabel":"Hentai fandom","rdfs:comment":"The fan community that focuses on, incorporates, or details the relationships of characters in hentai, or sexually explicit anime and manga.","skos:broader":"https://homosaurus.org/v3/homoit0002144","skos:narrower":"https://homosaurus.org/v3/homoit0002172","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002174","dc:identifier":"homoit0002174","skos:prefLabel":"Homophobia in fandom","rdfs:comment":"Issues and discussions about the presence of homophobia in fan spaces and works.","skos:broader":["https://homosaurus.org/v3/homoit0000646","https://homosaurus.org/v3/homoit0002171"],"skos:related":["https://homosaurus.org/v3/homoit0002181","https://homosaurus.org/v3/homoit0002194"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002175","dc:identifier":"homoit0002175","skos:prefLabel":"Intersex people in fandom","rdfs:comment":"The participation and inclusion of intersex people in fan communities.","skos:broader":["https://homosaurus.org/v3/homoit0002171","https://homosaurus.org/v3/homoit0002181"],"skos:narrower":"https://homosaurus.org/v3/homoit0001752","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002176","dc:identifier":"homoit0002176","skos:prefLabel":"Kink in fandom","skos:altLabel":"Kink in fan communities","rdfs:comment":"Representations of non-conventional or marginalized sexual practices in fanfiction.","skos:broader":"https://homosaurus.org/v3/homoit0002160","skos:related":["https://homosaurus.org/v3/homoit0002181","https://homosaurus.org/v3/homoit0002186"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002177","dc:identifier":"homoit0002177","skos:prefLabel":"Kirk/Spock","skos:altLabel":["K/S","Spirk"],"rdfs:comment":"The homoerotic fan pairing of Kirk and Spock from Star Trek: The Original Series. The Kirk/Spock fandom originated much of the terminology and practices associated with fandom today--for example, the word \"slash\" comes from the forward slash in Kirk/Spock.","skos:broader":"https://homosaurus.org/v3/homoit0002198","skos:related":["https://homosaurus.org/v3/homoit0000934","https://homosaurus.org/v3/homoit0001806","https://homosaurus.org/v3/homoit0002187"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002178","dc:identifier":"homoit0002178","skos:prefLabel":"Lesbians in fandom","skos:altLabel":"Lesbians in fan communities","rdfs:comment":"The participation and inclusion of lesbians in fan communities.","skos:broader":"https://homosaurus.org/v3/homoit0002181","skos:related":["https://homosaurus.org/v3/homoit0000556","https://homosaurus.org/v3/homoit0000742","https://homosaurus.org/v3/homoit0001724"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002179","dc:identifier":"homoit0002179","skos:prefLabel":"LGBTQ+ fanfiction","skos:altLabel":["Fan fic (LGBTQ)","Fan fics (LGBTQ)","Fan fiction (LGBTQ)","Fanfiction (LGBTQ)","LGBTQ+ fan fics","LGBTQ+ fan fiction","LGBTQ+ fanfics"],"rdfs:comment":"Fanfiction that primarily focuses on LGBTQ+ people, communities, and relationships, often using characters who are not stated to be LGBTQ+ in canon.","skos:broader":"https://homosaurus.org/v3/homoit0002159","skos:related":["https://homosaurus.org/v3/homoit0000443","https://homosaurus.org/v3/homoit0001522","https://homosaurus.org/v3/homoit0001723"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002180","dc:identifier":"homoit0002180","skos:prefLabel":"LGBTQ+ headcanons","skos:altLabel":"Headcanons (LGBTQ)","rdfs:comment":"Fans' personal interpretations of media properties and texts, particularly relating to the personalities and behaviors of characters. Use to describe headcanons that certain characters or relationships are LGBTQ+, as well as headcanons about other LGBTQ+ people and issues in the universe of the text.","skos:broader":"https://homosaurus.org/v3/homoit0001149","skos:related":["https://homosaurus.org/v3/homoit0000443","https://homosaurus.org/v3/homoit0002199"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001149"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002181","dc:identifier":"homoit0002181","skos:prefLabel":"LGBTQ+ people in fandom","skos:altLabel":["LGBTQ+ people in fan communities","People in fandom (LGBTQ)"],"rdfs:comment":"The participation and inclusion of LGBTQ+ people in fan communities.","skos:broader":["https://homosaurus.org/v3/homoit0000915","https://homosaurus.org/v3/homoit0002156"],"skos:narrower":["https://homosaurus.org/v3/homoit0002145","https://homosaurus.org/v3/homoit0002146","https://homosaurus.org/v3/homoit0002150","https://homosaurus.org/v3/homoit0002170","https://homosaurus.org/v3/homoit0002175","https://homosaurus.org/v3/homoit0002178","https://homosaurus.org/v3/homoit0002185","https://homosaurus.org/v3/homoit0002193","https://homosaurus.org/v3/homoit0002211"],"skos:related":["https://homosaurus.org/v3/homoit0002174","https://homosaurus.org/v3/homoit0002176","https://homosaurus.org/v3/homoit0002212","https://homosaurus.org/v3/homoit0002213"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002182","dc:identifier":"homoit0002182","skos:prefLabel":"Men in fandom","rdfs:comment":"The participation and inclusion of men in fan communities.","skos:broader":"https://homosaurus.org/v3/homoit0002171","skos:narrower":"https://homosaurus.org/v3/homoit0002170","skos:related":"https://homosaurus.org/v3/homoit0001008","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002183","dc:identifier":"homoit0002183","skos:prefLabel":"Misogyny in fandom","skos:altLabel":"Sexism in fandom","rdfs:comment":"Issues and discussions about the presence of misogyny in fan spaces and works.","skos:broader":["https://homosaurus.org/v3/homoit0001017","https://homosaurus.org/v3/homoit0002171"],"skos:related":["https://homosaurus.org/v3/homoit0001278","https://homosaurus.org/v3/homoit0002194"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001017"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002184","dc:identifier":"homoit0002184","skos:prefLabel":"Mpreg","skos:altLabel":"M-preg","rdfs:comment":"The fandom trope in which cisgender men can become pregnant. This term should not be used to describe pregnant trans men.","skos:broader":"https://homosaurus.org/v3/homoit0002186","skos:related":["https://homosaurus.org/v3/homoit0000576","https://homosaurus.org/v3/homoit0000859"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002185","dc:identifier":"homoit0002185","skos:prefLabel":"Non-binary people in fandom","skos:altLabel":"Nonbinary people in fandom","rdfs:comment":"The participation and inclusion of non-binary people in fan communities.","skos:broader":["https://homosaurus.org/v3/homoit0002171","https://homosaurus.org/v3/homoit0002181"],"skos:related":"https://homosaurus.org/v3/homoit0001048","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002186","dc:identifier":"homoit0002186","skos:prefLabel":"Omegaverse","skos:altLabel":["A/B/O","ABO","Alpha/Beta/Omega"],"rdfs:comment":"The alternate universe fanworks trope in which society is divided into three categories of people: alphas, betas, and omegas. Fanworks in the omegaverse often depict characters with genitalia and breeding behaviors (such as heat cycles) similar to wolves. Use to describe fanworks in the omegaverse that focus on LGBTQ+ people and issues.","skos:broader":"https://homosaurus.org/v3/homoit0002143","skos:narrower":"https://homosaurus.org/v3/homoit0002184","skos:related":"https://homosaurus.org/v3/homoit0002176","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002187","dc:identifier":"homoit0002187","skos:prefLabel":"One true pairing","skos:altLabel":"OTP","rdfs:comment":"Slang term referring to a fan's primary \"ship\" or preferred relationship within a fandom.","skos:broader":"https://homosaurus.org/v3/homoit0002189","skos:related":["https://homosaurus.org/v3/homoit0002160","https://homosaurus.org/v3/homoit0002177"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002188","dc:identifier":"homoit0002188","skos:prefLabel":"Original slash fiction","rdfs:comment":"Original works of creative fiction that focus on same-sex or same-gender relationships and incorporate tropes from fanfiction; includes femslash fiction.","skos:broader":"https://homosaurus.org/v3/homoit0002205","skos:related":["https://homosaurus.org/v3/homoit0000443","https://homosaurus.org/v3/homoit0000859","https://homosaurus.org/v3/homoit0002217"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002189","dc:identifier":"homoit0002189","skos:prefLabel":"Pairings in fandom","skos:altLabel":"Fandom pairings","rdfs:comment":"The relationships (primarily romantic or sexual) between characters in fanworks, including relationships that are not present within the canon text.","skos:broader":"https://homosaurus.org/v3/homoit0002199","skos:narrower":"https://homosaurus.org/v3/homoit0002187","skos:related":"https://homosaurus.org/v3/homoit0001237","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002190","dc:identifier":"homoit0002190","skos:prefLabel":"People of color in fandom","skos:altLabel":"BIPOC in fandom","rdfs:comment":"The participation and inclusion of people of color in fan communities.","skos:broader":"https://homosaurus.org/v3/homoit0002156","skos:related":"https://homosaurus.org/v3/homoit0001101","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002191","dc:identifier":"homoit0002191","skos:prefLabel":"Queerbaiting","skos:altLabel":"Queer baiting","rdfs:comment":"Marketing tactic in which creators of a piece of media purposefully hint at but do not explicitly depict or follow through with queer relationships or queer representation. Queerbaiting is distinct from queer coding in that queer coding is not typically used as a marketing tactic.","skos:related":["https://homosaurus.org/v3/homoit0000899","https://homosaurus.org/v3/homoit0002192"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002191"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002192","dc:identifier":"homoit0002192","skos:prefLabel":"Queer coding","skos:altLabel":"Queercoding","rdfs:comment":"Purposeful subtextual coding of a character or relationship in a piece of media as queer. Queer coding is distinct from the practice of queerbaiting in that the queer codes are intentionally present rather than falsely implied and are not typically used as a marketing tactic.","skos:related":["https://homosaurus.org/v3/homoit0000609","https://homosaurus.org/v3/homoit0000972","https://homosaurus.org/v3/homoit0001233","https://homosaurus.org/v3/homoit0001900","https://homosaurus.org/v3/homoit0002191"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002192"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002193","dc:identifier":"homoit0002193","skos:prefLabel":"Queer people in fandom","rdfs:comment":"The participation and inclusion of queer people in fan communities.","skos:broader":"https://homosaurus.org/v3/homoit0002181","skos:related":["https://homosaurus.org/v3/homoit0001177","https://homosaurus.org/v3/homoit0001195","https://homosaurus.org/v3/homoit0001728"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002194","dc:identifier":"homoit0002194","skos:prefLabel":"Racism in fandom","rdfs:comment":"Issues and discussions about the presence of racism in fan spaces and works.","skos:broader":["https://homosaurus.org/v3/homoit0002038","https://homosaurus.org/v3/homoit0002156"],"skos:related":["https://homosaurus.org/v3/homoit0002174","https://homosaurus.org/v3/homoit0002183","https://homosaurus.org/v3/homoit0002212"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002038"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002195","dc:identifier":"homoit0002195","skos:prefLabel":"Rape/non-con (Content warning)","skos:altLabel":["Non-consensual (Content warning)","Rape (Content warning)"],"rdfs:comment":"A content warning applied to fanworks to signal the presence of rape, non-consensual sexual encounters, or dubiously consensual sexual encounters.","skos:broader":"https://homosaurus.org/v3/homoit0001807","skos:related":["https://homosaurus.org/v3/homoit0000302","https://homosaurus.org/v3/homoit0000958","https://homosaurus.org/v3/homoit0000959","https://homosaurus.org/v3/homoit0001305","https://homosaurus.org/v3/homoit0001350","https://homosaurus.org/v3/homoit0001351"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002196","dc:identifier":"homoit0002196","skos:prefLabel":"Real person fiction","skos:altLabel":["RPF","RPS","Real people fiction","Real person slash","Real person stories"],"rdfs:comment":"Fanfiction about real people, such as actors or musicians; often but not always used to describe fanfiction focusing on (real or imagined) same-sex or same-gender relationships between celebrities.","skos:broader":"https://homosaurus.org/v3/homoit0002205","skos:narrower":["https://homosaurus.org/v3/homoit0002142","https://homosaurus.org/v3/homoit0002147"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002197","dc:identifier":"homoit0002197","skos:prefLabel":"Seme (Yaoi)","rdfs:comment":"Term used in yaoi or yaoi fan communities to describe the giving or dominant partner in a fictional male-male relationship.","skos:broader":"https://homosaurus.org/v3/homoit0002217","skos:related":["https://homosaurus.org/v3/homoit0001376","https://homosaurus.org/v3/homoit0002151","https://homosaurus.org/v3/homoit0002152"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002198","dc:identifier":"homoit0002198","skos:prefLabel":"Ship names in fandom","skos:altLabel":"Pairing names in fandom","rdfs:comment":"Names used to describe common pairings in fandom. Ship names are often portmanteaus of the names of two (or more) characters in the ship (e.g., Spirk for Spock and Kirk).","skos:broader":"https://homosaurus.org/v3/homoit0002199","skos:narrower":"https://homosaurus.org/v3/homoit0002177","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002199","dc:identifier":"homoit0002199","skos:prefLabel":"Shipping in fandom","rdfs:comment":"Term used to describe fans' desire to see certain characters in sexual or romantic relationships, as well as the practice of pairing those characters in fanworks. The terms \"shipping\" and \"ship\" come from \"relationship.\"","skos:broader":"https://homosaurus.org/v3/homoit0002156","skos:narrower":["https://homosaurus.org/v3/homoit0002189","https://homosaurus.org/v3/homoit0002198"],"skos:related":"https://homosaurus.org/v3/homoit0002180","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002200","dc:identifier":"homoit0002200","skos:prefLabel":"Slash (Genre)","rdfs:comment":"A genre of fanworks in which two or more characters of the same sex or gender are placed in sexual or romantic situations with one another. Slash fanworks are commonly erotic or pornographic. While the term \"slash\" has historically been used for male/male couples only, it has been recently been broadened to include LGBTQ+ relationships other than those between two men.","skos:broader":"https://homosaurus.org/v3/homoit0002203","skos:narrower":"https://homosaurus.org/v3/homoit0002162","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002201","dc:identifier":"homoit0002201","skos:prefLabel":"Slash art","rdfs:comment":"Artwork depicting same-sex or same-gender couples that is usually erotic or pornographic in nature. Historically used for male-male couples only, but is now used more broadly; includes femslash art.","skos:broader":["https://homosaurus.org/v3/homoit0002155","https://homosaurus.org/v3/homoit0002204"],"skos:related":"https://homosaurus.org/v3/homoit0000816","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002202","dc:identifier":"homoit0002202","skos:prefLabel":"Slash conventions","skos:altLabel":"Slash cons","rdfs:comment":"Conventions focused on slash, or fanworks depicting same-sex or same-gender couples that are typically erotic or pornographic in nature. Historically used for male-male couples only, but is now used more broadly; includes femslash conventions.","skos:broader":["https://homosaurus.org/v3/homoit0002157","https://homosaurus.org/v3/homoit0002203"],"skos:related":["https://homosaurus.org/v3/homoit0000861","https://homosaurus.org/v3/homoit0000900"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002203","dc:identifier":"homoit0002203","skos:prefLabel":"Slash fandom","skos:altLabel":"Slash fan community","rdfs:comment":"The fan community that focuses on, incorporates, or details relationships between two characters of the same sex or gender (usually fictional, with \"Real person fiction\" as an exception). Historically used for male-male couples only, but is now used more broadly; includes femslash fandom.","skos:broader":"https://homosaurus.org/v3/homoit0002156","skos:narrower":["https://homosaurus.org/v3/homoit0002200","https://homosaurus.org/v3/homoit0002202","https://homosaurus.org/v3/homoit0002204","https://homosaurus.org/v3/homoit0002205","https://homosaurus.org/v3/homoit0002208"],"skos:related":"https://homosaurus.org/v3/homoit0002221","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002204","dc:identifier":"homoit0002204","skos:prefLabel":"Slash fanworks","skos:altLabel":"Slash fan works","rdfs:comment":"Works created by fans that focus on romantic or sexual relationships between characters of the same sex or gender. Typically erotic or pornographic in nature. Historically used for male-male couples only, but is now used more broadly; includes femslash fanworks.","skos:broader":["https://homosaurus.org/v3/homoit0002161","https://homosaurus.org/v3/homoit0002203"],"skos:narrower":["https://homosaurus.org/v3/homoit0002201","https://homosaurus.org/v3/homoit0002205","https://homosaurus.org/v3/homoit0002206","https://homosaurus.org/v3/homoit0002207","https://homosaurus.org/v3/homoit0002209"],"skos:related":["https://homosaurus.org/v3/homoit0002155","https://homosaurus.org/v3/homoit0002217"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002205","dc:identifier":"homoit0002205","skos:prefLabel":"Slash fiction","skos:altLabel":["Slash fan fics","Slash fan fiction","Slash fanfiction","Slash fic"],"rdfs:comment":"Fanfiction focusing on sexual or romantic relationships between characters of the same sex or gender that is typically erotic or pornographic in nature. Historically used for male-male couples only, but is now used more broadly; includes femslash fiction.","skos:broader":["https://homosaurus.org/v3/homoit0002159","https://homosaurus.org/v3/homoit0002203","https://homosaurus.org/v3/homoit0002204"],"skos:narrower":["https://homosaurus.org/v3/homoit0002188","https://homosaurus.org/v3/homoit0002196"],"skos:related":"https://homosaurus.org/v3/homoit0000859","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002206","dc:identifier":"homoit0002206","skos:prefLabel":"Slash manips","rdfs:comment":"Fan-created photo manipulations or deepfakes depicting sexual or romantic relationships between characters from various media properties. Typically erotic or pornographic in nature. Historically used for male-male couples only, but is now used more broadly; includes femslash manips.","skos:broader":"https://homosaurus.org/v3/homoit0002204","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002207","dc:identifier":"homoit0002207","skos:prefLabel":"Slash roleplay","skos:altLabel":"Slash role play","rdfs:comment":"The act of pretending to be and behaving as a character in a sexual or romantic relationship with another character of the same sex or gender, sometimes to generate ideas for fanworks. Typically erotic or pornographic in nature. Historically used for male-male couples only, but is now used more broadly; includes femslash roleplay.","skos:broader":"https://homosaurus.org/v3/homoit0002204","skos:related":["https://homosaurus.org/v3/homoit0001241","https://homosaurus.org/v3/homoit0001242"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002208","dc:identifier":"homoit0002208","skos:prefLabel":"Slash terminology","skos:altLabel":"Slash terms","rdfs:comment":"Slang relating to fanworks about sexual or romantic relationships between characters of the same sex or gender. Historically used for male-male couples only, but is now used more broadly; includes femslash terminology.","skos:broader":["https://homosaurus.org/v3/homoit0002158","https://homosaurus.org/v3/homoit0002203"],"skos:related":"https://homosaurus.org/v3/homoit0001317","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002209","dc:identifier":"homoit0002209","skos:prefLabel":"Slash vidding","rdfs:comment":"Creating videos about sexual or romantic relationships between same-sex or -gender couples using scenes from television, movies, or video games. Historically used for male-male couples only, but is now used more broadly; includes femslash vidding.","skos:broader":"https://homosaurus.org/v3/homoit0002204","skos:related":"https://homosaurus.org/v3/homoit0003662","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002210","dc:identifier":"homoit0002210","skos:prefLabel":"Transfic","rdfs:comment":"Term used to describe fanfiction about trans characters, typically characters who are not stated to be transgender, transsexual, or gender diverse in the canon text","skos:broader":"https://homosaurus.org/v3/homoit0002159","skos:related":["https://homosaurus.org/v3/homoit0000576","https://homosaurus.org/v3/homoit0001414","https://homosaurus.org/v3/homoit0002143"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002211","dc:identifier":"homoit0002211","skos:prefLabel":"Transgender people in fandom","skos:altLabel":"Trans people in fandom","rdfs:comment":"The participation and inclusion of transgender people in fan communities.","skos:broader":["https://homosaurus.org/v3/homoit0002171","https://homosaurus.org/v3/homoit0002181"],"skos:related":["https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001414","https://homosaurus.org/v3/homoit0001727"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002212","dc:identifier":"homoit0002212","skos:prefLabel":"Transphobia in fandom","rdfs:comment":"Issues and discussions about the presence of transphobia in fan spaces and works.","skos:broader":["https://homosaurus.org/v3/homoit0001467","https://homosaurus.org/v3/homoit0002171"],"skos:related":["https://homosaurus.org/v3/homoit0002181","https://homosaurus.org/v3/homoit0002194"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002213","dc:identifier":"homoit0002213","skos:prefLabel":"Two-Spirit people in fandom","skos:altLabel":["2S people in fandom","Two Spirit people in fandom","Two Spirited people in fandom","Two-Spirited people in fandom"],"rdfs:comment":"The participation and inclusion of Two-Spirit people in fan communities.","skos:broader":"https://homosaurus.org/v3/homoit0002171","skos:related":["https://homosaurus.org/v3/homoit0001480","https://homosaurus.org/v3/homoit0001751","https://homosaurus.org/v3/homoit0002181"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002214","dc:identifier":"homoit0002214","skos:prefLabel":"Uke (Yaoi)","rdfs:comment":"Term used in yaoi and yaoi fan communities to describe the receiving or submissive partner in a fictional male-male relationship.","skos:broader":"https://homosaurus.org/v3/homoit0002217","skos:related":["https://homosaurus.org/v3/homoit0002151","https://homosaurus.org/v3/homoit0002152"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002215","dc:identifier":"homoit0002215","skos:prefLabel":"Underage (Content warning)","rdfs:comment":"A content warning applied to fanworks to signal the depiction of people under the age of consent in sexual situations, either with other underage people or adults.","skos:broader":"https://homosaurus.org/v3/homoit0001807","skos:related":["https://homosaurus.org/v3/homoit0000020","https://homosaurus.org/v3/homoit0000302"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme"