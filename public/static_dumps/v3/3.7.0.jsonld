urus.org/v2/bisexualJews"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000155","dc:identifier":"homoit0000155","skos:prefLabel":"Latino/a/x bisexual people","skos:altLabel":["Bisexual Latinas","Bisexual Latine people","Bisexual Latinos","Bisexual Latinx people","Latina bisexual people","Latine bisexual people","Latino bisexual people","Latinx bisexual people"],"rdfs:comment":"Latin American people who are bisexual; only use to describe individuals who self-identify as Latino, Latina, or Latinx. Do not conflate with Chicano/a/x or Hispanic.","skos:broader":"https://homosaurus.org/v3/homoit0000253","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualLatinx"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000156","dc:identifier":"homoit0000156","skos:prefLabel":"Bisexual libraries","rdfs:comment":"Libraries that hold materials primarily pertaining to bisexual people or intended for use by bisexual people.","skos:broader":"https://homosaurus.org/v3/homoit0000968","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2021005780"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualLibraries"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000157","dc:identifier":"homoit0000157","skos:prefLabel":"Bisexual literature","rdfs:comment":"Written literary works about bisexuality, bisexual characters, or bisexual themes.","skos:broader":"https://homosaurus.org/v3/homoit0000972","skos:related":["https://homosaurus.org/v3/homoit0000149","https://homosaurus.org/v3/homoit0000151","https://homosaurus.org/v3/homoit0000174","https://homosaurus.org/v3/homoit0001726","https://homosaurus.org/v3/homoit0001754","https://homosaurus.org/v3/homoit0002506","https://homosaurus.org/v3/homoit0002535"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualLiterature"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000158","dc:identifier":"homoit0000158","skos:prefLabel":"Mixed-orientation marriage","skos:altLabel":"Bisexual marriage","rdfs:comment":"Marriages between individuals who do not share the same sexual orientation (e.g., bisexual-heterosexual marriage, allosexual-asexual marriage).","skos:broader":"https://homosaurus.org/v3/homoit0000990","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mixed-orientationMarriage"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000973","dc:identifier":"homoit0000973","skos:prefLabel":"Living arrangements","rdfs:comment":"Structure or composition of an individual's household or living environment, including the number of household members and their relationships to each other.","skos:narrower":["https://homosaurus.org/v3/homoit0000274","https://homosaurus.org/v3/homoit0000362","https://homosaurus.org/v3/homoit0000990"],"skos:related":"https://homosaurus.org/v3/homoit0000360","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/livingArrangements"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000159","dc:identifier":"homoit0000159","skos:prefLabel":"Bisexual dominants","skos:altLabel":"Bisexual masters","rdfs:comment":"Bisexual people who are part of the BDSM scene and assume the dominant role in sexual relationships with a dominant/submissive dynamic.","skos:broader":"https://homosaurus.org/v3/homoit0000999","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualMasters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000160","dc:identifier":"homoit0000160","skos:prefLabel":"Bisexual men","skos:altLabel":"Male bisexuals","rdfs:comment":"Men who identify as bisexual.","skos:broader":["https://homosaurus.org/v3/homoit0000170","https://homosaurus.org/v3/homoit0001008"],"skos:related":["https://homosaurus.org/v3/homoit0001009","https://homosaurus.org/v3/homoit0001185"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002510"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000161","dc:identifier":"homoit0000161","skos:prefLabel":"Bisexual mistresses","rdfs:comment":"Bisexual women who are part of the BDSM scene and assume the mistress role in sexual relationships with a mistress/submissive dynamic.","skos:broader":"https://homosaurus.org/v3/homoit0001018","skos:related":["https://homosaurus.org/v3/homoit0000751","https://homosaurus.org/v3/homoit0001186","https://homosaurus.org/v3/homoit0001421"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualMistresses"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000162","dc:identifier":"homoit0000162","skos:prefLabel":"Bisexual movement","rdfs:comment":"Umbrella term for activism focused on the rights of bisexual people and issues faced by bisexual communities.","skos:broader":"https://homosaurus.org/v3/homoit0001026","skos:related":["https://homosaurus.org/v3/homoit0000122","https://homosaurus.org/v3/homoit0000147","https://homosaurus.org/v3/homoit0000177"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualMovement"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001322","dc:identifier":"homoit0001322","skos:prefLabel":"Social movements","rdfs:comment":"Organized efforts by groups of people to achieve certain political, social, economic, or cultural goals. Social movements are often intended to carry out, resist, or undo social changes.","skos:narrower"