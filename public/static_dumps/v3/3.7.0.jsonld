kos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000340","dc:identifier":"homoit0000340","skos:prefLabel":"Dee","rdfs:comment":"In Thailand, cisgender women who conform to feminine gender norms and who often partner with masculine-identified toms; similar to a femme in U.S. lesbian culture.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":["https://homosaurus.org/v3/homoit0000687","https://homosaurus.org/v3/homoit0001373"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dee"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000341","dc:identifier":"homoit0000341","skos:prefLabel":"Hate speech","skos:altLabel":["Defamation against groups","Group defamation","Group libel"],"rdfs:comment":"Any form of expression (written or verbal) with the intention to vilify, humiliate, or incite hatred against a individual or group of people on the basis of their actual or perceived race, religion, nationality, sexual identity, gender identity, or ability status.","skos:related":["https://homosaurus.org/v3/homoit0000109","https://homosaurus.org/v3/homoit0000112","https://homosaurus.org/v3/homoit0000850"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93004962"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000341"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hateSpeech"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000342","dc:identifier":"homoit0000342","skos:prefLabel":"Demigender people","rdfs:comment":"People who have a partial connection to a certain gender or concept of gender.","skos:broader":["https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001817"],"skos:narrower":["https://homosaurus.org/v3/homoit0001652","https://homosaurus.org/v3/homoit0001653"],"skos:related":["https://homosaurus.org/v3/homoit0000571","https://homosaurus.org/v3/homoit0001923"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/demigenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000343","dc:identifier":"homoit0000343","skos:prefLabel":"Demisexuality","rdfs:comment":"A sexual orientation generally characterized by the lack of sexual attraction to other people unless or until emotional connections have been formed.","skos:broader":"https://homosaurus.org/v3/homoit0001298","skos:related":["https://homosaurus.org/v3/homoit0000344","https://homosaurus.org/v3/homoit0001535","https://homosaurus.org/v3/homoit0001923","https://homosaurus.org/v3/homoit0001986"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/demisexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000344","dc:identifier":"homoit0000344","skos:prefLabel":"Demisexual people","rdfs:comment":"Individuals who do not experience sexual attraction unless they have first formed a strong emotional connection with a person.","skos:broader":["https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001297","https://homosaurus.org/v3/homoit0001300"],"skos:narrower":"https://homosaurus.org/v3/homoit0003036","skos:related":["https://homosaurus.org/v3/homoit0000343","https://homosaurus.org/v3/homoit0001302","https://homosaurus.org/v3/homoit0001535","https://homosaurus.org/v3/homoit0001985"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/demisexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000345","dc:identifier":"homoit0000345","skos:prefLabel":"Denial of sexual orientation","rdfs:comment":"Refusal to acknowledge or affirm one's own sexual identity, or the sexual identity of another individual.","skos:related":["https://homosaurus.org/v3/homoit0000391","https://homosaurus.org/v3/homoit0000699","https://homosaurus.org/v3/homoit0000936","https://homosaurus.org/v3/homoit0001298","https://homosaurus.org/v3/homoit0002590"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/denialOfSexualOrientation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000346","dc:identifier":"homoit0000346","skos:prefLabel":"Dental dams","skos:altLabel":"Latex barriers","rdfs:comment":"A square sheet of latex or polyurethane used to create a barrier between the mouth and the vagina or anus during oral sex.","skos:broader":"https://homosaurus.org/v3/homoit0001266","skos:related":"https://homosaurus.org/v3/homoit0001251","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85035617"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dentalDams"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000347","dc:identifier":"homoit0000347","skos:prefLabel":"Desire to have children","rdfs:comment":"A person's drive or desire to have children.","skos:related":["https://homosaurus.org/v3/homoit0000255","https://homosaurus.org/v3/homoit0000843","https://homosaurus.org/v3/homoit0000864","https://homosaurus.org/v3/homoit0000914"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000347"},"dc:replaces":{"@id":"http://homosaurus.org/v2/desireToHaveChildren"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000349","dc:identifier":"homoit0000349","skos:prefLabel":"Detention of LGBTQ+ people under a hospital order","skos:altLabel":"Detention of LGBTQ people under a hospital order","rdfs:comment":"Physical and legal confinement of LGBTQ+ people in hospitals or medical institutions, typically to receive evaluation and treatment ordered by a court or other such authority. Can be used to describe both short-term or long-term institutionalization.","skos:broader":"https://homosaurus.org/v3/homoit0000348","skos:related":["https://homosaurus.org/v3/homoit0000394","https://homosaurus.org/v3/homoit0001012"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000348"},"dc:replaces":{"@id":"http://homosaurus.org/v2/detentionOfLGBTQPeopleUnderAHospital"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000350","dc:identifier":"homoit0000350","skos:prefLabel":"Dhurani","rdfs:comment":"Bengali term for third sex people, often referring to feminine people who were assigned male at birth.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dhurani"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000351","dc:identifier":"homoit0000351","skos:prefLabel":"DSM (Diagnostic and Statistical Manual of Mental Disorders)","skos:altLabel":["DSM","Diagnostic and Statistical Manual of Mental Disorders"],"rdfs:comment":"The Diagnostic and Statistical Manual of Mental Disorders, produced by the American Psychiatric Association; can be used in reference to the DSM's historical or present day descriptions of LGBTQ+ identities and practices.","skos:related":"https://homosaurus.org/v3/homoit0001012","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000351"},"dc:replaces":{"@id":"http://homosaurus.org/v2/DSM"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000352","dc:identifier":"homoit0000352","skos:prefLabel":"Intersex","skos:altLabel":["Differences in sex development","Divergences in sex development","DSDs","Hermaphroditism","Intersexuality","Variations in sex development","VSDs","Intersexual"],"rdfs:comment":"An umbrella term used to refer to people born with variations in their physical sex characteristics--including genitals, gonads, chromosomes, and hormonal factors--that do not fit typical definitions of male or female bodies.","skos:broader":"https://homosaurus.org/v3/homoit0001269","skos:narrower":["https://homosaurus.org/v3/homoit0000357","https://homosaurus.org/v3/homoit0000669","https://homosaurus.org/v3/homoit0002835","https://homosaurus.org/v3/homoit0002841"],"skos:related":["https://homosaurus.org/v3/homoit0000618","https://homosaurus.org/v3/homoit0000666","https://homosaurus.org/v3/homoit0000670","https://homosaurus.org/v3/homoit0000671","https://homosaurus.org/v3/homoit0000672","https://homosaurus.org/v3/homoit0001822"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000353","dc:identifier":"homoit0000353","skos:prefLabel":"Dilbaa","rdfs:comment":"Navajo term for a person assigned female at birth who takes on the role of a boy in childhood and a man in adulthood.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":["https://homosaurus.org/v3/homoit0001035","https://homosaurus.org/v3/homoit0001480"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dilbaa"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000354","dc:identifier":"homoit0000354","skos:prefLabel":"Dildo harnesses","skos:altLabel":"Strap-ons","rdfs:comment":"Devices worn to attach a dildo to a person's body, typically so they can penetrate a partner's vagina or anus.","skos:broader":["https://homosaurus.org/v3/homoit0000612","https://homosaurus.org/v3/homoit0001266"],"skos:related":["https://homosaurus.org/v3/homoit0000355","https://homosaurus.org/v3/homoit0001067","https://homosaurus.org/v3/homoit0001342","https://homosaurus.org/v3/homoit0001367"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dildoHarnesses"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000355","dc:identifier":"homoit0000355","skos:prefLabel":"Dildos","rdfs:comment":"A sex toy, often explicitly (although not necessarily) phallic in appearance, intended for sexual penetration or other sexual activity during masturbation or with sex partners.","skos:broader":"https://homosaurus.org/v3/homoit0001266","skos:related":["https://homosaurus.org/v3/homoit0000354","https://homosaurus.org/v3/homoit0001099","https://homosaurus.org/v3/homoit0001342","https://homosaurus.org/v3/homoit0001491"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007007162"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dildos"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000357","dc:identifier":"homoit0000357","skos:prefLabel":"Disorders of sexual development","skos:altLabel":" Disorders of sex development","rdfs:comment":"Term used within medical contexts to refer to a wide range of variations in sex characteristics. Many people with intersex variations consider these terms to be stigmatizing and pathologizing, though they often still encounter them in their medical records.","skos:broader":"https://homosaurus.org/v3/homoit0000352","skos:related":"https://homosaurus.org/v3/homoit0001006","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120728"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/disordersOfSexualDevelopment"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000358","dc:identifier":"homoit0000358","skos:prefLabel":"Diversity","rdfs:comment":"Diversity in characteristics of people in age, gender, religion, ethnicity, sexual orientation, lifestyle, etc.","skos:narrower":["https://homosaurus.org/v3/homoit0000566","https://homosaurus.org/v3/homoit0001290"],"skos:related":"https://homosaurus.org/v3/homoit0000667","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85103571"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000358"},"dc:replaces":{"@id":"http://homosaurus.org/v2/diversity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000359","dc:identifier":"homoit0000359","skos:prefLabel":"Divorced people","rdfs:comment":"People whose marriages have been legally dissolved. ","skos:broader":"https://homosaurus.org/v3/homoit0000989","skos:related":["https://homosaurus.org/v3/homoit0000854","https://homosaurus.org/v3/homoit0001312"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85038648"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/divorcedPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000360","dc:identifier":"homoit0000360","skos:prefLabel":"Domestic partnership contracts","rdfs:comment":"Agreements, legal or otherwise, between two unmarried people in a domestic partnership that define property rights and support obligations if the relationship ends or if one partner dies.","skos:broader":"https://homosaurus.org/v3/homoit0001053","skos:related":["https://homosaurus.org/v3/homoit0000361","https://homosaurus.org/v3/homoit0000362","https://homosaurus.org/v3/homoit0000918","https://homosaurus.org/v3/homoit0000963","https://homosaurus.org/v3/homoit0000973","https://homosaurus.org/v3/homoit0000990"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/domesticPartnershipContracts"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000361","dc:identifier":"homoit0000361","skos:prefLabel":"Domestic partnership retirement benefits","skos:altLabel":"Same-sex pension benefits","rdfs:comment":"Employee benefit plans for people in domestic partnerships that can be accessed upon retirement.","skos:related":["https://homosaurus.org/v3/homoit0000360","https://homosaurus.org/v3/homoit0000918"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97004494"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000361"},"dc:replaces":{"@id":"http://homosaurus.org/v2/domesticPartnershipRetirementBenefits"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000362","dc:identifier":"homoit0000362","skos:prefLabel":"Domestic partnerships","rdfs:comment":"Legal or personal relationships between individuals who live together and share their lives but are not married or joined by civil union.","skos:broader":"https://homosaurus.org/v3/homoit0000973","skos:related":["https://homosaurus.org/v3/homoit0000274","https://homosaurus.org/v3/homoit0000360","https://homosaurus.org/v3/homoit0000990","https://homosaurus.org/v3/homoit0001053","https://homosaurus.org/v3/homoit0001237","https://homosaurus.org/v3/homoit0001311"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/domesticPartnerships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000363","dc:identifier":"homoit0000363","skos:prefLabel":"LGBTQ+ dominatrices","skos:altLabel":["Dominatrices (LGBTQ)","LGBTQ+ D-types","LGBTQ+ Dommes","LGBTQ+ Mistresses"],"rdfs:comment":"The person who takes on the position of authority or power in a power exchange relationship or kink activity. Most commonly used by feminine identified people and professional dominants.","skos:broader":["https://homosaurus.org/v3/homoit0001637","https://homosaurus.org/v3/homoit0003084"],"skos:narrower":["https://homosaurus.org/v3/homoit0000148","https://homosaurus.org/v3/homoit0000738","https://homosaurus.org/v3/homoit0001175","https://homosaurus.org/v3/homoit0001410","https://homosaurus.org/v3/homoit0002990"],"skos:related":["https://homosaurus.org/v3/homoit0000103","https://homosaurus.org/v3/homoit0000705","https://homosaurus.org/v3/homoit0000999","https://homosaurus.org/v3/homoit0001018","https://homosaurus.org/v3/homoit0001318","https://homosaurus.org/v3/homoit0003052"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001637"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dominatricesLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000364","dc:identifier":"homoit0000364","skos:prefLabel":"Donors","rdfs:comment":"Individuals who donate their own biological materials, typically gametes (e.g., sperm or eggs), organs, or blood.","skos:narrower":["https://homosaurus.org/v3/homoit0000390","https://homosaurus.org/v3/homoit0000824","https://homosaurus.org/v3/homoit0001336","https://homosaurus.org/v3/homoit0002616","https://homosaurus.org/v3/homoit0002624","https://homosaurus.org/v3/homoit0002625"],"skos:related":["https://homosaurus.org/v3/homoit0000116","https://homosaurus.org/v3/homoit0000583","https://homosaurus.org/v3/homoit0000843","https://homosaurus.org/v3/homoit0000918","https://homosaurus.org/v3/homoit0001004","https://homosaurus.org/v3/homoit0002621"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000364"},"dc:replaces":{"@id":"http://homosaurus.org/v2/donors"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000365","dc:identifier":"homoit0000365","skos:prefLabel":"Down-low","rdfs:comment":"African American slang term that describes a subculture of Black men who identify as heterosexual but have sex with men.","skos:broader":"https://homosaurus.org/v3/homoit0000015","skos:related":["https://homosaurus.org/v3/homoit0000123","https://homosaurus.org/v3/homoit0000285","https://homosaurus.org/v3/homoit0000286","https://homosaurus.org/v3/homoit0000463","https://homosaurus.org/v3/homoit0001009","https://homosaurus.org/v3/homoit0001261","https://homosaurus.org/v3/homoit0001783","https://homosaurus.org/v3/homoit0001785","https://homosaurus.org/v3/homoit0001786","https://homosaurus.org/v3/homoit0001787","https://homosaurus.org/v3/homoit0001788","https://homosaurus.org/v3/homoit0002278"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/downLow"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000366","dc:identifier":"homoit0000366","skos:prefLabel":"Drab (LGBTQ+ culture)","skos:altLabel":"Drab","rdfs:comment":"Slang term used to describe people wearing masculine clothing, typically drag queens or crossdressers who also sometimes wear feminine clothing. Drab is a shortened form of the phrase \"dressed as a boy\" or \"dress resembling a boy.\"","skos:broader":"https://homosaurus.org/v3/homoit0000568","skos:related":["https://homosaurus.org/v3/homoit0000289","https://homosaurus.org/v3/homoit0000367"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/drab"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000367","dc:identifier":"homoit0000367","skos:prefLabel":"Drag","rdfs:comment":"A performance genre involving dressing and/or using makeup to produce, emphasize, and/or exaggerate traits associated with a certain gender, which typically (but not always) is not the gender the performer primarily identifies with.","skos:broader":"https://homosaurus.org/v3/homoit0000568","skos:narrower":["https://homosaurus.org/v3/homoit0000970","https://homosaurus.org/v3/homoit0003160","https://homosaurus.org/v3/homoit0003245"],"skos:related":["https://homosaurus.org/v3/homoit0000238","https://homosaurus.org/v3/homoit0000289","https://homosaurus.org/v3/homoit0000366","https://homosaurus.org/v3/homoit0000368","https://homosaurus.org/v3/homoit0000369","https://homosaurus.org/v3/homoit0000370","https://homosaurus.org/v3/homoit0000373","https://homosaurus.org/v3/homoit0000375","https://homosaurus.org/v3/homoit0000816","https://homosaurus.org/v3/homoit0001494","https://homosaurus.org/v3/homoit0001808","https://homosaurus.org/v3/homoit0001895","https://homosaurus.org/v3/homoit0001906","https://homosaurus.org/v3/homoit0003359","https://homosaurus.org/v3/homoit0003360"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2020011587"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/drag"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000368","dc:identifier":"homoit0000368","skos:prefLabel":"Drag balls","rdfs:comment":"Events that are part of the drag ball subculture that emerged in early 20th-century New York City among primarily African-American and Latin American LGBTQ+ people. During a drag ball, individuals \"walk\" or perform for prizes.","skos:broader":"https://homosaurus.org/v3/homoit0000861","skos:related":["https://homosaurus.org/v3/homoit0000092","https://homosaurus.org/v3/homoit0000367","https://homosaurus.org/v3/homoit0000370","https://homosaurus.org/v3/homoit0001494"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh94008099"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000861"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragBalls"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000861","dc:identifier":"homoit0000861","skos:prefLabel":"LGBTQ+ events","skos:altLabel":"LGBTQ events","rdfs:comment":"Organized public or social occasions for LGBTQ+ people and communities.","skos:narrower":["https://homosaurus.org/v3/homoit0000368","https://homosaurus.org/v3/homoit0000607","https://homosaurus.org/v3/homoit0000949","https://homosaurus.org/v3/homoit0003080","https://homosaurus.org/v3/homoit0003106","https://homosaurus.org/v3/homoit0003359","https://homosaurus.org/v3/homoit0003360","https://homosaurus.org/v3/homoit0003594","https://homosaurus.org/v3/homoit0003595","https://homosaurus.org/v3/homoit0003596","https://homosaurus.org/v3/homoit0003597","https://homosaurus.org/v3/homoit0003598","https://homosaurus.org/v3/homoit0003599","https://homosaurus.org/v3/homoit0003600","https://homosaurus.org/v3/homoit0003602","https://homosaurus.org/v3/homoit0003603","https://homosaurus.org/v3/homoit0003604","https://homosaurus.org/v3/homoit0003605","https://homosaurus.org/v3/homoit0003606","https://homosaurus.org/v3/homoit0003651","https://homosaurus.org/v3/homoit0003656","https://homosaurus.org/v3/homoit0003734","https://homosaurus.org/v3/homoit0003735"],"skos:related":["https://homosaurus.org/v3/homoit0000853","https://homosaurus.org/v3/homoit0000900","https://homosaurus.org/v3/homoit0002157","https://homosaurus.org/v3/homoit0002166","https://homosaurus.org/v3/homoit0002202","https://homosaurus.org/v3/homoit0003601","https://homosaurus.org/v3/homoit0003607"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000861"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQEvents"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000369","dc:identifier":"homoit0000369","skos:prefLabel":"Drag bars","rdfs:comment":"Establishments (typically serving alcohol) that host drag shows or other events featuring drag performers.","skos:broader":"https://homosaurus.org/v3/homoit0000100","skos:related":["https://homosaurus.org/v3/homoit0000367","https://homosaurus.org/v3/homoit0000370","https://homosaurus.org/v3/homoit0000925","https://homosaurus.org/v3/homoit0003359","https://homosaurus.org/v3/homoit0003360"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragBars"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000370","dc:identifier":"homoit0000370","skos:prefLabel":"Drag community","rdfs:comment":"Groups of people (typically drag performers) with a shared interest in drag performances and culture.","skos:broader":"https://homosaurus.org/v3/homoit0000297","skos:narrower":"https://homosaurus.org/v3/homoit0000371","skos:related":["https://homosaurus.org/v3/homoit0000092","https://homosaurus.org/v3/homoit0000367","https://homosaurus.org/v3/homoit0000368","https://homosaurus.org/v3/homoit0000369","https://homosaurus.org/v3/homoit0000373","https://homosaurus.org/v3/homoit0000375","https://homosaurus.org/v3/homoit0001900","https://homosaurus.org/v3/homoit0001906"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragCommunity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000371","dc:identifier":"homoit0000371","skos:prefLabel":"Drag families","rdfs:comment":"Groups of drag performers who share a community and typically live in close quarters with one another. Drag families are headed by drag mothers or drag fathers, with other members termed drag daughters and sons. Members of a drag family typically use the same last name as their drag mother or father (e.g., Xtravaganza) in social contexts or while performing.","skos:broader":["https://homosaurus.org/v3/homoit0000370","https://homosaurus.org/v3/homoit0000420","https://homosaurus.org/v3/homoit0000834"],"skos:narrower":["https://homosaurus.org/v3/homoit0000372","https://homosaurus.org/v3/homoit0000374"],"skos:related":["https://homosaurus.org/v3/homoit0000094","https://homosaurus.org/v3/homoit0000373","https://homosaurus.org/v3/homoit0000375"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000372","dc:identifier":"homoit0000372","skos:prefLabel":"Drag fathers","rdfs:comment":"More experienced drag kings who support less experienced drag kings as they enter the drag scene as performers.","skos:broader":"https://homosaurus.org/v3/homoit0000371","skos:related":["https://homosaurus.org/v3/homoit0000373","https://homosaurus.org/v3/homoit0000374","https://homosaurus.org/v3/homoit0000375"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragFathers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000373","dc:identifier":"homoit0000373","skos:prefLabel":"Drag kings","rdfs:comment":"Performers, often people assigned female at birth, who dress in stereotypically masculine attire and enact masculine personas for the purpose of entertainment.","skos:related":["https://homosaurus.org/v3/homoit0000316","https://homosaurus.org/v3/homoit0000367","https://homosaurus.org/v3/homoit0000370","https://homosaurus.org/v3/homoit0000371","https://homosaurus.org/v3/homoit0000372","https://homosaurus.org/v3/homoit0000374","https://homosaurus.org/v3/homoit0000375","https://homosaurus.org/v3/homoit0000983","https://homosaurus.org/v3/homoit0001906"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2021001446"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000373"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragKings"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000374","dc:identifier":"homoit0000374","skos:prefLabel":"Drag mothers","rdfs:comment":"More experienced drag queens who support less experienced drag queens as they enter the drag scene as performers.","skos:broader":"https://homosaurus.org/v3/homoit0000371","skos:related":["https://homosaurus.org/v3/homoit0000372","https://homosaurus.org/v3/homoit0000373","https://homosaurus.org/v3/homoit0000375"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragMothers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000375","dc:identifier":"homoit0000375","skos:prefLabel":"Drag queens","rdfs:comment":"Performers, often people assigned male at birth, who dress in stereotypically feminine attire and enact feminine personas for the purpose of entertainment.","skos:broader":"https://homosaurus.org/v3/homoit0001148","skos:related":["https://homosaurus.org/v3/homoit0000316","https://homosaurus.org/v3/homoit0000367","https://homosaurus.org/v3/homoit0000370","https://homosaurus.org/v3/homoit0000371","https://homosaurus.org/v3/homoit0000372","https://homosaurus.org/v3/homoit0000373","https://homosaurus.org/v3/homoit0000374","https://homosaurus.org/v3/homoit0000431","https://homosaurus.org/v3/homoit0001906"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2021001445"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragQueens"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000376","dc:identifier":"homoit0000376","skos:prefLabel":"LGBTQ+ drama","skos:altLabel":"Drama (LGBTQ)","rdfs:comment":"Works of fiction written to be performed; use in reference to dramatic works focusing on LGBTQ+ characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000972","skos:narrower":["https://homosaurus.org/v3/homoit0000149","https://homosaurus.org/v3/homoit0000489","https://homosaurus.org/v3/homoit0000739","https://homosaurus.org/v3/homoit0001174","https://homosaurus.org/v3/homoit0001411","https://homosaurus.org/v3/homoit0002452","https://homosaurus.org/v3/homoit0002468","https://homosaurus.org/v3/homoit0002485","https://homosaurus.org/v3/homoit0002501","https://homosaurus.org/v3/homoit0002522","https://homosaurus.org/v3/homoit0002739"],"skos:related":["https://homosaurus.org/v3/homoit0000922","https://homosaurus.org/v3/homoit0001363","https://homosaurus.org/v3/homoit0001723","https://homosaurus.org/v3/homoit0002691"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dramaLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000377","dc:identifier":"homoit0000377","skos:prefLabel":"Driver's licenses","rdfs:comment":"Legal documents authorizing individuals to operate motor vehicles; commonly used as legal proof of identity; can be used in reference to LGBTQ+ people seeking driver's licenses or changes to existing licenses (e.g., name, gender or sex marker, photo).","skos:broader":"https://homosaurus.org/v3/homoit0001053","skos:narrower":"https://homosaurus.org/v3/homoit0000573","skos:related":["https://homosaurus.org/v3/homoit0000247","https://homosaurus.org/v3/homoit0000311","https://homosaurus.org/v3/homoit0000711","https://homosaurus.org/v3/homoit0001005","https://homosaurus.org/v3/homoit0001324","https://homosaurus.org/v3/homoit0001465"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85010130"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/driversLicenses"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0000378","dc:identifier":"homoit0000378","skos:prefLabel":"Drug abuse","skos:altLabel":["Drug addiction","Drug dependence"],"skos:broader":"https://homosaurus.org/v3/homoit0002226","skos:narrower":"https://homosaurus.org/v3/homoit0002226","skos:related":["https://homosaurus.org/v3/homoit0000379","https://homosaurus.org/v3/homoit0000380","https://homosaurus.org/v3/homoit0001235"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85039675"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000251"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0002226"},"dc:replaces":{"@id":"http://homosaurus.org/v2/drugAbuse"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000379","dc:identifier":"homoit0000379","skos:prefLabel":"LGBTQ+ people who use substances","skos:altLabel":["Drug users (LGBTQ)","LGBTQ+ people who drink","LGBTQ+ people who use drugs","Substance users (LGBTQ)"],"rdfs:comment":"Umbrella term for LGBTQ+ people who use substances (that are typically deemed harmful or are subject to legal restriction, such as drugs or alcohol) for any reason. Apply more specific terms if possible.","skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:narrower":["https://homosaurus.org/v3/homoit0001235","https://homosaurus.org/v3/homoit0001540","https://homosaurus.org/v3/homoit0001550","https://homosaurus.org/v3/homoit0002229"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/drugUsers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000381","dc:identifier":"homoit0000381","skos:prefLabel":"Dutch boys","skos:altLabel":"Lesbros","rdfs:comment":"Slang for heterosexual men who are friends with lesbians and socialize in lesbian spaces.","skos:broader":"https://homosaurus.org/v3/homoit0000626","skos:related":["https://homosaurus.org/v3/homoit0000416","https://homosaurus.org/v3/homoit0000455","https://homosaurus.org/v3/homoit0000598","https://homosaurus.org/v3/homoit0001133","https://homosaurus.org/v3/homoit0001788"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000627"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dutchBoys"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000382","dc:identifier":"homoit0000382","skos:prefLabel":"Lesbian culture","skos:altLabel":"Dyke culture","rdfs:comment":"Use to describe cultural experiences shared by members of lesbian communities or products of lesbian culture (e.g., art and media created by and for lesbians, activism focused on lesbian issues, slang commonly used in lesbian communities, etc.).","skos:broader":"https://homosaurus.org/v3/homoit0001831","skos:narrower":["https://homosaurus.org/v3/homoit0000230","https://homosaurus.org/v3/homoit0000385","https://homosaurus.org/v3/homoit0000730","https://homosaurus.org/v3/homoit0000755","https://homosaurus.org/v3/homoit0000779"],"skos:related":["https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001832","https://homosaurus.org/v3/homoit0001833"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2004003370"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianCulture"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000383","dc:identifier":"homoit0000383","skos:prefLabel":"Dyke marches","rdfs:comment":"Marches, rallies, and other public gatherings focused on lesbian visibility, rights, and issues. This term should only be used to describe marches explicitly for dykes or marches centered on the dyke identity and politics. Otherwise, use the more general term \"Lesbian pride.\"","skos:broader":"https://homosaurus.org/v3/homoit0003651","skos:related":"https://homosaurus.org/v3/homoit0000767","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000861"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dykeMarches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000384","dc:identifier":"homoit0000384","skos:prefLabel":"Dykes","rdfs:comment":"A largely reclaimed slur common in the U.S. that may be used to refer to lesbians who embrace a masculine style of presentation or lesbian political activists in general. Only use for individuals who self-identify as dykes.","skos:broader":["https://homosaurus.org/v3/homoit0001559","https://homosaurus.org/v3/homoit0001560"],"skos:related":["https://homosaurus.org/v3/homoit0000231","https://homosaurus.org/v3/homoit0000440","https://homosaurus.org/v3/homoit0000556","https://homosaurus.org/v3/homoit0003719"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001317"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dykes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000385","dc:identifier":"homoit0000385","skos:prefLabel":"Dykes on bikes","rdfs:comment":"A chartered motorcycle club with many loosely affiliated chapters that are comprised of lesbian members who identify as dykes; known for their participation in gay pride events.","skos:broader":"https://homosaurus.org/v3/homoit0000382","skos:related":["https://homosaurus.org/v3/homoit0000906","https://homosaurus.org/v3/homoit0003104"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dykesOnBikes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000386","dc:identifier":"homoit0000386","skos:prefLabel":"LGBTQ+ Eastern Orthodox Christians","skos:altLabel":["Eastern Orthodox Christians (LGBTQ)","LGBTQ Orthodox Eastern Christians","LGBTQ Eastern Orthodox Christians"],"rdfs:comment":"LGBTQ+ people who are members of the Eastern Orthodox Christian Church.","skos:broader":"https://homosaurus.org/v3/homoit0000265","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQEasternOrthodoxChristians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000387","dc:identifier":"homoit0000387","skos:prefLabel":"Ecofeminism","rdfs:comment":"Political and philosophical movement that views feminism and concerns for the environment as inherently related.","skos:broader":"https://homosaurus.org/v3/homoit0000437","skos:related":"https://homosaurus.org/v3/homoit0003171","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh91001601"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000437"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ecofeminism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000437","dc:identifier":"homoit0000437","skos:prefLabel":"Feminism","rdfs:comment":"Collection of movements aimed at defining, establishing, and defending equal political, economic, and social rights and equal opportunities for women.","skos:narrower":["https://homosaurus.org/v3/homoit0000387","https://homosaurus.org/v3/homoit0000444","https://homosaurus.org/v3/homoit0000622","https://homosaurus.org/v3/homoit0000741","https://homosaurus.org/v3/homoit0001230","https://homosaurus.org/v3/homoit0001260","https://homosaurus.org/v3/homoit0002270","https://homosaurus.org/v3/homoit0002271","https://homosaurus.org/v3/homoit0002274","https://homosaurus.org/v3/homoit0002275","https://homosaurus.org/v3/homoit0003101","https://homosaurus.org/v3/homoit0003121","https://homosaurus.org/v3/homoit0003765","https://homosaurus.org/v3/homoit0003767"],"skos:related":["https://homosaurus.org/v3/homoit0000054","https://homosaurus.org/v3/homoit0000438","https://homosaurus.org/v3/homoit0001505","https://homosaurus.org/v3/homoit0001509","https://homosaurus.org/v3/homoit0001516","https://homosaurus.org/v3/homoit0002039","https://homosaurus.org/v3/homoit0002290","https://homosaurus.org/v3/homoit0003157","https://homosaurus.org/v3/homoit0003158"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85047741"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000437"},"dc:replaces":{"@id":"http://homosaurus.org/v2/feminism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0000388","dc:identifier":"homoit0000388","skos:prefLabel":"MDMA","skos:altLabel":["Ecstacy","Molly","XTC"],"rdfs:comment":"A type of methamphetamine commonly referred to as ecstasy or molly","skos:broader":"https://homosaurus.org/v3/homoit0001235","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh89002646"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000380"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000380"},"dc:replaces":{"@id":"http://homosaurus.org/v2/MDMA"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000389","dc:identifier":"homoit0000389","skos:prefLabel":"Femininities","skos:altLabel":["Effeminacy","Femininity"],"rdfs:comment":"Culture-specific sets of attributes, behaviors, and roles generally associated with women or girls.","skos:broader":"https://homosaurus.org/v3/homoit0000568","skos:narrower":["https://homosaurus.org/v3/homoit0001821","https://homosaurus.org/v3/homoit0002043"],"skos:related":["https://homosaurus.org/v3/homoit0000047","https://homosaurus.org/v3/homoit0000440","https://homosaurus.org/v3/homoit0000577","https://homosaurus.org/v3/homoit0000995","https://homosaurus.org/v3/homoit0001382"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85047739"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/femininity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000390","dc:identifier":"homoit0000390","skos:prefLabel":"Egg donors","rdfs:comment":"Individuals of any gender who donate their own eggs for the purpose of inducing pregnancy.","skos:broader":"https://homosaurus.org/v3/homoit0000364","skos:related":["https://homosaurus.org/v3/homoit0000583","https://homosaurus.org/v3/homoit0000864","https://homosaurus.org/v3/homoit0001347","https://homosaurus.org/v3/homoit0002627"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005007904"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000364"},"dc:replaces":{"@id":"http://homosaurus.org/v2/eggDonors"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000391","dc:identifier":"homoit0000391","skos:prefLabel":["Internalized homophobia","Internalised homophobia"],"skos:altLabel":"Ego-dystonic homophobia","rdfs:comment":"This term is often used to describe internalized oppression held by and about LGBTQ+ people in general. It can also describe the more specific phenomenon in which gay men internalize or adopt homophobic beliefs (i.e., negative perceptions of and intolerance toward gay men and homosexuality) as a result of being raised or socialized within a homophobic environment or culture. ","skos:broader":["https://homosaurus.org/v3/homoit0000646","https://homosaurus.org/v3/homoit0002590"],"skos:narrower":"https://homosaurus.org/v3/homoit0003093","skos:related":["https://homosaurus.org/v3/homoit0000345","https://homosaurus.org/v3/homoit0000392","https://homosaurus.org/v3/homoit0000699","https://homosaurus.org/v3/homoit0000936"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005020575"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/internalisedHomophobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000392","dc:identifier":"homoit0000392","skos:prefLabel":"Ego-dystonic sexual orientation","skos:altLabel":"Ego-dystonic homosexuality","rdfs:comment":"Internal conflict caused by having a sexual identity or attraction that is at odds with one’s idealized self-image.","skos:broader":"https://homosaurus.org/v3/homoit0001011","skos:related":["https://homosaurus.org/v3/homoit0000303","https://homosaurus.org/v3/homoit0000391"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ego-dystonicSexualOrientation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001011","dc:identifier":"homoit0001011","skos:prefLabel":"Mental disorders","skos:altLabel":["Mental illnesses","Psychiatric disorders"],"rdfs:comment":"Medical conditions defined by changes or disturbances in an individual's thinking, feeling, mood, and behavior.","skos:narrower":"https://homosaurus.org/v3/homoit0000392","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85083643"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mentalDisorders"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000393","dc:identifier":"homoit0000393","skos:prefLabel":"LGBTQ+ older people","skos:altLabel":["Elderly (LGBTQ)","Senior citizens (LGBTQ)","Seniors (LGBTQ)","Older people (LGBTQ)"],"rdfs:comment":"LGBTQ+ people who are advanced in age, typically defined as older than 60 years of age.","skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:narrower":["https://homosaurus.org/v3/homoit0001054","https://homosaurus.org/v3/homoit0001055","https://homosaurus.org/v3/homoit0001056","https://homosaurus.org/v3/homoit0001057","https://homosaurus.org/v3/homoit0001058"],"skos:related":["https://homosaurus.org/v3/homoit0000856","https://homosaurus.org/v3/homoit0000931"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2004011614"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/olderPeopleLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000394","dc:identifier":"homoit0000394","skos:prefLabel":"Electroshock therapy","skos:altLabel":["Electric shock therapy","Electroconvulsive therapy"],"rdfs:comment":"A form of psychiatric treatment for major depression, bipolar depression, and other mental health conditions that usually consists of brief electrical pulses to the brain through electrodes on the head that induce controlled seizures. Electroshock therapy has historically been used as an attempt to \"cure\" homosexuality and other non-normative sexualities and sexual practices.","skos:broader":"https://homosaurus.org/v3/homoit0001366","skos:related":"https://homosaurus.org/v3/homoit0000349","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85041999"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/electroshockTherapy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000395","dc:identifier":"homoit0000395","skos:prefLabel":"Eonism","rdfs:comment":"Historical term used to describe people assigned male at birth who adopt feminine behaviors.","skos:broader":["https://homosaurus.org/v3/homoit0000568","https://homosaurus.org/v3/homoit0000878","https://homosaurus.org/v3/homoit0001006"],"skos:related":["https://homosaurus.org/v3/homoit0000318","https://homosaurus.org/v3/homoit0000396","https://homosaurus.org/v3/homoit0001296","https://homosaurus.org/v3/homoit0001463","https://homosaurus.org/v3/homoit0001468","https://homosaurus.org/v3/homoit0001469"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/eonism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000396","dc:identifier":"homoit0000396","skos:prefLabel":"Eonist people","rdfs:comment":"Historical term for people assigned male at birth who adopt feminine behaviors.","skos:broader":"https://homosaurus.org/v3/homoit0000878","skos:related":["https://homosaurus.org/v3/homoit0000316","https://homosaurus.org/v3/homoit0000395","https://homosaurus.org/v3/homoit0001378"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/eonistPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0000397","dc:identifier":"homoit0000397","skos:prefLabel":"Ephebophilia","rdfs:comment":"Sexual preference for young adults between the ages of 16 and 20","skos:broader":["https://homosaurus.org/v3/homoit0000442","https://homosaurus.org/v3/homoit0001300"],"skos:narrower":"https://homosaurus.org/v3/homoit0000442","skos:related":["https://homosaurus.org/v3/homoit0000442","https://homosaurus.org/v3/homoit0000663","https://homosaurus.org/v3/homoit0001520","https://homosaurus.org/v3/homoit0001521"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000404"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000442"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ephebophilia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-11-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000398","dc:identifier":"homoit0000398","skos:prefLabel":"Erectile dysfunction","skos:altLabel":"Impotence","rdfs:comment":"Persistent difficulties in achieving or maintaining erections, typically for sexual activities.","skos:broader":"https://homosaurus.org/v3/homoit0001291","skos:related":["https://homosaurus.org/v3/homoit0000399","https://homosaurus.org/v3/homoit0000400","https://homosaurus.org/v3/homoit0003058"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85064658"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001291"},"dc:replaces":{"@id":"http://homosaurus.org/v2/erectileDysfunction"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001291","dc:identifier":"homoit0001291","skos:prefLabel":"Sexual dysfunction","skos:altLabel":"Sexual malfunction","rdfs:comment":"Recurring problems or difficulties with sexual response, desire, or pleasure. Includes dysfunction occurring at any time in the sexual response cycle that causes distress or prevents one’s typical sexual function.","skos:narrower":["https://homosaurus.org/v3/homoit0000398","https://homosaurus.org/v3/homoit0001489"],"skos:related":["https://homosaurus.org/v3/homoit0001274","https://homosaurus.org/v3/homoit0001284","https://homosaurus.org/v3/homoit0001292","https://homosaurus.org/v3/homoit0001294","https://homosaurus.org/v3/homoit0001306"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001291"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualDysfunction"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000399","dc:identifier":"homoit0000399","skos:prefLabel":"Erection pills","rdfs:comment":"Medications used to relax muscles in the penis, increasing blood flow to allow for an erection in response to sexual stimuli.","skos:broader":"https://homosaurus.org/v3/homoit0001007","skos:related":["https://homosaurus.org/v3/homoit0000398","https://homosaurus.org/v3/homoit0000400","https://homosaurus.org/v3/homoit0002289"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/erectionPills"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000400","dc:identifier":"homoit0000400","skos:prefLabel":"Erections","rdfs:comment":"Enlargement of the erectile tissue of the penis or clitoris due to increased blood flow; typically associated with sexual arousal. ","skos:related":["https://homosaurus.org/v3/homoit0000398","https://homosaurus.org/v3/homoit0000399","https://homosaurus.org/v3/homoit0001099"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007006549"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000400"},"dc:replaces":{"@id":"http://homosaurus.org/v2/erections"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000402","dc:identifier":"homoit0000402","skos:prefLabel":"Erotic massage","rdfs:comment":"Massage intended to enhance sexual arousal. ","skos:broader":["https://homosaurus.org/v3/homoit0000998","https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001299"],"skos:related":["https://homosaurus.org/v3/homoit0000610","https://homosaurus.org/v3/homoit0000988","https://homosaurus.org/v3/homoit0003796"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000998"},"dc:replaces":{"@id":"http://homosaurus.org/v2/eroticMassage"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000998","dc:identifier":"homoit0000998","skos:prefLabel":"Massage","rdfs:comment":"Manipulation of the body through techniques like rubbing and kneading muscles and joints with the hands, typically to relieve tension and pain or to provide erotic stimulation.","skos:narrower":"https://homosaurus.org/v3/homoit0000402","skos:related":"https://homosaurus.org/v3/homoit0001112","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081957"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000998"},"dc:replaces":{"@id":"http://homosaurus.org/v2/massage"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000403","dc:identifier":"homoit0000403","skos:prefLabel":"Erotica","rdfs:comment":"The portrayal of sexuality with high-art aspirations, typically also focusing on feelings and emotions.","skos:narrower":"https://homosaurus.org/v3/homoit0000859","skos:related":["https://homosaurus.org/v3/homoit0000816","https://homosaurus.org/v3/homoit0001128"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85044718"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000403"},"dc:replaces":{"@id":"http://homosaurus.org/v2/erotica"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000405","dc:identifier":"homoit0000405","skos:prefLabel":"Escort services","rdfs:comment":"Agencies that serve to connect paying clients with escorts offering services by appointment. Escort services may be less stigmatized than other forms of sex work, in part because it tends to be safer for escorts and because some escorts offer a broader range of services, including accompaniment or entertainment without the promise of sexual contact. However, the tendency to frame escorting as separate from or superior to other forms of sex work obscures the labor undertaken by escorts and perpetuates discrimination against the most marginalized and vulnerable sex workers.","skos:broader":"https://homosaurus.org/v3/homoit0001276","skos:related":"https://homosaurus.org/v3/homoit0000406","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85044807"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/escortServices"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000406","dc:identifier":"homoit0000406","skos:prefLabel":"Escorts","skos:altLabel":["Call boys","Call girls"],"rdfs:comment":"Sex workers whose clients are required to make appointments for their services. Unlike sex workers who solicit clients on the street or in institutions like brothels, escorts typically advertise their services online, whether independently or through agencies. Escorting may be less stigmatized than other forms of sex work, in part because it tends to be safer for escorts and because some escorts offer a broader range of services, including accompaniment or entertainment without the promise of sexual contact. However, the tendency to frame escorting as separate from or superior to other forms of sex work obscures the labor undertaken by escorts and perpetuates discrimination against the most marginalized and vulnerable sex workers.","skos:broader":"https://homosaurus.org/v3/homoit0003758","skos:related":"https://homosaurus.org/v3/homoit0000405","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003758"},"dc:replaces":{"@id":"http://homosaurus.org/v2/escorts"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000407","dc:identifier":"homoit0000407","skos:prefLabel":"Estrogen","rdfs:comment":"A category of steroid hormones including estrone, estradiol, estriol, and estetrol. Estrogens are commonly utilized in feminizing hormone therapy regimens. Estrogens are produced mainly in the ovaries, in addition to the adrenal glands and fat cells. Responsible for certain secondary sexual characteristics, including breast growth, thickening of the endometrium, menstrual cycle regulation, and sperm maturation.","skos:broader":["https://homosaurus.org/v3/homoit0000317","https://homosaurus.org/v3/homoit0000651"],"skos:related":["https://homosaurus.org/v3/homoit0000986","https://homosaurus.org/v3/homoit0001642"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85045012"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/estrogen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000408","dc:identifier":"homoit0000408","skos:prefLabel":"Etiology","rdfs:comment":"Inquiries and speculations regarding the causes of sexual behaviors or diseases.","skos:broader":"https://homosaurus.org/v3/homoit0001365","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh00005666"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/etiology"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0000409","dc:identifier":"homoit0000409","skos:prefLabel":"Eurogames","rdfs:comment":"The most important gay and lesbian sporting event in Europe, hosted by license of the European Gay and Lesbian Sport Federation (EGLSF)","skos:broader":"https://homosaurus.org/v3/homoit0000949","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000861"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000949"},"dc:replaces":{"@id":"http://homosaurus.org/v2/eurogames"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-22"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0000410","dc:identifier":"homoit0000410","skos:prefLabel":"Europride","rdfs:comment":"A pan-European international event dedicated to LGBTQ+ pride that is hosted by a different European city each year","skos:broader":"https://homosaurus.org/v3/homoit0000522","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003653"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000861"},"dc:replaces":{"@id":"http://homosaurus.org/v2/europride"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-10-04"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003653","dc:identifier":"homoit0003653","skos:prefLabel":"LGBTQ+ pride","skos:altLabel":"Pride (LGBTQ)","rdfs:comment":"The recognition and celebration of LGBTQ+ people and culture, thereby affirming the visibility, dignity, and diversity of LGBTQ+ communities.","skos:narrower":["https://homosaurus.org/v3/homoit0000522","https://homosaurus.org/v3/homoit0000767","https://homosaurus.org/v3/homoit0003654","https://homosaurus.org/v3/homoit0003655"],"skos:related":["https://homosaurus.org/v3/homoit0003246","https://homosaurus.org/v3/homoit0002386"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003653"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000411","dc:identifier":"homoit0000411","skos:prefLabel":"Ex-gay movement","rdfs:comment":"People and organizations that encourage people to resist entering or pursuing same-sex relationships, to eliminate homosexual desires, to develop heterosexual desires, and/or to enter into heterosexual relationships.","skos:broader":"https://homosaurus.org/v3/homoit0001322","skos:related":["https://homosaurus.org/v3/homoit0000303","https://homosaurus.org/v3/homoit0000619"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005005425"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ex-gayMovement"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000412","dc:identifier":"homoit0000412","skos:prefLabel":"Exhibitionism","rdfs:comment":"A kink characterized by the sexual desire to display one's body or engage in sexual activities in public.","skos:broader":["https://homosaurus.org/v3/homoit0000442","https://homosaurus.org/v3/homoit0001299"],"skos:related":["https://homosaurus.org/v3/homoit0001142","https://homosaurus.org/v3/homoit0001257","https://homosaurus.org/v3/homoit0001283"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85046353"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/exhibitionism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000413","dc:identifier":"homoit0000413","skos:prefLabel":"Fa'afafine","rdfs:comment":"In New Zealand, Samoan people who were assigned male at birth but behave in feminine ways and may consider themselves women.","skos:broader":["https://homosaurus.org/v3/homoit0000322","https://homosaurus.org/v3/homoit0002653"],"skos:related":"https://homosaurus.org/v3/homoit0000414","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/faafafine"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000414","dc:identifier":"homoit0000414","skos:prefLabel":"Fa'afatama","rdfs:comment":"In New Zealand, Samoan people who were assigned female at birth but behave in masculine ways and may consider themselves men.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":"https://homosaurus.org/v3/homoit0000413","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/faafatama"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000415","dc:identifier":"homoit0000415","skos:prefLabel":"Faeries","skos:altLabel":["Radical Faeries","Faes"],"rdfs:comment":"Queer people who are involved with or identify with the countercultural movement seeking to redefine queer consciousness through secular spirituality. Often but not always associated with the Radical Faeries, a loosely affiliated worldwide network that formed in the 1970s.","skos:broader":["https://homosaurus.org/v3/homoit0000487","https://homosaurus.org/v3/homoit0001295"],"skos:related":["https://homosaurus.org/v3/homoit0000948","https://homosaurus.org/v3/homoit0002230"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh98004651"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/faeries"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000416","dc:identifier":"homoit0000416","skos:prefLabel":"Fag hags","rdfs:comment":"Slang for heterosexual women who are friends with gay men and socialize in gay spaces.","skos:broader":"https://homosaurus.org/v3/homoit0000629","skos:related":["https://homosaurus.org/v3/homoit0000381","https://homosaurus.org/v3/homoit0000455","https://homosaurus.org/v3/homoit0000598","https://homosaurus.org/v3/homoit0001133","https://homosaurus.org/v3/homoit0001788"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000627"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fagHags"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000417","dc:identifier":"homoit0000417","skos:prefLabel":"Fag stags","rdfs:comment":"Slang for heterosexual men who enjoy the company of gay men.","skos:broader":"https://homosaurus.org/v3/homoit0000626","skos:related":["https://homosaurus.org/v3/homoit0000455","https://homosaurus.org/v3/homoit0001133"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000627"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fagStags"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000418","dc:identifier":"homoit0000418","skos:prefLabel":"Faggots","skos:altLabel":"Fags","rdfs:comment":"Slur used chiefly in North America to refer to gay men (or, in some cases, LGBTQ+ people in general). Some gay men have reclaimed this term and use it to describe themselves.","skos:broader":["https://homosaurus.org/v3/homoit0000878","https://homosaurus.org/v3/homoit0001559","https://homosaurus.org/v3/homoit0001560"],"skos:related":"https://homosaurus.org/v3/homoit0000506","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/faggots"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000419","dc:identifier":"homoit0000419","skos:prefLabel":"Fakaleitī","skos:altLabel":"Fakaleiti","rdfs:comment":"Tongan people assigned male at birth who behave in an effeminate manner.","skos:broader":["https://homosaurus.org/v3/homoit0000322","https://homosaurus.org/v3/homoit0002653"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fakaleiti"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000422","dc:identifier":"homoit0000422","skos:prefLabel":"Fat distribution","rdfs:comment":"Location and arrangement of fat on the body, typically increasing during puberty as a secondary sex characteristic. ","skos:broader":"https://homosaurus.org/v3/homoit0001259","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fatDistribution"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000423","dc:identifier":"homoit0000423","skos:prefLabel":"Fathers","rdfs:comment":"People who are fathers.","skos:broader":"https://homosaurus.org/v3/homoit0000421","skos:narrower":["https://homosaurus.org/v3/homoit0002337","https://homosaurus.org/v3/homoit0002342","https://homosaurus.org/v3/homoit0003242"],"skos:related":["https://homosaurus.org/v3/homoit0000866","https://homosaurus.org/v3/homoit0001093"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85047451"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fathers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000424","dc:identifier":"homoit0000424","skos:prefLabel":"Fathers of bisexual people","rdfs:comment":"People who assume the role of father to bisexual people. Only use to describe individuals who identify as fathers.","skos:broader":"https://homosaurus.org/v3/homoit0002342","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fathersOfBisexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000425","dc:identifier":"homoit0000425","skos:prefLabel":"Fathers of gay men","rdfs:comment":"People who assume the role of father to gay men. Only use to describe individuals who identify as fathers.","skos:broader":"https://homosaurus.org/v3/homoit0002342","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fathersOfGayMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000426","dc:identifier":"homoit0000426","skos:prefLabel":"Fathers of lesbians","rdfs:comment":"People who assume the role of father to lesbians. Only use to describe individuals who identify as fathers.","skos:broader":"https://homosaurus.org/v3/homoit0002342","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fathersOfLesbians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000427","dc:identifier":"homoit0000427","skos:prefLabel":"Fathers of queer people","rdfs:comment":"People who assume the role of father to queer people. Only use to describe individuals who identify as fathers.","skos:broader":"https://homosaurus.org/v3/homoit0002342","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fathersOfQueerPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000428","dc:identifier":"homoit0000428","skos:prefLabel":"Fathers of transgender people","rdfs:comment":"People who assume the role of father to transgender people. Only use to describe individuals who identify as fathers.","skos:broader":"https://homosaurus.org/v3/homoit0002342","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fathersOfTransgenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000429","dc:identifier":"homoit0000429","skos:prefLabel":"Women's friendships","skos:altLabel":"Female friendships","rdfs:comment":"Connections based on affection and trust between two or more women.","skos:broader":["https://homosaurus.org/v3/homoit0000455","https://homosaurus.org/v3/homoit0000649"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh96004236"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womensFriendships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000431","dc:identifier":"homoit0000431","skos:prefLabel":"Female impersonators","rdfs:comment":"Historical term describing performers, often male-identified people, who enact female personas for the purpose of entertainment, often for straight audiences. Eclipsed by other terms (such as drag queen) in the late 20th century.","skos:broader":"https://homosaurus.org/v3/homoit0001363","skos:related":["https://homosaurus.org/v3/homoit0000375","https://homosaurus.org/v3/homoit0003816"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85064634"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001363"},"dc:replaces":{"@id":"http://homosaurus.org/v2/femaleImpersonators"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000432","dc:identifier":"homoit0000432","skos:prefLabel":"Female masculinity","rdfs:comment":"Form of masculinity enacted by people with a female or feminine gender identity, often by performing masculine roles, characteristics, and styles of dress.","skos:broader":"https://homosaurus.org/v3/homoit0000995","skos:related":["https://homosaurus.org/v3/homoit0000215","https://homosaurus.org/v3/homoit0000231","https://homosaurus.org/v3/homoit0001898"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/femaleMasculinity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000433","dc:identifier":"homoit0000433","skos:prefLabel":"Female sex workers","skos:altLabel":["Female prostitutes","Female prostitution","Women prostitutes","Women prostitution","Working girls","Women sex work","Female sex work"],"rdfs:comment":"Women who receive money or goods in exchange for sexual services, performances, or companionship. Use to describe women working across the broad spectrum of sex work.","skos:broader":"https://homosaurus.org/v3/homoit0003758","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85107622"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003758"},"dc:replaces":{"@id":"http://homosaurus.org/v2/femaleProstitutes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0000434","dc:identifier":"homoit0000434","skos:prefLabel":"Female prostitution","skos:broader":"https://homosaurus.org/v3/homoit0001136","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85107626"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000011"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000433"},"dc:replaces":{"@id":"http://homosaurus.org/v2/femaleProstitution"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-28"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0000435","dc:identifier":"homoit0000435","skos:prefLabel":"Females","skos:narrower":["https://homosaurus.org/v3/homoit0000273","https://homosaurus.org/v3/homoit0001642"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85047734"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000435"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001509"},"dc:replaces":{"@id":"http://homosaurus.org/v2/females"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-10-25"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000436","dc:identifier":"homoit0000436","skos:prefLabel":"FtMs","skos:altLabel":["Females transitioning to males","FtM transsexuals","F2Ms","Transsexual men","Female-to-male"],"rdfs:comment":"FtM (female-to-male) is a mostly historical term which has been largely replaced by “trans men.” This is due in part to the term's role in the medicalization of transgender people and the assumption that trans men were previously “female” and have become “male” (typically through hormones and/or surgery).","skos:broader":["https://homosaurus.org/v3/homoit0000878","https://homosaurus.org/v3/homoit0001381","https://homosaurus.org/v3/homoit0001643"],"skos:related":["https://homosaurus.org/v3/homoit0000114","https://homosaurus.org/v3/homoit0000224","https://homosaurus.org/v3/homoit0000457","https://homosaurus.org/v3/homoit0000986","https://homosaurus.org/v3/homoit0001027","https://homosaurus.org/v3/homoit0001362"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/FtMs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000438","dc:identifier":"homoit0000438","skos:prefLabel":"Women's movement","skos:altLabel":"Feminist movement","rdfs:comment":"Social and political movement originating in the 1800s for reforms on women’s issues stemming from social, cultural, political, and economic inequality between men and women. Feminist issues include reproductive rights, women’s liberation, and equal pay. This term encompasses the women’s movement in its entirety, including different waves of feminist thought and activism.","skos:broader":"https://homosaurus.org/v3/homoit0001322","skos:related":["https://homosaurus.org/v3/homoit0000437","https://homosaurus.org/v3/homoit0000753","https://homosaurus.org/v3/homoit0002290"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85047741"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womensMovement"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000439","dc:identifier":"homoit0000439","skos:prefLabel":"Feminists","rdfs:comment":"People who support and advocate for defining, establishing, and defending equal political, economic, and social rights and opportunities for women. ","skos:narrower":["https://homosaurus.org/v3/homoit0001346","https://homosaurus.org/v3/homoit0003169","https://homosaurus.org/v3/homoit0003170","https://homosaurus.org/v3/homoit0003171","https://homosaurus.org/v3/homoit0003172","https://homosaurus.org/v3/homoit0003173","https://homosaurus.org/v3/homoit0003174","https://homosaurus.org/v3/homoit0003175","https://homosaurus.org/v3/homoit0003177"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85047761"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000439"},"dc:replaces":{"@id":"http://homosaurus.org/v2/feminists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000440","dc:identifier":"homoit0000440","skos:prefLabel":"Femmes","rdfs:comment":"Feminine people of any gender, though this term is commonly used in lesbian communities.","skos:broader":["https://homosaurus.org/v3/homoit0000577","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001304"],"skos:related":["https://homosaurus.org/v3/homoit0000230","https://homosaurus.org/v3/homoit0000231","https://homosaurus.org/v3/homoit0000384","https://homosaurus.org/v3/homoit0000389","https://homosaurus.org/v3/homoit0000568","https://homosaurus.org/v3/homoit0000971","https://homosaurus.org/v3/homoit0001327","https://homosaurus.org/v3/homoit0001340","https://homosaurus.org/v3/homoit0002043"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001241"},"dc:replaces":{"@id":"http://homosaurus.org/v2/femmes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000441","dc:identifier":"homoit0000441","skos:prefLabel":"Femminiello","rdfs:comment":"In Italy, this is a Neapolitan term for homosexual men with feminine gender expression. Often considered a third gen