,{"@id":"https://homosaurus.org/v4/homoit0000103","dc:identifier":"homoit0000103","skos:prefLabel":"Kink community","rdfs:comment":"A broad term including all communities of people interested in kinks and fetishes, including or overlapping with certain subcultures such as the leather community and rubber and latex communities. ","skos:broader":"https://homosaurus.org/v3/homoit0000297","skos:related":["https://homosaurus.org/v3/homoit0000363","https://homosaurus.org/v3/homoit0000442","https://homosaurus.org/v3/homoit0000705","https://homosaurus.org/v3/homoit0001353","https://homosaurus.org/v3/homoit0001376","https://homosaurus.org/v3/homoit0003084"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/BDSMCommunity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000297","dc:identifier":"homoit0000297","skos:prefLabel":"LGBTQ+ communities","skos:altLabel":"Communities (LGBTQ)","rdfs:comment":"Groups of LGBTQ+ people who share interests or interact regularly, typically living in some proximity.","skos:narrower":["https://homosaurus.org/v3/homoit0000103","https://homosaurus.org/v3/homoit0000143","https://homosaurus.org/v3/homoit0000370","https://homosaurus.org/v3/homoit0000485","https://homosaurus.org/v3/homoit0000705","https://homosaurus.org/v3/homoit0000733","https://homosaurus.org/v3/homoit0000842","https://homosaurus.org/v3/homoit0001170","https://homosaurus.org/v3/homoit0001247","https://homosaurus.org/v3/homoit0001403","https://homosaurus.org/v3/homoit0001878","https://homosaurus.org/v3/homoit0002773","https://homosaurus.org/v3/homoit0002931","https://homosaurus.org/v3/homoit0003032","https://homosaurus.org/v3/homoit0003698"],"skos:related":["https://homosaurus.org/v3/homoit0000298","htt