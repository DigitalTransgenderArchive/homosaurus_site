alue":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001616","dc:identifier":"homoit0001616","skos:prefLabel":"Gay biographies","rdfs:comment":"Written accounts of the lives of gay men. For written accounts of gay men's lives written by the subject, use \"Gay autobiographies.\"","skos:broader":"https://homosaurus.org/v3/homoit0001614","skos:related":"https://homosaurus.org/v3/homoit0001731","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008117807"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001614"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayBiographies"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001617","dc:identifier":"homoit0001617","skos:prefLabel":"Bisexual biographies","rdfs:comment":"Written accounts of the lives of bisexual people. For written accounts of bisexual people's lives written by the subject, use \"Bisexual autobiographies.\"","skos:broader":"https://homosaurus.org/v3/homoit0001614","skos:related":["https://homosaurus.org/v3/homoit0001732","https://homosaurus.org/v3/homoit0001726"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001614"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualBiographies"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001618","dc:identifier":"homoit0001618","skos:prefLabel":"Transgender biographies","skos:altLabel":"Trans biographies","rdfs:comment":"Written accounts of the lives of trans people. For written accounts of trans people's lives written by the subject, use \"Transgender autobiographies.\"","skos:broader":"https://homosaurus.org/v3/homoit0001614","skos:related":["https://homosaurus.org/v3/homoit0001733","https://homosaurus.org/v3/homoit0001727"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001614"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderBiographies"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001619","dc:identifier":"homoit0001619","skos:prefLabel":"Queer biographies","rdfs:comment":"Written accounts of the lives of queer people. For written accounts of queer people's lives written by the subject, use \"Queer autobiographies.\"","skos:broader":"https://homosaurus.org/v3/homoit0001614","skos:related":["https://homosaurus.org/v3/homoit0001734","https://homosaurus.org/v3/homoit0001728"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001614"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerBiographies"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001620","dc:identifier":"homoit0001620","skos:prefLabel":"Breast augmentation","skos:altLabel":["Augmentation mammaplasty","Augmentation mammoplasty","Boob job"],"rdfs:comment":"A surgical procedure aimed at increasing breast size using a prosthetic implant; often undergone by transgender women as a gender affirming surgery.","skos:broader":"https://homosaurus.org/v3/homoit0001840","skos:related":"https://homosaurus.org/v3/homoit0000222","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh90001764"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/breastAugmentation"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001621","dc:identifier":"homoit0001621","skos:prefLabel":"Breast fetish","skos:altLabel":["Mazophilia","Breast partialism","Mastofact","Breast fetishism","Breast kink"],"rdfs:comment":"Eroticization of the breasts. ","skos:broader":"https://homosaurus.org/v3/homoit0001634","skos:related":["https://homosaurus.org/v3/homoit0000222","https://homosaurus.org/v3/homoit0001046","https://homosaurus.org/v3/homoit0003118","https://homosaurus.org/v3/homoit0003130","https://homosaurus.org/v3/homoit0003132"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/breastFetishism"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001622","dc:identifier":"homoit0001622","skos:prefLabel":"Breast reduction","skos:altLabel":["Reduction mammaplasty","Reduction mammoplasty"],"rdfs:comment":"A surgical procedure to decrease breast size. Often undertaken by transgender men or non-binary people as a gender affirming surgery.","skos:related":["https://homosaurus.org/v3/homoit0000222","https://homosaurus.org/v3/homoit0001631"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh90001763"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001622"},"dc:replaces":{"@id":"http://homosaurus.org/v2/breastReduction"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001623","dc:identifier":"homoit0001623","skos:prefLabel":"Breast size","rdfs:comment":"The dimensions of an individual's breast tissue; can be used as an approximation (e.g., large breasts, small breasts) or to reference to standards of measurement for bras and other support garments.","skos:narrower":["https://homosaurus.org/v3/homoit0001630","https://homosaurus.org/v3/homoit0001639"],"skos:related":"https://homosaurus.org/v3/homoit0000222","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001623"},"dc:replaces":{"@id":"http://homosaurus.org/v2/breastSize"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001625","dc:identifier":"homoit0001625","skos:prefLabel":"DADT relationships","rdfs:comment":"Abbreviation for \"don’t ask don’t tell relationships,\" where partners agree that they have each have multiple romantic and/or sexual relationships as long as they do not discuss it with their primary partner or let it interfere with their partner’s daily life.","skos:broader":"https://homosaurus.org/v3/homoit0001651","skos:related":"https://homosaurus.org/v3/homoit0001629","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/DADTRelationships"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001626","dc:identifier":"homoit0001626","skos:prefLabel":"Greysexuality","skos:altLabel":["Graysexuality","Grey-sexuality","Gray-sexuality"],"rdfs:comment":"A sexual orientation generally characterized by infrequent, rare, or low-intensity sexual attraction.","skos:broader":"https://homosaurus.org/v3/homoit0001298","skos:related":["https://homosaurus.org/v3/homoit0001627","https://homosaurus.org/v3/homoit0001988"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/greysexuality"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001627","dc:identifier":"homoit0001627","skos:prefLabel":"Greysexual people","skos:altLabel":["Graysexual people","Grey-sexual people","Gray-sexual people"],"rdfs:comment":"People who experience infrequent, rare, or low-intensity sexual attraction.","skos:broader":"https://homosaurus.org/v3/homoit0001297","skos:related":["https://homosaurus.org/v3/homoit0001626","https://homosaurus.org/v3/homoit0001987"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/greysexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001628","dc:identifier":"homoit0001628","skos:prefLabel":"Hard swap","rdfs:comment":"A term used in the swinging community to describe a type of partner swapping in which sexual activities happen in different spaces or rooms where partners may not necessarily be in sight of each other.","skos:broader":"https://homosaurus.org/v3/homoit0001299","skos:related":"https://homosaurus.org/v3/homoit0001640","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001299"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hardSwap"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001629","dc:identifier":"homoit0001629","skos:prefLabel":"Hierarchical non-monogamy","skos:altLabel":["Hierarchical polyamory","Hierarchical nonmonogamy"],"rdfs:comment":"A form of consensual non-monogamy in which a person has multiple partners who are not \"equal\" to one another in terms of time, emotional intensity, financial, or scheduling matters.","skos:broader":["https://homosaurus.org/v3/homoit0001123","https://homosaurus.org/v3/homoit0001659"],"skos:narrower":["https://homosaurus.org/v3/homoit0001641","https://homosaurus.org/v3/homoit0001656"],"skos:related":["https://homosaurus.org/v3/homoit0001625","https://homosaurus.org/v3/homoit0001635","https://homosaurus.org/v3/homoit0001638","https://homosaurus.org/v3/homoit0001645","https://homosaurus.org/v3/homoit0001657","https://homosaurus.org/v3/homoit0001664","https://homosaurus.org/v3/homoit0002255"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hierarchicalNonmonogamy"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001630","dc:identifier":"homoit0001630","skos:prefLabel":"Large breasts","skos:altLabel":["Gigantomastia","Macromastia","Breast hypertrophy"],"rdfs:comment":"Breasts considered large within a given cultural context. Note that large breasts have various health issues associated with them and may carry stigmatized medical associations (such as terms like gigantomastia and macromastia). These terms have more specific medical meanings but should not be used outside of those specific contexts.","skos:broader":"https://homosaurus.org/v3/homoit0001623","skos:related":"https://homosaurus.org/v3/homoit0000222","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001623"},"dc:replaces":{"@id":"http://homosaurus.org/v2/largeBreasts"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001631","dc:identifier":"homoit0001631","skos:prefLabel":"Mastectomy","skos:altLabel":"Breast amputation","rdfs:comment":"A surgical procedure aimed at removing the breast or as much breast tissue as possible; often undergone as part of \"top surgery\" for transgender men or nonbinary people.","skos:broader":"https://homosaurus.org/v3/homoit0001840","skos:related":["https://homosaurus.org/v3/homoit0000222","https://homosaurus.org/v3/homoit0001622","https://homosaurus.org/v3/homoit0001841"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081984"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mastectomy"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001632","dc:identifier":"homoit0001632","skos:prefLabel":"Megasexuality","rdfs:comment":"A sexual orientation generally characterized by a person's lack of emotional connection to other people unless or until they have formed a strong sexual connection with them first.","skos:broader":["https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001298"],"skos:related":["https://homosaurus.org/v3/homoit0001302","https://homosaurus.org/v3/homoit0001633"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/megasexuality"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001633","dc:identifier":"homoit0001633","skos:prefLabel":"Megasexual people","rdfs:comment":"People who do not experience strong emotional connections to other people unless they form strong sexual connections with them first.","skos:broader":"https://homosaurus.org/v3/homoit0001297","skos:narrower":"https://homosaurus.org/v3/homoit0003042","skos:related":["https://homosaurus.org/v3/homoit0000071","https://homosaurus.org/v3/homoit0001302","https://homosaurus.org/v3/homoit0001632"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/megasexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001634","dc:identifier":"homoit0001634","skos:prefLabel":"Body part fetishes","skos:altLabel":["Body part fetish","Body part fetishism","Partialism","Partialisms"],"rdfs:comment":"Any of various fetishes regarding a specific part of the body.","skos:broader":"https://homosaurus.org/v3/homoit0000442","skos:narrower":["https://homosaurus.org/v3/homoit0001621","https://homosaurus.org/v3/homoit0003051","https://homosaurus.org/v3/homoit0003064"],"skos:related":"https://homosaurus.org/v3/homoit0000401","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partialism"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001635","dc:identifier":"homoit0001635","skos:prefLabel":"Primary partners","rdfs:comment":"A term used in hierarchical polyamory to refer to the partner whose interests and desires come before those of any secondary partner(s).","skos:broader":"https://homosaurus.org/v3/homoit0002365","skos:related":["https://homosaurus.org/v3/homoit0001629","https://homosaurus.org/v3/homoit0001638"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/primaryPartners"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001638","dc:identifier":"homoit0001638","skos:prefLabel":"Secondary partners","rdfs:comment":"A term used in hierarchical polyamory to refer to partners whose interests and desires come second to those of the primary partner(s).","skos:broader":"https://homosaurus.org/v3/homoit0002365","skos:related":["https://homosaurus.org/v3/homoit0001554","https://homosaurus.org/v3/homoit0001629","https://homosaurus.org/v3/homoit0001635","https://homosaurus.org/v3/homoit0001662"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/secondaryPartners"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001639","dc:identifier":"homoit0001639","skos:prefLabel":"Small breasts","skos:altLabel":["Breast hypoplasia","Underdeveloped breasts"],"rdfs:comment":"Breasts considered small within a given cultural context. In certain situations, medical professionals may refer to such breasts as \"underdeveloped\" or \"hypoplastic.\" These terms can be considered offensive and should not be used outside of specific medical contexts. The alternate labels included here are intended to aid search tools only and should not be used in other contexts.","skos:broader":"https://homosaurus.org/v3/homoit0001623","skos:related":"https://homosaurus.org/v3/homoit0000222","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001623"},"dc:replaces":{"@id":"http://homosaurus.org/v2/smallBreasts"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001640","dc:identifier":"homoit0001640","skos:prefLabel":"Soft swap","rdfs:comment":"A term used in the swinging community to describe a type of partner swap in which sexual activities happen in the same shared space so that all partners are within sight of one another.","skos:broader":"https://homosaurus.org/v3/homoit0001299","skos:related":"https://homosaurus.org/v3/homoit0001628","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001299"},"dc:replaces":{"@id":"http://homosaurus.org/v2/softSwap"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001641","dc:identifier":"homoit0001641","skos:prefLabel":"Swinging","skos:altLabel":["Wife swapping","Husband swapping","Partner swapping"],"rdfs:comment":"An agreement, sexual practice, or relationship in which a couple engages in group sex or the swapping of sexual partners within a group, often on a habitual basis.","skos:broader":["https://homosaurus.org/v3/homoit0001629","https://homosaurus.org/v3/homoit0001651"],"skos:related":["https://homosaurus.org/v3/homoit0001299","https://homosaurus.org/v3/homoit0001656"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/swinging"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001642","dc:identifier":"homoit0001642","skos:prefLabel":"Trans women","skos:altLabel":["Transgender women","Transwomen","Trans-women"],"rdfs:comment":"Women whose gender assigned at birth was not female. Do not use for intersex people unless the intersex person identifies as a trans woman.","skos:broader":["https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001509"],"skos:narrower":"https://homosaurus.org/v3/homoit0000986","skos:related":["https://homosaurus.org/v3/homoit0000079","https://homosaurus.org/v3/homoit0000407","https://homosaurus.org/v3/homoit0001821","https://homosaurus.org/v3/homoit0002043","https://homosaurus.org/v3/homoit0002274"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2018002623"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transWomen"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001643","dc:identifier":"homoit0001643","skos:prefLabel":"Trans men","skos:altLabel":["Transgender men","Transmen","Trans-men"],"rdfs:comment":"Men whose gender assigned at birth was not male. Do not use for intersex people unless the intersex person identifies as a trans man.","skos:broader":["https://homosaurus.org/v3/homoit0001008","https://homosaurus.org/v3/homoit0001378"],"skos:narrower":"https://homosaurus.org/v3/homoit0000436","skos:related":["https://homosaurus.org/v3/homoit0000077","https://homosaurus.org/v3/homoit0000114","https://homosaurus.org/v3/homoit0001362","https://homosaurus.org/v3/homoit0001820","https://homosaurus.org/v3/homoit0002061"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2018002395"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transMen"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001644","dc:identifier":"homoit0001644","skos:prefLabel":"Aromanticism","skos:altLabel":"Aromantic","rdfs:comment":"A romantic orientation generally characterized by a lack of romantic attraction or desire.","skos:broader":"https://homosaurus.org/v3/homoit0001828","skos:related":["https://homosaurus.org/v3/homoit0000004","https://homosaurus.org/v3/homoit0000067","https://homosaurus.org/v3/homoit0001791"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001828"},"dc:replaces":{"@id":"http://homosaurus.org/v2/aromanticism"},"dc:issued":{"@type":"xsd:date","@value":"2021-03-04"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001828","dc:identifier":"homoit0001828","skos:prefLabel":"Romantic orientation","rdfs:comment":"The direction or nature of an individual's romantic attraction toward others.","skos:narrower":["https://homosaurus.org/v3/homoit0001644","https://homosaurus.org/v3/homoit0001791","https://homosaurus.org/v3/homoit0001792","https://homosaurus.org/v3/homoit0001793","https://homosaurus.org/v3/homoit0001794","https://homosaurus.org/v3/homoit0001795","https://homosaurus.org/v3/homoit0001986","https://homosaurus.org/v3/homoit0001988"],"skos:related":["https://homosaurus.org/v3/homoit0001298","https://homosaurus.org/v3/homoit0001636","https://homosaurus.org/v3/homoit0001829"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001828"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001645","dc:identifier":"homoit0001645","skos:prefLabel":"Anchor partners","rdfs:comment":"A term used in non-monogamous communities to refer to a long-term partner with multiple commitments. Often used in place of language that is seen as hierarchical (e.g., primary/secondary partner).","skos:broader":["https://homosaurus.org/v3/homoit0001660","https://homosaurus.org/v3/homoit0002365"],"skos:related":["https://homosaurus.org/v3/homoit0001123","https://homosaurus.org/v3/homoit0001629","https://homosaurus.org/v3/homoit0001657","https://homosaurus.org/v3/homoit0001663"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001637"},"dc:replaces":{"@id":"http://homosaurus.org/v2/anchorPartners"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001646","dc:identifier":"homoit0001646","skos:prefLabel":"Assigned X at birth","skos:altLabel":["AXAB","Designated X at birth","DXAB","X assigned at birth","XAAB"],"rdfs:comment":"The assignment of an \"X\" gender marker or \"X\" sex designation shortly after birth. It is uncommon for intersex people to be assigned intersex or X at birth.\r\n","skos:broader":"https://homosaurus.org/v3/homoit0001268","skos:related":["https://homosaurus.org/v3/homoit0000669","https://homosaurus.org/v3/homoit0001646","https://homosaurus.org/v3/homoit0002884"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/assignedXAtBirth"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001647","dc:identifier":"homoit0001647","skos:prefLabel":"Cheating","skos:altLabel":["Straying","Adultery","Infidelity","Affairs","Stepping out"],"rdfs:comment":"A violation of a couple's assumed or stated contract regarding emotional and/or sexual exclusivity. Should not be used to refer to non-monogamy in general, as cheating is possible in both monogamous and non-monogamous relationships.","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85001045"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001647"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001658"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cheating"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2022-10-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001648","dc:identifier":"homoit0001648","skos:prefLabel":"Assigned sex","rdfs:comment":"An individual's sex as determined by a medical practitioner or provider. Determination is usually based on the appearance of external genitalia but may use other methodologies. In practice, sex assigned at birth is often culturally variable; the term \"assigned gender\" is often more applicable or accurate.\r\n","skos:broader":"https://homosaurus.org/v3/homoit0001269","skos:narrower":"https://homosaurus.org/v3/homoit0001268","skos:related":["https://homosaurus.org/v3/homoit0000078","https://homosaurus.org/v3/homoit0000266","https://homosaurus.org/v3/homoit0001896","https://homosaurus.org/v3/homoit0001897"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/assignedSex"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001649","dc:identifier":"homoit0001649","skos:prefLabel":"Compersion","rdfs:comment":"The positive emotion an individual may experience in regards to their partner's relationship with another partner. Often defined as the opposite of jealousy.","skos:related":["https://homosaurus.org/v3/homoit0001123","https://homosaurus.org/v3/homoit0001651"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001649"},"dc:replaces":{"@id":"http://homosaurus.org/v2/compersion"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001650","dc:identifier":"homoit0001650","skos:prefLabel":"Compulsory monogamy","rdfs:comment":"The assumption that all people share a desire for monogamous relationships and that this is a preferential life goal.","skos:related":["https://homosaurus.org/v3/homoit0001532","https://homosaurus.org/v3/homoit0001535","https://homosaurus.org/v3/homoit0001636","https://homosaurus.org/v3/homoit0001916"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001650"},"dc:replaces":{"@id":"http://homosaurus.org/v2/compulsoryMonogamy"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001651","dc:identifier":"homoit0001651","skos:prefLabel":"Consensual non-monogamy","skos:altLabel":"Ethical Non-monogamy","rdfs:comment":"Practice of romantic or sexual relationships with more than one person simultaneously and with all the consent of all partners involved.","skos:broader":"https://homosaurus.org/v3/homoit0001659","skos:narrower":["https://homosaurus.org/v3/homoit0001123","https://homosaurus.org/v3/homoit0001625","https://homosaurus.org/v3/homoit0001641","https://homosaurus.org/v3/homoit0001665","https://homosaurus.org/v3/homoit0001666","https://homosaurus.org/v3/homoit0003278"],"skos:related":["https://homosaurus.org/v3/homoit0001554","https://homosaurus.org/v3/homoit0001649","https://homosaurus.org/v3/homoit0001662"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/consensualNonMonogamy"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001652","dc:identifier":"homoit0001652","skos:prefLabel":"Demigirls","skos:altLabel":["Demiwomen","Demiwoman","Demigirl","Demilady","Demiladies","Demifemale people"],"rdfs:comment":"People who partially, but not fully, identify women or girls irrespective of their assigned genders. Used by cisgender, transgender, transfeminine, or nonbinary people who feel more strongly aligned with women physically or socially, but not strongly enough to identify solely as one.","skos:broader":"https://homosaurus.org/v3/homoit0000342","skos:related":["https://homosaurus.org/v3/homoit0000271","https://homosaurus.org/v3/homoit0001048","https://homosaurus.org/v3/homoit0001382","https://homosaurus.org/v3/homoit0001653","https://homosaurus.org/v3/homoit0001821","https://homosaurus.org/v3/homoit0001923","https://homosaurus.org/v3/homoit0002043"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/demigirls"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001653","dc:identifier":"homoit0001653","skos:prefLabel":"Demiboys","skos:altLabel":["Demiguy","Demiguys","Demimen","Demimales","Demimale people","Demiboy"],"rdfs:comment":"People who partially, but not fully, identify as men or boys irrespective of their assigned genders. Used by cisgender, transgender, transmasculine, or nonbinary people who feel more aligned with men physically or socially, but not strongly enough to identify solely as one.","skos:broader":"https://homosaurus.org/v3/homoit0000342","skos:related":["https://homosaurus.org/v3/homoit0000271","https://homosaurus.org/v3/homoit0001048","https://homosaurus.org/v3/homoit0001466","https://homosaurus.org/v3/homoit0001652","https://homosaurus.org/v3/homoit0001820","https://homosaurus.org/v3/homoit0001923","https://homosaurus.org/v3/homoit0002061"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/demiboys"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001654","dc:identifier":"homoit0001654","skos:prefLabel":"Gym subculture","rdfs:comment":"Gay subculture popularized in the 1970s via homoerotic bodybuilder magazines. Often includes aesthetics modeled after ancient Greek gymnasiums. Especially popular in San Francisco, West Hollywood, and New York City.","skos:broader":"https://homosaurus.org/v3/homoit0001345","skos:related":["https://homosaurus.org/v3/homoit0000487","https://homosaurus.org/v3/homoit0002148","https://homosaurus.org/v3/homoit0002149","https://homosaurus.org/v3/homoit0003051","https://homosaurus.org/v3/homoit0003072"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gymSubculture"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001655","dc:identifier":"homoit0001655","skos:prefLabel":"Honeymooning","rdfs:comment":"A period of time in a relationship characterized by passionate love as well as intense feelings of attraction and ecstasy, sometimes accompanied by idealization of a partner or the shared relationship.","skos:related":"https://homosaurus.org/v3/homoit0001661","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001655"},"dc:replaces":{"@id":"http://homosaurus.org/v2/honeymooning"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001656","dc:identifier":"homoit0001656","skos:prefLabel":"Monogamish","rdfs:comment":"Term used to describe relationships that are mostly monogamous with occasional exceptions made for sexual play.","skos:broader":"https://homosaurus.org/v3/homoit0001629","skos:related":["https://homosaurus.org/v3/homoit0001641","https://homosaurus.org/v3/homoit0001916"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/monogamish"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001657","dc:identifier":"homoit0001657","skos:prefLabel":"Nesting partners","rdfs:comment":"A term used in non-monogamous communities to refer to partners an individual lives with. Often used in place of language that is seen as hierarchical (e.g., primary partner, secondary partner).","skos:broader":["https://homosaurus.org/v3/homoit0001660","https://homosaurus.org/v3/homoit0002365"],"skos:related":["https://homosaurus.org/v3/homoit0001123","https://homosaurus.org/v3/homoit0001629","https://homosaurus.org/v3/homoit0001645","https://homosaurus.org/v3/homoit0001663"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001637"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nestingPartners"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001658","dc:identifier":"homoit0001658","skos:prefLabel":"Non-consensual non-monogamy","rdfs:comment":"Practice of engaging in romantic or sexual relationships with more than one person simultaneously without each partner's consent.","skos:broader":"https://homosaurus.org/v3/homoit0001659","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nonConsensualNonMonogamy"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001659","dc:identifier":"homoit0001659","skos:prefLabel":"Non-monogamy","skos:altLabel":["Nonmono","Nonmonogamy"],"rdfs:comment":"Practice of engaging in romantic or sexual relationships with more than one person simultaneously. ","skos:broader":"https://homosaurus.org/v3/homoit0001636","skos:narrower":["https://homosaurus.org/v3/homoit0001629","https://homosaurus.org/v3/homoit0001651","https://homosaurus.org/v3/homoit0001658"],"skos:related":"https://homosaurus.org/v3/homoit0002255","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh00003586"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nonMonogamy"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001660","dc:identifier":"homoit0001660","skos:prefLabel":"Non-monogamous people","rdfs:comment":"People who practice romantic or sexual relationships with more than one person simultaneously.","skos:broader":"https://homosaurus.org/v3/homoit0001637","skos:narrower":["https://homosaurus.org/v3/homoit0001554","https://homosaurus.org/v3/homoit0001645","https://homosaurus.org/v3/homoit0001657","https://homosaurus.org/v3/homoit0001662","https://homosaurus.org/v3/homoit0001663","https://homosaurus.org/v3/homoit0001665"],"skos:related":"https://homosaurus.org/v3/homoit0003229","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001637"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nonMonogamousPeople"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001661","dc:identifier":"homoit0001661","skos:prefLabel":"NRE (New Relationship Energy)","rdfs:comment":"A strong, almost giddy feeling of excitement and infatuation common in the beginning of a new romantic relationship. Often used in polyamory contexts.","skos:related":["https://homosaurus.org/v3/homoit0001123","https://homosaurus.org/v3/homoit0001655","https://homosaurus.org/v3/homoit0001663"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001661"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nre"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001662","dc:identifier":"homoit0001662","skos:prefLabel":"Paramours","rdfs:comment":"In polyamory contexts, paramours are the partners of an individual's partner, typically as part of a relationship the primary partner is unaware of. In other contexts, this term is used broadly as a synonym for lovers.","skos:broader":["https://homosaurus.org/v3/homoit0001123","https://homosaurus.org/v3/homoit0001660"],"skos:related":["https://homosaurus.org/v3/homoit0001554","https://homosaurus.org/v3/homoit0001638","https://homosaurus.org/v3/homoit0001651"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006001642"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/paramours"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001663","dc:identifier":"homoit0001663","skos:prefLabel":"Polyamorous people","rdfs:comment":"People who engage in romantic, sexual, or play relationships with more than one person simultaneously, with the knowledge and consent of all parties involved.","skos:broader":["https://homosaurus.org/v3/homoit0001637","https://homosaurus.org/v3/homoit0001660"],"skos:related":["https://homosaurus.org/v3/homoit0001123","https://homosaurus.org/v3/homoit0001645","https://homosaurus.org/v3/homoit0001657","https://homosaurus.org/v3/homoit0001661","https://homosaurus.org/v3/homoit0003229"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001637"},"dc:replaces":{"@id":"http://homosaurus.org/v2/polyamorousPeople"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001664","dc:identifier":"homoit0001664","skos:prefLabel":"Polyfidelity","rdfs:comment":"In polyamory circles, this term refers to the practice of engaging in multiple-partner relationships that are \"closed off\" to new participants per the agreement of those involved.","skos:related":["https://homosaurus.org/v3/homoit0001123","https://homosaurus.org/v3/homoit0001629"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001664"},"dc:replaces":{"@id":"http://homosaurus.org/v2/polyfidelity"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001665","dc:identifier":"homoit0001665","skos:prefLabel":"Relationship anarchists","rdfs:comment":"People who practice a type of non-monogamy characterized by application of anarchist principles (such as autonomy, anti-normativity, anti-hierarchical practices, refusal of state governance) to relationships. Often contrasted with hierarchical polyamory.","skos:broader":["https://homosaurus.org/v3/homoit0001637","https://homosaurus.org/v3/homoit0001651","https://homosaurus.org/v3/homoit0001660"],"skos:related":"https://homosaurus.org/v3/homoit0001666","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001637"},"dc:replaces":{"@id":"http://homosaurus.org/v2/relationshipAnarchists"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001666","dc:identifier":"homoit0001666","skos:prefLabel":"Relationship anarchy","rdfs:comment":"A type of non-monogamy characterized by application of anarchist principles (such as autonomy, anti-normativity, anti-hierarchical practices, refusal of state governance) to relationships. Often contrasted with hierarchical polyamory.","skos:broader":"https://homosaurus.org/v3/homoit0001651","skos:related":"https://homosaurus.org/v3/homoit0001665","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/relationshipAnarchy"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001667","dc:identifier":"homoit0001667","skos:prefLabel":"Scissoring","rdfs:comment":"Typically, a sexual activity in which two women rub their genitalia against one \r\nanother while intertwining their legs.","skos:broader":["https://homosaurus.org/v3/homoit0000456","https://homosaurus.org/v3/homoit0001267"],"skos:related":"https://homosaurus.org/v3/homoit0001669","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/scissoring"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001668","dc:identifier":"homoit0001668","skos:prefLabel":"Transgenderqueer people","rdfs:comment":"Someone who is both trans and genderqueer and who identifies as transgenderqueer.\r\n","skos:broader":["https://homosaurus.org/v3/homoit0000582","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001817"],"skos:related":["https://homosaurus.org/v3/homoit0001918","https://homosaurus.org/v3/homoit0001921"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderqueerPeople"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001669","dc:identifier":"homoit0001669","skos:prefLabel":"Tribadism","skos:altLabel":"Tribbing","rdfs:comment":"A mostly antiquated term used either to refer to scissoring, to any sexual activity between women, or to the general concept of being a lesbian (\"lesbianism\").","skos:broader":["https://homosaurus.org/v3/homoit0000878","https://homosaurus.org/v3/homoit0001267"],"skos:related":["https://homosaurus.org/v3/homoit0000799","https://homosaurus.org/v3/homoit0001472","https://homosaurus.org/v3/homoit0001667"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tribadism"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001670","dc:identifier":"homoit0001670","skos:prefLabel":"Xenogender identity","rdfs:comment":"Non-binary gender identity that is not defined in relation to human understandings of gender (i.e., female or male, woman or man), but instead in relation to animals, plants, or other things","skos:broader":"https://homosaurus.org/v3/homoit0000571","skos:related":["https://homosaurus.org/v3/homoit0001048","https://homosaurus.org/v3/homoit0001671"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/xenogender"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001671","dc:identifier":"homoit0001671","skos:prefLabel":"Xenogender people","rdfs:comment":"A person who identifies their gender in relation to non-human understandings of gender and relates to animals, plants, or other things.","skos:related":["https://homosaurus.org/v3/homoit0000571","https://homosaurus.org/v3/homoit0001048","https://homosaurus.org/v3/homoit0001670"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001671"},"dc:replaces":{"@id":"http://homosaurus.org/v2/xenogenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001672","dc:identifier":"homoit0001672","skos:prefLabel":"Neopronouns","rdfs:comment":"Personal pronouns that are not officially (i.e., in dictionaries, style guides, etc.) recognized by the language that they are used in. Often intended to be gender neutral.","skos:narrower":["https://homosaurus.org/v3/homoit0001673","https://homosaurus.org/v3/homoit0001674","https://homosaurus.org/v3/homoit0001675","https://homosaurus.org/v3/homoit0001676","https://homosaurus.org/v3/homoit0001677","https://homosaurus.org/v3/homoit0001678","https://homosaurus.org/v3/homoit0001679","https://homosaurus.org/v3/homoit0001680","https://homosaurus.org/v3/homoit0001682","https://homosaurus.org/v3/homoit0001683","https://homosaurus.org/v3/homoit0001684","https://homosaurus.org/v3/homoit0001685","https://homosaurus.org/v3/homoit0001686","https://homosaurus.org/v3/homoit0001687","https://homosaurus.org/v3/homoit0001688","https://homosaurus.org/v3/homoit0001689","https://homosaurus.org/v3/homoit0001690","https://homosaurus.org/v3/homoit0001691","https://homosaurus.org/v3/homoit0001693","https://homosaurus.org/v3/homoit0001694","https://homosaurus.org/v3/homoit0001697","https://homosaurus.org/v3/homoit0001698","https://homosaurus.org/v3/homoit0001699","https://homosaurus.org/v3/homoit0001700","https://homosaurus.org/v3/homoit0001701","https://homosaurus.org/v3/homoit0001702","https://homosaurus.org/v3/homoit0001703","https://homosaurus.org/v3/homoit0001704","https://homosaurus.org/v3/homoit0001705","https://homosaurus.org/v3/homoit0001706","https://homosaurus.org/v3/homoit0001707","https://homosaurus.org/v3/homoit0001708","https://homosaurus.org/v3/homoit0001709","https://homosaurus.org/v3/homoit0001710","https://homosaurus.org/v3/homoit0001711","https://homosaurus.org/v3/homoit0001712","https://homosaurus.org/v3/homoit0001713","https://homosaurus.org/v3/homoit0001714","https://homosaurus.org/v3/homoit0001715","https://homosaurus.org/v3/homoit0001716"],"skos:related":"https://homosaurus.org/v3/homoit0001135","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001672"},"dc:replaces":{"@id":"http://homosaurus.org/v2/neopronouns"},"dc:issued":{"@type":"xsd:date","@value":"2021-07-01"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001673","dc:identifier":"homoit0001673","skos:prefLabel":"Ae/Aer/Aerself (Pronouns)","skos:altLabel":["Ae (Pronouns)","Ae/Aer/Aerself"],"rdfs:comment":"A set of pronouns. Used in th