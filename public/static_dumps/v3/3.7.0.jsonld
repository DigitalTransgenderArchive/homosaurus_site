 or clubs where people dance to recorded music; use in reference to discos that primarily cater to gay men.","skos:broader":"https://homosaurus.org/v3/homoit0000909","skos:related":"https://homosaurus.org/v3/homoit0000100","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005020372"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000909"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayDiscos"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000909","dc:identifier":"homoit0000909","skos:prefLabel":"LGBTQ+ night life","skos:altLabel":"LGBTQ night life","rdfs:comment":"Nighttime social activities and entertainment catering to LGBTQ+ people, often located at bars and clubs.","skos:narrower":["https://homosaurus.org/v3/homoit0000475","https://homosaurus.org/v3/homoit0000488"],"skos:related":["https://homosaurus.org/v3/homoit0000100","https://homosaurus.org/v3/homoit0000892","https://homosaurus.org/v3/homoit0000900","https://homosaurus.org/v3/homoit0000930","https://homosaurus.org/v3/homoit0002385"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000909"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQNightLife"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000489","dc:identifier":"homoit0000489","skos:prefLabel":"Gay drama","rdfs:comment":"Works of fiction written to be performed; use in reference to dramatic works focusing on gay characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000376","skos:related":"https://homosaurus.org/v3/homoit0001725","skos:closeMatch":{"@id":"h