aurus.org/v3/homoit0001284","https://homosaurus.org/v3/homoit0001288"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000610"},"dc:replaces":{"@id":"http://homosaurus.org/v2/happyEndings"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000611","dc:identifier":"homoit0000611","skos:prefLabel":"Harassment","rdfs:comment":"Covers a wide range of behaviors that are intended to disturb or upset. Harassment is often repetitive or occurs across an extended period of time.","skos:narrower":["https://homosaurus.org/v3/homoit0001121","https://homosaurus.org/v3/homoit0001293"],"skos:related":["https://homosaurus.org/v3/homoit0000228","https://homosaurus.org/v3/homoit0000356","https://homosaurus.org/v3/homoit0001560"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97007082"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000611"},"dc:replaces":{"@id":"http://homosaurus.org/v2/harassment"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000612","dc:identifier":"homoit0000612","skos:prefLabel":"Harnesses","rdfs:comment":"Wearable accessories, typically consisting of leather straps and metal rings or points of attachment. May be worn as a fashion statement, to signal one's belonging to the leather or BDSM communities, or during sex to restrict movement, increase pleasure, and/or to permit the attachment of a sex accessory, such as a dildo.","skos:broader":["https://homosaurus.org/v3/homoit0001266","https://homosaurus.org/v3/homoit0003059"],"skos:narrower":["https://homosaurus.org/v3/homoit0000252","https://ho