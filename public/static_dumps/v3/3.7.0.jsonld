{"@type":"xsd:date","@value":"2022-11-15"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002329","dc:identifier":"homoit0002329","skos:prefLabel":"Lesbian films","skos:altLabel":"Lesbian movies","rdfs:comment":"Motion pictures, or movies, created by lesbian directors, depicting lesbians, or that are regarded as important within lesbian culture.","skos:broader":["https://homosaurus.org/v3/homoit0000869","https://homosaurus.org/v3/homoit0002328"],"skos:narrower":"https://homosaurus.org/v3/homoit0000765","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88001611"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-15"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002330","dc:identifier":"homoit0002330","skos:prefLabel":"Gay cinema","skos:altLabel":"Gay film","rdfs:comment":"Term that encompasses gay filmmaking, the gay film industry, and film as an art form within gay culture. For specific movies created by or representing gay men, use the term \"Gay films.\"","skos:broader":"https://homosaurus.org/v3/homoit0002327","skos:narrower":"https://homosaurus.org/v3/homoit0002331","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-15"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002331","dc:identifier":"homoit0002331","skos:prefLabel":"Gay films","skos:altLabel":"Gay movies","rdfs:comment":"Motion pictures, or movies, created by gay directors, depicting gay men, or that are regarded as important within gay culture.","skos:broader":["https://homosaurus.org/v3/homoit0000869","https://homosaurus.org/v3/homoit0002330"],"skos:narrower":"https://homosaurus.org/v3/homoit0000520","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005008640"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-15"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002332","dc:identifier":"homoit0002332","skos:prefLabel":"Two-Spirit history","skos:altLabel":["2S history","Two Spirit history","Two Spirited history","Two-Spirited history"],"rdfs:comment":"Past events or accounts of the past concerning Two-Spirit people, or people who might be perceived as Two-Spirit if they were alive today.","skos:broader":"https://homosaurus.org/v3/homoit0002260","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002260"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-15"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002333","dc:identifier":"homoit0002333","skos:prefLabel":"LGBTQ+ people of the African diaspora","rdfs:comment":"LGBTQ+ people of native African ancestry living outside of the continent of Africa. While this term is commonly used to describe descendants of Africans who were enslaved and forcibly transported to the Americas via the transatlantic slave trade between the 16th and 19th centuries, it can also be used to refer to descendants of Africans who voluntarily immigrated to other parts of the world. Do not conflate with Black LGBTQ+ people or African American LGBTQ+ people. Follow the individual's preference whenever possible.","skos:related":"https://homosaurus.org/v3/homoit0000015","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002333"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-15"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002334","dc:identifier":"homoit0002334","skos:prefLabel":"Black asexual people","skos:altLabel":["Asexual Black people","Black ace people"],"rdfs:comment":"Black people who are asexual. Use only for individuals who self-identity as Black. Follow the individual’s preference for African American or Black whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000208","skos:narrower":["https://homosaurus.org/v3/homoit0002893","https://homosaurus.org/v3/homoit0002894","https://homosaurus.org/v3/homoit0002896","https://homosaurus.org/v3/homoit0002898"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002335","dc:identifier":"homoit0002335","skos:prefLabel":"African American asexual people","skos:altLabel":["African American ace people","Asexual African American people","Asexual African Americans"],"rdfs:comment":"Asexual people of African descent born in the United States or asexual people born in African countries who live in or have a strong connection to the United States. Use for individuals who self-identity as African American. Follow the individual’s preference for African American or Black whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000015","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002336","dc:identifier":"homoit0002336","skos:prefLabel":"Adopted LGBTQ+ people","skos:altLabel":["Adopted people (LGBTQ)","LGBTQ+ adopted people"],"rdfs:comment":"LGBTQ+ people who were adopted, whether or not by LGBTQ+ parents.","skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002337","dc:identifier":"homoit0002337","skos:prefLabel":"LGBTQ+ fathers","skos:altLabel":["Dads (LGBTQ)","Fathers (LGBTQ)","LGBTQ+ dads"],"rdfs:comment":"LGBTQ+ people who are fathers.","skos:broader":["https://homosaurus.org/v3/homoit0000423","https://homosaurus.org/v3/homoit0001075"],"skos:narrower":["https://homosaurus.org/v3/homoit0001413","https://homosaurus.org/v3/homoit0002338","https://homosaurus.org/v3/homoit0002339","https://homosaurus.org/v3/homoit0002340","https://homosaurus.org/v3/homoit0002341","https://homosaurus.org/v3/homoit0002741","https://homosaurus.org/v3/homoit0002792"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002338","dc:identifier":"homoit0002338","skos:prefLabel":"Bisexual fathers","skos:altLabel":"Bisexual dads","rdfs:comment":"Bisexual people who are fathers.","skos:broader":"https://homosaurus.org/v3/homoit0002337","skos:has