us.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001426","dc:identifier":"homoit0001426","skos:prefLabel":"Native American transgender people","skos:altLabel":["American Indian transgender people","Transgender American Indians","Transgender Native Americans"],"rdfs:comment":"People who are part of the Native peoples of the continental United States and Canada (excluding Inuit people) and self-identity as transgender. Use more specific terms when available.","skos:broader":"https://homosaurus.org/v3/homoit0001037","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderNativeAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001427","dc:identifier":"homoit0001427","skos:prefLabel":"Transgender newsletters","rdfs:comment":"Serialized print or digital periodicals created by or for transgender people, often with the purpose of sharing news and information related to transgender communities and transgender issues.","skos:broader":["https://homosaurus.org/v3/homoit0001041","https://homosaurus.org/v3/homoit0001436"],"skos:related":"https://homosaurus.org/v3/homoit0001428","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderNewsletters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001428","dc:identifier":"homoit0001428","skos:prefLabel":"Transgender newspapers","rdfs:comment":"Serialized print or digital publications about transgender people or transgender issues (and typically produced by transgender people or transgender organizations) that contain news, articles, columns, correspondence, and advertisements.","skos:broader":["https://homosaurus.org/v3/homoit0001042","https://homosaurus.org/v3/homoit0001436"],"skos:related":"https://homosaurus.org/v3/homoit0001427","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderNewspapers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001429","dc:identifier":"homoit0001429","skos:prefLabel":"Transgender Pagans","rdfs:comment":"Transgender people who are members of polytheistic religions or other religions outside of the dominant culture that typically incorporate nature worship and/or the sacred feminine, such as Wicca, Druidry, Heathenry, etc. Use to describe transgender people who self-identify as Pagan.","skos:broader":"https://homosaurus.org/v3/homoit0001069","skos:related":"https://homosaurus.org/v3/homoit0001911","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderPagans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001430","dc:identifier":"homoit0001430","skos:prefLabel":"Transgender parents","rdfs:comment":"Transgender people who are parents.","skos:broader":["https://homosaurus.org/v3/homoit0001075","https://homosaurus.org/v3/homoit0001378"],"skos:narrower":["https://homosaurus.org/v3/homoit0001413","https://homosaurus.org/v3/homoit0001422"],"skos:related":["https://homosaurus.org/v3/hom