date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000821","dc:identifier":"homoit0000821","skos:prefLabel":"LGBTQ+ birth parents","skos:altLabel":"LGBTQ birth parents","rdfs:comment":"In an adoption context, biological or genetic parents who are LGBTQ+ people.","skos:broader":["https://homosaurus.org/v3/homoit0000121","https://homosaurus.org/v3/homoit0000809","https://homosaurus.org/v3/homoit0001075"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQBirthParents"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000822","dc:identifier":"homoit0000822","skos:prefLabel":"LGBTQ+ blind people","skos:altLabel":["Blind people (LGBTQ)","Blind LGBTQ+ people"],"rdfs:comment":"LGBTQ+ people with significant or total loss of vision.","skos:broader":"https://homosaurus.org/v3/homoit0001854","skos:narrower":["https://homosaurus.org/v3/homoit0001872","https://homosaurus.org/v3/homoit0001873","https://homosaurus.org/v3/homoit0001874","https://homosaurus.org/v3/homoit0001875","https://homosaurus.org/v3/homoit0001876","https://homosaurus.org/v3/homoit0002783","https://homosaurus.org/v3/homoit0002932"],"skos:related":"https://homosaurus.org/v3/homoit0002683","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQBlindPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000823","dc:identifier":"homoit0000823","skos:prefLabel":"LGBTQ+ blogs","skos:altLabel":"LGBTQ blogs","rdfs:comment":"Websites featuring informal, often personal writing and reflections created by LGBTQ+ people or about LGBTQ+ communities and issues.","skos:broader":["https://homosaurus.org/v3/homoit0000210","https://homosaurus.org/v3/homoit0000946"],"skos:narrower":"https://homosaurus.org/v3/homoit0001983","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001321"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQBlogs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000824","dc:identifier":"homoit0000824","skos:prefLabel":"LGBTQ+ blood donors","skos:altLabel":"LGBTQ blood donors","rdfs:comment":"LGBTQ+ people who give blood for transfusion and medical purposes.","skos:broader":"https://homosaurus.org/v3/homoit0000364","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000364"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQBloodDonors"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000825","dc:identifier":"homoit0000825","skos:prefLabel":"LGBTQ+ book censorship","skos:altLabel":"LGBTQ book censorship","rdfs:comment":"The suppression or prohibition of written texts by LGBTQ+ authors and/or about LGBTQ+ issues due to religious, moral, political, and/or social objections.","skos:broader":"https://homosaurus.org/v3/homoit0000829","skos:related":["https://homosaurus.org/v3/homoit0000827","https://homosaurus.org/v3/homoit0000831","https://homosaurus.org/v3/homoit0003617"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000245"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQBookCensorship"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000826","dc:identifier":"homoit0000826","skos:prefLabel":"LGBTQ+ book clubs","skos:altLabel":"LGBTQ book clubs","rdfs:comment":"Groups of people gathering regularly to read and discuss written works; use in reference to book clubs with primarily LGBTQ+ membership or book clubs focused on books by LGBTQ+ authors or featuring LGBTQ+ characters and themes.","skos:broader":"https://homosaurus.org/v3/homoit0000836","skos:related":"https://homosaurus.org/v3/homoit0000827","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000836"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQBookClubs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000827","dc:identifier":"homoit0000827","skos:prefLabel":"LGBTQ+ books","skos:altLabel":"LGBTQ books","rdfs:comment":"Written works featuring LGBTQ+ characters or themes, or works intended to be read by LGBTQ+ people.","skos:narrower":"https://homosaurus.org/v3/homoit0000831","skos:related":["https://homosaurus.org/v3/homoit0000216","https://homosaurus.org/v3/homoit0000825","https://homosaurus.org/v3/homoit0000826","https://homosaurus.org/v3/homoit0000968","https://homosaurus.org/v3/homoit0000972","https://homosaurus.org/v3/homoit0001132","https://homosaurus.org/v3/homoit0001723","https://homosaurus.org/v3/homoit0001752","https://homosaurus.org/v3/homoit0001753","https://homosaurus.org/v3/homoit0001754"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000827"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQBooks"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000828","dc:identifier":"homoit0000828","skos:prefLabel":"LGBTQ+ cartoons","skos:altLabel":"LGBTQ cartoons","rdfs:comment":"Satirical drawings created by LGBTQ+ cartoonists or that depict someone or something relating to LGBTQ+ culture.","skos:broader":"https://homosaurus.org/v3/homoit0000841","skos:related":["https://homosaurus.org/v3/homoit0002144","https://homosaurus.org/v3/homoit0002172"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQCartoons"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000829","dc:identifier":"homoit0000829","skos:prefLabel":"LGBTQ+ censorship","skos:altLabel":"LGBTQ censorship","rdfs:comment":"Suppression or prohibition of the discussion, education, or circulation of information related to LGBTQ+ people and identities in media, schools, and/or in the general public. ","skos:broader":"https://homosaurus.org/v3/homoit0000245","skos:narrower":["https://homosaurus.org/v3/homoit0000815","https://homosaurus.org/v3/homoit0000825","https://homosaurus.org/v3/homoit0000867"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000245"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQCensorship"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:c