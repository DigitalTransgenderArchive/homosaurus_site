cept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001846","dc:identifier":"homoit0001846","skos:prefLabel":"Metoidioplasty","skos:altLabel":["Meta","Metaoidioplasty","Meto"],"rdfs:comment":"Surgical procedure in which the urethra is elongated and placed along a neophallus, typically to allow for standing urination.","skos:broader":"https://homosaurus.org/v3/homoit0000584","skos:related":["https://homosaurus.org/v3/homoit0001099","https://homosaurus.org/v3/homoit0001361","https://homosaurus.org/v3/homoit0001465","https://homosaurus.org/v3/homoit0001847","https://homosaurus.org/v3/homoit0001848","https://homosaurus.org/v3/homoit0001850","https://homosaurus.org/v3/homoit0001852","https://homosaurus.org/v3/homoit0001894"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001847","dc:identifier":"homoit0001847","skos:prefLabel":"Scrotoplasty","skos:altLabel":"Oscheoplasty","rdfs:comment":"Surgical construction of the scrotum.","skos:broader":"https://homosaurus.org/v3/homoit0000584","skos:related":["https://homosaurus.org/v3/homoit0001099","https://homosaurus.org/v3/homoit0001361","https://homosaurus.org/v3/homoit0001465","https://homosaurus.org/v3/homoit0001846","https://homosaurus.org/v3/homoit0001848","https://homosaurus.org/v3/homoit0001850","https://homosaurus.org/v3/homoit0001894"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001848","dc:identifier":"homoit0001848","skos:prefLabel":"Vaginectomy","rdfs:comment":"Surgical removal of the vagina.","skos:broader":"https://homosaurus.org/v3/homoit0000584","skos:related":["https://homosaurus.org/v3/homoit0000282","https://homosaurus.org/v3/homoit0001465","https://homosaurus.org/v3/homoit0001488","https://homosaurus.org/v3/homoit0001497","https://homosaurus.org/v3/homoit0001846","https://homosaurus.org/v3/homoit0001847","https://homosaurus.org/v3/homoit0001850","https://homosaurus.org/v3/homoit0001894"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001849","dc:identifier":"homoit0001849","skos:prefLabel":"Tracheal shave","skos:altLabel":["Adam's apple reduction","Chondrolaryngoplasty","TCR","Thyroid cartilage reduction","Trache shave","Trachea shave"],"rdfs:comment":"A surgery in which the laryngeal prominence, colloquially referred to as the Adam's apple, is reduced in size, often as part of facial feminization surgery for transfeminine people. Cisgender men and cisgender women may also undergo tracheal shaves if they feel their laryngeal prominence is too prominent.","skos:broader":"https://homosaurus.org/v3/homoit0001839","skos:related":["https://homosaurus.org/v3/homoit0001465","https://homosaurus.org/v3/homoit0001837"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-15"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001850","dc:identifier":"homoit0001850","skos:prefLabel":"Phalloplasty","skos:altLabel":["Phallo","Vagina-p