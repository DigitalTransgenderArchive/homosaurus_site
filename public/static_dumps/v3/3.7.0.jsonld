heology"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-22"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000791","dc:identifier":"homoit0000791","skos:prefLabel":"Lesbian trade union groups","rdfs:comment":"Organized groups of lesbian workers who are united to make decisions relating to the conditions affecting their labor.","skos:broader":"https://homosaurus.org/v3/homoit0000753","skos:related":"https://homosaurus.org/v3/homoit0000549","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianTradeUnionGroups"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000792","dc:identifier":"homoit0000792","skos:prefLabel":"Lesbian victims of hate crimes","rdfs:comment":"Lesbians who have experienced hate crimes and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000613","skos:narrower":"https://homosaurus.org/v3/homoit0000782","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianVictimsOfHateCrimes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000793","dc:identifier":"homoit0000793","skos:prefLabel":"Lesbian victims of rape","rdfs:comment":"Lesbians who have experienced rape and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000958","skos:narrower":"https://homosaurus.org/v3/homoit0000783","skos:related":"https://homosaurus.org/v3/homoit0000306","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianVictimsOfRape"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000794","dc:identifier":"homoit0000794","skos:prefLabel":"Lesbian victims of sexual abuse","rdfs:comment":"Lesbians who have experienced sexual abuse and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000959","skos:narrower":"https://homosaurus.org/v3/homoit0000784","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianVictimsOfSexualAbuse"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000795","dc:identifier":"homoit0000795","skos:prefLabel":"Lesbian victims of war","rdfs:comment":"Lesbians who have experienced war and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000961","skos:narrower":"https://homosaurus.org/v3/homoit0000785","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianVictimsOfWar"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000796","dc:identifier":"homoit0000796","skos:prefLabel":"Lesbian victims' rights","rdfs:comment":"Lesbians' legal rights to be informed, present, and heard within the criminal justice system after having been harmed or injured as the result of of a crime, accident, or other event.","skos:broader":"https://homosaurus.org/v3/homoit0001492","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianVictimsRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000797","dc:identifier":"homoit0000797","skos:prefLabel":"White lesbians","skos:altLabel":"Caucasian lesbians","rdfs:comment":"Lesbians who are white.","skos:broader":"https://homosaurus.org/v3/homoit0000243","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000243"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianWhitePeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000798","dc:identifier":"homoit0000798","skos:prefLabel":"Lesbian youth literature","rdfs:comment":"Written literary works for an audience of readers from 12-18 years of age, also known as young adult literature or YA; use in reference to youth literature focusing on lesbian characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0001522","skos:related":"https://homosaurus.org/v3/homoit0000786","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianYouthLiterature"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000799","dc:identifier":"homoit0000799","skos:prefLabel":"Lesbianism","rdfs:comment":"Sexual orientation of women and femmes who are sexually and/or romantically attracted to other women and femmes. However, not all lesbians are women, and gender non-conforming people who belong to lesbian communities have often identified as lesbian.","skos:broader":"https://homosaurus.org/v3/homoit0001298","skos:related":["https://homosaurus.org/v3/homoit0000204","https://homosaurus.org/v3/homoit0000556","https://homosaurus.org/v3/homoit0000647","https://homosaurus.org/v3/homoit0001669"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85076157"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000800","dc:identifier":"homoit0000800","skos:prefLabel":"Lesbians in the military","rdfs:comment":"Lesbians serving in state and national armed forces.","skos:broader":"https://homosaurus.org/v3/homoit0001100","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbiansInTheMilitary"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000801","dc:identifier":"homoit0000801","skos:prefLabel":["Lesbians of color","Lesbians of colour"],"rdfs:comment":"Primarily used in the United States, this term refers to lesbians who are not white and who identify as people of color.","skos:broader":"https://homosaurus.org/v3/homoit0001101","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbiansOfColour"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000802","dc:identifier":"homoit0000802","skos:prefLabel":"Parents of lesbians","skos:altLabel":"Lesbians' parents","rdfs:comment":"People who act as parents to one or more lesbian. For parents who are themselves lesbians, use the term \"Lesbian parents.\"","skos:broader":"https://homosaurus.org/v3/homoit0002224","skos:related":"https://homosaurus.org/v3/homoit0000556","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/parentsOfLesbians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000803","dc:identifier":"homoit0000803","skos:prefLabel":"Lesbophobia","rdfs:comment":"Antagonism or disgust directed towards lesbianism as an identity or lesbians due to their sexuality, perceived or actual. Lesbophobia can include denial of the existence of lesbianism, stereotypes, verbal harassment, and physical violence.","skos:broader":"https://homosaurus.org/v3/homoit0000920","skos:narrower":"https://homosaurus.org/v3/homoit0002591","skos:related":["https://homosaurus.org/v3/homoit0000057","https://homosaurus.org/v3/homoit0000058","https://homosaurus.org/v3/homoit0000556","https://homosaurus.org/v3/homoit0000619"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbophobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000804","dc:identifier":"homoit0000804","skos:prefLabel":"LGB","rdfs:comment":"Acronym used to describe lesbians, gay people, and bisexuals as a group. This acronym has often been used to exclude transgender people.","skos:broader":["https://homosaurus.org/v3/homoit0000594","https://homosaurus.org/v3/homoit0000805","https://homosaurus.org/v3/homoit0000806","https://homosaurus.org/v3/homoit0000807","https://homosaurus.org/v3/homoit0000882"],"skos:related":["https://homosaurus.org/v3/homoit0000143","https://homosaurus.org/v3/homoit0000485","https://homosaurus.org/v3/homoit0000733","https://homosaurus.org/v3/homoit0001403"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000805"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGB"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000806","dc:identifier":"homoit0000806","skos:prefLabel":"LGBTQ","rdfs:comment":"Acronym used to describe lesbians, gay men, bisexual people, transgender people, and queer people as a group.","skos:broader":["https://homosaurus.org/v3/homoit0000807","https://homosaurus.org/v3/homoit0000882"],"skos:narrower":["https://homosaurus.org/v3/homoit0000594","https://homosaurus.org/v3/homoit0000804"],"skos:related":["https://homosaurus.org/v3/homoit0000143","https://homosaurus.org/v3/homoit0000485","https://homosaurus.org/v3/homoit0000733","https://homosaurus.org/v3/homoit0001170","https://homosaurus.org/v3/homoit0001403"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001789"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001789","dc:identifier":"homoit0001789","skos:prefLabel":"2SLGBTQ+","skos:altLabel":"LGBTQ2S+","rdfs:comment":"Abbreviation used to describe Two-Spirit people, lesbians, gay men, bisexual people, transgender people, queer people, and other gender and sexual minorities as a group; commonly used in Canada to emphasize the particularities of Indigenous people's experiences.","skos:narrower":"https://homosaurus.org/v3/homoit0000807","skos:related":["https://homosaurus.org/v3/homoit0000143","https://homosaurus.org/v3/homoit0000485","https://homosaurus.org/v3/homoit0000733","https://homosaurus.org/v3/homoit0001170","https://homosaurus.org/v3/homoit0001403"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001789"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000807","dc:identifier":"homoit0000807","skos:prefLabel":"LGBTQ+","rdfs:comment":"Acronym used to describe lesbians, gay men, bisexual people, transgender people, queer people, and any other sexual and gender minorities as a group.","skos:broader":"https://homosaurus.org/v3/homoit0001789","skos:narrower":["https://homosaurus.org/v3/homoit0000804","https://homosaurus.org/v3/homoit0000806"],"skos:related":["https://homosaurus.org/v3/homoit0000004","https://homosaurus.org/v3/homoit0000143","https://homosaurus.org/v3/homoit0000485","https://homosaurus.org/v3/homoit0000672","https://homosaurus.org/v3/homoit0000733","https://homosaurus.org/v3/homoit0001170","https://homosaurus.org/v3/homoit0001290","https://homosaurus.org/v3/homoit0001403"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001789"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQ+"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000808","dc:identifier":"homoit0000808","skos:prefLabel":"LGBTQ+ action campaigns","skos:altLabel":"LGBTQ action campaigns","rdfs:comment":"A series of organized events or efforts centered around raising awareness or achieving a particular political, social, or cultural goal or action benefiting LGBTQ+ people and communities.","skos:broader":"https://homosaurus.org/v3/homoit0000853","skos:narrower":"https://homosaurus.org/v3/homoit0000851","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQActionCampaigns"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000809","dc:identifier":"homoit0000809","skos:prefLabel":"LGBTQ+ adoption","skos:altLabel":"LGBTQ adoption","rdfs:comment":"Adoption of a child or children, either by legal or informal processes, by LGBTQ+ people. ","skos:broader":"https://homosaurus.org/v3/homoit0000864","skos:narrower":["https://homosaurus.org/v3/homoit0000304","https://homosaurus.org/v3/homoit0000811","https://homosaurus.org/v3/homoit0000812","https://homosaurus.org/v3/homoit0