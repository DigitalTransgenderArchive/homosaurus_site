8"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerMuslims"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001190","dc:identifier":"homoit0001190","skos:prefLabel":"Native American queer people","skos:altLabel":["American Indian queer people","Queer American Indians","Queer Native Americans"],"rdfs:comment":"People who are part of the Native peoples of the continental United States and Canada (excluding Inuit people) and self-identity as queer. Use more specific terms when available.","skos:broader":"https://homosaurus.org/v3/homoit0001037","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerNativeAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001191","dc:identifier":"homoit0001191","skos:prefLabel":"Queer newsletters","rdfs:comment":"Serialized print or digital periodicals created by or for queer people, often with the purpose of sharing news and information related to queer communities and queer issues.","skos:broader":"https://homosaurus.org/v3/homoit0001041","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerNewsletters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001192","dc:identifier":"homoit0001192","skos:prefLabel":"Queer newspapers","rdfs:comment":"Serialized