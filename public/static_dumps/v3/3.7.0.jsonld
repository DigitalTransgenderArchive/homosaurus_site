rg/v3/homoit0002849","https://homosaurus.org/v3/homoit0002934"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001210"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerStudies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001211","dc:identifier":"homoit0001211","skos:prefLabel":"Queer survivors of hate crimes","rdfs:comment":"Queer people who have experienced and survived hate crimes; follow the individual's preference for \"victims\" or \"survivors\" whenever possible.","skos:broader":["https://homosaurus.org/v3/homoit0001221","https://homosaurus.org/v3/homoit0001349"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerSurvivorsOfHateCrimes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001212","dc:identifier":"homoit0001212","skos:prefLabel":"Queer survivors of rape","rdfs:comment":"Queer people who have experienced and survived rape; follow the individual's preference for \"victims\" or \"survivors\" whenever possible.","skos:broader":["https://homosaurus.org/v3/homoit0001222","https://homosaurus.org/v3/homoit0001350"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerSurvivorsOfRape"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001213","dc:identifier":"homoit0001213","skos:prefLabel":"Queer survivors of sexual abuse","rdfs:comment":"Queer people who have experienced and survived sexual abuse; follow the individual's preference for \"victims\" or \"survivors\" whenever possible.","skos:broader":["https://homosaurus.org/v3/homoit0001223","https://homosaurus.org/v3/homoit0001351"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerSurvivorsOfSexualAbuse"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001214","dc:identifier":"homoit0001214","skos:prefLabel":"Queer survivors of war","rdfs:comment":"Queer people who have experienced and survived war; follow the individual's preference for \"victims\" or \"survivors\" whenever possible.","skos:broader":["https://homosaurus.org/v3/homoit0001224","https://homosaurus.org/v3/homoit0001352"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerSurvivorsOfWar"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001215","dc:identifier":"homoit0001215","skos:prefLabel":"Queer youth","skos:altLabel":["Queer teenagers","Queer adolescents","Queer teens"],"rdfs:comment":"Queer people who are between the ages of childhood and adulthood.","skos:broader":["https://homosaurus.org/v3/homoit0001195","https://homosaurus.org/v3/homoit0001521"],"skos:narrower":"https://homosaurus.org/v3/homoit0001167","skos:related":"https://homosaurus.org/v3/homoit0001228","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerYouth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001216","dc:identifier":"homoit0001216","skos:prefLabel":"Queer television","rdfs:comment":"Television shows featuring queer people or queer themes.","skos:broader":"https://homosaurus.org/v3/homoit0001359","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001359"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerTelevision"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001217","dc:identifier":"homoit0001217","skos:prefLabel":["Queer theater","Queer theatre"],"rdfs:comment":"Works in the performance arts that focus on queer characters, communities, or issues.","skos:broader":"https://homosaurus.org/v3/homoit0001363","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001363"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerTheatre"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001218","dc:identifier":"homoit0001218","skos:prefLabel":"Queer theology","skos:altLabel":["Gay theology","LGBTQ+ theology","Lesbian theology"],"rdfs:comment":"A theological method that developed out of queer theory. Queer theology, which encompasses the previously commonly used terms gay theology and lesbian theology, can variously be understood as (1) theology done by, with, and for LGBTQ+ people according to their needs; (2) theology that purposefully opposes social and cultural norms surrounding gender and sexuality; and (3) theology that broadly challenges and deconstructs harmful historical boundaries.","skos:related":["https://homosaurus.org/v3/homoit0000928","https://homosaurus.org/v3/homoit0000948","https://homosaurus.org/v3/homoit0001219"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2010014738"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001218"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerTheology"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001219","dc:identifier":"homoit0001219","skos:prefLabel":"Queer theory","rdfs:comment":"Field of critical theory that emerged in the 1990s out of queer studies and women's studies. Queer theory involves the study and theorization of gender and sexual practices and identities that exist outside of heterosexuality and which challenge heteronormativity and essentialism.","skos:broader":"https://homosaurus.org/v3/homoit0001365","skos:narrower":["https://homosaurus.org/v3/homoit0002042","https://homosaurus.org/v3/homoit0003614","https://homosaurus.org/v3/homoit0003615","https://homosaurus.org/v3/homoit0003707","https://homosaurus.org/v3/homoit0003823","https://homosaurus.org/v3/homoit0003826"],"skos:related":["https://homosaurus.org/v3/homoit0000115","https://homosaurus.org/v3/homoit0000579","https://homosaurus.org/v3/homoit0001149","https://homosaurus.org/v3/homoit0001210","https://homosaurus.org/v3/homoit0001218","https://homosaurus.org/v3/homoit0001320"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006001835"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerTheory"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001220","dc:identifier":"homoit0001220","skos:prefLabel":"Queer transgender people","rdfs:comment":"Queer people who identify as transgender.","skos:broader":"https://homosaurus.org/v3/homoit0001195","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerTransgenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001221","dc:identifier":"homoit0001221","skos:prefLabel":"Queer victims of hate crimes","rdfs:comment":"Queer people who have experienced hate crimes and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000613","skos:narrower":"https://homosaurus.org/v3/homoit0001211","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerVictimsOfHateCrimes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001222","dc:identifier":"homoit0001222","skos:prefLabel":"Queer victims of rape","rdfs:comment":"Queer people who have experienced rape and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000958","skos:narrower":"https://homosaurus.org/v3/homoit0001212","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerVictimsOfRape"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001223","dc:identifier":"homoit0001223","skos:prefLabel":"Queer victims of sexual abuse","rdfs:comment":"Queer people who have experienced sexual abuse and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000959","skos:narrower":"https://homosaurus.org/v3/homoit0001213","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerVictimsOfSexualAbuse"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001224","dc:identifier":"homoit0001224","skos:prefLabel":"Queer victims of war","rdfs:comment":"Queer people who have experienced war and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000961","skos:narrower":"https://homosaurus.org/v3/homoit0001214","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerVictimsOfWar"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001225","dc:identifier":"homoit0001225","skos:prefLabel":"Queer victims' rights","rdfs:comment":"Queer people’s legal rights to be informed, present, and heard within the criminal justice system after having been harmed or injured as the result of a crime, accident, or other event.","skos:broader":"https://homosaurus.org/v3/homoit0001492","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerVictimsRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001226","dc:identifier":"homoit0001226","skos:prefLabel":"White queer people","skos:altLabel":["Caucasian queer people","Queer Caucasian people","Queer white people"],"rdfs:comment":"Queer people who are white.","skos:broader":"https://homosaurus.org/v3/homoit0000243","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000243"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerWhitePeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001227","dc:identifier":"homoit0001227","skos:prefLabel":"Queer women","rdfs:comment":"Women who identify as queer.","skos:broader":"https://homosaurus.org/v3/homoit0001195","skos:related":"https://homosaurus.org/v3/homoit0000556","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerWomen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001228","dc:identifier":"homoit0001228","skos:prefLabel":"Queer youth literature","rdfs:comment":"Written literary works for an audience of readers from 12-18 years of age, also known as young adult literature or YA; use in reference to youth literature focusing on queer characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0001522","skos:related":"https://homosaurus.org/v3/homoit0001215","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerYouthLiterature"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001229","dc:identifier":"homoit0001229","skos:prefLabel":"Queerphobia","rdfs:comment":"Antagonism or disgust directed towards queerness as an identity or queer people due to their identity, perceived or actual. Queerphobia can include denial of the existence of queerness, stereotypes, verbal harassment, and physical violence.","skos:broader":"https://homosaurus.org/v3/homoit0000920","skos:narrower":"https://homosaurus.org/v3/homoit0002594","skos:related":["https://homosaurus.org/v3/homoit0000060","https://homosaurus.org/v3/homoit0000061","https://homosaurus.org/v3/homoit0000619","https://homosaurus.org/v3/homoit0001195"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerphobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001230","dc:identifier":"homoit0001230","skos:prefLabel":"Radical feminism","rdfs:comment":"Perspective within feminism that calls for a radical reordering of society in which male supremacy is eliminated in all social and economic contexts.","skos:broader":"https://homosaurus.org/v3/homoit0000437","skos:related":["https://homosaurus.org/v3/homoit0001133","https://homosaurus.org/v3/homoit0001516","https://homosaurus.org/v3/homoit0003177"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000437"},"dc:replaces":{"@id":"http://homosaurus.org/v2/radicalFeminism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001232","dc:identifier":"homoit0001232","skos:prefLabel":"Rainbow flags","skos:altLabel":"Baker flags","rdfs:comment":"Rainbow-striped flags that symbolize LGBTQ+ pride and LGBTQ+ social movements. The first rainbow pride flag, which had eight colors, was created by Gilbert Baker, Lynn Segerblom, and others in San Francisco, California in 1978. Due to difficulties obtaining hot pink fabric and a desire for an even number of stripes, Baker modified his design in 1979 to contain six colors. The six-color version of the flag has been the most popular design since then.","skos:broader":"https://homosaurus.org/v3/homoit0003246","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000954"},"dc:replaces":{"@id":"http://homosaurus.org/v2/rainbowFlags"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001233","dc:identifier":"homoit0001233","skos:prefLabel":"Reading (Gender)","skos:altLabel":"Reading (Transgender)","rdfs:comment":"Slang term for the act of identifying (or reading) someone in public as trans, non-binary, crossdressing, or in drag. Unlike Clocking (Gender), which is typically understood as a threat (of violence or outing) against the person being clocked or read, Reading (Gender) refers to shared identification or recognized kinship between two individuals who are both gender minorities.","skos:related":["https://homosaurus.org/v3/homoit0000318","https://homosaurus.org/v3/homoit0001090","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001900","https://homosaurus.org/v3/homoit0002192"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001233"},"dc:replaces":{"@id":"http://homosaurus.org/v2/readingTransgender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001234","dc:identifier":"homoit0001234","skos:prefLabel":["Reciprocal in vitro fertilization","Reciprocal in vitro fertilisation"],"skos:altLabel":"Shared motherhood","rdfs:comment":"A medical procedure in which the egg of one partner is fertilized with donor sperm and then transferred to the uterus of the other partner to bring to term.","skos:broader":"https://homosaurus.org/v3/homoit0000659","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000864"},"dc:replaces":{"@id":"http://homosaurus.org/v2/reciprocalInVitroFertilisation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001235","dc:identifier":"homoit0001235","skos:prefLabel":"LGBTQ+ people who use substances recreationally","rdfs:comment":"The use of substances (that are typically deemed harmful or are subject to legal restriction, such as drugs or alcohol) by LGBTQ+ people for recreational or social purposes.","skos:broader":"https://homosaurus.org/v3/homoit0000379","skos:related":["https://homosaurus.org/v3/homoit0000380","https://homosaurus.org/v3/homoit0002289"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/recreationalDrugUse"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001236","dc:identifier":"homoit0001236","skos:prefLabel":"Relationship satisfaction","skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001236"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/relationshipSatisfaction"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-10-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001238","dc:identifier":"homoit0001238","skos:prefLabel":"Restraints","rdfs:comment":"Binding tools, devices, and accessories such as handcuffs, legcuffs, ropes, chains, straps, or straitjackets.","skos:broader":"https://homosaurus.org/v3/homoit0001266","skos:narrower":["https://homosaurus.org/v3/homoit0001337","https://homosaurus.org/v3/homoit0003115","https://homosaurus.org/v3/homoit0003117"],"skos:related":["https://homosaurus.org/v3/homoit0000086","https://homosaurus.org/v3/homoit0000704","https://homosaurus.org/v3/homoit0003059","https://homosaurus.org/v3/homoit0003071","https://homosaurus.org/v3/homoit0003089","https://homosaurus.org/v3/homoit0003090","https://homosaurus.org/v3/homoit0003145"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/restraints"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001239","dc:identifier":"homoit0001239","skos:prefLabel":["Risk behaviors","Risk behaviours"],"rdfs:comment":"Behaviors that may put someone at increased risk of contracting HIV or STIs.","skos:narrower":["https://homosaurus.org/v3/homoit0000099","https://homosaurus.org/v3/homoit0003129"],"skos:related":["https://homosaurus.org/v3/homoit0001251","https://homosaurus.org/v3/homoit0001287"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85114203"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001239"},"dc:replaces":{"@id":"http://homosaurus.org/v2/riskBehaviours"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001240","dc:identifier":"homoit0001240","skos:prefLabel":"Ritual homosexuality","rdfs:comment":"Non-reciprocal genital contact, typically fellatio, between younger and older men that takes place during initiation rituals practiced by the Sambari people of Papua New Guinea. This term was developed by Western outsiders and has been strongly criticized by the affected community.","skos:broader":["https://homosaurus.org/v3/homoit0000647","https://homosaurus.org/v3/homoit0001299"],"skos:related":"https://homosaurus.org/v3/homoit0000886","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ritualHomosexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001242","dc:identifier":"homoit0001242","skos:prefLabel":"Roleplay","rdfs:comment":"Practice in which one or more people take on a different identity or role to fulfill a desire or fantasy.","skos:broader":["https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0003068"],"skos:narrower":["https://homosaurus.org/v3/homoit0000022","https://homosaurus.org/v3/homoit0000576","https://homosaurus.org/v3/homoit0001145","https://homosaurus.org/v3/homoit0003067","https://homosaurus.org/v3/homoit0003082"],"skos:related":["https://homosaurus.org/v3/homoit0000217","https://homosaurus.org/v3/homoit0001241","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001304","https://homosaurus.org/v3/homoit0002165","https://homosaurus.org/v3/homoit0002169","https://homosaurus.org/v3/homoit0002207","https://homosaurus.org/v3/homoit0003052","https://homosaurus.org/v3/homoit0003063","https://homosaurus.org/v3/homoit0003089","https://homosaurus.org/v3/homoit0003125","https://homosaurus.org/v3/homoit0003138","https://homosaurus.org/v3/homoit0003139"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85114860"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/roleplay"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001243","dc:identifier":"homoit0001243","skos:prefLabel":"Rope play","skos:altLabel":"Shibari","rdfs:comment":"Bondage involving the use of rope for sexual stimulation.","skos:broader":"https://homosaurus.org/v3/homoit0001266","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ropePlay"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001244","dc:identifier":"homoit0001244","skos:prefLabel":"LGBTQ+ Roman Catholics","skos:altLabel":"Roman Catholics (LGBTQ)","rdfs:comment":"LGBTQ+ people who are members of the Roman Catholic Church.","skos:broader":"https://homosaurus.org/v3/homoit0000265","skos:narrower":["https://homosaurus.org/v3/homoit0000184","https://homosaurus.org/v3/homoit0000532","https://homosaurus.org/v3/homoit0000776","https://homosaurus.org/v3/homoit0001207","https://homosaurus.org/v3/homoit0001444","https://homosaurus.org/v3/homoit0002986","https://homosaurus.org/v3/homoit0002987"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/romanCatholicsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001245","dc:identifier":"homoit0001245","skos:prefLabel":"Romantic friendships","rdfs:comment":"Very close but non-sexual relationships between friends, often involving a degree of physical closeness beyond that which is common in modern Western societies; this may include, for example, friends holding hands, cuddling, kissing, and/or sharing a bed.","skos:broader":"https://homosaurus.org/v3/homoit0000455","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/romanticFriendships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001246","dc:identifier":"homoit0001246","skos:prefLabel":"Rubber and latex fetish","skos:altLabel":["Rubber and latex sex","Rubber sex","Rubbersex"],"rdfs:comment":"Eroticization of rubber, latex, and related materials.","skos:broader":["https://homosaurus.org/v3/homoit0000442","https://homosaurus.org/v3/homoit0001247","https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001299","https://homosaurus.org/v3/homoit0003066"],"skos:related":["https://homosaurus.org/v3/homoit0003099","https://homosaurus.org/v3/homoit0003126"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/rubberSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001247","dc:identifier":"homoit0001247","skos:prefLabel":"Rubber and latex community","skos:altLabel":"Rubber subculture","rdfs:comment":"Communities of people with an interest in rubber or latex materials for fashion and kink.","skos:broader":["https://homosaurus.org/v3/homoit0000297","https://homosaurus.org/v3/homoit0001345"],"skos:narrower":["https://homosaurus.org/v3/homoit0001246","https://homosaurus.org/v3/homoit0001248","https://homosaurus.org/v3/homoit0001249"],"skos:related":["https://homosaurus.org/v3/homoit0000705","https://homosaurus.org/v3/homoit0003098"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/rubberSubculture"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001248","dc:identifier":"homoit0001248","skos:prefLabel":"Rubbermen","rdfs:comment":"Men who have fetishes for or engage in fetish activities involving rubber and belong to the rubber community; frequently associated with U.S. LGBTQ+ subcultures.","skos:broader":"https://homosaurus.org/v3/homoit0001247","skos:related":"https://homosaurus.org/v3/homoit0001249","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/rubbermen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001249","dc:identifier":"homoit0001249","skos:prefLabel":"Rubberwomen","rdfs:comment":"Women who have fetishes for or engage in fetish activities involving rubber and belong to the rubber community; frequently associated with U.S. LGBTQ+ subcultures.","skos:broader":"https://homosaurus.org/v3/homoit0001247","skos:related":"https://homosaurus.org/v3/homoit0001248","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/rubberwomen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001250","dc:identifier":"homoit0001250","skos:prefLabel":"Sadism","rdfs:comment":"Erotic or sexual enjoyment of the application of pain or intense sensations. Derived from the literary works of the Marquis de Sade.","skos:broader":["https://homosaurus.org/v3/homoit0000036","https://homosaurus.org/v3/homoit0001300"],"skos:related":["https://homosaurus.org/v3/homoit0000997","https://homosaurus.org/v3/homoit0001295"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85116425"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sadism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001251","dc:identifier":"homoit0001251","skos:prefLabel":"Safer sex","rdfs:comment":"A set of practices aimed to minimize the risk of STI transmission, including but not limited to using condoms and dental dams, taking PrEP, and participating in regular STI testing.","skos:broader":["https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001299"],"skos:related":["https://homosaurus.org/v3/homoit0000027","https://homosaurus.org/v3/homoit0000299","https://homosaurus.org/v3/homoit0000346","https://homosaurus.org/v3/homoit0000700","https://homosaurus.org/v3/homoit0001239","https://homosaurus.org/v3/homoit0001252","https://homosaurus.org/v3/homoit0001287"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/saferSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001252","dc:identifier":"homoit0001252","skos:prefLabel":"Safer sex parties","rdfs:comment":"Social gatherings or events originating from Black lesbian communities in the Southern United States in the 1990s. Safer sex parties are typically held at private locations where organizers and participants discuss safer sex practices, sexuality, and sexual experiences.","skos:broader":"https://homosaurus.org/v3/homoit0001272","skos:related":"https://homosaurus.org/v3/homoit0001251","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000974"},"dc:replaces":{"@id":"http://homosaurus.org/v2/saferSexParties"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001253","dc:identifier":"homoit0001253","skos:prefLabel":"Sak veng","rdfs:comment":"Term used in Cambodia for people assigned male at birth who identify as women; translates to \"long hairs.\"","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":["https://homosaurus.org/v3/homoit0000695","https://homosaurus.org/v3/homoit0001338"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sakVeng"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001254","dc:identifier":"homoit0001254","skos:prefLabel":"Same-gender-loving","skos:altLabel":"SGL","rdfs:comment":"Culturally affirming term for sexual identity that is often used to describe African American homosexual people.","skos:broader":"https://homosaurus.org/v3/homoit0001295","skos:related":["https://homosaurus.org/v3/homoit0000015","https://homosaurus.org/v3/homoit0001009","https://homosaurus.org/v3/homoit0001510","https://homosaurus.org/v3/homoit0002278","https://homosaurus.org/v3/homoit0002279"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sameGenderLoving"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001255","dc:identifier":"homoit0001255","skos:prefLabel":"Same-sex divorce","rdfs:comment":"A legal proceeding undertaken to dissolve a marriage between two individuals of the same sex.","skos:broader":"https://homosaurus.org/v3/homoit0000854","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005000375"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sameSexDivorce"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001256","dc:identifier":"homoit0001256","skos:prefLabel":"Saris","rdfs:comment":"In Jewish culture, this term is used to refer to individuals who were assigned male at birth but later developed feminine characteristics..","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/saris"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001257","dc:identifier":"homoit0001257","skos:prefLabel":"Voyeurism","skos:altLabel":["Scopophilia","Scoptophilia"],"rdfs:comment":"Practice of watching or listening to others, typically without their awareness or consent. In consensual sexual encounters, voyeurism involves watching or listening to someone undress or engage in sexual activity without actively participating.","skos:broader":["https://homosaurus.org/v3/homoit0000442","https://homosaurus.org/v3/homoit0001267"],"skos:related":["https://homosaurus.org/v3/homoit0000412","https://homosaurus.org/v3/homoit0001142"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85118773"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/voyeurism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001258","dc:identifier":"homoit0001258","skos:prefLabel":"Sea queens","rdfs:comment":"Term used before the 1960s to describe gay men who worked aboard ships, mainly merchant vessels.","skos:broader":"https://homosaurus.org/v3/homoit0000878","skos:related":"https://homosaurus.org/v3/homoit0000506","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/seaQueens"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001259","dc:identifier":"homoit0001259","skos:prefLabel":"Secondary sex characteristics","rdfs:comment":"Features that appear during puberty that are not directly related to reproduction, like changes in the voice and the development of body hair.","skos:broader":"https://homosaurus.org/v3/homoit0001269","skos:narrower":["https://homosaurus.org/v3/homoit0000222","https://homosaurus.org/v3/homoit0000422","https://homosaurus.org/v3/homoit0000605","https://homosaurus.org/v3/homoit0001339","https://homosaurus.org/v3/homoit0001495"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/secondarySexCharacteristics"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001260","dc:identifier":"homoit0001260","skos:prefLabel":"Second-wave feminism","skos:altLabel":"Second wave feminism","rdfs:comment":"Period of feminist political activity (also referred to as women’s liberation) beginning in the early 1960s that critiqued male-dominated institutions and cultural practices in society.","skos:broader":"https://homosaurus.org/v3/homoit0000437","skos:related":["https://homosaurus.org/v3/homoit0003158","https://homosaurus.org/v3/homoit0003173"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008001560"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000437"},"dc:replaces":{"@id":"http://homosaurus.org/v2/secondWaveFeminism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001261","dc:identifier":"homoit0001261","skos:prefLabel":"Secrecy","rdfs:comment":"The state of being intentionally withheld, concealed, or kept secret; use in reference to LGBTQ+ individuals who conceal their (or others’) identities, whether out of preference or for safety reasons.","skos:related":["https://homosaurus.org/v3/homoit0000285","https://homosaurus.org/v3/homoit0000286","https://homosaurus.org/v3/homoit0000287","https://homosaurus.org/v3/homoit0000288","https://homosaurus.org/v3/homoit0000295","https://homosaurus.org/v3/homoit0000365","https://homosaurus.org/v3/homoit0001065","https://homosaurus.org/v3/homoit0001783","https://homosaurus.org/v3/homoit0001784","https://homosaurus.org/v3/homoit0001785","https://homosaurus.org/v3/homoit0001786","https://homosaurus.org/v3/homoit0001787","https://homosaurus.org/v3/homoit0001788","https://homosaurus.org/v3/homoit0002905"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85119431"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001261"},"dc:replaces":{"@id":"http://homosaurus.org/v2/secrecy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001262","dc:identifier":"homoit0001262","skos:prefLabel":"Seduction","skos:altLabel":"Temptation","rdfs:comment":"Enticing or tempting someone into something, typically sexual attraction or activity, through the use of persuasion, flattery, and/or promises.","skos:related":"https://homosaurus.org/v3/homoit0001306","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85119517"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001262"},"dc:replaces":{"@id":"http://homosaurus.org/v2/seduction"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001263","dc:identifier":"homoit0001263","skos:prefLabel":"Sekhet","skos:altLabel":"Sht","rdfs:comment":"Egyptian term that refers to a range of people of non-normative gender and sexual identities, including gay people, eunuchs, trans people, etc. Only use to describe people who self-identify as sekhet. ","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sekhet"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001264","dc:identifier":"homoit0001264","skos:prefLabel":"Sekrata","rdfs:comment":"In Madagascar, this term refers to people of a third gender who were assigned male at birth and present feminine characteristics.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sekrata"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001265","dc:identifier":"homoit0001265","skos:prefLabel":"Self-insemination","rdfs:comment":"The practice of using collected sperm to induce one's own pregnancy outside of a clinical environment.","skos:broader":["https://homosaurus.org/v3/homoit0000069","https://homosaurus.org/v3/homoit0000843","https://homosaurus.org/v3/homoit0002618"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97001526"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000864"},"dc:replaces":{"@id":"http://homosaurus.org/v2/self-insemination"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001268","dc:identifier":"homoit0001268","skos:prefLabel":"Sex assigned at birth","skos:altLabel":["Birth sex","Birth-assigned sex","Natal sex","Sex at birth","Sex reported at birth","ASAB ","SAAB"],"rdfs:comment":"The process of determining an individual’s sex relatively shortly after birth, usually documented on official records, such as a birth certificate. Determination is usually based on the appearance of external genitalia but may use other methodologies. In practice, sex assigned at birth is often culturally variable; the term “gender assigned at birth” is often more applicable or accurate.","skos:broader":"https://homosaurus.org/v3/homoit0001648","skos:narrower":["https://homosaurus.org/v3/homoit0000077","https://homosaurus.org/v3/homoit0000079","https://homosaurus.org/v3/homoit0001646"],"skos:related":["https://homosaurus.org/v3/homoit0000120","https://homosaurus.org/v3/homoit0000585","https://homosaurus.org/v3/homoit0000600","https://homosaurus.org/v3/homoit0000668","https://homosaurus.org/v3/homoit0000669","https://homosaurus.org/v3/homoit0000670","https://homosaurus.org/v3/homoit0001006","https://homosaurus.org/v3/homoit0001099","https://homosaurus.org/v3/homoit0001488","https://homosaurus.org/v3/homoit0001896","https://homosaurus.org/v3/homoit0001897"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexAssignedAtBirth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001270","dc:identifier":"homoit0001270","skos:prefLabel":"Sex clubs","rdfs:comment":"Establishments where patrons can engage in sex with other patrons, as well as formal or informal groups that organize sex-related activities.","skos:broader":"https://homosaurus.org/v3/homoit0000011","skos:related":["https://homosaurus.org/v3/homoit0000087","https://homosaurus.org/v3/homoit0000475","https://homosaurus.org/v3/homoit0001272","https://homosaurus.org/v3/homoit0003079"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexClubs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001271","dc:identifier":"homoit0001271","skos:prefLabel":"Sex education","rdfs:comment":"Instruction about sexual health and sexuality, including topics such as consent, safer sex, transmission of STIs, and reproduction.","skos:broader":"https://homosaurus.org/v3/homoit0000661","skos:related":"https://homosaurus.org/v3/homoit0000027","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120630"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000661"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexEducation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001272","dc:identifier":"homoit0001272","skos:prefLabel":"Sex parties","rdfs:comment":"Social gatherings or events, typically held in private residences or at sex clubs, in which participants engage in or observe group sexual activities.","skos:broader":"https://homosaurus.org/v3/homoit0000974","skos:narrower":"https://homosaurus.org/v3/homoit0001252","skos:related":["https://homosaurus.org/v3/homoit0000087","https://homosaurus.org/v3/homoit0000242","https://homosaurus.org/v3/homoit0000603","https://homosaurus.org/v3/homoit0001270","https://homosaurus.org/v3/homoit0001306","https://homosaurus.org/v3/homoit0003080"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000974"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexParties"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001273","dc:identifier":"homoit0001273","skos:prefLabel":"Sex scandals","skos:altLabel":"Sexual scandals","rdfs:comment":"Public scandals surrounding sensational cases of sexual indecency or sex crimes.","skos:related":"https://homosaurus.org/v3/homoit0000947","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007003459"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001273"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexScandals"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001274","dc:identifier":"homoit0001274","skos:prefLabel":"Sex therapy","rdfs:comment":"A form of counseling intended to address sexual dysfunction and other sex-related issues.","skos:broader":"https://homosaurus.org/v3/homoit0001366","skos:related":"https://homosaurus.org/v3/homoit0001291","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120674"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexTherapy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001275","dc:identifier":"homoit0001275","skos:prefLabel":"Sex tourism","rdfs:comment":"The practice of traveling with the intention of soliciting sex work, typically to countries where sex work is legal, decriminalized, or less stigmatized. Sex tourism often presents ethical concerns, such as the economic gap between tourists and residents, differences in age of consent laws globally, and the selective enforcement of anti-sex work laws by police.","skos:broader":"https://homosaurus.org/v3/homoit0000011","skos:narrower":"https://homosaurus.org/v3/homoit0003262","skos:related":"https://homosaurus.org/v3/homoit0001276","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh96006838"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexTourism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001276","dc:identifier":"homoit0001276","skos:prefLabel":"Sex work","skos:altLabel":"Prostitution","rdfs:comment":"The exchange of sexual services, performances, or companionship for money or goods. Use to describe the broad spectrum of sex work, and use more specific terms if possible. For individuals who perform sex work, use \"Sex workers\" or narrower terms. For sex work undertaken by individuals who cannot or have not consented, use \"Sex trafficking.\"","skos:broader":"https://homosaurus.org/v3/homoit0000011","skos:narrower":["https://homosaurus.org/v3/homoit0000405","https://homosaurus.org/v3/homoit0003763","https://homosaurus.org/v3/homoit0003764","https://homosaurus.org/v3/homoit0003768","https://homosaurus.org/v3/homoit0003780","https://homosaurus.org/v3/homoit0003781","https://homosaurus.org/v3/homoit0003792","https://homosaurus.org/v3/homoit0000494"],"skos:related":["https://homosaurus.org/v3/homoit0001275","https://homosaurus.org/v3/homoit0003743","https://homosaurus.org/v3/homoit0003758"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2022006936"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexWork"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001277","dc:identifier":"homoit0001277","skos:prefLabel":"LGBTQ+ sex workers","skos:altLabel":["LGBTQ+ prostitutes","LGBTQ+ prostitution","LGBTQ+ sex work","Prostitutes (LGBTQ)","Prostitution (LGBTQ)","Sex work (LGBTQ)"],"rdfs:comment":"LGBTQ+ people who receive money or goods in exchange for sexual services, performances, or companionship. Use to describe LGBTQ+ people working across the broad spectrum of sex work.","skos:broader":["https://homosaurus.org/v3/homoit0003758","https://homosaurus.org/v3/homoit0000915"],"skos:narrower":["https://homosaurus.org/v3/homoit0000178","https://homosaurus.org/v3/homoit0000525","https://homosaurus.org/v3/homoit0000768","https://homosaurus.org/v3/homoit0001201","https://homosaurus.org/v3/homoit0001437","https://homosaurus.org/v3/homoit0003759","https://homosaurus.org/v3/homoit0003760","https://homosaurus.org/v3/homoit0003797","https://homosaurus.org/v3/homoit0003798"],"skos:related":["https://homosaurus.org/v3/homoit0003262","https://homosaurus.org/v3/homoit0003761","https://homosaurus.org/v3/homoit0003762"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003758"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexWorkersLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001278","dc:identifier":"homoit0001278","skos:prefLabel":"Sexism","rdfs:comment":"Discrimination, prejudice, or bias directed against a particular sex or gender based on the assumption that this sex or gender is intrinsically inferior to another.","skos:related":["https://homosaurus.org/v3/homoit0000565","https://homosaurus.org/v3/homoit0000619","https://homosaurus.org/v3/homoit0001293","https://homosaurus.org/v3/homoit0002183","https://homosaurus.org/v3/homoit0002259","https://homosaurus.org/v3/homoit0003519"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120678"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001278"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001279","dc:identifier":"homoit0001279","skos:prefLabel":"Sexologists","rdfs:comment":"People who professionally study sexology, or human sexual behavior and sexual relationships.","skos:related":"https://homosaurus.org/v3/homoit0001280","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120693"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001279"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexologists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001280","dc:identifier":"homoit0001280","skos:prefLabel":"Sexology","rdfs:comment":"Scientific study of human sexuality including sexual interests, behaviors, and functions that utilizes tools from other academic fields like anthropology, biology, medicine, and psychology. ","skos:related":["https://homosaurus.org/v3/homoit0001279","https://homosaurus.org/v3/homoit0001306"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh90004841"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001280"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexology"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001281","dc:identifier":"homoit0001281","skos:prefLabel":"Sexting","rdfs:comment":"Act of sending sexually explicit messages or photographs, primarily between mobile phones.","skos:broader":"https://homosaurus.org/v3/homoit0001267","skos:related":["https://homosaurus.org/v3/homoit0001128","https://homosaurus.org/v3/homoit0001306"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2012000622"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexting"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001282","dc:identifier":"homoit0001282","skos:prefLabel":"Sexual abstinence","rdfs:comment":"Practice of abstaining or not participating in some or all forms of sexual activity, whether for medical, psychological, social, moral, or religious reasons. Sexual abstinence may be voluntary or involuntary. ","skos:broader":"https://homosaurus.org/v3/homoit0001267","skos:narrower":"https://homosaurus.org/v3/homoit0001493","skos:related":["https://homosaurus.org/v3/homoit0000004","https://homosaurus.org/v3/homoit0000244","https://homosaurus.org/v3/homoit0001306"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120718"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualAbstinence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001283","dc:identifier":"homoit0001283","skos:prefLabel":"LGBTQ+ people with sexual addictions","skos:altLabel":"LGBTQ+ people with sex addictions","rdfs:comment":"LGBTQ+ people experiencing addiction to or dependency upon sexual activities. Only use to refer to individuals who describe themselves as having sexual addictions, not individuals whose sexual practices are perceived as promiscuous or unsafe by others.","skos:broader":"https://homosaurus.org/v3/homoit0001550","skos:narrower":"https://homosaurus.org/v3/homoit0001539","skos:related":["https://homosaurus.org/v3/homoit0000412","https://homosaurus.org/v3/homoit0000656","https://homosaurus.org/v3/homoit0001538"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualAddiction"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001284","dc:identifier":"homoit0001284","skos:prefLabel":"Sexual excitement","skos:altLabel":"Sexual arousal","rdfs:comment":"Term describing the physiological and psychological response to sexual stimulation.","skos:broader":"https://homosaurus.org/v3/homoit0000656","skos:narrower":"https://homosaurus.org/v3/homoit0001062","skos:related":["https://homosaurus.org/v3/homoit0000323","https://homosaurus.org/v3/homoit0000404","https://homosaurus.org/v3/homoit0000589","https://homosaurus.org/v3/homoit0000610","https://homosaurus.org/v3/homoit0000683","https://homosaurus.org/v3/homoit0000967","https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001288","https://homosaurus.org/v3/homoit0001291","https://homosaurus.org/v3/homoit0001292","https://homosaurus.org/v3/homoit0001306","https://homosaurus.org/v3/homoit0001806"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120733"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000656"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualExcitement"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001285","dc:identifier":"homoit0001285","skos:prefLabel":"Sexual assault","rdfs:comment":"Sexual behavior or contact targeting an individual who has not consented; includes nonconsensual sex acts that may not be illegal or punishable by law in the given location or time period.","skos:broader":"https://homosaurus.org/v3/homoit0001305","skos:related":["https://homosaurus.org/v3/homoit0000855","https://homosaurus.org/v3/homoit0003444"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85111402"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001305"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualAssault"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001286","dc:identifier":"homoit0001286","skos:prefLabel":"Sexual autonomy","rdfs:comment":"One’s ability or prerogative to freely choose when, with whom, and under what circumstances they engage in sexual activity or relationships.","skos:related":["https://homosaurus.org/v3/homoit0001300","https://homosaurus.org/v3/homoit0001306"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001286"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualAutonomy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001287","dc:identifier":"homoit0001287","skos:prefLabel":["Sexual behavior change","Sexual behaviour change"],"rdfs:comment":"Term used to describe changes in behavior related to safer sexual practices (e.g., condom use, STI testing).","skos:related":["https://homosaurus.org/v3/homoit0001239","https://homosaurus.org/v3/homoit0001251","https://homosaurus.org/v3/homoit0001300"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001287"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualBehaviourChange"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001288","dc:identifier":"homoit0001288","skos:prefLabel":"Sexual climax","rdfs:comment":"The most intense or highest point of pleasure in sexual activities; the peak of an orgasm.","skos:related":["https://homosaurus.org/v3/homoit0000323","https://homosaurus.org/v3/homoit0000589","https://homosaurus.org/v3/homoit0000610","https://homosaurus.org/v3/homoit0000683","https://homosaurus.org/v3/homoit0001062","https://homosaurus.org/v3/homoit0001284"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001288"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualClimax"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001289","dc:identifier":"homoit0001289","skos:prefLabel":"Sexual offenses laws","skos:altLabel":"Sexual criminal codes","rdfs:comment":"Legislation determining the kinds of sexual behaviors and activities that are legally permissible. Laws vary by jurisdiction but typically address crimes like sexual coercion, sexual assault, incest, and sex trafficking. Historically and in the present day, sexual offenses laws have also served to criminalize consensual but non-normative sexual practices, such as anal sex and homosexuality.","skos:broader":"https://homosaurus.org/v3/homoit0000313","skos:narrower":"https://homosaurus.org/v3/homoit0001326","skos:related":["https://homosaurus.org/v3/homoit0000020","https://homosaurus.org/v3/homoit0002373"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualOffencesLaws"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001290","dc:identifier":"homoit0001290","skos:prefLabel":"Sexual diversity","rdfs:comment":"Diversity of sexual orientation or sexuality among members of a group or within a given society.","skos:broader":"https://homosaurus.org/v3/homoit0000358","skos:narrower":"https://homosaurus.org/v3/homoit0001558","skos:related":["https://homosaurus.org/v3/homoit0000807","https://homosaurus.org/v3/homoit0001292","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001298","https://homosaurus.org/v3/homoit0001300","https://homosaurus.org/v3/homoit0001556"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000358"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualDiversity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001292","dc:identifier":"homoit0001292","skos:prefLabel":"Sexual function","rdfs:comment":"The process by which an individual's body experiences and reacts to sexual stimuli.","skos:broader":"https://homosaurus.org/v3/homoit0001298","skos:related":["https://homosaurus.org/v3/homoit0000967","https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001284","https://homosaurus.org/v3/homoit0001290","https://homosaurus.org/v3/homoit0001291","https://homosaurus.org/v3/homoit0001294","https://homosaurus.org/v3/homoit0001306"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualFunction"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001293","dc:identifier":"homoit0001293","skos:prefLabel":"Sexual harassment","rdfs:comment":"Unwelcome behavior of a sexual nature, including unwanted advances or requests for sexual favors.","skos:broader":"https://homosaurus.org/v3/homoit0000611","skos:related":["https://homosaurus.org/v3/homoit0000059","https://homosaurus.org/v3/homoit0000675","https://homosaurus.org/v3/homoit0001278"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120735"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000611"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualHarassment"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001294","dc:identifier":"homoit0001294","skos:prefLabel":"Sexual health","rdfs:comment":"State of physical, emotional, mental, and social well being in relation to sexuality. This includes one’s ability to have responsible, satisfying, and safer sex free of violence or coercion. ","skos:related":["https://homosaurus.org/v3/homoit0000027","https://homosaurus.org/v3/homoit0001291","https://homosaurus.org/v3/homoit0001292"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85063528"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001294"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualHealth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001296","dc:identifier":"homoit0001296","skos:prefLabel":"Sexual inversion","rdfs:comment":"Historical term for homosexuality used by sexologists to refer to an inborn reversal of gender traits or roles. Only use in historical contexts.","skos:broader":["https://homosaurus.org/v3/homoit0000878","https://homosaurus.org/v3/homoit0001006"],"skos:related":["https://homosaurus.org/v3/homoit0000395","https://homosaurus.org/v3/homoit0000677","https://homosaurus.org/v3/homoit0001300","https://homosaurus.org/v3/homoit0001564"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualInversion"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001301","dc:identifier":"homoit0001301","skos:prefLabel":"Sexual reform","rdfs:comment":"Term used to describe the European movements for sexual reform in the 20th century.","skos:related":["https://homosaurus.org/v3/homoit0000947","https://homosaurus.org/v3/homoit0001306"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001301"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualReform"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001302","dc:identifier":"homoit0001302","skos:prefLabel":"Sexual relationships","rdfs:comment":"Ongoing connections between two or more individuals involving sexual behaviors or activities.","skos:broader":"https://homosaurus.org/v3/homoit0001237","skos:narrower":["https://homosaurus.org/v3/homoit0000242","https://homosaurus.org/v3/homoit0000976","https://homosaurus.org/v3/homoit0001019","https://homosaurus.org/v3/homoit0001124"],"skos:related":["https://homosaurus.org/v3/homoit0000050","https://homosaurus.org/v3/homoit0000344","https://homosaurus.org/v3/homoit0000458","https://homosaurus.org/v3/homoit0000895","https://homosaurus.org/v3/homoit0001080","https://homosaurus.org/v3/homoit0001081","https://homosaurus.org/v3/homoit0001300","https://homosaurus.org/v3/homoit0001632","https://homosaurus.org/v3/homoit0001633","https://homosaurus.org/v3/homoit0001636","https://homosaurus.org/v3/homoit0001916","https://homosaurus.org/v3/homoit0001917"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualRelationships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001303","dc:identifier":"homoit0001303","skos:prefLabel":"Sexual revolution","rdfs:comment":"Social perspective from the 1960s into the 1970s that challenged traditional codes of behavior related to sexuality and interpersonal relationships throughout the Western world.","skos:related":"https://homosaurus.org/v3/homoit0000947","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001303"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualRevolution"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001304","dc:identifier":"homoit0001304","skos:prefLabel":"Sexual roles","rdfs:comment":"An erotic identity an individual assumes during sexual play with one or more people; this identity can either be restricted to the bedroom or extended into day-to-day life.","skos:broader":["https://homosaurus.org/v3/homoit0001241","https://homosaurus.org/v3/homoit0001300"],"skos:narrower":["https://homosaurus.org/v3/homoit0000219","https://homosaurus.org/v3/homoit0000231","https://homosaurus.org/v3/homoit0000440","https://homosaurus.org/v3/homoit0000999","https://homosaurus.org/v3/homoit0001018","https://homosaurus.org/v3/homoit0001353","https://homosaurus.org/v3/homoit0001376","https://homosaurus.org/v3/homoit0001779","https://homosaurus.org/v3/homoit0001898","https://homosaurus.org/v3/homoit0003052","https://homosaurus.org/v3/homoit0003506"],"skos:related":["https://homosaurus.org/v3/homoit0000609","https://homosaurus.org/v3/homoit0001242","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001306"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001241"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualRoles"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001307","dc:identifier":"homoit0001307","skos:prefLabel":"Sexually abused LGBTQ+ children","skos:altLabel":"Sexually abused LGBTQ children","rdfs:comment":"LGBTQ+ children younger than 18 years of age who are currently experiencing or have experienced sexual abuse.","skos:broader":["https://homosaurus.org/v3/homoit0000256","https://homosaurus.org/v3/homoit0000959"],"skos:related":"https://homosaurus.org/v3/homoit0000958","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexuallyAbusedLGBTQChildren"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001309","dc:identifier":"homoit0001309","skos:prefLabel":"Shiv-Shakthis","rdfs:comment":"Term used in the Andhra Pradesh region of India to describe transgender people who are considered to be married to the gods (particularly Shiva). They often serve as astrologers and spiritual healers and their community is guarded by gurus who induct disciples and train them.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/shivShakthis"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001310","dc:identifier":"homoit0001310","skos:prefLabel":"Siblings","rdfs:comment":"Individuals who share the same parent or parents.","skos:broader":"https://homosaurus.org/v3/homoit0000421","skos:narrower":["https://homosaurus.org/v3/homoit0002349","https://homosaurus.org/v3/homoit0002350","https://homosaurus.org/v3/homoit0002621","https://homosaurus.org/v3/homoit0002623"],"skos:related":"https://homosaurus.org/v3/homoit0000420","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85017225"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/siblings"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001311","dc:identifier":"homoit0001311","skos:prefLabel":"Significant others","rdfs:comment":"An individual's partner or partners in an established, ongoing romantic or sexual relationship.","skos:related":["https://homosaurus.org/v3/homoit0000362","https://homosaurus.org/v3/homoit0000675","https://homosaurus.org/v3/homoit0000855","https://homosaurus.org/v3/homoit0000895","https://homosaurus.org/v3/homoit0001080","https://homosaurus.org/v3/homoit0001081","https://homosaurus.org/v3/homoit0001082","https://homosaurus.org/v3/homoit0001237","https://homosaurus.org/v3/homoit0001300","https://homosaurus.org/v3/homoit0002365"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001311"},"dc:replaces":{"@id":"http://homosaurus.org/v2/significantOthers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001312","dc:identifier":"homoit0001312","skos:prefLabel":"Single people","skos:altLabel":"Singles","rdfs:comment":"People who are not involved in any committed sexual or romantic relationships, including marriages, civil unions, or other established partnerships.","skos:broader":"https://homosaurus.org/v3/homoit0000989","skos:narrower":"https://homosaurus.org/v3/homoit0000944","skos:related":"https://homosaurus.org/v3/homoit0000359","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85122849"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/singlePeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001313","dc:identifier":"homoit0001313","skos:prefLabel":"Sissies","skos:altLabel":"Sissy boys","rdfs:comment":"Pejorative term applied to boys or men who are perceived to be effeminate or do not conform to traditional masculine roles.","skos:broader":["https://homosaurus.org/v3/homoit0000220","https://homosaurus.org/v3/homoit0000577"],"skos:related":"https://homosaurus.org/v3/homoit0001148","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sissies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001314","dc:identifier":"homoit0001314","skos:prefLabel":"Sistergirls","skos:altLabel":"Sistagirls","rdfs:comment":"Indigenous Australian term for people who transition from male to female.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":["https://homosaurus.org/v3/homoit0000002","https://homosaurus.org/v3/homoit0000224"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sistergirls"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001315","dc:identifier":"homoit0001315","skos:prefLabel":["Situational sexual behavior","Situational sexual behaviour"],"skos:altLabel":"Situational homosexuality","rdfs:comment":"Sexual behaviors that depart from an individual's typical behaviors or preferences as a result of social pressures that permit, encourage, or compel certain behaviors.","skos:related":["https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001299","https://homosaurus.org/v3/homoit0001300","https://homosaurus.org/v3/homoit0001306","https://homosaurus.org/v3/homoit0003738"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001315"},"dc:replaces":{"@id":"http://homosaurus.org/v2/situationalSexualBehaviour"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001316","dc:identifier":"homoit0001316","skos:prefLabel":"Skoptsy","rdfs:comment":"A sect within the larger Spiritual Christianity movement in the Russian Empire that emerged in the 18th century. This sect is most commonly known for conducting castrations and mastectomies in order to suppress sexual desire.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85123228"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/skoptsy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001318","dc:identifier":"homoit0001318","skos:prefLabel":"LGBTQ+ submissives","skos:altLabel":["LGBTQ+ S-type","LGBTQ+ Slaves","LGBTQ+ Subs"],"rdfs:comment":"The person who takes on the position of submission or service in a power exchange relationship or during kink activities.","skos:broader":["https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001637","https://homosaurus.org/v3/homoit0003084"],"skos:related":["https://homosaurus.org/v3/homoit0000036","https://homosaurus.org/v3/homoit0000219","https://homosaurus.org/v3/homoit0000363","https://homosaurus.org/v3/homoit0000705","https://homosaurus.org/v3/homoit0000999","https://homosaurus.org/v3/homoit0001018","https://homosaurus.org/v3/homoit0001376","https://homosaurus.org/v3/homoit0003052"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/slaves"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001319","dc:identifier":"homoit0001319","skos:prefLabel":"Leather and kink activism","rdfs:comment":"Organizing and activism focused on increasing awareness and acceptance of kinks, fetishes, sadomasochism, leather and related subcultures, closely associated with LGBTQ+ activism and the sex-positive feminist movement.","skos:broader":"https://homosaurus.org/v3/homoit0001322","skos:related":["https://homosaurus.org/v3/homoit0000006","https://homosaurus.org/v3/homoit0000036","https://homosaurus.org/v3/homoit0003101"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/SMMovement"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001320","dc:identifier":"homoit0001320","skos:prefLabel":"Social constructionism","rdfs:comment":"Belief or theory that categories of gender, sexual orientation, and ethnicity are cultural constructs rather than intrinsic categories of nature.","skos:broader":"https://homosaurus.org/v3/homoit0001365","skos:related":["https://homosaurus.org/v3/homoit0000115","https://homosaurus.org/v3/homoit0001006","https://homosaurus.org/v3/homoit0001219"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2009007835"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/socialConstructionism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001324","dc:identifier":"homoit0001324","skos:prefLabel":"Social security cards","rdfs:comment":"Official documents issued by governments that ascribe unique numeral identifiers to citizens to track their income and determine retirement benefits. ","skos:broader":"https://homosaurus.org/v3/homoit0001053","skos:related":["https://homosaurus.org/v3/homoit0000119","https://homosaurus.org/v3/homoit0000247","https://homosaurus.org/v3/homoit0000377","https://homosaurus.org/v3/homoit0000573","https://homosaurus.org/v3/homoit0001465"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/socialSecurityCards"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001325","dc:identifier":"homoit0001325","skos:prefLabel":"Sodomy","rdfs:comment":"Historical term for \"unnatural\" sexual acts unrelated to procreation, including oral sex and anal sex.","skos:broader":"https://homosaurus.org/v3/homoit0000878","skos:related":["https://homosaurus.org/v3/homoit0000227","https://homosaurus.org/v3/homoit0001095","https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001299","https://homosaurus.org/v3/homoit0001326"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85124275"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sodomy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001326","dc:identifier":"homoit0001326","skos:prefLabel":"Sodomy laws","rdfs:comment":"Laws and regulations regarding the legality of sodomy, particularly in the United States, Great Britain, and/or former British colonies.","skos:broader":"https://homosaurus.org/v3/homoit0001289","skos:related":["https://homosaurus.org/v3/homoit0001325","https://homosaurus.org/v3/homoit0002373","https://homosaurus.org/v3/homoit0002380"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2013003497"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sodomyLaws"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001327","dc:identifier":"homoit0001327","skos:prefLabel":"Soft butches","rdfs:comment":"People who are somewhat or slightly masculine in their appearance; commonly used in lesbian communities.","skos:broader":"https://homosaurus.org/v3/homoit0001295","skos:related":["https://homosaurus.org/v3/homoit0000231","https://homosaurus.org/v3/homoit0000440","https://homosaurus.org/v3/homoit0000556","https://homosaurus.org/v3/homoit0002061"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/softButches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001328","dc:identifier":"homoit0001328","skos:prefLabel":"Solo sex","rdfs:comment":"Sexual acts involving only one person, such as masturbation, as opposed to sex with a partner.","skos:related":"https://homosaurus.org/v3/homoit0001000","skos:hasTopConcept":{"@id":"https://homosaurus.