rg/v4/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexAccessories"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000042","dc:identifier":"homoit0000042","skos:prefLabel":"Anal fisting","rdfs:comment":"Sexual practice of inserting a fist into an anus.","skos:broader":["https://homosaurus.org/v3/homoit0000043","https://homosaurus.org/v3/homoit0000445"],"skos:related":["https://homosaurus.org/v3/homoit0000049","https://homosaurus.org/v3/homoit0000081","https://homosaurus.org/v3/homoit0001486"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/analFisting"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000043","dc:identifier":"homoit0000043","skos:prefLabel":"Anal sex","rdfs:comment":"Sexual activity involving penetration of the anus.","skos:broader":["https://homosaurus.org/v3/homoit0000081","https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001299"],"skos:narrower":["https://homosaurus.org/v3/homoit0000042","https://homosaurus.org/v3/homoit0000076"],"skos:related":["https://homosaurus.org/v3/homoit0000049","https://homosaurus.org/v3/homoit0000233","https://homosaurus.org/v3/homoit0003124"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85004760"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/analSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000044","dc:identifier":"homoit0000044","skos:prefLabel":"Androgen insensitivity syndrome","skos:altLabel":["AIS","Goldberg-Maxwell syndrome","Male androgen insensitivity syndrome"],"rdfs:comment":"People born with AIS have XY chromosomes and testes, and their bodies have varying levels of insensitivity to androgens (including testosterone). This means that their cells do not respond typically to the testosterone that they produce. Like other variations in sex characteristics, AIS is a spectrum, with the subcategories of complete (CAIS), partial (PAIS), and mild androgen insensitivity (MAIS). The term \"male androgen insensitivity syndrome\" should not be used to describe this variation because many people with AIS are women.","skos:broader":"https://homosaurus.org/v3/homoit0000669","skos:narrower":["https://homosaurus.org/v3/homoit0001079","https://homosaurus.org/v3/homoit0002830","https://homosaurus.org/v3/homoit0002866"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/androgenInsensitivitySyndrome"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000045","dc:identifier":"homoit0000045","skos:prefLabel":"Androgynous people","rdfs:comment":"People who have a non-binary gender that includes masculine and feminine traits.","skos:broader":["https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001817"],"skos:related":["https://homosaurus.org/v3/homoit0000047","https://homosaurus.org/v3/homoit0001048"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/androgynousPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000046","dc:identifier":"homoit0000046","skos:prefLabel":"Androgynos","rdfs:comment":"Israeli term used in Rabbinical literature to describe both an intersex mythological creature and refer to a legal condition.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":"https://homosaurus.org/v3/homoit0000618","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/androgynos"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000047","dc:identifier":"homoit0000047","skos:prefLabel":"Androgyny","rdfs:comment":"The combination of masculine and feminine characteristics.","skos:broader":"https://homosaurus.org/v3/homoit0000568","skos:related":["https://homosaurus.org/v3/homoit0000045","https://homosaurus.org/v3/homoit0000389","https://homosaurus.org/v3/homoit0000562","https://homosaurus.org/v3/homoit0000577","https://homosaurus.org/v3/homoit0000995","https://homosaurus.org/v3/homoit0001756"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85004920"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/androgyny"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000048","dc:identifier":"homoit0000048","skos:prefLabel":"LGBTQ+ Anglicans","skos:altLabel":["Anglicans (LGBTQ)","LGBTQ Church of England","LGBTQ Episcopalians","LGBTQ Anglicans"],"rdfs:comment":"LGBTQ+ people who are Anglican.","skos:broader":"https://homosaurus.org/v3/homoit0001137","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQAnglicans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000928","dc:identifier":"homoit0000928","skos:prefLabel":"LGBTQ+ religious people","skos:altLabel":"LGBTQ+ religions","rdfs:comment":"LGBTQ+ people who belong to a religion or hold religious beliefs. For LGBTQ+ people who hold spiritual beliefs or engage in spiritual practices but do not belong to an organized religion, use the term \"LGBTQ+ spiritual people.\"","skos:narrower":["https://homosaurus.org/v3/homoit0000225","https://homosaurus.org/v3/homoit0000265","https://homosaurus.org/v3/homoit0000300","https://homosaurus.org/v3/homoit0000633","https://homosaurus.org/v3/homoit0000682","https://homosaurus.org/v3/homoit0000939","https://homosaurus.org/v3/homoit0000940","https://homosaurus.org/v3/homoit0000955","https://homosaurus.org/v3/homoit0001032","https://homosaurus.org/v3/homoit0001069","https://homosaurus.org/v3/homoit0003347"],"skos:related":["https://homosaurus.org/v3/homoit0000082","https://homosaurus.org/v3/homoit0000948","https://homosaurus.org/v3/homoit0001218","https://homosaurus.org/v3/homoit0003609"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQReligions"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://