f rape","rdfs:comment":"Lesbians who have experienced and survived rape; follow the individual's preference for \"victims\" or \"survivors\" whenever possible.","skos:broader":["https://homosaurus.org/v3/homoit0000793","https://homosaurus.org/v3/homoit0001350"],"skos:related":"https://homosaurus.org/v3/homoit0000306","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianSurvivorsOfRape"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000784","dc:identifier":"homoit0000784","skos:prefLabel":"Lesbian survivors of sexual abuse","rdfs:comment":"Lesbians who have experienced and survived sexual abuse; follow the individual's preference for \"victims\" or \"survivors\" whenever possible.","skos:broader":["https://homosaurus.org/v3/homoit0000794","https://homosaurus.org/v3/homoit0001351"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianSurvivorsOfSexualAbuse"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000785","dc:identifier":"homoit0000785","skos:prefLabel":"Lesbian survivors of war","rdfs:comment":"Lesbians who have experienced and survived war; follow the individual's preference for \"victims\" or \"survivors\" whenever possible.","skos:broader":["https://homosaurus.org/v3/homoit0000795","https://homosaurus.org/v3/homoit0001352"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianSurvivorsOfWar"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000786","dc:identifier":"homoit0000786","skos:prefLabel":"Lesbian youth","skos:altLabel":["Lesbian teenagers","Lesbian adolescents","Lesbian teens"],"rdfs:comment":"Lesbians who are between the ages of childhood and adulthood.","skos:broader":["https://homosaurus.org/v3/homoit0000556","https://homosaurus.org/v3/homoit0001521"],"skos:narrower":"https://homosaurus.org/v3/homoit0000743","skos:related":["https://homosaurus.org/v3/homoit0000729","https://homosaurus.org/v3/homoit0000744","https://homosaurus.org/v3/homoit0000798"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh95001078"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianYouth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000787","dc:identifier":"homoit0000787","skos:prefLabel":"Lesbian television","rdfs:comment":"Television shows featuring lesbian characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0001359","skos:related":"https://homosaurus.org/v3/homoit0000753","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007002902"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001359"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianTelevision"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000788","dc:id