rimination","Anti-Two-Spirited discrimination"],"rdfs:comment":"The unjust or prejudicial treatment of Two-Spirit people due to their identity; may include the denial of legal rights, employment, and housing.","skos:broader":"https://homosaurus.org/v3/homoit0000356","skos:related":["https://homosaurus.org/v3/homoit0000112","https://homosaurus.org/v3/homoit0000920","https://homosaurus.org/v3/homoit0003158","https://homosaurus.org/v3/homoit0003737"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000356"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-17"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001886","dc:identifier":"homoit0001886","skos:prefLabel":"Lesbian wheelchair users","rdfs:comment":"Lesbians who use wheelchairs.","skos:broader":"https://homosaurus.org/v3/homoit0001877","skos:related":"https://homosaurus.org/v3/homoit0001880","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001887","dc:identifier":"homoit0001887","skos:prefLabel":"Gay wheelchair users","rdfs:comment":"Gay men who use wheelchairs.","skos:broader":"https://homosaurus.org/v3/homoit0001877","skos:related":"https://homosaurus.org/v3/homoit0001881","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001888","dc:identifier":"homoit0001888","skos:prefLabel":"Bisexual wheelchair users","rdfs:comment":"Bisexual people who use wheelchairs.","skos:broader":"https://homosaurus.org/v3/homoit0001877","skos:related":"https://homosaurus.org/v3/homoit0001882","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001889","dc:identifier":"homoit0001889","skos:prefLabel":"Transgender wheelchair users","rdfs:comment":"Transgender people who use wheelchairs.","skos:broader":"https://homosaurus.org/v3/homoit0001877","skos:related":"https://homosaurus.org/v3/homoit0001883","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001890","dc:identifier":"homoit0001890","skos:prefLabel":"Queer wheelchair users","rdfs:comment":"Queer people who use wheelchairs.","skos:broader":"https://homosaurus.org/v3/homoit0001877","skos:related":"https://homosaurus.org/v3/homoit0001884","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001891","dc:identifier":"homoit0001891","skos:prefLabel":"Crip","rdfs:comment":"A shortened form of the word \"cripple\" that has been reclaimed by disabled people to express pride and identify their political and community ties. Only use in reference to individuals or organizations that self-identify as crip. Because of the many intersections between crip theory/culture and queer theory/culture, the two are often but not always viewed as related.","skos:broader":"https://homosaurus.org/v3/homoit0001559","skos:related":["https://homosaurus.org/v3/homoit0001149","https://homosaurus.org/v3/homoit0001854","https://homosaurus.org/v3/homoit0001878","https://homosaurus.org/v3/homoit0001879","https://homosaurus.org/v3/homoit0002577"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001317"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001892","dc:identifier":"homoit0001892","skos:prefLabel":"Transmisogyny","rdfs:comment":"The intersection of transphobia and misogyny as directed toward trans women and transfeminine people.","skos:narrower":"https://homosaurus.org/v3/homoit0003158","skos:related":["https://homosaurus.org/v3/homoit0000062","https://homosaurus.org/v3/homoit0000112","https://homosaurus.org/v3/homoit0001017","https://homosaurus.org/v3/homoit0001467","https://homosaurus.org/v3/homoit0001903","https://homosaurus.org/v3/homoit0001904","https://homosaurus.org/v3/homoit0002273","https://homosaurus.org/v3/homoit0002274"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001892"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001893","dc:identifier":"homoit0001893","skos:prefLabel":"Anti-intersex discrimination","rdfs:comment":"The unjust or prejudicial treatment of intersex people due to the fact that they are intersex; may include the denial of legal rights, employment, and housing.","skos:broader":"https://homosaurus.org/v3/homoit0000356","skos:related":["https://homosaurus.org/v3/homoit0000112","https://homosaurus.org/v3/homoit0000666","https://homosaurus.org/v3/homoit0003737"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2016001192"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000356"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001894","dc:identifier":"homoit0001894","skos:prefLabel":"Neophallus","rdfs:comment":"A surgically constructed penis; typically made using tissue grafts from other parts of the body.","skos:broader":["https://homosaurus.org/v3/homoit0000561","https://homosaurus.org/v3/homoit0001099"],"skos:related":["https://homosaurus.org/v3/homoit0001465","https://homosaurus.org/v3/homoit0001846","https://homosaurus.org/v3/homoit0001847","https://homosaurus.org/v3/homoit0001848","https://homosaurus.org/v3/homoit0001850","https://homosaurus.org/v3/homoit0001852"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001895","dc:identifier":"homoit0001895","skos:prefLabel":"Masquerading","rdfs:comment":"Term used in the 18th and 19th centuries to describe the act of dressing in disguise, often to emulate another gender. Only use in historical contexts.","skos:broader":"https://homosaurus.org/v3/homoit0000878","skos:related":["https://homosaurus.org/v3/homoit0000289","https://homosaurus.org/v3/homoit0000318","https://homosaurus.org/v3/homoit0000367","https://homosaurus.org/v3/homoit0001469"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh86000513"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001896","dc:identifier":"homoit0001896","skos:prefLabel":"Endosex","skos:altLabel":["Dyadic","Non-intersex","Perisex"],"rdfs:comment":"The state of individuals born with the sexual anatomy, reproductive system, and chromosomes associated with their assigned sex (i.e., not intersex).","skos:broader":"https://homosaurus.org/v3/homoit0001269","skos:related":["https://homosaurus.org/v3/homoit0001268","https://homosaurus.org/v3/homoit0001648","https://homosaurus.org/v3/homoit0001897"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001897","dc:identifier":"homoit0001897","skos:prefLabel":"Endosex people","skos:altLabel":["Dyadic people","Non-intersex people","Perisex people"],"rdfs:comment":"Individuals born with the sexual anatomy, reproductive system, and chromosomes associated with their assigned sex (i.e., people who are not intersex).","skos:related":["https://homosaurus.org/v3/homoit0001268","https://homosaurus.org/v3/homoit0001648","https://homosaurus.org/v3/homoit0001896"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001897"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001898","dc:identifier":"homoit0001898","skos:prefLabel":"Studs","rdfs:comment":"Masculine identity associated with Black lesbian communities in the United States.","skos:broader":["https://homosaurus.org/v3/homoit0000577","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001304"],"skos:related":["https://homosaurus.org/v3/homoit0000215","https://homosaurus.org/v3/homoit0000432","https://homosaurus.org/v3/homoit0000995"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001241"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001899","dc:identifier":"homoit0001899","skos:prefLabel":"Gender ambiguity","rdfs:comment":"Gender expression that does not conform to a single, distinct gender identity.","skos:broader":"https://homosaurus.org/v3/homoit0000568","skos:related":["https://homosaurus.org/v3/homoit0000560","https://homosaurus.org/v3/homoit0000577"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001900","dc:identifier":"homoit0001900","skos:prefLabel":"Reading (LGBTQ+ culture)","rdfs:comment":"Slang term used in drag and ballroom communities to describe the act of playfully or wittily insulting someone's appearance or behavior; described by drag queen Dorian Corey as \"the art form of the insult.\" ","skos:related":["https://homosaurus.org/v3/homoit0000092","https://homosaurus.org/v3/homoit0000370","https://homosaurus.org/v3/homoit0001233","https://homosaurus.org/v3/homoit0002192"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001900"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001901","dc:identifier":"homoit0001901","skos:prefLabel":"Passing (Sexuality)","skos:altLabel":["Passing (Sexual identity)","Passing (Sexual orientation)"],"rdfs:comment":"The ability of a person who is not heterosexual to \"pass,\" or be accepted or regarded as heterosexual by others. \"Passing\" has historically been used to describe an individual's ability to \"pass\" as a certain race or ethnicity, though the term was later appropriated by the LGBTQ+ community.","skos:related":["https://homosaurus.org/v3/homoit0001090","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001306"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001901"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001902","dc:identifier":"homoit0001902","skos:prefLabel":"Critical race theory","skos:altLabel":"CRT","rdfs:comment":"A multidiscplinary field of study and intellectual framework used by scholars and activists to examine the intersections of race, class, and law in the United States, as well as to challenge mainstream U.S. liberal approaches to racial justice. Key concepts of CRT include the argument that race is a social construct with no biological basis and that racism and disparate racial outcomes are the result of complex, changing, and often subtle social and institutional dynamics, rather than individuals' explicit and intentional prejudices.","skos:broader":"https://homosaurus.org/v3/homoit0001365","skos:related":["https://homosaurus.org/v3/homoit0001903","https://homosaurus.org/v3/homoit0002038","https://homosaurus.org/v3/homoit0002257","https://homosaurus.org/v3/homoit0002269"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2020008165"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001903","dc:identifier":"homoit0001903","skos:prefLabel":"Transmisogynoir","rdfs:comment":"Term coined by coined by Trudy of the womanist blog Gradient Lair to describe the intersection of transphobia, misogyny, and anti-Black racism as directed toward Black trans women.","skos:related":["https://homosaurus.org/v3/homoit0000062","https://homosaurus.org/v3/homoit0000112","https://homosaurus.org/v3/homoit0001017","https://homosaurus.org/v3/homoit0001467","https://homosaurus.org/v3/homoit0001892","https://homosaurus.org/v3/homoit0001902","https://homosaurus.org/v3/homoit0001904","https://homosaurus.org/v3/homoit0002038","https://homosaurus.org/v3/homoit0002257"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001903"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001904","dc:identifier":"homoit0001904","skos:prefLabel":"Misogynoir","rdfs:comment":"Term coined by scholar Moya Bailey to describe the intersection of misogyny and anti-Black racism as directed toward Black women.","skos:related":["https://homosaurus.org/v3/homoit0001017","https://homosaurus.org/v3/homoit0001892","https://homosaurus.org/v3/homoit0001903","https://homosaurus.org/v3/homoit0002038","https://homosaurus.org/v3/homoit0002257"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2020010021"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001904"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001905","dc:identifier":"homoit0001905","skos:prefLabel":"Zaps","rdfs:comment":"Popularized by the gay liberation group Gays Activists Alliance, zaps are public demonstrations focused on confronting or embarrassing specific politicians or public officials while calling attention to the liberation movement.","skos:broader":"https://homosaurus.org/v3/homoit0000851","skos:related":["https://homosaurus.org/v3/homoit0000007","https://homosaurus.org/v3/homoit0001026"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000006"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001906","dc:identifier":"homoit0001906","skos:prefLabel":"Drag performers","rdfs:comment":"Performers who dress and/or use makeup to produce, emphasize, and/or exaggerate traits associated with a certain gender, which may or may not be the gender the performer primarily identifies with.","skos:related":["https://homosaurus.org/v3/homoit0000367","https://homosaurus.org/v3/homoit0000370","https://homosaurus.org/v3/homoit0000373","https://homosaurus.org/v3/homoit0000375","https://homosaurus.org/v3/homoit0003359","https://homosaurus.org/v3/homoit0003360"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001906"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001907","dc:identifier":"homoit0001907","skos:prefLabel":"LGBTQ+ witches","skos:altLabel":"LGBTQ+ Wiccans","rdfs:comment":"LGBTQ+ practitioners of Wicca or other Pagan religions who self-identify as witches.","skos:broader":"https://homosaurus.org/v3/homoit0001069","skos:narrower":["https://homosaurus.org/v3/homoit0001908","https://homosaurus.org/v3/homoit0001909","https://homosaurus.org/v3/homoit0001910","https://homosaurus.org/v3/homoit0001911","https://homosaurus.org/v3/homoit0001912","https://homosaurus.org/v3/homoit0001913","https://homosaurus.org/v3/homoit0002985"],"skos:related":"https://homosaurus.org/v3/homoit0000596","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001908","dc:identifier":"homoit0001908","skos:prefLabel":"Lesbian witches","skos:altLabel":["Lesbian Wiccans","Witches (Lesbians)"],"rdfs:comment":"Lesbians who practice Wicca or other Pagan religions and self-identify as witches.","skos:broader":"https://homosaurus.org/v3/homoit0001907","skos:related":["https://homosaurus.org/v3/homoit0000596","https://homosaurus.org/v3/homoit0000761"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001909","dc:identifier":"homoit0001909","skos:prefLabel":"Gay witches","skos:altLabel":"Gay Wiccans","rdfs:comment":"Gay men who practice Wicca or other Pagan religions and self-identify as witches.","skos:broader":"https://homosaurus.org/v3/homoit0001907","skos:related":["https://homosaurus.org/v3/homoit0000516","https://homosaurus.org/v3/homoit0000596"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001910","dc:identifier":"homoit0001910","skos:prefLabel":"Bisexual witches","skos:altLabel":"Bisexual Wiccans","rdfs:comment":"Bisexual practitioners of Wicca or other Pagan religions who self-identify as witches.","skos:broader":"https://homosaurus.org/v3/homoit0001907","skos:related":["https://homosaurus.org/v3/homoit0000168","https://homosaurus.org/v3/homoit0000596"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001911","dc:identifier":"homoit0001911","skos:prefLabel":"Transgender witches","skos:altLabel":"Transgender Wiccans","rdfs:comment":"Transgender practitioners of Wicca or other Pagan religions who self-identify as witches.","skos:broader":"https://homosaurus.org/v3/homoit0001907","skos:related":["https://homosaurus.org/v3/homoit0000596","https://homosaurus.org/v3/homoit0001429"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001912","dc:identifier":"homoit0001912","skos:prefLabel":"Queer witches","skos:altLabel":"Queer Wiccans","rdfs:comment":"Queer practitioners of Wicca or other Pagan religions who self-identify as witches.","skos:broader":"https://homosaurus.org/v3/homoit0001907","skos:related":["https://homosaurus.org/v3/homoit0000596","https://homosaurus.org/v3/homoit0001193"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001913","dc:identifier":"homoit0001913","skos:prefLabel":"Intersex witches","skos:altLabel":"Intersex Wiccans","rdfs:comment":"Intersex practitioners of Wicca or other Pagan religions who self-identify as witches.","skos:broader":"https://homosaurus.org/v3/homoit0001907","skos:related":"https://homosaurus.org/v3/homoit0000596","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001914","dc:identifier":"homoit0001914","skos:prefLabel":"Two-Spirit identity","skos:altLabel":["2S identity","Two Spirit identity","Two Spirited identity","Two-Spirited identity"],"rdfs:comment":"Identity term used by Indigenous people in North America to reconnect with the multiple gender and sexual roles in Indigenous cultures.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":["https://homosaurus.org/v3/homoit0000098","https://homosaurus.org/v3/homoit0001037","https://homosaurus.org/v3/homoit0002581"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001915","dc:identifier":"homoit0001915","skos:prefLabel":"Monosexual people","skos:altLabel":"Monosexuals","rdfs:comment":"Individuals who are attracted to only one gender; includes gay people and straight people.","skos:related":["https://homosaurus.org/v3/homoit0000627","https://homosaurus.org/v3/homoit0000648","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001298","https://homosaurus.org/v3/homoit0001300","https://homosaurus.org/v3/homoit0001555","https://homosaurus.org/v3/homoit0001556"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001915"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001916","dc:identifier":"homoit0001916","skos:prefLabel":"Monogamous people","rdfs:comment":"Individuals who engage in sexual or romantic relationships with only one person at a time.","skos:related":["https://homosaurus.org/v3/homoit0001019","https://homosaurus.org/v3/homoit0001081","https://homosaurus.org/v3/homoit0001302","https://homosaurus.org/v3/homoit0001555","https://homosaurus.org/v3/homoit0001650","https://homosaurus.org/v3/homoit0001656"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001916"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001917","dc:identifier":"homoit0001917","skos:prefLabel":"Allosexual people","rdfs:comment":"Individuals who generally experience sexual attraction or the desire for partnered sexual experiences.","skos:related":["https://homosaurus.org/v3/homoit0001300","https://homosaurus.org/v3/homoit0001302","https://homosaurus.org/v3/homoit0001531","https://homosaurus.org/v3/homoit0001535"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001917"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001918","dc:identifier":"homoit0001918","skos:prefLabel":"Transgenderqueer identity","skos:altLabel":"Transgenderqueerness","rdfs:comment":"Identity term used to describe the intersection of trans identity and genderqueer identity.","skos:broader":"https://homosaurus.org/v3/homoit0000571","skos:related":["https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001668"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001919","dc:identifier":"homoit0001919","skos:prefLabel":"Polysexual people","skos:altLabel":"Polysexuals","rdfs:comment":"Individuals who experience sexual attraction to more than one gender; includes bisexual and pansexual people.","skos:broader":["https://homosaurus.org/v3/homoit0000108","https://homosaurus.org/v3/homoit0000915"],"skos:related":["https://homosaurus.org/v3/homoit0000204","https://homosaurus.org/v3/homoit0001558"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001920","dc:identifier":"homoit0001920","skos:prefLabel":"Non-binary identity","skos:altLabel":"Nonbinary identity","rdfs:comment":"Gender identity that exists outside of the gender binary; may be used as a specific gender identity or as an umbrella term in the Euro-American gender system for gender identities outside of the gender binary.","skos:broader":"https://homosaurus.org/v3/homoit0000571","skos:related":"https://homosaurus.org/v3/homoit0001048","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001921","dc:identifier":"homoit0001921","skos:prefLabel":"Genderqueer identity","skos:altLabel":"Genderqueerness","rdfs:comment":"Gender identity that does not conform to the gender binary and emphasizes alignment with queer politics.","skos:broader":"https://homosaurus.org/v3/homoit0000571","skos:related":["https://homosaurus.org/v3/homoit0000582","https://homosaurus.org/v3/homoit0001195","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001668"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001922","dc:identifier":"homoit0001922","skos:prefLabel":"Gender non-conforming identity","skos:altLabel":["Gender nonconforming identity","Gender-nonconforming identity"],"rdfs:comment":"Gender identity that does not conform to the gender binary, not to be confused with gender non-conforming practices engaged in by cisgender people.","skos:broader":"https://homosaurus.org/v3/homoit0000571","skos:related":["https://homosaurus.org/v3/homoit0000574","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001756","https://homosaurus.org/v3/homoit0002388"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007003716"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001923","dc:identifier":"homoit0001923","skos:prefLabel":"Demigender identity","rdfs:comment":"Umbrella term for gender identities that emphasize a partial connection to a certain gender or concept of gender.","skos:broader":"https://homosaurus.org/v3/homoit0000571","skos:related":["https://homosaurus.org/v3/homoit0000342","https://homosaurus.org/v3/homoit0000343","https://homosaurus.org/v3/homoit0001652","https://homosaurus.org/v3/homoit0001653"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001924","dc:identifier":"homoit0001924","skos:prefLabel":"Cissexuality","rdfs:comment":"Term used to describe people who identify with the sex they were assigned at birth.","skos:related":["https://homosaurus.org/v3/homoit0000273","https://homosaurus.org/v3/homoit0001925"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001924"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001925","dc:identifier":"homoit0001925","skos:prefLabel":"Cisgender identity","skos:altLabel":"Cis identity","rdfs:comment":"Term used to describe the identity of people who identify with the sex or gender they were assigned at birth.","skos:broader":"https://homosaurus.org/v3/homoit0000571","skos:related":["https://homosaurus.org/v3/homoit0000270","https://homosaurus.org/v3/homoit0000271","https://homosaurus.org/v3/homoit0000272","https://homosaurus.org/v3/homoit0001924"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001926","dc:identifier":"homoit0001926","skos:prefLabel":"Pansexuality","rdfs:comment":"Sexual identity used to describe sexual and/or romantic attraction to people of all genders.","skos:broader":["https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001298","https://homosaurus.org/v3/homoit0001558"],"skos:related":"https://homosaurus.org/v3/homoit0001073","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001927","dc:identifier":"homoit0001927","skos:prefLabel":"Agender identity","rdfs:comment":"Identity term used to describe people who do not have genders or who identify with genderlessness.","skos:broader":"https://homosaurus.org/v3/homoit0000571","skos:related":"https://homosaurus.org/v3/homoit0000021","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept