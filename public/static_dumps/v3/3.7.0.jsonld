"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002779","dc:identifier":"homoit0002779","skos:prefLabel":"Intersex biographies","rdfs:comment":"Written accounts of the lives of intersex people. For written accounts of intersex people's lives written by the subject, use \"Intersex autobiographies.\"","skos:broader":"https://homosaurus.org/v3/homoit0001614","skos:related":["https://homosaurus.org/v3/homoit0001749","https://homosaurus.org/v3/homoit0002778"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001614"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002780","dc:identifier":"homoit0002780","skos:prefLabel":"Asexual couples","rdfs:comment":"Partnerships in which both people are asexual.","skos:broader":"https://homosaurus.org/v3/homoit0000310","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001237"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002781","dc:identifier":"homoit0002781","skos:prefLabel":"Asexual daughters","rdfs:comment":"Daughters who identify as asexual.","skos:broader":"https://homosaurus.org/v3/homoit0000330","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002782","dc:identifier":"homoit0002782","skos:prefLabel":"Asexual disabled people","skos:altLabel":["Asexual people with disabilities","Disabled asexual people"],"rdfs:comment":"Asexual people who are disabled.","skos:broader":"https://homosaurus.org/v3/homoit0001854","skos:narrower":["https://homosaurus.org/v3/homoit0002664","https://homosaurus.org/v3/homoit0002783","https://homosaurus.org/v3/homoit0002784","https://homosaurus.org/v3/homoit0002785","https://homosaurus.org/v3/homoit0002787"],"skos:related":"https://homosaurus.org/v3/homoit0002786","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002783","dc:identifier":"homoit0002783","skos:prefLabel":"Asexual blind people","skos:altLabel":"Blind asexual people","rdfs:comment":"Asexual people with significant or total loss of vision.","skos:broader":["https://homosaurus.org/v3/homoit0000822","https://homosaurus.org/v3/homoit0002782"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002784","dc:identifier":"homoit0002784","skos:prefLabel":"Asexual Deaf people","skos:altLabel":"Deaf asexual people","rdfs:comment":"Asexual people with significant or total hearing loss. Some but not all Deaf people prefer to capitalize Deaf in recognition of the cultural and linguistic identity they share with other Deaf people.","skos:broader":["https://homosaurus.org/v3/homoit0001866","https://homosaurus.org/v3/homoit0002782"],"skos:related":"https://homosaurus.org/v3/homoit0002785","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002785","dc:identifier":"homoit0002785","skos:prefLabel":"Asexual hard of hearing people","rdfs:comment":"Asexual people with significant or total hearing loss who may or may not consider themselves d/Deaf.","skos:broader":["https://homosaurus.org/v3/homoit0001860","https://homosaurus.org/v3/homoit0002782"],"skos:related":"https://homosaurus.org/v3/homoit0002784","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002786","dc:identifier":"homoit0002786","skos:prefLabel":"Asexual people with chronic illnesses","skos:altLabel":"Chronically ill asexual people","rdfs:comment":"Asexual people who have long-term health conditions that require continued medical attention and/or significantly impact or limit daily life; some but not all people with chronic illnesses consider themselves disabled.","skos:broader":"https://homosaurus.org/v3/homoit0001879","skos:related":"https://homosaurus.org/v3/homoit0002782","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002787","dc:identifier":"homoit0002787","skos:prefLabel":"Asexual wheelchair users","rdfs:comment":"Asexual people who use wheelchairs.","skos:broader":["https://homosaurus.org/v3/homoit0001877","https://homosaurus.org/v3/homoit0002782"],"skos:hasTopConc