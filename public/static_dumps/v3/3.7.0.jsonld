urus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0000774","dc:identifier":"homoit0000774","skos:prefLabel":"Lesbian religious groups","skos:broader":"https://homosaurus.org/v3/homoit0000753","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001322"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000530"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianReligiousGroups"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-22"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000775","dc:identifier":"homoit0000775","skos:prefLabel":"Lesbian rights","rdfs:comment":"Legal, social, or ethical principles of freedom or entitlement held by lesbians.","skos:broader":"https://homosaurus.org/v3/homoit0000276","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000652"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000776","dc:identifier":"homoit0000776","skos:prefLabel":"Lesbian Roman Catholics","rdfs:comment":"Lesbians who are members of the Roman Catholic Church.","skos:broader":"https://homosaurus.org/v3/homoit0001244","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2018002746"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianRomanCatholics"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000777","dc:identifier":"homoit0000777","skos:prefLabel":"Lesbian sensibility","rdfs:comment":"A way of reading and looking at cultural texts (books, movies, television, magazines, etc.) through a lesbian lens, often including the appropriation of texts otherwise thought of as heterosexual.","skos:related":"https://homosaurus.org/v3/homoit0000533","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000777"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianSensibility"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000779","dc:identifier":"homoit0000779","skos:prefLabel":"Lesbian slang","rdfs:comment":"Colloquial or informal language related to lesbians or used by lesbians.","skos:broader":["https://homosaurus.org/v3/homoit0000382","https://homosaurus.org/v3/homoit0001317"],"skos:related":["https://homosaurus.org/v3/homoit0000215","https://homosaurus.org/v3/homoit0002288"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianSlang"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000780","dc:identifier":"homoit0000780","skos:prefLabel":"Lesbian sports clubs","rdfs:comment":"Groups of lesbians formed for the purpose of playing sports; includes professional and amateur sports clubs.","skos:broader":"https://homosaurus.org/v3/homoit0000950","skos:related":"https://homosaurus.org/v3/homoit0001930","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000836"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianSportsClubs"},