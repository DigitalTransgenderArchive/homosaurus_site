it0000175","https://homosaurus.org/v3/homoit0000518","https://homosaurus.org/v3/homoit0000763","https://homosaurus.org/v3/homoit0001198","https://homosaurus.org/v3/homoit0001434","https://homosaurus.org/v3/homoit0002803","https://homosaurus.org/v3/homoit0002933"],"skos:related":["https://homosaurus.org/v3/homoit0000006","https://homosaurus.org/v3/homoit0001905","https://homosaurus.org/v3/homoit0002657"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/activistsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000008","dc:identifier":"homoit0000008","skos:prefLabel":"LGBTQ+ actors","skos:altLabel":["Actors (LGBTQ)","Actresses (LGBTQ)","LGBTQ actors"],"rdfs:comment":"LGBTQ+ people who act in stage plays, movies, television shows, broadcasts, or other productions.","skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:narrower":"https://homosaurus.org/v3/homoit0003798","skos:related":["https://homosaurus.org/v3/homoit0000816","https://homosaurus.org/v3/homoit0002142"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQActors"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000009","dc:identifier":"homoit0000009","skos:prefLabel":"Adoptive parenthood","rdfs:comment":"The experience of being an adoptive parent to a child or children. An adoptive parent is the person or persons who become permanent parents through adoption with all the responsibilities therein.","skos:broader":"https://homosaurus.org/v3/homoit0000914","skos:related":["https://homosaurus.org/v3/homoit0000451","https://homosaurus.org/v3/homoit0000809"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000914"},"dc:replaces":{"@id":"http://homosaurus.org/v2/adoptiveParenthood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000914","dc:identifier":"homoit0000914","skos:prefLabel":"LGBTQ+ parenthood","skos:altLabel":["Parenting","LGBTQ parenthood"],"rdfs:comment":"The experiences of being an LGBTQ+ parent and the responsibilities involved.","skos:narrower":["https://homosaurus.org/v3/homoit0000009","https://homosaurus.org/v3/homoit0000116","https://homosaurus.org/v3/homoit0000811","https://homosaurus.org/v3/homoit0000812","https://homosaurus.org/v3/homoit0000839","https://homosaurus.org/v3/homoit0000866","https://homosaurus.org/v3/homoit0000871","https://homosaurus.org/v3/homoit0000905","https://homosaurus.org/v3/homoit0000945"],"skos:related":["https://homosaurus.org/v3/homoit0000347","https://homosaurus.org/v3/homoit0000420","https://homosaurus.org/v3/homoit0000583","https://homosaurus.org/v3/homoit0000809","https://homosaurus.org/v3/homoit0000819","https://homosaurus.org/v3/homoit0000870","https://homosaurus.org/v3/homoit0001001","https://homosaurus.org/v3/homoit0001074","https://homosaurus.org/v3/homoit0001075","https://homosaurus.org/v3/homoit0001093","https://homosaurus.org/v3/homoit0001176"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000914"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQParenthood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homos