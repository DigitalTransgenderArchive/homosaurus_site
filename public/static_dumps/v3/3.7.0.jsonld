":"https://homosaurus.org/v4/homoit0000404","dc:identifier":"homoit0000404","skos:prefLabel":"Eroticism","rdfs:comment":"The quality of being erotic, or causing sexual attraction, arousal, or desire. ","skos:narrower":["https://homosaurus.org/v3/homoit0000442","https://homosaurus.org/v3/homoit0001806"],"skos:related":["https://homosaurus.org/v3/homoit0001112","https://homosaurus.org/v3/homoit0001284","https://homosaurus.org/v3/homoit0001306"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/eroticism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000037","dc:identifier":"homoit0000037","skos:prefLabel":"Ali","rdfs:comment":"Tamil slur for effeminate gay man; directly translates to hermaphrodite.","skos:broader":["https://homosaurus.org/v3/homoit0000322","https://homosaurus.org/v3/homoit0001560"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ali"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000038","dc:identifier":"homoit0000038","skos:prefLabel":"Allies","rdfs:comment":"Individuals of a privileged social identity who support, stand in solidarity with, and work to advance the interests of marginalized groups they do not belong to.","skos:broader":"https://homosaurus.org/v3/homoit0000627","skos:related":["https://homosaurus.org/v3/homoit0000006","https://homosaurus.org/v3/homoit0000538","https://homosaurus.org/v3/homoit0000873","https://homosaurus.org/v3/homoit0003195","https://homosaurus.org/v3/homoit0003693"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000627"},"dc:replaces":{"@id":"http://homosaurus.org/v2/allies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000627","dc:identifier":"homoit0000627","skos:prefLabel":"Heterosexuals","skos:altLabel":["Heterosexual people","Straight people"],"rdfs:comment":"Individuals who are romantically and sexually attracted to members of the opposite sex or gender.","skos:narrower":["https://homosaurus.org/v3/homoit0000038","https://homosaurus.org/v3/homoit0000626","https://homosaurus.org/v3/homoit0000629","https://homosaurus.org/v3/homoit0000630","https://homosaurus.org/v3/homoit0002285"],"skos:related":["https://homosaurus.org/v3/homoit0000624","https://homosaurus.org/v3/homoit0000631","https://homosaurus.org/v3/homoit0001531","https://homosaurus.org/v3/homoit0001915"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93003546"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000627"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexuals"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000039","dc:identifier":"homoit0000039","skos:prefLabel":"Alyha","rdfs:comment":"In Native American Mohave tribes, people assigned male at birth who exhibit feminine traits and could become socially female, often serving as healers.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":["https://homosaurus.org/v3/homoit0000654","https://homosaurus.org/v3/homoit0001480"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/alyha"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000040","dc:identifier":"homoit0000040","skos:prefLabel":"Amazons","rdfs:comment":"Nation of all-female warriors in Greek mythology and Classical antiquity; from the Early Modern period, their name has become a term for woman warriors in general as well as a cultural symbol invoked in lesbian communities.","skos:broader":"https://homosaurus.org/v3/homoit0001509","skos:related":"https://homosaurus.org/v3/homoit0000556","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85004138"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/amazons"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000041","dc:identifier":"homoit0000041","skos:prefLabel":"Anal beads","rdfs:comment":"A sex toy used in anal play that consists of multiple attached spheres (or balls) that are continuously inserted through the anus into the rectum and then removed with varying speeds.","skos:broader":"https://homosaurus.org/v3/homoit0001266","skos:related":"https://homosaurus.org/v3/homoit0000081","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/analBeads"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001266","dc:ide