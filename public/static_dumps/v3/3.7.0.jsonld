.org/v2/childrenOfTransgenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000262","dc:identifier":"homoit0000262","skos:prefLabel":"Children of queer people","rdfs:comment":"Children who have one or more queer parent.","skos:broader":"https://homosaurus.org/v3/homoit0000260","skos:narrower":"https://homosaurus.org/v3/homoit0001334","skos:related":["https://homosaurus.org/v3/homoit0001176","https://homosaurus.org/v3/homoit0001194","https://homosaurus.org/v3/homoit0002583","https://homosaurus.org/v3/homoit0002588"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/childrenOfQueerPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000263","dc:identifier":"homoit0000263","skos:prefLabel":"Children's sexuality","rdfs:comment":"The sexual behavior of children, include children's sense of their sexual orientation.","skos:broader":"https://homosaurus.org/v3/homoit0001306","skos:related":"https://homosaurus.org/v3/homoit0000255","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001306"},"dc:replaces":{"@id":"http://homosaurus.org/v2/childrensSexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001306","dc:identifier":"homoit0001306","skos:prefLabel":"Sexuality","rdfs:comment":"Term used to describe the ways in which individuals experience a