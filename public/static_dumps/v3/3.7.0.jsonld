pt","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003277","dc:identifier":"homoit0003277","skos:prefLabel":"Arab non-binary people","skos:altLabel":["Arab nonbinary people","Non-binary Arab people","Non-binary Arabs","Nonbinary Arab people","Nonbinary Arabs"],"rdfs:comment":"Non-binary people who are from Arab countries and/or are descended from Arab peoples. Do not conflate with Muslim people.","skos:broader":"https://homosaurus.org/v3/homoit0002009","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003278","dc:identifier":"homoit0003278","skos:prefLabel":"Open marriage","rdfs:comment":"A form of consensual non-monogamy in which spouses agree to engage in sexual and/or romantic relationships with individuals other than their marriage partner, without regarding this as infidelity.","skos:broader":"https://homosaurus.org/v3/homoit0001651","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2003007086"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001636"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003279","dc:identifier":"homoit0003279","skos:prefLabel":"LGBTQ+ travel guides","skos:altLabel":["Guide books (LGBTQ)","LGBTQ+ guide books","LGBTQ+ travel guide books","Travel guide books (LGBTQ)","Travel guides (LGBTQ)"],"rdfs:comment":"Books or other resources of information about places designed for the use of LGBTQ+ visitors or tourists, typically to direct travelers to establishments or attractions that are owned by, open to, or frequented by LGBTQ+ people. LGBTQ+ travel guides may also direct travelers to safe houses or businesses in places where LGBTQ+ people are otherwise unsafe or criminalized, as well as locations commonly used for cruising, or picking up casual sex partners.","skos:broader":"https://homosaurus.org/v3/homoit0000956","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000956"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003280","dc:identifier":"homoit0003280","skos:prefLabel":"Central American Indigenous LGBTQ+ people","skos:altLabel":["Central American Indigenous people (LGBTQ)","Central American Native LGBTQ+ people","Central American Native people (LGBTQ)","Indigenous Central American LGBTQ+ people","LGBTQ+ Central American Indigenous people","LGBTQ+ Central American Native people"],"rdfs:comment":"People who are part of the Native peoples of Central America and self-identify as LGBTQ. Use more specific terms when available.","skos:broader":"https://homosaurus.org/v3/homoit0000886","skos:narrower":["https://homosaurus.org/v3/homoit0003281","https://homosaurus.org/v3/homoit0003282","https://homosaurus.org/v3/homoit0003283","https://homosaurus.org/v3/homoit0003284","https://homosaurus.org/v3/homoit0003285","https://homosaurus.org/v3/homoit0003286","https://homosaurus.org/v3/homoit0003287","https://homosaurus.org/v3/homoit0003288","https://homosaurus.org/v3/homoit0003289","https://homosaurus.org/v3/homoit0003290","https://homosaurus.org/v3/homoit0003291","https://homosaurus.org/v3/homoit0003292"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003281","dc:identifier":"homoit0003281","skos:prefLabel":"Central American Indigenous asexual people","skos:altLabel":["Asexual Central American Indigenous people","Asexual Central American Native people","Central American Native asexual people","Indigenous Central American asexual people"],"rdfs:comment":"People who are part of the Native peoples of Central America and self-identify as asexual.","skos:broader":"https://homosaurus.org/v3/homoit0003280","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003282","dc:identifier":"homoit0003282","skos:prefLabel":"Central American Indigenous bisexual people","skos:altLabel":["Bisexual Central American Indigenous people","Bisexual Central American Native people","Central American Native bisexual people","Indigenous Central American bisexual people"],"rdfs:comment":"People who are part of the Native peoples of Central America and self-identify as bisexual.","skos:broader":"https://homosaurus.org/v3/homoit0003280","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003283","dc:identifier":"homoit0003283","skos:prefLabel":"Central American Indigenous gay men","skos:altLabel":["Central American Native gay men","Gay Central American Indigenous men","Gay Central American Native men","Indigenous Central American gay men"],"rdfs: