.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001205","dc:identifier":"homoit0001205","skos:prefLabel":"Queer relationships","rdfs:comment":"Ongoing connections (romantic, sexual, or platonic) between two or more queer people.","skos:broader":["https://homosaurus.org/v3/homoit0001237","https://homosaurus.org/v3/homoit0003826"],"skos:related":["https://homosaurus.org/v3/homoit0000182","https://homosaurus.org/v3/homoit0000529","https://homosaurus.org/v3/homoit0000773","https://homosaurus.org/v3/homoit0001442"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerRelationships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001206","dc:identifier":"homoit0001206","skos:prefLabel":"Queer rights","rdfs:comment":"Legal, social, or ethical principles of freedom or entitlement held by queer people.","skos:broader":"https://homosaurus.org/v3/homoit0000276","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000652"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001207","dc:identifier":"homoit0001207","skos:prefLabel":"Queer Roman Catholics","rdfs:comment":"Queer people who are members of the Roman Catholic Church.","skos:broader":"https://homosaurus.org/v3/homoit0001244","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerRomanCatholics"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modif