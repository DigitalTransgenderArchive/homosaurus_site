:identifier":"homoit0000877","skos:prefLabel":"LGBTQ+ health education","skos:altLabel":"LGBTQ health education","rdfs:comment":"Instruction about health for LGBTQ+ people, including topics such as gender-affirming healthcare and safer sex practices. ","skos:broader":"https://homosaurus.org/v3/homoit0000661","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000661"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQHealthEducation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000879","dc:identifier":"homoit0000879","skos:prefLabel":"LGBTQ+ unhoused people","skos:altLabel":["Unhoused people (LGBT)","LGBTQ+ homeless people","LGBTQ+ houseless people","LGBTQ+ unsheltered people"],"rdfs:comment":"LGBTQ+ people who do not have access to stable, safe, and adequate housing; includes people living in emergency shelters; transitional housing, and on the street.","skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:narrower":"https://homosaurus.org/v3/homoit0000880","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQHomelessPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000880","dc:identifier":"homoit0000880","skos:prefLabel":"LGBTQ+ unhoused youth","skos:altLabel":["LGBTQ+ homeless youth","LGBTQ+ unhoused adolescents","LGBTQ+ unhoused teenagers","LGBTQ+ unsheltered youth"],"rdfs:comment":"LGBTQ+ people between the ages of childhood and adulthood who do not have access to stable, safe, and adequate housing; includes youth living in emergency shelters, transitional housing, and on the street.","skos:broader":["https://homosaurus.org/v3/homoit0000879","https://homosaurus.org/v3/homoit0001521"],"skos:related":"https://homosaurus.org/v3/homoit0002460","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQHomelessYouth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000881","dc:identifier":"homoit0000881","skos:prefLabel":"LGBTQ+ hotels","skos:altLabel":"LGBTQ hotels","rdfs:comment":"Establishments providing accommodations, meals, and other services for travelers; use in reference to hotels catering to LGBTQ+ people or commonly used by LGBTQ+ people.","skos:narrower":"https://homosaurus.org/v3/homoit0000929","skos:related":"https://homosaurus.org/v3/homoit0000956","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000881"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQHotels"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000882","dc:identifier":"homoit0000882","skos:prefLabel":"LGBTQIA","rdfs:comment":"Acronym used to describe describe lesbians, gay people, bisexuals, transgender people, queer people, intersex people, and asexual people as a group.","skos:narrower":["https://homosaurus.org/v3/homoit0000804","https://homosaurus.org/v3/homoit0000806"],"skos:related":["https://homosaurus.org/v3/homoit0000004","https://homosaurus.org/v3/homoit0000143","https://homosaurus.org/v3/homoit0000485","https://homosaurus.org/v3/homoit0000672","https://homosaurus.org/v3/homoit0000733","https://homosaurus.org/v3/homoit0001170","https://homosaurus.org/v3/homoit0001403"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000882"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQIA"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000883","dc:identifier":"homoit0000883","skos:prefLabel":"LGBTQ+ immigration rights","skos:altLabel":"LGBTQ immigration rights","rdfs:comment":"Legal and social entitlement to freedom, equality, and protection held by LGBTQ+ immigrants.","skos:broader":"https://homosaurus.org/v3/homoit0000712","skos:related":["https://homosaurus.org/v3/homoit0000348","https://homosaurus.org/v3/homoit0000927","https://homosaurus.org/v3/homoit0001053","https://homosaurus.org/v3/homoit0001092","https://homosaurus.org/v3/homoit0001482","https://homosaurus.org/v3/homoit0001815","https://homosaurus.org/v3/homoit0001853"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQImmigrationRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000884","dc:identifier":"homoit0000884","skos:prefLabel":"LGBTQ+ imprisonment","skos:altLabel":"LGBTQ imprisonment","rdfs:comment":"Confinement, including physical and/or legal restraint, of LGBTQ+ people by an institution or authority. Typically used to describe confinement to a public or private prison that is sentenced by a court within a penal system.","skos:broader":"https://homosaurus.org/v3/homoit0000348","skos:related":"https://homosaurus.org/v3/homoit0000887","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000348"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQImprisonment"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000885","dc:identifier":"homoit0000885","skos:prefLabel":"LGBTQ+ incest victims","skos:altLabel":["LGBTQ victims of incest","LGBTQ incest victims"],"rdfs:comment":"LGBTQ+ people who have experienced incest and may or may not have survived; follow individuals' preference for \"victims\" or \"survivors\" whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000959","skos:narrower":"https://homosaurus.org/v3/homoit0002062","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQIncestVictims"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000886","dc:identifier":"homoit0000886","skos:prefLabel":"Indigenous LGBTQ+ people","skos:altLabel":["Indigenous people (LGBTQ)","LGBTQ+ Indigenous people"],"rdfs:comment":"LGBTQ+ people who are part of an Indigenous people, or culturally distinct ethnic group whose members are directly descended from the earliest known inhabitants of a particular region and, to some extent, maintain the language and culture of those people. Only use to describe people who identify as Indigenous; use more specific terms whenever possible.","skos:broader":["https://homosaurus.org/v3/homoit0001101","https://homosaurus.org/v3/homoit0000860"],"skos:narrower":["https://homosaurus.org/v3/homoit0000002","https://homosaurus.org/v3/homoit0000676","https://homosaurus.org/v3/homoit0000898","https://homosaurus.org/v3/homoit0000913","https://homosaurus.org/v3/homoit0001037","https://homosaurus.org/v3/homoit0001809","https://homosaurus.org/v3/homoit0001955","https://homosaurus.org/v3/homoit0001968","https://homosaurus.org/v3/homoit0001969","https://homosaurus.org/v3/homoit0001970","https://homosaurus.org/v3/homoit0001971","https://homosaurus.org/v3/homoit0001972","https://homosaurus.org/v3/homoit0001973","https://homosaurus.org/v3/homoit0002922","https://homosaurus.org/v3/homoit0003232","https://homosaurus.org/v3/homoit0003280","https://homosaurus.org/v3/homoit0003293","https://homosaurus.org/v3/homoit0003333","https://homosaurus.org/v3/homoit0001812","https://homosaurus.org/v3/homoit0001480"],"skos:related":["https://homosaurus.org/v3/homoit0001240","https://homosaurus.org/v3/homoit0002377","https://homosaurus.org/v3/homoit0000322"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQIndigenousPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000887","dc:identifier":"homoit0000887","skos:prefLabel":"LGBTQ+ prisoners","skos:altLabel":["LGBTQ inmates","Prisoners (LGBTQ)","LGBTQ prisoners"],"rdfs:comment":"LGBTQ+ people who are deprived of their liberty against their will by an institution or authority. Typically used to describe individuals sentenced to confinement in a public or private prison by a court within a penal system, but may also include people forcibly confined to hospitals and other institutions.","skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:narrower":"https://homosaurus.org/v3/homoit0000924","skos:related":["https://homosaurus.org/v3/homoit0000348","https://homosaurus.org/v3/homoit0000884"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPrisoners"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000888","dc:identifier":"homoit0000888","skos:prefLabel":"LGBTQ+ Internet forums","skos:altLabel":"LGBTQ Internet forums","rdfs:comment":"Websites that facilitate online conversations between LGBTQ+ people, often about LGBQ+ issues.","skos:broader":["https://homosaurus.org/v3/homoit0000665","https://homosaurus.org/v3/homoit0000946"],"skos:related":"https://homosaurus.org/v3/homoit0000962","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001321"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQInternetForums"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000889","dc:identifier":"homoit0000889","skos:prefLabel":"LGBTQ+ intimacy","skos:altLabel":"LGBTQ intimacy","rdfs:comment":"Feelings of close familiarity or connection between two or more LGBTQ+ people that can be romantic, sexual, or platonic in nature. Can be used to describe the particularities of intimacy as experienced by LGBTQ+ people, as well as the ways intimacy is discussed and expressed within LGBTQ+ communities.","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000889"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQIntimacy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0000890","dc:identifier":"homoit0000890","skos:prefLabel":"LGBTQ+ Judaism","skos:altLabel":"LGBTQ Judaism","rdfs:comment":"Jewish religion and culture as practiced by LGBTQ+ people","skos:broader":"https://homosaurus.org/v3/homoit0000928","skos:narrower":"https://homosaurus.org/v3/homoit0000046","skos:related":"https://homosaurus.org/v3/homoit0000682","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000682"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQJudaism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-10-04"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000891","dc:identifier":"homoit0000891","skos:prefLabel":"LGBTQ+ literary awards","skos:altLabel":"LGBTQ literary awards","rdfs:comment":"Prizes or forms of recognition given in honor of influential LGBTQ+ writers or literary works featuring LGBTQ+ characters and themes.","skos:broader":"https://homosaurus.org/v3/homoit0000818","skos:related":"https://homosaurus.org/v3/homoit0000972","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000818"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQLiteraryAwards"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000892","dc:identifier":"homoit0000892","skos:prefLabel":"LGBTQ+ literary salons","skos:altLabel":"LGBTQ literary salons","rdfs:comment":"Social gatherings, typically hosted by a notable public figure, for discussing literature or other shared topics; use in reference to literary salons with primarily LGBTQ+ membership or literary salons focused on works featuring LGBTQ+ characters and themes.","skos:related":["https://homosaurus.org/v3/homoit0000909","https://homosaurus.org/v3/homoit0000972"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000892"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQLiterarySalons"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000893","dc:identifier":"homoit0000893","skos:prefLabel":"LGBTQ+ lobbying","skos:altLabel":"LGBTQ lobbying","rdfs:comment":"Actions taken by individuals or groups to influence legislative action (or non-action), policies, or decisions of government officials in favor of LGBTQ+ people, communities, or issues.","skos:broader":"https://homosaurus.org/v3/homoit0000853","skos:related":"https://homosaurus.org/v3/homoit0000702","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQLobbying"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000894","dc:identifier":"homoit0000894","skos:prefLabel":"LGBTQ+ love","skos:altLabel":["LGBTQ love","Love (LGBTQ)"],"rdfs:comment":"Strong feelings of affection arising out of kinship, personal ties, or intimate relationships between two or more LGBTQ+ people. Can be used to describe the particularities of love as experienced by LGBTQ+ people in a given culture, as well as the ways love is discussed and expressed within LGBTQ+ communities.","skos:broader":"https://homosaurus.org/v3/homoit0003826","skos:narrower":["https://homosaurus.org/v3/homoit0000921","https://homosaurus.org/v3/homoit0000957"],"skos:related":["https://homosaurus.org/v3/homoit0000976","https://homosaurus.org/v3/homoit0001237"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQLove"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000895","dc:identifier":"homoit0000895","skos:prefLabel":"LGBTQ+ lovers","skos:altLabel":["Lovers (LGBTQ)","LGBTQ lovers"],"rdfs:comment":"LGBTQ+ people engaging in sexual or romantic relationships with other people; typically used to describe people who are not married.","skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:related":["https://homosaurus.org/v3/homoit0000458","https://homosaurus.org/v3/homoit0001083","https://homosaurus.org/v3/homoit0001302","https://homosaurus.org/v3/homoit0001311"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQLovers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000896","dc:identifier":"homoit0000896","skos:prefLabel":"LGBTQ+ magazines","skos:altLabel":"LGBTQ magazines","rdfs:comment":"Print or digital publications about LGBTQ+ people and LGBTQ+ issues (typically produced by LGBTQ+ people or LGBTQ+ organizations) that contain articles, photographs, and illustrations, and advertisements.","skos:broader":["https://homosaurus.org/v3/homoit0001132","https://homosaurus.org/v3/homoit0001830"],"skos:related":["https://homosaurus.org/v3/homoit0000177","https://homosaurus.org/v3/homoit0000521","https://homosaurus.org/v3/homoit0000766","https://homosaurus.org/v3/homoit0000965","https://homosaurus.org/v3/homoit0001041","https://homosaurus.org/v3/homoit0001042","https://homosaurus.org/v3/homoit0001436"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQMagazines"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000897","dc:identifier":"homoit0000897","skos:prefLabel":"LGBTQ+ manga","skos:altLabel":"LGBTQ manga","rdfs:comment":"Japanese comics or graphic novels focused on LGBTQ+ people or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000841","skos:related":["https://homosaurus.org/v3/homoit0002144","https://homosaurus.org/v3/homoit0002172"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQMangas"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000898","dc:identifier":"homoit0000898","skos:prefLabel":"Takatāpui","skos:altLabel":["LGBTQ+ Māori people","Māori (LGBTQ)","Māori LGBTQ+ people"],"rdfs:comment":"Term used by the Māori people, or people who are part of the Indigenous Polynesian people of mainland Aotearoa (New Zealand), that was historically used to describe an \"intimate companion of the same sex.\" In the 1980s, the term was reclaimed for use by lesbian, gay, bisexual, transgender, queer, intersex people, and other members of Rainbow communities. Only use to refer to individuals who identify as Takatāpui.","skos:broader":["https://homosaurus.org/v3/homoit0000322","https://homosaurus.org/v3/homoit0000886","https://homosaurus.org/v3/homoit0001297"],"skos:related":"https://homosaurus.org/v3/homoit0001810","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/takatapui"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000899","dc:identifier":"homoit0000899","skos:prefLabel":"LGBTQ+ marketing","skos:altLabel":"LGBTQ marketing","rdfs:comment":"Marketing strategies and campaigns specifically targeting LGBTQ+ people.","skos:related":["https://homosaurus.org/v3/homoit0001117","https://homosaurus.org/v3/homoit0002191"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000899"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQMarketing"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000901","dc:identifier":"homoit0000901","skos:prefLabel":"LGBTQ+ memorials","skos:altLabel":"LGBTQ memorials","rdfs:comment":"Projects, events, monuments, and sculptures created to memorialize or celebrate LGBTQ+ people, communities, or events.","skos:narrower":"https://homosaurus.org/v3/homoit0001408","skos:related":["https://homosaurus.org/v3/homoit0000028","https://homosaurus.org/v3/homoit0000029","https://homosaurus.org/v3/homoit0002260"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000901"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQMemorials"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000902","dc:identifier":"homoit0000902","skos:prefLabel":"LGBTQ+ migrants","skos:altLabel":["Migrants (LGBTQ)","LGBTQ migrants"],"rdfs:comm