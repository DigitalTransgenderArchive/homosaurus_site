s"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000013","dc:identifier":"homoit0000013","skos:prefLabel":"LGBTQ+ porn films","skos:altLabel":["Adult films (LGBTQ)","Porn videos (LGBTQ)","X-rated films (LGBTQ)","Porn films (LGBTQ)"],"rdfs:comment":"Erotic or sexually explicit films featuring LGBTQ+ people.","skos:broader":["https://homosaurus.org/v3/homoit0002579","https://homosaurus.org/v3/homoit0003802"],"skos:narrower":["https://homosaurus.org/v3/homoit0000176","https://homosaurus.org/v3/homoit0000520","https://homosaurus.org/v3/homoit0000765","https://homosaurus.org/v3/homoit0001199","https://homosaurus.org/v3/homoit0001435","https://homosaurus.org/v3/homoit0002559","https://homosaurus.org/v3/homoit0002573"],"skos:related":["https://homosaurus.org/v3/homoit0000014","https://homosaurus.org/v3/homoit0000869","https://homosaurus.org/v3/homoit0001126","https://homosaurus.org/v3/homoit0002544","https://homosaurus.org/v3/homoit0002555","https://homosaurus.org/v3/homoit0002634","https://homosaurus.org/v3/homoit0003798"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pornFilmsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001345","dc:identifier":"homoit0001345","skos:prefLabel":"Subcultures","rdfs:comment":"Groups of people belonging to cultures that differentiate them from the larger culture to which they belong. Subcultures develop their own norms and values regarding cultural, political, and sexual matters.","skos:narrower":["https://homosaurus.org/v3/homoit000009