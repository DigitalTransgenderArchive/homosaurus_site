 people who are transgender. Use only for individuals who self-identity as Black. Follow the individual’s preference for African American or Black whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000208","skos:narrower":["https://homosaurus.org/v3/homoit0001384","https://homosaurus.org/v3/homoit0001385","https://homosaurus.org/v3/homoit0001386","https://homosaurus.org/v3/homoit0001387","https://homosaurus.org/v3/homoit0001388"],"skos:related":"https://homosaurus.org/v3/homoit0002399","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderBlackPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001397","dc:identifier":"homoit0001397","skos:prefLabel":"Transgender bookshops","rdfs:comment":"Bookshops that sell materials intended for use by transgender people or addressing topics related to transgender experiences.","skos:broader":"https://homosaurus.org/v3/homoit0000216","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000216"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderBookshops"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001398","dc:identifier":"homoit0001398","skos:prefLabel":"Transgender Buddhists","rdfs:comment":"Transgender people who are Buddhist.","skos:broader":"https://homosaurus.org/v3/homoit0000225","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderBuddhists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001399","dc:identifier":"homoit0001399","skos:prefLabel":"Transgender characters","rdfs:comment":"Characters in creative works who are transgender.","skos:broader":"https://homosaurus.org/v3/homoit0000249","skos:related":["https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001400"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000249"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderCharacters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001400","dc:identifier":"homoit0001400","skos:prefLabel":"Transgender children","rdfs:comment":"Transgender people who have not yet reached the age of adolescence.","skos:broader":["https://homosaurus.org/v3/homoit0000256","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001452"],"skos:narrower":["https://homosaurus.org/v3/homoit0001407","https://homosaurus.org/v3/homoit0001446"],"skos:related":["https://homosaurus.org/v3/homoit0001138","https://homosaurus.org/v3/homoit0001399","https://homosaurus.org/v3/homoit0001415","https://homosaurus.org/v3/homoit0003502","https://homosaurus.org/v3/homoit0003514"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008003689"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderChildren"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001401","dc:identifier":"homoit0001401","skos:prefLabel":"Transgender Christians","rdfs:comment":"Transgender people who are Christian.","skos:broader":"https://homosaurus.org/v3/homoit0000265","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007003726"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderChristians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001402","dc:identifier":"homoit0001402","skos:prefLabel":"Transgender clergy","rdfs:comment":"Transgender people who are ordained for religious duties, particularly in the Christian Church.","skos:broader":"https://homosaurus.org/v3/homoit0001624","skos:related":["https://homosaurus.org/v3/homoit0000142","https://homosaurus.org/v3/homoit0000244","https://homosaurus.org/v3/homoit0000484","https://homosaurus.org/v3/homoit0000732","https://homosaurus.org/v3/homoit0001169"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001624"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderClergy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001403","dc:identifier":"homoit0001403","skos:prefLabel":"Transgender community","rdfs:comment":"Groups of people who share the experience of being transgender.","skos:broader":"https://homosaurus.org/v3/homoit0000297","skos:related":["https://homosaurus.org/v3/homoit0000594","https://homosaurus.org/v3/homoit0000804","https://homosaurus.org/v3/homoit0000805","https://homosaurus.org/v3/homoit0000806","https://homosaurus.org/v3/homoit0000807","https://homosaurus.org/v3/homoit0000882","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001780","https://homosaurus.org/v3/homoit0001789","https://homosaurus.org/v3/homoit0003708"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderCommunity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001404","dc:identifier":"homoit0001404","skos:prefLabel":["Transgender community centers","Transgender community centres"],"rdfs:comment":"Spaces in which people from transgender communities meet for social, education, recreational, or organizing activities.","skos:broader":"https://homosaurus.org/v3/homoit0000298","skos:related":"https://homosaurus.org/v3/homoit0001378","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderCommunityCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001405","dc:identifier":"homoit0001405","skos:prefLabel":"Transgender couples","rdfs:comment":"Partnerships in which both people are transgender.","skos:broader":"https://homosaurus.org/v3/homoit0000310","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderCouples"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001406","dc:identifier":"homoit0001406","skos:prefLabel":"Transgender culture","rdfs:comment":"Cultural experiences shared by members of transgender communities or products of transgender culture (e.g., art and media created by and for transgender people, activism focused on transgender issues, slang commonly used in transgender communities, etc.).","skos:broader":"https://homosaurus.org/v3/homoit0001831","skos:narrower":"https://homosaurus.org/v3/homoit0001445","skos:related":["https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001832","https://homosaurus.org/v3/homoit0001833"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderCulture"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001407","dc:identifier":"homoit0001407","skos:prefLabel":"Transgender daughters","rdfs:comment":"Daughters who identify as transgender.","skos:broader":["https://homosaurus.org/v3/homoit0000330","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001400"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderDaughters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001408","dc:identifier":"homoit0001408","skos:prefLabel":"Transgender Day of Remembrance","skos:altLabel":["TDOR","TDoR","Trans Day of Remembrance"],"rdfs:comment":"International day of observance recognized annually on November 20 to honor the memory and lives of trans people who were murdered in the previous 12 months and to draw attention to the continued violence against trans people. Transgender Day of Remembrance (abbreviated TDoR) was founded in 1999 by a small group of trans people, including Gwendolyn Ann Smith, to memorialize Rita Hester, a trans woman murdered in Allston, Massachusetts.","skos:broader":"https://homosaurus.org/v3/homoit0000901","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2017004815"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000901"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderDayOfRemembrance"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001409","dc:identifier":"homoit0001409","skos:prefLabel":["Transgender information centers","Transgender information centres"],"skos:altLabel":"Transgender documentation centers","rdfs:comment":"Institutions providing education, support, and information about transgender issues and transgender communities to transgender people.","skos:broader":"https://homosaurus.org/v3/homoit0000660","skos:related":["https://homosaurus.org/v3/homoit0001423","https://homosaurus.org/v3/homoit0001463"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderInformationCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001410","dc:identifier":"homoit0001410","skos:prefLabel":"Transgender dominatrices","rdfs:comment":"Women who take a dominant role in BDSM activities; use for dominatrices who identify as transgender.","skos:broader":"https://homosaurus.org/v3/homoit0000363","skos:related":["https://homosaurus.org/v3/homoit0000148","https://homosaurus.org/v3/homoit0000738","https://homosaurus.org/v3/homoit0001175"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001637"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderDominatrices"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001411","dc:identifier":"homoit0001411","skos:prefLabel":"Transgender drama","rdfs:comment":"Works of fiction written to be performed; use in reference to dramatic works focusing on transgender characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000376","skos:related":"https://homosaurus.org/v3/homoit0001727","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderDrama"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001412","dc:identifier":"homoit0001412","skos:prefLabel":"Transgender families","rdfs:comment":"Families, whether biological, adoptive, or chosen, in which one or more individuals identify as transgender.","skos:broader":"https://homosaurus.org/v3/homoit0000420","skos:related":["https://homosaurus.org/v3/homoit0000261","https://homosaurus.org/v3/homoit0001430","https://homosaurus.org/v3/homoit0002587"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001413","dc:identifier":"homoit0001413","skos:prefLabel":"Transgender fathers","rdfs:comment":"Transgender people who are fathers.","skos:broader":["https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001430","https://homosaurus.org/v3/homoit0002337"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderFathers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001414","dc:identifier":"homoit0001414","skos:prefLabel":"Transgender fiction","rdfs:comment":"Written works describing imagined events or people; use in reference to fictional works focusing on transgender characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000443","skos:related":["https://homosaurus.org/v3/homoit0001727","https://homosaurus.org/v3/homoit0001752","https://homosaurus.org/v3/homoit0001753","https://homosaurus.org/v3/homoit0001754","https://homosaurus.org/v3/homoit0002210","https://homosaurus.org/v3/homoit0002211"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderFiction"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001415","dc:identifier":"homoit0001415","skos:prefLabel":"Transgender identity","rdfs:comment":"Identity term used to describe people who cross or transgress the  gender they were assigned at birth.","skos:broader":"https://homosaurus.org/v3/homoit0000571","skos:related":["https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001400","https://homosaurus.org/v3/homoit0001563"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007005095"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001416","dc:identifier":"homoit0001416","skos:prefLabel":"Jewish transgender people","skos:altLabel":"Transgender Jews","rdfs:comment":"Transgender people who are Jewish.","skos:broader":"https://homosaurus.org/v3/homoit0000682","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2009010821"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderJews"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001417","dc:identifier":"homoit0001417","skos:prefLabel":"Latino/a/x transgender people","skos:altLabel":["Latina transgender people","Latine transgender people","Latino transgender people","Latinx transgender people","Transgender Latinas","Transgender Latine people","Transgender Latinos","Transgender Latinx people"],"rdfs:comment":"Latin American people who are transgender; only use to describe individuals who self-identify as Latino, Latina, or Latinx. Do not conflate with Chicano/a/x or Hispanic.","skos:broader":"https://homosaurus.org/v3/homoit0000253","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:r