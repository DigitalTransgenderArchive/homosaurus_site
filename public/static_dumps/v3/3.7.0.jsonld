it0000556","https://homosaurus.org/v3/homoit0001783"],"skos:related":["https://homosaurus.org/v3/homoit0000285","https://homosaurus.org/v3/homoit0000286","https://homosaurus.org/v3/homoit0000295","https://homosaurus.org/v3/homoit0001065","https://homosaurus.org/v3/homoit0001261","https://homosaurus.org/v3/homoit0001784","https://homosaurus.org/v3/homoit0001785","https://homosaurus.org/v3/homoit0002905"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/closetedLesbians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000288","dc:identifier":"homoit0000288","skos:prefLabel":"Stealth (Transgender)","skos:altLabel":"Stealth","rdfs:comment":"Term used to describe the experience of a trans person who is not openly trans and is choosing to pass as cisgender.","skos:related":["https://homosaurus.org/v3/homoit0000078","https://homosaurus.org/v3/homoit0000295","https://homosaurus.org/v3/homoit0000560","https://homosaurus.org/v3/homoit0001065","https://homosaurus.org/v3/homoit0001090","https://homosaurus.org/v3/homoit0001261","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001781","https://homosaurus.org/v3/homoit0001783","https://homosaurus.org/v3/homoit0001784","https://homosaurus.org/v3/homoit0001785","https://homosaurus.org/v3/homoit0001786","https://homosaurus.org/v3/homoit0001787"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000288"},"dc:replaces":{"@id":"http://homosaurus.org/v2/stealthTransgender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.o