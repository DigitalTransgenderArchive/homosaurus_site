"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002224","dc:identifier":"homoit0002224","skos:prefLabel":"Parents of LGBTQ+ people","skos:altLabel":["LGBTQ people's parents","LGBTQ+ people's parents","Parents of LGBTQ people"],"rdfs:comment":"Individuals who have one or more LGBTQ+ child.","skos:broader":"https://homosaurus.org/v3/homoit0002372","skos:narrower":["https://homosaurus.org/v3/homoit0000173","https://homosaurus.org/v3/homoit0000509","https://homosaurus.org/v3/homoit0000802","https://homosaurus.org/v3/homoit0001077","https://homosaurus.org/v3/homoit0001078","https://homosaurus.org/v3/homoit0002225","https://homosaurus.org/v3/homoit0002742","https://homosaurus.org/v3/homoit0002910"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh90005864"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-19"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002225","dc:identifier":"homoit0002225","skos:prefLabel":"Parents of non-binary people","skos:altLabel":["Non-binary people's parents","Nonbinary people's parents","Parents of nonbinary people"],"rdfs:comment":"Individuals who have one or more non-binary child.","skos:broader":"https://homosaurus.org/v3/homoit0002224","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-19"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002226","dc:identifier":"homoit0002226","skos:prefLabel":"LGBTQ+ people with substance use disorders","skos:altLabel":["Drug addicts (LGBTQ)","LGBTQ+ drug addicts","LGBTQ+ people with drug addictions","People with substance abuse disorders (LGBTQ)"],"rdfs:comment":"LGBTQ+ people who have been diagnosed with or regard themselves as having a substance use disorder, a medical condition that involves a pattern of substance use that is difficult to control, negatively impacts the individual's life, and results in withdrawal symptoms upon cessation. Only use to refer to individuals who describe themselves as having a substance use disorder. Follow the individual's preference for \"use disorder\" or \"addiction\" whenever possible.","skos:broader":["https://homosaurus.org/v3/homoit0000915","https://homosaurus.org/v3/homoit0001550"],"skos:related":"https://homosaurus.org/v3/homoit0000380","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-19"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002227","dc:identifier":"homoit0002227","skos:prefLabel":"LGBTQ+ people in recovery groups","skos:altLabel":["LGBTQ people in recovery groups","LGBTQ+ people in 12 step programs","People in recovery groups (LGBTQ)"],"rdfs:comment":"LGBTQ+ people who are members of recovery groups, or voluntary associations of people in recovery from use disorders, conditions, or addictions.","skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:related":"https://homosaurus.org/v3/homoit0001551","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-19"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002228","dc:identifier":"homoit0002228","skos:prefLabel":"LGBTQ+ people practicing sobriety","skos:altLabel":["LGBTQ+ sober people","Sober LGBTQ+ people","Sober people (LGBTQ)","Sobriety (LGBTQ)"],"rdfs:comment":"LGBTQ+ people intentionally refraining from substance use (typically drugs or alcohol). Follow the individual's preference for \"sobriety\" or \"recovery\" whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:related":"https://homosaurus.org/v3/homoit0001551","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-19"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002229","dc:identifier":"homoit0002229","skos:prefLabel":"LGBTQ+ people who use substances for medical purposes","skos:altLabel":"People who use substances for medical purposes (LGBTQ)","rdfs:comment":"LGBTQ+ people who use substances (that are typically deemed harmful or are subject to legal restriction, such as drugs or alcohol) in order to manage pain and other symptoms related to a medical condition or disability.","skos:broader":"https://homosaurus.org/v3/homoit0000379","skos:related":["https://homosaurus.org/v3/homoit0000380","https://homosaurus.org/v3/homoit0001854","https://homosaurus.org/v3/homoit0001879"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-19"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002230","dc:identifier":"homoit0002230","skos:prefLabel":"Fairies (Gay culture)","skos:altLabel":"Fairy (Gay culture)","rdfs:comment":"Pejorative term used chiefly in North America to describe gay men (or men assumed to be gay) and insult their perceived femininity. Some gay men have reclaimed this term and use it to describe themselves. Not to be confused with Faeries, the queer spiritual group.","skos:broader":["https://homosaurus.org/v3/homoit0000878","https://homosaurus.org/v3/homoit0001559","https://homosaurus.org/v3/homoit0001560"],"skos:related":["https://homosaurus.org/v3/homoit0000415","https://homosaurus.org/v3/homoit0000487","https://homosaurus.org/v3/homoit0000535"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-20"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002231","dc:identifier":"homoit0002231","skos:prefLabel":"Gujarati LGBTQ+ people","skos:altLabel":["Gujarati people (LGBTQ)","Gujaratis (LGBTQ)","LGBTQ+ Gujarati people","LGBTQ+ Gujaratis"],"rdfs:comment":"LGBTQ+ people who reside in or are descended from those indigenous to the Indian state of Gujarat.","skos:broader":["https://homosaurus.org/v3/homoit0000860","https://homosaurus.org/v3/homoit0001101"],"skos:narrower":["https://homosaurus.org/v3/homoit0002232","https://homosaurus.org/v3/homoit0002233","https://homosaurus.org/v3/homoit0002234","https://homosaurus.org/v3/homoit0002235","https://homosaurus.org/v3/homoit0002236","https://homosaurus.org/v3/homoit0002237","https://homosaurus.org/v3/homoit0002238","https://homosaurus.org/v3/homoit0003408"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-20"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002232","dc:identifier":"homoit0002232","skos:prefLabel":"Gujarati lesbians","skos:altLabel":"Lesbian Gujaratis","rdfs:comment":"Lesbians who reside in or are descended from those indigenous to the Indian state of Gujarat.","skos:broader":"https://homosaurus.org/v3/homoit0002231","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-20"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002233","dc:identifier":"homoit0002233","skos:prefLabel":"Gujarati gay men","skos:altLabel":["Gay Gujarati men","Gay Gujaratis"],"rdfs:comment":"Gay men who reside in or are descended from those indigenous to the Indian state of Gujarat.","skos:broader":"https://homosaurus.org/v3/homoit0002231","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-20"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002234","dc:identifier":"homoit0002234","skos:prefLabel":"Gujarati bisexual people","skos:altLabel":["Bisexual Gujarati people","Bisexual Gujaratis"],"rdfs:comment":"Bisexual people who reside in or are descended from those indigenous to the Indian state of Gujarat.","skos:broader":"https://homosaurus.org/v3/homoit0002231","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-20"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002235","dc:identifier":"homoit0002235","skos:prefLabel":"Gujarati transgender people","skos:altLabel":["Trangender Gujaratis","Transgender Gujarati people"],"rdfs:comment":"Transgender people who reside in or are desce