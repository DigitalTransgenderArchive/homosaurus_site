S.","skos:broader":"https://homosaurus.org/v3/homoit0000007","skos:related":["https://homosaurus.org/v3/homoit0000005","https://homosaurus.org/v3/homoit0000030","https://homosaurus.org/v3/homoit0001026"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93005197"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/AIDSActivists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000025","dc:identifier":"homoit0000025","skos:prefLabel":"AIDS awareness","rdfs:comment":"Activism and other efforts to bring attention to the AIDS epidemic.","skos:related":["https://homosaurus.org/v3/homoit0000005","https://homosaurus.org/v3/homoit0000034"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000025"},"dc:replaces":{"@id":"http://homosaurus.org/v2/AIDSAwareness"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000026","dc:identifier":"homoit0000026","skos:prefLabel":["AIDS information centers","AIDS information centres"],"rdfs:comment":"Institutions dedicated to education, prevention, and treatment of HIV/AIDS; AIDS information centers often provide services like HIV counseling and testing services.","skos:broader":"https://homosaurus.org/v3/homoit0000660","skos:related":"https://homosaurus.org/v3/homoit0000005","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2021005736"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/AIDSInformationCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000830","dc:identifier":"homoit0000830","skos:prefLabel":["LGBTQ+ centers","LGBTQ+ centres"],"rdfs:comment":"Spaces dedicated for use by members of LGBTQ+ communities engaging in various activities, including education, health and wellness services, community support and outreach, etc. Use a more specific term if possible.","skos:narrower":["https://homosaurus.org/v3/homoit0000298","https://homosaurus.org/v3/homoit0000660","https://homosaurus.org/v3/homoit0000876","https://homosaurus.org/v3/homoit0000964"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000027","dc:identifier":"homoit0000027","skos:prefLabel":"AIDS education","rdfs:comment":"Instruction about HIV/AIDS, including topics like the history of the AIDS epidemic, contraction, prevention, and treatment.","skos:broader":"https://homosaurus.org/v3/homoit0000661","skos:related":["https://homosaurus.org/v3/homoit0000005","https://homosaurus.org/v3/homoit0001251","https://homosaurus.org/v3/homoit0001271","https://homosaurus.org/v3/homoit0001294"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2009114510"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000661"},"dc:replaces":{"@id":"http://homosaurus.org/v2/AIDSEducation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000661","dc:identifier":"homoit0000661","skos:prefLabel":"Information provision","rdfs:comment":"Process by which information is provided to individuals or communities.","skos:narrower":["https://homosaurus.org/v3/homoit0000027","https://homosaurus.org/v3/homoit0000877","https://homosaurus.org/v3/homoit0001271"],"skos:related":["https://homosaurus.org/v3/homoit0000660","https://homosaurus.org/v3/homoit0003617"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000661"},"dc:replaces":{"@id":"http://homosaurus.org/v2/informationProvision"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000028","dc:identifier":"homoit0000028","skos:prefLabel":"AIDS memorial quilts","rdfs:comment":"Quilts created to celebrate the lives of people who have died of AIDS-related causes, bring awareness to the AIDS epidemic, and provide support and healing for those affected. The term is often used to refer to the NAMES Project AIDS Memorial Quilt started by Cleve Jones in 1985.","skos:broader":"https://homosaurus.org/v3/homoit0000029","skos:related":["https://homosaurus.org/v3/homoit0000005","https://homosaurus.org/v3/homoit0000901"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh90005342"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/AIDSMemorialQuilts"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001004","dc:identifier":"homoit0001004","skos:prefLabel":"Medical care","rdfs:comment":"Organized measures taken for the maintenance or improvement of health via the prevention, diagnosis, treatment, or cure of disease, illness, injury, or other condition.","skos:narrower":["https://homosaurus.org/v3/homoit0000029","https://homosaurus.org/v3/homoit0000561","https://homosaurus.org/v3/homoit0001006","https://homosaurus.org/v3/homoit0001366"],"skos:related":["https://homosaurus.org/v3/homoit0000364","https://homosaurus.org/v3/homoit0001005","https://homosaurus.org/v3/homoit0002844"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85082871"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/medicalCare"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000029","dc:identifier":"homoit0000029","skos:prefLabel":"AIDS memorials","rdfs:comment":"Projects and events celebrating the lives of people who have died of AIDS-related causes.","skos:broader":"https://homosaurus.org/v3/homoit0001004","skos:narrower":"https://homosaurus.org/v3/homoit0000028","skos:related":["https://homosaurus.org/v3/homoit0000005","https://homosaurus.org/v3/homoit0000901"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/AIDSMemorials"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000030","dc:identifier":"homoit0000030","skos:prefLabel":["AIDS organizations","AIDS organisations"],"rdfs:comment":"Community-based groups or institutions that provide support and advocacy for people affected by HIV/AIDS.","skos:related":["https://homosaurus.org/v3/homoit0000005","https://homosaurus.org/v3/homoit0000024","https://homosaurus.org/v3/homoit0000031","https://homosaurus.org/v3/homoit0000614","https://homosaurus.org/v3/homoit0000836"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000030"},"dc:replaces":{"@id":"http://homosaurus.org/v2/AIDSOrganisations"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000031","dc:identifier":"homoit0000031","skos:prefLabel":"AIDS periodicals","rdfs:comment":"Print or digital publications published periodically and created by or for people with AIDS.","skos:broader":"https://homosaurus.org/v3/homoit0001830","skos:related":["https://homosaurus.org/v3/homoit0000005","https://homosaurus.org/v3/homoit0000030","https://homosaurus.org/v3/homoit0001132"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007100929"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/AIDSPeriodicals"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001830","dc:identifier":"homoit0001830","skos:prefLabel":"LGBTQ+ periodicals","skos:altLabel":["LGBTQ+ serials","Periodicals (LGBTQ)","Serials (LGBTQ)"],"rdfs:comment":"Publications or serials by or about LGBTQ+ people; use a more specific term if possible.","skos:narrower":["https://homosaurus.org/v3/homoit0000031","https://homosaurus.org/v3/homoit0000896","https://homosaurus.org/v3/homoit0001041","https://homosaurus.org/v3/homoit0001042"],"skos:related":["https://homosaurus.org/v3/homoit0000923","https://homosaurus.org/v3/homoit0000965","https://homosaurus.org/v3/homoit0001144"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001830"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000032","dc:identifier":"homoit0000032","skos:prefLabel":"AIDS phobia","skos:altLabel":["AIDSphobia","Fear of AIDS"],"rdfs:comment":"Antagonism or disgust directed toward individuals with HIV/AIDS or behaviors perceived as putting oneself at risk for contracting HIV/AIDS. AIDS phobia may include isolation, stereotypes, verbal harassment, and physical violence.","skos:related":["https://homosaurus.org/v3/homoit0000005","https://homosaurus.org/v3/homoit0000920"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88004490"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000032"},"dc:replaces":{"@id":"http://homosaurus.org/v2/AIDSPhobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000033","dc:identifier":"homoit0000033","skos:prefLabel":"ARC (AIDS-Related Complex)","skos:altLabel":["AIDS Related Complex","ARC"],"rdfs:comment":"Abbreviation for AIDS-related complex, a term used early in the AIDS epidemic to describe people with symptomatic HIV infections who have not been formally diagnosed with AIDS. Since 2000, clinical use of the term has been largely discontinued.","skos:broader":"https://homosaurus.org/v3/homoit0000005","skos:related":"https://homosaurus.org/v3/homoit0000686","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh86002565"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001308"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ARC"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000034","dc:identifier":"homoit0000034","skos:prefLabel":"Red ribbons (AIDS)","skos:altLabel":["AIDS ribbons","Red ribbons"],"rdfs:comment":"Red ribbon that acts as an international symbol for HIV and AIDS awareness; first adopted in the early 1990s for the Red Ribbon Project.","skos:broader":"https://homosaurus.org/v3/homoit0000954","skos:related":["https://homosaurus.org/v3/homoit0000005","https://homosaurus.org/v3/homoit0000025"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000954"},"dc:replaces":{"@id":"http://homosaurus.org/v2/redRibbons"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000954","dc:identifier":"homoit0000954","skos:prefLabel":"LGBTQ+ symbols","skos:altLabel":"LGBTQ symbols","rdfs:comment":"Characters, signs, or objects used to represent LGBTQ+ people, identities, communities, and/or specific historical events.","skos:narrower":["https://homosaurus.org/v3/homoit0000034","https://homosaurus.org/v3/homoit0000453","https://homosaurus.org/v3/homoit0000609","https://homosaurus.org/v3/homoit0000696","https://homosaurus.org/v3/homoit0000698","https://homosaurus.org/v3/homoit0001116","https://homosaurus.org/v3/homoit0003246"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000954"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSymbols"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https: