n love","skos:broader":"https://homosaurus.org/v3/homoit0000894","skos:related":"https://homosaurus.org/v3/homoit0001237","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85078519"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001365"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000894"},"dc:replaces":{"@id":"http://homosaurus.org/v2/beingInLove"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-10-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001365","dc:identifier":"homoit0001365","skos:prefLabel":"Theories","rdfs:comment":"Systems of ideas intended to explain a particular phenomenon.","skos:narrower":["https://homosaurus.org/v3/homoit0000115","https://homosaurus.org/v3/homoit0000408","https://homosaurus.org/v3/homoit0001219","https://homosaurus.org/v3/homoit0001320","https://homosaurus.org/v3/homoit0001902","https://homosaurus.org/v3/homoit0002039","https://homosaurus.org/v3/homoit0002272","https://homosaurus.org/v3/homoit0003515","https://homosaurus.org/v3/homoit0003520","https://homosaurus.org/v3/homoit0003616"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/theories"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000108","dc:identifier":"homoit0000108","skos:prefLabel":"Bi+ people","rdfs:comment":"Individuals who are not exclusively sexually and/or romantically attracted to individuals of a single biological sex (includes bisexual, queer, pansexual, and fluid identities).","skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:narrower":["https://homosaurus.org/v3/homoit0000170","https://homosaurus.org/v3/homoit0001073","https://homosaurus.org/v3/homoit0001195","https://homosaurus.org/v3/homoit0001919"],"skos:related":"https://homosaurus.org/v3/homoit0001297","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bi+People"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000109","dc:identifier":"homoit0000109","skos:prefLabel":"Hate crimes","skos:altLabel":"Bias-related crimes","rdfs:comment":"Criminal acts motivated by the victim’s actual or perceived race, nationality, religion, sexual identity, gender identity, or ability status.","skos:related":["https://homosaurus.org/v3/homoit0000052","https://homosaurus.org/v3/homoit0000056","https://homosaurus.org/v3/homoit0000058","https://homosaurus.org/v3/homoit0000061","https://homosaurus.org/v3/homoit0000063","https://homosaurus.org/v3/homoit0000112","https://homosaurus.org/v3/homoit0000341","https://homosaurus.org/v3/homoit0000613","https://homosaurus.org/v3/homoit0000641","https://homosaurus.org/v3/homoit0001769","https://homosaurus.org/v3/homoit0001770","https://homosaurus.org/v3/homoit0002900","https://homosaurus.org/v3/homoit0003787","https://homosaurus.org/v3/homoit0003788"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh90002645"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000109"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hateCrimes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000110","dc:identifier":"homoit0000110","skos:prefLabel":"Bigender identity","rdfs:comment":"Term used to describe the identities of people who have two genders.","skos:broader":"https://homosaurus.org/v3/homoit0000571","skos:related":["https://homosaurus.org/v3/homoit0000111","https://homosaurus.org/v3/homoit0000569"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bigenderIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000111","dc:identifier":"homoit0000111","skos:prefLabel":"Bigender people","rdfs:comment":"People who identify as any two genders, either simultaneously or more fluidly.","skos:broader":"https://homosaurus.org/v3/homoit0001378","skos:related":["https://homosaurus.org/v3/homoit0000110","https://homosaurus.org/v3/homoit0000570"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bigenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000112","dc:identifier":"homoit0000112","skos:prefLabel":"Intolerance towards LGBTQ+ people","skos:altLabel":["Bigotry towards LGBTQ people","Prejudice towards LGBTQ people","Intolerance towards LGBTQ people"],"rdfs:comment":"Unwillingness to accept or affirm LGBTQ+ people or their identities in attitude or practice.","skos:related":["https://homosaurus.org/v3/homoit0000109","https://homosaurus.org/v3/homoit0000341","https://homosaurus.org/v3/homoit0000356","https://homosaurus.org/v3/homoit0000643","https://homosaurus.org/v3/homoit0001015","https://homosaurus.org/v3/homoit0001017","https://homosaurus.org/v3/homoit0001561","https://homosaurus.org/v3/homoit0001885","https://homosaurus.org/v3/homoit0001892","https://homosaurus.org/v3/homoit0001893","https://homosaurus.org/v3/homoit0001903","https://homosaurus.org/v3/homoit0002899"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000112"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intoleranceTowardsLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000113","dc:identifier":"homoit0000113","skos:prefLabel":"Binabae","rdfs:comment":"Tagalog term for individuals who possess both male and female traits.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/binabae"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000114","dc:identifier":"homoit0000114","skos:prefLabel":"Binding (Chest)","rdfs:comment":"The act of flattening or concealing the chest area with a tight fitting shirt, strap, or similar material; often practiced by transgender men and transmasculine people.","skos:broader":"https://homosaurus.org/v3/homoit0000568","skos:related":["https://homosaurus.org/v3/homoit0000222","https://homosaurus.org/v3/homoit0000436","https://homosaurus.org/v3/homoit0001643","https://homosaurus.org/v3/homoit0001840","https://homosaurus.org/v3/homoit0001852","https://homosaurus.org/v3/homoit0003118","https://homosaurus.org/v3/homoit0003815"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bindingChest"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000115","dc:identifier":"homoit0000115","skos:prefLabel":"Essentialism","skos:altLabel":"Biological essentialism","rdfs:comment":"The practice of defining certain categories through a set of supposed universal or fixed characteristics or traits (e.g., defining women in terms of \"female\" genitalia).","skos:broader":"https://homosaurus.org/v3/homoit0001365","skos:narrower":"https://homosaurus.org/v3/homoit0003158","skos:related":["https://homosaurus.org/v3/homoit0001219","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001320","https://homosaurus.org/v3/homoit0003519"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85044919"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/essentialism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000116","dc:identifier":"homoit0000116","skos:prefLabel":"Biological parenthood","rdfs:comment":"The experience of being a biological parent to a child. This relationship can be genetic, gestational, or both.","skos:broader":["https://homosaurus.org/v3/homoit0000819","https://homosaurus.org/v3/homoit0000914"],"skos:narrower":["https://homosaurus.org/v3/homoit0000583","https://homosaurus.org/v3/homoit0000587"],"skos:related":["https://homosaurus.org/v3/homoit0000121","https://homosaurus.org/v3/homoit0000364","https://homosaurus.org/v3/homoit0000451","https://homosaurus.org/v3/homoit0001001","https://homosaurus.org/v3/homoit0001093","https://homosaurus.org/v3/homoit0002621","https://homosaurus.org/v3/homoit0002623"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/biologicalParenthood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000420","dc:identifier":"homoit0000420","skos:prefLabel":"LGBTQ+ families","skos:altLabel":"Families (LGBTQ)","rdfs:comment":"Families, whether biological, adoptive, or chosen, in which one or more individuals identify as LGBTQ+.","skos:narrower":["https://homosaurus.org/v3/homoit0000150","https://homosaurus.org/v3/homoit0000371","https://homosaurus.org/v3/homoit0000491","https://homosaurus.org/v3/homoit0000740","https://homosaurus.org/v3/homoit0000810","https://homosaurus.org/v3/homoit0000812","https://homosaurus.org/v3/homoit0000819","https://homosaurus.org/v3/homoit0000834","https://homosaurus.org/v3/homoit0000870","https://homosaurus.org/v3/homoit0000872","https://homosaurus.org/v3/homoit0000943","https://homosaurus.org/v3/homoit0001075","https://homosaurus.org/v3/homoit0001083","https://homosaurus.org/v3/homoit0001176","https://homosaurus.org/v3/homoit0001412","https://homosaurus.org/v3/homoit0001757","https://homosaurus.org/v3/homoit0001758","https://homosaurus.org/v3/homoit0001759","https://homosaurus.org/v3/homoit0002586"],"skos:related":["https://homosaurus.org/v3/homoit0000809","https://homosaurus.org/v3/homoit0000811","https://homosaurus.org/v3/homoit0000864","https://homosaurus.org/v3/homoit0000871","https://homosaurus.org/v3/homoit0000914","https://homosaurus.org/v3/homoit0000945","https://homosaurus.org/v3/homoit0001310","https://homosaurus.org/v3/homoit0002584","https://homosaurus.org/v3/homoit0002585"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/familiesLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000117","dc:identifier":"homoit0000117","skos:prefLabel":"Biphobia","rdfs:comment":"Antagonism or disgust directed toward bisexuality as an identity or bisexual people due to their sexuality. Biphobia can include denial of the existence of bisexuality, stereotypes, verbal harassment, and physical violence.","skos:broader":"https://homosaurus.org/v3/homoit0000920","skos:narrower":"https://homosaurus.org/v3/homoit0002592","skos:related":["https://homosaurus.org/v3/homoit0000051","https://homosaurus.org/v3/homoit0000052","https://homosaurus.org/v3/homoit0000170","https://homosaurus.org/v3/homoit0000619"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2012001037"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/biphobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000920","dc:identifier":"homoit0000920","skos:prefLabel":"LGBTQ+ phobia","skos:altLabel":"LGBTQ phobia","rdfs:comment":"Antagonism or disgust directed towards LGBTQ+ identities or people due to their sexuality or gender, perceived or actual. LGBTQ+ phobia can include denial of the existence of certain LGBTQ+ identities, stereotypes, verbal harassment, and physical violence.","skos:narrower":["https://homosaurus.org/v3/homoit0000117","https://homosaurus.org/v3/homoit0000565","https://homosaurus.org/v3/homoit0000646","https://homosaurus.org/v3/homoit0000666","https://homosaurus.org/v3/homoit0000803","https://homosaurus.org/v3/homoit0001229","https://homosaurus.org/v3/homoit0001467"],"skos:related":["https://homosaurus.org/v3/homoit0000032","https://homosaurus.org/v3/homoit0000228","https://homosaurus.org/v3/homoit0001885","https://homosaurus.org/v3/homoit0002590"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPhobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000118","dc:identifier":"homoit0000118","skos:prefLabel":"Birth certificate amendments","rdfs:comment":"Formal changes to an individual's birth certificate, typically to reflect a change to the individual's legal name or gender or sex marker.","skos:broader":"https://homosaurus.org/v3/homoit0000119","skos:related":["https://homosaurus.org/v3/homoit0000078","https://homosaurus.org/v3/homoit0000120","https://homosaurus.org/v3/homoit0000918"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/birthCertificateAmendments"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000712","dc:identifier":"homoit0000712","skos:prefLabel":"Legal status","rdfs:comment":"The status or standing of an individual or thing within a certain legal jurisdiction, including the individual's or thing's legal rights and privileges; typically used in reference to citizenship or marriage.","skos:narrower":["https://homosaurus.org/v3/homoit0000883","https://homosaurus.org/v3/homoit0001053","https://homosaurus.org/v3/homoit0001074","https://homosaurus.org/v3/homoit0001082","https://homosaurus.org/v3/homoit0001100"],"skos:related":["https://homosaurus.org/v3/homoit0000274","https://homosaurus.org/v3/homoit0000348","https://homosaurus.org/v3/homoit0000702","https://homosaurus.org/v3/homoit0000927","https://homosaurus.org/v3/homoit0000989","https://homosaurus.org/v3/homoit0001482"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh99004999"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/legalStatus"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000119","dc:identifier":"homoit0000119","skos:prefLabel":"Birth certificates","rdfs:comment":"Legal documents issued to record an individual’s birth, typically including identifying information such as the individual's name, assigned gender or sex, date and location of birth, and parentage.","skos:broader":"https://homosaurus.org/v3/homoit0001053","skos:narrower":["https://homosaurus.org/v3/homoit0000118","https://homosaurus.org/v3/homoit0000573"],"skos:related":["https://homosaurus.org/v3/homoit0000120","https://homosaurus.org/v3/homoit0000247","https://homosaurus.org/v3/homoit0000311","https://homosaurus.org/v3/homoit0000711","https://homosaurus.org/v3/homoit0001005","https://homosaurus.org/v3/homoit0001324","https://homosaurus.org/v3/homoit0001465"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85014366"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/birthCertificates"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000120","dc:identifier":"homoit0000120","skos:prefLabel":"Gender assigned at birth","skos:altLabel":["Birth gender","Natal gender","GAAB","Assigned gender at birth","AGAB","Designated gender at birth","DGAB","Gender at birth"],"rdfs:comment":"The legal gender marker recorded in birth-related certifications and registries. Often but not always used synonymously with “sex assigned at birth.\" Also used in reference to the gendered roles and expectations associated with said gender marker.","skos:broader":"https://homosaurus.org/v3/homoit0000078","skos:related":["https://homosaurus.org/v3/homoit0000118","https://homosaurus.org/v3/homoit0000119","https://homosaurus.org/v3/homoit0000271","https://homosaurus.org/v3/homoit0000567","https://homosaurus.org/v3/homoit0000573","https://homosaurus.org/v3/homoit0001268","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0002256"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderAssignedAtBirth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000121","dc:identifier":"homoit0000121","skos:prefLabel":"Birth parents","rdfs:comment":"Biological or genetic parents of a child or children placed for adoption.","skos:broader":["https://homosaurus.org/v3/homoit0000587","https://homosaurus.org/v3/homoit0002372"],"skos:narrower":"https://homosaurus.org/v3/homoit0000821","skos:related":["https://homosaurus.org/v3/homoit0000010","https://homosaurus.org/v3/homoit0000116","https://homosaurus.org/v3/homoit0000809","https://homosaurus.org/v3/homoit0000812","https://homosaurus.org/v3/homoit0000819","https://homosaurus.org/v3/homoit0000843"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85014394"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/birthParents"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000122","dc:identifier":"homoit0000122","skos:prefLabel":"Bisexual activism","rdfs:comment":"Direct action and organizing to achieve political or social change and acceptance for bisexuality.","skos:broader":"https://homosaurus.org/v3/homoit0000006","skos:related":["https://homosaurus.org/v3/homoit0000147","https://homosaurus.org/v3/homoit0000162","https://homosaurus.org/v3/homoit0000175","https://homosaurus.org/v3/homoit0000183"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualActivism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000123","dc:identifier":"homoit0000123","skos:prefLabel":"African American bisexual people","skos:altLabel":["Bisexual African American people","Bisexual African Americans"],"rdfs:comment":"Bisexual people of African descent born in the United States or bisexual people born in African countries who live in or have a strong connection to the United States. Use for individuals who self-identity as African American. Follow the individual’s preference for African American or Black whenever possible.","skos:broader":["https://homosaurus.org/v3/homoit0000015","https://homosaurus.org/v3/homoit0000135"],"skos:related":"https://homosaurus.org/v3/homoit0000365","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2003006883"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualAfricanAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000124","dc:identifier":"homoit0000124","skos:prefLabel":"Afro-Canadian bisexual people","skos:altLabel":["Bisexual Afro-Canadian people","Bisexual Afro-Canadians"],"rdfs:comment":"Bisexual people of African descent born in Canada or bisexual people born in African countries who live in or have a strong connection to Canada. Use for individuals who self-identify as Afro-Canadian.","skos:broader":["https://homosaurus.org/v3/homoit0000016","https://homosaurus.org/v3/homoit0000135"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualAfroCanadians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000125","dc:identifier":"homoit0000125","skos:prefLabel":"Afro-Caribbean bisexual people","skos:altLabel":["Bisexual Afro-Caribbean people","Bisexual Afro-Caribbeans"],"rdfs:comment":"Bisexual people of African descent born in the Caribbean or bisexual people born in African countries who live in or have a strong connection to the Caribbean. Only use for individuals who self-identify as Afro-Caribbean.","skos:broader":["https://homosaurus.org/v3/homoit0000017","https://homosaurus.org/v3/homoit0000135"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualAfroCaribbeans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000126","dc:identifier":"homoit0000126","skos:prefLabel":"Afro-European bisexual people","skos:altLabel":["Bisexual Afro-European people","Bisexual Afro-Europeans"],"rdfs:comment":"Bisexual people of African descent born in European countries or bisexual people born in African countries who live in or have a strong connection to Europe. Only use for individuals who self-identify as Afro-European.","skos:broader":["https://homosaurus.org/v3/homoit0000018","https://homosaurus.org/v3/homoit0000135"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualAfroEuropeans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000127","dc:identifier":"homoit0000127","skos:prefLabel":"Afro-Latin American bisexual people","skos:altLabel":"Bisexual Afro-Latin Americans","rdfs:comment":"Bisexual people of African descent born in Latin American countries or bisexual people born in African countries who live in or have a strong connection to Latin America. Only use for individuals who self-identify as Afro-Latin American.","skos:broader":["https://homosaurus.org/v3/homoit0000019","https://homosaurus.org/v3/homoit0000135"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualAfroLatinAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000128","dc:identifier":"homoit0000128","skos:prefLabel":"Bisexual archives","rdfs:comment":"Collections of records and materials relating to bisexual people or bisexual communities; can include a variety of organizations and institutions from community to government archives.","skos:broader":"https://homosaurus.org/v3/homoit0000066","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualArchives"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000129","dc:identifier":"homoit0000129","skos:prefLabel":"Bisexual artists","rdfs:comment":"Bisexual people who practice any of various creative arts.","skos:broader":"https://homosaurus.org/v3/homoit0000070","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualArtists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000130","dc:identifier":"homoit0000130","skos:prefLabel":"Asian American bisexual people","skos:altLabel":["Bisexual Asian American people","Bisexual Asian Americans"],"rdfs:comment":"Bisexual people of Asian heritage or descent born in the United States or born in Asian countries who live in or have a strong connection to the United States. Only use for individuals who self-identify as Asian American.","skos:broader":["https://homosaurus.org/v3/homoit0000073","https://homosaurus.org/v3/homoit0000131"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh98006060"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualAsianAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000131","dc:identifier":"homoit0000131","skos:prefLabel":"Asian bisexual people","skos:altLabel":["Bisexual Asian people","Bisexual Asians"],"rdfs:comment":"Bisexual people of Asian heritage or descent, living in Asia or part of the Asian diaspora. Only use for people who self-identify as Asian.","skos:broader":"https://homosaurus.org/v3/homoit0000074","skos:narrower":"https://homosaurus.org/v3/homoit0000130","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualAsians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000132","dc:identifier":"homoit0000132","skos:prefLabel":"Bisexual atheists","rdfs:comment":"Bisexual people who are atheists.","skos:broader":"https://homosaurus.org/v3/homoit0000082","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualAtheists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000133","dc:identifier":"homoit0000133","skos:prefLabel":"Bisexual bars","rdfs:comment":"Drinking establishments that primary cater to bisexual people.","skos:broader":"https://homosaurus.org/v3/homoit0000100","skos:related":"https://homosaurus.org/v3/homoit0000170","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualBars"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000134","dc:identifier":"homoit0000134","skos:prefLabel":"Bisexual beaches","rdfs:comment":"Beaches set aside for use by bisexual people or beaches known to be frequented by bisexual people.","skos:broader":"https://homosaurus.org/v3/homoit0000104","skos:related":"https://homosaurus.org/v3/homoit0000170","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualBeaches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000135","dc:identifier":"homoit0000135","skos:prefLabel":"Black bisexual people","skos:altLabel":"Bisexual Black people","rdfs:comment":"Black people who are bisexual. Use only for individuals who self-identity as Black. Follow the individual’s preference for African American or Black whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000208","skos:narrower":["https://homosaurus.org/v3/homoit0000123","https://homosaurus.org/v3/homoit0000124","https://homosaurus.org/v3/homoit0000125","https://homosaurus.org/v3/homoit0000126","https://homosaurus.org/v3/homoit0000127"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualBlackPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"ht