dividuals who self-identity as women and understand their gender in terms of Western conceptions of womanness, femaleness, and/or femininity.","skos:broader":["https://homosaurus.org/v3/homoit0000170","https://homosaurus.org/v3/homoit0001509"],"skos:narrower":"https://homosaurus.org/v3/homoit0001002","skos:related":"https://homosaurus.org/v3/homoit0001510","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002512"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualWomen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000203","dc:identifier":"homoit0000203","skos:prefLabel":"Bisexual youth literature","rdfs:comment":"Written literary works for an audience of readers from 12-18 years of age, also known as young adult literature or YA; use in reference to youth literature focusing on bisexual characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0001522","skos:related":"https://homosaurus.org/v3/homoit0000192","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualYouthLiterature"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000204","dc:identifier":"homoit0000204","skos:prefLabel":"Bisexuality","rdfs:comment":"Sexual identity that is defined as attraction to more than one gender; follow the individual's preference for bisexuality, pansexuality, or polysexuality whenever possible.","skos:broader":["https://homosaurus.org/v3/homoit0001298","https://homosaurus.org/v3/homoit0001558"],"skos:narrower":"https://homosaurus.org/v3/homoit0003445","skos:related":["https://homosaurus.org/v3/homoit0000170","https://homosaurus.org/v3/homoit0000647","https://homosaurus.org/v3/homoit0000799","https://homosaurus.org/v3/homoit0001919"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85014412"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000205","dc:identifier":"homoit0000205","skos:prefLabel":"Bissu","rdfs:comment":"Mentally and physically androgynous shamans in Bugis (Indonesia) culture.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bissu"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000206","dc:identifier":"homoit0000206","skos:prefLabel":"Biting","rdfs:comment":"Biting, or applying pressure with one's teeth, for the purposes of sexual arousal.","skos:broader":["https://homosaurus.org/v3/homoit0000593","https://homosaurus.org/v3/homoit0001299"],"skos:related":"https://homosaurus.org/v3/homoit0000211","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/biting"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000207","dc:identifier":"homoit0000207","skos:prefLabel":"Biza'ah","rdfs:comment":"Among the Zapotec in Teotitlán del Valle, Mexico, this term refers to people assigned male at birth who exhibit feminine characteristics.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bizaah"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000208","dc:identifier":"homoit0000208","skos:prefLabel":"Black LGBTQ+ people","skos:altLabel":["Black people (LGBTQ)","LGBTQ+ Black people"],"rdfs:comment":"Black people who are also LGBTQ+; do not use for people of color broadly; follow the individual's preference for Black or African American whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0001101","skos:narrower":["https://homosaurus.org/v3/homoit0000015","https://homosaurus.org/v3/homoit0000016","https://homosaurus.org/v3/homoit0000017","https://homosaurus.org/v3/homoit0000018","https://homosaurus.org/v3/homoit0000019","https://homosaurus.org/v3/homoit0000135","https://homosaurus.org/v3/homoit0000477","https://homosaurus.org/v3/homoit0000726","https://homosaurus.org/v3/homoit0001163","https://homosaurus.org/v3/homoit0001396","https://homosaurus.org/v3/homoit0001782","https://homosaurus.org/v3/homoit0002334","https://homosaurus.org/v3/homoit0002764","https://homosaurus.org/v3/homoit0003400"],"skos:related":["https://homosaurus.org/v3/homoit0001928","https://homosaurus.org/v3/homoit0002376","https://homosaurus.org/v3/homoit0002398","https://homosaurus.org/v3/homoit0002399"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2013002417"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/blackPeopleLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000209","dc:identifier":"homoit0000209","skos:prefLabel":"Blindfolds","rdfs:comment":"An accessory used to cover the eyes, traditionally a piece of cloth tied around one’s head to eliminate or limit vision.","skos:broader":["https://homosaurus.org/v3/homoit0001266","https://homosaurus.org/v3/homoit0003059"],"skos:related":["https://homosaurus.org/v3/homoit0003146","https://homosaurus.org/v3/homoit0003850"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2003009027"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/blindfolds"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000210","dc:identifier":"homoit0000210","skos:prefLabel":"Blogs","rdfs:comment":"Websites or webpages, typically run by individuals or small groups, that are written in an informal or conversational style.","skos:broader":"https://homosaurus.org/v3/homoit0001321","skos:narrower":"https://homosaurus.org/v3/homoit0000823","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2003004628"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001321"},"dc:replaces":{"@id":"http://homosaurus.org/v2/blogs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"