eNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002952","dc:identifier":"homoit0002952","skos:prefLabel":"Intersex wheelchair users","rdfs:comment":"Intersex people who use wheelchairs.","skos:broader":["https://homosaurus.org/v3/homoit0001877","https://homosaurus.org/v3/homoit0002929"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002953","dc:identifier":"homoit0002953","skos:prefLabel":"Intersex youth literature","skos:altLabel":["Intersex YA","Intersex young adult literature"],"rdfs:comment":"Written literary works for an audience of readers from 12-18 years of age, also known as young adult literature or YA; use in reference to youth literature focusing on intersex characters or themes.","skos:broader":["https://homosaurus.org/v3/homoit0001522","https://homosaurus.org/v3/homoit0002750"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002954","dc:identifier":"homoit0002954","skos:prefLabel":"Intersex-focused businesses","rdfs:comment":"Businesses focusing on intersex clientele and products related to intersex communities.","skos:broader":"https://homosaurus.org/v3/homoit0001741","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001741"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002955","dc:identifier":"homoit0002955","skos:prefLabel":"Intersex-owned businesses","rdfs:comment":"Businesses owned by intersex people.","skos:broader":"https://homosaurus.org/v3/homoit0001735","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001735"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002957","dc:identifier":"homoit0002957","skos:prefLabel":"Afro-Canadian intersex people","skos:altLabel":["Intersex Afro-Canadian people","Intersex Afro-Canadians"],"rdfs:comment":"Intersex people of African descent born in Canada or intersex people born in African countries who live in or have a strong connection to Canada. Use for individuals who self-identify as Afro-Canadian.","skos:broader":["https://homosaurus.org/v3/homoit0000016","https://homosaurus.org/v3/homoit0002764"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002958","dc:identifier":"homoit0002958","skos:prefLabel":"Afro-Caribbean intersex people","rdfs:comment":"Intersex people of African descent born in the Caribbean or intersex people born in African countries who live in or have a strong connection to the Caribbean. Only use for individuals who self-identify as Afro-Caribbean.","skos:broader":["https://homosaurus.org/v3/homoit0000017","https://homosaurus.org/v3/homoit0002764"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002959","dc:identifier":"homoit0002959","skos:prefLabel":"Afro-European intersex people","skos:altLabel":"Intersex Afro-Europeans","rdfs:comment":"Intersex people of African descent born in European countries or intersex people born in African countries who live in or have a strong connection to Europe. Only use for individuals who self-identify as Afro-European.","skos:broader":["https://homosaurus.org/v3/homoit0000018","https://homosaurus.org/v3/homoit0002764"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002960","dc:identifier":"homoit0002960","skos:prefLabel":"Afro-Latin American intersex people","skos:altLabel":["Afro-Latina intersex people","Afro-Latine intersex people","Afro-Latino intersex people","Afro-Latino/a/x intersex people","Afro-Latinx intersex people","Intersex Afro-Latin Americans","Intersex Afro-Latinas","Intersex Afro-Latine people","Intersex Afro-Latinos","Intersex Afro-Latinx people"],"rdfs:comment":"Intersex people of African descent born in Latin American countries or intersex people born in African countries who live in or have a strong connection to Latin America. Only use for individuals who self-identify as Afro-Latin American.","skos:broader":["https://homosaurus.org/v3/homoit0000019","https://homosaurus.org/v3/homoit0002764","https://homosaurus.org/v3/homoit0002769"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"