s://homosaurus.org/v4/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayVictimsRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000555","dc:identifier":"homoit0000555","skos:prefLabel":"White gay men","skos:altLabel":["Caucasian gay men","Gay Caucasian men","Gay white men"],"rdfs:comment":"Gay men who are white.","skos:broader":"https://homosaurus.org/v3/homoit0000243","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005020516"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000243"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayWhitePeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000556","dc:identifier":"homoit0000556","skos:prefLabel":"Lesbians","skos:altLabel":["Gay women","Lesbian women","Lesbian people"],"rdfs:comment":"Individuals who self-identify as lesbian and belong to lesbian communities. The term has been predominately used to describe women who are exclusively or primarily romantically and/or sexually attracted to other women. However, not all lesbians are women, and gender non-conforming people who belong to lesbian communities have often identified as lesbian.","skos:broader":["https://homosaurus.org/v3/homoit0000915","https://homosaurus.org/v3/homoit0001297"],"skos:narrower":["https://homosaurus.org/v3/homoit0000088","https://homosaurus.org/v3/homoit0000287","https://homosaurus.org/v3/homoit0000786","https://homosaurus.org/v3/homoit0000971","https://homosaurus.org/v3/homoit0001056","https://homosaurus.org/v3/homoit0003040"],"skos:related":["https://homosaurus.org/v3/homoit0000040","https://homosaurus.org/v3/homoit0000058","https://homosaurus.org/v3/homoit0000215","https://homosaurus.org/v3/homoit0000231","https://homosaurus.org/v3/homoit0000384","https://homosaurus.org/v3/homoit0000454","https://homosaurus.org/v3/homoit0000499","https://homosaurus.org/v3/homoit0000647","https://homosaurus.org/v3/homoit0000729","https://homosaurus.org/v3/homoit0000744","https://homosaurus.org/v3/homoit0000799","https://homosaurus.org/v3/homoit0000802","https://homosaurus.org/v3/homoit0000803","https://homosaurus.org/v3/homoit0001105","https://homosaurus.org/v3/homoit0001227","https://homosaurus.org/v3/homoit0001327","https://homosaurus.org/v3/homoit0001340","https://homosaurus.org/v3/homoit0001472","https://homosaurus.org/v3/homoit0001509","https://homosaurus.org/v3/homoit0001510","https://homosaurus.org/v3/homoit0002178"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85076160"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000557","dc:identifier":"homoit0000557","skos:prefLabel":"Gay youth literature","rdfs:comment":"Written literary works for an audience of readers from 12-18 years of age, also known as young adult literature or YA; use in reference to youth literature focusing on gay characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0001522","skos:related":["https://homosaurus.org/v3/homoit0000544","https://homosaurus.org/v3/homoit0002152"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayYouthLiterature"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000558","dc:identifier":"homoit0000558","skos:prefLabel":["LGBTQ+ neighborhoods","LGBTQ+ neighbourhoods"],"rdfs:comment":"Districts or portions of towns or cities that are (typically unofficial) social and/or residential centers for LGBTQ+ people and communities.","skos:related":"https://homosaurus.org/v3/homoit0000297","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000558"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQNeighbourhoods"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000559","dc:identifier":"homoit0000559","skos:prefLabel":"Gaydar","rdfs:comment":"Term describing a person's intuitive ability to identify others' sexual orientations.","skos:related":"https://homosaurus.org/v3/homoit0001298","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000559"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gaydar"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000561","dc:identifier":"homoit0000561","skos:prefLabel":"Gender affirming surgery","skos:altLabel":["Gender affirmation surgery","Gender confirmation surgery","Gender realignment surgery","Gender reassignment surgery","Sex reassignment surgery","SRS","Gender confirming surgery"],"rdfs:comment":"Any of various surgeries undertaken to affirm an individual's gender. Most often applied to transgender people, but may also refer to certain procedures undergone by cisgender and intersex people.","skos:broader":["https://homosaurus.org/v3/homoit0001004","https://homosaurus.org/v3/homoit0003657"],"skos:narrower":["https://homosaurus.org/v3/homoit0000584","https://homosaurus.org/v3/homoit0001040","https://homosaurus.org/v3/homoit0001837","https://homosaurus.org/v3/homoit0001840","https://homosaurus.org/v3/homoit0001842","https://homosaurus.org/v3/homoit0001843","https://homosaurus.org/v3/homoit0001894"],"skos:related":["https://homosaurus.org/v3/homoit0000560","https://homosaurus.org/v3/homoit0001049","https://homosaurus.org/v3/homoit0001129","https://homosaurus.org/v3/homoit0001131","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001381","https://homosaurus.org/v3/homoit0001464","https://homosaurus.org/v3/homoit0001465","https://homosaurus.org/v3/homoit0003504"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2020000651"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderConfirmingSurgery"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000562","dc:identifier":"homoit0000562","skos:prefLabel":"Gender bending","rdfs:comment":"The practice of transgressing or \"bending\" expected gender roles, which often involves adopting or exaggerating stereotypically feminine or masculine traits to expose them as artificial. Gender bending is similar to drag, though drag is often associated with artistic or stage performances, whereas gender bending is typically enacted in everyday life.","skos:broader":"https://homosaurus.org/v3/homoit0000568","skos:related":["https://homosaurus.org/v3/homoit0000047","https://homosaurus.org/v3/homoit0000577","https://homosaurus.org/v3/homoit0001756","https://homosaurus.org/v3/homoit0001816"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderBending"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000563","dc:identifier":"homoit0000563","skos:prefLabel":"Gender binaries","rdfs:comment":"Cultural conceptions of gender as two distinct and opposing categories, typically man and woman or masculine and feminine.","skos:related":["https://homosaurus.org/v3/homoit0000220","https://homosaurus.org/v3/homoit0000560","https://homosaurus.org/v3/homoit0000571","https://homosaurus.org/v3/homoit0000577","https://homosaurus.org/v3/homoit0000578","https://homosaurus.org/v3/homoit0000590","https://homosaurus.org/v3/homoit0001008","https://homosaurus.org/v3/homoit0001509","https://homosaurus.org/v3/homoit0002589"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000563"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderBinary"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000564","dc:identifier":"homoit0000564","skos:prefLabel":"Gender blending","rdfs:comment":"Gender expression that involves blending dress and behaviors associated with different genders. Do not use to describe the identities of genderqueer or non-binary people.","skos:broader":"https://homosaurus.org/v3/homoit0000568","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderBlending"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000565","dc:identifier":"homoit0000565","skos:prefLabel":"Genderism","skos:altLabel":"Gender discrimination","rdfs:comment":"The systematic belief that there are only two genders (men and women) and that individuals must conform to the gender they were assigned at or shortly after birth.","skos:broader":"https://homosaurus.org/v3/homoit0000920","skos:narrower":"https://homosaurus.org/v3/homoit0003158","skos:related":["https://homosaurus.org/v3/homoit0000560","https://homosaurus.org/v3/homoit0000571","https://homosaurus.org/v3/homoit0001278","https://homosaurus.org/v3/homoit0003519"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000566","dc:identifier":"homoit0000566","skos:prefLabel":"Gender diversity","rdfs:comment":"An umbrella term encompassing a range of gender identities.","skos:broader":"https://homosaurus.org/v3/homoit0000358","skos:related":["https://homosaurus.org/v3/homoit0000560","https://homosaurus.org/v3/homoit0000568","https://homosaurus.org/v3/homoit0000571","https://homosaurus.org/v3/homoit0001048","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001817"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000358"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderDiversity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000567","dc:identifier":"homoit0000567","skos:prefLabel":"Gender dysphoria","rdfs:comment":"A psychological diagnosis (replacing the outdated and offensive \"gender identity disorder\") used to describe the sense of unease or dissatisfaction an individual feels as a result of incongruence between their gender identity and their assigned gender, gender expression, and/or the way their gender is perceived by others. This term is also used colloquially by individuals to describe the discomfort and distress they experience as a result of this incongruence. Though gender dysphoria is often associated with trans people, people of any identity may experience gender dysphoria when they do not feel \"right\" in their body or the way their gender is being expressed.","skos:narrower":["https://homosaurus.org/v3/homoit0002699","https://homosaurus.org/v3/homoit0002700"],"skos:related":["https://homosaurus.org/v3/homoit0000120","https://homosaurus.org/v3/homoit0000567","https://homosaurus.org/v3/homoit0000568","https://homosaurus.org/v3/homoit0000571","https://homosaurus.org/v3/homoit0000572","https://homosaurus.org/v3/homoit0001006","https://homosaurus.org/v3/homoit0002256"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000567"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderDysphoria"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000568","dc:identifier":"homoit0000568","skos:prefLabel":"Gender expression","rdfs:comment":"Term used to describe the way individuals express their gender identity through their appearance and behaviors, including gestures, movement, dress, and grooming.","skos:broader":"https://homosaurus.org/v3/homoit0000560","skos:narrower":["https://homosaurus.org/v3/homoit0000047","https://homosaurus.org/v3/homoit0000114","https://homosaurus.org/v3/homoit0000289","https://homosaurus.org/v3/homoit0000318","https://homosaurus.org/v3/homoit0000366","https://homosaurus.org/v3/homoit0000367","https://homosaurus.org/v3/homoit0000389","https://homosaurus.org/v3/homoit0000395","https://homosaurus.org/v3/homoit0000562","https://homosaurus.org/v3/homoit0000564","https://homosaurus.org/v3/homoit0000576","https://homosaurus.org/v3/homoit0000606","https://homosaurus.org/v3/homoit0000995","https://homosaurus.org/v3/homoit0001067","https://homosaurus.org/v3/homoit0001469","https://homosaurus.org/v3/homoit0001476","https://homosaurus.org/v3/homoit0001496","https://homosaurus.org/v3/homoit0001756","https://homosaurus.org/v3/homoit0001790","https://homosaurus.org/v3/homoit0001816","https://homosaurus.org/v3/homoit0001820","https://homosaurus.org/v3/homoit0001821","https://homosaurus.org/v3/homoit0001852","https://homosaurus.org/v3/homoit0001899"],"skos:related":["https://homosaurus.org/v3/homoit0000105","https://homosaurus.org/v3/homoit0000231","https://homosaurus.org/v3/homoit0000321","https://homosaurus.org/v3/homoit0000326","https://homosaurus.org/v3/homoit0000440","https://homosaurus.org/v3/homoit0000566","https://homosaurus.org/v3/homoit0000567","https://homosaurus.org/v3/homoit0000571","https://homosaurus.org/v3/homoit0000577","https://homosaurus.org/v3/homoit0000581","https://homosaurus.org/v3/homoit0001063","https://homosaurus.org/v3/homoit0001145","https://homosaurus.org/v3/homoit0001148","https://homosaurus.org/v3/homoit0001479","https://homosaurus.org/v3/homoit0001508","https://homosaurus.org/v3/homoit0002256","https://homosaurus.org/v3/homoit0002589","https://homosaurus.org/v3/homoit0002699","https://homosaurus.org/v3/homoit0002700","https://homosaurus.org/v3/homoit0003066","https://homosaurus.org/v3/homoit0003126"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2011002609"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderExpression"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000569","dc:identifier":"homoit0000569","skos:prefLabel":"Genderfluid identity","skos:altLabel":"Genderfluidity","rdfs:comment":"A gender identity in which an individual's gender varies over time and across circumstances; some genderfluid people may identify as a mixture of more than one gender simultaneously.","skos:broader":"https://homosaurus.org/v3/homoit0000571","skos:related":["https://homosaurus.org/v3/homoit0000110","https://homosaurus.org/v3/homoit0000570"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderfluid"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000570","dc:identifier":"homoit0000570","skos:prefLabel":"Genderfluid people","rdfs:comment":"People who identify as different genders at different times, including multiple genders at once or none at all. Only use to describe people who self-identify as genderfluid.","skos:broader":["https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001817"],"skos:related":["https://homosaurus.org/v3/homoit0000111","https://homosaurus.org/v3/homoit0000569","https://homosaurus.org/v3/homoit0000571"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderfluidPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000571","dc:identifier":"homoit0000571","skos:prefLabel":"Gender identity","skos:altLabel":"Gender-variant identity","rdfs:comment":"A person’s experience of having a particular gender, which may or may not correspond with the gender or sex they were assigned at birth. Not to be used to describe solely women’s experiences or women’s studies.","skos:broader":"https://homosaurus.org/v3/homoit0000560","skos:narrower":["https://homosaurus.org/v3/homoit0000078","https://homosaurus.org/v3/homoit0000110","https://homosaurus.org/v3/homoit0000322","https://homosaurus.org/v3/homoit0000569","https://homosaurus.org/v3/homoit0001008","https://homosaurus.org/v3/homoit0001071","https://homosaurus.org/v3/homoit0001415","https://homosaurus.org/v3/homoit0001473","https://homosaurus.org/v3/homoit0001509","https://homosaurus.org/v3/homoit0001670","https://homosaurus.org/v3/homoit0001756","https://homosaurus.org/v3/homoit0001918","https://homosaurus.org/v3/homoit0001920","https://homosaurus.org/v3/homoit0001921","https://homosaurus.org/v3/homoit0001922","https://homosaurus.org/v3/homoit0001923","https://homosaurus.org/v3/homoit0001925","https://homosaurus.org/v3/homoit0001927"],"skos:related":["https://homosaurus.org/v3/homoit0000021","https://homosaurus.org/v3/homoit0000271","https://homosaurus.org/v3/homoit0000342","https://homosaurus.org/v3/homoit0000563","https://homosaurus.org/v3/homoit0000565","https://homosaurus.org/v3/homoit0000566","https://homosaurus.org/v3/homoit0000567","https://homosaurus.org/v3/homoit0000568","https://homosaurus.org/v3/homoit0000570","https://homosaurus.org/v3/homoit0000577","https://homosaurus.org/v3/homoit0000580","https://homosaurus.org/v3/homoit0001016","https://homosaurus.org/v3/homoit0001048","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001463","https://homosaurus.org/v3/homoit0001465","https://homosaurus.org/v3/homoit0001563","https://homosaurus.org/v3/homoit0001671","https://homosaurus.org/v3/homoit0001817","https://homosaurus.org/v3/homoit0002256","https://homosaurus.org/v3/homoit0002699","https://homosaurus.org/v3/homoit0002700"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh91003756"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000572","dc:identifier":"homoit0000572","skos:prefLabel":"Gender identity disorder","rdfs:comment":"An obsolete psychological diagnosis that medicalizes trans identities and practices; only use in historical contexts.","skos:broader":"https://homosaurus.org/v3/homoit0001006","skos:related":["https://homosaurus.org/v3/homoit0000567","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001381"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85053731"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderIdentityDisorder"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000573","dc:identifier":"homoit0000573","skos:prefLabel":"Gender markers","rdfs:comment":"Markers used to designate an individual's gender on official documentation, including passports, birth certificates, driver’s licenses, etc. Different jurisdictions vary significantly in the number and types of gender markers they allow on official documentation.","skos:broader":["https://homosaurus.org/v3/homoit0000119","https://homosaurus.org/v3/homoit0000377","https://homosaurus.org/v3/homoit0001092"],"skos:narrower":"https://homosaurus.org/v3/homoit0002884","skos:related":["https://homosaurus.org/v3/homoit0000120","https://homosaurus.org/v3/homoit0000311","https://homosaurus.org/v3/homoit0001005","https://homosaurus.org/v3/homoit0001324","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001465","https://homosaurus.org/v3/homoit0003503"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderMarkers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000574","dc:identifier":"homoit0000574","skos:prefLabel":"Gender non-conforming people","rdfs:comment":"People who identify outside, transgress, or do not conform to a given culture's gender roles or expectations. Only use in reference to people who self-identity as gender non-conforming. Do not use to describe cisgender people whose dress or behaviors do not conform to gender roles or expectations.","skos:broader":"https://homosaurus.org/v3/homoit0001817","skos:related":["https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001756","https://homosaurus.org/v3/homoit0001922"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2017004882"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001817"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderNonConformingPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000575","dc:identifier":"homoit0000575","skos:prefLabel":"Gender relations","rdfs:comment":"The culturally specific rights, responsibilities, and connections afforded to individuals or communities of one gender by individuals or communities of another gender.","skos:broader":"https://homosaurus.org/v3/homoit0000947","skos:narrower":"https://homosaurus.org/v3/homoit0000499","skos:related":["https://homosaurus.org/v3/homoit0000560","https://homosaurus.org/v3/homoit0000577","https://homosaurus.org/v3/homoit0000578","https://homosaurus.org/v3/homoit0000778","https://homosaurus.org/v3/homoit0002589"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000947"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderRelations"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000576","dc:identifier":"homoit0000576","skos:prefLabel":"Gender swapping","skos:altLabel":"Gender roleplay","rdfs:comment":"A media trope (commonly used in fanfiction and fanart) in which one or more characters switch binary sexes (e.g., a cisgender man transforms into a cisgender woman), often temporarily.","skos:broader":["https://homosaurus.org/v3/homoit0000568","https://homosaurus.org/v3/homoit0001242"],"skos:related":["https://homosaurus.org/v3/homoit0000577","https://homosaurus.org/v3/homoit0002160","https://homosaurus.org/v3/homoit0002162","https://homosaurus.org/v3/homoit0002171","https://homosaurus.org/v3/homoit0002184","https://homosaurus.org/v3/homoit0002210"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderSwapping"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000577","dc:identifier":"homoit0000577","skos:prefLabel":"Gender roles","rdfs:comment":"Socially-determined rules or standards for gendered behaviors. Some LGBTQ+ people identify with gender roles that exist outside of the gender binary (e.g., butches, femmes, twinks, bears). Use the term \"Gender role stereotypes\" to describe widely held but oversimplified or offensive ideas regarding gender roles.","skos:broader":"https://homosaurus.org/v3/homoit0001241","skos:narrower":["https://homosaurus.org/v3/homoit0000105","https://homosaurus.org/v3/homoit0000231","https://homosaurus.org/v3/homoit0000321","https://homosaurus.org/v3/homoit0000326","https://homosaurus.org/v3/homoit0000440","https://homosaurus.org/v3/homoit0000655","https://homosaurus.org/v3/homoit0001063","https://homosaurus.org/v3/homoit0001313","https://homosaurus.org/v3/homoit0001374","https://homosaurus.org/v3/homoit0001479","https://homosaurus.org/v3/homoit0001508","https://homosaurus.org/v3/homoit0001898","https://homosaurus.org/v3/homoit0002589","https://homosaurus.org/v3/homoit0003506"],"skos:related":["https://homosaurus.org/v3/homoit0000047","https://homosaurus.org/v3/homoit0000389","https://homosaurus.org/v3/homoit0000562","https://homosaurus.org/v3/homoit0000563","https://homosaurus.org/v3/homoit0000568","https://homosaurus.org/v3/homoit0000571","https://homosaurus.org/v3/homoit0000575","https://homosaurus.org/v3/homoit0000576","https://homosaurus.org/v3/homoit0000995","https://homosaurus.org/v3/homoit0001756","https://homosaurus.org/v3/homoit0001816","https://homosaurus.org/v3/homoit0001817","https://homosaurus.org/v3/homoit0001899"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120663"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001241"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderRoles"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000578","dc:identifier":"homoit0000578","skos:prefLabel":"Gender segregation","rdfs:comment":"Physical, legal, cultural, or rhetorical separation of people according to their gender.","skos:related":["https://homosaurus.org/v3/homoit0000560","https://homosaurus.org/v3/homoit0000563","https://homosaurus.org/v3/homoit0000575"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000578"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderSegregation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000580","dc:identifier":"homoit0000580","skos:prefLabel":"Gendercide","rdfs:comment":"The systematic killing of members of a specific gender for their gender.","skos:related":["https://homosaurus.org/v3/homoit0000560","https://homosaurus.org/v3/homoit0000571","https://homosaurus.org/v3/homoit0001108"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000580"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gendercide"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000581","dc:identifier":"homoit0000581","skos:prefLabel":"Genderfuck","rdfs:comment":"A form of gender expression that seeks to subvert the gender binary or gender roles by mixing and messing with (or \"fucking with\") traditionally masculine and feminine components. Typically used to describe gender practices and presentation, though some people identify as \"genderfuck\" or as \"genderfuckers.\" Only use to describe people and the practices of people who self-identify with genderfuck.","skos:related":["https://homosaurus.org/v3/homoit0000568","https://homosaurus.org/v3/homoit0001816","https://homosaurus.org/v3/homoit0001817"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000581"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderfuck"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000582","dc:identifier":"homoit0000582","skos:prefLabel":"Genderqueer people","rdfs:comment":"Individuals who self-identify as genderqueer, an umbrella term for queer or non-normative gender identities and gender expressions.","skos:broader":["https://homosaurus.org/v3/homoit0001195","https://homosaurus.org/v3/homoit0001817"],"skos:narrower":"https://homosaurus.org/v3/homoit0001668","skos:related":["https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001921"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderqueerPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000583","dc:identifier":"homoit0000583","skos:prefLabel":"Genetic parenthood","rdfs:comment":"The experience of parenthood as felt by parents who passed on genetic material to their child or children.","skos:broader":["https://homosaurus.org/v3/homoit0000116","https://homosaurus.org/v3/homoit0000819"],"skos:related":["https://homosaurus.org/v3/homoit0000364","https://homosaurus.org/v3/homoit0000390","https://homosaurus.org/v3/homoit0000587","https://homosaurus.org/v3/homoit0000914","https://homosaurus.org/v3/homoit0002621","https://homosaurus.org/v3/homoit0002623"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/geneticParenthood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000584","dc:identifier":"homoit0000584","skos:prefLabel":"Bottom surgery","skos:altLabel":"Genital reconstruction surgery","rdfs:comment":"Colloquial term for gender-affirming surgical alterations of the genitalia and/or reproductive organs.","skos:broader":"https://homosaurus.org/v3/homoit0000561","skos:narrower":["https://homosaurus.org/v3/homoit0000658","https://homosaurus.org/v3/homoit0001060","https://homosaurus.org/v3/homoit0001097","https://homosaurus.org/v3/homoit0001844","https://homosaurus.org/v3/homoit0001845","https://homosaurus.org/v3/homoit0001846","https://homosaurus.org/v3/homoit0001847","https://homosaurus.org/v3/homoit0001848","https://homosaurus.org/v3/homoit0001850","https://homosaurus.org/v3/homoit0001851","https://homosaurus.org/v3/homoit0002840"],"skos:related":["https://homosaurus.org/v3/homoit0001465","https://homosaurus.org/v3/homoit0001840","https://homosaurus.org/v3/homoit0002847"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genitalReconstructionSurgery"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000585","dc:identifier":"homoit0000585","skos:prefLabel":"Genitals","skos:altLabel":"Genitalia","rdfs:comment":"General term for erogenous and/or reproductive organs (e.g., vagina, clitoris, penis).","skos:broader":"https://homosaurus.org/v3/homoit0001269","skos:narrower":["https://homosaurus.org/v3/homoit0000282","https://homosaurus.org/v3/homoit0001099","https://homosaurus.org/v3/homoit0001361","https://homosaurus.org/v3/homoit0001488","https://homosaurus.org/v3/homoit0001497"],"skos:related":["https://homosaurus.org/v3/homoit0000401","https://homosaurus.org/v3/homoit0001268","https://homosaurus.org/v3/homoit0003110"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85053822"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genitals"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0000586","dc:identifier":"homoit0000586","skos:prefLabel":"Gerontophilia","skos:broader":["https://homosaurus.org/v3/homoit0000442","https://homosaurus.org/v3/homoit0001300"],"skos:related":["https://homosaurus.org/v3/homoit0000393","https://homosaurus.org/v3/homoit0000663"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000404"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000442"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gerontophilia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-11-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000587","dc:identifier":"homoit0000587","skos:prefLabel":"Gestational parenthood","rdfs:comment":"The experience of parenthood as felt by a person whose uterus was utilized to nurture and develop an embryo into a baby.","skos:broader":["https://homosaurus.org/v3/homoit0000116","https://homosaurus.org/v3/homoit0000819"],"skos:narrower":["https://homosaurus.org/v3/homoit0000121","https://homosaurus.org/v3/homoit0001347"],"skos:related":["https://homosaurus.org/v3/homoit0000583","https://homosaurus.org/v3/homoit0002627","https://homosaurus.org/v3/homoit0002628"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gestationalParenthood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000588","dc:identifier":"homoit0000588","skos:prefLabel":"Getting laid","rdfs:comment":"Slang term for the act of having sex, typically with another person.","skos:broader":["https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001299"],"skos:related":["https://homosaurus.org/v3/homoit0000459","https://homosaurus.org/v3/homoit0000662"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gettingLaid"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000589","dc:identifier":"homoit0000589","skos:prefLabel":"Getting off","rdfs:comment":"Slang term for the act of experiencing erotic or sexual pleasure, typically referring to an orgasm.","skos:related":["https://homosaurus.org/v3/homoit0000323","https://homosaurus.org/v3/homoit0000610","https://homosaurus.org/v3/homoit0000683","https://homosaurus.org/v3/homoit0001000","https://homosaurus.org/v3/homoit0001062","https://homosaurus.org/v3/homoit0001284","https://homosaurus.org/v3/homoit0001288"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000589"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gettingOff"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000590","dc:identifier":"homoit0000590","skos:prefLabel":"Girls","rdfs:comment":"Children or youth, typically younger than 18 years old, who identify as girls.","skos:broader":"https://homosaurus.org/v3/homoit0000255","skos:narrower":["https://homosaurus.org/v3/homoit0000152","https://homosaurus.org/v3/homoit0000623","https://homosaurus.org/v3/homoit0000743","https://homosaurus.org/v3/homoit0001374","https://homosaurus.org/v3/homoit0002284"],"skos:related":["https://homosaurus.org/v3/homoit0000563","https://homosaurus.org/v3/homoit0000591"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85055012"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/girls"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000591","dc:identifier":"homoit0000591","skos:prefLabel":"Girls' friendships","rdfs:comment":"Connections based on affection and trust between two or more girls.","skos:broader":["https://homosaurus.org/v3/homoit0000455","https://homosaurus.org/v3/homoit0000649"],"skos:related":"https://homosaurus.org/v3/homoit0000590","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/girlsFriendships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000592","dc:identifier":"homoit0000592","skos:prefLabel":"Given name","skos:altLabel":["Birth names","First names"],"rdfs:comment":"Personal names ascribed to individuals at birth, typically by their parents. Sometimes referred to as \"birth names\" or, in cultures where the given name precedes the family name, \"first names.\"","skos:related":["https://homosaurus.org/v3/homoit0000264","https://homosaurus.org/v3/homoit0000336"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000592"},"dc:replaces":{"@id":"http://homosaurus.org/v2/givenName"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000593","dc:identifier":"homoit0000593","skos:prefLabel":"Oral sex","skos:altLabel":["Giving head","Going down"],"rdfs:comment":"Sexual activities performed using the mouth.","skos:broader":["https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001299"],"skos:narrower":["https://homosaurus.org/v3/homoit0000206","https://homosaurus.org/v3/homoit0000212","https://homosaurus.org/v3/homoit0000239","https://homosaurus.org/v3/homoit0000691","https://homosaurus.org/v3/homoit0000969","https://homosaurus.org/v3/homoit0002578"],"skos:related":"https://homosaurus.org/v3/homoit0000049","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85095239"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/oralSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000594","dc:identifier":"homoit0000594","skos:prefLabel":"LGBT","skos:altLabel":"GLBT","rdfs:comment":"Acronym used to describe lesbians, gay men, bisexual people, and transgender people as a group.","skos:broader":["https://homosaurus.org/v3/homoit0000805","https://homosaurus.org/v3/homoit0000806"],"skos:narrower":["https://homosaurus.org/v3/homoit0000703","https://homosaurus.org/v3/homoit0000804"],"skos:related":["https://homosaurus.org/v3/homoit0000143","https://homosaurus.org/v3/homoit0000485","https://homosaurus.org/v3/homoit0000733","https://homosaurus.org/v3/homoit0001403"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000805"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBT"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000805","dc:identifier":"homoit0000805","skos:prefLabel":"LGBTI","rdfs:comment":"Acronym used to describe lesbians, gay men, bisexual people, transgender people, and intersex people as a group.","skos:narrower":["https://homosaurus.org/v3/homoit0000594","https://homosaurus.org/v3/homoit0000804"],"skos:related":["https://homosaurus.org/v3/homoit0000143","https://homosaurus.org/v3/homoit0000485","https://homosaurus.org/v3/homoit0000672","https://homosaurus.org/v3/homoit0000733","https://homosaurus.org/v3/homoit0001297","https://homosaurus.org/v3/homoit0001403","https://homosaurus.org/v3/homoit0001463"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000805"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTI"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000595","dc:identifier":"homoit0000595","skos:prefLabel":"Glory holes","rdfs:comment":"Holes through walls or partitions, such as public bathr