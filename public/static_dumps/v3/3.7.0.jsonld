{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dc":"http://purl.org/dc/terms/","rdfs":"http://www.w3.org/2000/01/rdf-schema#","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@id":"https://homosaurus.org/v4/homoit0000001","dc:identifier":"homoit0000001","skos:prefLabel":"5-alpha reductase deficiency","skos:altLabel":"5-ARD","rdfs:comment":"People with 5-alpha reductase deficiency, abbreviated as 5-ARD, have XY chromosomes, testes, and typical levels of testosterone, but their bodies do not have the enzyme responsible for converting testosterone to the more powerful androgen dihydrotestosterone (DHT). This affects how an individual's external sex characteristics develop, and people born with 5-ARD often have genital differences that are noticed at birth. In adolescence, people with 5-ARD typically develop some features associated with testosterone puberty, and they may experience genital growth at this point.","skos:broader":"https://homosaurus.org/v3/homoit0000669","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/5AlphaReductaseDeficiency"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001269","dc:identifier":"homoit0001269","skos:prefLabel":"Sex (Body)","rdfs:comment":"The category assigned to an individual to describe their body and its role in sexual reproduction, usually based on external anatomy, but also including chromosomes, gene expression, hormones, and internal and external reproductive/sexual organs. Although sex is often described as binary, it exists as a spectrum with significant variation in the biological attributes that comprise sex and the way it is defined in different cultural contexts.","skos:narrower":["https://homosaurus.org/v3/homoit0000266","https://homosaurus.org/v3/homoit0000352","https://homosaurus.org/v3/homoit0000585","https://homosaurus.org/v3/homoit0000600","https://homosaurus.org/v3/homoit0000651","https://homosaurus.org/v3/homoit0001259","https://homosaurus.org/v3/homoit0001648","https://homosaurus.org/v3/homoit0001896"],"skos:related":"https://homosaurus.org/v3/homoit0000560","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120560"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexBody"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000002","dc:identifier":"homoit0000002","skos:prefLabel":"Aboriginal Australian LGBTQ+ people","skos:altLabel":["Aboriginal people (LGBTQ)","Aboriginal Australian people (LGBTQ)","LGBTQ+ Aboriginal Australian people","LGBTQ+ Aboriginal Australians","LGBTQ+ Aboriginal people","LGBTQ+ Aboriginals"],"rdfs:comment":"LGBTQ+ people who belong to one or more of the various Indigenous peoples of Australia; do not use to refer to the Indigenous people of the Torres Strait Islands, who are considered ethnically and culturally distinct. Only use to describe people who identify as Aboriginal Australian.","skos:broader":"https://homosaurus.org/v3/homoit0000886","skos:narrower":["https://homosaurus.org/v3/homoit0001974","https://homosaurus.org/v3/homoit0001975","https://homosaurus.org/v3/homoit0001976","https://homosaurus.org/v3/homoit0001977","https://homosaurus.org/v3/homoit0001978","https://homosaurus.org/v3/homoit0001979","https://homosaurus.org/v3/homoit0002892","https://homosaurus.org/v3/homoit0003393"],"skos:related":["https://homosaurus.org/v3/homoit0001314","https://homosaurus.org/v3/homoit0001809","https://homosaurus.org/v3/homoit0001810"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQAboriginalPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000915","dc:identifier":"homoit0000915","skos:prefLabel":"LGBTQ+ people","skos:altLabel":["Gay people","LGBTQ people","People (LGBTQ)"],"rdfs:comment":"Self-identified lesbians, gay men, bisexual people, transgender people, queer people, and other sexual and gender minorities.","skos:narrower":["https://homosaurus.org/v3/homoit0000007","https://homosaurus.org/v3/homoit0000008","https://homosaurus.org/v3/homoit0000070","https://homosaurus.org/v3/homoit0000082","https://homosaurus.org/v3/homoit0000108","https://homosaurus.org/v3/homoit0000170","https://homosaurus.org/v3/homoit0000312","https://homosaurus.org/v3/homoit0000330","https://homosaurus.org/v3/homoit0000379","https://homosaurus.org/v3/homoit0000393","https://homosaurus.org/v3/homoit0000506","https://homosaurus.org/v3/homoit0000556","https://homosaurus.org/v3/homoit0000618","https://homosaurus.org/v3/homoit0000860","https://homosaurus.org/v3/homoit0000862","https://homosaurus.org/v3/homoit0000879","https://homosaurus.org/v3/homoit0000887","https://homosaurus.org/v3/homoit0000895","https://homosaurus.org/v3/homoit0000902","https://homosaurus.org/v3/homoit0000908","https://homosaurus.org/v3/homoit0000927","https://homosaurus.org/v3/homoit0000961","https://homosaurus.org/v3/homoit0001009","https://homosaurus.org/v3/homoit0001073","https://homosaurus.org/v3/homoit0001195","https://homosaurus.org/v3/homoit0001329","https://homosaurus.org/v3/homoit0001352","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001482","https://homosaurus.org/v3/homoit0001510","https://homosaurus.org/v3/homoit0001549","https://homosaurus.org/v3/homoit0001550","https://homosaurus.org/v3/homoit0001771","https://homosaurus.org/v3/homoit0001783","https://homosaurus.org/v3/homoit0001815","https://homosaurus.org/v3/homoit0001853","https://homosaurus.org/v3/homoit0001854","https://homosaurus.org/v3/homoit0001879","https://homosaurus.org/v3/homoit0001919","https://homosaurus.org/v3/homoit0001929","https://homosaurus.org/v3/homoit0001989","https://homosaurus.org/v3/homoit0002181","https://homosaurus.org/v3/homoit0002226","https://homosaurus.org/v3/homoit0002227","https://homosaurus.org/v3/homoit0002228","https://homosaurus.org/v3/homoit0002277","https://homosaurus.org/v3/homoit0002278","https://homosaurus.org/v3/homoit0002279","https://homosaurus.org/v3/homoit0002336","https://homosaurus.org/v3/homoit0002349","https://homosaurus.org/v3/homoit0002356","https://homosaurus.org/v3/homoit0002358","https://homosaurus.org/v3/homoit0002360","https://homosaurus.org/v3/homoit0002585","https://homosaurus.org/v3/homoit0003247","https://homosaurus.org/v3/homoit0003263","https://homosaurus.org/v3/homoit0003370","https://homosaurus.org/v3/homoit0003533","https://homosaurus.org/v3/homoit0001101","https://homosaurus.org/v3/homoit0003637","https://homosaurus.org/v3/homoit0003677","https://homosaurus.org/v3/homoit0003696","https://homosaurus.org/v3/homoit0003697","https://homosaurus.org/v3/homoit0003739","https://homosaurus.org/v3/homoit0003740","https://homosaurus.org/v3/homoit0003741","https://homosaurus.org/v3/homoit0001277","https://homosaurus.org/v3/homoit0001723"],"skos:related":"https://homosaurus.org/v3/homoit0001297","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2004003385"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000003","dc:identifier":"homoit0000003","skos:prefLabel":"Acault","rdfs:comment":"A commonly mistranslated Burmese term for people assigned male at birth who exhibit feminine behaviors while serving as spiritual mediums; there is some question over the legitimacy of term.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/acault"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000560","dc:identifier":"homoit0000560","skos:prefLabel":"Gender","rdfs:comment":"A socially constructed system that gives meaning to masculinity and femininity and that unevenly distributes power and opportunity according to cultural interpretations of sex. As an element of personal identity, a gender is developed through the interaction of social roles and expectations, one’s response to those expectations, one’s physiology, and one’s internal sense of self. Gender is culturally specific, meaning that different cultures have different understandings of what gender means and how many genders should be recognized.","skos:narrower":["https://homosaurus.org/v3/homoit0000078","https://homosaurus.org/v3/homoit0000568","https://homosaurus.org/v3/homoit0000571","https://homosaurus.org/v3/homoit0003824"],"skos:related":["https://homosaurus.org/v3/homoit0000288","https://homosaurus.org/v3/homoit0000561","https://homosaurus.org/v3/homoit0000563","https://homosaurus.org/v3/homoit0000565","https://homosaurus.org/v3/homoit0000566","https://homosaurus.org/v3/homoit0000575","https://homosaurus.org/v3/homoit0000578","https://homosaurus.org/v3/homoit0000579","https://homosaurus.org/v3/homoit0000580","https://homosaurus.org/v3/homoit0001090","https://homosaurus.org/v3/homoit0001269","https://homosaurus.org/v3/homoit0001463","https://homosaurus.org/v3/homoit0001816","https://homosaurus.org/v3/homoit0001817","https://homosaurus.org/v3/homoit0001899"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000004","dc:identifier":"homoit0000004","skos:prefLabel":"Asexuality","skos:altLabel":"Ace","rdfs:comment":"A sexual orientation generally characterized by a lack of sexual attraction or desire.","skos:broader":"https://homosaurus.org/v3/homoit0001298","skos:related":["https://homosaurus.org/v3/homoit0000067","https://homosaurus.org/v3/homoit0000071","https://homosaurus.org/v3/homoit0000807","https://homosaurus.org/v3/homoit0000882","https://homosaurus.org/v3/homoit0001282","https://homosaurus.org/v3/homoit0001493","https://homosaurus.org/v3/homoit0001535","https://homosaurus.org/v3/homoit0001644"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2016000238"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/asexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001298","dc:identifier":"homoit0001298","skos:prefLabel":"Sexual orientation","rdfs:comment":"The direction of an individual's sexual attraction towards other individuals of the same, opposite, or multiple sexes; commonly understood to be biologically and physiologically dictated, rather than sociologically determined.","skos:narrower":["https://homosaurus.org/v3/homoit0000004","https://homosaurus.org/v3/homoit0000204","https://homosaurus.org/v3/homoit0000343","https://homosaurus.org/v3/homoit0000631","https://homosaurus.org/v3/homoit0000647","https://homosaurus.org/v3/homoit0000799","https://homosaurus.org/v3/homoit0001292","https://homosaurus.org/v3/homoit0001531","https://homosaurus.org/v3/homoit0001556","https://homosaurus.org/v3/homoit0001558","https://homosaurus.org/v3/homoit0001626","https://homosaurus.org/v3/homoit0001632","https://homosaurus.org/v3/homoit0001926"],"skos:related":["https://homosaurus.org/v3/homoit0000303","https://homosaurus.org/v3/homoit0000345","https://homosaurus.org/v3/homoit0000559","https://homosaurus.org/v3/homoit0001290","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001297","https://homosaurus.org/v3/homoit0001300","https://homosaurus.org/v3/homoit0001636","https://homosaurus.org/v3/homoit0001828","https://homosaurus.org/v3/homoit0001915"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh91005179"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualOrientation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000005","dc:identifier":"homoit0000005","skos:prefLabel":"HIV/AIDS","skos:altLabel":["Acquired immune deficiency syndrome","AIDS","Acquired immunodeficiency syndrome","HIV","Human immunodeficiency virus"],"rdfs:comment":"Abbreviation for human immunodeficiency virus (HIV) and acquired immunodeficiency syndrome (AIDS).","skos:broader":"https://homosaurus.org/v3/homoit0001308","skos:narrower":["https://homosaurus.org/v3/homoit0000033","https://homosaurus.org/v3/homoit0001980"],"skos: