 have biological or legal relationships.","skos:broader":"https://homosaurus.org/v3/homoit0000420","skos:narrower":["https://homosaurus.org/v3/homoit0000094","https://homosaurus.org/v3/homoit0000371"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQChosenFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000835","dc:identifier":"homoit0000835","skos:prefLabel":"LGBTQ+ civil disobedience","skos:altLabel":"LGBTQ civil disobedience","rdfs:comment":"The active, professed refusal of LGBTQ+ people to obey certain laws or governmental orders as a form of activism and resistance.","skos:broader":"https://homosaurus.org/v3/homoit0000853","skos:related":"https://homosaurus.org/v3/homoit0000068","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQCivilDisobedience"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000837","dc:identifier":"homoit0000837","skos:prefLabel":"LGBTQ+ co-fathers","skos:altLabel":"LGBTQ co-fathers","rdfs:comment":"Co-parenting fathers who are LGBTQ+ people. They may or may not be partners.","skos:broader":"https://homosaurus.org/v3/homoit0000840","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQCoFathers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote"