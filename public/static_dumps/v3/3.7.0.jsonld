ps of lesbians who sing together.","skos:broader":["https://homosaurus.org/v3/homoit0000382","https://homosaurus.org/v3/homoit0000833"],"skos:related":"https://homosaurus.org/v3/homoit0000482","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianChoruses"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000731","dc:identifier":"homoit0000731","skos:prefLabel":"Lesbian Christians","rdfs:comment":"Lesbians who are Christian.","skos:broader":"https://homosaurus.org/v3/homoit0000265","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006008772"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianChristians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000732","dc:identifier":"homoit0000732","skos:prefLabel":"Lesbian clergy","skos:altLabel":"Lesbian pastors","rdfs:comment":"Lesbians who are ordained for religious duties, particularly in the Christian Church.","skos:broader":"https://homosaurus.org/v3/homoit0001624","skos:related":["https://homosaurus.org/v3/homoit0000142","https://homosaurus.org/v3/homoit0000244","https://homosaurus.org/v3/homoit0000484","https://homosaurus.org/v3/homoit0001169","https://homosaurus.org/v3/homoit0001402"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh89003320"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001624"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianClergy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000733","dc:identifier":"homoit0000733","skos:prefLabel":"Lesbian community","rdfs:comment":"Groups of people who share the experience of being lesbians.","skos:broader":"https://homosaurus.org/v3/homoit0000297","skos:related":["https://homosaurus.org/v3/homoit0000594","https://homosaurus.org/v3/homoit0000724","https://homosaurus.org/v3/homoit0000734","https://homosaurus.org/v3/homoit0000804","https://homosaurus.org/v3/homoit0000805","https://homosaurus.org/v3/homoit0000806","https://homosaurus.org/v3/homoit0000807","https://homosaurus.org/v3/homoit0000882","https://homosaurus.org/v3/homoit0001789"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh95005870"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianCommunity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000734","dc:identifier":"homoit0000734","skos:prefLabel":["Lesbian community centers","Lesbian community centres"],"rdfs:comment":"Spaces in which people from lesbian communities meet for social, education, recreational, or organizing activities.","skos:broader":"https://homosaurus.org/v3/homoit0000298","skos:related":["https://homosaurus.org/v3/homoit0000733","https://homosaurus.org/v3/homoit0000753"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianCommunityCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:i