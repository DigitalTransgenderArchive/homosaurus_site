05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000738","dc:identifier":"homoit0000738","skos:prefLabel":"Lesbian dominatrices","rdfs:comment":"Women who take a dominant role in BDSM activities; use for dominatrices who identify as lesbians.","skos:broader":"https://homosaurus.org/v3/homoit0000363","skos:related":["https://homosaurus.org/v3/homoit0000148","https://homosaurus.org/v3/homoit0001175","https://homosaurus.org/v3/homoit0001410"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001637"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianDominatrices"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000739","dc:identifier":"homoit0000739","skos:prefLabel":"Lesbian drama","rdfs:comment":"Works of fiction written to be performed; use in reference to dramatic works focusing on lesbian characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000376","skos:related":"https://homosaurus.org/v3/homoit0001724","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2009129546"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianDrama"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000740","dc:identifier":"homoit0000740","skos:prefLabel":"Lesbian families","rdfs:comment":"Families, whether biological, adoptive, or chosen, in which one or more individuals identify as lesbian.","skos:broader":"https://homosaurus.org/v3/homoit0000420","skos:related":"https://homosaurus.org/v3/homoit0000259","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2018003209"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000741","dc:identifier":"homoit0000741","skos:prefLabel":"Lesbian feminism","rdfs:comment":"A cultural movement and critical perspective that arose in the 1970s and 1980s primarily in North America and Western Europe as a result of dissatisfaction with the women's liberation movement and the gay liberation movement. Lesbian feminism encourages women to focus their efforts, activities, and relationships toward other women rather than men, often advocating for lesbianism as the logical result of feminism.","skos:broader":"https://homosaurus.org/v3/homoit0000437","skos:related":["https://homosaurus.org/v3/homoit0000622","https://homosaurus.org/v3/homoit0000753","https://homosaurus.org/v3/homoit0003169"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93000705"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000437"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianFeminism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000742","dc:identifier":"homoit0000742","skos:prefLabel":"Lesbian fiction","rdfs:comment":"Written works describing imagined events or people; use in reference to fictional works focusing on lesbian characters or themes.","skos:broader":["https://homosaurus.org/v3/homoit0000443","https://homosaurus.org/v3/homoit0002162"],"skos:related":["https://homosaurus.org/v3/homoit0001724","https://homosaurus.org/v3/homoit0001752","https://homosaurus.org/v3/homoit0001753","https://homosaurus.org/v3/homoit0001754","https://homosaurus.org/v3/homoit0002178","https://homosaurus.org/v3/homoit0002220","https://homosaurus.org/v3/homoit0003507","https://homosaurus.org/v3/homoit0003508"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008106911"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianFiction"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000743","dc:identifier":"homoit0000743","skos:prefLabel":"Lesbian girls","rdfs:comment":"Girls (typically children younger than 18) who are lesbians.","skos:broader":["https://homosaurus.org/v3/homoit0000590","https://homosaurus.org/v3/homoit0000786"],"skos:related":"https://homosaurus.org/v3/homoit0002362","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianGirls"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000744","dc:identifier":"homoit0000744","skos:prefLabel":"Lesbian identity","rdfs:comment":"Term used to describe the sexual identity of women and femmes who are romantically and/or sexually attracted to other women and femmes. However, not all lesbians are women, and gender non-conforming people who belong to lesbian communities have often identified as lesbian.","skos:broader":"https://homosaurus.org/v3/homoit0001295","skos:related":["https://homosaurus.org/v3/homoit0000556","https://homosaurus.org/v3/homoit0000786"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh94004083"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000745","dc:identifier":"homoit0000745","skos:prefLabel":"Jewish lesbians","skos:altLabel":"Lesbian Jews","rdfs:comment":"Lesbians who are Jewish.","skos:broader":"https://homosaurus.org/v3/homoit0000682","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh96007024"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianJews"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000746","dc:identifier":"homoit0000746","skos:prefLabel":"Lesbian land","rdfs:comment":"Rural communities populated only by lesbians.","skos:broader":"https://homosaurus.org/v3/homoit0000778","skos:related":"https://homosaurus.org/v3/homoit0000753","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000778"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianLand"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000778","dc:identifier":"homoit0000778","skos:prefLabel":"Lesbian separatism","rdfs:comment":"Ideological, social, cultural, and physical separation between men and women or between lesbians and heterosexual women.","skos:narrower":["https://homosaurus.org/v3/homoit0000746","https://homosaurus.org/v3/homoit0000757"],"skos:related":"https://homosaurus.org/v3/homoit0000575","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2009003403"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000778"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianSeparatism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000747","dc:identifier":"homoit0000747","skos:prefLabel":"Latino/a/x lesbians","skos:altLabel":["Latina lesbians","Latine lesbians","Latino lesbians","Latinx lesbians","Lesbian Latinas","Lesbian Latine","Lesbian Latinos"],"rdfs:comment":"Latin American people who are lesbians; only use to describe individuals who self-identify as Latino, Latina, or Latinx. Do not conflate with Chicano/a/x or Hispanic.","skos:broader":"https://homosaurus.org/v3/homoit0000253","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianLatinas"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000748","dc:identifier":"homoit0000748","skos:prefLabel":"Lesbian liberation","rdfs:comment":"Liberation movement that began in the 1970s to direct more attention to lesbian and feminist issues within the larger gay liberation movement and in national discourse.","skos:broader":"https://homosaurus.org/v3/homoit0000947","skos:related":"https://homosaurus.org/v3/homoit0000500","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000947"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianLiberation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000749","dc:identifier":"homoit0000749","skos:prefLabel":"Lesbian libraries","rdfs:comment":"Libraries that hold materials primarily pertaining to lesbians or intended for use by lesbians.","skos:broader":["https://homosaurus.org/v3/homoit0000968","https://homosaurus.org/v3/homoit0001513"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh89000079"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianLibraries"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000750","dc:identifier":"homoit0000750","skos:prefLabel":"Lesbian literature","rdfs:comment":"Written literary works about lesbian characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000972","skos:related":"https://homosaurus.org/v3/homoit0001724","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianLiterature"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000751","dc:identifier":"homoit0000751","skos:prefLabel":"Lesbian mistresses","rdfs:comment":"Lesbians who are part of the BDSM scene and assume the mistress role in sexual relationships with a mistress/submissive dynamic.","skos:broader":"https://homosaurus.org/v3/homoit0001018","skos:related":["https://homosaurus.org/v3/homoit0000161","https://homosaurus.org/v3/homoit0001186","https://homosaurus.org/v3/homoit0001421"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianMistresses"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000752","dc:identifier":"homoit0000752","skos:prefLabel":"Lesbian parents","rdfs:comment":"Lesbians who are parents.","skos:broader":"https://homosaurus.org/v3/homoit0001075","skos:related":["https://homosaurus.org/v3/homoit0000259","https://homosaurus.org/v3/homoit0001021","https://homosaurus.org/v3/homoit0002585"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85076155"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianParents"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000753","dc:identifier":"homoit0000753","skos:prefLabel":"Lesbian movement","skos:altLabel":["Lesbian organisations","Lesbian organizations"],"rdfs:comment":"Umbrella term for activism focused on the rights of lesbians and issues faced by lesbian communities.","skos:broader":"https://homosaurus.org/v3/homoit0001026","skos:narrower":"https://homosaurus.org/v3/homoit0000791","skos:related":["https://homosaurus.org/v3/homoit0000438","https://homosaurus.org/v3/homoit0000500","https://homosaurus.org/v3/homoit0000734","https://homosaurus.org/v3/homoit0000737","https://homosaurus.org/v3/homoit0000741","https://homosaurus.org/v3/homoit0000746","https://homosaurus.org/v3/homoit0000757","https://homosaurus.org/v3/homoit0000766","https://homosaurus.org/v3/homoit0000772","https://homosaurus.org/v3/homoit0000787","https://homosaurus.org/v3/homoit0003169"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianMovement"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000754","dc:identifier":"homoit0000754","skos:prefLabel":"Lesbian museums","rdfs:comment":"Institutions dedicated to the storage, exhibition, conservation, and preservation of materials relating to lesbians and lesbian history.","skos:broader":"https://homosaurus.org/v3/homoit0001030","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianMuseums"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000755","dc:identifier":"homoit0000755","skos:prefLabel":"Women's music","skos:altLabel":["Lesbian music","Wimmin's music","Women-identified music","Womyn's music"],"rdfs:comment":"Genre of music by women, for women, and about women that emerged in the 1960s and 1970s as a form of musical expression of the second-wave feminist movement.","skos:broader":"https://homosaurus.org/v3/homoit0000382","skos:related":["https://homosaurus.org/v3/homoit0001515","https://homosaurus.org/v3/homoit0003166"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93005222"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womensMusic"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000756","dc:identifier":"homoit0000756","skos:prefLabel":"Lesbian Muslims","rdfs:comment":"Lesbians who are Muslim.","skos:broader":"https://homosaurus.org/v3/homoit0001032","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2018001970"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianMuslims"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000757","dc:identifier":"homoit0000757","skos:prefLabel":"Lesbian nation","rdfs:comment":"An imagined autonomous, international lesbian community that is set apart from men.","skos:broader":"https://homosaurus.org/v3/homoit0000778","skos:related":"https://homosaurus.org/v3/homoit0000753","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000778"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianNation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000758","dc:identifier":"homoit0000758","skos:prefLabel":"Native American lesbians","skos:altLabel":["American Indian lesbians","Lesbian Native Americans"],"rdfs:comment":"People who are part of the Native peoples of the continental United States and Canada (excluding Inuit people) and self-identity as lesbians. Use more specific terms when available.","skos:broader":"https://homosaurus.org/v3/homoit0001037","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianNativeAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000759","dc:identifier":"homoit0000759","skos:prefLabel":"Lesbian newsletters","rdfs:comment":"Serialized print or digital periodicals created by or for lesbians, often with the purpose of sharing news and information related to lesbian communities and lesbian issues.","skos:broader":["https://homosaurus.org/v3/homoit0000766","https://homosaurus.org/v3/homoit0001041"],"skos:related":"https://homosaurus.org/v3/homoit0000760","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianNewsletters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000760","dc:identifier":"homoit0000760","skos:prefLabel":"Lesbian newspapers","rdfs:comment":"Serialized print or digital publications about lesbians or lesbian issues (and typically produced by lesbians or lesbian organizations) that contain news, articles, columns, correspondence, and advertisements.","skos:broader":["https://homosaurus.org/v3/homoit0000766","https://homosaurus.org/v3/homoit0001042"],"skos:related":"https://homosaurus.org/v3/homoit0000759","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianNewspapers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000761","dc:identifier":"homoit0000761","skos:prefLabel":"Lesbian Pagans","rdfs:comment":"Lesbians who are members of polytheistic religions or other religions outside of the dominant culture that typically incorporate nature worship and/or the sacred feminine, such as Wicca, Druidry, Heathenry, etc. Use to describe lesbians who self-identify as Pagan.","skos:broader":"https://homosaurus.org/v3/homoit0001069","skos:related":"https://homosaurus.org/v3/homoit0001908","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianPagans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000762","dc:identifier":"homoit0000762","skos:prefLabel":"Lesbian poetry","rdfs:comment":"Literary work, typically written in verse, that focuses on lesbian characters, lesbian themes, or lesbian identity.","skos:broader":"https://homosaurus.org/v3/homoit0001118","skos:related":"https://homosaurus.org/v3/homoit0001724","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008106915"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianPoetry"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000763","dc:identifier":"homoit0000763","skos:prefLabel":"Lesbian political activists","rdfs:comment":"Lesbians working to bring about political or social change through public organizing.","skos:broader":"https://homosaurus.org/v3/homoit0000007","skos:related":"https://homosaurus.org/v3/homoit0000713","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh96007532"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianPoliticalActivists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000764","dc:identifier":"homoit0000764","skos:prefLabel":"Lesbian political groups","rdfs:comment":"Organized groups centered on political change and action for lesbian rights; may include advocating for lesbianism as a political and feminist choice against sexism.","skos:broader":"https://homosaurus.org/v3/homoit0003521","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003521"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianPoliticalGroups"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000765","dc:identifier":"homoit0000765","skos:prefLabel":"Lesbian porn films","rdfs:comment":"Erotic or sexually explicit films featuring lesbians.","skos:broader":["https://homosaurus.org/v3/homoit0000013","https://homosaurus.org/v3/homoit0002329","https://homosaurus.org/v3/homoit0002607"],"skos:related":"https://homosaurus.org/v3/homoit0002546","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2019103063"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianPornFilms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000766","dc:identifier":"homoit0000766","skos:prefLabel":"Lesbian press","rdfs:comment":"Newspapers, magazines, or other publishing outlets aimed at lesbian audiences and/or operated by lesbians.","skos:broader":"https://homosaurus.org/v3/homoit0001132","skos:narrower":["https://homosaurus.org/v3/homoit0000759","https://homosaurus.org/v3/homoit0000760","https://homosaurus.org/v3/homoit0003155"],"skos:related":["https://homosaurus.org/v3/homoit0000753","https://homosaurus.org/v3/homoit0000896"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianPress"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000767","dc:identifier":"homoit0000767","skos:prefLabel":"Lesbian pride","rdfs:comment":"The recognition and celebration of lesbians and lesbian culture, thereby affirming the visibility, dignity, and diversity of lesbian communities.","skos:broader":"https://homosaurus.org/v3/homoit0003653","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003653"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianPride"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000768","dc:identifier":"homoit0000768","skos:prefLabel":"Lesbian sex workers","skos:altLabel":["Lesbian prostitutes","Lesbian prostitution","Lesbian sex work"],"rdfs:comment":"Lesbians who receive money or goods in exchange for sexual services, performances, or companionship. Use to describe lesbians working across the broad spectrum of sex work.","skos:broader":"https://homosaurus.org/v3/homoit0001277","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003758"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianProstitutes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0000769","dc:identifier":"homoit0000769","skos:prefLabel":["Lesbian prostitution","Prostitución lesbiana"],"rdfs:comment":"","skos:broader":"https://homosaurus.org/v3/homoit0001136","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000011"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000768"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianProstitution"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-28"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000770","dc:identifier":"homoit0000770","skos:prefLabel":"Lesbian Protestants","rdfs:comment":"Lesbians who are members of the Protestant Church.","skos:broader":"https://homosaurus.org/v3/homoit0001137","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianProtestants"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000771","dc:identifier":"homoit0000771","skos:p