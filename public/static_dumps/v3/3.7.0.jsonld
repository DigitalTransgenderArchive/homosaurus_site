t0000264","dc:identifier":"homoit0000264","skos:prefLabel":"Chosen name","rdfs:comment":"A name chosen by an individual that differs from their birth or legal name; often used to describe names chosen by LGBTQ+ people to better match their identities.","skos:related":["https://homosaurus.org/v3/homoit0000336","https://homosaurus.org/v3/homoit0000592"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000264"},"dc:replaces":{"@id":"http://homosaurus.org/v2/chosenName"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000265","dc:identifier":"homoit0000265","skos:prefLabel":"LGBTQ+ Christians","skos:altLabel":"Christians (LGBTQ)","rdfs:comment":"LGBTQ+ people who are Christian. Use a more specific term if possible.","skos:broader":"https://homosaurus.org/v3/homoit0000928","skos:narrower":["https://homosaurus.org/v3/homoit0000141","https://homosaurus.org/v3/homoit0000386","https://homosaurus.org/v3/homoit0000483","https://homosaurus.org/v3/homoit0000680","https://homosaurus.org/v3/homoit0000731","https://homosaurus.org/v3/homoit0000904","https://homosaurus.org/v3/homoit0000912","https://homosaurus.org/v3/homoit0001137","https://homosaurus.org/v3/homoit0001168","https://homosaurus.org/v3/homoit0001244","https://homosaurus.org/v3/homoit0001401","https://homosaurus.org/v3/homoit0002974","https://homosaurus.org/v3/homoit0002980"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/christiansLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000266","dc:identifier":"homoi