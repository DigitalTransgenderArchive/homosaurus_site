/homoit0000273","dc:identifier":"homoit0000273","skos:prefLabel":"Cissexual people","rdfs:comment":"Individuals whose sex matches the sex or gender they were assigned at birth. Whereas cisgender refers to people who are not transgender, cissexual refers to people who are not transsexual.","skos:related":["https://homosaurus.org/v3/homoit0000271","https://homosaurus.org/v3/homoit0001381","https://homosaurus.org/v3/homoit0001924"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000273"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cissexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000274","dc:identifier":"homoit0000274","skos:prefLabel":"Civil unions","skos:altLabel":["Civil partnership","Registered partnership"],"rdfs:comment":"Legally recognized unions with rights similar (but often not identical or equal) to those of marriage, originally created for same-sex couples in jurisdictions where they were not legally allowed to marry.","skos:broader":"https://homosaurus.org/v3/homoit0000973","skos:narrower":["https://homosaurus.org/v3/homoit0000275","https://homosaurus.org/v3/homoit0000277"],"skos:related":["https://homosaurus.org/v3/homoit0000362","https://homosaurus.org/v3/homoit0000712","https://homosaurus.org/v3/homoit0000918","https://homosaurus.org/v3/homoit0000990","https://homosaurus.org/v3/homoit0000992","https://homosaurus.org/v3/homoit0001053"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2003003097"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/civilUnions"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000275","dc:identifier":"homoit0000275","skos:prefLabel":"Civil union documents","rdfs:comment":"Legal documents certifying civil unions established in compliance with the laws of certain jurisdictions.","skos:broader":["https://homosaurus.org/v3/homoit0000274","https://homosaurus.org/v3/homoit0001053"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/civilUnionDocuments"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000276","dc:identifier":"homoit0000276","skos:prefLabel":"LGBTQ+ civil rights","skos:altLabel":["LGBTQ rights","Civil rights (LGBTQ)"],"rdfs:comment":"Legal rights of LGBTQ+ people to political and social freedom and equality.","skos:broader":"https://homosaurus.org/v3/homoit0000652","skos:narrower":["https://homosaurus.org/v3/homoit0000183","https://homosaurus.org/v3/homoit0000531","https://homosaurus.org/v3/homoit0000775","https://homosaurus.org/v3/homoit0001206","https://homosaurus.org/v3/homoit0001443","https://homosaurus.org/v3/homoit0002808"],"skos:related":["https://homosaurus.org/v3/homoit0000339","https://homosaurus.org/v3/homoit0000673","https://homosaurus.org/v3/homoit0001026","https://homosaurus.org/v3/homoit0001492","https://homosaurus.org/v3/homoit0002723"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000652"},"dc:replaces":{"@id":"http://homosaurus.org/v2/civilRightsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000277","dc:identifier":"homoit0000277","skos:prefLabel":"Civil union certificates","rdfs:comment":"Official certificates certifying civil unions established in compliance with the laws of certain jurisdictions.","skos:broader":["https://homosaurus.org/v3/homoit0000274","https://homosaurus.org/v3/homoit0001053"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/civilUnionCertificates"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000278","dc:identifier":"homoit0000278","skos:prefLabel":"Sex workers' clients","skos:altLabel":["Johns","Tricks","Prostitutes' clients","Prostitutes' customers","Sex workers' customers","Sex-buyers","Janes","Curb crawlers","Punters"],"rdfs:comment":"People who provide money or goods to sex workers in exchange for sexual services, performances, or companionship.","skos:narrower":["https://homosaurus.org/v3/homoit0003794","https://homosaurus.org/v3/homoit0003795"],"skos:related":["https://homosaurus.org/v3/homoit0003778","https://homosaurus.org/v3/homoit0003779"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh98005017"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000278"},"dc:replaces":{"@id":"http://homosaurus.org/v2/prostitutesClients"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000279","dc:identifier":"homoit0000279","skos:prefLabel":"Clit rings","rdfs:comment":"Genital piercings placed directly through the hood of the clitoris, typically worn for aesthetic purposes or to enhance sexual arousal.","skos:broader":"https://h