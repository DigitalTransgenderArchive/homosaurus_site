","dc:identifier":"homoit0000966","skos:prefLabel":"Lhamana","rdfs:comment":"Native American Zuni people assigned male at birth who exhibit mixed gender traits.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":"https://homosaurus.org/v3/homoit0001480","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lhamana"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000967","dc:identifier":"homoit0000967","skos:prefLabel":"Libido","skos:altLabel":"Sex drive","rdfs:comment":"A person's overall sexual drive or desire for sexual activity.","skos:related":["https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001284","https://homosaurus.org/v3/homoit0001292","https://homosaurus.org/v3/homoit0001306"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2015001702"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000967"},"dc:replaces":{"@id":"http://homosaurus.org/v2/libido"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000968","dc:identifier":"homoit0000968","skos:prefLabel":"LGBTQ+ libraries","skos:altLabel":"Libraries (LGBTQ)","rdfs:comment":"Libraries that hold materials primarily pertaining to LGBTQ+ people or intended for use by LGBTQ+ people.","skos:broader":"https://homosaurus.org/v3/homoit0001755","skos:narrower":["https://homosaurus.org/v3/homoit0000156","https://homosaurus.org/v3/homoit0000501","https://homosaurus.org/v3/homoit0000749","https://homosaurus.org/v3/homoit0001182","https://homosaurus.org/v3/homoit0001418","https://homosaurus.org/v3/homoit0001513","https://homosaurus.org/v3/homoit0002748","https://homosaurus.org/v3/homoit0002794"],"skos:related":["https://homosaurus.org/v3/homoit0000066","https://homosaurus.org/v3/homoit0000827","https://homosaurus.org/v3/homoit0001813","https://homosaurus.org/v3/homoit0002697","https://homosaurus.org/v3/homoit0003547","https://homosaurus.org/v3/homoit0003618"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/librariesLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000969","dc:identifier":"homoit0000969","skos:prefLabel":"Licking","rdfs:comment":"To touch or pass over with the tongue to moisten or taste; use to describe licking associated in the context of sexual practices or sexual arousal. ","skos:broader":"https://homosaurus.org/v3/homoit0000593","skos:narrower":["https://homosaurus.org/v3/homoit0000049","https://homosaurus.org/v3/homoit0000239"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/licking"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000970","dc:identifier":"homoit0000970","skos:prefLabel":"Lingerie","rdfs:comment":"Category of clothing that includes bras, underwear, hosiery, and robes; typically refers to undergarments and sleepwear designed to be sexually appealing and worn in erotic contexts.","skos:broader":["https://homosaurus.org/v3/homoit0000289","https://homosaurus.org/v3/homoit0000367","https://homosaurus.org/v3/homoit0001266"],"skos:related":["https://homosaurus.org/v3/homoit0000316","https://homosaurus.org/v3/homoit0000318"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85077205"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lingerie"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000971","dc:identifier":"homoit0000971","skos:prefLabel":"Lipstick lesbians","rdfs:comment":"Lesbians whose appearance or mannerisms are more traditionally feminine.","skos:broader":"https://homosaurus.org/v3/homoit0000556","skos:related":"https://homosaurus.org/v3/homoit0000440","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lipstickLesbians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000972","dc:identifier":"homoit0000972","skos:prefLabel":"LGBTQ+ literature","skos:altLabel":"Literature (LGBTQ)","rdfs:comment":"Written literary works featuring LGBTQ+ characters and themes.","skos:broader":"https://homosaurus.org/v3/homoit0001831","skos:narrower":["https://homosaurus.org/v3/homoit0000157","https://homosaurus.org/v3/homoit0000376","https://homosaurus.org/v3/homoit0000443","https://homosaurus.org/v3/homoit0000502","https://homosaurus.org/v3/homoit0000750","https://homosaurus.org/v3/homoit0001118","https://homosaurus.org/v3/homoit0001183","https://homosaurus.org/v3/homoit0001419","https://homosaurus.org/v3/homoit0001522","https://homosaurus.org/v3/homoit0002449","https://homosaurus.org/v3/homoit0002467","https://homosaurus.org/v3/homoit0002484","https://homosaurus.org/v3/homoit0002507","https://homosaurus.org/v3/homoit0002537","https://homosaurus.org/v3/homoit0002750","https://homosaurus.org/v3/homoit0003488","https://homosaurus.org/v3/homoit0003822"],"skos:related":["https://homosaurus.org/v3/homoit0000816","https://homosaurus.org/v3/homoit0000827","https://homosaurus.org/v3/homoit0000891","https://homosaurus.org/v3/homoit0000892","https://homosaurus.org/v3/homoit0001132","https://homosaurus.org/v3/homoit0001149","https://homosaurus.org/v3/homoit0001602","https://homosaurus.org/v3/homoit0001723","https://homosaurus.org/v3/homoit0001755","https://homosaurus.org/v3/homoit0002192","https://homosaurus.org/v3/homoit0002710","https://homosaurus.org/v3/homoit0003618"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/literatureLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000975","dc:identifier":"homoit0000975","skos:prefLabel":"Locker rooms","rdfs:comment":"Rooms or areas in public or commercial spaces where people change clothes, bathe, and store items or personal belongings. LGBTQ+ people, particularly trans people, are often restricted from using locker rooms under the pretense of public safety.","skos:broader":"https://homosaurus.org/v3/homoit0001141","skos:related":"https://homosaurus.org/v3/homoit0001139","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001141"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lockerRooms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000976","dc:identifier":"homoit0000976","skos:prefLabel":"Love triangles","rdfs:comment":"Polyamorous relationships that involve three people in various arrangements.","skos:broader":"https://homosaurus.org/v3/homoit0001302","skos:related":"https://homosaurus.org/v3/homoit0000894","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh96008285"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/loveTriangles"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000977","dc:identifier":"homoit0000977","skos:prefLabel":"Lubricants","rdfs:comment":"Liquids or gels used during sexual activity, typically to ease the act of penetration by a penis or a sex toy.","skos:broader":"https://homosaurus.org/v3/homoit0001266","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85078720"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lubricants"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000978","dc:identifier":"homoit0000978","skos:prefLabel":"Macho men","skos:altLabel":"Machos","rdfs:comment":"Subculture of gay men who display characteristics associated with machismo (e.g., masculine pride, self-reliance, physical strength). Though \"macho men\" can be used more broadly, this term refers to gay men who embrace machismo and traditional masculinity through their dress and behavior.","skos:broader":"https://homosaurus.org/v3/homoit0000506","skos:related":["https://homosaurus.org/v3/homoit0000095","https://homosaurus.org/v3/homoit0000655","https://homosaurus.org/v3/homoit0000995","https://homosaurus.org/v3/homoit0002148","https://homosaurus.org/v3/homoit0002149"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/machoMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000979","dc:identifier":"homoit0000979","skos:prefLabel":"Māhū","skos:altLabel":"Mahu","rdfs:comment":"Term used in Hawaiian and Tahitian cultures for third gender people who blend genders and often hold spiritual roles.","skos:broader":["https://homosaurus.org/v3/homoit0000322","https://homosaurus.org/v3/homoit0002653"],"skos:narrower":["https://homosaurus.org/v3/homoit0002654","https://homosaurus.org/v3/homoit0002655","https://homosaurus.org/v3/homoit0003231","https://homosaurus.org/v3/homoit0003256","https://homosaurus.org/v3/homoit0003762"],"skos:related":["https://homosaurus.org/v3/homoit0001955","https://homosaurus.org/v3/homoit0001959"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mahu"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000980","dc:identifier":"homoit0000980","skos:prefLabel":"Mak nyahs","rdfs:comment":"Term used in Malaysia for transgender women.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/makNyah"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000981","dc:identifier":"homoit0000981","skos:prefLabel":"Male bonding","rdfs:comment":"Friendship and connection between two or more male-identified people.","skos:related":["https://homosaurus.org/v3/homoit0000649","https://homosaurus.org/v3/homoit0000982"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000981"},"dc:replaces":{"@id":"http://homosaurus.org/v2/maleBonding"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000982","dc:identifier":"homoit0000982","skos:prefLabel":"Men's friendships","skos:altLabel":"Male friendships","rdfs:comment":"Connections based on affection and trust between two or more men.","skos:broader":["https://homosaurus.org/v3/homoit0000455","https://homosaurus.org/v3/homoit0000649"],"skos:related":"https://homosaurus.org/v3/homoit0000981","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93005650"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mensFriendships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000983","dc:identifier":"homoit0000983","skos:prefLabel":"Male impersonators","rdfs:comment":"Historical term used to describe performers, often female-identified people, who enact male personas for the purpose of entertainment, typically for straight audiences. Only use in historical contexts.","skos:broader":"https://homosaurus.org/v3/homoit0001363","skos:related":["https://homosaurus.org/v3/homoit0000373","https://homosaurus.org/v3/homoit0003817"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85064636"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001363"},"dc:replaces":{"@id":"http://homosaurus.org/v2/maleImpersonators"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0000984","dc:identifier":"homoit0000984","skos:prefLabel":"Male prostitution","skos:broader":"https://homosaurus.org/v3/homoit0001136","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85107630"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000011"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000236"},"dc:replaces":{"@id":"http://homosaurus.org/v2/maleProstitution"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-28"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0000985","dc:identifier":"homoit0000985","skos:prefLabel":"Males","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85080137"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000985"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001008"},"dc:replaces":{"@id":"http://homosaurus.org/v2/males"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-10-25"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000986","dc:identifier":"homoit0000986","skos:prefLabel":"MtFs","skos:altLabel":["Males transitioning to females","MtF transsexuals","Male-to-female","M2Fs","Transsexual women"],"rdfs:comment":"MtF (male-to-female) is a mostly historical term that has been largely replaced by \"trans women.\" This is due in part to the term’s connection to the medicalisation of transgender people and its assumption that trans women are \"born\" male and become female (typically through hormones and/or surgery).","skos:broader":["https://homosaurus.org/v3/homoit0000878","https://homosaurus.org/v3/homoit0001381","https://homosaurus.org/v3/homoit0001642"],"skos:related":["https://homosaurus.org/v3/homoit0000407","https://homosaurus.org/v3/homoit0000436","https://homosaurus.org/v3/homoit0000457","https://homosaurus.org/v3/homoit0001027"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006002132"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/MtFs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000987","dc:identifier":"homoit0000987","skos:prefLabel":"Mangaiko","rdfs:comment":"Mbo term for third gender people.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mangaiko"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000988","dc:identifier":"homoit0000988","skos:prefLabel":"Manual sex","rdfs:comment":"Sexual activity involving manual stimulation of erogenous zones using the hands.","skos:broader":["https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001299"],"skos:narrower":["https://homosaurus.org/v3/homoit0000446","https://homosaurus.org/v3/homoit0001115","https://homosaurus.org/v3/homoit0001498","https://homosaurus.org/v3/homoit0001500"],"skos:related":["https://homosaurus.org/v3/homoit0000402","https://homosaurus.org/v3/homoit0001000"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/manualSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000989","dc:identifier":"homoit0000989","skos:prefLabel":"Marital status","rdfs:comment":"A person's state of being single, married, separated, divorced, or widowed, as defined by a government or legal authority.","skos:broader":"https://homosaurus.org/v3/homoit0000990","skos:narrower":["https://homosaurus.org/v3/homoit0000359","https://homosaurus.org/v3/homoit0000994","https://homosaurus.org/v3/homoit0001312","https://homosaurus.org/v3/homoit0001483","https://homosaurus.org/v3/homoit0001504"],"skos:related":["https://homosaurus.org/v3/homoit0000712","https://homosaurus.org/v3/homoit0000937","https://homosaurus.org/v3/homoit0000992"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081304"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/maritalStatus"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000990","dc:identifier":"homoit0000990","skos:prefLabel":"Marriage","rdfs:comment":"Legal union between two or more people in a personal relationship that may or may not grant certain economic, legal, and social rights.","skos:broader":"https://homosaurus.org/v3/homoit0000973","skos:narrower":["https://homosaurus.org/v3/homoit0000158","https://homosaurus.org/v3/homoit0000296","https://homosaurus.org/v3/homoit0000504","https://homosaurus.org/v3/homoit0000625","https://homosaurus.org/v3/homoit0000854","https://homosaurus.org/v3/homoit0000937","https://homosaurus.org/v3/homoit0000989","https://homosaurus.org/v3/homoit0000991","https://homosaurus.org/v3/homoit0000993","https://homosaurus.org/v3/homoit0001514"],"skos:related":["https://homosaurus.org/v3/homoit0000247","https://homosaurus.org/v3/homoit0000274","https://homosaurus.org/v3/homoit0000360","https://homosaurus.org/v3/homoit0000362","https://homosaurus.org/v3/homoit0000963","https://homosaurus.org/v3/homoit0000992","https://homosaurus.org/v3/homoit0001053"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081416"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/marriage"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000991","dc:identifier":"homoit0000991","skos:prefLabel":"Marriage certificates","rdfs:comment":"Government-issued documents that serve as official records of marriages; can be used in reference to LGBTQ+ people's marriage certificates or their efforts to acquire marriage certificates.","skos:broader":["https://homosaurus.org/v3/homoit0000990","https://homosaurus.org/v3/homoit0001053"],"skos:related":"https://homosaurus.org/v3/homoit0000992","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/marriageCertificates"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000992","dc:identifier":"homoit0000992","skos:prefLabel":"Marriage law","skos:altLabel":"Matrimonial law","rdfs:comment":"Legal regulations and laws dictating where, when, under what conditions, and who can be legally married in a certain jurisdiction.","skos:broader":"https://homosaurus.org/v3/homoit0000918","skos:narrower":"https://homosaurus.org/v3/homoit0000296","skos:related":["https://homosaurus.org/v3/homoit0000274","https://homosaurus.org/v3/homoit0000989","https://homosaurus.org/v3/homoit0000990","https://homosaurus.org/v3/homoit0000991","https://homosaurus.org/v3/homoit0000993"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081508"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/marriageLaw"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000993","dc:identifier":"homoit0000993","skos:prefLabel":"Marriage licenses","rdfs:comment":"Legal documents issued by a religious organization or local authority that authorizes marriage. In some jurisdictions a license is necessary to legalize a union, but this varies by locale.","skos:broader":["https://homosaurus.org/v3/homoit0000990","https://homosaurus.org/v3/homoit0001053"],"skos:related":"https://homosaurus.org/v3/homoit0000992","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081510"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/marriageLicenses"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000994","dc:identifier":"homoit0000994","skos:prefLabel":"Married people","rdfs:comment":"Individuals who are currently married, or part of a legal union involving two or more people in a personal relationship that may or may not grant certain economic, legal, and social rights.","skos:broader":"https://homosaurus.org/v3/homoit0000989","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081522"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/marriedPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000995","dc:identifier":"homoit0000995","skos:prefLabel":"Masculinities","skos:altLabel":"Masculinity","rdfs:comment":"Culture-specific sets of attributes, behaviors, and roles generally associated with men or boys.","skos:broader":"https://homosaurus.org/v3/homoit0000568","skos:narrower":["https://homosaurus.org/v3/homoit0000432","https://homosaurus.org/v3/homoit0001377","https://homosaurus.org/v3/homoit0001820","https://homosaurus.org/v3/homoit0002061"],"skos:related":["https://homosaurus.org/v3/homoit0000047","https://homosaurus.org/v3/homoit0000231","https://homosaurus.org/v3/homoit0000389","https://homosaurus.org/v3/homoit0000577","https://homosaurus.org/v3/homoit0000655","https://homosaurus.org/v3/homoit0000978","https://homosaurus.org/v3/homoit0001466","https://homosaurus.org/v3/homoit0001508","https://homosaurus.org/v3/homoit0001898"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081797"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/masculinity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000996","dc:identifier":"homoit0000996","skos:prefLabel":"Mashoga","rdfs:comment":"Swahili term for people assigned male at birth who engage in sex with men and who may dress as women.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mashoga"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000997","dc:identifier":"homoit0000997","skos:prefLabel":"Masochism","rdfs:comment":"Erotic or sexual enjoyment of pain and intense sensations. ","skos:broader":["https://homosaurus.org/v3/homoit0000036","https://homosaurus.org/v3/homoit0001300"],"skos:related":["https://homosaurus.org/v3/homoit0001250","https://homosaurus.org/v3/homoit0001295"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081828"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/masochism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000999","dc:identifier":"homoit0000999","skos:prefLabel":"LGBTQ+ dominants","skos:altLabel":["Masters (LGBTQ)","LGBTQ+ D-types","LGBTQ+ Doms","LGBTQ+ masters"],"rdfs:comment":"The person who takes on the position of authority or power in a power exchange relationship or kink activity.","skos:broader":["https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001304","https://homosaurus.org/v3/homoit0001637","https://homosaurus.org/v3/homoit0003084"],"skos:narrower":["https://homosaurus.org/v3/homoit0000159","https://homosaurus.org/v3/homoit0000505","https://homosaurus.org/v3/homoit0001184","https://homosaurus.org/v3/homoit0001420","https://homosaurus.org/v3/homoit0002991","https://homosaurus.org/v3/homoit0003194"],"skos:related":["https://homosaurus.org/v3/homoit0000363","https://homosaurus.org/v3/homoit0000705","https://homosaurus.org/v3/homoit0001018","https://homosaurus.org/v3/homoit0001133","https://homosaurus.org/v3/homoit0001318","https://homosaurus.org/v3/homoit0001376","https://homosaurus.org/v3/homoit0003052"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mastersLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001000","dc:identifier":"homoit0001000","skos:prefLabel":"Masturbation","rdfs:comment":"Sexual stimulation of one's own genitals for sexual pleasure.","skos:broader":["https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001299"],"skos:narrower":["https://homosaurus.org/v3/homoit0000681","https://homosaurus.org/v3/homoit0001033","https://homosaurus.org/v3/homoit0001498"],"skos:related":["https://homosaurus.org/v3/homoit0000083","https://homosaurus.org/v3/homoit0000589","https://homosaurus.org/v3/homoit0000988","https://homosaurus.org/v3/homoit0001328"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85082015"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/masturbation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001001","dc:identifier":"homoit0001001","skos:prefLabel":"Motherhood","skos:altLabel":"Maternity","rdfs:comment":"The state, condition, or fact of being a mother.","skos:related":["https://homosaurus.org/v3/homoit0000116","https://homosaurus.org/v3/homoit0000811","https://homosaurus.org/v3/homoit0000864","https://homosaurus.org/v3/homoit0000871","https://homosaurus.org/v3/homoit0000905","https://homosaurus.org/v3/homoit0000914","https://homosaurus.org/v3/homoit0001021"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85087522"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001001"},"dc:replaces":{"@id":"http://homosaurus.org/v2/motherhood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001002","dc:identifier":"homoit0001002","skos:prefLabel":"Mati","rdfs:comment":"Surinamese-Creole women who have sexual relations with other women but also have had or do have relationships with men.","skos:broader":["https://homosaurus.org/v3/homoit0000202","https://homosaurus.org/v3/homoit0001510"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mati"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001003","dc:identifier":"homoit0001003","skos:prefLabel":"Metropolitan Community Church","skos:altLabel":"MCC","rdfs:comment":"Christian church founded in 1968 by Troy Perry as a welcoming spiritual gathering place for LGBT Christians; MCC is now an international denomination","skos:broader":"https://homosaurus.org/v3/homoit0000530","skos:related":"https://homosaurus.org/v3/homoit0001137","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000530"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000530"},"dc:replaces":{"@id":"http://homosaurus.org/v2/metropolitanCommunityChurch"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001005","dc:identifier":"homoit0001005","skos:prefLabel":"Medical practitioners' statements","rdfs:comment":"Official documents from medical practitioners (e.g., doctors, nurses, therapists) diagnosing a patient's gender dysphoria and, typically, recommending gender-affirming healthcare; sometimes required for an individual's gender-affirming healthcare to be covered under insurance or for an individual to legally change their name or gender marker.","skos:broader":"https://homosaurus.org/v3/homoit0001053","skos:related":["https://homosaurus.org/v3/homoit0000119","https://homosaurus.org/v3/homoit0000377","https://homosaurus.org/v3/homoit0000573","https://homosaurus.org/v3/homoit0001004","https://homosaurus.org/v3/homoit0001465"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/medicalPractitionersStatements"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001006","dc:identifier":"homoit0001006","skos:prefLabel":["Medicalization","Medicalisation"],"rdfs:comment":"Process by which human conditions and experiences come to be defined and treated as medical conditions and thus become the subject of medical study, diagnosis, prevention, and/or treatment. Use in reference to non-medical problems, such as LGBTQ+ identities and practices, that have been wrongly treated as medical issues.","skos:broader":"https://homosaurus.org/v3/homoit0001004","skos:narrower":["https://homosaurus.org/v3/homoit0000395","https://homosaurus.org/v3/homoit0000572","https://homosaurus.org/v3/homoit0000669","https://homosaurus.org/v3/homoit0001296","https://homosaurus.org/v3/homoit0001463","https://homosaurus.org/v3/homoit0001468","https://homosaurus.org/v3/homoit0001469"],"skos:related":["https://homosaurus.org/v3/homoit0000062","https://homosaurus.org/v3/homoit0000357","https://homosaurus.org/v3/homoit0000567","https://homosaurus.org/v3/homoit0001268","https://homosaurus.org/v3/homoit0001320","https://homosaurus.org/v3/homoit0002835","https://homosaurus.org/v3/homoit0002841"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2016000450"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/medicalisation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001007","dc:identifier":"homoit0001007","skos:prefLabel":"Medication","skos:altLabel":"Pharmaceuticals","rdfs:comment":"Non-recreational drugs as used by members of the LGBTQ+ community.","skos:broader":"https://homosaurus.org/v3/homoit0001366","skos:narrower":["https://homosaurus.org/v3/homoit0000399","https://homosaurus.org/v3/homoit0000650","https://homosaurus.org/v3/homoit0001091","https://homosaurus.org/v3/homoit0001130","https://homosaurus.org/v3/homoit0001138","https://homosaurus.org/v3/homoit0001981"],"skos:related":["https://homosaurus.org/v3/homoit0000317","https://homosaurus.org/v3/homoit0000380"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85039719"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/medication"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001008","dc:identifier":"homoit0001008","skos:prefLabel":"Men","rdfs:comment":"Adults who self-identify as men and understand their gender in terms of Western conceptions of manliness, maleness, and/or masculinity. The term has typically been defined as adult male humans, though not all men identify with the term \"male\" depending on the context in which it is used.","skos:broader":"https://homosaurus.org/v3/homoit0000571","skos:narrower":["https://homosaurus.org/v3/homoit0000160","https://homosaurus.org/v3/homoit0000270","https://homosaurus.org/v3/homoit0000506","https://homosaurus.org/v3/homoit0000626","https://homosaurus.org/v3/homoit0001009","https://homosaurus.org/v3/homoit0001643","https://homosaurus.org/v3/homoit0002278","https://homosaurus.org/v3/homoit0003223"],"skos:related":["https://homosaurus.org/v3/homoit0000271","https://homosaurus.org/v3/homoit0000322","https://homosaurus.org/v3/homoit0000563","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001509","https://homosaurus.org/v3/homoit0002182"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85083510"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/men"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001009","dc:identifier":"homoit0001009","skos:prefLabel":"Men who have sex with men","skos:altLabel":"MSM","rdfs:comment":"Men who engage in sexual activity with other men, whether or not they identify as gay or bisexual.","skos:broader":["https://homosaurus.org/v3/homoit0000915","https://homosaurus.org/v3/homoit0001008"],"skos:related":["https://homosaurus.org/v3/homoit0000095","https://homosaurus.org/v3/homoit0000160","https://homosaurus.org/v3/homoit0000365","https://homosaurus.org/v3/homoit0000506","https://homosaurus.org/v3/homoit0001254","https://homosaurus.org/v3/homoit0001297"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/menWhoHaveSexWithMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001010","dc:identifier":"homoit0001010","skos:prefLabel":"Men's movement","rdfs:comment":"Movement that began in the 1960s and 1970s (primarily in the United States, United Kingdom, and Australia) in response to the women's movement. Consists of groups and organizations of men and their allies working to address gender issues and their impact on men. Different men's movement groups vary significantly in how they frame their relationship to the women's movement and society at large. Not to be confused with the men's or father's rights movement, which focuses on perceived inequalities faced by men and seeks to maintain patriarchal values.","skos:broader":"https://homosaurus.org/v3/homoit0001322","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh92002382"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mensMovement"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001012","dc:identifier":"homoit0001012","skos:prefLabel":"Mental health care for LGBTQ+ people","skos:altLabel":"Mental health care for LGBTQ people","rdfs:comment":"Organized measures taken for the diagnosis, maintenance, treatment, or improvement of mental health or psychological well being; use in reference to mental health care addressing the particular needs of LGBTQ+ individuals or communities.","skos:broader":"https://homosaurus.org/v3/homoit0000614","skos:narrower":["https://homosaurus.org/v3/homoit0000953","https://homosaurus.org/v3/homoit0001551"],"skos:related":["https://homosaurus.org/v3/homoit0000349","https://homosaurus.org/v3/homoit0000351","https://homosaurus.org/v3/homoit0000952","https://homosaurus.org/v3/homoit0001366"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000614"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mentalHealthCareForLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001013","dc:identifier":"homoit0001013","skos:prefLabel":"Metis","rdfs:comment":"Officially recognized third gender in Nepal; predominantly used to refer to transgender women.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/metis"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001014","dc:identifier":"homoit0001014","skos:prefLabel":"Micropenis","skos:altLabel":"Microphallus","rdfs:comment":"A person born with a micropenis has a penis that is smaller than the typical size range for an infant. People may also develop a micropenis as a result of several different intersex variations. The size of a person’s penis does not generally affect its functionality.","skos:broader":"https://homosaurus.org/v3/homoit0000669","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/micropenis"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001015","dc:identifier":"homoit0001015","skos:prefLabel":"Misandry","rdfs:comment":"Hate or dislike of men or boys.","skos:related":"https://homosaurus.org/v3/homoit0000112","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh89000857"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001015"},"dc:replaces":{"@id":"http://homosaurus.org/v2/misandry"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001016","dc:identifier":"homoit0001016","skos:prefLabel":"Misgendering","rdfs:comment":"The act of referring to a person's gender incorrectly, often by using pronouns they do not identify with.","skos:related":["https://homosaurus.org/v3/homoit0000336","https://homosaurus.org/v3/homoit0000571","https://homosaurus.org/v3/homoit0001135","https://homosaurus.org/v3/homoit0002259"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001016"},"dc:replaces":{"@id":"http://homosaurus.org/v2/misgendering"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001017","dc:identifier":"homoit0001017","skos:prefLabel":"Misogyny","rdfs:comment":"Hate or dislike of women or girls.","skos:narrower":"https://homosaurus.org/v3/homoit0002183","skos:related":["https://homosaurus.org/v3/homoit0000112","https://homosaurus.org/v3/homoit0001133","https://homosaurus.org/v3/homoit0001892","https://homosaurus.org/v3/homoit0001903","https://homosaurus.org/v3/homoit0001904"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85086002"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001017"},"dc:replaces":{"@id":"http://homosaurus.org/v2/misogyny"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001018","dc:identifier":"homoit0001018","skos:prefLabel":"LGBTQ+ mistresses (BDSM culture)","skos:altLabel":["Mistresses (LGBTQ)","LGBTQ+ mistresses"],"rdfs:comment":"LGBTQ+ women who are part of the BDSM scene and assume the mistress role in sexual relationships with a mistress/submissive dynamic.","skos:broader":["https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001304","https://homosaurus.org/v3/homoit0001376"],"skos:narrower":["https://homosaurus.org/v3/homoit0000161","https://homosaurus.org/v3/homoit0000751","https://homosaurus.org/v3/homoit0001186","https://homosaurus.org/v3/homoit0001421","https://homosaurus.org/v3/homoit0002992"],"skos:related":["https://homosaurus.org/v3/homoit0000363","https://homosaurus.org/v3/homoit0000999","https://homosaurus.org/v3/homoit0001133","https://homosaurus.org/v3/homoit0001318"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mistressesLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001019","dc:identifier":"homoit0001019","skos:prefLabel":"Monogamy","rdfs:comment":"Relationship orientation in which individuals are exclusively committed to one partner at a time.","skos:broader":["https://homosaurus.org/v3/homoit0001081","https://homosaurus.org/v3/homoit0001302","https://homosaurus.org/v3/homoit0001636"],"skos:related":["https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001555","https://homosaurus.org/v3/homoit0001916"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005004443"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001300"},"dc:replaces":{"@id":"http://homosaurus.org/v2/monogamy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001300","dc:identifier":"homoit0001300","skos:prefLabel":"Sexual preference","rdfs:comment":"An enduring pattern of sexual attraction towards a certain sex or multiple sexes, as well as characterizations, objects, situational fantasies, or behaviors; generally understood to be either or both biologically determined and culturally and/or sociologically dictated.","skos:narrower":["https://homosaurus.org/v3/homoit0000036","https://homosaurus.org/v3/homoit0000344","https://homosaurus.org/v3/homoit0000442","https://homosaurus.org/v3/homoit0000997","https://homosaurus.org/v3/homoit0001081","https://homosaurus.org/v3/homoit0001094","https://homosaurus.org/v3/homoit0001250","https://homosaurus.org/v3/homoit0001304","https://homosaurus.org/v3/homoit0001558","https://homosaurus.org/v3/homoit0001814"],"skos:related":["https://homosaurus.org/v3/homoit0000242","https://homosaurus.org/v3/homoit0000303","https://homosaurus.org/v3/homoit0001095","https://homosaurus.org/v3/homoit0001286","https://homosaurus.org/v3/homoit0001287","https://homosaurus.org/v3/homoit0001290","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001296","https://homosaurus.org/v3/homoit0001297","https://homosaurus.org/v3/homoit0001298","https://homosaurus.org/v3/homoit0001302","https://homosaurus.org/v3/homoit0001311","https://homosaurus.org/v3/homoit0001315","https://homosaurus.org/v3/homoit0001493","https://homosaurus.org/v3/homoit0001556","https://homosaurus.org/v3/homoit0001915","https://homosaurus.org/v3/homoit0001917","https://homosaurus.org/v3/homoit0003738"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh91005179"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001300"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualPreference"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001020","dc:identifier":"homoit0001020","skos:prefLabel":"Mosaicism involving \"sex\" chromosomes","rdfs:comment":"People with mosaic chromosomes have different chromosome patterns in some cells of their body than in others. Mosaicism results from random differences in how cells divide while an embryo is growing, resulting in different numbers of chromosomes in different cells (such as 45X/46XX or 45X/46XY, which are both variants of Turner syndrome, or 46XY/47XXY or 46XX/47XXY, which are both variants of Klinefelter syndrome). If someone specifically has 46XX chromosomes in some cells and 46XY in others, their variation is probably chimerism instead of mosaicism. Having mosaic chromosomes can cause someone to develop variations in their genitals, gonads, or hormone function. For example, if they have at least one Y chromosome, they may have both ovarian and testicular tissue, or genital differences like hypospadias, or they may develop some secondary sex characteristics at puberty that are not expected for the sex they were assigned. People who have mosaicism without a Y chromosome (e.g., 45X/46XX, or 46XX/47XXX) may have streak gonads or ovaries that stop functioning at an earlier age than typical, which can affect development during puberty and fertility. Other people may not have any noticeable signs of their mosaicism at all.","skos:broader":"https://homosaurus.org/v3/homoit0000669","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85087417"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mosaicismInvolvingSexChromosomes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001021","dc:identifier":"homoit0001021","skos:prefLabel":"Mothers","rdfs:comment":"People who are mothers.","skos:broader":"https://homosaurus.org/v3/homoit0000421","skos:narrower":["https://homosaurus.org/v3/homoit0000838","https://homosaurus.org/v3/homoit0000942","https://homosaurus.org/v3/homoit0002343","https://homosaurus.org/v3/homoit0002348","https://homosaurus.org/v3/homoit0002795","https://homosaurus.org/v3/homoit0002916","https://homosaurus.org/v3/homoit0003243"],"skos:related":["https://homosaurus.org/v3/homoit0000752","https://homosaurus.org/v3/homoit0000905","https://homosaurus.org/v3/homoit0001001"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85087526"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mothers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001022","dc:identifier":"homoit0001022","skos:prefLabel":"Mothers of bisexual people","rdfs:comment":"A person who assumes the role of mother to a bisexual person; use only for individuals who self-identify as mothers.","skos:broader":"https://homosaurus.org/v3/homoit0002348","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mothersOfBisexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001023","dc:identifier":"homoit0001023","skos:prefLabel":"Mothers of gay men","rdfs:comment":"A person who assumes the role of mother to a gay man; use only for individuals who self-identify as mothers.","skos:broader":"https://homosaurus.org/v3/homoit0002348","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mothersOfGayMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001024","dc:identifier":"homoit0001024","skos:prefLabel":"Mothers of lesbians","rdfs:comment":"A person who assumes the role of mother to a lesbian; use only for individuals who self-identify as mothers.","skos:broader":"https://homosaurus.org/v3/homoit0002348","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mothersOfLesbians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001025","dc:identifier":"homoit0001025","skos:prefLabel":"Mothers of transgender people","rdfs:comment":"A person who assumes the role of mother to a transgender person; use only for individuals who self-identify as mothers.","skos:broader":"https://homosaurus.org/v3/homoit0002348","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mothersOfTransgenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001026","dc:identifier":"homoit0001026","skos:prefLabel":"LGBTQ+ movement","skos:altLabel":"Movement (LGBTQ)","rdfs:comment":"Refers to various social and political movements aimed at securing equity and equal representation for LGBTQ+ people.","skos:broader":"https://homosaurus.org/v3/homoit0001322","skos:narrower":["https://homosaurus.org/v3/homoit0000162","https://homosaurus.org/v3/homoit0000510","https://homosaurus.org/v3/homoit0000672","https://homosaurus.org/v3/homoit0000753","https://homosaurus.org/v3/homoit0001187","https://homosaurus.org/v3/homoit0001423","https://homosaurus.org/v3/homoit0002796"],"skos:related":["https://homosaurus.org/v3/homoit0000024","https://homosaurus.org/v3/homoit0000276","https://homosaurus.org/v3/homoit0000538","https://homosaurus.org/v3/homoit0001905","https://homosaurus.org/v3/homoit0002713","https://homosaurus.org/v3/homoit0003695"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/movementLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001027","dc:identifier":"homoit0001027","skos:prefLabel":"MtXs","rdfs:comment":"People who transition from male to unknown or not male.","skos:broader":"https://homosaurus.org/v3/homoit0001378","skos:related":["https://homosaurus.org/v3/homoit0000436","https://homosaurus.org/v3/homoit0000457","https://homosaurus.org/v3/homoit0000986","https://homosaurus.org/v3/homoit0001518"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mtxs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001028","dc:identifier":"homoit0001028","skos:prefLabel":"Mud sex","rdfs:comment":"Sexual activities that take place outside in mud.","skos:broader":["https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001299"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mudSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001029","dc:identifier":"homoit0001029","skos:prefLabel":"Mukhannathun","skos:altLabel":"Mukhannaths","rdfs:comment":"A term used in classical Arabic to refer to men who are perceived as e