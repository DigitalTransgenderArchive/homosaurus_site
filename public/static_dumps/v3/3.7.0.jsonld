d":"https://homosaurus.org/v4/homoit0002650","dc:identifier":"homoit0002650","skos:prefLabel":"Two-Spirit mystery and detective fiction ","skos:altLabel":["2S mystery and detective fiction ","Two Spirit mystery and detective fiction  ","Two Spirited mystery and detective fiction ","Two-Spirited mystery and detective fiction "],"rdfs:comment":"Written literary works about the investigation of crime or the work of detectives; use in reference to mystery and detective fiction focusing on Two-Spirit characters and themes.","skos:related":["https://homosaurus.org/v3/homoit0000443","https://homosaurus.org/v3/homoit0000852"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002650"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002651","dc:identifier":"homoit0002651","skos:prefLabel":"Two-Spirit romance fiction ","skos:altLabel":["2S romance fiction ","Two Spirit romance fiction ","Two Spirited romance fiction ","Two-Spirited romance fiction "],"rdfs:comment":"Works of fiction revolving around romantic and/or sexual relationships between the main characters; use in reference to romance fiction focusing on Two-Spirit characters.","skos:related":["https://homosaurus.org/v3/homoit0000443","https://homosaurus.org/v3/homoit0001586"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002651"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002652","dc:identifier":"homoit0002652","skos:prefLabel":"Non-binary disabled people","skos:altLabel":["Disabled non-binary people","Non-binary people with disabilities"],"rdfs:comment":"Non-binary people who are disabled.","skos:broader":"https://homosaurus.org/v3/homoit0001854","skos:narrower":["https://homosaurus.org/v3/homoit0003005","https://homosaurus.org/v3/homoit0003011","https://homosaurus.org/v3/homoit0003016","https://homosaurus.org/v3/homoit0003021","https://homosaurus.org/v3/homoit0003027"],"skos:related":"https://homosaurus.org/v3/homoit0003026","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002653","dc:identifier":"homoit0002653","skos:prefLabel":"MVPFAFF+","rdfs:comment":"Acronym used to describe Pasifika/Pacific Islander gender diverse identities as a group. The acronym includes Māhū (Hawai'i and Tahiti), Vaka sa lewa lewa (Fiji), Palopa (Papua New Guinea), Fa’afafine (Samoa), Akava’ine (Rarotonga), Fakaleitī (Tonga), Fakafifine (Niue), and more.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:narrower":["https://homosaurus.org/v3/homoit0000035","https://homosaurus.org/v3/homoit0000413","https://homosaurus.org/v3/homoit0000419","https://homosaurus.org/v3/homoit0000979","https://homosaurus.org/v3/homoit0001499","https://homosaurus.org/v3/homoit0001502"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002654","dc:identifier":"homoit0002654","skos:prefLabel":"Māhūkāne","skos:altLabel":"Mahukane","rdfs:comment":"A term coined by the Kānaka Maoli (Native Hawaiian) queer community in the early 2000s that blends the term Māhū (for third gender indigenous people of Hawai'i and Tahiti who blend genders and often hold spiritual roles) and kāne (man).","skos:broader":"https://homosaurus.org/v3/homoit0000979","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002655","dc:identifier":"homoit0002655","skos:prefLabel":"Māhūwahine","skos:altLabel":"Mahuwahine","rdfs:comment":"A term coined by the Kānaka Maoli (Native Hawaiian) queer community in the early 2000s that blends the term Māhū (for third gender indigenous people of Hawai'i and Tahiti who blend genders and often hold spiritual roles) and wahine (woman).","skos:broader":"https://homosaurus.org/v3/homoit0000979","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002656","dc:identifier":"homoit0002656","skos:prefLabel":"Two-Spirit activism","skos:altLabel":["2S activism","Two Spirit activism","Two Spiritied activism","Two-Spirited activism"],"rdfs:comment":"Direct action and organizing to achieve political or social change and acceptance for Two-Spirit people.","skos:related":["https://homosaurus.org/v3/homoit0000006","https://homosaurus.org/v3/homoit0002657","https://homosaurus.org/v3/homoit0003531"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002656"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0