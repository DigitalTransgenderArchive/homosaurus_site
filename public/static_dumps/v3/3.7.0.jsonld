homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-21"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003432","dc:identifier":"homoit0003432","skos:prefLabel":"Queer graphic novels","rdfs:comment":"Works consisting of sequential images often accompanied by text that generally contain stand-alone stories; used in reference to graphic novels focusing on queer characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000874","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-21"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003433","dc:identifier":"homoit0003433","skos:prefLabel":"Child sexual abuse content","skos:altLabel":["CSA content","CSA materials","Child pornography","Child sexual abuse materials"],"rdfs:comment":"Images and videos that show children and youth who are under the age of consent engaged in sexual activities. While this term is not otherwise within the scope of the Homosaurus vocabulary, it is provided as an alternative to commonly used terms such as \"Child pornography\" in order to highlight that the production of such materials is a direct product of and contributes to the sexual abuse of children.","skos:broader":"https://homosaurus.org/v3/homoit0001305","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85023536"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001305"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-21"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003434","dc:identifier":"homoit0003434","skos:prefLabel":"Queer painters","rdfs:comment":"Queer people who paint, either professionally or as a hobby.","skos:broader":"https://homosaurus.org/v3/homoit0003511","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003435","dc:identifier":"homoit0003435","skos:prefLabel":"Intersex painters","rdfs:comment":"Intersex people who paint, either professionally or as a hobby.","skos:broader":"https://homosaurus.org/v3/homoit0003511","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003436","dc:identifier":"homoit0003436","skos:prefLabel":"Two-Spirit painters","skos:altLabel":["2S painters","Two Spirit painters","Two-Spirited painters"],"rdfs:comment":"Two-Spirit people who paint, either professionally or as a hobby.","skos:broader":"https://homosaurus.org/v3/homoit0002678","skos:related":"https://homosaurus.org/v3/homoit0003511","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003437","dc:identifier":"homoit0003437","skos:prefLabel":"Non-binary painters","skos:altLabel":"Nonbinary painters","rdfs:comment":"Non-binary people who paint, either prof