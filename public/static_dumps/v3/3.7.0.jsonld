mosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bakla"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000092","dc:identifier":"homoit0000092","skos:prefLabel":"Ball culture","skos:altLabel":["Ballroom community","Ballroom culture","Ballroom scene","Drag ball culture","House-ballroom culture"],"rdfs:comment":"A subculture that emerged in early 20th century New York City in which primarily African-American and Latin American LGBTQ+ people perform and compete for various prizes.","skos:broader":"https://homosaurus.org/v3/homoit0001345","skos:narrower":"https://homosaurus.org/v3/homoit0000094","skos:related":["https://homosaurus.org/v3/homoit0000095","https://homosaurus.org/v3/homoit0000368","https://homosaurus.org/v3/homoit0000370","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001494","https://homosaurus.org/v3/homoit0001900","https://homosaurus.org/v3/homoit0003505"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ballCulture"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000093","dc:identifier":"homoit0000093","skos:prefLabel":"Ballgags","rdfs:comment":"Silicone, rubber, or other types of balls that are strapped in a person’s mouth to prevent them from speaking, typically during sex.","skos:broader":"https://homosaurus.org/v3/homoit0001266","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ballgags"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000094","dc:identifier":"homoit0000094","skos:prefLabel":"Ballroom families","skos:altLabel":"Ballroom houses","rdfs:comment":"In ball culture, ballroom families (or houses) are chosen families headed by and named after established community members (e.g., the House of Xtravaganza); heads of ballroom families are typically called \"mothers\" or \"fathers,\" while members are termed \"children\" and \"siblings.\"","skos:broader":["https://homosaurus.org/v3/homoit0000092","https://homosaurus.org/v3/homoit0000834"],"skos:related":"https://homosaurus.org/v3/homoit0000371","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ballroomFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000095","dc:identifier":"homoit0000095","skos:prefLabel":"Banjees","rdfs:comment":"Term from the 1980s (or earlier) that describes a certain type of young Latin American or African American man who has sex with men and who dresses in stereotypical masculine urban fashion.","skos:broader":["https://homosaurus.org/v3/homoit0000878","https://homosaurus.org/v3/homoit0001295"],"skos:related":["https://homosaurus.org/v3/homoit0000015","https://homosaurus.org/v3/homoit0000092","https://homosaurus.org/v3/homoit0000253","https://homosaurus.org/v3/homoit0000978","https://homosaurus.org/v3/homoit0001009","https://homosaurus.org/v3/homoit0002017"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/banjees"},"dc:issued":{"@type":"xsd:date","@v