usBodyParts"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000223","dc:identifier":"homoit0000223","skos:prefLabel":"Brothels","skos:altLabel":"Bordellos","rdfs:comment":"Establishments where clients pay to engage in sexual activity with sex workers. Brothels may be illegal, decriminalized, or legal operations.","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005004145"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000223"},"dc:replaces":{"@id":"http://homosaurus.org/v2/brothels"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000224","dc:identifier":"homoit0000224","skos:prefLabel":"Brotherboys","skos:altLabel":"Brothaboys","rdfs:comment":"Indigenous Australian term for people who transition from female to male.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":["https://homosaurus.org/v3/homoit0000436","https://homosaurus.org/v3/homoit0001314"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/brotherboys"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000225","dc:identifier":"homoit0000225","skos:prefLabel":"LGBTQ+ Buddhists","skos:altLabel":"Buddhists (LGBTQ)","rdfs:comment":"LGBTQ+ people who are Buddhist.","skos:broader":"https://homosaurus.org/v3/homoit0000928","skos:narrower":["https://homosaurus.org/v3/homoit0000138","https://homosaurus.org/v3/homoit0000480","https://homosaurus.org/v3/homoit0000728","https://homosaurus.org/v3/homoit0001165","https://homosaurus.org/v3/homoit0001398","https://homosaurus.org/v3/homoit0002988","https://homosaurus.org/v3/homoit0002989"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/buddhistsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000226","dc:identifier":"homoit0000226","skos:prefLabel":"LGBTQ+ peer support","skos:altLabel":["Buddy care for LGBTQ+ people","LGBTQ+ buddy care","Peer support for LGBTQ+ people"],"rdfs:comment":"A peer-to-peer form of healthcare support for LGBTQ+ people in which volunteers (sometimes called buddies) attend clinical visits with patients to provide emotional and logistical support.","skos:broader":"https://homosaurus.org/v3/homoit0000614","skos:related":["https://homosaurus.org/v3/homoit0000005","https://homosaurus.org/v3/homoit0000636"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000614"},"dc:replaces":{"@id":"http://homosaurus.org/v2/buddyCareForLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000614","dc:identifier":"homoit0000614","skos:prefLabel":"Health care for LGBTQ+ people","skos:altLabel":["Medical care for LGBTQ people","Health care for LGBTQ people"],"rdfs:comment":"Organized measures taken for the maintenance or improvement of health via the prevention, diagnosis, treatment, and/or cure of disease, illness, injury, or other conditions; use in reference to health care addressing the particular needs of LGBTQ+ individuals or communities.","skos:narrower":["https://homosaurus.org/v3/homoit0000226","https://homosaurus.org/v3/homoit0001012","https://homosaurus.org/v3/homoit0001113","https://homosaurus.org/v3/homoit0001360","https://homosaurus.org/v3/homoit0003361","https://homosaurus.org/v3/homoit0003514","https://homosaurus.org/v3/homoit0003657"],"skos:related":["https://homosaurus.org/v3/homoit0000030","https://homosaurus.org/v3/homoit0000876","https://homosaurus.org/v3/homoit0003504","https://homosaurus.org/v3/homoit0003694"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000614"},"dc:replaces":{"@id":"http://homosaurus.org/v2/healthCareForLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000227","dc:identifier":"homoit0000227","skos:prefLabel":"Sodomites","skos:altLabel":"Buggers","rdfs:comment":"Pejorative historical term for individuals who engage in sexual activities that are characterized as unnatural or immoral; commonly applied to gay men engaging in anal sex. Only use in historical contexts.","skos:broader":"https://homosaurus.org/v3/homoit0000878","skos:related":["https://homosaurus.org/v3/homoit0001297","https://homosaurus.org/v3/homoit0001325"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sodomites"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000228","dc:identifier":"homoit0000228","skos:prefLabel":"Bullying","rdfs:comment":"A form of aggressive behavior that can include verbal harassment, physical assault, or coercion. Bullying is typically directed repeatedly towards particular victims, often on the grounds of race, gender, sexuality, or ability.","skos:narrower":"https://homosaurus.org/v3/homoit0000324","skos:related":["https://homosaurus.org/v3/homoit0000611","https://homosaurus.org/v3/homoit0000920","https://homosaurus.org/v3/homoit0001989","https://homosaurus.org/v3/homoit0001998"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh89006054"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000228"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bullying"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000229","dc:identifier":"homoit0000229","skos:prefLabel":"Burrnesha","rdfs:comment":"In the Balkans, people assigned female at birth who take a vow of chastity and live as men.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/burrnesha"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000230","dc:identifier":"homoit0000230","skos:prefLabel":"Butch-femme relationships","rdfs:comment":"Romantic, sexual, or play relationships between a masculine-identifying or -presenting person and a feminine-identifying or -presenting person. Though the terms \"butch\" and \"femme\" are most commonly used in lesbian communities, they are also used by other LGBTQ+ people. Only use to describe relationships between individuals who self-identify as butch and femme.","skos:broader":["https://homosaurus.org/v3/homoit0000382","https://homosaurus.org/v3/homoit0001237"],"skos:related":["https://homosaurus.org/v3/homoit0000231","https://homosaurus.org/v3/homoit0000440","https://homosaurus.org/v3/homoit0001241","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001340"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2012003858"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/butchFemmeRelationships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000231","dc:identifier":"homoit0000231","skos:prefLabel":"Butches","rdfs:comment":"A masculine person of any gender, though this term is most commonly used in lesbian communities.","skos:broader":["https://homosaurus.org/v3/homoit0000577","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001304"],"skos:related":["https://homosaurus.org/v3/homoit0000215","https://homosaurus.org/v3/homoit0000230","https://homosaurus.org/v3/homoit0000384","https://homosaurus.org/v3/homoit0000432","https://homosaurus.org/v3/homoit0000440","https://homosaurus.org/v3/homoit0000556","https://homosaurus.org/v3/homoit0000568","https://homosaurus.org/v3/homoit0000995","https://homosaurus.org/v3/homoit0001327","https://homosaurus.org/v3/homoit0001340","https://homosaurus.org/v3/homoit0001374","https://homosaurus.org/v3/homoit0001499","https://homosaurus.org/v3/homoit0002061"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001241"},"dc:replaces":{"@id":"http://homosaurus.org/v2/butches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org