rited drama","Two-Spirited drama"],"rdfs:comment":"Works of fiction written to be performed; use in reference to dramatic works focusing on Two-Spirit characters or themes.","skos:related":"https://homosaurus.org/v3/homoit0000376","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002691"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002692","dc:identifier":"homoit0002692","skos:prefLabel":"Two-Spirit employment","skos:altLabel":["2S employment","Two Spirit employment","Two Spirited employment","Two-Spirited employment"],"rdfs:comment":"Employment of Two-Spirit people","skos:related":"https://homosaurus.org/v3/homoit0001717","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002692"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002693","dc:identifier":"homoit0002693","skos:prefLabel":"Two-Spirit hard of hearing people","skos:altLabel":["2S hard of hearing people","Two Spirit hard of hearing people","Two Spirited hard of hearing people","Two-Spirited hard of hearing people"],"rdfs:comment":"Two-Spirit people with significant or total hearing loss who may or may not consider themselves d/Deaf.","skos:broader":"https://homosaurus.org/v3/homoit0002682","skos:related":"https://homosaurus.org/v3/homoit0001860","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002694","dc:identifier":"homoit0002694","skos:prefLabel":"Two-Spirit people with chronic illnesses","skos:altLabel":["2S people with chronic illnesses","Chronically ill 2S people","Chronically ill Two Spirit people","Chronically ill Two Spirited people","Chronically ill Two-Spirited people","Two Spirit people with chronic illnesses","Two Spirited people with chronic illnesses","Two-Spirited people with chronic illnesses"],"rdfs:comment":"Two-Spirit people who have long-term health conditions that require continued medical attention and/or significantly impact or limit daily life; some but not all people with chronic illnesses consider themselves disabled.","skos:related":["https://homosaurus.org/v3/homoit0001879","https://homosaurus.org/v3/homoit0002682"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002694"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002695","dc:identifier":"homoit0002695","skos:prefLabel":"Two-Spirit wheelchair users","skos:altLabel":["2S wheelchair users","Two Spirit wheelchair users","Two Spirited wheelchair users","Two-Spirited wheelchair users"],"rdfs:comment":"Two-Spirit people who use wheelchairs.","skos:broader":"https://homosaurus.org/v3/homoit0002682","skos:related":"https://homosaurus.org/v3/homoit0001877","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002696","dc:identifier":"homoit0002696","skos:prefLabel":"Two-Spirit information centers","skos:altLabel":["2S information centers","Two Spirit information centers","Two Spirited information centers","Two-Spirit information centres","Two-Spirited information centers"],"rdfs:comment":"Institutions providing education, support, and information about Two-Spirit issues and Two-Spirit communities to Two-Spirit people.","skos:related":"https://homosaurus.org/v3/homoit0000660","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002696"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002697","dc:identifier":"homoit0002697","skos:prefLabel":"Two-Spirit libraries","skos:altLabel":["2S libraries","Two Spirit libraries","Two Spirited libraries","Two-Spirited libraries"],"rdfs:comment":"Libraries that hold materials primarily pertaining to Two-Spirit people or intended for use by Two-Spirit people.","skos:related":"https://homosaurus.org/v3/homoit0000968","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002697"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002698","dc:identifier":"homoit0002698","skos:prefLabel":"Two-Spirit literary criticism","skos:altLabel":["2S literary criticism","Two Spirit literary criticism","Two Spirited literary criticism","Two-Spirited literary criticism"],"rdfs:comment":"The study, evaluation, and interpretation of literary works focusing on Two-Spirit characters or themes; can also include interpretation of literature through the lens and frameworks of Two-Spirit studies.","skos:related":"https://homosaurus.org/v3/homoit0001602","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002698"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002699","dc:identifier":"homoit0002699","skos:prefLabel":"Gender dysphoria in children","rdfs:comment":"A psychological diagnosis (replacing the outdated and offensive \"gender identity disorder\") used to describe the sense of unease or dissatisfaction an individual feels as a result of incongruence between their gender identity and their assigned gender, gender expression, and/or the way their gender is perceived by others. This term is also used colloquially by individuals to describe the discomfort and distress they experience as a result of this incongruence. Though gender dysphoria is often associated with trans people, people of any identity may experience gender dysphoria when they do not feel \"right\" in their body or the way their gender is being expressed. Use this particular term for works about children who experience or have experienced gender dysphoria.","skos:broader":"https://homosaurus.org/v3/homoit0000567","skos:related":["https://homosaurus.org/v3/homoit0000256","https://homosaurus.org/v3/homoit0000568","https://homosaurus.org/v3/homoit0000571","https://homosaurus.org/v3/homoit0002256"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000567"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002700","dc:identifier":"homoit0002700","skos:prefLabel":"Gender dysphoria in youth","skos:altLabel":["Gender dysphoria in adolescence","Gender dysphoria in adolescents"],"rdfs:comment":"A psychological diagnosis (replacing the outdated and offensive \"gender identity disorder\") used to describe the sense of unease or dissatisfaction an individual feels as a result of incongruence between their gender identity and their assigned gender, gender expression, and/or the way their gender is perceived by others. This term is also used colloquially by individuals to describe the discomfort and distress they experience as a result of this incongruence. Though gender dysphoria is often associated with trans people, people of any identity may experience gender dysphoria when they do not feel \"right\" in their body or the way their gender is being expressed. Use this particular term for works about adolescents (people between the ages of childhood and adulthood) who experience or have experience gender dysphoria.","skos:broader":"https://homosaurus.org/v3/homoit0000567","skos:related":["https://homosaurus.org/v3/homoit0000568","https://homosaurus.org/v3/homoit0000571","https://homosaurus.org/v3/homoit0001521","https://homosaurus.org/v3/homoit0002256"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000567"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002701","dc:identifier":"homoit0002701","skos:prefLabel":"LGBTQ+ comedians","skos:altLabel":"LGBTQ+ comics (Persons)","rdfs:comment":"LGBTQ+ people who seek to entertain an audience by making them laugh, through jokes, slapstick, employing prop comedy, or other amusing means.","skos:narrower":["https://homosaurus.org/v3/homoit0002702","https://homosaurus.org/v3/homoit0002703","https://homosaurus.org/v3/homoit0002704","https://homosaurus.org/v3/homoit0002705","https://homosaurus.org/v3/homoit0002706","https://homosaurus.org/v3/homoit0002707","https://homosaurus.org/v3/homoit0002708"],"skos:related":"https://homosaurus.org/v3/homoit0002709","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002701"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002702","dc:identifier":"homoit0002702","skos:prefLabel":"Gay comedians","skos:altLabel":"Gay comics (Persons)","rdfs:comment":"Gay people who seek to entertain an audience by making them laugh, through jokes, slapstick, employing prop comedy, or other amusing means.","skos:broader":"https://homosaurus.org/v3/homoit0002701","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2019100096"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002701"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002703","dc:identifier":"homoit0002703","skos:prefLabel":"Lesbian comedians","skos:altLabel":"Lesbian comics (Persons)","rdfs:comment":"Lesbians who seek to entertain an audience by making them laugh, through jokes, slapstick, employing prop comedy, or other amusing means.","skos:broader":"https://homosaurus.org/v3/homoit0002701","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002701"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002704","dc:identifier":"homoit0002704","skos:prefLabel":"Bisexual comedians","skos:altLabel":"Bisexual comics (Persons)","rdfs:comment":"Bisexual people who seek to entertain an audience by making them laugh, through jokes, slapstick, employing prop comedy, or other amusing means.","skos:broader":"https://homosaurus.org/v3/homoit0002701","skos:hasTopC