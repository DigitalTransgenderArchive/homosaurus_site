olent resistance","skos:altLabel":"LGBTQ nonviolent resistance","rdfs:comment":"Actions taken to promote social change for LGBTQ+ people and communities through non-violent means, including protests, boycotts, and organized non-cooperation.","skos:broader":"https://homosaurus.org/v3/homoit0000853","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQNonviolentResistance"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000911","dc:identifier":"homoit0000911","skos:prefLabel":"LGBTQ+ obituaries","skos:altLabel":"LGBTQ obituaries","rdfs:comment":"Public notices published shortly after an LGBTQ+ person's death to inform others of their passing and celebrate their life.","skos:broader":"https://homosaurus.org/v3/homoit0001042","skos:related":["https://homosaurus.org/v3/homoit0000848","https://homosaurus.org/v3/homoit0000849","https://homosaurus.org/v3/homoit0002258"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQObituaries"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000912","dc:identifier":"homoit0000912","skos:prefLabel":"LGBTQ+ Old Catholics","skos:altLabel":"LGBTQ+ Old Catholic Church","rdfs:comment":"LGBTQ+ members of the anti-papal-primacy Christian denomination that originated with groups that split from the Holy See because they disagreed with essential doctrines.","skos:broader":"https://homosaurus.org/v3/homoit0000265","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},