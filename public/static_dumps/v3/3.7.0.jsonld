n 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002563","dc:identifier":"homoit0002563","skos:prefLabel":"Asexual films ","rdfs:comment":"Motion pictures, or movies, created by asexual directors, depicting asexual people, or that are regarded as important within asexual culture.","skos:broader":"https://homosaurus.org/v3/homoit0000869","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002564","dc:identifier":"homoit0002564","skos:prefLabel":"Demisexual films","rdfs:comment":"Motion pictures, or movies, created by demisexual directors, depicting demisexual people, or that are regarded as important within demisexual culture.","skos:broader":"https://homosaurus.org/v3/homoit0000869","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002565","dc:identifier":"homoit0002565","skos:prefLabel":"Non-binary fiction","rdfs:comment":"Written works describing imagined events or people; use in reference to fictional works focusing on non-binary characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000443","skos:narrower":["https://homosaurus.org/v3/homoit0002566","https://homosaurus.org/v3/homoit0002567","https://homosaurus.org/v3/homoit0002568","https://homosaurus.org/v3/homoit0002570","https://homosaurus.org/v3/homoit0002571"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002566","dc:identifier":"homoit0002566","skos:prefLabel":"Non-binary romance fiction","rdfs:comment":"Written works of fiction revolving around romantic and/or sexual relationships between the main characters; use in reference to romance fiction focusing on non-binary characters.","skos:broader":["https://homosaurus.org/v3/homoit0001586","https://homosaurus.org/v3/homoit0002565"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002567","dc:identifier":"homoit0002567","skos:prefLabel":"Non-binary mystery and detective fiction","rdfs:comment":"Written literary works about the investigation of crime or the work of detectives; use in reference to mystery and detective fiction focusing on non-binary characters or themes.","skos:broader":["https://homosaurus.org/v3/homoit0000852","https://homosaurus.org/v3/homoit0002565"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002568","dc:identifier":"homoit0002568","skos:prefLabel":"Non-binary horror fiction","rdfs:comment":"Written works of fiction intended to frighten, scare, or disgust; use in reference to horror fiction focusing on non-binary characters or themes.","skos:broader":["https://homosaurus.org/v3/homoit0001580","https://homosaurus.org/v3/homoit0002565"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002569","dc:identifier":"homoit0002569","skos:prefLabel":"Non-binary graphic novels","rdfs:comment":"Works consisting of sequential images often accompanied by text that generally contain stand-alone stories; used in reference to graphic novels focusing on non-binary characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000874","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002570","dc:identifier":"homoit0002570","skos:prefLabel":"Non-binary science fiction","rdfs:comment":"Written literary work about imaginative or futuristic concepts incorporating science, technology, space, time travel, and other speculative elements; use in reference to science fiction focusing on non-binary characters or themes.","skos:broader":["https://homosaurus.org/v3/homoit0000934","https://homosaurus.org/v3/homoit0002565"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002571","dc:identifier":"homoit0002571","skos:prefLabel":"Non-binary fantasy fiction","rdfs:comment":"Genre that uses magic and other supernatural phenomena as a primary element of plot, theme, and/or setting; use for fantasy fiction focusing on non-binary characters or themes.","skos:broader":["https://homosaurus.org/v3/homoit0000865","https://homosaurus.org/v3/homoit0002565"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002572","dc:identifier":"homoit0002572","skos:prefLabel":"Non-binary erotic literature","rdfs:comment":"Literary works that have erotic or sexual elements; use in reference to erotic literature focusing on non-binary characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000859","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000403"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002573","dc:identifier":"homoit0002573","skos:prefLabel":"Non-binary porn films","rdfs:comment":"Erotic or sexually explicit films featuring non-binary people.","skos:broader":"https://homosaurus.org/v3/homoit0000013","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002574","dc:identifier":"homoit0002574","skos:prefLabel":"Non-binary short stories","rdfs:comment":"Written literary works that are short in length and detail a self-contained incident or concept; use in reference to short stories focusing on non-binary characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0001608","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002575","dc:identifier":"homoit0002575","skos:prefLabel":"Non-binary comics","rdfs:comment":"Works consisting of sequential images often accompanied by text; use in reference to comics focusing on non-binary characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000841","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002576","dc:identifier":"homoit0002576","skos:prefLabel":"Non-binary poetry","rdfs:comment":"Literary work, typically written in verse, that focuses on non-binary characters, themes, or identity.","skos:broader":"https://homosaurus.org/v3/homoit0001118","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002577","dc:identifier":"homoit0002577","skos:prefLabel":"Queercrip","skos:altLabel":"Cripqueer","rdfs:comment":"A portmanteau of two reclaimed terms (queer and crip) used to indicate that a person or a thing belongs to both queer and crip communities, often used to indicate unity or shared struggles. This term may also appear as \"cripqueer\" to emphasize the crip identity before the queer one.\t\t\t\t","skos:broader":"https://homosaurus.org/v3/homoit0001559","skos:related":["https://homosaurus.org/v3/homoit0001149","https://homosaurus.org/v3/homoit0001195","https://homosaurus.org/v3/homoit0001854","https://homosaurus.org/v3/homoit0001879","https://homosaurus.org/v3/homoit0001891"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001317"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002578","dc:identifier":"homoit0002578","skos:prefLabel":"69ing ","skos:altLabel":["69'ing","69-ing","69","Sixty-Nining"],"rdfs:comment":"69ing refers to an act of shared oral sex between two people simultaneously giving and receiving oral sex, said to look similar to the number 69.","skos:broader":"https://homosaurus.org/v3/homoit0000593","skos:related":["https://homosaurus.org/v3/homoit0000212","https://homosaurus.org/v3/homoit0000239"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85095239"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002579","dc:identifier":"homoit0002579","skos:prefLabel":"LGBTQ+ erotic art","rdfs:comment":"Umbrella term for different forms of creative activity dealing with or engaging with erotic themes, including visual, material, and performing art, by LGBTQ+ artists or about LGBTQ+ topics and communities. Use a more specific term if possible.","skos:broader":"https://homosaurus.org/v3/homoit0000816","skos:narrower":["https://homosaurus.org/v3/homoit0000013","https://homosaurus.org/v3/homoit0002607","https://homosaurus.org/v3/homoit0002608","https://homosaurus.org/v3/homoit0002609","https://homosaurus.org/v3/homoit0002610","https://homosaurus.org/v3/homoit0002611","https://homosaurus.org/v3/homoit0002612","https://homosaurus.org/v3/homoit0002613","https://homosaurus.org/v3/homoit0002614","https://homosaurus.org/v3/homoit0002615"],"skos:related":["https://homosaurus.org/v3/homoit0001052","https://homosaurus.org/v3/homoit0002544","https://homosaurus.org/v3/homoit0002606"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85044668"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002580","dc:identifier":"homoit0002580","skos:prefLabel":"Appropriation of Indigenous identity","skos:altLabel":"Pretendians","rdfs:comment":"A form of cultural appropriation and race shifting involving false claims of citizenship, belonging, and/or descent from Indigenous people in North America. Not to be confused with disconnected or reconnecting descendants.","skos:broader":"https://homosaurus.org/v3/homoit0002582","skos:narrower":"https://homosaurus.org/v3/homoit0002581","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002582"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002582","dc:identifier":"homoit0002582","skos:prefLabel":"Appropriation of marginalized identities","rdfs:comment":"Falsely claiming belonging to a marginalized group (including, but not limited to: disability, ethnicity, race, and sexuality).","skos:narrower":"https://homosaurus.org/v3/homoit0002580","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002582"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002581","dc:identifier":"homoit0002581","skos:prefLabel":"Appropriation of Two-Spirit identity","rdfs:comment":"A form of cultural appropriation involving identification with Two-Spirit identity by people who cannot claim citizenship, belonging, and/or descent from Indigenous people in North America.","skos:broader":"https://homosaurus.org/v3/homoit0002580","skos:related":"https://homosaurus.org/v3/homoit0001914","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002582"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002583","dc:identifier":"homoit0002583","skos:prefLabel":"Queerspawn ","rdfs:comment":"People with one or more queer parent or caregiver, usually for self-identification. Queerspawn is believed to have been coined in 1995 or 1996 by Stefan Lynch for use in zine published by COLAGE, a U.S. based organization dedicated to supporting people with one or more LGBTQ+ caregiver.","skos:broader":["https://homosaurus.org/v3/homoit0000260","https://homosaurus.org/v3/homoit0001317"],"skos:related":["https://homosaurus.org/v3/homoit0000262","https://homosaurus.org/v3/homoit0001176","https://homosaurus.org/v3/homoit0001194"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002584","dc:identifier":"homoit0002584","skos:prefLabel":"Bothies","rdfs:comment":"People who have two or more LGBTQ+ parents or caregivers. Includes individuals born to or adopted by people in a heterosexual relationship who later came out as LGBTQ+, as well as individuals born to or adopted by LGBTQ+ people who came together to create their own families, such as lesbian couples who choose to conceive with friends who are gay men. For use in a Canadian and United States context.","skos:broader":["https://homosaurus.org/v3/homoit0000260","https://homosaurus.org/v3/homoit0001317"],"skos:related":["https://homosaurus.org/v3/homoit0000420","https://homosaurus.org/v3/homoit0001075"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002585","dc:identifier":"homoit0002585","skos:prefLabel":"LGBTQ+ children of LGBTQ+ parents","skos:altLabel":"Second generation (LGBTQ+ families)","rdfs:comment":"Term used to describe people who are LGBTQ+ and have at least one LGBTQ+ parent or caregiver.","skos:broader":["https://homosaurus.org/v3/homoit0000260","https://homosaurus.org/v3/homoit0000915"],"skos:related":["https://homosaurus.org/v3/homoit0000420","https://homosaurus.org/v3/homoit0000752"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002586","dc:identifier":"homoit0002586","skos:prefLabel":"LGBTQ+ family generations","rdfs:comment":"Refers to families with LGBTQ+ individuals in multiple generations.","skos:broader":"https://homosaurus.org/v3/homoit0000420","skos:related":["https://homosaurus.org/v3/homoit0000260","https://homosaurus.org/v3/homoit0001075","https://homosaurus.org/v3/homoit0001430","https://homosaurus.org/v3/homoit0002358"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002587","dc:identifier":"homoit0002587","skos:prefLabel":"People with transgender parents","skos:altLabel":["KOT (Kids of Trans)","Kids of Trans","PTP","People with trans parents","Transpawn"],"rdfs:comment":"People who have one or more transgender parent or caregiver.","skos:broader":"https://homosaurus.org/v3/homoit0000261","skos:related":["https://homosaurus.org/v3/homoit0001412","https://homosaurus.org/v3/homoit0001430"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002588","dc:identifier":"homoit0002588","skos:prefLabel":"Culturally queer","rdfs:comment":"Term used to describe the feeling shared by many people with queer parents or caregivers that they grew up immersed in queer culture, including queer traditions, celebrations, media, and language.","skos:broader":"https://homosaurus.org/v3/homoit0001832","skos:related":["https://homosaurus.org/v3/homoit0000262","https://homosaurus.org/v3/homoit0001176","https://homosaurus.org/v3/homoit0001195"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002589","dc:identifier":"homoit0002589","skos:prefLabel":"Gender role stereotypes","skos:altLabel":"Gender stereotypes","rdfs:comment":"Widely held but oversimplified and often offensive ideas regarding gender roles, which are socially-determined rules or standards for gendered behaviors. Use the term \"Gender roles\" to describe gender roles as a whole, rather than stereotypes related to them.","skos:broader":"https://homosaurus.org/v3/homoit0000577","skos:related":["https://homosaurus.org/v3/homoit0000563","https://homosaurus.org/v3/homoit0000568","https://homosaurus.org/v3/homoit0000575"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001241"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002590","dc:identifier":"homoit0002590","skos:prefLabel":"Internalized oppression","rdfs:comment":"The phenomenon in which someone in a marginalized group internalizes or adopts oppressive beliefs (i.e., negative perceptions of and intolerance toward any marginalized identities they hold) as a result of being raised or socialized within an oppressive environment or culture.","skos:narrower":["https://homosaurus.org/v3/homoit0000391","https://homosaurus.org/v3/homoit0002591","https://homosaurus.org/v3/homoit0002592","https://homosaurus.org/v3/homoit0002593","https://homosaurus.org/v3/homoit0002594","https://homosaurus.org/v3/homoit0002595"],"skos:related":["https://homosaurus.org/v3/homoit0000345","https://homosaurus.org/v3/homoit0000920","https://homosaurus.org/v3/homoit0000936","https://homosaurus.org/v3/homoit0003091"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002590"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002591","dc:identifier":"homoit0002591","skos:prefLabel":"Internalized lesbophobia","rdfs:comment":"The phenomenon in which lesbians internalize or adopt lesbophobic beliefs (i.e., negative perceptions of and intolerance toward lesbians and lesbianism) as a result of being raised or socialized within a lesbophobic environment or culture.","skos:broader":["https://homosaurus.org/v3/homoit0000803","https://homosaurus.org/v3/homoit0002590"],"skos:narrower":"https://homosaurus.org/v3/homoit0003092","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002592","dc:identifier":"homoit0002592","skos:prefLabel":"Internalized biphobia","rdfs:comment":"The phenomenon in which bisexual people internalize or adopt biphobic beliefs (i.e., negative perceptions of and intolerance toward bisexual people and bisexuality) as a result of being raised or socialized within a biphobic environment or culture.","skos:broader":["https://homosaurus.org/v3/homoit0000117","https://homosaurus.org/v3/homoit0002590"],"skos:narrower":"https://homosaurus.org/v3/homoit0003094","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002593","dc:identifier":"homoit0002593","skos:prefLabel":"Internalized transphobia","rdfs:comment":"The phenomenon in which transgender people internalize or adopt transphobic beliefs (i.e., negative perceptions of and intolerance toward transgender people and trans identities) as a result of being raised or socialized within a transphobic environment or culture.","skos:broader":["https://homosaurus.org/v3/homoit0001467","https://homosaurus.org/v3/homoit0002590"],"skos:narrower":"https://homosaurus.org/v3/homoit0003095","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002594","dc:identifier":"homoit0002594","skos:prefLabel":"Internalized queerphobia","rdfs:comment":"The phenomenon in which queer people internalize or adopt queerphobic beliefs (i.e., negative perceptions of and intolerance toward queer people and queerness) as a result of being raised or socialized within a queerphobic environment or culture.","skos:broader":["https://homosaurus.org/v3/homoit0001229","https://homosaurus.org/v3/homoit0002590"],"skos:narrower":"https://homosaurus.org/v3/homoit0003096","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002595","dc:identifier":"homoit0002595","skos:prefLabel":"Internalized intersexphobia","skos:altLabel":"Internalized interphobia","rdfs:comment":"The phenomenon in which intersex people internalize or adopt intersexphobic beliefs (i.e., negative perceptions of and intolerance toward intersex people and intersex variations) as a result of being raised or socialized within a intersexphobic environment or culture.","skos:broader":["https://homosaurus.org/v3/homoit0000666","https://homosaurus.org/v3/homoit0002590"],"skos:narrower":"https://homosaurus.org/v3/homoit0003097","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002596","dc:identifier":"homoit0002596","skos:prefLabel":"Transgender art ","rdfs:comment":"Term for different forms of creative activity, including visual, material, and performing arts, by transgender artists or about transgender topics and communities. \r\n","skos:broader":"https://homosaurus.org/v3/homoit0000816","skos:related":"https://homosaurus.org/v3/homoit0002610","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002597","dc:identifier":"homoit0002597","skos:prefLabel":"Two-Spirit art ","skos:altLabel":["2S art","Two Spirit art","Two Spirited art","Two-Spirited art"],"rdfs:comment":"Term for different forms of creative activity, including visual, material, and performing arts, by Two-Sprit artists or about Two-Spirit topics and communities. \r\n","skos:narrower":"https://homosaurus.org/v3/homoit0002606","skos:related":"https://homosaurus.org/v3/homoit0000816","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002597"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002598","dc:identifier":"homoit0002598","skos:prefLabel":"Gay art ","rdfs:comment":"Umbrella term for different forms of creative activity, including visual, material, and performing arts, by gay artists or about gay topics and communities. Use a more specific term if possible.\r\n","skos:broader":"https://homosaurus.org/v3/homoit0000816","skos:related":"https://homosaurus.org/v3/homoit0002608","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002599","dc:identifier":"homoit0002599","skos:prefLabel":"Lesbian art ","rdfs:comment":"Term for different forms of creative activity, including visual, material, and performing arts, by lesbian artists or about lesbian topics and communities. \r\n","skos:broader":"https://homosaurus.org/v3/homoit0000816","skos:related":"https://homosaurus.org/v3/homoit0002607","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002600","dc:identifier":"homoit0002600","skos:prefLabel":"Bisexual art ","rdfs:comment":"Term for different forms of creative activity, including visual, material, and performing arts, by bisexual artists or about bisexual topics and communities. \r\n","skos:broader":"https://homosaurus.org/v3/homoit0000816","skos:related":"https://homosaurus.org/v3/homoit0002609","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002601","dc:identifier":"homoit0002601","skos:prefLabel":"Queer art ","rdfs:comment":"Term for different forms of creative activity, including visual, material, and performing arts, by queer artists or about queer topics and communities. \r\n","skos:broader":"https://homosaurus.org/v3/homoit0000816","skos:narrower":"https://homosaurus.org/v3/homoit0003614","skos:related":"https://homosaurus.org/v3/homoit0002611","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002602","dc:identifier":"homoit0002602","skos:prefLabel":"Intersex art","rdfs:comment":"Term for different forms of creative activity, including visual, material, and performing arts, by intersex artists or about intersex topics and communities. \r\n","skos:broader":"https://homosaurus.org/v3/homoit0000816","skos:related":"https://homosaurus.org/v3/homoit0002612","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002603","dc:identifier":"homoit0002603","skos:prefLabel":"Aromantic art ","rdfs:comment":"Term for different forms of creative activity, including visual, material, and performing arts, by aromantic artists or about aromantic topics and communities. \r\n","skos:broader":"https://homosaurus.org/v3/homoit0000816","skos:related":"https://homosaurus.org/v3/homoit0002613","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002604","dc:identifier":"homoit0002604","skos:prefLabel":"Asexual art ","rdfs:comment":"Term for different forms of creative activity, including visual, material, and performing arts, by asexual artists or about asexual topics and communities. \r\n","skos:broader":"https://homosaurus.org/v3/homoit0000816","skos:related":"https://homosaurus.org/v3/homoit0002614","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002605","dc:identifier":"homoit0002605","skos:prefLabel":"Demisexual art ","rdfs:comment":"Term for different forms of creative activity, including visual, material, and performing arts, by demisexual artists or about demisexual topics and communities. \r\n","skos:broader":"https://homosaurus.org/v3/homoit0000816","skos:related":"https://homosaurus.org/v3/homoit0002615","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002606","dc:identifier":"homoit0002606","skos:prefLabel":"Two-Spirit erotic art ","skos:altLabel":["2S erotic art ","Two Spirit erotic art ","Two Spirited erotic art ","Two-Spirited erotic art "],"rdfs:comment":"Erotic art, created by Two-Spirit artists, depicting Two-Spirit people, or that are regarded as important within Two-Spirit culture.","skos:broader":"https://homosaurus.org/v3/homoit0002597","skos:related":"https://homosaurus.org/v3/homoit0002579","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002597"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002607","dc:identifier":"homoit0002607","skos:prefLabel":"Lesbian erotic art ","rdfs:comment":"Erotic art, created by lesbian artists, depicting lesbian people, or that are regarded as important within lesbian culture.","skos:broader":"https://homosaurus.org/v3/homoit0002579","skos:narrower":["https://homosaurus.org/v3/homoit0000765","https://homosaurus.org/v3/homoit0002546"],"skos:related":"https://homosaurus.org/v3/homoit0002599","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh96007206"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002608","dc:identifier":"homoit0002608","skos:prefLabel":"Gay erotic art","rdfs:comment":"Erotic art, created by gay artists, depicting gay people, or that are regarded as important within gay culture.","skos:broader":"https://homosaurus.org/v3/homoit0002579","skos:narrower":["https://homosaurus.org/v3/homoit0000520","https://homosaurus.org/v3/homoit0002547"],"skos:related":"https://homosaurus.org/v3/homoit0002598","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002536"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002609","dc:identifier":"homoit0002609","skos:prefLabel":"Bisexual erotic art ","rdfs:comment":"Erotic art, created by bisexual artists, depicting bisexual people, or that are regarded as important within bisexual culture.","skos:broader":"https://homosaurus.org/v3/homoit0002579","skos:narrower":["https://homosaurus.org/v3/homoit0000176","https://homosaurus.org/v3/homoit0002548"],"skos:related":"https://homosaurus.org/v3/homoit0002600","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002610","dc:identifier":"homoit0002610","skos:prefLabel":"Transgender erotic art ","rdfs:comment":"Erotic art, created by transgender artists, depicting transgender people, or that are regarded as important within transgender culture.","skos:broader":"https://homosaurus.org/v3/homoit0002579","skos:narrower":["https://homosaurus.org/v3/homoit0001435","https://homosaurus.org/v3/homoit0002549"],"skos:related":"https://homosaurus.org/v3/homoit0002596","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002611","dc:identifier":"homoit0002611","skos:prefLabel":"Queer erotic art ","rdfs:comment":"Erotic art, created by queer artists, depicting queer people, or that are regarded as important within queer culture.","skos:broader":"https://homosaurus.org/v3/homoit0002579","skos:narrower":["https://homosaurus