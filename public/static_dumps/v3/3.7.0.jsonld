.org/v4/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nudeBeaches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001051","dc:identifier":"homoit0001051","skos:prefLabel":"Nude photographs","skos:altLabel":"Nudes","rdfs:comment":"Images of naked individuals, including those taken by amateurs or professionals; may be produced for aesthetic or erotic purposes.","skos:broader":"https://homosaurus.org/v3/homoit0001052","skos:related":"https://homosaurus.org/v3/homoit0000816","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001052"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nudePhotographs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001052","dc:identifier":"homoit0001052","skos:prefLabel":"Nude art","rdfs:comment":"Works of art depicting naked individuals, either for aesthetic or erotic purposes; includes paintings, photographs, sculptures, etc.","skos:narrower":"https://homosaurus.org/v3/homoit0001051","skos:related":["https://homosaurus.org/v3/homoit0000816","https://homosaurus.org/v3/homoit0002579"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85093169"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001052"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nudes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001053","dc:identifier":"homoit0001053","skos:p