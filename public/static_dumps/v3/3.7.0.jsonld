and culture, thereby affirming the visibility, dignity, and diversity of LGBTQ+ communities.","skos:broader":"https://homosaurus.org/v3/homoit0000861","skos:narrower":["https://homosaurus.org/v3/homoit0001379","https://homosaurus.org/v3/homoit0000383","https://homosaurus.org/v3/homoit0003652","https://homosaurus.org/v3/homoit0003654"],"skos:related":"https://homosaurus.org/v3/homoit0002386","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2010013029"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000861"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003652","dc:identifier":"homoit0003652","skos:prefLabel":"Pride parades","skos:altLabel":"LGBTQ+ pride parades","rdfs:comment":"Public parades that recognize and celebrate LGBTQ+ people and culture, thereby affirming the visibility, dignity, and diversity of LGBTQ+ communities.","skos:broader":"https://homosaurus.org/v3/homoit0003651","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006020042"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000861"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003654","dc:identifier":"homoit0003654","skos:prefLabel":"Pride Month","skos:altLabel":"LGBTQ+ Pride Month","rdfs:comment":"A period of public recognition and celebration of LGBTQ+ people and culture, usually organized over the course of a month with local events, parades, marches, and rallies. Pride occurs at different times during the year in different places but is typically held in June in the United States to commemorate the Stonewall uprising.","skos:broader":["https://homosaurus.org/v3/homoit0003653","https://homosaurus.org/v3/homoit0003651"],"skos:narrower":"https://homosaurus.org/v3/homoit0000523","skos:related":"https://homosaurus.org/v3/homoit0003656","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003653"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003655","dc:identifier":"homoit0003655","skos:prefLabel":"Transgender pride","skos:altLabel":"Trans pride","rdfs:comment":"The recognition and celebration of transgender people and culture, thereby affirming the visibility, dignity, and diversity of transgender communities.","skos:broader":"https://homosaurus.org/v3/homoit0003653","skos:related":"https://homosaurus.org/v3/homoit0001379","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003653"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003656","dc:identifier":"homoit0003656","skos:prefLabel":"LGBTQ+ History Month","skos:altLabel":"Gay History Month","rdfs:comment":"An annual, month-long observance of LGBTQ+ history and related civil rights movements. The month in which LGBTQ+ History Month is observed differs depending on the country.","skos:broader":"https://homosaurus.org/v3/homoit0000861","skos:related":["https://homosaurus.org/v3/homoit0002260","https://homosaurus.org/v3/homoit0003654"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2016000166"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000861"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003657","dc:identifier":"homoit0003657","skos:prefLabel":"Gender-affirming care","skos:altLabel":"Gender affirming care","rdfs:comment":"Social, psychological, behavioral, and medical interventions designed to support and affirm an individual's gender identity. Gender-affirming care includes but is not limited to equal access to health care facilities, counseling, puberty blockers, hormone therapy, and gender-affirming surgeries. It can also include resources to aid in social transition, such as affirming policies regarding name and pronoun changes, access to non-gendered restrooms and facilities, etc.","skos:broader":"https://homosaurus.org/v3/homoit0000614","skos:narrower":["https://homosaurus.org/v3/homoit0000561","https://homosaurus.org/v3/homoit0003658","https://homosaurus.org/v3/homoit0003659"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2023000451"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000614"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003658","dc:identifier":"homoit0003658","skos:prefLabel":"Intersex-affirming care","skos:altLabel":"Intersex affirming care","rdfs:comment":"Social, psychological, behavioral, and medical interventions designed to support and affirm individuals belonging to the intersex community. Intersex-affirming care includes but is not limited to equal access to health care facilities, access to medical records and information about one's intersex status and traits, and informed consent regarding medical procedures or treatments related to intersex traits.","skos:broader":"https://homosaurus.org/v3/homoit0003657","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000614"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003659","dc:identifier":"homoit0003659","skos:prefLabel":"Transgender-affirming care","skos:altLabel":["Trans-affirming care","Transgender affirming care","Trans affirming care"],"rdfs:comment":"Social, psychological, behavioral, and medical interventions designed to support and affirm a transgender individual's gender identity. Transgender-affirming care includes but is not limited to equal access to health care facilities, counseling, puberty blockers, hormone therapy, and gender-affirming surgeries. It can also include resources to aid in social transition, such as affirming policies regarding name and pronoun changes, access to non-gendered restrooms and facilities, etc.","skos:broader":"https://homosaurus.org/v3/homoit0003657","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000614"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003660","dc:identifier":"homoit0003660","skos:prefLabel":"LGBTQ+ superheroes","skos:altLabel":["Superheroes (LGBTQ)","LGBTQ+ super heroes","LGBTQ+ comic book heroes","Super heroes (LGBTQ)"],"rdfs:comment":"Benevolent fictional characters who possess superhuman powers or abilities beyond those of ordinary people which they use to fight evil and help the public. Use to refer to superheroes who are explicitly identified as LGBTQ+ within their source material.","skos:broader":"https://homosaurus.org/v3/homoit0000249","skos:related":"https://homosaurus.org/v3/homoit0000841","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000249"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003661","dc:identifier":"homoit0003661","skos:prefLabel":"LGBTQ+ supervillains","skos:altLabel":["Supervillains (LGBTQ)","LGBTQ+ super villains","Super villains (LGBTQ)","LGBTQ+ comic book villains"],"rdfs:comment":"Villainous fictional characters who possess superhuman powers or abilities beyond those of ordinary people which they use to do evil and harm the public. Use to refer to supervillains who are explicitly identified as LGBTQ+ within their source material.","skos:broader":"https://homosaurus.org/v3/homoit0000249","skos:related":"https://homosaurus.org/v3/homoit0000841","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000249"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003662","dc:identifier":"homoit0003662","skos:prefLabel":"LGBTQ+ video games","skos:altLabel":["Video games (LGBTQ)","LGBTQ+ computer games","Computer games (LGBTQ)"],"rdfs:comment":"Games played by electronically manipulating images produced by a computer program on a display screen. Use in reference to video games intended for LGBTQ+ audiences and/or focusing on LGBTQ+ characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000816","skos:related":"https://homosaurus.org/v3/homoit0002209","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003663","dc:identifier":"homoit0003663","skos:prefLabel":"LGBTQ+ poets","skos:altLabel":"Poets (LGBTQ)","rdfs:comment":"Creators of written or spoken verse who identify as LGBTQ+.","skos:broader":"https://homosaurus.org/v3/homoit0001723","skos:narrower":["https://homosaurus.org/v3/homoit0003664","https://homosaurus.org/v3/homoit0003665","https://homosaurus.org/v3/homoit0003666","https://homosaurus.org/v3/homoit0003667","https://homosaurus.org/v3/homoit0003668","https://homosaurus.org/v3/homoit0003669","https://homosaurus.org/v3/homoit0003670","https://homosaurus.org/v3/homoit0003672","https://homosaurus.org/v3/homoit0003673","https://homosaurus.org/v3/homoit0003674","https://homosaurus.org/v3/homoit0003675","https://homosaurus.org/v3/homoit0003676"],"skos:related":"https://homosaurus.org/v3/homoit0003671","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003664","dc:identifier":"homoit0003664","skos:prefLabel":"Lesbian poets","rdfs:comment":"Creators of written or spoken verse who identify as lesbian.","skos:broader":"https://homosaurus.org/v3/homoit0003663","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003665","dc:identifier":"homoit0003665","skos:prefLabel":"Gay poets","rdfs:comment":"Creators of written or spoken verse who identify as gay.","skos:broader":"https://homosaurus.org/v3/homoit0003663","skos:hasTopConcept":{