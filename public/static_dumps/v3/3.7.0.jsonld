performed; use in reference to dramatic works focusing on intersex characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000376","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002740","dc:identifier":"homoit0002740","skos:prefLabel":"Intersex employment","rdfs:comment":"Employment of intersex people.","skos:broader":"https://homosaurus.org/v3/homoit0001717","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001717"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002741","dc:identifier":"homoit0002741","skos:prefLabel":"Intersex fathers","rdfs:comment":"Intersex people who are fathers. Only use for people who identify as fathers.","skos:broader":"https://homosaurus.org/v3/homoit0002337","skos:related":"https://homosaurus.org/v3/homoit0001763","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002742","dc:identifier":"homoit0002742","skos:prefLabel":"Parents of intersex people","skos:altLabel":"Intersex people's parents","rdfs:comment":"People who act as parents to one or more intersex person. For parents who are themselves intersex, use the term \"intersex parents.\"","skos:broader":"https://homosaurus.org/v3/homoit0002224","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002743","dc:identifier":"homoit0002743","skos:prefLabel":"Partners of intersex people","rdfs:comment":"People whose sexual, romantic, or play partner is intersex.","skos:broader":"https://homosaurus.org/v3/homoit0002366","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002365"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002744","dc:identifier":"homoit0002744","skos:prefLabel":"Persecution of intersex people","rdfs:comment":"Systematic mistreatment of intersex people on the basis of their sex or gender identity.","skos:broader":"https://homosaurus.org/v3/homoit0001108","skos:related":"https://homosaurus.org/v3/homoit0000618","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001108"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002745","dc:identifier":"homoit0002745","skos:prefLabel":"Sons of intersex people","rdfs:comment":"Sons who have one or more intersex parent. For sons who are themselves intersex, use the term \"Intersex sons.\"","skos:broader":"https://homosaurus.org/v3/homoit0002355","skos:related":"https://homosaurus.org/v3/homoit0001767","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"