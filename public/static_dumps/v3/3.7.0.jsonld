://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003498","dc:identifier":"homoit0003498","skos:prefLabel":"Two-Spirit children's literature","skos:altLabel":["2S children's literature","Two Spirit children's literature","Two Spirited children's literature","Two-Spirit juvenile literature","Two-Spirit kid lit","Two-Spirited children's literature"],"rdfs:comment":"Written literary works for an audience of readers up to 12 years of age, also known as kid lit or juvenile literature. Use in reference to children's literature focusing on Two-Spirit characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0002710","skos:related":"https://homosaurus.org/v3/homoit0003488","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002710"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003499","dc:identifier":"homoit0003499","skos:prefLabel":"Anti-transgender legislation","skos:altLabel":["Anti-trans law-making","Anti-trans legislation","Anti-transgender law-making"],"rdfs:comment":"Efforts to propose, enact, amend, or strike down laws as a means of restricting the legal rights of transgender people. This includes legislation regarding access to gender-affirming healthcare, participation in sporting events, administrative and judicial procedures such as sex and name registration, and policies affecting the medical treatment, education, and mental health care of transgender youth.","skos:broader":"https://homosaurus.org/v3/homoit0000702","skos:narrower":["https://homosaurus.org/v3/homoit0001139","https://homosaurus.org/v3/homoit0003502","https://homosaurus.org/v3/homoit0003503","https://homosaurus.org/v3/homoit0003504","https://homosaurus.org/v3/homoit0003510"],"skos:related":["https://homosaurus.org/v3/homoit0000062","https://homosaurus.org/v3/homoit0000314","https://homosaurus.org/v3/homoit0001467","https://homosaurus.org/v3/homoit0001819"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003500","dc:identifier":"homoit0003500","skos:prefLabel":"Danmei","skos:altLabel":"Dānměi","rdfs:comment":"A genre focusing on the romantic or sexual relationships between male characters in Chinese novels, comics, movies, animation, and dramas.","skos:broader":"https://homosaurus.org/v3/homoit0002152","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003501","dc:identifier":"homoit0003501","skos:prefLabel":"Turkey baster babies","rdfs:comment":"Babies conceived through at-home artificial insemination, specifically by injecting semen into one's vagina using a turkey baster. There is an extensive history of at-home artificial insemination undertaken by LGBTQ+ people, including gay men contributing semen to aid lesbian couples in conceiving.","skos:broader":"https://homosaurus.org/v3/homoit0000255","skos:related":"https://homosaurus.org/v3/homoit0002617","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003502","dc:identifier":"homoit0003502","skos:prefLabel":"Transgender health care bans for children and youth","rdfs:comment":"Laws or policies instituted that prevent trans and non-binary youth and children from seeking and/or obtaining medical treatment or gender-affirming care, including but not limited to surgery, hormone treatment, and mental health care. ","skos:broader":"https://homosaurus.org/v3/homoit0003499","skos:related":["https://homosaurus.org/v3/homoit0001400","https://homosaurus.org/v3/homoit0001452","https://homosaurus.org/v3/homoit0003514"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003503","dc:identifier":"homoit0003503","skos:prefLabel":"Gender marker change bans","skos:altLabel":"Legal documents change ban","rdfs:comment":"Laws or policies instituted to prevent trans and non-binary people from changing the gender marker on their birth certificate, driver's license, passport, or other legal documents.","skos:broader":"https://homosaurus.org/v3/homoit0003499","skos:related":["https://homosaurus.org/v3/homoit0000247","https://homosaurus.org/v3/homoit0000573","https://homosaurus.org/v3/homoit0000711"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003504","dc:identifier":"homoit0003504","skos:prefLabel":"Transgender health care bans","rdfs:comment":"Laws or policies instituted to prevent trans and non-binary individuals from seeking medical treatment or gender-affirming care, including but not limited to surgery, hormone treatment, and mental health care. ","skos:broader":"https://homosaurus.org/v3/homoit0003499","skos:related":["https://homosaurus.org/v3/homoit0000561","https://homosaurus.org/v3/homoit0000614"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003505","dc:identifier":"homoit0003505","skos:prefLabel":"Kiki (Social Gathering)","skos:altLabel":["Kikiing (Social gathering)","Kiking (Social gathering)"],"rdfs:comment":"A slang term to describe a gathering of friends for the purpose of chatting and gossiping. The term evolved out of the 1990s ballroom scene in New York City and was further popularized by the 2012 song \"Let's Have a Kiki\" by the Scissor Sisters. Do not conflate with the term \"Ky-ky (Gender role),\" sometimes also spelled \"Kiki,\" which refers to lesbians who do not identify as either butches or femmes.","skos:broader":"https://homosaurus.org/v3/homoit0001317","skos:related":["https://homosaurus.org/v3/homoit0000092","https://homosaurus.org/v3/homoit0000455"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001317"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003506","dc:identifier":"homoit0003506","skos:prefLabel":"Ky-ky (Gender role)","skos:altLabel":["Kiki (Gender role)","Kyky (Gender role)"],"rdfs:comment":"A slang term that emerged in the 1940s to describe lesbians who do not identify as butch or femme. Do not conflate with the term \"Kiki (Social gathering), which refers to a gathering of friends.","skos:broader":["https://homosaurus.org/v3/homoit0000577","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001304"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001241"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003507","dc:identifier":"homoit0003507","skos:prefLabel":"Girls’ Love (Genre)","skos:altLabel":"GL (Genre)","rdfs:comment":"A genre focusing on the romantic or sexual relationships between female characters in anime, dramas, comics, novels, and movies. The term is usually used to describe media originating from Asia.","skos:broader":"https://homosaurus.org/v3/homoit0002144","skos:narrower":["https://homosaurus.org/v3/homoit0002221","https://homosaurus.org/v3/homoit0003508"],"skos:related":"https://homosaurus.org/v3/homoit0000742","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003508","dc:identifier":"homoit0003508","skos:prefLabel":"Baihe","skos:altLabel":"Bǎihé","rdfs:comment":"A genre focusing on the romantic or sexual relationships between female characters in Chinese novels, comics, movies, animation, and dramas. ","skos:broader":"https://homosaurus.org/v3/homoit0003507","skos:related":"https://homosaurus.org/v3/homoit0000742","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003509","dc:identifier":"homoit0003509","skos:prefLabel":"Questioning","rdfs:comment":"A term used to describe individuals who are in the process of determining their sexual orientation and/or gender identity. ","skos:related":["https://homosaurus.org/v3/homoit0000295","https://homosaurus.org/v3/homoit0003445"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003509"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003510","dc:identifier":"homoit0003510","skos:prefLabel":"Sports bans","skos:altLabel":"Sport bans","rdfs:comment":"Laws or policies instituted to prevent trans and non-binary individuals from participating in gendered sports leagues or competitions, typically to force players to compete as their sex assigned at birth rather than as their gender. This ranges from criminalizing schools and programs that allow trans and non-binary youth participation to banning players, particularly trans women, from competing in gendered leagues or competitions.","skos:broader":"https://homosaurus.org/v3/homoit0003499","skos:related":"https://homosaurus.org/v3/homoit0001933","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003511","dc:identifier":"homoit0003511","skos:prefLabel":"LGBTQ+ painters","skos:altLabel":"Painters (LGBTQ)","rdfs:comment":"LGBTQ+ people who paint, either professionally or as a hobby.","skos:broader":"https://homosaurus.org/v3/homoit0000070","skos:narrower":["https://homosaurus.org/v3/homoit0003434","https://homosaurus.org/v3/homoit0003435","https://homosaurus.org/v3/homoit0003437","https://homosaurus.org/v3/homoit0003438","https://homosaurus.org/v3/homoit0003439","https://homosaurus.org/v3/homoit0003440","https://homosaurus.org/v3/homoit0003441","https://homosaurus.org/v3/homoit0003442","https://homosaurus.org/v3/homoit0003513","https://homosaurus.org/v3/homoit0003516","https://homosaurus.org/v3/homoit0003517","https://homosaurus.org/v3/homoit0003518"],"skos:related":"https://homosaurus.org/v3/homoit0003436","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003512","dc:identifier":"homoit0003512","skos:prefLabel":"Gender conversion therapy","skos:altLabel":["Conversion therapy for gender","Conversion therapy for trans people","Conversion therapy for transgender people","Gender reorientation therapy","Trans conversion therapy","Transgender conversion therapy"],"rdfs:comment":"Efforts to change the gender identity of a transgender or non-binary person to meet cisgender norms, typically under the belief that their identity is dangerous and/or the result of mental illness or trauma. The processes involved in conversion therapy include visualization training, spiritual interventions, and other aversion treatments. ","skos:broader":"https://homosaurus.org/v3/homoit0000303","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006004076"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003513","dc:identifier":"homoit0003513","skos:prefLabel":"Gay painters","rdfs:comment":"Gay men who paint, either professionally or as a hobby.","skos:broader":"https://homosaurus.org/v3/homoit0003511","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003514","dc:identifier":"homoit0003514","skos:prefLabel":"Health care for transgender children and youth","skos:altLabel":["Health care for trans children and youth","Trans health care for children and youth","Transgender health care for children and youth"],"rdfs:comment":"Organized measures taken for the maintenance or improvement of health via the prevention, diagnosis, and/or treatment of physical and mental health issues faced by transgender children and youth. This includes but is not limited to access to safe, legal therapy and counseling, hormone treatment, and gender-affirming surgery.","skos:broader":"https://homosaurus.org/v3/homoit0000614","skos:related":["https://homosaurus.org/v3/homoit0001400","https://homosaurus.org/v3/homoit0001452","https://homosaurus.org/v3/homoit0003502"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000614"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003515","dc:identifier":"homoit0003515","skos:prefLabel":"Lavender linguistics","skos:altLabel":["LGBTQ+ linguistics","Linguistics (LGBTQ)"],"rdfs:comment":"The study of language as used by members of LGBTQ+ communities.","skos:broader":"https://homosaurus.org/v3/homoit0001365","skos:related":"https://homosaurus.org/v3/homoit0001317","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003516","dc:identifier":"homoit0003516","skos:prefLabel":"Lesbian painters","rdfs:comment":"Lesbians who paint, either professionally or as a hobby.","skos:broader":"https://homosaurus.org/v3/homoit0003511","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003517","dc:identifier":"homoit0003517","skos:prefLabel":"Bisexual painters","rdfs:comment":"Bisexual people who paint, either professionally or as a hobby.","skos:broader":"https://homosaurus.org/v3/homoit0003511","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003518","dc:identifier":"homoit0003518","skos:prefLabel":"Transgender painters","skos:altLabel":"Trans painters","rdfs:comment":"Trans people who paint, either professionally or as a hobby.","skos:broader":"https://homosaurus.org/v3/homoit0003511","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003519","dc:identifier":"homoit0003519","skos:prefLabel":"Patriarchy","skos:altLabel":"Androcracy","rdfs:comment":"A cultural system in which positions of dominance and privilege are held by men, while women and other gender minorities are largely excluded from access to power.","skos:related":["https://homosaurus.org/v3/homoit0000115","https://homosaurus.org/v3/homoit0000565","https://homosaurus.org/v3/homoit0001278"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85098727"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003519"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003520","dc:identifier":"homoit0003520","skos:prefLabel":"Queer linguistics","rdfs:comment":"A field of linguistics that analyzes the effect of heteronormativity on the expression of sexual identity through language.","skos:broader":"https://homosaurus.org/v3/homoit0001365","skos:related":"https://homosaurus.org/v3/homoit0001317","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003522","dc:identifier":"homoit0003522","skos:prefLabel":"Bisexual political groups","rdfs:comment":"Organized groups centered on political change and action for bisexual people's rights.","skos:broader":"https://homosaurus.org/v3/homoit0003521","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003521"},"dc:issued":{"@type":"xsd:date","@value":"2024-09-19"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.