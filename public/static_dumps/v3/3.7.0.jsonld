le.","skos:broader":"https://homosaurus.org/v3/homoit0000702","skos:related":["https://homosaurus.org/v3/homoit0000356","https://homosaurus.org/v3/homoit0001141"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93005719"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/anti-discriminationLaw"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000702","dc:identifier":"homoit0000702","skos:prefLabel":"Law","skos:altLabel":"Legislation","rdfs:comment":"System of rules or conduct recognized and legally enforced within a country or community.","skos:narrower":["https://homosaurus.org/v3/homoit0000053","https://homosaurus.org/v3/homoit0000311","https://homosaurus.org/v3/homoit0000313","https://homosaurus.org/v3/homoit0000918","https://homosaurus.org/v3/homoit0001139","https://homosaurus.org/v3/homoit0001492","https://homosaurus.org/v3/homoit0003499","https://homosaurus.org/v3/homoit0003772"],"skos:related":["https://homosaurus.org/v3/homoit0000712","https://homosaurus.org/v3/homoit0000893","https://homosaurus.org/v3/homoit0001482"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85075119"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/law"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000054","dc:identifier":"homoit0000054","skos:prefLabel":"Anti-feminism","rdfs:comment":"Opposition to some or all forms of feminism.","skos:related":["https://homosaurus.org/v3/homoit0000437","https://homosaurus.org/v3/homoit0001133"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh96004456"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000054"},"dc:replaces":{"@id":"http://homosaurus.org/v2/anti-feminism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000055","dc:identifier":"homoit0000055","skos:prefLabel":"Anti-gay discrimination","rdfs:comment":"The unjust or prejudicial treatment of gay men due to their sexual identity; may include the denial of legal rights, employment, and housing.","skos:broader":"https://homosaurus.org/v3/homoit0000356","skos:related":"https://homosaurus.org/v3/homoit0000646","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88006552"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000356"},"dc:replaces":{"@id":"http://homosaurus.org/v2/antiGayDiscrimination"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000056","dc:identifier":"homoit0000056","skos:prefLabel":"Anti-gay violence","skos:altLabel":"Gay bashing","rdfs:comment":"Behavior involving physical force intended to harm or kill gay men on the basis of their identity. ","skos:broader":"https://homosaurus.org/v3/homoit0000059","skos:narrower":"https://homosaurus.org/v3/homoit0000449","skos:related":["https://homosaurus.org/v3/homoit0000109","https://homosaurus.org/v3/homoit0000646"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005020376"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/anti-gayViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000057","dc:identifier":"homoit0000057","skos:prefLabel":"Anti-lesbian discrimination","rdfs:comment":"The unjust or prejudicial treatment of lesbians due to their sexual identity; may include the denial of legal rights, employment, and housing.","skos:broader":"https://homosaurus.org/v3/homoit0000356","skos:related":"https://homosaurus.org/v3/homoit0000803","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000356"},"dc:replaces":{"@id":"http://homosaurus.org/v2/antiLesbianDiscrimination"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000058","dc:identifier":"homoit0000058","skos:prefLabel":"Anti-lesbian violence","skos:altLabel":"Lesbian bashing","rdfs:comment":"Behavior involving physical force intended to harm or kill lesbians on the basis of their identity. ","skos:broader":"https://homosaurus.org/v3/homoit0000059","skos:related":["https://homosaurus.org/v3/homoit0000109","https://homosaurus.org/v3/homoit0000556","https://homosaurus.org/v3/homoit0000803"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/anti-lesbianViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000060","dc:identifier":"homoit0000060","skos:prefLabel":"Anti-queer discrimination","rdfs:comment":"The unjust or prejudicial treatment of queer people due to their identity; may include the denial of legal rights, employment, and housing.","skos:broader":"https://homosaurus.org/v3/homoit0000356","skos:related":"https://homosaurus.org/v3/homoit0001229","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000356"},"dc:replaces":{"@id":"http://homosaurus.org/v2/antiQueerDiscrimination"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000061","dc:identifier":"homoit0000061","skos:prefLabel":"Anti-queer violence","rdfs:comment":"Behavior involving physical force intended to harm or kill queer people on the basis of their identity. ","skos:broader":"https://homosaurus.org/v3/homoit0000059","skos:related":["https://homosaurus.org/v3/homoit0000109","https://homosaurus.org/v3/homoit0001229"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/antiQueerViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000062","dc:identifier":"homoit0000062","skos:prefLabel":"Anti-transgender discrimination","rdfs:comment":"The unjust or prejudicial treatment of transgender people (or others perceived to be transgressing gender norms) due to their gender identity and/or expression; may include the denial of legal rights, employment, and housing.","skos:broader":"https://homosaurus.org/v3/homoit0000356","skos:narrower":["https://homosaurus.org/v3/homoit0000336","https://homosaurus.org/v3/homoit0001819"],"skos:related":["https://homosaurus.org/v3/homoit0001006","https://homosaurus.org/v3/homoit0001139","https://homosaurus.org/v3/homoit0001140","https://homosaurus.org/v3/homoit0001141","https://homosaurus.org/v3/homoit0001467","https://homosaurus.org/v3/homoit0001516","https://homosaurus.org/v3/homoit0001892","https://homosaurus.org/v3/homoit0001903","https://homosaurus.org/v3/homoit0003158","https://homosaurus.org/v3/homoit0003499","https://homosaurus.org/v3/homoit0003737"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2010012303"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000356"},"dc:replaces":{"@id":"http://homosaurus.org/v2/antiTransgenderDiscrimination"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000063","dc:identifier":"homoit0000063","skos:prefLabel":"Anti-transgender violence","rdfs:comment":"Behavior involving physical force intended to harm or kill transgender people on the basis of their identity. ","skos:broader":"https://homosaurus.org/v3/homoit0000059","skos:related":["https://homosaurus.org/v3/homoit0000109","https://homosaurus.org/v3/homoit0001467"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2010014446"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/anti-transgenderViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000064","dc:identifier":"homoit0000064","skos:prefLabel":"Aphallia","skos:altLabel":"Penile agenesis","rdfs:comment":"People with aphallia have XY chromosomes, testes, and are born without a penis. They produce typical levels of testosterone, and they develop secondary sex characteristics associated with a typical testosterone puberty during adolescence.","skos:broader":"https://homosaurus.org/v3/homoit0000669","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/aphallia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000065","dc:identifier":"homoit0000065","skos:prefLabel":"Aravani","skos:altLabel":"Aruvani","rdfs:comment":"Indian term for people who identify as women trapped in male bodies; many prefer other terms, such as hijra or thirunangai.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":["https://homosaurus.org/v3/homoit0000632","https://homosaurus.org/v3/homoit0001370"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/aravani"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000066","dc:identifier":"homoit0000066","skos:prefLabel":"LGBTQ+ archives","skos:altLabel":["LGBTQ archives","Archives (LGBTQ)"],"rdfs:comment":"Collections of records and materials relating to LGBTQ+ people or LGBTQ+ communities; can include a variety of organizations and institutions from community to government archives.","skos:broader":"https://homosaurus.org/v3/homoit0001755","skos:narrower":["https://homosaurus.org/v3/homoit0000128","https://homosaurus.org/v3/homoit0000469","https://homosaurus.org/v3/homoit0000719","https://homosaurus.org/v3/homoit0001156","https://homosaurus.org/v3/homoit0001389","https://homosaurus.org/v3/homoit0002759","https://homosaurus.org/v3/homoit0002776","https://homosaurus.org/v3/homoit0003608"],"skos:related":["https://homosaurus.org/v3/homoit0000968","https://homosaurus.org/v3/homoit0002677"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/archivesLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001755","dc:identifier":"homoit0001755","skos:prefLabel":"LGBTQ+ cultural heritage institutions","skos:altLabel":["Cultural heritage institutions (LGBTQ)","GLAM (LGBTQ)","GLAMS (LGBTQ)","LGBTQ+ GLAM","LGBTQ+ GLAMS"],"rdfs:comment":"A broad grouping term for galleries, libraries, archives, museums, and special collections (GLAMS) that hold materials primarily pertaining to LGBTQ+ people or intended for use by LGBTQ+ people.","skos:narrower":["https://homosaurus.org/v3/homoit0000066","https://homosaurus.org/v3/homoit0000968","https://homosaurus.org/v3/homoit0001030","https://homosaurus.org/v3/homoit0001813"],"skos:related":["https://homosaurus.org/v3/homoit0000070","https://homosaurus.org/v3/homoit0000816","https://homosaurus.org/v3/homoit0000972","https://homosaurus.org/v3/homoit0001363","https://homosaurus.org/v3/homoit0001831","https://homosaurus.org/v3/homoit0002260"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001755"},"dc:issued":{"@type":"xsd:date","@value":"2021-11-23"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000067","dc:identifier":"homoit0000067","skos:prefLabel":"Aromantic people","rdfs:comment":"Individuals who do not generally experience romantic attraction or desire.","skos:broader":"https://homosaurus.org/v3/homoit0001829","skos:related":["https://homosaurus.org/v3/homoit0000004","https://homosaurus.org/v3/homoit0001237","https://homosaurus.org/v3/homoit0001532","https://homosaurus.org/v3/homoit0001644","https://homosaurus.org/v3/homoit0001757","https://homosaurus.org/v3/homoit0001761","https://homosaurus.org/v3/homoit0001765","https://homosaurus.org/v3/homoit0001823","https://homosaurus.org/v3/homoit0001824","https://homosaurus.org/v3/homoit0001825","https://homosaurus.org/v3/homoit0001826","https://homosaurus.org/v3/homoit0001827","https://homosaurus.org/v3/homoit0002145"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001829"},"dc:replaces":{"@id":"http://homosaurus.org/v2/aromanticPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001829","dc:identifier":"homoit0001829","skos:prefLabel":"Romantic minorities","rdfs:comment":"Individuals whose romantic orientations and/or practices differ from those of the dominant culture.","skos:narrower":["https://homosaurus.org/v3/homoit0000067","https://homosaurus.org/v3/homoit0001824","https://homosaurus.org/v3/homoit0001825","https://homosaurus.org/v3/homoit0001827","https://homosaurus.org/v3/homoit0001985","https://homosaurus.org/v3/homoit0001987"],"skos:related":["https://homosaurus.org/v3/homoit0001297","https://homosaurus.org/v3/homoit0001637","https://homosaurus.org/v3/homoit0001817","https://homosaurus.org/v3/homoit0001828"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001829"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000068","dc:identifier":"homoit0000068","skos:prefLabel":"Arrests of LGBTQ+ people","skos:altLabel":"Arrests of LGBTQ people","rdfs:comment":"Apprehension and detention of LGBTQ+ people by an institution or authority in order to deprive them of their freedom of movement.","skos:broader":["https://homosaurus.org/v3/homoit0000348","https://homosaurus.org/v3/homoit0002373"],"skos:related":["https://homosaurus.org/v3/homoit0000835","https://homosaurus.org/v3/homoit0001108","https://homosaurus.org/v3/homoit0001120"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000348"},"dc:replaces":{"@id":"http://homosaurus.org/v2/arrestsOfLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000348","dc:identifier":"homoit0000348","skos:prefLabel":"Detention of LGBTQ+ people","skos:altLabel":"Detention of LGBTQ people","rdfs:comment":"Temporary physical and legal confinement of LGBTQ+ people by an institution or authority, typically pending criminal charges or deportation. Can also be used to describe individuals held in custody for political purposes or within the context of war.","skos:narrower":["https://homosaurus.org/v3/homoit0000068","https://homosaurus.org/v3/homoit0000349","https://homosaurus.org/v3/homoit0000884"],"skos:related":["https://homosaurus.org/v3/homoit0000712","https://homosaurus.org/v3/homoit0000883","https://homosaurus.org/v3/homoit0000887"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000348"},"dc:replaces":{"@id":"http://homosaurus.org/v2/detentionOfLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000069","dc:identifier":"homoit0000069","skos:prefLabel":"Insemination","skos:altLabel":["Fertilisation","Fertilization"],"rdfs:comment":"The act of using sperm to induce pregnancy by natural or artificial means, especially in the context of LGBTQ+ family planning with sperm donors.","skos:broader":"https://homosaurus.org/v3/homoit0000843","skos:narrower":["https://homosaurus.org/v3/homoit0001265","https://homosaurus.org/v3/homoit0002617","https://homosaurus.org/v3/homoit0002620"],"skos:related":["https://homosaurus.org/v3/homoit0001336","https://homosaurus.org/v3/homoit0002618"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85008176"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000864"},"dc:replaces":{"@id":"http://homosaurus.org/v2/insemination"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000864","dc:identifier":"homoit0000864","skos:prefLabel":"LGBTQ+ family planning","skos:altLabel":"LGBTQ family planning","rdfs:comment":"The practice of determining the shape of a family by LGBTQ+ people.","skos:narrower":["https://homosaurus.org/v3/homoit0000809","https://homosaurus.org/v3/homoit0000843"],"skos:related":["https://homosaurus.org/v3/homoit0000347","https://homosaurus.org/v3/homoit0000390","https://homosaurus.org/v3/homoit0000420","https://homosaurus.org/v3/homoit0000811","https://homosaurus.org/v3/homoit0000819","https://homosaurus.org/v3/homoit0000871","https://homosaurus.org/v3/homoit0000945","https://homosaurus.org/v3/homoit0001001","https://homosaurus.org/v3/homoit0001075","https://homosaurus.org/v3/homoit0001093","https://homosaurus.org/v3/homoit0001336"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000864"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQFamilyPlanning"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-1