.org/v3/homoit0002695"],"skos:related":["https://homosaurus.org/v3/homoit0001854","https://homosaurus.org/v3/homoit0002694"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002683","dc:identifier":"homoit0002683","skos:prefLabel":"Two-Spirit blind people","skos:altLabel":["2S blind people","Blind 2S people","Blind Two Spirit people","Blind Two Spirited people","Blind Two-Spirited people","Two Spirit blind people","Two Spirited blind people","Two-Spirited blind people"],"rdfs:comment":"Two-Spirit people with significant or total loss of vision.","skos:broader":"https://homosaurus.org/v3/homoit0002682","skos:related":"https://homosaurus.org/v3/homoit0000822","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002684","dc:identifier":"homoit0002684","skos:prefLabel":"Two-Spirit Deaf people","skos:altLabel":["2S Deaf people","Deaf 2S people","Deaf Two Spirit people","Deaf Two Spirited people","Deaf Two-Spirited people","Two Spirit Deaf people","Two Spirited Deaf people","Two-Spirited Deaf people"],"rdfs:comment":"Two-Spirit people with significant or total hearing loss. Some but not all Deaf people prefer to capitalize Deaf in recognition of the cultural and linguistic identity they share with other Deaf people.","skos:broader":"https://homosaurus.org/v3/homoit0002682","skos:related":"https://homosaurus.org/v3/homoit0001866","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@typ