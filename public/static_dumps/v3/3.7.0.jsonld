s:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002353","dc:identifier":"homoit0002353","skos:prefLabel":"Sons","rdfs:comment":"People who are sons.","skos:broader":"https://homosaurus.org/v3/homoit0000421","skos:narrower":["https://homosaurus.org/v3/homoit0001329","https://homosaurus.org/v3/homoit0002355","https://homosaurus.org/v3/homoit0003244"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002355","dc:identifier":"homoit0002355","skos:prefLabel":"Sons of LGBTQ+ people","rdfs:comment":"Sons who have one or more LGBTQ+ parent. For sons who are themselves LGBTQ+, use the term \"LGBTQ+ sons.\"","skos:broader":"https://homosaurus.org/v3/homoit0002353","skos:narrower":["https://homosaurus.org/v3/homoit0001330","https://homosaurus.org/v3/homoit0001331","https://homosaurus.org/v3/homoit0001332","https://homosaurus.org/v3/homoit0001333","https://homosaurus.org/v3/homoit0001334","https://homosaurus.org/v3/homoit0002745","https://homosaurus.org/v3/homoit0002914"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002356","dc:identifier":"homoit0002356","skos:prefLabel":"LGBTQ+ grandchildren","skos:altLabel":"Grandchildren (LGBTQ)","rdfs:comment":"LGBTQ+ people who are grandchildren.","skos:broader":["https://homosaurus.org/v3/homoit0000601","https://homosaurus.org/v3/homoit0000915"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002357","dc:identifier":"homoit0002357","skos:prefLabel":"Grandchildren of LGBTQ+ people","rdfs:comment":"People who have one or more LGBTQ+ grandparent. For grandchildren who are themselves LGBTQ+, use the term \"LGBTQ+ grandchildren.\"","skos:broader":"https://homosaurus.org/v3/homoit0000601","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002358","dc:identifier":"homoit0002358","skos:prefLabel":"LGBTQ+ grandparents","skos:altLabel":"Grandparents (LGBTQ)","rdfs:comment":"LGBTQ+ people who are grandparents.","skos:broader":["https://homosaurus.org/v3/homoit0000602","https://homosaurus.org/v3/homoit0000915"],"skos:related":"https://homosaurus.org/v3/homoit0002586","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002359","dc:identifier":"homoit0002359","skos:prefLabel":"Grandparents of LGBTQ+ people","rdfs:comment":"People who have one or more LGBTQ+ grandchild. For grandparents who are themselves LGBTQ+, use the term \"LGBTQ+ grandparents.\"","skos:broader":"https://homosaurus.org/v3/homoit0000602","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002360","dc:identifier":"homoit0002360","skos:prefLabel":"LGBTQ+ family members","skos:altLabel":"Family members (LGBTQ)","rdfs:comment":"Family members who are LGBTQ+.","skos:broader":["https://homosaurus.org/v3/homoit0000421","https://homosaurus.org/v3/homoit0000915"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002361","dc:identifier":"homoit0002361","skos:prefLabel":"Family members of LGBTQ+ people","rdfs:comment":"People who have one or more LGBTQ+ family member. For family members who are themselves LGBTQ+, use the term \"LGBTQ+ family members.\"","skos:broader":"https://homosaurus.org/v3/homoit0000421","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002362","dc:identifier":"homoit0002362","skos:prefLabel":"Lesbian children","skos:altLabel":"Lesbian kids","rdfs:comment":"Lesbians who have not yet reached the age of adolescence.","skos:broader":"https://homosaurus.org/v3/homoit0000256","skos:related":"https://homosaurus.org/v3/homoit0000743","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002363","dc:identifier":"homoit0002363","skos:prefLabel":"Gay children","skos:altLabel":"Gay kids","rdfs:comment":"Gay people who have not yet reached the age of adolescence.","skos:broader":"https://homosaurus.org/v3/homoit0000256","skos:related":"https://homosaurus.org/v3/homoit0000479","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002366","dc:identifier":"homoit0002366","skos:prefLabel":"Partners of LGBTQ+ people","rdfs:comment":"Individuals who have one ore more romantic, sexual, or play partner who is LGBTQ+.","skos:broader":"https://homosaurus.org/v3/homoit0002365","skos:narrower":["https://homosaurus.org/v3/homoit0001084","https://homosaurus.org/v3/homoit0001086","https://homosaurus.org/v3/homoit0001087","https://homosaurus.org/v3/homoit0001088","https://homosaurus.org/v3/homoit0001089","https://homosaurus.org/v3/homoit0002743","https://homosaurus.org/v3/homoit0002911"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002365"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002367","dc:identifier":"homoit0002367","skos:prefLabel":"Lesbian partners","rdfs:comment":"Lesbians who are the romantic, sexual, or play partners of another person or people.","skos:broader":"https://homosaurus.org/v3/homoit0001083","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002368","dc:identifier":"homoit0002368","skos:prefLabel":"Gay partners","rdfs:comment":"Gay men who are the romantic, sexual, or play partners of another person or people.","skos:broader":"https://homosaurus.org/v3/homoit0001083","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002369","dc:identifier":"homoit0002369","skos:prefLabel":"Bisexual partners","rdfs:comment":"Bisexual people who are the romantic, sexual, or play partners of another person or people.","skos:broader":"https://homosaurus.org/v3/homoit0001083","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002370","dc:identifier":"homoit0002370","skos:prefLabel":"Transgender partners","rdfs:comment":"Transgender people who are the romantic, sexual, or play partners of another person or people.","skos:broader":"https://homosaurus.org/v3/homoit0001083","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002371","dc:identifier":"homoit0002371","skos:prefLabel":"Queer partners","rdfs:comment":"Queer people who are the romantic, sexual, or play partners of another person or people.","skos:broader":"https://homosaurus.org/v3/homoit0001083","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002372","dc:identifier":"homoit0002372","skos:prefLabel":"Parents","rdfs:comment":"People who act as parents to one or more people.","skos:broader":"https://homosaurus.org/v3/homoit0000421","skos:narrower":["https://homosaurus.org/v3/homoit0000010","https://homosaurus.org/v3/homoit0000121","https://homosaurus.org/v3/homoit0000452","https://homosaurus.org/v3/homoit0001075","https://homosaurus.org/v3/homoit0001076","https://homosaurus.org/v3/homoit0001764","https://homosaurus.org/v3/homoit0002224"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002373","dc:identifier":"homoit0002373","skos:prefLabel":"Police interactions with LGBTQ+ people","skos:altLabel":["Police treatment of LGBTQ+ people","Policing and the LGBTQ+ community"],"rdfs:comment":"Umbrella term including any of various forms of interactions between police and LGBTQ+ individuals or communities.","skos:narrower":["https://homosaurus.org/v3/homoit0000068","https://homosaurus.org/v3/homoit0002374","https://homosaurus.org/v3/homoit0002375","https://homosaurus.org/v3/homoit0002378","https://homosaurus.org/v3/homoit0002392","https://homosaurus.org/v3/homoit0002394","https://homosaurus.org/v3/homoit0002396"],"skos:related":["https://homosaurus.org/v3/homoit0001289","https://homosaurus.org/v3/homoit0001326","https://homosaurus.org/v3/homoit0001349"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002373"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002374","dc:identifier":"homoit0002374","skos:prefLabel":"Police entrapment of LGBTQ+ people","rdfs:comment":"A practice in which law enforcement agents or agents of the state coerce an LGBTQ+ person to commit a \"crime\" they would have otherwise been unlikely or unwilling to commit. Legal definitions of entrapment vary widely depending on the jurisdiction, but the term is often used colloquially to refer to police acting dishonestly or in bad faith, as well as policing focused on anticipating and inducing crime, rather than responding to reports of crime.","skos:broader":["https://homosaurus.org/v3/homoit0001120","https://homosaurus.org/v3/homoit0002373"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000611"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002375","dc:identifier":"homoit0002375","skos:prefLabel":"Police harassment of LGBTQ+ people","skos:altLabel":[" Mistreatment of LGBTQ+ people by police","Harassment of LGBTQ+ people by police","Police brutality toward LGBTQ+ people","Police misconduct toward LGBTQ+ people","Police mistreatment of LGBTQ+ people"],"rdfs:comment":"Any of various forms of inappropriate conduct, illegal actions, or abuses of power undertaken by law enforcement agents or agents of the state against LGBTQ+ members of the public. This includes but is not limited to racial, ethnic, and other forms of profiling; unwarranted surveillance, searches, and seizure; selective enforcement; excessive use of force; sexual misconduct; intimidation and witness tampering; falsification of evidence; coerced confessions; false arrests and imprisonment; and bribing or lobbying.","skos:broader":["https://homosaurus.org/v3/homoit0001121","https://homosaurus.org/v3/homoit0002373"],"skos:narrower":["https://homosaurus.org/v3/homoit0002376","https://homosaurus.org/v3/homoit0002377"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000611"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002376","dc:identifier":"homoit0002376","skos:prefLabel":"Police harassment of Black LGBTQ+ people","rdfs:comment":"Any of various forms of inappropriate conduct, illegal actions, or abuses of power undertaken by law enforcement agents or agents of the state against Black LGBTQ+ members of the public. This includes but is not limited to racial, ethnic, and other forms of profiling; unwarranted surveillance, searches, and seizure; selective enforcement; excessive use of force; sexual misconduct; intimidation and witness tampering; falsification of evidence; coerced confessions; false arrests and imprisonment; and bribing or lobbying.","skos:broader":"https://homosaurus.org/v3/homoit0002375","skos:related":["https://homosaurus.org/v3/homoit0000208","https://homosaurus.org/v3/homoit0002257","https://homosaurus.org/v3/homoit0002397"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000611"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002377","dc:identifier":"homoit0002377","skos:prefLabel":"Police harassment of Indigenous LGBTQ+ people","rdfs:comment":"Any of various forms of inappropriate conduct, illegal actions, or abuses of power undertaken by law enforcement agents or agents of the state against Indigenous LGBTQ+ members of the public. This includes but is not limited to racial, ethnic, and other forms of profiling; unwarranted surveillance, searches, and seizure; selective enforcement; excessive use of force; sexual misconduct; intimidation and witness tampering; falsification of evidence; coerced confessions; false arrests and imprisonment; and bribing or lobbying.","skos:broader":"https://homosaurus.org/v3/homoit0002375","skos:related":["https://homosaurus.org/v3/homoit0000886","https://homosaurus.org/v3/homoit0002397"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000611"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002378","dc:identifier":"homoit0002378","skos:prefLabel":"Police violence toward LGBTQ+ people ","skos:altLabel":["Police abuse toward LGBTQ+ people","Police torture of LGBTQ+ people"],"rdfs:comment":"Any of various forms of police violence aimed toward LGBTQ+ people.","skos:broader":["https://homosaurus.org/v3/homoit0000059","https://homosaurus.org/v3/homoit0002373"],"skos:narrower":["https://homosaurus.org/v3/homoit0002381","https://homosaurus.org/v3/homoit0002395"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000059"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002379","dc:identifier":"homoit0002379","skos:prefLabel":"LGBTQ+ criminalization","skos:altLabel":"Criminalization of LGBTQ+ people","rdfs:comment":"Criminalization of existing or identifying as an LGBTQ+ person, being perceived as LGBTQ+, or engaging in any of various actions considered to be linked to LGBTQ+ status.","skos:broader":"https://homosaurus.org/v3/homoit0000314","skos:narrower":"https://homosaurus.org/v3/homoit0002380","skos:related":"https://homosaurus.org/v3/homoit0000356","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002380","dc:identifier":"homoit0002380","skos:prefLabel":"Criminalization of homosexuality","skos:altLabel":["Criminalization of same-gender relations","Criminalization of same-sex relations"],"rdfs:comment":"Criminalization of acts considered to be sexual or romantic between individuals perceived as being of the same gender category in a given sociocultural context.","skos:broader":"https://homosaurus.org/v3/homoit0002379","skos:related":"https://homosaurus.org/v3/homoit0001326","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002381","dc:identifier":"homoit0002381","skos:prefLabel":"Police raids on LGBTQ+-related establishments","skos:altLabel":["Anti-LGBTQ+ police raids","Police raids on LGBTQ+ establishments","Police raids on LGBTQ+ venues","Police raids to LGBTQ+ venues"],"rdfs:comment":"Unexpected and unannounced entry into and searches of establishments owned or frequented by LGBTQ+ people by law enforcement officers with the aim of using surprise to seize evidence or arrest suspects. Police raids may be undertaken legally using a search warrant or through exigent circumstances, such as probable cause, though the latter is highly subjective and civilians often have little resources to appeal illegal raids.","skos:broader":["https://homosaurus.org/v3/homoit0001122","https://homosaurus.org/v3/homoit0002378"],"skos:narrower":["https://homosaurus.org/v3/homoit0002382","https://homosaurus.org/v3/homoit0002383","https://homosaurus.org/v3/homoit0002384","https://homosaurus.org/v3/homoit0002385"],"skos:related":["https://homosaurus.org/v3/homoit0001735","https://homosaurus.org/v3/homoit0001741"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000611"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002382","dc:identifier":"homoit0002382","skos:prefLabel":"Police raids on LGBTQ+ bathhouses","rdfs:comment":"Unexpected and unannounced entry into and searches of bathouses, saunas, or spas owned or frequented by LGBTQ+ people by law enforcement officers with the aim of using surprise to seize evidence or arrest suspects. Police raids may be undertaken legally using a search warrant or through exigent circumstances, such as probable cause, though the latter is highly subjective and civilians often have little resources to appeal illegal raids.","skos:broader":"https://homosaurus.org/v3/homoit0002381","skos:related":"https://homosaurus.org/v3/homoit0000475","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000611"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002383","dc:identifier":"homoit0002383","skos:prefLabel":"Police raids on LGBTQ+ meeting places","rdfs:comment":"Unexpected and unannounced entry into and searches of meeting places owned or frequented by LGBTQ+ people, including individuals' residences, businesses, and other institutions, by law enforcement officers with the aim of using surprise to seize evidence or arrest suspects. Police raids may be undertaken legally using a search warrant or through exigent circumstances, such as probable cause, though the latter is highly subjective and civilians often have little resources to appeal illegal raids.","skos:broader":"https://homosaurus.org/v3/homoit0002381","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000611"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002384","dc:identifier":"homoit0002384","skos:prefLabel":"Police raids on LGBTQ+ bars","rdfs:comment":"Unexpected and unannounced entry into and searches of drinking establishments owned or frequented by LGBTQ+ people by law enforcement officers with the aim of using surprise to seize evidence or arrest suspects. Police raids may be undertaken legally using a search warrant or through exigent circumstances, such as probable cause, though the latter is highly subjective and civilians often have little resources to appeal illegal raids.","skos:broader":"https://homosaurus.org/v3/homoit0002381","skos:related":"https://homosaurus.org/v3/homoit0000100","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000611"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002385","dc:identifier":"homoit0002385","skos:prefLabel":"Police raids on LGBTQ+ nightclubs","rdfs:comment":"Unexpected and unannounced entry into and searches of nightclubs owned or frequented by LGBTQ+ people by law enforcement officers with the aim of using surprise to seize evidence or arrest suspects. Police raids may be undertaken legally using a search warrant or through exigent circumstances, such as probable cause, though the latter is highly subjective and civilians often have little resources to appeal illegal raids.","skos:broader":"https://homosaurus.org/v3/homoit0002381","skos:related":"https://homosaurus.org/v3/homoit0000909","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000611"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002386","dc:identifier":"homoit0002386","skos:prefLabel":"No Police at Pride","skos:altLabel":["No Cops at Pride movement","No Cops at Pride","No Police at Pride movement"],"rdfs:comment":"Primarily Canadian and U.S. American movement wherein police officers were banned from LGBTQ+ pride events in some locations, due to historical and contemporary mistreatment of LGBTQ+ persons, especially Black and Indigenous LGBTQ+ persons. In recent years acted as a response to the 2010-2017 Toronto serial homicides and the mishandling of the investigation by the Toronto Police Service.","skos:related":["https://homosaurus.org/v3/homoit0003651","https://homosaurus.org/v3/homoit0003653"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002386"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002387","dc:identifier":"homoit0002387","skos:prefLabel":"Non-binary parents","rdfs:comment":"Parents who are non-binary.","skos:broader":["https://homosaurus.org/v3/homoit0001048","https://homosaurus.org/v3/homoit0001075"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002388","dc:identifier":"homoit0002388","skos:prefLabel":"Criminalization of gender non-conformity","rdfs:comment":"Criminalization of any expression of gender considered to be nonconforming in a given sociocultural context.","skos:broader":"https://homosaurus.org/v3/homoit0000314","skos:narrower":"https://homosaurus.org/v3/homoit0002389","skos:related":"https://homosaurus.org/v3/homoit0001922","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002389","dc:identifier":"homoit0002389","skos:prefLabel":"Criminalization of cross-dressing","rdfs:comment":"Criminalization of any expression of gender considered to be cross-dressing in a given sociocultural context.","skos:broader":"https://homosaurus.org/v3/homoit0002388","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002390","dc:identifier":"homoit0002390","skos:prefLabel":"Defund the police movement","skos:altLabel":["Defund the Police","Movement to defund police"],"rdfs:comment":"Primarily a U.S. American and Canadian movement which supports divesting funds from, or abolition of, police departments (and often police structures generally) and reallocating them to non-policing forms of public safety and community support, such as social services, youth services, housing, education, healthcare and other community resources.","skos:broader":"https://homosaurus.org/v3/homoit0001322","skos:related":["https://homosaurus.org/v3/homoit0001119","https://homosaurus.org/v3/homoit0002391"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001322"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002391","dc:identifier":"homoit0002391","skos:prefLabel":"Police abolitionist movement","skos:altLabel":"Abolishing the police movement","rdfs:comment":"A primarily U.S. American and Canadian political movement that advocates replacing policing with other systems of public safety. Police abolitionists believe that policing, as a system, is inherently flawed and cannot be reformed—a view that rejects the ideology of police reformists. While reformists seek to address the ways in which policing occurs, abolitionists seek to transform policing altogether through a process of disbanding, disempowering, and disarming the police. Abolitionists argue that the institution of policing is deeply rooted in a history of white supremacy and settler colonialism and that it is inseparable from a pre-existing racial capitalist order, and thus believe a reformist approach to policing will always fail.","skos:broader":"https://homosaurus.org/v3/homoit0001322","skos:related":["https://homosaurus.org/v3/homoit0001119","https://homosaurus.org/v3/homoit0002390"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001322"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002392","dc:identifier":"homoit0002392","skos:prefLabel":"Identification of LGBTQ+ people by police","rdfs:comment":"Identification of LGBTQ+ people, or people believed to be LGBTQ+, by police using any of various tools and mechanisms, many of which are pseudoscientific in nature. Such data is then used to entrap and prosecute LGBTQ+ persons, especially in areas where being LGBTQ+ is still criminalized.","skos:broader":"https://homosaurus.org/v3/homoit0002373","skos:narrower":"https://homosaurus.org/v3/homoit0002393","skos:related":"https://homosaurus.org/v3/homoit0001065","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002373"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002393","dc:identifier":"homoit0002393","skos:prefLabel":"Digital identification of LGBTQ+ people by police","skos:altLabel":["Digital stop and search to identify LGBTQ+ people","Identification of LGBTQ+ people by police using phone data","Police use of digital tools to identify LGBTQ+ people"],"rdfs:comment":"Identification of LGBTQ+ people, or people believed to be LGBTQ+, by police using digital tools, such as phone records, mobile applications, facial identification algorithms, and artificial intelligence technologies. Such data is then used to entrap and prosecute LGBTQ+ persons, especially in areas where being LGBTQ+ is still criminalized.","skos:broader":"https://homosaurus.org/v3/homoit0002392","skos:related":["https://homosaurus.org/v3/homoit0000846","https://homosaurus.org/v3/homoit0000847"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002373"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002394","dc:identifier":"homoit0002394","skos:prefLabel":"Attitudes of LGBTQ+ people toward police ","skos:altLabel":["LGBTQ+ viewpoints on police","LGBTQ+ views of police","Perceptions of police by LGBTQ+ communities","Perceptions of police by LGBTQ+ people"],"rdfs:comment":"Attitudes and assessments of feelings, relationships, and interactions between LGBTQ+ people and police.","skos:broader":"https://homosaurus.org/v3/homoit0002373","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002373"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002395","dc:identifier":"homoit0002395","skos:prefLabel":"Shootings of LGBTQ+ people by police","rdfs:comment":"Shooting of LGBTQ+ individuals or individuals perceived as being LGBTQ+ by police officers.","skos:broader":"https://homosaurus.org/v3/homoit0002378","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000059"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002396","dc:identifier":"homoit0002396","skos:prefLabel":"Performative LGBTQ+ activism by police","skos:altLabel":["Gay copaganda","LGBTQ+ copaganda","Pinkwashing by police officers","Pride patches on police uniforms","Rainbow colored patrol cars","Rainbow hate crime cars","Rainbow-hued police cars","Rainbow-painted police cars","Rainbow-washing by police officers"],"rdfs:comment":"LGBTQ+ activism undertaken by police organizations and institutions which intends to increase the social capital of such institutions, rather than to actually serve LGBTQ+ communities.","skos:broader":"https://homosaurus.org/v3/homoit0002373","skos:related":"https://homosaurus.org/v3/homoit0000006","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002373"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002397","dc:identifier":"homoit0002397","skos:prefLabel":"White supremacy in policing ","skos:altLabel":["Far-right presence in police forces","Infiltration of police by white supremacists","Law enforcement and white supremacy","Police and right-wing extremism","Police officer ties with white supremacists","Police with far-right ties"],"rdfs:comment":"Historical and contemporary linkages between white supremacist ideologies and modern policing institutions, primarily discussed within the context of the countries of Canada and the United States.","skos:related":["https://homosaurus.org/v3/homoit0001119","https://homosaurus.org/v3/homoit0002376","https://homosaurus.org/v3/homoit0002377"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002397"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002398","dc:identifier":"homoit0002398","skos:prefLabel":"Black Lives Matter movement ","skos:altLabel":["BLM","Black Lives Matter","BlackLivesMatter","Movement for Black Lives"],"rdfs:comment":"A primarily U.S. American and Canadian decentralized political and social movement advocating for non-violent civil disobedience in protest against incidents of police brutality and all racially motivated violence against Black people. The broader movement and its related organizations typically advocate against police violence towards Black people, as well as for various other policy changes considered to be related to Black liberation.","skos:broader":"https://homosaurus.org/v3/homoit0001322","skos:narrower":"https://homosaurus.org/v3/homoit0002399","skos:related":"https://homosaurus.org/v3/homoit0000208","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2016001442"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001322"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002399","dc:identifier":"homoit0002399","skos:prefLabel":"Black Trans Lives Matter movement ","skos:altLabel":["BTLM Movement","BTLM"],"rdfs:comment":"A part of the Black Lives Matter movement which specifically advocates for Black trans people (especially Black trans women) and fights for racial equity and Black liberation.","skos:broader":"https://homosaurus.org/v3/homoit0002398","skos:related":["https://homosaurus.org/v3/homoit0000208","https://homosaurus.org/v3/homoit0001396"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001322"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002400","dc:identifier":"homoit0002400","skos:prefLabel":"Aromantic comics ","rdfs:comment":"Works consisting of sequential images often accompanied by text; use in reference to comics focusing on aromantic characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000841","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002401","dc:identifier":"homoit0002401","skos:prefLabel":"Aromantic poetry ","rdfs:comment":"Literary work, typically written in verse, that focuses on aromantic characters, themes, or identity.","skos:broader":"https://homosaurus.org/v3/homoit0001118","skos:related":["https://homosaurus.org/v3/homoit0001748","https://homosaurus.org/v3/homoit0002449"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-17"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002402","dc:identifier":"homoit0002402","skos:prefLabel":"Intersex comics","rdfs:comment":"Works consisting of sequential images often accompanied by text; use in reference to comics focusing on intersexual characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000841","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-17"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002403","dc:identifier":"homoit0002403","skos:prefLabel":"Intersex poetry",