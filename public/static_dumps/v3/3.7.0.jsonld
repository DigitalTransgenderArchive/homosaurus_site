3","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003673","dc:identifier":"homoit0003673","skos:prefLabel":"Aromantic poets","rdfs:comment":"Creators of written or spoken verse who identify as aromantic.","skos:broader":"https://homosaurus.org/v3/homoit0003663","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003674","dc:identifier":"homoit0003674","skos:prefLabel":"Demisexual poets","rdfs:comment":"Creators of written or spoken verse who identify as demisexual.","skos:broader":"https://homosaurus.org/v3/homoit0003663","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003675","dc:identifier":"homoit0003675","skos:prefLabel":"Greyromantic poets","rdfs:comment":"Creators of written or spoken verse who identify as greyromantic.","skos:broader":"https://homosaurus.org/v3/homoit0003663","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003676","dc:identifier":"homoit0003676","skos:prefLabel":"Megasexual poets","rdfs:comment":"Creators of written or spoken verse who identify as megasexual.","skos:broader":"https://homosaurus.org/v3/homoit0003663","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003677","dc:identifier":"homoit0003677","skos:prefLabel":"LGBTQ+ television personalities","skos:altLabel":["Television personalities (LGBTQ)","LGBTQ+ TV personalities","TV personalities (LGBTQ)"],"rdfs:comment":"LGBTQ+ people who are well-known to the public through their appearances on television shows, typically as themselves rather than in scripted roles.","skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:narrower":["https://homosaurus.org/v3/homoit0003678","https://homosaurus.org/v3/homoit0003679","https://homosaurus.org/v3/homoit0003680","https://homosaurus.org/v3/homoit0003681","https://homosaurus.org/v3/homoit0003682","https://homosaurus.org/v3/homoit0003683","https://homosaurus.org/v3/homoit0003684","https://homosaurus.org/v3/homoit0003685","https://homosaurus.org/v3/homoit0003687","https://homosaurus.org/v3/homoit0003688","https://homosaurus.org/v3/homoit0003689","https://homosaurus.org/v3/homoit0003690"],"skos:related":"https://homosaurus.org/v3/homoit0003686","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003678","dc:identifier":"homoit0003678","skos:prefLabel":"Lesbian television personalities","skos:altLabel":"Lesbian TV personalities","