":"Groups of LGBTQ+ people living in community and sharing possessions and responsibilities.","skos:broader":"https://homosaurus.org/v3/homoit0000297","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQCommunes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000843","dc:identifier":"homoit0000843","skos:prefLabel":"Conception by LGBTQ+ people","skos:altLabel":"Conception by LGBTQ people","rdfs:comment":"Umbrella term used to describe the processes by which LGBTQ+ people conceive children, including an LGBTQ+ person, their partner, or a third party becoming pregnant with a child that will be raised by an LGBTQ+ person, as well as LGBTQ+ people conceiving children that will be raised by other parents.","skos:broader":"https://homosaurus.org/v3/homoit0000864","skos:narrower":["https://homosaurus.org/v3/homoit0000069","https://homosaurus.org/v3/homoit0000659","https://homosaurus.org/v3/homoit0001265","https://homosaurus.org/v3/homoit0001347"],"skos:related":["https://homosaurus.org/v3/homoit0000121","https://homosaurus.org/v3/homoit0000347","https://homosaurus.org/v3/homoit0000364","https://homosaurus.org/v3/homoit0001075"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000864"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ConceptionByLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000844","dc:identifier":"homoit0000844","skos:prefLabel":"LGBTQ+ conscientious objection","skos:altLabel":"LGBTQ conscientious objection","rdfs:comment":"LGBTQ+ people exercising their right to refuse to perform military service or participate in same-sex marriages on the grounds of freedom of thought, conscience, and/or religion.","skos:broader":"https://homosaurus.org/v3/homoit0000853","skos:related":"https://homosaurus.org/v3/homoit0000504","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQConscientiousObjection"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000845","dc:identifier":"homoit0000845","skos:prefLabel":"LGBTQ+ cruises","skos:altLabel":"LGBTQ cruises","rdfs:comment":"Voyages on a ship taken for pleasure or as a vacation; use in reference to cruises catered toward LGBTQ+ clientele.","skos:broader":"https://homosaurus.org/v3/homoit0000956","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000956"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQCruises"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000956","dc:identifier":"homoit0000956","skos:prefLabel":"LGBTQ+ tourism","skos:altLabel":"LGBTQ tourism","rdfs:comment":"Industry centered around LGBTQ+ people traveling to and staying in various locations for recreation or leisure. ","skos:narrower":["https://homosaurus.org/v3/homoit0000845","https://homosaurus.org/v3/homoit0003262","https://homosaurus.org/v3/homoit0003279"],"skos:related":["https://homosaurus.org/v3/homoit0000881","https://homosaurus.org/v3/homoit0000930"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000956"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQTourism"},"