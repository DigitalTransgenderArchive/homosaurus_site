","skos:related":["https://homosaurus.org/v3/homoit0000262","https://homosaurus.org/v3/homoit0000914","https://homosaurus.org/v3/homoit0001195","https://homosaurus.org/v3/homoit0002583","https://homosaurus.org/v3/homoit0002588"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001177","dc:identifier":"homoit0001177","skos:prefLabel":"Queer fiction","rdfs:comment":"Written works that describe imagined events or people; use in reference to fictional works focusing on queer characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000443","skos:related":["https://homosaurus.org/v3/homoit0001728","https://homosaurus.org/v3/homoit0001752","https://homosaurus.org/v3/homoit0001753","https://homosaurus.org/v3/homoit0001754","https://homosaurus.org/v3/homoit0002193"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerFiction"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001178","dc:identifier":"homoit0001178","skos:prefLabel":"Queer identity","rdfs:comment":"Identity term that can be used to describe several not-necessarily-mutually-exclusive understandings of queerness. Queerness can describe identities that exist outside of or between different identities, and also identities that actively resist normative understandings of sexuality and/or gender. This term should only be used for those who self-identify as queer.","skos:broader":"https://homosaurus.org/v3/homoit0001295","skos:related":["https://homosaurus.org/v3/homoit0001167","https://homosaurus.org/v3/homoit0001195"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001179","dc:identifier":"homoit0001179","skos:prefLabel":["Queer information centers","Queer information centres"],"rdfs:comment":"Institutions that provide education, support, and information about queerness and queer communities to queer people.","skos:broader":"https://homosaurus.org/v3/homoit0000660","skos:related":"https://homosaurus.org/v3/homoit0001187","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerInformationCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001180","dc:identifier":"homoit0001180","skos:prefLabel":"Jewish queer people","skos:altLabel":["Jewish queers","Queer Jews"],"rdfs:comment":"Queer people who are Jewish.","skos:broader":"https://homosaurus.org/v3/homoit0000682","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerJews"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001181","dc:identifier":"homoit0001181","skos:prefLabel":"Latino/a/x queer people","skos:altLabel":["Latina queer people","Latine queer people","Latino queer people","Latinx queer people","Queer Latinas","Queer Latine people","Queer Latinos","Queer Latinx people"],"rdfs:comment":"Latin American people who are queer; only use to describe individuals who self-identify as Latino, Latina, or Latinx. Do not conflate with Chicano/a/x or Hispanic.","skos:broader":"https://homosaurus.org/v3/homoit0000253","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerLatinx"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001182","dc:identifier":"homoit0001182","skos:prefLabel":"Queer libraries","rdfs:comment":"Libraries that hold materials primarily pertaining to queer people or intended for use by queer people.","skos:broader":"https://homosaurus.org/v3/homoit0000968","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerLibraries"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001183","dc:identifier":"homoit0001183","skos:prefLabel":"Queer literature","rdfs:comment":"Written literary works about queerness, queer characters, or queer themes.","skos:broader":"https://homosaurus.org/v3/homoit0000972","skos:related":"https://homosaurus.org/v3/homoit0001728","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerLiterature"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001184","dc:identifier":"homoit0001184","skos:prefLabel":"Queer dominants","skos:altLabel":"Queer masters","rdfs:comment":"Queer people who are part of the BDSM scene and assume the dominant role in sexual relationships with a dominant/submissive dynamic.","skos:broader":"https://homosaurus.org/v3/homoit0000999","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerMasters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001185","dc:identifier":"homoit0001185","skos:prefLabel":"Queer men","rdfs:comment":"Men who identify as queer.","skos:broader":"https://homosaurus.org/v3/homoit0001195","skos:related":["https://homosaurus.org/v3/homoit0000160","https://homosaurus.org/v3/homoit0000506"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001186","dc:identifier":"homoit0001186","skos:prefLabel":"Queer mistresses","rdfs:comment":"Queer women who are part of the BDSM scene and assume the mistress role in sexual relationships with a mistress/submissive dynamic.","skos:broader":"https://homosaurus.org/v3/homoit0001018","skos:related":["https://homosaurus.org/v3/homoit0000161","https://homosaurus.org/v3/homoit0000751","https://homosaurus.org/v3/homoit0001421"],"skos:hasTopConcept":{"@id":"https://homo