/authorities/subjects/sh2001007148"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianBars"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000725","dc:identifier":"homoit0000725","skos:prefLabel":"Lesbian beaches","rdfs:comment":"Beaches set aside for use by lesbians or beaches known to be frequented by lesbians.","skos:broader":"https://homosaurus.org/v3/homoit0000104","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianBeaches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000726","dc:identifier":"homoit0000726","skos:prefLabel":"Black lesbians","rdfs:comment":"Black people who are lesbians. Use only for individuals who self-identity as Black. Follow the individual’s preference for African American or Black whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000208","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2013002418"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianBlackPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000727","dc:identifier":"homoit0000727","skos:prefLabel":"Lesbian bookshops","rdfs:comment":"Bookshops that sell materials intended for us