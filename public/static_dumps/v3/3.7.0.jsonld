"@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000020","dc:identifier":"homoit0000020","skos:prefLabel":"Age of consent","rdfs:comment":"The age at which a person is considered legally competent to consent to sexual acts. The age of consent varies depending on the country, state, or culture.","skos:broader":"https://homosaurus.org/v3/homoit0000302","skos:related":["https://homosaurus.org/v3/homoit0000663","https://homosaurus.org/v3/homoit0001289","https://homosaurus.org/v3/homoit0002215"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85002086"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000302"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ageOfConsent"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000302","dc:identifier":"homoit0000302","skos:prefLabel":"Consent","rdfs:comment":"Permission or agreement for a set of actions to occur, particularly in a sexual encounter and/or within a relational dynamic.","skos:narrower":["https://homosaurus.org/v3/homoit0000020","https://homosaurus.org/v3/homoit0002844"],"skos:related":["https://homosaurus.org/v3/homoit0000241","https://homosaurus.org/v3/homoit0000442","https://homosaurus.org/v3/homoit0000855","https://homosaurus.org/v3/homoit0000938","https://homosaurus.org/v3/homoit0000958","https://homosaurus.org/v3/homoit0000959","https://homosaurus.org/v3/homoit0001123","https://homosaurus.org/v3/homoit0001124","https://homosaurus.org/v3/homoit0001133","https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001299","https://homosaurus.org/v3/homoit0002195","https://homosaurus.org/v3/homoit0002215"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh98003848"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000302"},"dc:replaces":{"@id":"http://homosaurus.org/v2/consent"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000021","dc:identifier":"homoit0000021","skos:prefLabel":"Agender people","rdfs:comment":"People who identify as not having a gender, or being genderless.","skos:broader":["https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001817"],"skos:related":["https://homosaurus.org/v3/homoit0000571","https://homosaurus.org/v3/homoit0001048","https://homosaurus.org/v3/homoit0001927"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/agenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000022","dc:identifier":"homoit0000022","skos:prefLabel":"Age play","skos:altLabel":["ABDL","Ageplay","Infantilism"],"rdfs:comment":"The act of roleplaying as people of different ages, usually as children, for fun or erotic enjoyment.","skos:broader":"https://homosaurus.org/v3/homoit0001242","skos:related":["https://homosaurus.org/v3/homoit0000442","https://homosaurus.org/v3/homoit0003052","https://homosaurus.org/v3/homoit0003062"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ageplay"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeN