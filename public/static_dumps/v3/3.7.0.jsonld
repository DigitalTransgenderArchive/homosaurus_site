us.org/v2/LGBTQPlatonicLove"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000922","dc:identifier":"homoit0000922","skos:prefLabel":"LGBTQ+ plays","skos:altLabel":["LGBTQ stage performances","LGBTQ plays"],"rdfs:comment":"Works of drama consisting primarily of dialogue between characters and intended for theatrical performance; use in reference to plays focusing on LGBTQ+ characters or themes.","skos:related":["https://homosaurus.org/v3/homoit0000376","https://homosaurus.org/v3/homoit0000546","https://homosaurus.org/v3/homoit0000788","https://homosaurus.org/v3/homoit0000816"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000922"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPlays"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000923","dc:identifier":"homoit0000923","skos:prefLabel":"LGBTQ+ porn magazines","skos:altLabel":"LGBTQ porn magazines","rdfs:comment":"Erotic or sexually explicit magazines featuring LGBTQ+ people.","skos:broader":["https://homosaurus.org/v3/homoit0001132","https://homosaurus.org/v3/homoit0003802"],"skos:related":["https://homosaurus.org/v3/homoit0001126","https://homosaurus.org/v3/homoit0001830"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPornMagazines"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000924","dc:identifier":"homoit0000924","skos:prefLabel":"LGBTQ+ prisoners of conscience","skos:altLabel":["Prisoners of conscience (LGBTQ)","LGBTQ prisoners of conscience"],"rdfs:comment":"LGBTQ+ people who are imprisoned because of their sexual or gender identities; may also be used to describe LGBTQ+ individuals imprisoned because of their race, religion, or political views.","skos:broader":"https://homosaurus.org/v3/homoit0000887","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPrisonersOfConscience"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000925","dc:identifier":"homoit0000925","skos:prefLabel":"LGBTQ+ pubs","skos:altLabel":["LGBTQ public houses","LGBTQ pubs"],"rdfs:comment":"A drinking establishment that serves food and acts as a community gathering place; use in reference to pubs that primarily cater to LGBTQ+ people.","skos:related":["https://homosaurus.org/v3/homoit0000100","https://homosaurus.org/v3/homoit0000369","https://homosaurus.org/v3/homoit0000474","https://homosaurus.org/v3/homoit0000724"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000925"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPubs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000926","dc:identifier":"homoit0000926","skos:prefLabel":"LGBTQ+ Quakers","skos:altLabel":["LGBTQ Religious Society of Friends","LGBTQ Society of Friends","Quakers (LGBTQ)","LGBTQ Quakers"],"rdfs:comment":"LGBTQ+ people who are Quakers.","skos:broader":"https://homosaurus.org/v3/homoit0001137","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQQuakers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000927","dc:identifier":"homoit0000927","skos:prefLabel":"LGBTQ+ refugees","skos:altLabel":["Refugees (LGBTQ)","LGBTQ refugees"],"rdfs:comment":"LGBTQ+ people who have fled to another country to escape war, persecution, natural disaster, or other forms of conflict. Only use for people legally recognized as refugees; otherwise, use LGBTQ+ asylum seekers.","skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:related":["https://homosaurus.org/v3/homoit0000712","https://homosaurus.org/v3/homoit0000883","https://homosaurus.org/v3/homoit0000902","https://homosaurus.org/v3/homoit0001108","https://homosaurus.org/v3/homoit0001482","https://homosaurus.org/v3/homoit0001815","https://homosaurus.org/v3/homoit0001853"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQRefugees"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000929","dc:identifier":"homoit0000929","skos:prefLabel":"LGBTQ+ resorts","skos:altLabel":"LGBTQ resorts","rdfs:comment":"Commercial establishments providing lodging, entertainment, food, drinks, sporting, and shopping; use in reference to resorts that cater primarily to LGBTQ+ people or are known to be frequented by LGBTQ+ people.","skos:broader":"https://homosaurus.org/v3/homoit0000881","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000881"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQResorts"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000930","dc:identifier":"homoit0000930","skos:prefLabel":"LGBTQ+ restaurants","skos:altLabel":"LGBTQ restaurants","rdfs:comment":"Commercial establishments that prepare and serve food and drinks; use in reference to restaurants that cater primarily to LGBTQ+ people or are known to be frequented by LGBTQ+ people.","skos:related":["https://homosaurus.org/v3/homoit0000909","https://homosaurus.org/v3/homoit0000956"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000930"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQRestaurants"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000931","dc:identifier":"homoit0000931","skos:prefLabel":"LGBTQ+ retirement homes","skos:altLabel":"LGBTQ retirement homes","rdfs:comment":"Multi-residence facilities that provide assisted living services to elderly people; use in reference to retirement homes that primarily cater to LGBTQ+ people.","skos:related":"https://homosaurus.org/v3/homoit0000393","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000931"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQRetirementHomes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000932","dc:identifier":"homoit0000932","skos:prefLabel":"LGBTQ+ riots","skos:altLabel":"LGBTQ riots","rdfs:comment":"Civil disorder directed against authorities, property, and other individuals, typically in response to grievances, conflicts, or injustice; use in reference to riots involving LGBTQ+ people or in response to LGBTQ+ issues.","skos:narrower":"https://homosaurus.org/v3/homoit0001341","skos:related":"https://homosaurus.org/v3/homoit0000851","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000932"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQRiots"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000933","dc:identifier":"homoit0000933","skos:prefLabel":"Schools for LGBTQ+ youth","skos:altLabel":["LGBTQ schools","Schools for LGBTQ youth"],"rdfs:comment":"Educational institutions providing instruction and resources specifically for LGBTQ+ youth.","skos:related":"https://homosaurus.org/v3/homoit0001521","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000933"},"dc:replaces":{"@id":"http://homosaurus.org/v2/schoolsForLGBTQYouth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000934","dc:identifier":"homoit0000934","skos:prefLabel":"LGBTQ+ science fiction","skos:altLabel":"Science fiction (LGBTQ)","rdfs:comment":"Written literary work about imaginative or futuristic concepts incorporating science, technology, space, time travel, and other speculative elements; use in reference to science fiction focusing on LGBTQ+ characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000443","skos:narrower":["https://homosaurus.org/v3/homoit0001570","https://homosaurus.org/v3/homoit0001571","https://homosau