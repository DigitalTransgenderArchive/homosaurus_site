gleFathers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000942","dc:identifier":"homoit0000942","skos:prefLabel":"LGBTQ+ single mothers","skos:altLabel":"LGBTQ single mothers","rdfs:comment":"LGBTQ+ people who are mothers but are not married or part of a long-term partnership.","skos:broader":["https://homosaurus.org/v3/homoit0000944","https://homosaurus.org/v3/homoit0001021"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSingleMothers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000943","dc:identifier":"homoit0000943","skos:prefLabel":"LGBTQ+ single parent families","skos:altLabel":"LGBTQ single parent families","rdfs:comment":"Families headed by a single parent; use in reference to single parent families headed by or including LGBTQ+ people.","skos:broader":"https://homosaurus.org/v3/homoit0000420","skos:related":["https://homosaurus.org/v3/homoit0000944","https://homosaurus.org/v3/homoit0001059"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSingleParentFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000944","dc:identifier":"homoit0000944","skos:prefLabel":"LGBTQ+ single parents","skos:altLabel":"LGBTQ single parents","rdfs:comment":"LGBTQ+ people who are parents but are not married or part of a long-term partnership.","skos:broader":["https://homosaurus.org/v3/homoit0001075","https://homosaurus.org/v3/homoit0001312"],"skos:narrower":["https://homosaurus.org/v3/homoit0000941","https://homosaurus.org/v3/homoit0000942"],"skos:related":"https://homosaurus.org/v3/homoit0000943","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSingleParents"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000945","dc:identifier":"homoit0000945","skos:prefLabel":"LGBTQ+ social parenthood","skos:altLabel":"Social parenthood (LGBTQ)","rdfs:comment":"The experiences involved in social parenting, as experienced by LGBTQ+ people.","skos:broader":"https://homosaurus.org/v3/homoit0000914","skos:related":["https://homosaurus.org/v3/homoit0000420","https://homosaurus.org/v3/homoit0000811","https://homosaurus.org/v3/homoit0000864","https://homosaurus.org/v3/homoit0000871"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000914"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSocialParenthood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000946","dc:identifier":"homoit0000946","skos:prefLabel":"LGBTQ+ social media","skos:altLabel":"LGBTQ social media","rdfs:comment":"Web-based and mobile technologies that facilitate interactive dialogue, as used by or designed for LGBTQ+ people.","skos:narrower":["https://homosaurus.org/v3/homoit0000823","https://homosaurus.org/v3/homoit0000832","https://homosaurus.org/v3/homoit0000846","https://homosa