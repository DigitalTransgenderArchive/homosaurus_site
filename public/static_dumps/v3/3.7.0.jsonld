:identifier":"homoit0001978","skos:prefLabel":"Aboriginal Australian queer people","skos:altLabel":["Aboriginal queer people","Queer Aboriginal Australian people","Queer Aboriginal Australians"],"rdfs:comment":"Queer people who belong to one or more of the various Indigenous peoples of Australia; do not use to refer to the Indigenous people of the Torres Strait Islands, who are considered ethnically and culturally distinct. Only use to describe people who identify as Aboriginal Australian.","skos:broader":"https://homosaurus.org/v3/homoit0000002","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001979","dc:identifier":"homoit0001979","skos:prefLabel":"Aboriginal Australian intersex people","skos:altLabel":["Aboriginal intersex people","Intersex Aboriginal Australian people","Intersex Aboriginal Australians"],"rdfs:comment":"Intersex people who belong to one or more of the various Indigenous peoples of Australia; do not use to refer to the Indigenous people of the Torres Strait Islands, who are considered ethnically and culturally distinct. Only use to describe people who identify as Aboriginal Australian.","skos:broader":"https://homosaurus.org/v3/homoit0000002","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001980","dc:identifier":"homoit0001980","skos:prefLabel":"GRID (Gay-Related Immune Deficiency)","skos:altLabel":["GRID","GRIDS","Gay Related Immune Deficiency","Gay-Related Immune Deficiency"],"rdfs:comment":"The original name for AIDS, proposed after public health scientists noticed clusters of Kaposi's sarcoma and Pneumocystis pneumonia among gay men in California and New York City. Should only be used in historical contexts.","skos:broader":["https://homosaurus.org/v3/homoit0000005","https://homosaurus.org/v3/homoit0000878"],"skos:related":"https://homosaurus.org/v3/homoit0000686","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001308"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001981","dc:identifier":"homoit0001981","skos:prefLabel":"HAART (Highly Active Antiretroviral Therapy)","skos:altLabel":["Combination Anti-Retroviral Therapy","Combination Antiretroviral Therapy","HAART","Highly Active Anti-Retroviral Therapy","Highly Active Antiretroviral Therapy","cART"],"rdfs:comment":"Treatment that involves the use of three or more drugs in combination to treat HIV infection by preventing the virus from making copies of itself in the body; can lessen the damage to the immune system caused by HIV, slow down the development of AIDS, and prevent the transmission of HIV to others.","skos:broader":"https://homosaurus.org/v3/homoit0001007","skos:related":"https://homosaurus.org/v3/homoit0000005","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008003832"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001982","dc:identifier":"homoit0001982","skos:prefLabel":"LGBTQ+ home movies","skos:altLabel":["Home movies (LGBTQ)","LGBTQ+ personal films","Personal films (LGBTQ)"],"rdfs:comment":"Short amateur films or videos created primarily to preserve memories; use in reference to home movies created by or featuring LGBTQ+ people.","skos:broader":"https://homosaurus.org/v3/homoit0000869","skos:narrower":"https://homosaurus.org/v3/homoit0001983","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001983","dc:identifier":"homoit0001983","skos:prefLabel":"LGBTQ+ vlogs","skos:altLabel":["LGBTQ+ video blogs","Video blogs (LGBTQ)","Vlogs (LGBTQ)"],"rdfs:comment":"A form of online blogging via short videos about an individual's life; use in reference to vlogs created by LGBTQ+ people or focusing on LGBTQ+ issues.","skos:broader":["https://homosaurus.org/v3/homoit0000823","https://homosaurus.org/v3/homoit0001982"],"skos:related":"https://homosaurus.org/v3/homoit0000946","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001321"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001984","dc:identifier":"homoit0001984","skos:prefLabel":"Nipple","skos:altLabel":"Nipples","rdfs:comment":"The small protuberance of a mammary gland.","skos:broader":"https://homosaurus.org/v3/homoit0000401","skos:related":["https://homosaurus.org/v3/homoit0001045","https://homosaurus.org/v3/homoit0001046","https://homosaurus.org/v3/homoit0003131"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2009007031"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000401"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"