.org/v3/homoit0001774","https://homosaurus.org/v3/homoit0001775","https://homosaurus.org/v3/homoit0001776","https://homosaurus.org/v3/homoit0002771"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-07"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001778","dc:identifier":"homoit0001778","skos:prefLabel":"Two-Spirit chefs","skos:altLabel":["2S chefs","Two Spirit chefs","Two Spirited chefs","Two-Spirited chefs"],"rdfs:comment":"Two-Spirit people who are trained, professional cooks, typically holding a leadership role in the kitchen in which they are employed.","skos:broader":"https://homosaurus.org/v3/homoit0001480","skos:related":"https://homosaurus.org/v3/homoit0001771","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-07"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001779","dc:identifier":"homoit0001779","skos:prefLabel":"Vers (Sex)","skos:altLabel":["Vers","Versatile"],"rdfs:comment":"Slang term for individuals who alternate between being the giving partner and the receiving partner in sexual encounters; typically used as an adjective (e.g., \"They're vers.\").","skos:broader":["https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001304"],"skos:related":["https://homosaurus.org/v3/homoit0000219","https://homosaurus.org/v3/homoit0001353","https://homosaurus.org/v3/homoit0001376"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-07"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001780","dc:identifier":"homoit0001780","skos:prefLabel":"t4t","skos:altLabel":["T4T (Trans for Trans)","TFT","Trans4Trans","tft"],"rdfs:comment":"Abbreviated form of the phrase \"trans for trans,\" a label used to describe trans people who prioritize engaging in romantic, sexual, or other relationships with other trans people.","skos:related":["https://homosaurus.org/v3/homoit0001089","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001403"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001780"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-07"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001781","dc:identifier":"homoit0001781","skos:prefLabel":"Clocking (Gender)","skos:altLabel":["Clocking (Transgender)","Clocking"],"rdfs:comment":"Slang term for the act of identifying (or clocking) someone in public as trans, crossdressing, or in drag when that person is intending to pass or be read by others as cisgender, typically for their personal safety. Clocking is often understood to be a threat (of violence or public outing) against the person being clocked. Use the term \"Reading (Gender)\" to refer to shared identification or recognized kinship between two individuals who are both gender minorities.","skos:related":["https://homosaurus.org/v3/homoit0000288","https://homosaurus.org/v3/homoit0000316","https://homosaurus.org/v3/homoit0001090","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001381","https://homosaurus.org/v3/homoit0001470"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001781"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-07"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001782","dc:identifier":"homoit0001782","skos:prefLabel":"Blaqueer people","skos:altLabel":"BlaQ people","rdfs:comment":"Black queer people who recognize their queer identity as salient to their Blackness and vice versa; only use to describe individuals who identify as Blaqueer or BlaQ.","skos:broader":"https://homosaurus.org/v3/homoit0000208","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-07"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001783","dc:identifier":"homoit0001783","skos:prefLabel":"Closeted LGBTQ+ people","skos:altLabel":"Closeted people (LGBTQ)","rdfs:comment":"LGBTQ+ people who do not identify as such to others.","skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:narrower":["https://homosaurus.org/v3/homoit0000285","https://homosaurus.org/v3/homoit0000286","https://homosaurus.org/v3/homoit0000287","https://homosaurus.org/v3/homoit0001784","https://homosaurus.org/v3/homoit0001785","https://homosaurus.org/v3/homoit0001786","https://homosaurus.org/v3/homoit0002905","https://homosaurus.org/v3/homoit0003403"],"skos:related":["https://homosaurus.org/v3/homoit0000288","https://homosaurus.org/v3/homoit0000295","https://homosaurus.org/v3/homoit0000365","https://homosaurus.org/v3/homoit0001065","https://homosaurus.org/v3/homoit0001261","https://homosaurus.org/v3/homoit0001787","https://homosaurus.org/v3/homoit0001788"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-08"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001784","dc:identifier":"homoit0001784","skos:prefLabel":"Closeted transgender people","skos:altLabel":"Closeted trans people","rdfs:comment":"Transgender people who do not identify as such to others.","skos:broader":["https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001783"],"skos:related":["https://homosaurus.org/v3/homoit0000285","https://homosaurus.org/v3/homoit0000286","https://homosaurus.org/v3/homoit0000287","https://homosaurus.org/v3/homoit0000288","https://homosaurus.org/v3/homoit0000295","https://homosaurus.org/v3/homoit0001065","https://homosaurus.org/v3/homoit0001261","https://homosaurus.org/v3/homoit0001785","https://homosaurus.org/v3/homoit0002905"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-08"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001785","dc:identifier":"homoit0001785","skos:prefLabel":"Closeted queer people","rdfs:comment":"Queer people who do not identify as such to others.","skos:broader":["https://homosaurus.org/v3/homoit0001195","https://homosaurus.org/v3/homoit0001783"],"skos:related":["https://homosaurus.org/v3/homoit0000285","https://homosaurus.org/v3/homoit0000286","https://homosaurus.org/v3/homoit0000287","https://homosaurus.org/v3/homoit0000288","https://homosaurus.org/v3/homoit0000295","https://homosaurus.org/v3/homoit0000365","https://homosaurus.org/v3/homoit0001065","https://homosaurus.org/v3/homoit0001261","https://homosaurus.org/v3/homoit0001784","https://homosaurus.org/v3/homoit0002905"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-08"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001786","dc:identifier":"homoit0001786","skos:prefLabel":"Closeted intersex people","rdfs:comment":"Intersex people who do not disclose the fact that they are intersex to others.","skos:broader":"https://homosaurus.org/v3/homoit0001783","skos:related":["https://homosaurus.org/v3/homoit0000288","https://homosaurus.org/v3/homoit0000295","https://homosaurus.org/v3/homoit0000365","https://homosaurus.org/v3/homoit0001065","https://homosaurus.org/v3/homoit0001261","https://homosaurus.org/v3/homoit0002905"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-08"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001787","dc:identifier":"homoit0001787","skos:prefLabel":"Closeted Two-Spirit people","skos:altLabel":["Closeted 2S people","Closeted Two Spirit people","Closeted Two Spirited people","Closeted Two-Spirited people"],"rdfs:comment":"Two-Spirit people who do not identify as such to others.","skos:broader":"https://homosaurus.org/v3/homoit0001480","skos:related":["https://homosaurus.org/v3/homoit0000288","https://homosaurus.org/v3/homoit0000295","https://homosaurus.org/v3/homoit0000365","https://homosaurus.org/v3/homoit0001065","https://homosaurus.org/v3/homoit0001261","https://homosaurus.org/v3/homoit0001783"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-08"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001788","dc:identifier":"homoit0001788","skos:prefLabel":"Beards (Gay culture)","skos:altLabel":"Beards","rdfs:comment":"Individuals who pose as the date or partner of someone they are not in a relationship with, typically to prevent that person's sexuality from becoming public knowledge; most commonly used to refer to a woman pretending to be dating a gay man.","skos:broader":"https://homosaurus.org/v3/homoit0000487","skos:related":["https://homosaurus.org/v3/homoit0000365","https://homosaurus.org/v3/homoit0000381","https://homosaurus.org/v3/homoit0000416","https://homosaurus.org/v3/homoit0000598","https://homosaurus.org/v3/homoit0001261","https://homosaurus.org/v3/homoit0001783"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-08"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001790","dc:identifier":"homoit0001790","skos:prefLabel":"Packers (Phallus)","rdfs:comment":"Padding or phallic objects designed to be worn in the front of an individual's pants or underwear to give the appearance of having a bulge.","skos:broader":"https://homosaurus.org/v3/homoit0000568","skos:related":["https://homosaurus.org/v3/homoit0001067","https://homosaurus.org/v3/homoit0001099"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001791","dc:identifier":"homoit0001791","skos:prefLabel":"Alloromanticism","rdfs:comment":"A romantic orientation characterized by the occurrence of romantic attraction or desire in a frequent and consistent manner, often alongside sexual attraction.","skos:broader":"https://homosaurus.org/v3/homoit0001828","skos:narrower":["https://homosaurus.org/v3/homoit0001792","https://homosaurus.org/v3/homoit0001793","https://homosaurus.org/v3/homoit0001794","https://homosaurus.org/v3/homoit0001795"],"skos:related":["https://homosaurus.org/v3/homoit0001644","https://homosaurus.org/v3/homoit0001823"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001828"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001792","dc:identifier":"homoit0001792","skos:prefLabel":"Biromanticism","rdfs:comment":"A romantic orientation characterized by the occurrence of romantic attraction or desire in a frequent and consistent manner toward more than one sex or gender.","skos:broader":["https://homosaurus.org/v3/homoit0001791","https://homosaurus.org/v3/homoit0001828"],"skos:related":"https://homosaurus.org/v3/homoit0001824","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001828"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001793","dc:identifier":"homoit0001793","skos:prefLabel":"Homoromanticism","rdfs:comment":"A romantic orientation characterized by the occurrence of romantic attraction or desire in a frequent and consistent manner toward members of the same sex or gender.","skos:broader":["https://homosaurus.org/v3/homoit0001791","https://homosaurus.org/v3/homoit0001828"],"skos:related":"https://homosaurus.org/v3/homoit0001825","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001828"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001794","dc:identifier":"homoit0001794","skos:prefLabel":"Heteroromanticism","rdfs:comment":"A romantic orientation characterized by the occurrence of romantic attraction or romantic desire in a frequent and consistent manner toward members of the opposite sex or gender.","skos:broader":["https://homosaurus.org/v3/homoit0001791","https://homosaurus.org/v3/homoit0001828"],"skos:related":"https://homosaurus.org/v3/homoit0001826","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001828"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001795","dc:identifier":"homoit0001795","skos:prefLabel":"Panromanticism","rdfs:comment":"A romantic orientation characterized by the occurrence of romantic attraction or romantic desire in a frequent and consistent manner irrespective of sex or gender.","skos:broader":["https://homosaurus.org/v3/homoit0001791","https://homosaurus.org/v3/homoit0001828"],"skos:related":"https://homosaurus.org/v3/homoit0001827","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001828"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001796","dc:identifier":"homoit0001796","skos:prefLabel":"Biracial lesbians","skos:altLabel":"Bi-racial lesbians","rdfs:comment":"Lesbians who belong to two or more racial groups. Only use to describe people who self-identify as biracial.","skos:broader":"https://homosaurus.org/v3/homoit0000820","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-01-18"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001797","dc:identifier":"homoit0001797","skos:prefLabel":"Biracial gay men","skos:altLabel":["Bi-racial gay men","Gay bi-racial men","Gay biracial men"],"rdfs:comment":"Gay men who belong to two or more racial groups. Only use to describe people who self-identify as biracial.","skos:broader":"https://homosaurus.org/v3/homoit0000820","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-01-18"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001798","dc:identifier":"homoit0001798","skos:prefLabel":"Biracial bisexual people","skos:altLabel":["Bi-racial bisexual people","Bisexual bi-racial people","Bisexual biracial people"],"rdfs:comment":"Bisexual people who belong to two or more racial groups. Only use to describe people who self-identify as biracial.","skos:broader":"https://homosaurus.org/v3/homoit0000820","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-01-18"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001799","dc:identifier":"homoit0001799","skos:prefLabel":"Biracial transgender people","skos:altLabel":["Bi-racial transgender people","Transgender bi-racial people","Transgender biracial people"],"rdfs:comment":"Transgender people who belong to two or more racial groups. Only use to describe people who self-identify as biracial.","skos:broader":"https://homosaurus.org/v3/homoit0000820","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-01-18"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001800","dc:identifier":"homoit0001800","skos:prefLabel":"Biracial queer people","skos:altLabel":["Bi-racial queer people","Queer bi-racial people","Queer biracial people"],"rdfs:comment":"Queer people who belong to two or more racial groups. Only use to describe people who self-identify as biracial.","skos:broader":"https://homosaurus.org/v3/homoit0000820","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-01-18"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001801","dc:identifier":"homoit0001801","skos:prefLabel":"Multiracial lesbians","skos:altLabel":"Multi-racial lesbians","rdfs:comment":"Lesbians who belong to two or more racial groups.","skos:broader":"https://homosaurus.org/v3/homoit0000903","skos:related":["https://homosaurus.org/v3/homoit0001802","https://homosaurus.org/v3/homoit0001803","https://homosaurus.org/v3/homoit0001804","https://homosaurus.org/v3/homoit0001805"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-01-18"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001802","dc:identifier":"homoit0001802","skos:prefLabel":"Multiracial gay men","skos:altLabel":["Gay multi-racial men","Gay multiracial men","Multi-racial gay men"],"rdfs:comment":"Gay men w