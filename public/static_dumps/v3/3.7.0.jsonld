und the chest and shoulders like a vest. May be worn as a fashion statement, to signal one's belonging to the leather or BDSM communities, or to restrict the wearer's movement during sex.","skos:broader":"https://homosaurus.org/v3/homoit0000612","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/chestHarnesses"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000253","dc:identifier":"homoit0000253","skos:prefLabel":"Latino/a/x LGBTQ+ people","skos:altLabel":["Latinas (LGBTQ)","Latinos (LGBTQ)","Latine people (LGBTQ)","Latinx people (LGBTQ)","LGBTQ+ Latinas","LGBTQ+ Latine people","LGBTQ+ Latinos","LGBTQ+ Latinx people"],"rdfs:comment":"Latin American people who are LGBTQ+; only use to describe individuals who self-identify as Latino, Latina, or Latinx. Do not conflate with Chicano/a/x or Hispanic.","skos:broader":"https://homosaurus.org/v3/homoit0000860","skos:narrower":["https://homosaurus.org/v3/homoit0000019","https://homosaurus.org/v3/homoit0000155","https://homosaurus.org/v3/homoit0000498","https://homosaurus.org/v3/homoit0000747","https://homosaurus.org/v3/homoit0001181","https://homosaurus.org/v3/homoit0001417","https://homosaurus.org/v3/homoit0002769","https://homosaurus.org/v3/homoit0002897","https://homosaurus.org/v3/homoit0003419"],"skos:related":"https://homosaurus.org/v3/homoit0000095","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/latinxLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000254","dc:identifier":"homoit0000254","skos:prefLabel":"Child custody","skos:altLabel":["Guardianship","Parental custody","Tutelage"],"rdfs:comment":"Legal term for the guardianship of a child, or the legal and practical relationship between a parent and a child in their care. Typically used to describe legal custody, which is the right to make decisions about the child, as well as physical custody, which is the right and duty to house, provide, and care for the child.","skos:related":["https://homosaurus.org/v3/homoit0000255","https://homosaurus.org/v3/homoit0000809","https://homosaurus.org/v3/homoit0000854","https://homosaurus.org/v3/homoit0000870","https://homosaurus.org/v3/homoit0000918","https://homosaurus.org/v3/homoit0000937"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85034952"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000254"},"dc:replaces":{"@id":"http://homosaurus.org/v2/childCustody"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000255","dc:identifier":"homoit0000255","skos:prefLabel":"Children","skos:altLabel":"Kids","rdfs:comment":"People who have not yet reached the age of adolescence.","skos:broader":"https://homosaurus.org/v3/homoit0000421","skos:narrower":["https://homosaurus.org/v3/homoit0000220","https://homosaurus.org/v3/homoit0000256","https://homosaurus.org/v3/homoit0000260","https://homosaurus.org/v3/homoit0000590","https://homosaurus.org/v3/homoit0001768","https://homosaurus.org/v3/homoit0002282","https://homosaurus.org/v3/homoit0002285","https://homosaurus.org/v3/homoit0002628","https://homosaurus.org/v3/homoit0002629","https://homosaurus.org/v3/homoit0002772","https://homosaurus.org/v3/homoit0003501"],"skos:related":["https://homosaurus.org/v3/homoit0000254","https://homosaurus.org/