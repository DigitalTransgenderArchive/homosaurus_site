https://homosaurus.org/v3/homoit0000322","https://homosaurus.org/v3/homoit0002653"],"skos:related":"https://homosaurus.org/v3/homoit0001499","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/whakawahine"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001503","dc:identifier":"homoit0001503","skos:prefLabel":"Whips","rdfs:comment":"Sticks, cords, or straps, usually with stiff handles, that are used for striking individuals. Often used in BDSM circles to enhance sexual arousal.","skos:broader":"https://homosaurus.org/v3/homoit0001266","skos:related":["https://homosaurus.org/v3/homoit0000447","https://homosaurus.org/v3/homoit0003048"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85146436"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/whips"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001504","dc:identifier":"homoit0001504","skos:prefLabel":"Widowed people","skos:altLabel":["Widowers","Widows"],"rdfs:comment":"People whose spouses or partners have died.","skos:broader":"https://homosaurus.org/v3/homoit0000989","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/widowedPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001505","dc:identifier":"homoit0001505","skos:prefLabel":"Wimmin","rdfs:comment":"A way of spelling \"women\" that is used in certain feminist circles. First used by George P. Krapp (1872-1934) and then appeared in 19th century Black American English renderings before being used by feminists in the 20th century.\r\n","skos:related":["https://homosaurus.org/v3/homoit0000437","https://homosaurus.org/v3/homoit0001509","https://homosaurus.org/v3/homoit0001516"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001505"},"dc:replaces":{"@id":"http://homosaurus.org/v2/wimmin"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001506","dc:identifier":"homoit0001506","skos:prefLabel":"Winkté","skos:altLabel":"Winkte","rdfs:comment":"North American Lakota word referring to people assigned male at birth who adopt feminine roles; translates to \"to be like a woman.\"","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":"https://homosaurus.org/v3/homoit0001480","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/winkte"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001507","dc:identifier":"homoit0001507","skos:prefLabel":"Witches (Lesbians)","skos:related":["https://homosaurus.org/v3/homoit0000596","https://homosaurus.org/v3/homoit0000761"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001507"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001908"},"dc:replaces":{"@id":"http://homosaurus.org/v2/witchesLesbian"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-22"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001508","dc:identifier":"homoit0001508","skos:prefLabel":"Wolves (Gay culture)","skos:altLabel":"Wolves","rdfs:comment":"U.S. slang term for heavy-set, masculine gay men who are often characterized as having hairy bodies and facial hair; typically used for individuals who are more aggressive and overtly masculine than bears.","skos:broader":["https://homosaurus.org/v3/homoit0000487","https://homosaurus.org/v3/homoit0000506","https://homosaurus.org/v3/homoit0000577","https://homosaurus.org/v3/homoit0001295"],"skos:narrower":"https://homosaurus.org/v3/homoit0000321","skos:related":["https://homosaurus.org/v3/homoit0000105","https://homosaurus.org/v3/homoit0000568","https://homosaurus.org/v3/homoit0000995","https://homosaurus.org/v3/homoit0001063"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/wolves"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001509","dc:identifier":"homoit0001509","skos:prefLabel":"Women","rdfs:comment":"Adults who self-identify as women and understand their gender in terms of Western conceptions of womanness, femaleness, and/or femininity. The term has typically been defined as adult female humans, though not all women identify with the term \"female\" depending on the context in which it is used.","skos:broader":"https://homosaurus.org/v3/homoit0000571","skos:narrower":["https://homosaurus.org/v3/homoit0000040","https://homosaurus.org/v3/homoit0000202","https://homosaurus.org/v3/homoit0000272","https://homosaurus.org/v3/homoit0000629","https://homosaurus.org/v3/homoit0001510","https://homosaurus.org/v3/homoit0001642","https://homosaurus.org/v3/homoit0002279","https://homosaurus.org/v3/homoit0003224"],"skos:related":["https://homosaurus.org/v3/homoit0000271","https://homosaurus.org/v3/homoit0000322","https://homosaurus.org/v3/homoit0000437","https://homosaurus.org/v3/homoit0000556","https://homosaurus.org/v3/homoit0000563","https://homosaurus.org/v3/homoit0001008","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001505","https://homosaurus.org/v3/homoit0001516","https://homosaurus.org/v3/homoit0002216"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85147274"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/women"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001510","dc:identifier":"homoit0001510","skos:prefLabel":"Women who have sex with women","skos:altLabel":"WSW","rdfs:comment":"Women who engage in sexual activity with other women.","skos:broader":["https://homosaurus.org/v3/homoit0000915","https://homosaurus.org/v3/homoit0001509"],"skos:narrower":"https://homosaurus.org/v3/homoit0001002","skos:related":["https://homosaurus.org/v3/homoit0000202","https://homosaurus.org/v3/homoit0000556","https://homosaurus.org/v3/homoit0001254","https://homosaurus.org/v3/homoit0001297","https://homosaurus.org/v3/homoit0001342","https://homosaurus.org/v3/homoit0003613"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womenWhoHaveSexWithWomen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001511","dc:identifier":"homoit0001511","skos:prefLabel":"Women's bookshops","rdfs:comment":"Bookshops that sell materials intended for use by women or addressing topics related to women. ","skos:broader":"https://homosaurus.org/v3/homoit0000216","skos:related":"https://homosaurus.org/v3/homoit0000727","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93005210"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000216"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womensBookshops"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001512","dc:identifier":"homoit0001512","skos:prefLabel":["Women's community centers","Women's community centres"],"rdfs:comment":"Spaces in which women meet for social, educational, recreational, and organizing activities.","skos:broader":"https://homosaurus.org/v3/homoit0000298","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womensCommunityCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001513","dc:identifier":"homoit0001513","skos:prefLabel":"Women's libraries","rdfs:comment":"Libraries that contain materials primarily pertaining to women or for use by women.","skos:broader":"https://homosaurus.org/v3/homoit0000968","skos:narrower":"https://homosaurus.org/v3/homoit0000749","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88005244"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womensLibraries"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001514","dc:identifier":"homoit0001514","skos:prefLabel":"Women's marriages","rdfs:comment":"Same-gender marriage tradition between two women in Africa conducted according to African culture and traditions.","skos:broader":"https://homosaurus.org/v3/homoit0000990","skos:related":"https://homosaurus.org/v3/homoit0000504","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womensMarriages"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001515","dc:identifier":"homoit0001515","skos:prefLabel":"Women's music festivals","rdfs:comment":"Organized events typically lasting more than one day that feature performances by women’s musical groups and performers. Though centered on music, women’s music festivals may also incorporate aspects of lesbian and feminist culture by offering workshops, arts and crafts, and community resources.","skos:broader":"https://homosaurus.org/v3/homoit0003607","skos:related":["https://homosaurus.org/v3/homoit0000755","https://homosaurus.org/v3/homoit0001516"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh99003279"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003607"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womensMusicFestivals"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003607","dc:identifier":"homoit0003607","skos:prefLabel":"Women's events","rdfs:comment":"Organized public or social occasions for women.","skos:narrower":"https://homosaurus.org/v3/homoit0001515","skos:related":"https://homosaurus.org/v3/homoit0000861","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003607"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001516","dc:identifier":"homoit0001516","skos:prefLabel":"Womyn","rdfs:comment":"A spelling of \"woman\" or \"women\" that first appeared in print in 1976 and is used in certain feminist circles to avoid having the suffix of \"men.\"  Some contemporary transgender activists have criticized use of the word \"womyn\" due to its prevalence in trans-exclusionary radical feminist (TERF) circles following the exclusion of trans women from the Michigan Womyn’s Music Festival.","skos:related":["https://homosaurus.org/v3/homoit0000062","https://homosaurus.org/v3/homoit0000437","https://homosaurus.org/v3/homoit0001230","https://homosaurus.org/v3/homoit0001505","https://homosaurus.org/v3/homoit0001509","https://homosaurus.org/v3/homoit0001515","https://homosaurus.org/v3/homoit0001819"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85147274"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001516"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womyn"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001517","dc:identifier":"homoit0001517","skos:prefLabel":"Khaniths","skos:altLabel":["Khanith","Xanith","Xaniths"],"rdfs:comment":"Arabic word used in Oman for people who assigned male at birth who adopt feminine mannerisms and/or roles.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/xanith"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001518","dc:identifier":"homoit0001518","skos:prefLabel":"X-jendā","rdfs:comment":"Japanese term for people who do not fit within the categories of man or woman; includes individuals born intersex, female, or male, and is often abbreviated using FTX, MTX, or XTX to describe individuals' transitions; some definitions equate the term to genderqueer or beyond the binary identities.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":["https://homosaurus.org/v3/homoit0000457","https://homosaurus.org/v3/homoit0001027"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/XJenda"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001519","dc:identifier":"homoit0001519","skos:prefLabel":"Yīnyángrén","skos:altLabel":["Jiānxìngrén","Yin-yang ren","Yinyang ren","Yinyangren"],"rdfs:comment":"Chinese word for individuals who are both female (yin) and male (yang).","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/yinyangRen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001521","dc:identifier":"homoit0001521","skos:prefLabel":"LGBTQ+ youth","skos:altLabel":["Adolescents (LGBTQ)","Teenagers (LGBTQ)","Teens (LGBTQ)","Youth (LGBTQ)","LGBTQ+ adolescents","LGBTQ+ teenagers","LGBTQ+ teens"],"rdfs:comment":"LGBTQ+ people who are between the ages of childhood and adulthood.","skos:broader":"https://homosaurus.org/v3/homoit0001520","skos:narrower":["https://homosaurus.org/v3/homoit0000192","https://homosaurus.org/v3/homoit0000544","https://homosaurus.org/v3/homoit0000786","https://homosaurus.org/v3/homoit0000880","https://homosaurus.org/v3/homoit0001215","https://homosaurus.org/v3/homoit0001452","https://homosaurus.org/v3/homoit0002223","https://homosaurus.org/v3/homoit0002292","https://homosaurus.org/v3/homoit0002460","https://homosaurus.org/v3/homoit0002489","https://homosaurus.org/v3/homoit0002509","https://homosaurus.org/v3/homoit0002538","https://homosaurus.org/v3/homoit0003460","https://homosaurus.org/v3/homoit0003474"],"skos:related":["https://homosaurus.org/v3/homoit0000630","https://homosaurus.org/v3/homoit0000674","https://homosaurus.org/v3/homoit0000933","https://homosaurus.org/v3/homoit0000964","https://homosaurus.org/v3/homoit0001522","https://homosaurus.org/v3/homoit0001756","https://homosaurus.org/v3/homoit0002700","https://homosaurus.org/v3/homoit0002711"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2004011606"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001520"},"dc:replaces":{"@id":"http://homosaurus.org/v2/youthLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001522","dc:identifier":"homoit0001522","skos:prefLabel":"LGBTQ+ youth literature","skos:altLabel":["Young adult literature (LGBTQ)","Youth literature (LGBTQ)"],"rdfs:comment":"Written literary works for an audience of readers from 12-18 years of age, also known as young adult literature or YA; use in reference to youth literature focusing on LGBTQ+ characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000972","skos:narrower":["https://homosaurus.org/v3/homoit0000203","https://homosaurus.org/v3/homoit0000557","https://homosaurus.org/v3/homoit0000798","https://homosaurus.org/v3/homoit0001228","https://homosaurus.org/v3/homoit0001462","https://homosaurus.org/v3/homoit0002461","https://homosaurus.org/v3/homoit0002478","https://homosaurus.org/v3/homoit0002490","https://homosaurus.org/v3/homoit0002510","https://homosaurus.org/v3/homoit0002539","https://homosaurus.org/v3/homoit0002953"],"skos:related":["https://homosaurus.org/v3/homoit0001521","https://homosaurus.org/v3/homoit0002179","https://homosaurus.org/v3/homoit0002712"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/youthLiteratureLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001523","dc:identifier":"homoit0001523","skos:prefLabel":"Zenanas","rdfs:comment":"In northern India and Pakistan, this term is used to refer to effeminate people.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/zenanas"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001524","dc:identifier":"homoit0001524","skos:prefLabel":"Zenani","rdfs:comment":"Urdu word for effeminate people.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001523"},"dc:replaces":{"@id":"http://homosaurus.org/v2/zenani"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001525","dc:identifier":"homoit0001525","skos:prefLabel":"Recovery groups","skos:altLabel":"12-step groups","skos:narrower":"https://homosaurus.org/v3/homoit0001551","skos:related":"https://homosaurus.org/v3/homoit0002228","skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001525"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001551"},"dc:replaces":{"@id":"http://homosaurus.org/v2/recoveryGroups"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001526","dc:identifier":"homoit0001526","skos:prefLabel":"Adult Children of Alcoholics","skos:altLabel":["ACA","ACOA"],"rdfs:comment":"A twelve step program based in the U.S. that treats alcoholism as a disease and aims to address its impact on the adult lives of children of alcoholics; may be used in reference to LGBTQ+ members of ACA or LGBTQ+-focused chapters of ACA","skos:broader":"https://homosaurus.org/v3/homoit0001551","skos:related":["https://homosaurus.org/v3/homoit0001540","https://homosaurus.org/v3/homoit0000256","https://homosaurus.org/v3/homoit0002227"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001525"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001551"},"dc:replaces":{"@id":"http://homosaurus.org/v2/adultChildrenOfAlcoholics"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001527","dc:identifier":"homoit0001527","skos:prefLabel":"Al-Anon","skos:related":["https://homosaurus.org/v3/homoit0001551","https://homosaurus.org/v3/homoit0001540","https://homosaurus.org/v3/homoit0002227"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001527"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001551"},"dc:replaces":{"@id":"http://homosaurus.org/v2/al-Anon"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-22"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001528","dc:identifier":"homoit0001528","skos:prefLabel":"Alcoholics ","rdfs:comment":"Individuals who are addicted to alcohol or have alcohol dependencies","skos:narrower":"https://homosaurus.org/v3/homoit0001540","skos:related":["https://homosaurus.org/v3/homoit0001540","https://homosaurus.org/v3/homoit0000256","https://homosaurus.org/v3/homoit0001083"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001528"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001540"},"dc:replaces":{"@id":"http://homosaurus.org/v2/alcoholics"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-22"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001529","dc:identifier":"homoit0001529","skos:prefLabel":"Alcoholics Anonymous","skos:altLabel":"AA","rdfs:comment":"An international organization aimed toward supporting alcoholics in sobriety through a twelve-step program; may be used in reference to LGBTQ+ individuals in AA or LGBTQ+ chapters of AA","skos:broader":"https://homosaurus.org/v3/homoit0001551","skos:related":["https://homosaurus.org/v3/homoit0001540","https://homosaurus.org/v3/homoit0002227"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001525"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001551"},"dc:replaces":{"@id":"http://homosaurus.org/v2/alcoholicsAnonymous"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001530","dc:identifier":"homoit0001530","skos:prefLabel":"Alcoholism","skos:related":["https://homosaurus.org/v3/homoit0002227","https://homosaurus.org/v3/homoit0001551"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001530"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001540"},"dc:replaces":{"@id":"http://homosaurus.org/v2/alcoholism"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-22"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001531","dc:identifier":"homoit0001531","skos:prefLabel":"Allosexuality","rdfs:comment":"A sexual orientation generally characterized by the occurrence of sexual attraction or the desire for partnered sexual experiences.","skos:broader":"https://homosaurus.org/v3/homoit0001298","skos:related":["https://homosaurus.org/v3/homoit0000170","https://homosaurus.org/v3/homoit0000627","https://homosaurus.org/v3/homoit0000648","https://homosaurus.org/v3/homoit0001073","https://homosaurus.org/v3/homoit0001535","https://homosaurus.org/v3/homoit0001917"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/allosexuality"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001532","dc:identifier":"homoit0001532","skos:prefLabel":"Amatonormativity","rdfs:comment":"The assumption that all people share a desire for romantic relationships and that this is a preferential life goal.","skos:broader":"https://homosaurus.org/v3/homoit0001323","skos:related":["https://homosaurus.org/v3/homoit0000067","https://homosaurus.org/v3/homoit0000356","https://homosaurus.org/v3/homoit0001650"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001323"},"dc:replaces":{"@id":"http://homosaurus.org/v2/amatonormativity"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001533","dc:identifier":"homoit0001533","skos:prefLabel":"Cocaine addiction","skos:altLabel":["Cocaine abuse","Cocaine misuse","Cocaine use disorder","Crack abuse","Crack addiction"],"rdfs:comment":"Dependence upon cocaine or crack; characterized by the experience of withdrawal symptoms upon cessation.","skos:broader":"https://homosaurus.org/v3/homoit0002226","skos:related":["https://homosaurus.org/v3/homoit0002227","https://homosaurus.org/v3/homoit0001551"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000251"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0002226"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cocaineAddiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001534","dc:identifier":"homoit0001534","skos:prefLabel":"Cocaine Anonymous","skos:altLabel":"CA","skos:broader":"https://homosaurus.org/v3/homoit0001551","skos:related":["https://homosaurus.org/v3/homoit0002226","https://homosaurus.org/v3/homoit0002227"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001525"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001551"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cocaineAnonymous"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001535","dc:identifier":"homoit0001535","skos:prefLabel":"Compulsory sexuality","rdfs:comment":"The belief that everyone should be either sexually available or in a sexual relationship.","skos:broader":"https://homosaurus.org/v3/homoit0001323","skos:related":["https://homosaurus.org/v3/homoit0000004","https://homosaurus.org/v3/homoit0000071","https://homosaurus.org/v3/homoit0000343","https://homosaurus.org/v3/homoit0000344","https://homosaurus.org/v3/homoit0000356","https://homosaurus.org/v3/homoit0001531","https://homosaurus.org/v3/homoit0001650","https://homosaurus.org/v3/homoit0001917"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001323"},"dc:replaces":{"@id":"http://homosaurus.org/v2/compulsorySexuality"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001536","dc:identifier":"homoit0001536","skos:prefLabel":"Crystal meth addiction","skos:altLabel":["Crystal meth misuse","Crystal meth abuse","Methamphetamine misuse","Methamphetamine abuse"],"skos:related":"https://homosaurus.org/v3/homoit0001551","skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001536"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0002226"},"dc:replaces":{"@id":"http://homosaurus.org/v2/crystalMethAddiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001537","dc:identifier":"homoit0001537","skos:prefLabel":"Crystal Meth Anonymous","skos:altLabel":"CMA","skos:broader":"https://homosaurus.org/v3/homoit0001551","skos:related":["https://homosaurus.org/v3/homoit0002226","https://homosaurus.org/v3/homoit0002227"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001525"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001551"},"dc:replaces":{"@id":"http://homosaurus.org/v2/crystalMethAnonymous"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001538","dc:identifier":"homoit0001538","skos:prefLabel":"Erotomania","skos:altLabel":["Clinical erotomania","De Clérambault syndrome","De Clérambault's syndrome","Obsessional erotomania","Primary erotomania"],"rdfs:comment":"Condition characterized by an individual's persistent and often mistaken belief that another person is infatuated or in love with them. Can also be used to describe a level or frequency of sexual desire perceived as excessive within a given culture. Medical doctors and psychologists have historically diagnosed LGBTQ+ people with erotomania in order to wrongly treat their identities and desires as medical disorders. Should only be used in a historical context or if an individual self-identifies with the term.","skos:related":["https://homosaurus.org/v3/homoit0000656","https://homosaurus.org/v3/homoit0001283"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97003456"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001538"},"dc:replaces":{"@id":"http://homosaurus.org/v2/erotomania"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001539","dc:identifier":"homoit0001539","skos:prefLabel":"LGBTQ+ people with internet sex addictions","skos:altLabel":["LGBTQ+ people with cybersex addictions","LGBTQ+ people with internet sexual addictions","LGBTQ+ people with porn addictions","LGBTQ+ people with pornography addictions"],"rdfs:comment":"LGBTQ+ people experiencing addiction to or dependency upon sexual activities involving the internet, including watching pornography, engaging in sexual conversations online, etc. Only use to refer to individuals who describe themselves as having internet sex addictions, not individuals who sexual practices are perceived as promiscuous or excessive by others.","skos:broader":"https://homosaurus.org/v3/homoit0001283","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/internetSexAddiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001540","dc:identifier":"homoit0001540","skos:prefLabel":"LGBTQ+ people with alcohol use disorders","skos:altLabel":["Alcoholics (LGBTQ)","LGBTQ+ alcoholics"],"rdfs:comment":"LGBTQ+ people who have been diagnosed with or regard themselves as having an alcohol use disorder, a medical condition that involves a pattern of alcohol use that is difficult to control, negatively impacts the individual's life, and results in withdrawal symptoms upon cessation. Only use to refer to individuals who describe themselves as having an alcohol use disorder. Follow the individual's preference for \"use disorder\" or \"addiction\" whenever possible.","skos:broader":["https://homosaurus.org/v3/homoit0000379","https://homosaurus.org/v3/homoit0001550"],"skos:related":"https://homosaurus.org/v3/homoit0001549","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQAlcoholics"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001541","dc:identifier":"homoit0001541","skos:prefLabel":"LGBTQ+ children of alcoholics","skos:altLabel":"LGBTQ children of alcoholics","skos:related":["https://homosaurus.org/v3/homoit0000256","https://homosaurus.org/v3/homoit0002227"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001541"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000256"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQChildrenOfAlcoholics"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001542","dc:identifier":"homoit0001542","skos:prefLabel":"LGBTQ+ partners of alcoholics","skos:altLabel":"LGBTQ partners of alcoholics","skos:broader":["https://homosaurus.org/v3/homoit0000915","https://homosaurus.org/v3/homoit0001083"],"skos:related":["https://homosaurus.org/v3/homoit0001540","https://homosaurus.org/v3/homoit0002227"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001083"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPartnersOfAlcoholics"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001543","dc:identifier":"homoit0001543","skos:prefLabel":"LGBTQ+ people in Adult Children of Alcoholics","skos:altLabel":"LGBTQ people in Adult Children of Alcoholics","skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0002227"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPeopleInAdultChildrenOfAlcoholics"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001544","dc:identifier":"homoit0001544","skos:prefLabel":"LGBTQ+ people in Al-Anon","skos:altLabel":"LGBTQ people in Al-Anon","skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0002227"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPeopleInAlAnon"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001545","dc:identifier":"homoit0001545","skos:prefLabel":"LGBTQ+ people in Alcoholics Anonymous","skos:altLabel":["LGBTQ people in AA","LGBTQ people in Alcoholics Anonymous"],"skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:related":"https://homosaurus.org/v3/homoit0001540","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0002227"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPeopleInAlcoholicsAnonymous"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001546","dc:identifier":"homoit0001546","skos:prefLabel":"LGBTQ+ people in Cocaine Anonymous","skos:altLabel":["LGBTQ people in CA","LGBTQ people in Cocaine Anonymous"],"skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0002227"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPeopleInCocaineAnonymous"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001547","dc:identifier":"homoit0001547","skos:prefLabel":"LGBTQ+ people in Crystal Meth Anonymous","skos:altLabel":["LGBTQ people in CMA","LGBTQ people in Crystal Meth Anonymous"],"skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:related":"https://homosaurus.org/v3/homoit0002226","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0002227"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPeopleInCrystalMethAnonymous"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001548","dc:identifier":"homoit0001548","skos:prefLabel":"LGBTQ+ people in Narcotics Anonymous","skos:altLabel":["LGBTQ people in NA","LGBTQ people in Narcotics Anonymous"],"skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0002227"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPeopleInNarcoticsAnonymous"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001549","dc:identifier":"homoit0001549","skos:prefLabel":"LGBTQ+ people in recovery","skos:altLabel":"LGBTQ people in recovery","rdfs:comment":"LGBTQ+ people currently in recovery from use disorders, conditions, or addictions. Follow the individual's preference for \"recovery\" or \"sobriety\" whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:related":["https://homosaurus.org/v3/homoit0000380","https://homosaurus.org/v3/homoit0001540"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPeopleInRecovery"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001550","dc:identifier":"homoit0001550","skos:prefLabel":"LGBTQ+ people with addictions","skos:altLabel":"LGBTQ people with addictions","rdfs:comment":"Umbrella term for LGBTQ+ people experiencing addictions, dependencies, or use disorders of some kind. Only use to refer to individuals who describe themselves as having addictions. Apply more specific terms if possible.","skos:broader":["https://homosaurus.org/v3/homoit0000379","https://homosaurus.org/v3/homoit0000380","https://homosaurus.org/v3/homoit0000915"],"skos:narrower":["https://homosaurus.org/v3/homoit0001283","https://homosaurus.org/v3/homoit0001540","https://homosaurus.org/v3/homoit0002226"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPeopleWithAddictions"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001551","dc:identifier":"homoit0001551","skos:prefLabel":"LGBTQ+-affirming recovery groups","skos:altLabel":["12 step programs (LGBTQ)","Recovery groups (LGBTQ)","Step work (LGBTQ)","LGBTQ+-affirming 12 step programs","LGBTQ+-affirming step work"],"rdfs:comment":"Recovery groups, or voluntary associations of people in recovery from use disorders, conditions, or addictions, that are accepting and supportive of LGBTQ+ people and their identities.","skos:broader":"https://homosaurus.org/v3/homoit0001012","skos:related":["https://homosaurus.org/v3/homoit0000953","https://homosaurus.org/v3/homoit0002227","https://homosaurus.org/v3/homoit0002228"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000614"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQRecoveryGroups"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001552","dc:identifier":"homoit0001552","skos:prefLabel":"LGBTQ+ step work","skos:altLabel":"LGBTQ step work","skos:broader":"https://homosaurus.org/v3/homoit0001551","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000614"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0002227"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQStepWork"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001553","dc:identifier":"homoit0001553","skos:prefLabel":"Leather bars","rdfs:comment":"Bars or clubs that cater to or which are known to be especially friendly to the leather community.","skos:broader":"https://homosaurus.org/v3/homoit0000100","skos:related":["https://homosaurus.org/v3/homoit0000087","https://homosaurus.org/v3/homoit0000474","https://homosaurus.org/v3/homoit0000705"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh99013466"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/leatherBars"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001554","dc:identifier":"homoit0001554","skos:prefLabel":"Metamours","rdfs:comment":"In polyamory or open relationships, metamours are the partners of an individual's partner, with whom the individual does not have a direct sexual or romantic relationship.","skos:broader":["https://homosaurus.org/v3/homoit0001123","https://homosaurus.org/v3/homoit0001660"],"skos:related":["https://homosaurus.org/v3/homoit0001638","https://homosaurus.org/v3/homoit0001651","https://homosaurus.org/v3/homoit0001662"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/metamours"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001555","dc:identifier":"homoit0001555","skos:prefLabel":"Mononormativity","rdfs:comment":"The belief that all people share a desire for monogamous relationships and that this is a preferential life goal.","skos:broader":"https://homosaurus.org/v3/homoit0001323","skos:related":["https://homosaurus.org/v3/homoit0000356","https://homosaurus.org/v3/homoit0001019","https://homosaurus.org/v3/homoit0001556","https://homosaurus.org/v3/homoit0001915","https://homosaurus.org/v3/homoit0001916"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001323"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mononormativity"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001556","dc:identifier":"homoit0001556","skos:prefLabel":"Monosexuality","rdfs:comment":"A sexuality that involves attraction to only one gender; includes homosexuality and heterosexuality.","skos:broader":"https://homosaurus.org/v3/homoit0001298","skos:narrower":["https://homosaurus.org/v3/homoit0000631","https://homosaurus.org/v3/homoit0000647"],"skos:related":["https://homosaurus.org/v3/homoit0001290","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001300","https://homosaurus.org/v3/homoit0001555","https://homosaurus.org/v3/homoit0001915"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/monosexuality"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001557","dc:identifier":"homoit0001557","skos:prefLabel":"Narcotics Anonymous","skos:altLabel":"NA","skos:broader":"https://homosaurus.org/v3/homoit0001551","skos:related":["https://homosaurus.org/v3/homoit0002226","https://homosaurus.org/v3/homoit0002227"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001525"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001551"},"dc:replaces":{"@id":"http://homosaurus.org/v2/narcoticsAnonymous"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001558","dc:identifier":"homoit0001558","skos:prefLabel":"Polysexuality","rdfs:comment":"Term used to describe the sexual identity of individuals who experience attraction to more than one gender; includes bisexuality and pansexuality.","skos:broader":["https://homosaurus.org/v3/homoit0001290","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001298","https://homosaurus.org/v3/homoit0001300"],"skos:narrower":["https://homosaurus.org/v3/homoit0000204","https://homosaurus.org/v3/homoit0001926"],"skos:related":["https://homosaurus.org/v3/homoit0001123","https://homosaurus.org/v3/homoit0001919"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000358"},"dc:replaces":{"@id":"http://homosaurus.org/v2/polysexuality"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001559","dc:identifier":"homoit0001559","skos:prefLabel":"Reclaimed terms","rdfs:comment":"Terms that have been or are currently used in derogatory ways but have been reclaimed by certain groups or in certain circumstances.","skos:broader":"https://homosaurus.org/v3/homoit0001317","skos:narrower":["https://homosaurus.org/v3/homoit0000384","https://homosaurus.org/v3/homoit0000418","https://homosaurus.org/v3/homoit0001195","https://homosaurus.org/v3/homoit0001891","https://homosaurus.org/v3/homoit0002230","https://homosaurus.org/v3/homoit0002577"],"skos:related":["https://homosaurus.org/v3/homoit0001208","https://homosaurus.org/v3/homoit0001560"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001317"},"dc:replaces":{"@id":"http://homosaurus.org/v2/reclaimedTerms"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001560","dc:identifier":"homoit0001560","skos:prefLabel":"Slurs","rdfs:comment":"Insulting or discriminating remarks, innuendos, or names intended to demoralize a person, typically by disparaging that person's identity or social group. Generally, for a term to be considered a slur, it must be derogatory towards a particular person or group, it must be used to subordinate them within some structure of power relations, and the derogated person or group must be defined by an intrinsic property such as their race, sexual orientation, gender identity, etc. This category includes terms considered slurs at any point in their usage. Therefore, some of these terms may no longer be considered universally derogatory, may be in common usage, or may be selectively reclaimed by certain groups.","skos:narrower":["https://homosaurus.org/v3/homoit0000023","https://homosaurus.org/v3/homoit0000037","https://homosaurus.org/v3/homoit0000090","https://homosaurus.org/v3/homoit0000091","https://homosaurus.org/v3/homoit0000096","https://homosaurus.org/v3/homoit0000098","https://homosaurus.org/v3/homoit0000101","https://homosaurus.org/v3/homoit0000246","https://homosaurus.org/v3/homoit0000384","https://homosaurus.org/v3/homoit0000418","https://homosaurus.org/v3/homoit0000695","https://homosaurus.org/v3/homoit0002230"],"skos:related":["https://homosaurus.org/v3/homoit0000336","https://homosaurus.org/v3/homoit0000356","https://homosaurus.org/v3/homoit0000611","https://homosaurus.org/v3/homoit0001108","https://homosaurus.org/v3/homoit0001317","https://homosaurus.org/v3/homoit0001559"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/slurs"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001561","dc:identifier":"homoit0001561","skos:prefLabel":"Stigma","rdfs:comment":"Widespread disapproval of a group of people or set of behaviors based on preconceived ideas.","skos:related":["https://homosaurus.org/v3/homoit0000112","https://homosaurus.org/v3/homoit0000356","https://homosaurus.org/v3/homoit0000534"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85128107"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001561"},"dc:replaces":{"@id":"http://homosaurus.org/v2/stigma"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001562","dc:identifier":"homoit0001562","skos:prefLabel":"Sobriety","rdfs:comment":"Conscious abstinence from addictive or mind-altering substances, typically alcohol or drugs.","skos:related":"https://homosaurus.org/v3/homoit0001235","skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001562"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0002228"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sobriety"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001563","dc:identifier":"homoit0001563","skos:prefLabel":"Trans","skos:altLabel":"Trans*","rdfs:comment":"Umbrella term used to describe individuals who \"trans\" gender regardless of their identification; sometimes used as a way to historicize non-binary identities.","skos:related":["https://homosaurus.org/v3/homoit0000571","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001415","https://homosaurus.org/v3/homoit0001463","https://homosaurus.org/v3/homoit0001468","https://homosaurus.org/v3/homoit0001469"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001563"},"dc:replaces":{"@id":"http://homosaurus.org/v2/trans"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001564","dc:identifier":"homoit0001564","skos:prefLabel":"Uranism","skos:altLabel":["Uranismus","Congenital sexual inversion","Urningism","Uraniadism","Uranianism"],"rdfs:comment":"Historical term originating from the German \"Uranismus\" coined by Karl Heinrich Ulrichs as an umbrella term for what are now referred to as gender and sexual minorities; use only in historical contexts.","skos:broader":"https://homosaurus.org/v3/homoit0000878","skos:related":["https://homosaurus.org/v3/homoit0000677","https://homosaurus.org/v3/homoit0001296","https://homosaurus.org/v3/homoit0001484"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/uranism"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001565","dc:identifier":"homoit0001565","skos:prefLabel":"Lesbian fantasy fiction","rdfs:comment":"Written works that include magical or fantastical elements; use in reference to fantasy fiction focusing on lesbian characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000865","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianFantasyFiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001566","dc:identifier":"homoit0001566","skos:prefLabel":"Gay fantasy fiction","rdfs:comment":"Written works that include magical or fantastical elements; use in reference to fantasy fiction focusing on gay characters or themes.","skos:broader":"https://homosaurus.org/v3/homoit0000865","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayFantasyFiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001567","dc:identifier":"homoit0001567","skos:prefLabel":"Bisexual fantasy fiction","rdfs:comment":"Written works that include magical or fantastical elements; use in reference to fantasy fiction focusing on bisexual characters or themes.","skos:broader":"https://homosaurus.