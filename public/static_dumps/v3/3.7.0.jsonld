pConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/olderQueerPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001058","dc:identifier":"homoit0001058","skos:prefLabel":"Older transgender people","rdfs:comment":"Transgender people who are advanced in age, typically over 60 years of age.","skos:broader":["https://homosaurus.org/v3/homoit0000393","https://homosaurus.org/v3/homoit0001378"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2018003006"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/olderTransgenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001059","dc:identifier":"homoit0001059","skos:prefLabel":"Single parent families","skos:altLabel":"One-parent families","rdfs:comment":"Families headed by a single parent. For single parent families headed by or including LGBTQ+ people, use the term \"LGBTQ+ single parent families.\"","skos:related":"https://homosaurus.org/v3/homoit0000943","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85122844"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/singleParentFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001060","dc:identifier":"homoit0001060","skos:prefLabel":"Orchiectomy","rdfs:comment":"Medical procedure to remove one or more testes; often part of gender affirming surgery, though it can be performed for other reasons.","skos:broader":["https://homosaurus.org/v3/homoit0000241","https://homosaurus.org/v3/homoit0000584"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000241"},"dc:replaces":{"@id":"http://homosaurus.org/v2/orchiectomy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001061","dc:identifier":"homoit0001061","skos:prefLabel":["Organizations for sexual research and sexual reform","Organisations for sexual research and sexual reform"],"skos:altLabel":["Sexual reform organizations","Sexual research organizations"],"rdfs:comment":"Institutions or groups dedicated to research, education, policy work, and advocacy regarding human sexuality and sexual behavior, particularly to challenge taboos and encourage more open discussion of sex and sexuality within society.","skos:broader":"https://homosaurus.org/v3/homoit0001306","skos:related":"https://homosaurus.org/v3/homoit0000836","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001306"},"dc:replaces":{"@id":"http://homosaurus.org/v2/organisationsForSexualResearchAndSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001062","dc:identifier":"homoit0001062","skos:prefLabel":"Orgasm","rdfs:comment":"Climax of sexual excitement, typically characterized by feelings of pleasure and physical sensations including rapid muscle contractions, higher blood pressure and heart rate, release of endorphins, and ejaculation.","skos:broader":"https://homosaurus.org/v3/homoit0001284","skos:related":["https://homosaurus.org/v3/homoit0000323","https://homosaurus.org/v3/homoit0000460","https://homosaurus.org/v3/homoit0000589","https://homosaurus.org/v3/homoit0000610","https://homosaurus.org/v3/homoit0000683","https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001288","https://homosaurus.org/v3/homoit0001306","https://homosaurus.org/v3/homoit0003073","https://homosaurus.org/v3/homoit0003114","https://homosaurus.org/v3/homoit0003127"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85095593"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000656"},"dc:replaces":{"@id":"http://homosaurus.org/v2/orgasm"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001063","dc:identifier":"homoit0001063","skos:prefLabel":"Otters (Gay culture)","skos:altLabel":["Otter men","Otters"],"rdfs:comment":"U.S. slang term term for gay men who blend the physical and social traits of bears and twinks.","skos:broader":["https://homosaurus.org/v3/homoit0000487","https://homosaurus.org/v3/homoit0000506","https://homosaurus.org/v3/homoit0000577","https://homosaurus.org/v3/homoit0001295"],"skos:related":["https://homosaurus.org/v3/homoit0000105","https://homosaurus.org/v3/homoit0000568","https://homosaurus.org/v3/homoit0001145","https://homosaurus.org/v3/homoit0001508"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/otters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001064","dc:identifier":"homoit0001064","skos:prefLabel":"Outgames","rdfs:comment":"A sporting and cultural event open to anyone regardless of sexual identity or qualifying standards that is intended to bring together athletes and artists from around the globe, many from countries where homosexuality remains illegal; separate from the Gay Games","skos:broader":"https://homosaurus.org/v3/homoit0000949","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000861"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000949"},"dc:replaces":{"@id":"http://homosaurus.org/v2/outgames"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001065","dc:identifier":"homoit0001065","skos:prefLabel":"Outing (LGBTQ+ culture)","skos:altLabel":"Outing","rdfs:comment":"The act of disclosing a person's sexual or gender identity without that person's consent.","skos:broader":"https://homosaurus.org/v3/homoit0000853","skos:related":["https://homosaurus.org/v3/homoit0000088","https://homosaurus.org/v3/homoit0000089","https://homosaurus.org/v3/homoit0000285","https://homosaurus.org/v3/homoit0000286","https://homosaurus.org/v3/homoit0000287","https://homosaurus.org/v3/homoit0000288","https://homosaurus.org/v3/homoit0000295","https://homosaurus.org/v3/homoit0000336","https://homosaurus.org/v3/homoit0001261","https://homosaurus.org/v3/homoit0001783","https://homosaurus.org/v3/homoit0001784","https://homosaurus.org/v3/homoit0001785","https://homosaurus.org/v3/homoit0001786","https://homosaurus.org/v3/homoit0001787","https://homosaurus.org/v3/homoit0002392","https://homosaurus.org/v3/homoit0002905"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002177"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/outing"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001066","dc:identifier":"homoit0001066","skos:prefLabel":"Ovo-testes","skos:altLabel":["True hermaphroditism","\"Ovotesticular DSD \""],"rdfs:comment":"People with this variation are born with both ovarian and testicular tissue. A person can develop one testis and one ovary, or they may develop one or more ovo-testes, which means that a single gonad is made up of both ovarian and testicular cells. The levels of hormones they produce can vary and how their genitals and secondary sex characteristics develop will depend partially on the levels of estrogen and testosterone that their bodies make. In adolescence, people with ovo-testes may develop features associated with either a typical estrogen puberty or a typical testosterone puberty, or they may develop some of each. Sometimes a person with an ovary and a testis or with ovo-testes can produce viable sperm and viable eggs.","skos:broader":"https://homosaurus.org/v3/homoit0000669","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ovoTestes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001067","dc:identifier":"homoit0001067","skos:prefLabel":"Packing (Phallus)","rdfs:comment":"The act of wearing padding or a phallic object in the front of the pants or underwear to give the appearance of having a bulge.","skos:broader":"https://homosaurus.org/v3/homoit0000568","skos:related":["https://homosaurus.org/v3/homoit0000354","https://homosaurus.org/v3/homoit0001099","https://homosaurus.org/v3/homoit0001790"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/packingPhallus"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001068","dc:identifier":"homoit0001068","skos:prefLabel":"Spanking paddles","rdfs:comment":"A tool with a short handle at one end and a wide, flat surface at the other that is used to strike the buttocks as a form of impact play.","skos:broader":"https://homosaurus.org/v3/homoit0001266","skos:related":["https://homosaurus.org/v3/homoit0001335","https://homosaurus.org/v3/homoit0003075"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/spankingPaddles"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001069","dc:identifier":"homoit0001069","skos:prefLabel":"LGBTQ+ Pagans","skos:altLabel":"Pagans (LGBTQ)","rdfs:comment":"LGBTQ+ people who are members of polytheistic religions or other religions outside of the dominant culture that typically incorporate nature worship and/or the sacred feminine, such as Wicca, Druidry, Heathenry, etc. Use to describe LGBTQ+ people who self-identify as Pagan.","skos:broader":"https://homosaurus.org/v3/homoit0000928","skos:narrower":["https://homosaurus.org/v3/homoit0000168","https://homosaurus.org/v3/homoit0000516","https://homosaurus.org/v3/homoit0000761","https://homosaurus.org/v3/homoit0001193","https://homosaurus.org/v3/homoit0001429","https://homosaurus.org/v3/homoit0001907","https://homosaurus.org/v3/homoit0002977","https://homosaurus.org/v3/homoit0002983"],"skos:related":"https://homosaurus.org/v3/homoit0000596","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pagansLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001070","dc:identifier":"homoit0001070","skos:prefLabel":"Palao'ana","rdfs:comment":"Chamorro (Mariana Islands) term for third gender people.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/palaoana"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001071","dc:identifier":"homoit0001071","skos:prefLabel":"Pangender identity","rdfs:comment":"Gender identity that encompasses multiple or all genders.","skos:broader":"https://homosaurus.org/v3/homoit0000571","skos:related":"https://homosaurus.org/v3/homoit0001072","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pangenderIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001072","dc:identifier":"homoit0001072","skos:prefLabel":"Pangender people","rdfs:comment":"People who identify as multiple or all genders.","skos:broader":["https://homosaurus.org/v3/homoit0000322","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001817"],"skos:related":"https://homosaurus.org/v3/homoit0001071","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pangenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001073","dc:identifier":"homoit0001073","skos:prefLabel":"Pansexual people","skos:altLabel":"Omnisexual","rdfs:comment":"Individuals who self-identify as pansexual, meaning that they are sexually attracted to people of all genders. Some but not all pansexual people also identify as \"gender-blind\" because gender is insignificant or irrelevant in determining their attraction.","skos:broader":["https://homosaurus.org/v3/homoit0000108","https://homosaurus.org/v3/homoit0000915"],"skos:related":["https://homosaurus.org/v3/homoit0000170","https://homosaurus.org/v3/homoit0001381","https://homosaurus.org/v3/homoit0001531","https://homosaurus.org/v3/homoit0001926"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pansexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001074","dc:identifier":"homoit0001074","skos:prefLabel":"Parental rights","rdfs:comment":"The legal parent-child relationship that may be established by biological relations, at birth, or through adoption. These rights may include child custody and visitation, decision-making authority, and informational access. ","skos:broader":"https://homosaurus.org/v3/homoit0000712","skos:related":["https://homosaurus.org/v3/homoit0000914","https://homosaurus.org/v3/homoit0000918"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/parentalRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001075","dc:identifier":"homoit0001075","skos:prefLabel":"LGBTQ+ parents","skos:altLabel":"Parents (LGBTQ)","rdfs:comment":"LGBTQ+ people who are parents.","skos:broader":["https://homosaurus.org/v3/homoit0000420","https://homosaurus.org/v3/homoit0002372"],"skos:narrower":["https://homosaurus.org/v3/homoit0000169","https://homosaurus.org/v3/homoit0000492","https://homosaurus.org/v3/homoit0000752","https://homosaurus.org/v3/homoit0000812","https://homosaurus.org/v3/homoit0000819","https://homosaurus.org/v3/homoit0000821","https://homosaurus.org/v3/homoit0000840","https://homosaurus.org/v3/homoit0000872","https://homosaurus.org/v3/homoit0000944","https://homosaurus.org/v3/homoit0001194","https://homosaurus.org/v3/homoit0001430","https://homosaurus.org/v3/homoit0001761","https://homosaurus.org/v3/homoit0001762","https://homosaurus.org/v3/homoit0001763","https://homosaurus.org/v3/homoit0002337","https://homosaurus.org/v3/homoit0002343","https://homosaurus.org/v3/homoit0002387"],"skos:related":["https://homosaurus.org/v3/homoit0000809","https://homosaurus.org/v3/homoit0000811","https://homosaurus.org/v3/homoit0000843","https://homosaurus.org/v3/homoit0000864","https://homosaurus.org/v3/homoit0000870","https://homosaurus.org/v3/homoit0000914","https://homosaurus.org/v3/homoit0002584","https://homosaurus.org/v3/homoit0002586"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006000228"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/parentsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001076","dc:identifier":"homoit0001076","skos:prefLabel":"Parents of crossdressers","rdfs:comment":"People who act as parents to one or more crossdresser. Only use to describe the parents of someone who self-identifies as a crossdresser.","skos:broader":"https://homosaurus.org/v3/homoit0002372","skos:related":"https://homosaurus.org/v3/homoit0000316","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/parentsOfCrossdressers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001077","dc:identifier":"homoit0001077","skos:prefLabel":"Parents of queer people","skos:altLabel":"Queer people's parents","rdfs:comment":"People who act as parents to one or more queer person. For parents who are themselves queer, use the term \"Queer parents.\"","skos:broader":"https://homosaurus.org/v3/homoit0002224","skos:related":"https://homosaurus.org/v3/homoit0001195","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/parentsOfQueerPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001078","dc:identifier":"homoit0001078","skos:prefLabel":"Parents of transgender people","skos:altLabel":"Transgender people's parents","rdfs:comment":"People who act as parents to one or more transgender person. For parents who are themselves transgender, use the term \"Transgender parents.\"","skos:broader":"https://homosaurus.org/v3/homoit0002224","skos:related":"https://homosaurus.org/v3/homoit0001378","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2016000194"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/parentsOfTransgenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001079","dc:identifier":"homoit0001079","skos:prefLabel":"Partial androgen insensitivity syndrome","skos:altLabel":"PAIS","rdfs:comment":"People with partial androgen insensitivity (PAIS) have some response to testosterone, but not as much as is typical for people with XY chromosomes without androgen insensitivity. People with PAIS may be born with testes that are undescended or partially descended and with genital differences such as a vaginal opening that is shallower than typical, a phallus that may be perceived as a large clitoris or a small penis, and variations affecting their urethra. They might also be born with genitals that look more like a penis or like a vulva and vagina. In adolescence, people with PAIS may develop some features that are associated with a typical testosterone puberty and others that are associated with a typical estrogen puberty since their body responds to some of the testosterone that their gonads produce while the rest is converted into estrogen.","skos:broader":["https://homosaurus.org/v3/homoit0000044","https://homosaurus.org/v3/homoit0000669"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partialAndrogenInsensitivitySyndrome"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001080","dc:identifier":"homoit0001080","skos:prefLabel":"Partner notification","rdfs:comment":"The practice of notifying the sexual partners of a person who has been newly diagnosed with a sexually transmitted infection to inform them that they have been exposed to the infection.","skos:related":["https://homosaurus.org/v3/homoit0001302","https://homosaurus.org/v3/homoit0001308","https://homosaurus.org/v3/homoit0001311","https://homosaurus.org/v3/homoit0002365"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001080"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnerNotification"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001081","dc:identifier":"homoit0001081","skos:prefLabel":"Partner preference","rdfs:comment":"An enduring pattern of desire for connection and relationships (romantic, sexual, or play) with people of specific identities or within specific relationship orientations (monogamy, polyamory, polygamy).","skos:broader":"https://homosaurus.org/v3/homoit0001300","skos:narrower":["https://homosaurus.org/v3/homoit0001019","https://homosaurus.org/v3/homoit0001124"],"skos:related":["https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001302","https://homosaurus.org/v3/homoit0001311","https://homosaurus.org/v3/homoit0001916","https://homosaurus.org/v3/homoit0002255","https://homosaurus.org/v3/homoit0002365"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001300"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnerPreference"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001082","dc:identifier":"homoit0001082","skos:prefLabel":"Partner rights","rdfs:comment":"Legal, economic, social, and cultural rights afforded to individuals who are in long-term partnerships (e.g., marriage, domestic partnership, civil union) that can include shared health insurance, life insurance benefits, adoption rights, and the authority to make medical and financial decisions on behalf of one's partner.","skos:broader":"https://homosaurus.org/v3/homoit0000712","skos:related":["https://homosaurus.org/v3/homoit0001311","https://homosaurus.org/v3/homoit0002365"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnerRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001083","dc:identifier":"homoit0001083","skos:prefLabel":"LGBTQ+ partners","skos:altLabel":"Partners (LGBTQ)","rdfs:comment":"Gender-neutral term for sexual, romantic, or play partners who are also LGBTQ+.","skos:broader":["https://homosaurus.org/v3/homoit0000420","https://homosaurus.org/v3/homoit0002365"],"skos:narrower":["https://homosaurus.org/v3/homoit0000863","https://homosaurus.org/v3/homoit0002367","https://homosaurus.org/v3/homoit0002368","https://homosaurus.org/v3/homoit0002369","https://homosaurus.org/v3/homoit0002370","https://homosaurus.org/v3/homoit0002371","https://homosaurus.org/v3/homoit0002800","https://homosaurus.org/v3/homoit0002920"],"skos:related":["https://homosaurus.org/v3/homoit0000310","https://homosaurus.org/v3/homoit0000855","https://homosaurus.org/v3/homoit0000895","https://homosaurus.org/v3/homoit0001237"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnersLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001084","dc:identifier":"homoit0001084","skos:prefLabel":"Partners of bisexual people","rdfs:comment":"People whose sexual, romantic, or play partner is bisexual.","skos:broader":"https://homosaurus.org/v3/homoit0002366","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnersOfBisexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002365","dc:identifier":"homoit0002365","skos:prefLabel":"Partners","rdfs:comment":"People who share a romantic, sexual, or play partnership with another person or people.","skos:narrower":["https://homosaurus.org/v3/homoit0001083","https://homosaurus.org/v3/homoit0001085","https://homosaurus.org/v3/homoit0001635","https://homosaurus.org/v3/homoit0001638","https://homosaurus.org/v3/homoit0001645","https://homosaurus.org/v3/homoit0001657","https://homosaurus.org/v3/homoit0002366","https://homosaurus.org/v3/homoit0002717"],"skos:related":["https://homosaurus.org/v3/homoit0001080","https://homosaurus.org/v3/homoit0001081","https://homosaurus.org/v3/homoit0001082","https://homosaurus.org/v3/homoit0001311"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002365"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001085","dc:identifier":"homoit0001085","skos:prefLabel":"Partners of crossdressers","rdfs:comment":"People whose sexual, romantic, or play partner is a crossdresser. Only use to describe individuals whose partners self-identify as crossdressers.","skos:broader":"https://homosaurus.org/v3/homoit0002365","skos:related":"https://homosaurus.org/v3/homoit0000316","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnersOfCrossdressers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001086","dc:identifier":"homoit0001086","skos:prefLabel":"Partners of gay men","rdfs:comment":"People whose sexual, romantic, or play partner is a gay man.","skos:broader":"https://homosaurus.org/v3/homoit0002366","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnersOfGayMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001087","dc:identifier":"homoit0001087","skos:prefLabel":"Partners of lesbians","rdfs:comment":"People whose sexual, romantic, or play partner is a lesbian.","skos:broader":"https://homosaurus.org/v3/homoit0002366","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnersOfLesbians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001088","dc:identifier":"homoit0001088","skos:prefLabel":"Partners of queer people","rdfs:comment":"People whose sexual, romantic, or play partner is queer.","skos:broader":"https://homosaurus.org/v3/homoit0002366","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnersOfQueerPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001089","dc:identifier":"homoit0001089","skos:prefLabel":"Partners of transgender people","rdfs:comment":"People whose sexual, romantic, or play partner is transgender.","skos:broader":"https://homosaurus.org/v3/homoit0002366","skos:related":["https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001780"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnersOfTransgenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001090","dc:identifier":"homoit0001090","skos:prefLabel":"Passing (Gender)","rdfs:comment":"An individual's ability to \"pass,\" or be accepted or regarded as a member of the gender they identify with. \"Passing\" has historically been used to describe an individual's ability to \"pass\" as a certain race or ethnicity, though the term was later appropriated by the LGBTQ+ community.","skos:related":["https://homosaurus.org/v3/homoit0000288","https://homosaurus.org/v3/homoit0000316","https://homosaurus.org/v3/homoit0000560","https://homosaurus.org/v3/homoit0001140","https://homosaurus.org/v3/homoit0001233","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001781","https://homosaurus.org/v3/homoit0001901"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001090"},"dc:replaces":{"@id":"http://homosaurus.org/v2/passingGender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001091","dc:identifier":"homoit0001091","skos:prefLabel":"Passive immune therapy","rdfs:comment":"A medical treatment in which a person receives laboratory-made antibodies to help fight an infection or disease.","skos:broader":"https://homosaurus.org/v3/homoit0001007","skos:related":"https://homosaurus.org/v3/homoit0000005","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/passiveImmuneTherapy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001092","dc:identifier":"homoit0001092","skos:prefLabel":"Passports","rdfs:comment":"Official documentation issued by a government that certifies the holder’s identity and citizenship, entitling them to travel under to and from other countries.","skos:broader":"https://homosaurus.org/v3/homoit0001053","skos:narrower":"https://homosaurus.org/v3/homoit0000573","skos:related":["https://homosaurus.org/v3/homoit0000247","https://homosaurus.org/v3/homoit0000711","https://homosaurus.org/v3/homoit0000883","https://homosaurus.org/v3/homoit0001465","https://homosaurus.org/v3/homoit0001815","https://homosaurus.org/v3/homoit0001853"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85098541"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/passports"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001093","dc:identifier":"homoit0001093","skos:prefLabel":"Fatherhood","skos:altLabel":"Paternity","rdfs:comment":"The experience of acting as a father, including the responsibilities involved in fathering and raising children.","skos:related":["https://homosaurus.org/v3/homoit0000116","https://homosaurus.org/v3/homoit0000423","https://homosaurus.org/v3/homoit0000811","https://homosaurus.org/v3/homoit0000864","https://homosaurus.org/v3/homoit0000871","https://homosaurus.org/v3/homoit0000914"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh89006293"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001093"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fatherhood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001094","dc:identifier":"homoit0001094","skos:prefLabel":"Pederasts","rdfs:comment":"Adult men who have sexual and mentor/protégé relationships with adolescent boys. This term has historically been used to describe gay men. Only use in historical contexts.","skos:broader":["https://homosaurus.org/v3/homoit0000878","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001300"],"skos:related":"https://homosaurus.org/v3/homoit0001095","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pederasts"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001095","dc:identifier":"homoit0001095","skos:prefLabel":"Pederasty","rdfs:comment":"Term used to describe the practices of adult men who engage in sexual and mentor/protégé relationships with adolescent boys. This term has historically been used to describe the practices of gay men. Only use in historical contexts.","skos:broader":"https://homosaurus.org/v3/homoit0000878","skos:related":["https://homosaurus.org/v3/homoit0001094","https://homosaurus.org/v3/homoit0001300","https://homosaurus.org/v3/homoit0001325"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pederasty"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001096","dc:identifier":"homoit0001096","skos:prefLabel":"Peep shows","skos:altLabel":"Peepshows","rdfs:comment":"Live sex shows or pornographic movies viewed through a small opening or magnifying lens, typically from a coin-operated booth.","skos:broader":"https://homosaurus.org/v3/homoit0000011","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97005572"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/peepShows"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001097","dc:identifier":"homoit0001097","skos:prefLabel":"Penectomy","rdfs:comment":"Surgical removal of the penis.","skos:broader":["https://homosaurus.org/v3/homoit0000241","https://homosaurus.org/v3/homoit0000584"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000241"},"dc:replaces":{"@id":"http://homosaurus.org/v2/penectomy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001098","dc:identifier":"homoit0001098","skos:prefLabel":"Penile plethysmography","skos:altLabel":["Penile response measurement","Phallometry"],"rdfs:comment":"Assessments of penile tumescence in response to erotic stimuli in order to test an individual's sexual preference or excitement.","skos:related":"https://homosaurus.org/v3/homoit0001099","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001098"},"dc:replaces":{"@id":"http://homosaurus.org/v2/penilePlethysmography"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001099","dc:identifier":"homoit0001099","skos:prefLabel":"Penis","skos:altLabel":["Cock","Dick","Dong","Penises","Phallus","Prick","Wang"],"rdfs:comment":"External genital organ.","skos:broader":["https://homosaurus.org/v3/homoit0000401","https://homosaurus.org/v3/homoit0000585"],"skos:narrower":"https://homosaurus.org/v3/homoit0001894","skos:related":["https://homosaurus.org/v3/homoit0000212","https://homosaurus.org/v3/homoit0000292","https://homosaurus.org/v3/homoit0000355","https://homosaurus.org/v3/homoit0000400","https://homosaurus.org/v3/homoit0001067","https://homosaurus.org/v3/homoit0001098","https://homosaurus.org/v3/homoit0001268","https://homosaurus.org/v3/homoit0001342","https://homosaurus.org/v3/homoit0001476","https://homosaurus.org/v3/homoit0001790","https://homosaurus.org/v3/homoit0001846","https://homosaurus.org/v3/homoit0001847","https://homosaurus.org/v3/homoit0001850"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85099480"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000401"},"dc:replaces":{"@id":"http://homosaurus.org/v2/penises"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001100","dc:identifier":"homoit0001100","skos:prefLabel":"LGBTQ+ people in the military","skos:altLabel":"People in the military (LGBTQ)","rdfs:comment":"LGBTQ+ people serving in state and national armed forces.","skos:broader":"https://homosaurus.org/v3/homoit0000712","skos:narrower":["https://homosaurus.org/v3/homoit0000171","https://homosaurus.org/v3/homoit0000507","https://homosaurus.org/v3/homoit0000800","https://homosaurus.org/v3/homoit0001196","https://homosaurus.org/v3/homoit0001431","https://homosaurus.org/v3/homoit0002801","https://homosaurus.org/v3/homoit0002921"],"skos:related":["https://homosaurus.org/v3/homoit0000862","https://homosaurus.org/v3/homoit0002718"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2020006298"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/peopleInTheMilitaryLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001101","dc:identifier":"homoit0001101","skos:prefLabel":["LGBTQ+ people of color","LGBTQ+ people of colour"],"rdfs:comment":"Primarily used in the United States, this term refers to LGBTQ+ people who are not white and who identify as people of color.","skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:narrower":["https://homosaurus.org/v3/homoit0000074","https://homosaurus.org/v3/homoit0000172","https://homosaurus.org/v3/homoit0000208","https://homosaurus.org/v3/homoit0000508","https://homosaurus.org/v3/homoit0000801","https://homosaurus.org/v3/homoit0000820","https://homosaurus.org/v3/homoit0000886","https://homosaurus.org/v3/homoit0000903","https://homosaurus.org/v3/homoit0001146","https://homosaurus.org/v3/homoit0001432","https://homosaurus.org/v3/homoit0001812","https://homosaurus.org/v3/homoit0002009","https://homosaurus.org/v3/homoit0002044","https://homosaurus.org/v3/homoit0002060","https://homosaurus.org/v3/homoit0002070","https://homosaurus.org/v3/homoit0002078","https://homosaurus.org/v3/homoit0002086","https://homosaurus.org/v3/homoit0002094","https://homosaurus.org/v3/homoit0002102","https://homosaurus.org/v3/homoit0002110","https://homosaurus.org/v3/homoit0002118","https://homosaurus.org/v3/homoit0002126","https://homosaurus.org/v3/homoit0002134","https://homosaurus.org/v3/homoit0002231","https://homosaurus.org/v3/homoit0002239","https://homosaurus.org/v3/homoit0002247","https://homosaurus.org/v3/homoit0002295","https://homosaurus.org/v3/homoit0002303","https://homosaurus.org/v3/homoit0002311","https://homosaurus.org/v3/homoit0002319","https://homosaurus.org/v3/homoit0002755","https://homosaurus.org/v3/homoit0002802","https://homosaurus.org/v3/homoit0003557"],"skos:related":["https://homosaurus.org/v3/homoit0001928","https://homosaurus.org/v3/homoit0002190","https://homosaurus.org/v3/homoit0002273","https://homosaurus.org/v3/homoit0003801"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/peopleOfColourLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001102","dc:identifier":"homoit0001102","skos:prefLabel":"Performance art","rdfs:comment":"Art created through actions performed by the artist or other participants, typically for a live audience.","skos:broader":"https://homosaurus.org/v3/homoit0001363","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85099809"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001363"},"dc:replaces":{"@id":"http://homosaurus.org/v2/performanceArt"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001103","dc:identifier":"homoit0001103","skos:prefLabel":"Persecution of bisexual people","rdfs:comment":"Systematic mistreatment of bisexual people on the basis of their sexual identity.","skos:broader":"https://homosaurus.org/v3/homoit0001108","skos:related":"https://homosaurus.org/v3/homoit0000170","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001108"},"dc:replaces":{"@id":"http://homosaurus.org/v2/persecutionOfBisexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001104","dc:identifier":"homoit0001104","skos:prefLabel":"Persecution of gay men","rdfs:comment":"Systematic mistreatment of gay men on the basis of their sexual identity.","skos:broader":"https://homosaurus.org/v3/homoit0001108","skos:related":"https://homosaurus.org/v3/homoit0000506","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001108"},"dc:replaces":{"@id":"http://homosaurus.org/v2/persecutionOfGayMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001105","dc:identifier":"homoit0001105","skos:prefLabel":"Persecution of lesbians","rdfs:comment":"Systematic mistreatment of lesbians on the basis of their sexual identity.","skos:broader":"https://homosaurus.org/v3/homoit0001108","skos:related":"https://homosaurus.org/v3/homoit0000556","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001108"},"dc:replaces":{"@id":"http://homosaurus.org/v2/persecutionOfLesbians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001106","dc:identifier":"homoit0001106","skos:prefLabel":"Persecution of queer people","rdfs:comment":"Systematic mistreatment of queer people on the basis of their gender and/or sexual identities.","skos:broader":"https://homosaurus.org/v3/homoit0001108","skos:related":"https://homosaurus.org/v3/homoit0001195","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001108"},"dc:replaces":{"@id":"http://homosaurus.org/v2/persecutionOfQueerPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001107","dc:identifier":"homoit0001107","skos:prefLabel":"Persecution of transgender people","rdfs:comment":"Systematic mistreatment of transgender people on the basis of their gender identity.","skos:broader":"https://homosaurus.org/v3/homoit0001108","skos:related":"https://homosaurus.org/v3/homoit0001378","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001108"},"dc:replaces":{"@id":"http://homosaurus.org/v2/persecutionOfTransgenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001109","dc:identifier":"homoit0001109","skos:prefLabel":"Phallic sex","rdfs:comment":"Sexual stimulation or sexual practices involving penises or phallic objects (e.g., dildos).","skos:broader":["https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001299"],"skos:narrower":["https://homosaurus.org/v3/homoit0000212","https://homosaurus.org/v3/homoit0000459","https://homosaurus.org/v3/homoit0001498","https://homosaurus.org/v3/homoit0001500"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/phallicSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001110","dc:identifier":"homoit0001110","skos:prefLabel":"Phone sex","skos:altLabel":"Telephone sex","rdfs:comment":"Sexual encounters that take place over the phone, whether in a phone call or on a video call using a smartphone.","skos:broader":["https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001299"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh94005250"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/phoneSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001111","dc:identifier":"homoit0001111","skos:prefLabel":"Phone sex workers","skos:altLabel":["Phone sex operators","Telephone sex workers"," Telephone sex operators"],"rdfs:comment":"People who perform real-time sex work via phone calls, text messaging, or online voice calls. Use \"Cam models\" for individuals who perform real-time sex work via streaming video or video calls.","skos:broader":"https://homosaurus.org/v3/homoit0003758","skos:related":"https://homosaurus.org/v3/homoit0003763","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003758"},"dc:replaces":{"@id":"http://homosaurus.org/v2/phoneSexWorkers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001112","dc:identifier":"homoit0001112","skos:prefLabel":"Physical affection","rdfs:comment":"Touch between two or more people intended to arouse or convey feelings of closeness; can be used to express sexual or non-sexual intimacy and includes actions such as kissing, cuddling, embracing, and holding hands.","skos:narrower":"https://homosaurus.org/v3/homoit0000691","skos:related":["https://homosaurus.org/v3/homoit0000404","https://homosaurus.org/v3/homoit0000998","https://homosaurus.org/v3/homoit0001806"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001112"},"dc:replaces":{"@id":"http://homosaurus.org/v2/physicalAffection"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001113","dc:identifier":"homoit0001113","skos:prefLabel":"Physical health care for LGBTQ+ people","skos:altLabel":"Physical health care for LGBTQ people","rdfs:comment":"Organized measures taken for the maintenance, treatment, or improvement of physical health or conditions of the body; use in reference to physical health care addressing the particular needs of LGBTQ+ individuals or communities.","skos:broader":"https://homosaurus.org/v3/homoit0000614","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000614"},"dc:replaces":{"@id":"http://homosaurus.org/v2/physicalHealthCareForLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001114","dc:identifier":"homoit0001114","skos:prefLabel":"Piercings","rdfs:comment":"Small holes or openings made in parts of the body to insert jewelry or implants, whether for aesthetic purposes, spiritual or religious reasons, or sexual pleasure.","skos:broader":["https://homosaurus.org/v3/homoit0000214","https://homosaurus.org/v3/homoit0003076"],"skos:narrower":"https://homosaurus.org/v3/homoit0003077","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93005224"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000214"},"dc:replaces":{"@id":"http://homosaurus.org/v2/piercings"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001115","dc:identifier":"homoit0001115","skos:prefLabel":"Pinching","rdfs:comment":"Form of manual stimulation involving gripping, pulling, or putting tension on parts of one’s body or another person's body for sexual stimulation, arousal, or pleasure.","skos:broader":["https://homosaurus.org/v3/homoit0000988","https://homosaurus.org/v3/homoit0001299"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pinching"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001116","dc:identifier":"homoit0001116","skos:prefLabel":"Pink triangles","rdfs:comment":"International symbol of gay pride and the gay rights movement that symbolizes the reclamation of the pink triangles used in Nazi Germany to identify gay men (and, later, bisexual men and transgender women) who were sent to concentration camps.","skos:broader":"https://homosaurus.org/v3/homoit0000954","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000954"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pinkTriangles"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001117","dc:identifier":"homoit0001117","skos:prefLabel":"Pinkwashing","rdfs:comment":"A variety of marketing and political strategies aimed at promoting products, countries, people, or entities to LGBTQ+ people; using LGBTQ+-related symbols in order to be perceived as progressive, modern, and tolerant; and/or utilizing concern for LGBTQ+ people and rights to justify or deviate attention from settler-colonialism, genocide, invasion, and intervention in other countries.","skos:related":["https://homosaurus.org/v3/homoit0000643","https://homosaurus.org/v3/homoit0000873","https://homosaurus.org/v3/homoit0000899"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001117"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pinkwashing"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001118","dc:identifier":"homoit0001118","skos:prefLabel":"LGBTQ+ poetry","skos:altLabel":"Poetry (LGBTQ)","rdfs:comment":"Poetry about LGBTQ+ people or relating to LGBTQ+ issues.","skos:broader":"https://homosaurus.org/v3/homoit0000972","skos:narrower":["https://homosaurus.org/v3/homoit0000174","https://homosaurus.org/v3/homoit0000517","https://homosaurus.org/v3/homoit0000762","https://homosaurus.org/v3/homoit0001197","https://homosaurus.org/v3/homoit0001433","https://homosaurus.org/v3/homoit0002401","https://homosaurus.org/v3/homoit0002403","https://homosaurus.org/v3/homoit0002405","https://homosaurus.org/v3/homoit0002408","https://homosaurus.org/v3/homoit0002508","https://homosaurus.org/v3/homoit0002536","https://homosaurus.org/v3/homoit0002576"],"skos:related":["https://homosaurus.org/v3/homoit0001723","https://homosaurus.org/v3/homoit0002630","https://homosaurus.org/v3/homoit0002642"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/poetryLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001119","dc:identifier":"homoit0001119","skos:prefLabel":"Police","skos:altLabel":"Cops","rdfs:comment":"A civil force empowered by the state to enforce the law and maintain public order.","skos:related":["https://homosaurus.org/v3/homoit0001120","https://homosaurus.org/v3/homoit0001122","https://homosaurus.org/v3/homoit0002390","https://homosaurus.org/v3/homoit0002391","https://homosaurus.org/v3/homoit0002397"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85104183"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001119"},"dc:replaces":{"@id":"http://homosaurus.org/v2/police"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001120","dc:identifier":"homoit0001120","skos:prefLabel":"Police entrapment","rdfs:comment":"A practice in which law enforcement agents or agents of the state coerce an individual to commit a \"crime\" they would have otherwise been unlikely or unwilling to commit. Legal definitions of entrapment vary widely depending on the jurisdiction, but the term is often used colloquially to refer to police acting dishonestly or in bad faith, as well as policing focused on anticipating and inducing crime, rather than responding to reports of crime.","skos:broader":"https://homosaurus.org/v3/homoit0001121","skos:narrower":"https://homosaurus.org/v3/homoit0002374","skos:related":["https://homosaurus.org/v3/homoit0000068","https://homosaurus.org/v3/homoit0001119"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85044146"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000611"},"dc:replaces":{"@id":"http://homosaurus.org/v2/policeEntrapment"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001121","dc:identifier":"homoit0001121","skos:prefLabel":"Police harassment","skos:altLabel":["Harrassment by police","Misconduct by police","Mistreatment by police","Police misconduct","Police mistreatment"],"rdfs:comment":"Any of various forms of inappropriate conduct, illegal actions, or abuses of power undertaken by law enforcement agents or agents of the state against members of the public. This includes but is not limited to racial, ethnic, and other forms of profiling; unwarranted surveillance, searches, and seizure; selective enforcement; excessive use of force; sexual misconduct; intimidation and witness tampering; falsification of evidence; coerced confessions; false arrests and imprisonment; and bribing or lobbying.","skos:broader":"https://homosaurus.org/v3/homoit0000611","skos:narrower":["https://homosaurus.org/v3/homoit0001120","https://homosaurus.org/v3/homoit0001122","https://homosaurus.org/v3/homoit0002375"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh95010616"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000611"},"dc:replaces":{"@id":"http://homosaurus.org/v2/policeHarassment"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001122","dc:identifier":"homoit0001122","skos:prefLabel":"Police raids","skos:altLabel":["Dawn raids","No-knock raids"],"rdfs:comment":"Unexpected and unannounced entry into and searches of residences or establishments by law enforcement officers with the aim of using surprise to seize evidence or arrest suspects. Police raids may be undertaken legally using a search warrant or through exigent circumstances, such as probable cause, though the latter is highly subjective and civilians often have little resources to appeal illegal raids.","skos:broader":"https://homosaurus.org/v3/homoit0001121","skos:narrower":"https://homosaurus.org/v3/homoit0002381","skos:related":"https://homosaurus.org/v3/homoit0001119","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000611"},"dc:replaces":{"@id":"http://homosaurus.org/v2/policeRaids"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001123","dc:identifier":"homoit0001123","skos:prefLabel":"Polyamory","rdfs:comment":"Practice of engaging in romantic, sexual, or play relationships with more than one person simultaneously, with the knowledge and consent of all parties involved.","skos:broader":"https://homosaurus.org/v3/homoit0001651","skos:narrower":["https://homosaurus.org/v3/homoit0001554","https://homosaurus.org/v3/homoit0001629","https://homosaurus.org/v3/homoit0001662"],"skos:related":["https://homosaurus.org/v3/homoit0000302","https://homosaurus.org/v3/homoit0000603","https://homosaurus.org/v3/homoit0001124","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001558","https://homosaurus.org/v3/homoit0001645","https://homosaurus.org/v3/homoit0001649","https://homosaurus.org/v3/homoit0001657","https://homosaurus.org/v3/homoit0001661","https://homosaurus.org/v3/homoit0001663","https://homosaurus.org/v3/homoit0001664","https://homosaurus.org/v3/homoit0002255"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/polyamory"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001636","dc:identifier":"homoit0001636","skos:prefLabel":"Relationship orientation","rdfs:comment":"An individual's preference toward or away from a particular relationship model.","skos:narrower":["https://homosaurus.org/v3/homoit0001019","https://homosaurus.org/v3/homoit0001659"],"skos:related":["https://homosaurus.org/v3/homoit0000315","https://homosaurus.org/v3/homoit0000663","https://homosaurus.org/v3/homoit0001237","https://homosaurus.org/v3/homoit0001298","https://homosaurus.org/v3/homoit0001302","https://homosaurus.org/v3/homoit0001650","https://homosaurus.org/v3/homoit0001828","https://homosaurus.org/v3/homoit0003229"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/relationshipOrientation"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001124","dc:identifier":"homoit0001124","skos:prefLabel":"Polygamy","rdfs:comment":"The practice of engaging in romantic, sexual, or play relationships where the dominant partner has multiple spouses, though these marriages are not always recognized by law or within society.","skos:broader":["https://homosaurus.org/v3/homoit0001081","https://homosaurus.org/v3/homoit0001302"],"skos:related":["https://homosaurus.org/v3/homoit0000302","https://homosaurus.org/v3/homoit0000603","https://homosaurus.org/v3/homoit0001123","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0002255"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85104627"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001300"},"dc:replaces":{"@id":"http://homosaurus.org/v2/polygamy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001125","dc:identifier":"homoit0001125","skos:prefLabel":"Poppers","skos:altLabel":"Tape head cleaner","rdfs:comment":"A slang term commonly used in LGBTQ+ subcultures to describe alkyl nitrites, a class of drug that produces a high when inhaled. Poppers are often associated with gay nightlife because they can be used to facilitate anal sex by relaxining the anal muscles.","skos:broader":"https://homosaurus.org/v3/homoit0001317","skos:related":"https://homosaurus.org/v3/homoit0000380","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001317"},"dc:replaces":{"@id":"http://homosaurus.org/v2/poppers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001126","dc:identifier":"homoit0001126","skos:prefLabel":"Porn industry","skos:altLabel":["Porno industry","Pornography industry"],"rdfs:comment":"Businesses that sell pornography, or materials intended for sexual arousal, including images, videos, literature, etc.","skos:broader":"https://homosaurus.org/v3/homoit0000011","skos:related":["https://homosaurus.org/v3/homoit0000013","https://homosaurus.org/v3/homoit0000923"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2009006249"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pornIndustry"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001127","dc:identifier":"homoit0001127","skos:prefLabel":"Porn stars","skos:altLabel":["Pornographic actors","Pornstars","Porn actresses","Adult entertainers"],"rdfs:comment":"Actors in erotic or sexually explicit films.","skos:broader":"https://homosaurus.org/v3/homoit0003758","skos:narrower":"https://homosaurus.org/v3/homoit0003798","skos:related":["https://homosaurus.org/v3/homoit0000494","https://homosaurus.org/v3/homoit0001128"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003758"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pornStars"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001128","dc:identifier":"homoit0001128","skos:prefLabel":"Pornography","rdfs:comment":"Printed or visual materials that explicitly depict sexual acts.","skos:broader":"https://homosaurus.org/v3/homoit0000011","skos:narrower":["https://homosaurus.org/v3/homoit0002172","https://homosaurus.org/v3/homoit0003802"],"skos:related":["https://homosaurus.org/v3/homoit0000403","https://homosaurus.org/v3/homoit0001127","https://homosaurus.org/v3/homoit0001281","https://homosaurus.org/v3/homoit0003127","https://homosaurus.org/v3/homoit0003128"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85105008"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pornography"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001129","dc:identifier":"homoit0001129","skos:prefLabel":"Post-operative","rdfs:comment":"Individuals who have recently undergone a surgical operation; commonly used to describe trans people who have undergone gender affirming surgery.","skos:broader":"https://homosaurus.org/v3/homoit0001464","skos:related":["https://homosaurus.org/v3/homoit0000561","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001381"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85105563"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001465"},"dc:replaces":{"@id":"http://homosaurus.org/v2/postOperative"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001130","dc:identifier":"homoit0001130","skos:prefLabel":"PrEP","skos:altLabel":"Pre-exposure prophylaxis","rdfs:comment":"Medication taken to prevent the contraction of HIV.","skos:broader":"https://homosaurus.org/v3/homoit0001007","skos:related":"https://homosaurus.org/v3/homoit0000005","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2017003696"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/prep"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001131","dc:identifier":"homoit0001131","skos:prefLabel":"Pre-operative","rdfs:comment":"The medical status of individuals who plan to undertake a surgical procedure but have not yet done so. Commonly used to describe trans people who have not yet undergone gender affirming surgery but plan to do so.","skos:broader":"https://homosaurus.org/v3/homoit0001464","skos:related":["https://homosaurus.org/v3/homoit0000561","https://homosaurus.org/v3/homoit0001378","https://homosaurus.org/v3/homoit0001381"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85106377"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001465"},"dc:replaces":{"@id":"http://homosaurus.org/v2/preOperative"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001133","dc:identifier":"homoit0001133","skos:prefLabel":"Social privilege","rdfs:comment":"Special rights or immunities granted to specific people or groups that are used to falsely homogenize or discriminate against other people or groups.","skos:related":["https://homosaurus.org/v3/homoit0000054","https://homosaurus.org/v3/homoit0000243","https://homosaurus.org/v3/homoit0000302","https://homosaurus.org/v3/homoit0000381","https://homosaurus.org/v3/homoit0000416","https://homosaurus.org/v3/homoit0000417","https://homosaurus.org/v3/homoit0000598","https://homosaurus.org/v3/homoit0000622","https://homosaurus.org/v3/homoit0000667","https://homosaurus.org/v3/homoit0000675","https://homosaurus.org/v3/homoit0000860","https://homosaurus.org/v3/homoit0000999","https://homosaurus.org/v3/homoit0001017","https://homosaurus.org/v3/homoit0001018","https://homosaurus.org/v3/homoit0001230","https://homosaurus.org/v3/homoit0001376","https://homosaurus.org/v3/homoit0001377","https://homosaurus.org/v3/homoit0002271"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2017003293"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001133"},"dc:replaces":{"@id":"http://homosaurus.org/v2/socialPrivilege"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001134","dc:identifier":"homoit0001134","skos:prefLabel":"Progestin induced virilization","rdfs:comment":"People born with progestin-induced virilization have XX chromosomes and may have visible genital variations at birth such as a larger-than-typical clitoris, sometimes also with fused or partially fused labia. They usually have a typical uterus, ovaries, and fallopian tubes, though their vagina may or may not have differences. This variation develops in utero as a result of the individual's parent taking progestin medication while pregnant. Being exposed to these additional hormones before birth can change how someone’s genitals develop, but it generally will not change how their own body will produce or respond to hormones later on. This means that someone born with progestin-induced virilization will usually develop features associated with a typical estrogen puberty.","skos:broader":"https://homosaurus.org/v3/homoit0000669","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/progestinInducedVirilization"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001135","dc:identifier":"homoit0001135","skos:prefLabel":"Pronouns","skos:altLabel":"Personal pronouns","rdfs:comment":"Words used in place of a noun. Typically used in the context of \"personal pronouns,\" or pronouns used to describe people (e.g., she, he, they, ze).","skos:narrower":["https://homosaurus.org/v3/homoit0001673","https://homosaurus.org/v3/homoit0001674","https://homosaurus.org/v3/homoit0001675","https://homosaurus.org/v3/homoit0001676","https://homosaurus.org/v3/homoit0001677","https://homosaurus.org/v3/homoit0001678","https://homosaurus.org/v3/homoit0001679","https://homosaurus.org/v3/homoit0001680","https://homosaurus.org/v3/homoit0001681","https://homosaurus.org/v3/homoit0001682","https://homosaurus.org/v3/homoit0001683","https://homosaurus.org/v3/homoit0001684","https://homosaurus.org/v3/homoit0001685","https://homosaurus.org/v3/homoit0001686","https://homosaurus.org/v3/homoit0001687","https://homosaurus.org/v3/homoit0001688","https://homosaurus.org/v3/homoit0001689","https://homosaurus.org/v3/homoit0001690","https://homosaurus.org/v3/homoit0001691","https://homosaurus.org/v3/homoit0001692","https://homosaurus.org/v3/homoit0001693","https://homosaurus.org/v3/homoit0001694","https://homosaurus.org/v3/homoit0001695","https://homosaurus.org/v3/homoit0001696","https://homosaurus.org/v3/homoit0001697","https://homosaurus.org/v3/homoit0001698","https://homosaurus.org/v3/homoit0001699","https://homosaurus.org/v3/homoit0001700","https://homosaurus.org/v3/homoit0001701","https://homosaurus.org/v3/homoit0001702","https://homosaurus.org/v3/homoit0001703","https://homosaurus.org/v3/homoit0001704","https://homosaurus.org/v3/homoit0001705","https://homosaurus.org/v3/homoit0001706","https://homosaurus.org/v3/homoit0001707","https://homosaurus.org/v3/homoit0001708","https://homosaurus.org/v3/homoit0001709","https://homosaurus.org/v3/homoit0001710","https://homosaurus.org/v3/homoit0001711","https://homosaurus.org/v3/homoit0001712","https://homosaurus.org/v3/homoit0001713","https://homosaurus.org/v3/homoit0001714","https://homosaurus.org/v3/homoit0001715","https://homosaurus.org/v3/homoit0001716"],"skos:related":["https://homosaurus.org/v3/homoit0001016","https://homosaurus.org/v3/homoit0001672","https://homosaurus.org/v3/homoit0002259"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85043654"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001135"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pronouns"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0001136","dc:identifier":"homoit0001136","skos:prefLabel":"Prostitution","skos:broader":["https://homosaurus.org/v3/homoit0001276","https://homosaurus.org/v3/homoit0001299"],"skos:narrower":"https://homosaurus.org/v3/homoit0001438","skos:related":"https://homosaurus.org/v3/homoit0000278","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85107626"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000011"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001276"},"dc:replaces":{"@id":"http://homosaurus.org/v2/prostitution"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-28"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001137","dc:identifier":"homoit0001137","skos:prefLabel":"LGBTQ+ Protestants","skos:altLabel":"Protestants (LGBTQ)","rdfs:comment":"LGBTQ+ people who are members of the Protestant Church.","skos:broader":"https://homosaurus.org/v3/homoit0000265","skos:narrower":["https://homosaurus.org/v3/homoit0000048","https://homosaurus.org/v3/homoit0000097","https://homosaurus.org/v3/homoit0000179","https://homosaurus.org/v3/homoit0000237","https://homosaurus.org/v3/homoit0000526","https://homosaurus.org/v3/homoit0000770","https://homosaurus.org/v3/homoit0000926","https://homosaurus.org/v3/homoit0001202","https://homosaurus.org/v3/homoit0001439","https://homosaurus.org/v3/homoit0002978","https://homosaurus.org/v3/homoit0002984"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/protestantsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001138","dc:identifier":"homoit0001138","skos:prefLabel":"Puberty blockers","rdfs:comment":"Group of medications used to inhibit puberty.","skos:broader":["https://homosaurus.org/v3/homoit0000650","https://homosaurus.org/v3/homoit0001007"],"skos:related":"https://homosaurus.org/v3/homoit0001400","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pubertyBlockers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001139","dc:identifier":"homoit0001139","skos:prefLabel":"Bathroom bans","skos:altLabel":["Changing room bans","Locker room bans","Restroom bans"],"rdfs:comment":"Laws or policies instituted to prevent trans and non-binary individuals from using public bathrooms and facilities, such as locker rooms, shower rooms, changing rooms, and other sex-segregated spaces, on the basis of their gender identity.","skos:broader":"https://homosaurus.org/v3/homoit0003499","skos:related":["https://homosaurus.org/v3/homoit0000248","https://homosaurus.org/v3/homoit0000975","https://homosaurus.org/v3/homoit0001140","https://homosaurus.org/v3/homoit0001141","https://homosaurus.org/v3/homoit0001143"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/publicBathroomBills"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001140","dc:identifier":"homoit0001140","skos:prefLabel":"Public bathrooms","skos:altLabel":["Public restrooms","Toilets"],"rdfs:comment":"Rooms or small buildings with one or more toilets (or urinals) available for use by the general public or by customers or employees of a business.","skos:broader":"https://homosaurus.org/v3/homoit0001141","skos:narrower":"https://homosaurus.org/v3/homoit0000595","skos:related":["https://homosaurus.org/v3/homoit0000062","https://homosaurus.org/v3/homoit0000308","https://homosaurus.org/v3/homoit0001090","https://homosaurus.org/v3/homoit0001139","https://homosaurus.org/v3/homoit0001358"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85108627"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001141"},"dc:replaces":{"@id":"http://homosaurus.org/v2/publicBathrooms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001142","dc:identifier":"homoit0001142","skos:prefLabel":"Public sex","rdfs:comment":"Sex in public places such as beaches, parks, cottages, etc.","skos:broader":"https://homosaurus.org/v3/homoit0001299","skos:related":["https://homosaurus.org/v3/homoit0000309","https://homosaurus.org/v3/homoit0000319","https://homosaurus.org/v3/homoit0000412","https://homosaurus.org/v3/homoit0000475","https://homosaurus.org/v3/homoit0000900","https://homosaurus.org/v3/homoit0000974","https://homosaurus.org/v3/homoit0001257","https://homosaurus.org/v3/homoit0001306","https://homosaurus.org/v3/homoit0001357"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008001734"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001299"},"dc:replaces":{"@id":"http://homosaurus.org/v2/publicSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001143","dc:identifier":"homoit0001143","skos:prefLabel":"Public showers","rdfs:comment":"Public or commercial facilities equipped with showers or places to bathe.","skos:broader":"https://homosaurus.org/v3/homoit0001141","skos:related":"https://homosaurus.org/v3/homoit0001139","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001141"},"dc:replaces":{"@id":"http://homosaurus.org/v2/publicShowers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001145","dc:identifier":"homoit0001145","skos:prefLabel":"Pups (Roleplay)","skos:altLabel":["Puppers","Puppies"],"rdfs:comment":"Individuals who take on the pup or puppy role in puppy play, a form of animal roleplay that is often but not always associated with BDSM and kink communities.","skos:broader":["https://homosaurus.org/v3/homoit0000487","https://homosaurus.org/v3/homoit0000506","https://homosaurus.org/v3/homoit0000705","https://homosaurus.org/v3/homoit0001242","https://homosaurus.org/v3/homoit0001295"],"skos:related":["https://homosaurus.org/v3/homoit0000105","https://homosaurus.org/v3/homoit0000568","https://homosaurus.org/v3/homoit0001063","https://homosaurus.org/v3/homoit0003083","https://homosaurus.org/v3/homoit0003086"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pups"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001146","dc:identifier":"homoit0001146","skos:prefLabel":["Queer people of color","Queer people of colour"],"skos:altLabel":"QPOC","rdfs:comment":"Primarily used in the United States, this term refers to queer people who are not white and who identify as people of color.","skos:broader":"https://homosaurus.org/v3/homoit0001101","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerPeopleOfColour"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001147","dc:identifier":"homoit0001147","skos:prefLabel":"Quariwarmi","rdfs:comment":"North American Inca term for people assigned male at birth who fulfill a third gender role that is often spiritual in nature.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":"https://homosaurus.org/v3/homoit0001480","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/quariwarmi"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001148","dc:identifier":"homoit0001148","skos:prefLabel":"Queens (Gay culture)","skos:altLabel":"Queens","rdfs:comment":"Slang term for effeminate gay men; predominantly used in the United States.","skos:broader":["https://homosaurus.org/v3/homoit0000487","https://homosaurus.org/v3/homoit0000506"],"skos:narrower":"https://homosaurus.org/v3/homoit0000375","skos:related":["https://homosaurus.org/v3/homoit0000568","https://homosaurus.org/v3/homoit0001313"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queens"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001149","dc:identifier":"homoit0001149","skos:prefLabel":"Queer (Verb)","rdfs:comment":"A term commonly used in academic disciplines to describe actions that address sexual and gender normativity, expose systems of oppression, and attempt to undermine those systems.","skos:narrower":"https://homosaurus.org/v3/homoit0002180","skos:related":["https://homosaurus.org/v3/homoit0000579","https://homosaurus.org/v3/homoit0000972","https://homosaurus.org/v3/homoit0001156","https://homosaurus.org/v3/homoit0001219","https://homosaurus.org/v3/homoit0001891","https://homosaurus.org/v3/homoit0002042","https://homosaurus.org/v3/homoit0002577"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001149"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerVerb"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001150","dc:identifier":"homoit0001150","skos:prefLabel":"Queer activism","rdfs:comment":"Direct action and organizing to achieve political or social change and acceptance for queer people.","skos:broader":"https://homosaurus.org/v3/homoit0000006","skos:related":"https://homosaurus.org/v3/homoit0001198","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerActivism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001151","dc:identifier":"homoit0001151","skos:prefLabel":"African American queer people","skos:altLabel":["Queer African American people","Queer African Americans"],"rdfs:comment":"Queer people of African descent born in the United States or queer people born in African countries who live in or have a strong connection to the United States. Use for individuals who self-identity as African American. Follow the individual’s preference for African American or Black whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000015","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerAfricanAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001152","dc:identifier":"homoit0001152","skos:prefLabel":"Afro-Canadian queer people","skos:altLabel":["Queer Afro-Canadian people","Queer Afro-Canadians"],"rdfs:comment":"Queer people of African descent born in Canada or queer people born in African countries who live in or have a strong connection to Canada. Use for individuals who self-identify as Afro-Canadian.","skos:broader":"https://homosaurus.org/v3/homoit0000016","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerAfroCanadians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001153","dc:identifier":"homoit0001153","skos:prefLabel":"Afro-Caribbean queer people","skos:altLabel":["Queer Afro-Caribbean people","Queer Afro-Caribbeans"],"rdfs:comment":"Queer people of African descent born in the Caribbean or queer people born in African countries who live in or have a strong connection to the Caribbean. Only use for individuals who self-identify as Afro-Caribbean.","skos:broader":"https://homosaurus.org/v3/homoit0000017","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerAfroCaribbeans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001154","dc:identifier":"homoit0001154","skos:prefLabel":"Afro-European queer people","skos:altLabel":["Queer Afro-European people","Queer Afro-Europeans"],"rdfs:comment":"Queer people of African descent born in European countries or queer people born in African countries who live in or have a strong connection to Europe. Only use for individuals who self-identify as Afro-European.","skos:broader":"https://homosaurus.org/v3/homoit0000018","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerAfroEuropeans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001155","dc:identifier":"homoit0001155","skos:prefLabel":"Afro-Latin American queer people","skos:altLabel":["Queer Afro-Latin American people","Queer Afro-Latin Americans"],"rdfs:comment":"Queer people of African descent born in Latin American countries or queer people born in African countries who live in or have a strong connection to Latin America. Only use for individuals who self-identify as Afro-Latin American.","skos:broader":"https://homosaurus.org/v3/homoit0000019","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerAfroLatinAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001156","dc:identifier":"homoit0001156","skos:prefLabel":"Queer archives","rdfs:comment":"Collections of records and materials relating to queer people or queer communities; can include a variety of organizations and institutions from community to government archives.","skos:broader":"https://homosaurus.org/v3/homoit0000066","skos:related":"https://homosaurus.org/v3/homoit0001149","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerArchives"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001157","dc:identifier":"homoit0001157","skos:prefLabel":"Queer artists","rdfs:comment":"Queer people who practice any of various creative arts.","skos:broader":"https://homosaurus.org/v3/homoit0000070","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerArtists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001158","dc:identifier":"homoit0001158","skos:prefLabel":"Asian American queer people","skos:altLabel":["Queer Asian American people","Queer Asian Americans"],"rdfs:comment":"Queer people of Asian heritage or descent born in the United States or born in Asian countries who live in or have a strong connection to the United States. Only use for individuals who self-identify as Asian American.","skos:broader":["https://homosaurus.org/v3/homoit0000073","https://homosaurus.org/v3/homoit0001159"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerAsianAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001159","dc:identifier":"homoit0001159","skos:prefLabel":"Asian queer people","skos:altLabel":["Queer Asian people","Queer Asians"],"rdfs:comment":"Queer people of Asian heritage or descent, living in Asia or part of the Asian diaspora. Only use for people who self-identify as Asian.","skos:broader":"https://homosaurus.org/v3/homoit0000074","skos:narrower":"https://homosaurus.org/v3/homoit0001158","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerAsians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001160","dc:identifier":"homoit0001160","skos:prefLabel":"Queer atheists","rdfs:comment":"Queer people who are atheists.","skos:broader":"https://homosaurus.org/v3/homoit0000082","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerAtheists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001161","dc:identifier":"homoit0001161","skos:prefLabel":"Queer bars","rdfs:comment":"Drinking establishments that primarily cater to queer people.","skos:broader":"https://homosaurus.org/v3/homoit0000100","skos:related":"https://homosaurus.org/v3/homoit0001170","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerBars"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001162","dc:identifier":"homoit0001162","skos:prefLabel":"Queer beaches","rdfs:comment":"Beaches set aside for use by queer people or beaches known to be frequented by queer people.","skos:broader":"https://homosaurus.org/v3/homoit0000104","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerBeaches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001163","dc:identifier":"homoit0001163","skos:prefLabel":"Black queer people","skos:altLabel":"Queer Black people","rdfs:comment":"Black people who are queer. Use only for individuals who self-identity as Black. Follow the individual’s preference for African American or Black whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000208","skos:related":"https://homosaurus.org/v3/homoit0003608","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerBlackPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001164","dc:identifier":"homoit0001164","skos:prefLabel":"Queer bookshops","rdfs:comment":"Bookshops that sell materials intended for use by queer people or addressing topics related to queerness.","skos:broader":"https://homosaurus.org/v3/homoit0000216","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000216"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerBookshops"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@