peform as if they are gay or lesbian.","Sex workers, including porn stars, who identify as heterosexual but are paid to peform as if they are homosexual."],"skos:broader":"https://homosaurus.org/v3/homoit0001276","skos:related":["https://homosaurus.org/v3/homoit0001127","https://homosaurus.org/v3/homoit0003758"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayForPay"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0000495","dc:identifier":"homoit0000495","skos:prefLabel":"Gay Games","rdfs:comment":"An international sport and cultural event held by the Federation of Gay Games since 1982 that promotes acceptance of LGBTQ+ people and features LGBTQ+ athletes, artists, and other individuals","skos:broader":"https://homosaurus.org/v3/homoit0000949","skos:related":"https://homosaurus.org/v3/homoit0000949","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000861"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000949"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayGames"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000496","dc:identifier":"homoit0000496","skos:prefLabel":"Gay identity","rdfs:comment":"Term used to describe the sexual identity of men and mascs who are sexually and/or romantically attracted to other men and mascs. Do not use as a broader term for LGBTQ+ people.","skos:broader":"https://homosaurus.org/v3/homoit0001295","skos:related":["https://homosaurus.org/v3/homoit0000479","https://homosaurus.org/v3/homoit0000506","https://homosaurus.org/v3/homoit0000544"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh99003153"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000497","dc:identifier":"homoit0000497","skos:prefLabel":"Jewish gay men","skos:altLabel":["Gay Jews","Jewish gay people","Jewish gays"],"rdfs:comment":"Gay men who are Jewish.","skos:broader":"https://homosaurus.org/v3/homoit0000682","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2003011466"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayJews"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000498","dc:identifier":"homoit0000498","skos:prefLabel":"Latino/a/x gay men","skos:altLabel":["Gay Latine","Gay Latinos","Gay Latinx","Latine gay men","Latino gay men","Latinx gay men"],"rdfs:comment":"Latin American men who are gay; only use to describe individuals who self-identify as Latino, Latina, or Latinx. Do not conflate with Chicano/a/x or Hispanic.","skos:broader":"https://homosaurus.org/v3/homoit0000253","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayLatinos"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000499","dc:identifier":"homoit0000499","skos:prefLabel":"Lesbian-gay relations","skos:altLabel":"Gay-lesbian relations","rdfs:comment":"Connections between individuals and communities of lesbians and gay men, including historic and ongoing solidarity, advocacy, and activism.","skos:broader":"https://homosaurus.org/v3/homoit0000575","skos:related":["https://homosaurus.org/v3/homoit0000506","https://homosaurus.org/v3/homoit0000556"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh95007084"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000947"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbian-gayRelations"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000947","dc:identifier":"homoit0000947","skos:prefLabel":"LGBTQ+ social processes","skos:altLabel":"LGBTQ social processes","rdfs:comment":"Forms of social interaction that occur repeatedly; use to describe the ways in which LGBTQ+ people interact and establish social relationships.","skos:narrower":["https://homosaurus.org/v3/homoit0000500","https://homosaurus.org/v3/homoit0000538","https://homosaurus.org/v3/homoit0000575","https://homosaurus.org/v3/homoit0000748","https://homosaurus.org/v3/homoit0000857","https://homosaurus.org/v3/homoit0000960"],"skos:related":["https://homosaurus.org/v3/homoit0000080","https://homosaurus.org/v3/homoit0001273","https://homosaurus.org/v3/homoit0001301","https://homosaurus.org/v3/homoit0001303","https://homosaurus.org/v3/homoit0003694"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000947"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSocialProcesses"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000500","dc:identifier":"homoit0000500","skos:prefLabel":"Gay liberation","skos:altLabel":"Gay liberation movement","rdfs:comment":"Movement of the late 1960s and early to mid 1970s that urged lesbians and gay men to “come out\" and publicly reveal their sexuality to family, friends, and colleagues as a form of activism and as a means of countering shame with pride.","skos:broader":"https://homosaurus.org/v3/homoit0000947","skos:related":["https://homosaurus.org/v3/homoit0000510","https://homosaurus.org/v3/homoit0000748","https://homosaurus.org/v3/homoit0000753","https://homosaurus.org/v3/homoit0000857","https://homosaurus.org/v3/homoit0001341"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000947"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayLiberation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000501","dc:identifier":"homoit0000501","skos:prefLabel":"Gay libraries","rdfs:comment":"Libraries that hold materials primarily pertaining to gay men or intended for use by gay men.","skos:broader":"https://homosaurus.org/v3/homoit0000968","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh89000080"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayLibraries"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000502","dc:identifier":"homoit0000502","skos:prefLabel":"Gay literature","rdfs:comment":"Written literary works about gay men, gay characters, or gay themes.","skos:broader":"https://homosaurus.org/v3/homoit0000972","skos:related":"https://homosaurus.org/v3/homoit0001725","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayLiterature"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000503","dc:identifier":"homoit0000503","skos:prefLabel":"Gay couples","rdfs:comment":"Partnerships in which both people are gay men.","skos:broader":"https://homosaurus.org/v3/homoit0000310","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85061777"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayMaleCouples"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000504","dc:identifier":"homoit0000504","skos:prefLabel":"Same-sex marriage","skos:altLabel":["Gay marriage","Lesbian marriage"],"rdfs:comment":"Legal union between two people of the same sex who are in a partnership. In the United States, same-sex marriage differs from civil unions in that the former is recognized at the federal level, whereas the latter is only recognized at the state level and may not be recognized by other states.","skos:broader":"https://homosaurus.org/v3/homoit0000990","skos:related":["https://homosaurus.org/v3/homoit0000844","https://homosaurus.org/v3/homoit0001514"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh92003901"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/same-sexMarriage"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000505","dc:identifier":"homoit0000505","skos:prefLabel":"Gay dominants","rdfs:comment":"Gay men who are part of the BDSM scene and assume the dominant role in sexual relationships with a master/slave dynamic.","skos:broader":"https://homosaurus.org/v3/homoit0000999","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayMasters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000506","dc:identifier":"homoit0000506","skos:prefLabel":"Gay men","skos:altLabel":"Gays","rdfs:comment":"Men who self-identify as gay and belong to gay communities. Predominately used to describe men who are exclusively or primarily romantically and/or sexually attracted to other men. While \"gay\" is often used as an identifier by people of all genders, this term specifically refers to gay men.","skos:broader":["https://homosaurus.org/v3/homoit0000915","https://homosaurus.org/v3/homoit0001008","https://homosaurus.org/v3/homoit0001297"],"skos:narrower":["https://homosaurus.org/v3/homoit0000089","https://homosaurus.org/v3/homoit0000105","https://homosaurus.org/v3/homoit0000284","https://homosaurus.org/v3/homoit0000286","https://homosaurus.org/v3/homoit0000492","https://homosaurus.org/v3/homoit0000978","https://homosaurus.org/v3/homoit0001055","https://homosaurus.org/v3/homoit0001063","https://homosaurus.org/v3/homoit0001145","https://homosaurus.org/v3/homoit0001148","https://homosaurus.org/v3/homoit0001479","https://homosaurus.org/v3/homoit0001508","https://homosaurus.org/v3/homoit0003037"],"skos:related":["https://homosaurus.org/v3/homoit0000418","https://homosaurus.org/v3/homoit0000479","https://homosaurus.org/v3/homoit0000481","https://homosaurus.org/v3/homoit0000485","https://homosaurus.org/v3/homoit0000496","https://homosaurus.org/v3/homoit0000499","https://homosaurus.org/v3/homoit0000509","https://homosaurus.org/v3/homoit0000544","https://homosaurus.org/v3/homoit0000646","https://homosaurus.org/v3/homoit0000647","https://homosaurus.org/v3/homoit0001009","https://homosaurus.org/v3/homoit0001104","https://homosaurus.org/v3/homoit0001185","https://homosaurus.org/v3/homoit0001258","https://homosaurus.org/v3/homoit0002170"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85061798"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000507","dc:identifier":"homoit0000507","skos:prefLabel":"Gay men in the military","rdfs:comment":"Gay men serving in state and national armed forces.","skos:broader":"https://homosaurus.org/v3/homoit0001100","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006000714"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayMenInTheMilitary"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000508","dc:identifier":"homoit0000508","skos:prefLabel":["Gay men of color","Gay men of colour"],"rdfs:comment":"Primarily used in the United States, this term refers to gay men who are not white and who identify as people of color.","skos:broader":"https://homosaurus.org/v3/homoit0001101","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayMenOfColour"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000509","dc:identifier":"homoit0000509","skos:prefLabel":"Parents of gay men","skos:altLabel":"Gay men's parents","rdfs:comment":"People who act as parents to one or more gay man. For parents who are themselves gay, use the term \"Gay parents.\"","skos:broader":"https://homosaurus.org/v3/homoit0002224","skos:related":"https://homosaurus.org/v3/homoit0000506","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh90005864"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/parentsOfGayMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000510","dc:identifier":"homoit0000510","skos:prefLabel":"Gay movement","skos:altLabel":["Gay organisations","Gay organizations"],"rdfs:comment":"Umbrella term for activism focused on the rights of gay men and issues faced by gay communities.","skos:broader":"https://homosaurus.org/v3/homoit0001026","skos:narrower":"https://homosaurus.org/v3/homoit0000549","skos:related":["https://homosaurus.org/v3/homoit0000486","https://homosaurus.org/v3/homoit0000490","https://homosaurus.org/v3/homoit0000500","https://homosaurus.org/v3/homoit0000521","https://homosaurus.org/v3/homoit0000528","https://homosaurus.org/v3/homoit0000545"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayMovement"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000511","dc:identifier":"homoit0000511","skos:prefLabel":"Gay museums","rdfs:comment":"Institutions dedicated to the storage, exhibition, conservation, and preservation of materials relating to gay men or gay history.","skos:broader":"https://homosaurus.org/v3/homoit0001030","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayMuseums"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000512","dc:identifier":"homoit0000512","skos:prefLabel":"Gay Muslims","rdfs:comment":"Gay men who are Muslim.","skos:broader":"https://homosaurus.org/v3/homoit0001032","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2009009639"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayMuslims"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000513","dc:identifier":"homoit0000513","skos:prefLabel":"Native American gay men","skos:altLabel":["American Indian gay men","Gay American Indians","Gay Native Americans"],"rdfs:comment":"People who are part of the Native peoples of the continental United States and Canada (excluding Inuit people) and self-identity as gay men. Use more specific terms when available.","skos:broader":"https://homosaurus.org/v3/homoit0001037","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayNativeAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000514","dc:identifier":"homoit0000514","skos:prefLabel":"Gay newsletters","rdfs:comment":"Serialized print or digital periodicals created by or for gay men, often with the purpose of sharing news and information related to gay communities and issues.","skos:broader":["https://homosaurus.org/v3/homoit0000521","https://homosaurus.org/v3/homoit0001041"],"skos:related":"https://homosaurus.org/v3/homoit0000515","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayNewsletters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000515","dc:identifier":"homoit0000515","skos:prefLabel":"Gay newspapers","rdfs:comment":"Serialized print or digital publications about gay men or gay issues (and typically produced by gay men or gay organizations) that contain news, articles, columns, correspondence, and advertisements.","skos:broader":["https://homosaurus.org/v3/homoit0000521","https://homosaurus.org/v3/homoit0001042"],"skos:related":"https://homosaurus.org/v3/homoit0000514","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh94008545"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayNewspapers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000516","dc:identifier":"homoit0000516","skos:prefLabel":"Gay Pagans","rdfs:comment":"Gay men who are members of polytheistic religions or other religions outside of the dominant culture that typically incorporate nature worship and/or the sacred feminine, such as Wicca, Druidry, Heathenry, etc. Use to describe gay men who self-identify as Pagan.","skos:broader":"https://homosaurus.org/v3/homoit0001069","skos:related":"https://homosaurus.org/v3/homoit0001909","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayPagans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000517","dc:identifier":"homoit0000517","skos:prefLabel":"Gay poetry","rdfs:comment":"Literary work, typically written in verse, that focuses on gay characters, themes, or identity.","skos:broader":"https://homosaurus.org/v3/homoit0001118","skos:related":"https://homosaurus.org/v3/homoit0001725","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008105069"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayPoetry"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000518","dc:identifier":"homoit0000518","skos:prefLabel":"Gay political activists","rdfs:comment":"Gay men working to bring about political or social change through public organizing.","skos:broader":"https://homosaurus.org/v3/homoit0000007","skos:related":"https://homosaurus.org/v3/homoit0000462","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002979"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayPoliticalActivists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000519","dc:identifier":"homoit0000519","skos:prefLabel":"Gay political groups","rdfs:comment":"Organized groups centered on political change and action for gay rights that may or may not be aligned with major political parties.","skos:broader":"https://homosaurus.org/v3/homoit0003521","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003521"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayPoliticalGroups"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0003521","dc:identifier":"homoit0003521","skos:prefLabel":"LGBTQ+ political groups","skos:altLabel":"Political groups (LGBTQ)","rdfs:comment":"Organized groups centered on political change and action for LGBTQ+ rights that may or may not be aligned with major political parties.","skos:narrower":["https://homosaurus.org/v3/homoit0003522","https://homosaurus.org/v3/homoit0003523","https://homosaurus.org/v3/homoit0003524","https://homosaurus.org/v3/homoit0003525","https://homosaurus.org/v3/homoit0003526","https://homosaurus.org/v3/homoit0003527","https://homosaurus.org/v3/homoit0003528","https://homosaurus.org/v3/homoit0003529","https://homosaurus.org/v3/homoit0003530","https://homosaurus.org/v3/homoit0003532","https://homosaurus.org/v3/homoit0000764"],"skos:related":"https://homosaurus.org/v3/homoit0003531","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003521"},"dc:issued":{"@type":"xsd:date","@value":"2024-09-19"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000520","dc:identifier":"homoit0000520","skos:prefLabel":"Gay porn films","rdfs:comment":"Erotic or sexually explicit films featuring gay men.","skos:broader":["https://homosaurus.org/v3/homoit0000013","https://homosaurus.org/v3/homoit0002331","https://homosaurus.org/v3/homoit0002608"],"skos:related":"https://homosaurus.org/v3/homoit0002547","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2011001047"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayPornFilms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000521","dc:identifier":"homoit0000521","skos:prefLabel":"Gay press","rdfs:comment":"Newspapers, magazines, or other publishing outlets aimed at gay audiences and/or operated by gay men.","skos:broader":"https://homosaurus.org/v3/homoit0001132","skos:narrower":["https://homosaurus.org/v3/homoit0000514","https://homosaurus.org/v3/homoit0000515","https://homosaurus.org/v3/homoit0003156"],"skos:related":["https://homosaurus.org/v3/homoit0000510","https://homosaurus.org/v3/homoit0000896"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh94008923"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayPress"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000522","dc:identifier":"homoit0000522","skos:prefLabel":"Gay pride","rdfs:comment":"The recognition and celebration of gay people and culture, thereby affirming the visibility, dignity, and diversity of gay communities. This term can be used to refer to gay men specifically, but it is often used as an umbrella term for LGBTQ+ pride as a whole, particularly in historical contexts.","skos:broader":"https://homosaurus.org/v3/homoit0003653","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003653"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayPride"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000523","dc:identifier":"homoit0000523","skos:prefLabel":"Gay Pride Week","skos:altLabel":["Pink Saturday","Pink Week","Pride Week"],"rdfs:comment":"A period of public recognition and celebration of LGBTQ+ people and culture, usually organized over the course of a week with local events, parades, marches, and rallies. Gay pride week occurs at different times during the year in different places but is typically held in June in the United States to commemorate the Stonewall uprising.","skos:broader":"https://homosaurus.org/v3/homoit0003654","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93000860"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003653"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayPrideWeek"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000524","dc:identifier":"homoit0000524","skos:prefLabel":"Gay priests","rdfs:comment":"Gay men who are ordained as priests in different denominations of the Christian Church.","skos:broader":"https://homosaurus.org/v3/homoit0000484","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001624"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayPriests"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000525","dc:identifier":"homoit0000525","skos:prefLabel":"Gay sex workers","skos:altLabel":["Gay prostitutes","Gay prostitution","Gay sex work"],"rdfs:comment":"Gay men who receive money or goods in exchange for sexual services, performances, or companionship. Use to describe gay men working across the broad spectrum of sex work.","skos:broader":"https://homosaurus.org/v3/homoit0001277","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003758"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayProstitutes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000526","dc:identifier":"homoit0000526","skos:prefLabel":"Gay Protestants","rdfs:comment":"Gay men who are members of the Protestant Church.","skos:broader":"https://homosaurus.org/v3/homoit0001137","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007008279"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayProtestants"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000527","dc:identifier":"homoit0000527","skos:prefLabel":"Gay publishers","rdfs:comment":"Companies and organizations that publish materials for gay communities or addressing gay issues.","skos:broader":"https://homosaurus.org/v3/homoit0001144","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001144"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayPublishers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000528","dc:identifier":"homoit0000528","skos:prefLabel":"Gay radio","rdfs:comment":"Auditory content broadcast on the radio (analog or digital) about gay men and gay issues.","skos:broader":"https://homosaurus.org/v3/homoit0001231","skos:related":"https://homosaurus.org/v3/homoit0000510","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001231"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayRadio"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000529","dc:identifier":"homoit0000529","skos:prefLabel":"Gay relationships","rdfs:comment":"Ongoing connections (romantic, sexual, or platonic) between two or more gay men.","skos:broader":"https://homosaurus.org/v3/homoit0001237","skos:related":["https://homosaurus.org/v3/homoit0000182","https://homosaurus.org/v3/homoit0001205","https://homosaurus.org/v3/homoit0001442"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayRelationships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000530","dc:identifier":"homoit0000530","skos:prefLabel":"LGBTQ+-affirming religious groups","skos:altLabel":["Gay religious groups","Lesbian religious groups","LGBTQ+ affirming religious groups","LGBTQ+ inclusive religious groups","LGBTQ+-inclusive religious groups"],"rdfs:comment":"Groups of people united by a religion or religious practices that are accepting and supportive of LGBTQ+ people and their identities. Includes large-scale organized groups, such as denominations or sects, as well as small-scale groups, such as specific churches, mosques, temples, or congregations.","skos:related":"https://homosaurus.org/v3/homoit0003609","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000530"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayReligiousGroups"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000531","dc:identifier":"homoit0000531","skos:prefLabel":"Gay rights","rdfs:comment":"Legal, social, or ethical principles of freedom or entitlement held by gay men.","skos:broader":"https://homosaurus.org/v3/homoit0000276","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh94009215"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000652"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000532","dc:identifier":"homoit0000532","skos:prefLabel":"Gay Roman Catholics","rdfs:comment":"Gay men who are members of the Roman Catholic Church.","skos:broader":"https://homosaurus.org/v3/homoit0001244","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005004587"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayRomanCatholics"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000533","dc:identifier":"homoit0000533","skos:prefLabel":"Gay sensibility","rdfs:comment":"A way of reading and looking at cultural texts (books, movies, television, magazines, etc.) through a gay lens, often including the appropriation of texts otherwise thought of as heterosexual.","skos:related":"https://homosaurus.org/v3/homoit0000777","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000533"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gaySensibility"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000534","dc:identifier":"homoit0000534","skos:prefLabel":"Gay shame","rdfs:comment":"Movement within queer communities that is described as a radical alternative to gay culture being brought into the mainstream; directly posits an alternative view of gay pride events and activities that rejects increasing commercialization, corporate sponsors, and \"safer\" agendas to avoid offending heterosexual supporters and sponsors.","skos:related":["https://homosaurus.org/v3/homoit0000006","https://homosaurus.org/v3/homoit0001561"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000534"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayShame"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000535","dc:identifier":"homoit0000535","skos:prefLabel":"Gay slang","skos:altLabel":"Gay speak","rdfs:comment":"Colloquial or informal language related to gay men or used by gay men.","skos:broader":["https://homosaurus.org/v3/homoit0000487","https://homosaurus.org/v3/homoit0001317"],"skos:related":"https://homosaurus.org/v3/homoit0002230","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gaySlang"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000536","dc:identifier":"homoit0000536","skos:prefLabel":"Gay sons","rdfs:comment":"Sons who identify as gay men.","skos:broader":"https://homosaurus.org/v3/homoit0001329","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gaySons"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000537","dc:identifier":"homoit0000537","skos:prefLabel":"Gay sports clubs","rdfs:comment":"Groups of gay men formed for the purpose of playing sports; includes professional and amateur sports clubs.","skos:broader":"https://homosaurus.org/v3/homoit0000950","skos:related":"https://homosaurus.org/v3/homoit0001931","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000836"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gaySportsClubs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000836","dc:identifier":"homoit0000836","skos:prefLabel":"LGBTQ+ clubs and organizations","skos:altLabel":["LGBTQ+ clubs","Clubs (LGBTQ)","LGBTQ+ organizations","Organizations (LGBTQ)","Clubs and organizations (LGBTQ)"],"rdfs:comment":"Organized clubs and groups composed primarily of LGBTQ+ people.","skos:narrower":["https://homosaurus.org/v3/homoit0000826","https://homosaurus.org/v3/homoit0000906","https://homosaurus.org/v3/homoit0000950","https://homosaurus.org/v3/homoit0000951","https://homosaurus.org/v3/homoit0003104","https://homosaurus.org/v3/homoit0000856","https://homosaurus.org/v3/homoit0003836","https://homosaurus.org/v3/homoit0003837","https://homosaurus.org/v3/homoit0003838","https://homosaurus.org/v3/homoit0003839","https://homosaurus.org/v3/homoit0003840","https://homosaurus.org/v3/homoit0003841","https://homosaurus.org/v3/homoit0003842","https://homosaurus.org/v3/homoit0003843"],"skos:related":["https://homosaurus.org/v3/homoit0000833","https://homosaurus.org/v3/homoit0000030","https://homosaurus.org/v3/homoit0001061"],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh00003132"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000836"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQClubs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit00