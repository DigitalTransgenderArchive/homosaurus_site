://homosaurus.org/v3/homoit0002029","skos:related":["https://homosaurus.org/v3/homoit0001740","https://homosaurus.org/v3/homoit0001746"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001717"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002035","dc:identifier":"homoit0002035","skos:prefLabel":"Two-Spirit people in the workplace","rdfs:comment":"The presence of Two-Spirit people in the workplace, including acceptance of and issues faced by Two-Spirit workers.","skos:broader":"https://homosaurus.org/v3/homoit0001480","skos:related":"https://homosaurus.org/v3/homoit0002029","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002036","dc:identifier":"homoit0002036","skos:prefLabel":"Intersex people in the workplace","rdfs:comment":"The presence of intersex people in the workplace, including acceptance of and issues faced by intersex workers.","skos:broader":"https://homosaurus.org/v3/homoit0002029","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001717"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002037","dc:identifier":"homoit0002037","skos:prefLabel":"Asexual people in the workplace","rdfs:comment":"The presence of asexual people in the workplace, including acceptance of and issues faced by asexual workers.","skos:broader":"https://homosaurus.org/v3/homoit0002029","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001717"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002038","dc:identifier":"homoit0002038","skos:prefLabel":"Racism","rdfs:comment":"The belief that groups of human beings possess different inherent behavioral traits that correspond to inherited attributes and can be divided based on the superiority of one race over another. This term also encompasses prejudice, discrimination, and antagonism (whether personal or systematic) directed against other people because of their race and its perceived inferiority.","skos:narrower":["https://homosaurus.org/v3/homoit0002194","https://homosaurus.org/v3/homoit0002257"],"skos:related":["https://homosaurus.org/v3/homoit0001902","https://homosaurus.org/v3/homoit0001903","https://homosaurus.org/v3/homoit0001904","https://homosaurus.org/v3/homoit0002269","https://homosaurus.org/v3/homoit0002270","https://homosaurus.org/v3/homoit0002271","https://homosaurus.org/v3/homoit0002272","https://homosaurus.org/v3/homoit0003691","https://homosaurus.org/v3/homoit0003692"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85110266"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0002038"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002039","dc:identifier":"homoit0002039","skos:prefLabel":"Feminist theory","skos:altLabel":["Feminist philosophy","Theory of feminism"],"rdfs:comment":"The extension of feminism into theoretical, fictional, or philosophical discourse, often seeking to understand the nature of gender inequity.","skos:broader":"https://homosaurus.org/v3/homoit0001365","skos:narrower":["https://homosaurus.org/v3/homoit0002040","https://homosaurus.org/v3/homoit0002041","https://homosaurus.org/v3/homoit0003444","https://homosaurus.org/v3/homoit0003706"],"skos:related":["https://homosaurus.org/v3/homoit0000437","https://homosaurus.org/v3/homoit0000579","https://homosaurus.org/v3/homoit0001210"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh90002282"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002040","dc:identifier":"homoit0002040","skos:prefLabel":"Female gaze","rdfs:comment":"A term used to describe the depiction of women in media and the arts as subjects with agency and whose perspective a text may be presented from. Often used in contrast to the male gaze.","skos:broader":"https://homosaurus.org/v3/homoit0002039","skos:related":"https://homosaurus.org/v3/homoit0002042","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002041","dc:identifier":"homoit0002041","skos:prefLabel":"Male gaze","rdfs:comment":"A term used to describe the sexualized and objectified depiction of women in media and the arts from the perspective of and for the pleasure of the heterosexual man/male viewer. Originally used solely to describe the heterosexual, cisgender gaze but has since been expanded.","skos:broader":"https://homosaurus.org/v3/homoit0002039","skos:related":"https://homosaurus.org/v3/homoit0002042","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002042","dc:identifier":"homoit0002042","skos:prefLabel":"Queer gaze","rdfs:comment":"A term used to describe the ways LGBTQ+ people create and engage with media and art, in contrast to the male gaze, female gaze, or straight gaze.","skos:broader":"https://homosaurus.org/v3/homoit0001219","skos:related":["https://homosaurus.org/v3/homoit0001149","https://homosaurus.org/v3/homoit0002040","https://homosaurus.org/v3/homoit0002041"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002043","dc:identifier":"homoit0002043","skos:prefLabel":"Feminine of center","skos:altLabel":["FOC","Fem of center","Femme of center"],"rdfs:comment":"Term used to describe individuals whose gender expression is more feminine than androgynous. Generally used as a self-descriptor within LGBTQ+ communities.","skos:broader":"https://homosaurus.org/v3/homoit0000389","skos:related":["https://homosaurus.org/v3/homoit0000440","https://homosaurus.org/v3/homoit0001382","https://homosaurus.org/v3/homoit0001642","https://homosaurus.org/v3/homoit0001652","https://homosaurus.org/v3/homoit0002061"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"V