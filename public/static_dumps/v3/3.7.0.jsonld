 of a child by an adult who has taken on that duty. ","skos:related":["https://homosaurus.org/v3/homoit0000009","https://homosaurus.org/v3/homoit0000010","https://homosaurus.org/v3/homoit0000116","https://homosaurus.org/v3/homoit0000452"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000451"},"dc:replaces":{"@id":"http://homosaurus.org/v2/socialParenthood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000452","dc:identifier":"homoit0000452","skos:prefLabel":"Foster parents","rdfs:comment":"A person or family unit who takes in and cares for a child or children on behalf of the state. ","skos:broader":"https://homosaurus.org/v3/homoit0002372","skos:related":"https://homosaurus.org/v3/homoit0000451","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85051035"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fosterParents"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000453","dc:identifier":"homoit0000453","skos:prefLabel":"Freedom rings","rdfs:comment":"A symbol designed by David Spada that consists of six aluminum rings in colors based on the rainbow flag; typically worn as jewelry.","skos:broader":"https://homosaurus.org/v3/homoit0000954","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000954"},"dc:replaces":{"@id":"http://homosaurus.org/v2/freedomRings"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000454","dc:identifier":"homoit0000454","skos:prefLabel":"Fricatrices","rdfs:comment":"A historical term for lesbians. Only use in a historical context.","skos:broader":"https://homosaurus.org/v3/homoit0000878","skos:related":"https://homosaurus.org/v3/homoit0000556","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fricatrices"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000455","dc:identifier":"homoit0000455","skos:prefLabel":"Friendships","rdfs:comment":"Connections based on affection and trust between two or more people.","skos:broader":"https://homosaurus.org/v3/homoit0001237","skos:narrower":["https://homosaurus.org/v3/homoit0000221","https://homosaurus.org/v3/homoit0000429","https://homosaurus.org/v3/homoit0000591","https://homosaurus.org/v3/homoit0000982","https://homosaurus.org/v3/homoit0001245"],"skos:related":["https://homosaurus.org/v3/homoit0000381","https://homosaurus.org/v3/homoit0000416","https://homosaurus.org/v3/homoit0000417","https://homosaurus.org/v3/homoit0000598","https://homosaurus.org/v3/homoit0000649","https://homosaurus.org/v3/homoit0003505"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85051992"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/friendships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000456","dc:identifier":"homoit0000456","skos:prefLabel":"Frottage","rdfs:comment":"Non-penetrative sex act in which individuals rub parts of their body (usually the genitals) against another person's body. Not to be confused with \"frotteurism\" (nonconsensual frottage), though both are often abbreviated as \"frot.\"","skos:broader":["https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001299"],"skos:narrower":"https://homosaurus.org/v3/homoit0001667","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97004942"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/frottage"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000457","dc:identifier":"homoit0000457","skos:prefLabel":"FtXs","rdfs:comment":"People who transition from female to unknown or not female.","skos:broader":"https://homosaurus.org/v3/homoit0001378","skos:related":["https://homosaurus.org/v3/homoit0000436","https://homosaurus.org/v3/homoit0000986","https://homosaurus.org/v3/homoit0001027","https://homosaurus.org/v3/homoit0001518"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ftxs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000458","dc:identifier":"homoit0000458","skos:prefLabel":"Fuck buddies","rdfs:comment":"Two friends who regularly have sex with one another but are not committed to a romantic relationship.","skos:related":["https://homosaurus.org/v3/homoit0000895","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001302"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000458"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fuckBuddies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000459","dc:identifier":"homoit0000459","skos:prefLabel":"Fucking","rdfs:comment":"Slang term (typically regarded as vulgar) for the sexual act of penetrating another individual’s mouth, anus, or vagina with a penis or dildo. May also be used to describe sex acts in general (e.g., \"They were fucking.\").","skos:broader":["https://homosaurus.org/v3/homoit0000280","https://homosaurus.org/v3/homoit0001109","https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001487"],"skos:narrower":"https://homosaurus.org/v3/homoit0000076","skos:related":["https://homosaurus.org/v3/homoit0000588","https://homosaurus.org/v3/homoit0000662","https://homosaurus.org/v3/homoit0003107"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fucking"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000460","dc:identifier":"homoit0000460","skos:prefLabel":"G-spot","rdfs:comment":"Commonly characterized as an erogenous area of the front anterior wall of the vagina that, when stimulated, can lead to sexual arousal, orgasms, and/or ejaculation.","skos:broader":["https://homosaurus.org/v3/homoit0000282","https://homosaurus.org/v3/homoit0001488"],"skos:related":"https://homosaurus.org/v3/homoit0001062","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002802"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000401"},"dc:replaces":{"@id":"http://homosaurus.org/v2/g-spot"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000461","dc:identifier":"homoit0000461","skos:prefLabel":"Galli","rdfs:comment":"A term originating in Ancient Rome that describes eunuch priestesses who were voluntarily castrated as part of an annual celebration.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/galli"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000462","dc:identifier":"homoit0000462","skos:prefLabel":"Gay activism","rdfs:comment":"Direct action and organizing to achieve political or social change and acceptance for gay men.","skos:broader":"https://homosaurus.org/v3/homoit0000006","skos:related":"https://homosaurus.org/v3/homoit0000518","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayActivism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000463","dc:identifier":"homoit0000463","skos:prefLabel":"African American gay men","skos:altLabel":["Gay African American people","Gay African Americans"],"rdfs:comment":"Gay men of African descent born in the United States or gay men born in African countries who live in or have a strong connection to the United States. Use for individuals who self-identity as African American. Follow the individual’s preference for African American or Black whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000015","skos:related":"https://homosaurus.org/v3/homoit0000365","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2003003398"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayAfricanAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000464","dc:identifier":"homoit0000464","skos:prefLabel":"Afro-Canadian gay men","skos:altLabel":["Gay Afro-Canadian people","Gay Afro-Canadians"],"rdfs:comment":"Gay men of African descent born in Canada or gay men born in African countries who live in or have a strong connection to Canada. Use for individuals who self-identify as Afro-Canadian.","skos:broader":"https://homosaurus.org/v3/homoit0000016","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayAfroCanadians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000465","dc:identifier":"homoit0000465","skos:prefLabel":"Afro-Caribbean gay men","skos:altLabel":["Gay Afro-Caribbean men","Gay Afro-Caribbeans"],"rdfs:comment":"Gay men of African descent born in the Caribbean or gay men born in African countries who live in or have a strong connection to the Caribbean. Only use for individuals who self-identify as Afro-Caribbean.","skos:broader":"https://homosaurus.org/v3/homoit0000017","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayAfroCaribbeans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000466","dc:identifier":"homoit0000466","skos:prefLabel":"Afro-European gay men","skos:altLabel":["Gay Afro-European men","Gay Afro-Europeans"],"rdfs:comment":"Gay men of African descent born in European countries or gay men born in African countries who live in or have a strong connection to Europe. Only use for individuals who self-identify as Afro-European.","skos:broader":"https://homosaurus.org/v3/homoit0000018","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayAfroEuropeans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000467","dc:identifier":"homoit0000467","skos:prefLabel":"Afro-Latin American gay men","skos:altLabel":["Gay Afro-Latin American men","Gay Afro-Latin Americans"],"rdfs:comment":"Gay men of African descent born in Latin American countries or gay men born in African countries who live in or have a strong connection to Latin America. Only use for individuals who self-identify as Afro-Latin American.","skos:broader":"https://homosaurus.org/v3/homoit0000019","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayAfroLatinAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0000468","dc:identifier":"homoit0000468","skos:prefLabel":"Gay and lesbian youth","skos:altLabel":"Lesbian and gay youth","rdfs:comment":"Younger gay men and lesbians, typically between the ages of childhood and adulthood or adolescence","skos:broader":["https://homosaurus.org/v3/homoit0001215","https://homosaurus.org/v3/homoit0001521"],"skos:narrower":["https://homosaurus.org/v3/homoit0000479","https://homosaurus.org/v3/homoit0000743","https://homosaurus.org/v3/homoit0001145","https://homosaurus.org/v3/homoit0001479"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000544"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayAndLesbianYouth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000469","dc:identifier":"homoit0000469","skos:prefLabel":"Gay archives","rdfs:comment":"Collections of records and materials relating to gay men or gay communities; can include a variety of organizations and institutions from community to government archives.","skos:broader":"https://homosaurus.org/v3/homoit0000066","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayArchives"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000470","dc:identifier":"homoit0000470","skos:prefLabel":"Gay artists","rdfs:comment":"Gay men who practice any of various creative arts.","skos:broader":"https://homosaurus.org/v3/homoit0000070","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh92001225"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayArtists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000471","dc:identifier":"homoit0000471","skos:prefLabel":"Asian American gay men","skos:altLabel":["Gay Asian American people","Gay Asian Americans"],"rdfs:comment":"Gay men of Asian heritage or descent born in the United States or born in Asian countries who live in or have a strong connection to the United States. Only use for individuals who self-identify as Asian American.","skos:broader":["https://homosaurus.org/v3/homoit0000073","https://homosaurus.org/v3/homoit0000472"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008009912"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayAsianAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000472","dc:identifier":"homoit0000472","skos:prefLabel":"Asian gay men","skos:altLabel":["Gaysians","Gay Asians"],"rdfs:comment":"Gay men of Asian heritage or descent, living in Asia or part of the Asian diaspora. Only use for people who self-identify as Asian.","skos:broader":"https://homosaurus.org/v3/homoit0000074","skos:narrower":"https://homosaurus.org/v3/homoit0000471","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayAsians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000473","dc:identifier":"homoit0000473","skos:prefLabel":"Gay atheists","rdfs:comment":"Gay men who are atheists.","skos:broader":"https://homosaurus.org/v3/homoit0000082","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayAtheists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000474","dc:identifier":"homoit0000474","skos:prefLabel":"Gay bars","rdfs:comment":"Drinking establishments that primarily cater to gay men.","skos:broader":"https://homosaurus.org/v3/homoit0000100","skos:narrower":"https://homosaurus.org/v3/homoit0003718","skos:related":["https://homosaurus.org/v3/homoit0000087","https://homosaurus.org/v3/homoit0000485","https://homosaurus.org/v3/homoit0000925","https://homosaurus.org/v3/homoit0001553"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85053577"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayBars"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000475","dc:identifier":"homoit0000475","skos:prefLabel":"Gay saunas","skos:altLabel":["Gay bathhouses","Gay baths"],"rdfs:comment":"Commercial saunas or bathhouses intended for gay men to meet and engage in sexual activities.","skos:broader":["https://homosaurus.org/v3/homoit0000011","https://homosaurus.org/v3/homoit0000909","https://homosaurus.org/v3/homoit0000974"],"skos:narrower":"https://homosaurus.org/v3/homoit0000595","skos:related":["https://homosaurus.org/v3/homoit0001142","https://homosaurus.org/v3/homoit0001270","https://homosaurus.org/v3/homoit0002382","https://homosaurus.org/v3/homoit0003079"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005020503"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gaySaunas"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000476","dc:identifier":"homoit0000476","skos:prefLabel":"Gay beaches","rdfs:comment":"Beaches set aside for use by gay men or beaches known to be frequented by gay men.","skos:broader":"https://homosaurus.org/v3/homoit0000104","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayBeaches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000477","dc:identifier":"homoit0000477","skos:prefLabel":"Black gay men","skos:altLabel":"Gay Black men","rdfs:comment":"Black men who are gay. Use only for individuals who self-identity as Black. Follow the individual’s preference for African American or Black whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000208","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2004002160"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayBlackPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000478","dc:identifier":"homoit0000478","skos:prefLabel":"Gay bookshops","rdfs:comment":"Bookshops that sell materials intended for use by gay men or addressing topics related to gay men.","skos:broader":"https://homosaurus.org/v3/homoit0000216","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000216"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayBookshops"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000479","dc:identifier":"homoit0000479","skos:prefLabel":"Gay boys","rdfs:comment":"Boys (typically children younger than 18) who are gay.","skos:broader":["https://homosaurus.org/v3/homoit0000220","https://homosaurus.org/v3/homoit0000544"],"skos:related":["https://homosaurus.org/v3/homoit0000481","https://homosaurus.org/v3/homoit0000496","https://homosaurus.org/v3/homoit0000506","https://homosaurus.org/v3/homoit0002363"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayBoys"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000480","dc:identifier":"homoit0000480","skos:prefLabel":"Gay Buddhists","rdfs:comment":"Gay men who are Buddhist.","skos:broader":"https://homosaurus.org/v3/homoit0000225","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2011004972"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@