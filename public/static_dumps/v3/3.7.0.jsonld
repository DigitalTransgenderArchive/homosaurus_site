3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002968","dc:identifier":"homoit0002968","skos:prefLabel":"Intersex community centers","skos:altLabel":"Intersex community centres","rdfs:comment":"Spaces in which people from intersex communities meet for social, education, recreational, or organizing activities.","skos:broader":"https://homosaurus.org/v3/homoit0000298","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000830"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002969","dc:identifier":"homoit0002969","skos:prefLabel":"Intersex couples","rdfs:comment":"Partnerships in which both people are intersex.","skos:broader":["https://homosaurus.org/v3/homoit0000310","https://homosaurus.org/v3/homoit0002939"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001237"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0002970","dc:identifier":"homoit0002970","skos:prefLabel":"Intersex culture","rdfs:comment":"Cultural experiences shared by members of intersex communities or products of intersex culture (e.g., art and media created by and for intersex people, activism focused on intersex issues, slang commonly used in intersex communities, etc.).","skos:broader":"https://homosaurus.org/v3/homoit0001831","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@i