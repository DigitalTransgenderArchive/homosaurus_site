ic communication, images, ideas, or other information by institutions, authorities, or other controlling bodies, typically because the material has been deemed objectionable, harmful, or sensitive. ","skos:narrower":"https://homosaurus.org/v3/homoit0000829","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85021828"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000245"},"dc:replaces":{"@id":"http://homosaurus.org/v2/censorship"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000246","dc:identifier":"homoit0000246","skos:prefLabel":"Chakka","rdfs:comment":"Derogatory term for a third gender person in Karnataka culture in India.","skos:broader":["https://homosaurus.org/v3/homoit0000322","https://homosaurus.org/v3/homoit0001560"],"skos:related":"https://homosaurus.org/v3/homoit0000632","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/chakka"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000247","dc:identifier":"homoit0000247","skos:prefLabel":"Legal name change","skos:altLabel":"Change of name","rdfs:comment":"The process by which an individual adopts a new name on legal or government-issued documents.","skos:broader":["https://homosaurus.org/v3/homoit0000918","https://homosaurus.org/v3/homoit0001053"],"skos:related":["https://homosaurus.org/v3/homoit0000119","https://homosaurus.org/v3/homoit0000377","https://homosaurus.org/v3/homoit0000711","https://homosaurus.org/v3/homoit0000990","https://homosaurus.org/v3/homoit0001092","https://homosauru