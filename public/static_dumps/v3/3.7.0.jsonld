/homoit0001299"},"dc:replaces":{"@id":"http://homosaurus.org/v2/groupSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000604","dc:identifier":"homoit0000604","skos:prefLabel":"Güevedoce","skos:altLabel":"Guevedoche","rdfs:comment":"In the Dominican Republic, this term refers to people who have undifferentiated genitalia and who are generally raised as female until puberty; may be considered a third gender.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/guevedoche"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000605","dc:identifier":"homoit0000605","skos:prefLabel":"Hair","rdfs:comment":"Threadlike strands of keratin growing out of the skin on the body. Use in reference to hair as a secondary sex characteristic or as a form of self expression.","skos:broader":"https://homosaurus.org/v3/homoit0001259","skos:narrower":"https://homosaurus.org/v3/homoit0002287","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85058305"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hair"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000606","dc:identifier":"homoit0000606","skos:prefLabel":"Hair removal","skos:altLabel":["Shaving","Waxing"],"rdfs:comment":"The process of removing hair from the body through shaving, waxing, depilatories, laser hair removal, etc. May have a social component related to gender identity and/or have an erotic component.","skos:broader":"https://homosaurus.org/v3/homoit0000568","skos:related":["https://homosaurus.org/v3/homoit0001465","https://homosaurus.org/v3/homoit0003049"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85058312"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hairRemoval"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000607","dc:identifier":"homoit0000607","skos:prefLabel":"Halloween (LGBTQ+ culture)","skos:altLabel":["Gay Christmas","Gay Halloween"],"rdfs:comment":"The celebration of Halloween, often called Gay Christmas, by LGBTQ+ people. Typically involves dressing in drag or elaborate costumes as a form of gender play and attending large parties in LGBTQ+ neighborhoods or establishments.","skos:broader":"https://homosaurus.org/v3/homoit0000861","skos:related":"https://homosaurus.org/v3/homoit0001808","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85058475"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000861"},"dc:replaces":{"@id":"http://homosaurus.org/v2/halloween"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000608","dc:identifier":"homoit0000608","skos:prefLabel":"Handcuffs","skos:altLabel":"Handcuff restraints","rdfs:comment":"A restraint device designed to secure an individual’s 