f puberty may vary)","skos:broader":["https://homosaurus.org/v3/homoit0000442","https://homosaurus.org/v3/homoit0001300"],"skos:narrower":"https://homosaurus.org/v3/homoit0000442","skos:related":"https://homosaurus.org/v3/homoit0000663","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000404"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000442"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hebephilia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-22"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000616","dc:identifier":"homoit0000616","skos:prefLabel":"Hemaneh","rdfs:comment":"Cheyenne term for a half-man, half-woman persona.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hemaneh"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000617","dc:identifier":"homoit0000617","skos:prefLabel":"Herbal treatments","rdfs:comment":"The use of plants to improve health, prevent disease, and/or treat illness.","skos:broader":"https://homosaurus.org/v3/homoit0001366","skos:related":["https://homosaurus.org/v3/homoit0001047","https://homosaurus.org/v3/homoit0001049"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85060354"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/herbalTreatments"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000618","dc:identifier":"homoit0000618","skos:prefLabel":"Intersex people","skos:altLabel":["Hermaphrodites","Intersexuals","Hermaphroditic people","Intersex-identified people","Intersexual people"],"rdfs:comment":"Individuals born with variations in their genitalia, hormones, internal anatomy, and/or chromosomes that do not fully or exclusively conform to medical or social expectations for males or females. Only use to describe people who describe themselves as intersex.","skos:broader":"https://homosaurus.org/v3/homoit0000915","skos:narrower":["https://homosaurus.org/v3/homoit0000668","https://homosaurus.org/v3/homoit0000674","https://homosaurus.org/v3/homoit0002825","https://homosaurus.org/v3/homoit0003039","https://homosaurus.org/v3/homoit0003225"],"skos:related":["https://homosaurus.org/v3/homoit0000046","https://homosaurus.org/v3/homoit0000352","https://homosaurus.org/v3/homoit0000669","https://homosaurus.org/v3/homoit0000670","https://homosaurus.org/v3/homoit0000671","https://homosaurus.org/v3/homoit0000672","https://homosaurus.org/v3/homoit0000673","https://homosaurus.org/v3/homoit0001759","https://homosaurus.org/v3/homoit0001763","https://homosaurus.org/v3/homoit0001767","https://homosaurus.org/v3/homoit0001822","https://homosaurus.org/v3/homoit0002744"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007003860"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000619","dc:identifier":"homoit0000619","skos:prefLabel":"Heterosexism","skos:altLabel":"Heterocentrism","rdfs:comment":"Discrimination, prejudice, or bias against non-heterosexual people based on the assumption or belief that heterosexuality is the only normal or natural expression of sexual identity.","skos:related":["https://homosaurus.org/v3/homoit0000117","https://homosaurus.org/v3/homoit0000411","https://homosaurus.org/v3/homoit0000620","https://homosaurus.org/v3/homoit0000631","https://homosaurus.org/v3/homoit0000646","https://homosaurus.org/v3/homoit0000666","https://homosaurus.org/v3/homoit0000803","https://homosaurus.org/v3/homoit0001229","https://homosaurus.org/v3/homoit0001278","https://homosaurus.org/v3/homoit0001467"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002513"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000619"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000620","dc:identifier":"homoit0000620","skos:prefLabel":"Heteronormativity","skos:altLabel":"Heterosexual norms","rdfs:comment":"The notion or belief that heterosexuality is the normal or preferred sexual orientation.","skos:broader":"https://homosaurus.org/v3/homoit0001323","skos:related":["https://homosaurus.org/v3/homoit0000080","https://homosaurus.org/v3/homoit0000619","https://homosaurus.org/v3/homoit0000644","https://homosaurus.org/v3/homoit0003445"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002513"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001323"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heteronormativity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0001323","dc:identifier":"homoit0001323","skos:prefLabel":"Social norms","rdfs:comment":"Group-held beliefs about how members of that group should behave in a given context.","skos:narrower":["https://homosaurus.org/v3/homoit0000620","https://homosaurus.org/v3/homoit0000644","https://homosaurus.org/v3/homoit0001532","https://homosaurus.org/v3/homoit0001535","https://homosaurus.org/v3/homoit0001555"],"skos:related":["https://homosaurus.org/v3/homoit0000080","https://homosaurus.org/v3/homoit0000643","https://homosaurus.org/v3/homoit0001241"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85123980"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001323"},"dc:replaces":{"@id":"http://homosaurus.org/v2/socialNorms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000621","dc:identifier":"homoit0000621","skos:prefLabel":"Heterosexual boys","skos:altLabel":"Straight boys","rdfs:comment":"Boys (typically children or youth younger than 18) who are heterosexual.","skos:broader":["https://homosaurus.org/v3/homoit0000220","https://homosaurus.org/v3/homoit0000630","https://homosaurus.org/v3/homoit0002285"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexualBoys"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000622","dc:identifier":"homoit0000622","skos:prefLabel":"Heterosexual feminism","rdfs:comment":"A form of feminism that prioritizes the experiences of heterosexual women and focuses on securing equitable economic, political, and social rights for heterosexual women. Often discussed in juxtaposition to political lesbianism.","skos:broader":"https://homosaurus.org/v3/homoit0000437","skos:related":["https://homosaurus.org/v3/homoit0000741","https://homosaurus.org/v3/homoit0001133"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000437"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexualFeminism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000623","dc:identifier":"homoit0000623","skos:prefLabel":"Heterosexual girls","skos:altLabel":"Straight girls","rdfs:comment":"Girls (typically children or youth younger than 18) who are heterosexual.","skos:broader":["https://homosaurus.org/v3/homoit0000590","https://homosaurus.org/v3/homoit0000630","https://homosaurus.org/v3/homoit0002285"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexualGirls"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000624","dc:identifier":"homoit0000624","skos:prefLabel":"Heterosexual identity","rdfs:comment":"Term used to describe the sexual identity of individuals who are romantically and/or sexually attracted to people assigned the “opposite” sex at birth.","skos:broader":"https://homosaurus.org/v3/homoit0001295","skos:related":"https://homosaurus.org/v3/homoit0000627","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexualIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000625","dc:identifier":"homoit0000625","skos:prefLabel":"Heterosexual marriage","rdfs:comment":"The legally and formally recognized union of a heterosexual man and woman as partners in a personal relationship.","skos:broader":"https://homosaurus.org/v3/homoit0000990","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexualMarriage"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000626","dc:identifier":"homoit0000626","skos:prefLabel":"Heterosexual men","skos:altLabel":"Straight men","rdfs:comment":"Men who identify as heterosexual, or straight.","skos:broader":["https://homosaurus.org/v3/homoit0000627","https://homosaurus.org/v3/homoit0001008"],"skos:narrower":["https://homosaurus.org/v3/homoit0000381","https://homosaurus.org/v3/homoit0000417"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93003542"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000627"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexualMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000628","dc:identifier":"homoit0000628","skos:prefLabel":"Heterosociality","skos:altLabel":["Heterosexual social relationships","Heterosocial bonds"],"rdfs:comment":"In sociology, this term is used to describe social relations and bonds between members of the opposite sex or gender in a given culture. Typically excludes romantic and sexual relationships.","skos:broader":"https://homosaurus.org/v3/homoit0001237","skos:related":"https://homosaurus.org/v3/homoit0000649","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosociality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000629","dc:identifier":"homoit0000629","skos:prefLabel":"Heterosexual women","skos:altLabel":"Straight women","rdfs:comment":"Women who identify as heterosexual, or straight.","skos:broader":["https://homosaurus.org/v3/homoit0000627","https://homosaurus.org/v3/homoit0001509"],"skos:narrower":["https://homosaurus.org/v3/homoit0000416","https://homosaurus.org/v3/homoit0000598"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93003545"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000627"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexualWomen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000630","dc:identifier":"homoit0000630","skos:prefLabel":"Heterosexual youth","skos:altLabel":["Straight youth","Heterosexual adolescents","Heterosexual teenagers","Heterosexual teens","Straight adolescents","Straight teenagers","Straight teens"],"rdfs:comment":"Heterosexual people between the ages of childhood and adulthood.","skos:broader":["https://homosaurus.org/v3/homoit0000627","https://homosaurus.org/v3/homoit0001520"],"skos:narrower":["https://homosaurus.org/v3/homoit0000621","https://homosaurus.org/v3/homoit0000623","https://homosaurus.org/v3/homoit0002285"],"skos:related":"https://homosaurus.org/v3/homoit0001521","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000627"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexualYouth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000631","dc:identifier":"homoit0000631","skos:prefLabel":"Heterosexuality","rdfs:comment":"Romantic and sexual attraction to members of the opposite sex or gender, typically in a culture that understands sex and gender through the binary opposition of male/female or man/woman.","skos:broader":["https://homosaurus.org/v3/homoit0001298","https://homosaurus.org/v3/homoit0001556"],"skos:related":["https://homosaurus.org/v3/homoit0000619","https://homosaurus.org/v3/homoit0000627","https://homosaurus.org/v3/homoit0000647","https://homosaurus.org/v3/homoit0003445"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93008585"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000632","dc:identifier":"homoit0000632","skos:prefLabel":"Hijras","skos:altLabel":"Jagappa","rdfs:comment":"Hindi word used in South Asia to refer to people assigned male at birth who identify as women or “not-men.”","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":["https://homosaurus.org/v3/homoit0000065","https://homosaurus.org/v3/homoit0000240","https://homosaurus.org/v3/homoit0000246","https://homosaurus.org/v3/homoit0000684","https://homosaurus.org/v3/homoit0000688","https://homosaurus.org/v3/homoit0000690","https://homosaurus.org/v3/homoit0000694"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hijra"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000633","dc:identifier":"homoit0000633","skos:prefLabel":"LGBTQ+ Hindus","skos:altLabel":["Hindus (LGBTQ)","LGBTQ Hindus"],"rdfs:comment":"LGBTQ+ people who are Hindu.","skos:broader":"https://homosaurus.org/v3/homoit0000928","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQHindus"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000634","dc:identifier":"homoit0000634","skos:prefLabel":"HIV tests","rdfs:comment":"Medical tests used to determine the presence of HIV antibodies or antigens in an individual's blood, saliva, or urine.","skos:related":"https://homosaurus.org/v3/homoit0000005","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000634"},"dc:replaces":{"@id":"http://homosaurus.org/v2/HIVTests"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000635","dc:identifier":"homoit0000635","skos:prefLabel":"HIV-negative people","skos:altLabel":"HIV-seronegative people","rdfs:comment":"Individuals who have not contracted HIV.","skos:related":["https://homosaurus.org/v3/homoit0000005","https://homosaurus.org/v3/homoit0000636","https://homosaurus.org/v3/homoit0000638","https://homosaurus.org/v3/homoit0000639","https://homosaurus.org/v3/homoit0000640"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000635"},"dc:replaces":{"@id":"http://homosaurus.org/v2/HIV-negativePeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000636","dc:identifier":"homoit0000636","skos:prefLabel":"HIV-positive people","skos:altLabel":"HIV-seropositive people","rdfs:comment":"People who have contracted HIV.","skos:narrower":"https://homosaurus.org/v3/homoit0000640","skos:related":["https://homosaurus.org/v3/homoit0000005","https://homosaurus.org/v3/homoit0000226","https://homosaurus.org/v3/homoit0000635","https://homosaurus.org/v3/homoit0000638","https://homosaurus.org/v3/homoit0000639"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh95001199"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/HIV-positivePeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000637","dc:identifier":"homoit0000637","skos:prefLabel":"Seroconversion","skos:altLabel":"HIV-seroconversion","rdfs:comment":"Term used to describe the period of time between exposure to a virus and when antibodies for the virus are detectable; often used in reference to HIV testing when a test changes from HIV negative to HIV positive.","skos:related":"https://homosaurus.org/v3/homoit0000005","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000637"},"dc:replaces":{"@id":"http://homosaurus.org/v2/seroconversion"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000638","dc:identifier":"homoit0000638","skos:prefLabel":"Serodiscordant couples","skos:altLabel":"HIV-serodiscordant couples","rdfs:comment":"Partnerships in which one person has HIV and the other does not.","skos:related":["https://homosaurus.org/v3/homoit0000635","https://homosaurus.org/v3/homoit0000636"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000638"},"dc:replaces":{"@id":"http://homosaurus.org/v2/serodiscordantCouples"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000639","dc:identifier":"homoit0000639","skos:prefLabel":"Serostatus","skos:altLabel":"HIV-serostatus","rdfs:comment":"The presence (seropositivity) or absence (seronegativity) of antibodies in blood serum; commonly used in in reference to HIV testing.","skos:related":["https://homosaurus.org/v3/homoit0000005","https://homosaurus.org/v3/homoit0000635","https://homosaurus.org/v3/homoit0000636","https://homosaurus.org/v3/homoit0000640"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000639"},"dc:replaces":{"@id":"http://homosaurus.org/v2/serostatus"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000640","dc:identifier":"homoit0000640","skos:prefLabel":"HIV-undetectable people","rdfs:comment":"People who have contracted HIV and received treatment to reduce their HIV antibodies to an amount that can no longer be detected by standard HIV tests.","skos:broader":"https://homosaurus.org/v3/homoit0000636","skos:related":["https://homosaurus.org/v3/homoit0000005","https://homosaurus.org/v3/homoit0000635","https://homosaurus.org/v3/homoit0000639"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/HIVUndetectablePeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000641","dc:identifier":"homoit0000641","skos:prefLabel":"Murders of LGBTQ+ people","skos:altLabel":["Homicides of LGBTQ people","Murders of LGBTQ people"],"rdfs:comment":"Intentional killing of LGBTQ+ people due to their gender and/or sexual identities.","skos:broader":"https://homosaurus.org/v3/homoit0000059","skos:related":"https://homosaurus.org/v3/homoit0000109","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/murdersOfLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000642","dc:identifier":"homoit0000642","skos:prefLabel":"LGBTQ+ monuments","skos:altLabel":["Homomonuments","Monuments (LGBTQ)"],"rdfs:comment":"Public monuments designed to commemorate LGBTQ+ people who have been persecuted because of their gender and/or sexual identities.","skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh99004297"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000642"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000901"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homomonuments"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000643","dc:identifier":"homoit0000643","skos:prefLabel":"Homonationalism","rdfs:comment":"Favorable association between a nationalist ideology and LGBTQ+ people or their rights.","skos:related":["https://homosaurus.org/v3/homoit0000112","https://homosaurus.org/v3/homoit0001117","https://homosaurus.org/v3/homoit0001323"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000643"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homonationalism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000644","dc:identifier":"homoit0000644","skos:prefLabel":"Homonormativity","skos:altLabel":"Homosexual norms","rdfs:comment":"The projection of heteronormative ideals and constructs onto LGBTQ+ cultures and identities, predicated on the assumption that LGBTQ+ people (particularly cisgender gay men and lesbians) must conform to the norms and values of heterosexuality (e.g., the gender binary, marriage, procreation, and monogamy) in order to be viewed as \"normal\" and gain social acceptance. ","skos:broader":"https://homosaurus.org/v3/homoit0001323","skos:related":["https://homosaurus.org/v3/homoit0000080","https://homosaurus.org/v3/homoit0000620"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001323"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homonormativity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000645","dc:identifier":"homoit0000645","skos:prefLabel":"Homophiles","rdfs:comment":"Outdated term for lesbians and gay men. The use of the word began to disappear with the emergence of the gay liberation movement of the late 1960s and early 1970s.","skos:broader":"https://homosaurus.org/v3/homoit0000878","skos:related":"https://homosaurus.org/v3/homoit0001297","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homophiles"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000646","dc:identifier":"homoit0000646","skos:prefLabel":"Homophobia","rdfs:comment":"Antagonism or disgust directed towards homosexuality as an identity or men who are perceived to be or are actually gay. Homophobia can include denial of the existence of homosexuality, stereotypes, verbal harassment, and physical violence. This term is often used colloquially to encompass all LGBTQ+ phobia.","skos:broader":"https://homosaurus.org/v3/homoit0000920","skos:narrower":["https://homosaurus.org/v3/homoit0000391","https://homosaurus.org/v3/homoit0002174"],"skos:related":["https://homosaurus.org/v3/homoit0000055","https://homosaurus.org/v3/homoit0000056","https://homosaurus.org/v3/homoit0000506","https://homosaurus.org/v3/homoit0000619"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88006552"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homophobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000647","dc:identifier":"homoit0000647","skos:prefLabel":"Homosexuality","rdfs:comment":"Sexual orientation with sexual and/or romantic attraction to individuals of the same sex.","skos:broader":["https://homosaurus.org/v3/homoit0001298","https://homosaurus.org/v3/homoit0001556"],"skos:narrower":"https://homosaurus.org/v3/homoit0001240","skos:related":["https://homosaurus.org/v3/homoit0000204","https://homosaurus.org/v3/homoit0000506","https://homosaurus.org/v3/homoit0000556","https://homosaurus.org/v3/homoit0000631","https://homosaurus.org/v3/homoit0000799"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85061780"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homosexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000648","dc:identifier":"homoit0000648","skos:prefLabel":"Homosexuals","rdfs:comment":"Outdated term for lesbians and gay men.","skos:broader":"https://homosaurus.org/v3/homoit0000878","skos:related":["https://homosaurus.org/v3/homoit0001297","https://homosaurus.org/v3/homoit0001531","https://homosaurus.org/v3/homoit0001915"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85061795"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homosexuals"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000649","dc:identifier":"homoit0000649","skos:prefLabel":"Homosociality","skos:altLabel":"Homosocial bonds","rdfs:comment":"A concept used to describe the social bonds that exist between members of the same sex or gender in a given culture.","skos:narrower":["https://homosaurus.org/v3/homoit0000221","https://homosaurus.org/v3/homoit0000429","https://homosaurus.org/v3/homoit0000591","https://homosaurus.org/v3/homoit0000982"],"skos:related":["https://homosaurus.org/v3/homoit0000455","https://homosaurus.org/v3/homoit0000628","https://homosaurus.org/v3/homoit0000981"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000649"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homosociality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000650","dc:identifier":"homoit0000650","skos:prefLabel":"Hormone blockers","rdfs:comment":"Medications used to block the body from producing certain hormones in order to replace or supplement them with other types of hormones.","skos:broader":["https://homosaurus.org/v3/homoit0000317","https://homosaurus.org/v3/homoit0001007"],"skos:narrower":"https://homosaurus.org/v3/homoit0001138","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85061977"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hormoneBlockers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000651","dc:identifier":"homoit0000651","skos:prefLabel":"Hormones","rdfs:comment":"Regulatory substances produced in organisms and transported throughout the body to stimulate specific cells or tissues into action. Though hormones regulate digestion, respiration, sleep, and many other bodily functions, the term is most commonly used by the general public to describe the \"sex hormones,\" or the hormones involved in puberty and sexual development, reproduction, and sexual desire.","skos:broader":"https://homosaurus.org/v3/homoit0001269","skos:narrower":["https://homosaurus.org/v3/homoit0000407","https://homosaurus.org/v3/homoit0001362","https://homosaurus.org/v3/homoit0002820"],"skos:related":"https://homosaurus.org/v3/homoit0002876","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85061980"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hormones"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000653","dc:identifier":"homoit0000653","skos:prefLabel":["Sexual sterilization","Sexual sterilisation"],"rdfs:comment":"Refers to any type of medical treatment that intentionally leaves an individual sterile or unable to reproduce. This term encompasses both voluntary and involuntary sterilization.","skos:related":"https://homosaurus.org/v3/homoit0000430","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85128029"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000653"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualSterilisation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000654","dc:identifier":"homoit0000654","skos:prefLabel":"Hwame","rdfs:comment":"In Native American Mohave tribes, hwame are people assigned female at birth who exhibit masculine traits and are socially male.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":["https://homosaurus.org/v3/homoit0000039","https://homosaurus.org/v3/homoit0001480"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hwame"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000655","dc:identifier":"homoit0000655","skos:prefLabel":"Machismo","rdfs:comment":"Term originating in the early 1930s and 40s to describe a man's responsibility and pride in providing for, protecting, and defending his family. It is unclear whether the term originates in Spain or Portugal. Though there are positive sides of machismo and it remains an important part of Iberian and Latin American cultures, the concept has also been criticized for its perceived role in perpetuating misogyny, harmful gender roles, and domestic and sexual violence.","skos:broader":"https://homosaurus.org/v3/homoit0000577","skos:related":["https://homosaurus.org/v3/homoit0000978","https://homosaurus.org/v3/homoit0000995","https://homosaurus.org/v3/homoit0001377"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88006590"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001241"},"dc:replaces":{"@id":"http://homosaurus.org/v2/machismo"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000656","dc:identifier":"homoit0000656","skos:prefLabel":"Hypersexuality","skos:altLabel":["Nymphomania","Satyriasis","Andromania","Clitoromania","Don Juan syndrome","Don Juanism","Estromania","Excessive sex drive","Furor amatorius","Furor uterinus","Hyper-sexuality","Hyperactive sexual desire disorder","Hyperaesthesia","Hypereroticism","Hyperlibido","Hyperphilia","Hypersensuality","Hypersexual disorder","Messalina syndrome","Œstromania","Oversexuality","Satyrism","Satyromania","Sexual hyperesthesia","Sexual hyperversion"],"rdfs:comment":"Term used to describe a level or frequency of sexual desire that is perceived as excessive within a given culture. Though the medical community has not reached a consensus as to whether hypersexuality should be included as a clinical diagnosis, doctors and psychologists have historically diagnosed LGBTQ+ people with hypersexuality (or other related labels) in order to wrongly treat their identities and desires as medical disorders. Should only be used in a historical context or if an individual self-identifies with the term.","skos:narrower":"https://homosaurus.org/v3/homoit0001284","skos:related":["https://homosaurus.org/v3/homoit0001283","https://homosaurus.org/v3/homoit0001306","https://homosaurus.org/v3/homoit0001538"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000656"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hypersexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000657","dc:identifier":"homoit0000657","skos:prefLabel":"Hypospadias","rdfs:comment":"People with hypospadias are born with their urinary opening located somewhere other than the tip of the penis. In \"distal hypospadias,\" the urinary opening is elsewhere on the glans (head) of the penis, whereas in \"proximal hypospadias,\" it is on the underside of the penis and sometimes further back near the scrotum. Hypospadias is one of the most common and visible genital variations. People with hypospadias often have additional variations like chordee (a bend in the penis) or cryptorchidism (undescended testicles).","skos:broader":"https://homosaurus.org/v3/homoit0000669","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85063812"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hypospadias"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000658","dc:identifier":"homoit0000658","skos:prefLabel":"Hysterectomy","rdfs:comment":"Surgical procedure to remove the uterus.","skos:broader":"https://homosaurus.org/v3/homoit0000584","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85063844"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hysterectomy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000659","dc:identifier":"homoit0000659","skos:prefLabel":["In vitro fertilization","In vitro fertilisation"],"skos:altLabel":"IVF","rdfs:comment":"Medical practice of achieving fertilization by combining sperm and eggs in laboratory settings to induce pregnancy.","skos:broader":["https://homosaurus.org/v3/homoit0000843","https://homosaurus.org/v3/homoit0002618"],"skos:narrower":"https://homosaurus.org/v3/homoit0001234","skos:related":"https://homosaurus.org/v3/homoit0002629","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85047905"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000864"},"dc:replaces":{"@id":"http://homosaurus.org/v2/inVitroFertilisation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000660","dc:identifier":"homoit0000660","skos:prefLabel":["LGBTQ+ information centers","LGBTQ+ information centres"],"rdfs:comment":"An institution that locates and compiles information for the LGBTQ+ community into a central database that can be accessed by the public.","skos:broader":"https://homosaurus.org/v3/homoit0000830","skos:narrower":["https://homosaurus.org/v3/homoit0000026","https://homosaurus.org/v3/homoit0000147","https://homosaurus.org/v3/homoit0000490","https://homosaurus.org/v3/homoit0000737","https://homosaurus.org/v3/homoit0001179","https://homosaurus.org/v3/homoit0001409","https://homosaurus.org/v3/homoit0002747","https://homosaurus.org/v3/homoit0002793"],"skos:related":["https://homosaurus.org/v3/homoit0000661","https://homosaurus.org/v3/homoit0002696"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/informationCentresLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000662","dc:identifier":"homoit0000662","skos:prefLabel":"Sexual intercourse","rdfs:comment":"Term used to describe sexual activity between two or more people, typically involving penetration. ","skos:broader":["https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001299"],"skos:related":["https://homosaurus.org/v3/homoit0000459","https://homosaurus.org/v3/homoit0000588","https://homosaurus.org/v3/homoit0001342"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120739"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualIntercourse"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000663","dc:identifier":"homoit0000663","skos:prefLabel":"Intergenerational relationships","rdfs:comment":"Ongoing connections (romantic, sexual, play, or platonic) between two or more people of different age groups or from different generations.","skos:broader":"https://homosaurus.org/v3/homoit0001237","skos:related":["https://homosaurus.org/v3/homoit0000020","https://homosaurus.org/v3/homoit0001295","https://homosaurus.org/v3/homoit0001636"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85067264"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intergenerationalRelationships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000664","dc:identifier":"homoit0000664","skos:prefLabel":"Online dating","skos:altLabel":"Internet dating","rdfs:comment":"Utilizing online websites, applications, or forums to meet romantic or sexual partners.","skos:related":["https://homosaurus.org/v3/homoit0000328","https://homosaurus.org/v3/homoit0000329"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2003001798"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000664"},"dc:replaces":{"@id":"http://homosaurus.org/v2/onlineDating"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000665","dc:identifier":"homoit0000665","skos:prefLabel":"Internet forums","rdfs:comment":"Websites designed to facilitate discussion amongst users through posted messages.","skos:broader":"https://homosaurus.org/v3/homoit0001321","skos:narrower":"https://homosaurus.org/v3/homoit0000888","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97004057"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001321"},"dc:replaces":{"@id":"http://homosaurus.org/v2/internetForums"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000666","dc:identifier":"homoit0000666","skos:prefLabel":"Intersexphobia","skos:altLabel":"Interphobia","rdfs:comment":"Antagonism or disgust directed toward intersex people or intersex variations. Intersexphobia can include the denial of the existence of intersex people, insistence that intersex variations should be forcibly \"corrected,\" stereotypes, verbal harassment, and physical violence.","skos:broader":"https://homosaurus.org/v3/homoit0000920","skos:narrower":"https://homosaurus.org/v3/homoit0002595","skos:related":["https://homosaurus.org/v3/homoit0000352","https://homosaurus.org/v3/homoit0000619","https://homosaurus.org/v3/homoit0000670","https://homosaurus.org/v3/homoit0001770","https://homosaurus.org/v3/homoit0001893"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexphobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000667","dc:identifier":"homoit0000667","skos:prefLabel":"Intersectionality","rdfs:comment":"A theoretical framework first conceptualized by Kimberlé Crenshaw to describe how different facets of social identity (such as gender, race, ethnicity, disability, socioeconomic class, religion, and sexual identity) overlap and intersect, often compounding the individual's experiences with inequality and discrimination.","skos:related":["https://homosaurus.org/v3/homoit0000358","https://homosaurus.org/v3/homoit0000860","https://homosaurus.org/v3/homoit0001133","https://homosaurus.org/v3/homoit0002270","https://homosaurus.org/v3/homoit0002271","https://homosaurus.org/v3/homoit0002272","https://homosaurus.org/v3/homoit0002274"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2017003056"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000667"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersectionality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000668","dc:identifier":"homoit0000668","skos:prefLabel":"Intersex children","rdfs:comment":"Children younger than 18 years who describe themselves as intersex.","skos:broader":["https://homosaurus.org/v3/homoit0000256","https://homosaurus.org/v3/homoit0000618","https://homosaurus.org/v3/homoit0000674"],"skos:related":"https://homosaurus.org/v3/homoit0001268","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007005476"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexChildren"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000669","dc:identifier":"homoit0000669","skos:prefLabel":"Intersex variations","skos:altLabel":"Intersex conditions","rdfs:comment":"Term used to refer to a wide range of variations in sex characteristics. The term \"intersex conditions\" is a pathologizing term used to mean people born with variations in their physical sex characteristics also known as intersex traits.","skos:broader":["https://homosaurus.org/v3/homoit0000352","https://homosaurus.org/v3/homoit0001006"],"skos:narrower":["https://homosaurus.org/v3/homoit0000001","https://homosaurus.org/v3/homoit0000044","https://homosaurus.org/v3/homoit0000064","https://homosaurus.org/v3/homoit0000283","https://homosaurus.org/v3/homoit0000301","https://homosaurus.org/v3/homoit0000599","https://homosaurus.org/v3/homoit0000657","https://homosaurus.org/v3/homoit0000692","https://homosaurus.org/v3/homoit0001014","https://homosaurus.org/v3/homoit0001020","https://homosaurus.org/v3/homoit0001066","https://homosaurus.org/v3/homoit0001079","https://homosaurus.org/v3/homoit0001134","https://homosaurus.org/v3/homoit0001354","https://homosaurus.org/v3/homoit0001478","https://homosaurus.org/v3/homoit0002818","https://homosaurus.org/v3/homoit0002819","https://homosaurus.org/v3/homoit0002821","https://homosaurus.org/v3/homoit0002822","https://homosaurus.org/v3/homoit0002823","https://homosaurus.org/v3/homoit0002824","https://homosaurus.org/v3/homoit0002826","https://homosaurus.org/v3/homoit0002828","https://homosaurus.org/v3/homoit0002829","https://homosaurus.org/v3/homoit0002831","https://homosaurus.org/v3/homoit0002832","https://homosaurus.org/v3/homoit0002833","https://homosaurus.org/v3/homoit0002836","https://homosaurus.org/v3/homoit0002837","https://homosaurus.org/v3/homoit0002838","https://homosaurus.org/v3/homoit0002839","https://homosaurus.org/v3/homoit0002842","https://homosaurus.org/v3/homoit0002843","https://homosaurus.org/v3/homoit0002848","https://homosaurus.org/v3/homoit0002861","https://homosaurus.org/v3/homoit0002862","https://homosaurus.org/v3/homoit0002863","https://homosaurus.org/v3/homoit0002864","https://homosaurus.org/v3/homoit0002865","https://homosaurus.org/v3/homoit0002870","https://homosaurus.org/v3/homoit0002871","https://homosaurus.org/v3/homoit0002872","https://homosaurus.org/v3/homoit0002873","https://homosaurus.org/v3/homoit0002875","https://homosaurus.org/v3/homoit0002878","https://homosaurus.org/v3/homoit0002883","https://homosaurus.org/v3/homoit0002885"],"skos:related":["https://homosaurus.org/v3/homoit0000618","https://homosaurus.org/v3/homoit0001268","https://homosaurus.org/v3/homoit0001646"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85060401"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexConditions"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000670","dc:identifier":"homoit0000670","skos:prefLabel":"Intersex genital mutilation","skos:altLabel":"IGM","rdfs:comment":"Surgeries or other medical treatments performed, typically on newborn babies or children, to \"normalize\" the patient's reproductive or sexual anatomy and force their body to conform to medical or social expectations for what is male or female. IGM practices can be performed for cultural, social, or religious reasons. Though they are typically justified through a medical lens, IGM practices are medically unnecessary and non-consensual.","skos:narrower":["https://homosaurus.org/v3/homoit0000281","https://homosaurus.org/v3/homoit0002847"],"skos:related":["https://homosaurus.org/v3/homoit0000352","https://homosaurus.org/v3/homoit0000618","https://homosaurus.org/v3/homoit0000666","https://homosaurus.org/v3/homoit0000673","https://homosaurus.org/v3/homoit0001268"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000670"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexGenitalMutilation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000671","dc:identifier":"homoit0000671","skos:prefLabel":"Intersex identity","rdfs:comment":"Used to describe the experience of selfhood of intersex people. Intersex identity is not gender identity, sexual identity, nor sexual orientation. For the subject of intersex variations, use \"intersex variations\" or \"intersex\". For the subject of intersex people, use \"intersex people\". Do not use in place of gender-identity-related terms such as non-binary identity or genderfluid identity.","skos:related":["https://homosaurus.org/v3/homoit0000352","https://homosaurus.org/v3/homoit0000618"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007005480"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000671"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000672","dc:identifier":"homoit0000672","skos:prefLabel":"Intersex movement","rdfs:comment":"Umbrella term for activism focused on the rights of intersex people and issues faced by intersex communities.","skos:broader":"https://homosaurus.org/v3/homoit0001026","skos:related":["https://homosaurus.org/v3/homoit0000352","https://homosaurus.org/v3/homoit0000618","https://homosaurus.org/v3/homoit0000805","https://homosaurus.org/v3/homoit0000807","https://homosaurus.org/v3/homoit0000882","https://homosaurus.org/v3/homoit0001322"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexMovement"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000673","dc:identifier":"homoit0000673","skos:prefLabel":"Intersex rights","rdfs:comment":"Legal, social, or ethical principles of freedom or entitlement held by intersex people. Often used to refer to intersex people's right to bodily autonomy and, specifically, their right to delay or decline unnecessary medical interventions.","skos:broader":"https://homosaurus.org/v3/homoit0000652","skos:related":["https://homosaurus.org/v3/homoit0000276","https://homosaurus.org/v3/homoit0000618","https://homosaurus.org/v3/homoit0000670"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000652"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000674","dc:identifier":"homoit0000674","skos:prefLabel":"Intersex youth","skos:altLabel":["Intersex adolescents","Intersex teenagers","Intersex teens"],"rdfs:comment":"Intersex people between the age of childhood and adulthood.","skos:broader":["https://homosaurus.org/v3/homoit0000618","https://homosaurus.org/v3/homoit0001520"],"skos:narrower":"https://homosaurus.org/v3/homoit0000668","skos:related":"https://homosaurus.org/v3/homoit0001521","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexYouth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000675","dc:identifier":"homoit0000675","skos:prefLabel":"Intimate partner violence","skos:altLabel":"Intimate partner abuse","rdfs:comment":"Acts of violence or abuse directed against an individual by their current or former partner in a romantic, sexual, or play relationship.","skos:broader":"https://homosaurus.org/v3/homoit0000855","skos:related":["https://homosaurus.org/v3/homoit0000918","https://homosaurus.org/v3/homoit0001133","https://homosaurus.org/v3/homoit0001293","https://homosaurus.org/v3/homoit0001311"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2009000032"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intimatePartnerViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000676","dc:identifier":"homoit0000676","skos:prefLabel":"Inuit LGBTQ+ people","skos:altLabel":["Inuit (LGBTQ)","Inuit people (LGBTQ)","LGBTQ+ Inuit","LGBTQ+ Inuit people"],"rdfs:comment":"LGBTQ+ people who are Inuit, or part of several Indigenous peoples inhabiting the Inuit homeland in the Arctic and subarctic regions of Greenland, Canada, and Alaska. Only use for people who identify as Inuit.","skos:broader":"https://homosaurus.org/v3/homoit0000886","skos:narrower":["https://homosaurus.org/v3/homoit0001962","https://homosaurus.org/v3/homoit0001963","https://homosaurus.org/v3/homoit0001964","https://homosaurus.org/v3/homoit0001965","https://homosaurus.org/v3/homoit0001966","https://homosaurus.org/v3/homoit0001967","https://homosaurus.org/v3/homoit0002923","https://homosaurus.org/v3/homoit0003410"],"skos:related":["https://homosaurus.org/v3/homoit0001809","https://homosaurus.org/v3/homoit0001810"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQInuit"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000677","dc:identifier":"homoit0000677","skos:prefLabel":"Inverts","skos:altLabel":"Sexual inverts","rdfs:comment":"Outdated, historical term used for LGBTQ+ people.","skos:broader":"https://homosaurus.org/v3/homoit0000878","skos:related":["https://homosaurus.org/v3/homoit0001296","https://homosaurus.org/v3/homoit0001297","https://homosaurus.org/v3/homoit0001564"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/inverts"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000678","dc:identifier":"homoit0000678","skos:prefLabel":"Jankha","rdfs:comment":"In India, this term is used to describe people assigned male at birth who take on female dress and characteristics but who do not elect to receive castration.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/jankha"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v3/homoit0000679","dc:identifier":"homoit0000679","skos:prefLabel":"Jealousy","skos:related":["https://homosaurus.org/v3/homoit0000889","https://homosaurus.org/v3/homoit0001237","https://homosaurus.org/v3/homoit0001649"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85069852"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000679"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001658"},"dc:replaces":{"@id":"http://homosaurus.org/v2/jealousy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-10-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000680","dc:identifier":"homoit0000680","skos:prefLabel":"LGBTQ+ Jehovah's Witnesses","skos:altLabel":["LGBTQ Jehova's Witnesses","Jehova's Witnesses (LGBTQ)","LGBTQ Jehovah's Witnesses"],"rdfs:comment":"LGBTQ+ people who are Jehovah’s Witnesses. ","skos:broader":"https://homosaurus.org/v3/homoit0000265","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQJehovahsWitnesses"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000681","dc:identifier":"homoit0000681","skos:prefLabel":"Jerking off","skos:altLabel":["Jacking off","Jerking it"],"rdfs:comment":"Slang term for masturbation; typically refers to manual stimulation of the penis.","skos:broader":"https://homosaurus.org/v3/homoit0001000","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/jerkingOff"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000682","dc:identifier":"homoit0000682","skos:prefLabel":"Jewish LGBTQ+ people","skos:altLabel":["Jews (LGBTQ)","LGBTQ+ Jews"],"rdfs:comment":"LGBTQ+ people who are Jewish.","skos:broader":["https://homosaurus.org/v3/homoit0000860","https://homosaurus.org/v3/homoit0000928"],"skos:narrower":["https://homosaurus.org/v3/homoit0000154","https://homosaurus.org/v3/homoit0000497","https://homosaurus.org/v3/homoit0000745","https://homosaurus.org/v3/homoit0001180","https://homosaurus.org/v3/homoit0001416","https://homosaurus.org/v3/homoit0002767","https://homosaurus.org/v3/homoit0002908","https://homosaurus.org/v3/homoit0003411"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008007442"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/jewsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000683","dc:identifier":"homoit0000683","skos:prefLabel":"Jizz","rdfs:comment":"Slang term for semen; primarily used in the United States.","skos:broader":"https://homosaurus.org/v3/homoit0003061","skos:related":["https://homosaurus.org/v3/homoit0000323","https://homosaurus.org/v3/homoit0000589","https://homosaurus.org/v3/homoit0000610","https://homosaurus.org/v3/homoit0001062","https://homosaurus.org/v3/homoit0001284","https://homosaurus.org/v3/homoit0001288","https://homosaurus.org/v3/homoit0003128"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0003061"},"dc:replaces":{"@id":"http://homosaurus.org/v2/jizz"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000684","dc:identifier":"homoit0000684","skos:prefLabel":"Jogappa","rdfs:comment":"In India, this term is used to describe people assigned male at birth who become genderfluid in a spiritual conversion.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":"https://homosaurus.org/v3/homoit0000632","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/jogappa"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000685","dc:identifier":"homoit0000685","skos:prefLabel":"Kabuki","rdfs:comment":"A form of theatre in Japan that often features crossdressing actors. Historically, female performers played both male and female roles, but women were later banned from performing and were replaced with male performers who played both male and female roles.","skos:broader":"https://homosaurus.org/v3/homoit0001363","skos:related":"https://homosaurus.org/v3/homoit0000318","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85071224"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001363"},"dc:replaces":{"@id":"http://homosaurus.org/v2/kabuki"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000686","dc:identifier":"homoit0000686","skos:prefLabel":"Kaposi's sarcoma","rdfs:comment":"A type of cancer that causes lesions to grow in the skin, lymph nodes, internal organs, and mucous membranes; often affects people with immune deficiencies, such as AIDS.","skos:related":["https://homosaurus.org/v3/homoit0000005","https://homosaurus.org/v3/homoit0000033","https://homosaurus.org/v3/homoit0001980"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85071562"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000686"},"dc:replaces":{"@id":"http://homosaurus.org/v2/kaposisSarcoma"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000687","dc:identifier":"homoit0000687","skos:prefLabel":"Katoey","skos:altLabel":["Ladyboy","Kathoey"],"rdfs:comment":"In Thailand, this term refers to a range of people of non-normative gender expressions, including intersex people, transgender women, and effeminate gay men. Some regard this term as outdated and offensive, while others self-identify with it. Only use to describe people who self-identify as katoey.","skos:broader":["https://homosaurus.org/v3/homoit0000322","https://homosaurus.org/v3/homoit0001297"],"skos:related":["https://homosaurus.org/v3/homoit0000340","https://homosaurus.org/v3/homoit0001373"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/katoey"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000688","dc:identifier":"homoit0000688","skos:prefLabel":"Khusra","rdfs:comment":"A term used in Pakistan and Northern India to describe third-gender people, typically people assigned male at birth who identify as female.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":"https://homosaurus.org/v3/homoit0000632","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/khusra"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000689","dc:identifier":"homoit0000689","skos:prefLabel":"Khwaja sira","skos:altLabel":["Khawaja sara","Khwaja sara","Khawaja sira"],"rdfs:comment":"An umbrella term used in Pakistan and South Asia to describe people assigned male at birth who identify as women, intersex, or third gender.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/khawajaSara"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000690","dc:identifier":"homoit0000690","skos:prefLabel":"Kinnar","rdfs:comment":"A variant term for hijra used in northern India.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":"https://homosaurus.org/v3/homoit0000632","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/kinnar"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000691","dc:identifier":"homoit0000691","skos:prefLabel":"Kissing","rdfs:comment":"Touching or pressing one's lips to another person or an object to communicate a greeting, affection, reverence, love, or sexual desire.","skos:broader":["https://homosaurus.org/v3/homoit0000593","https://homosaurus.org/v3/homoit0001112","https://homosaurus.org/v3/homoit0001267","https://homosaurus.org/v3/homoit0001299"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85072549"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/kissing"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000692","dc:identifier":"homoit0000692","skos:prefLabel":"Klinefelter syndrome","skos:altLabel":"47XXY","rdfs:comment":"People with Klinefelter syndrome develop with an extra copy of the X chromosome, resulting in a 47XXY pattern (instead of the typical 46XY). These individuals might have smaller-than-typical testes that produce lower amounts of testosterone and/or sperm, and they may start puberty later than typical (or may not go through puberty without hormone therapy). They may grow taller than usual, may develop breast tissue, and often experience infertility. This variation often does not cause obvious physical differences, and many people do not realize they have it.","skos:broader":"https://homosaurus.org/v3/homoit0000669","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85072641"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/klinefelterSyndrome"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000693","dc:identifier":"homoit0000693","skos:prefLabel":"Köçek","rdfs:comment":"Turkish term for male dancers who crossdress in feminine attire for entertainment purposes.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/köçek"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000694","dc:identifier":"homoit0000694","skos:prefLabel":"Kothis","rdfs:comment":"In South Asia, this term is used to describe people who are assigned male at birth who exhibit feminine characteristics. Please note that not all kothis identify as hijra or transgender.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:related":"https://homosaurus.org/v3/homoit0000632","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/kothi"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000695","dc:identifier":"homoit0000695","skos:prefLabel":"Khteuy","skos:altLabel":"Kteuy","rdfs:comment":"Khmer term for third sex people. Can be considered outdated and offensive.","skos:broader":["https://homosaurus.org/v3/homoit0000322","https://homosaurus.org/v3/homoit0001560"],"skos:related":["https://homosaurus.org/v3/homoit0001253","https://homosaurus.org/v3/homoit0001338"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/kteuy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000696","dc:identifier":"homoit0000696","skos:prefLabel":"Labrys","rdfs:comment":"Symbol used to represent lesbianism and feminism.","skos:broader":"https://homosaurus.org/v3/homoit0000954","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000954"},"dc:replaces":{"@id":"http://homosaurus.org/v2/labrys"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000697","dc:identifier":"homoit0000697","skos:prefLabel":"Lakin-on","rdfs:comment":"Cebuano term for women who are attracted to women and take on male personas and cultural work.","skos:broader":"https://homosaurus.org/v3/homoit0000322","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lakinOn"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000698","dc:identifier":"homoit0000698","skos:prefLabel":"Lambda","rdfs:comment":"Symbol for lesbian and gay rights.","skos:broader":"https://homosaurus.org/v3/homoit0000954","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000954"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lambda"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000699","dc:identifier":"homoit0000699","skos:prefLabel":"Latent homosexuality","rdfs:comment":"Term coined by Sigmund Freud to describe erotic attraction towards members of the same sex or gender that is not (and may never be) consciously experienced or expressed openly.","skos:related":["https://homosaurus.org/v3/homoit0000345","https://homosaurus.org/v3/homoit0000391"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000699"},"dc:replaces":{"@id":"http://homosaurus.org/v2/latentHomosexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000700","dc:identifier":"homoit0000700","skos:prefLabel":"Latex gloves","rdfs:comment":"Protective coverings for the hands made from latex, a thin-plastic like material; often used as a barrier to protect against STIs while engaging in safer sex practices.","skos:broader":["https://homosaurus.org/v3/homoit0001266","https://homosaurus.org/v3/homoit0003111"],"skos:related":"https://homosaurus.org/v3/homoit0001251","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/latexGloves"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000701","dc:identifier":"homoit0000701","skos:prefLabel":"Lavender Scare","rdfs:comment":"Term used to describe the mid-20th century purge of lesbians and gay men in the U.S. government as a result of moral panic incited by Joseph McCarthy and others.","skos:related":["https://homosaurus.org/v3/homoit0000356","https://homosaurus.org/v3/homoit0001108"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000701"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lavenderScare"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000703","dc:identifier":"homoit0000703","skos:prefLabel":"LBT","rdfs:comment":"Acronym used to describe lesbians, bisexuals, and transgender people as a group.","skos:broader":"https://homosaurus.org/v3/homoit0000594","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000805"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LBT"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000704","dc:identifier":"homoit0000704","skos:prefLabel":"Leashes","rdfs:comment":"A length of rope or similar material used to control an individual, often to increase sexual arousal.","skos:broader":"https://homosaurus.org/v3/homoit0001266","skos:related":"https://homosaurus.org/v3/homoit0001238","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/leashes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000705","dc:identifier":"homoit0000705","skos:prefLabel":"Leather community","skos:altLabel":["Leather scene","Leather lifestyle","Leather"],"rdfs:comment":"An LGBTQ+ subculture that celebrates sexual freedom, kinks and fetishes with its own fashions (especially leather garments), clubs, and events.","skos:broader":["https://homosaurus.org/v3/homoit0000297","https://homosaurus.org/v3/homoit0001345"],"skos:narrower":["https://homosaurus.org/v3/homoit0000217","https://homosaurus.org/v3/homoit0000706","https://homosaurus.org/v3/homoit0000707","https://homosaurus.org/v3/homoit0000708","https://homosaurus.org/v3/homoit0000709","https://homosaurus.org/v3/homoit0000710","https://homosaurus.org/v3/homoit0001145","https://homosaurus.org/v3/homoit0003083","https://homosaurus.org/v3/homoit0003086","https://homosaurus.org/v3/homoit0003087","https://homosaurus.org/v3/homoit0003088"],"skos:related":["https://homosaurus.org/v3/homoit0000103","https://homosaurus.org/v3/homoit0000363","https://homosaurus.org/v3/homoit0000442","https://homosaurus.org/v3/homoit0000906","https://homosaurus.org/v3/homoit0000999","https://homosaurus.org/v3/homoit0001247","https://homosaurus.org/v3/homoit0001318","https://homosaurus.org/v3/homoit0001553","https://homosaurus.org/v3/homoit0003052","https://homosaurus.org/v3/homoit0003059","https://homosaurus.org/v3/homoit0003065","https://homosaurus.org/v3/homoit0003080","https://homosaurus.org/v3/homoit0003084","https://homosaurus.org/v3/homoit0003104","https://homosaurus.org/v3/homoit0003106","https://homosaurus.org/v3/homoit0003140"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/leatherCommunity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000706","dc:identifier":"homoit0000706","skos:prefLabel":"Leather daddies","rdfs:comment":"People who participate in leather communities and identify as leather daddies.","skos:broader":["https://homosaurus.org/v3/homoit0000705","https://homosaurus.org/v3/homoit0003086"],"skos:related":["https://homosaurus.org/v3/homoit0000707","https://homosaurus.org/v3/homoit0000708","https://homosaurus.org/v3/homoit0000709","https://homosaurus.org/v3/homoit0000710","https://homosaurus.org/v3/homoit0003087","https://homosaurus.org/v3/homoit0003088"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/leatherDaddies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000707","dc:identifier":"homoit0000707","skos:prefLabel":"Leather families","skos:altLabel":"Leather household","rdfs:comment":"Multiple people who participate in leather communities and identify as a leather family.","skos:broader":["https://homosaurus.org/v3/homoit0000705","https://homosaurus.org/v3/homoit0003086"],"skos:related":["https://homosaurus.org/v3/homoit0000706","https://homosaurus.org/v3/homoit0000708","https://homosaurus.org/v3/homoit0000709","https://homosaurus.org/v3/homoit0000710","https://homosaurus.org/v3/homoit0003087","https://homosaurus.org/v3/homoit0003088"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/leatherFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000708","dc:identifier":"homoit0000708","skos:prefLabel":"Leather mommies","rdfs:comment":"People who participate in leather communities and identify as leather mommies.","skos:broader":["https://homosaurus.org/v3/homoit0000705","https://homosaurus.org/v3/homoit0003086"],"skos:related":["https://homosaurus.org/v3/homoit0000706","https://homosaurus.org/v3/homoit0000707","https://homosaurus.org/v3/homoit0000709","https://homosaurus.org/v3/homoit0000710","https://homosaurus.org/v3/homoit0003087","https://homosaurus.org/v3/homoit0003088"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/leatherMommies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000709","dc:identifier":"homoit0000709","skos:prefLabel":"Leathermen","rdfs:comment":"People who participate in leather communities and identify as leathermen.","skos:broader":["https://homosaurus.org/v3/homoit0000705","https://homosaurus.org/v3/homoit0003086"],"skos:related":["https://homosaurus.org/v3/homoit0000706","https://homosaurus.org/v3/homoit0000707","https://homosaurus.org/v3/homoit0000708","https://homosaurus.org/v3/homoit0000710","https://homosaurus.org/v3/homoit0003087","https://homosaurus.org/v3/homoit0003088"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/leathermen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000710","dc:identifier":"homoit0000710","skos:prefLabel":"Leatherwomen","skos:altLabel":"Leatherdykes","rdfs:comment":"People who participate in leather communities and identify as leatherwomen.","skos:broader":["https://homosaurus.org/v3/homoit0000705","https://homosaurus.org/v3/homoit0003086"],"skos:related":["https://homosaurus.org/v3/homoit0000706","https://homosaurus.org/v3/homoit0000707","https://homosaurus.org/v3/homoit0000708","https://homosaurus.org/v3/homoit0000709","https://homosaurus.org/v3/homoit0003087","https://homosaurus.org/v3/homoit0003088"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/leatherwomen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000711","dc:identifier":"homoit0000711","skos:prefLabel":"Legal name","rdfs:comment":"Use in reference to laws and regulations concerning the name assigned to an individual at birth.","skos:broader":"https://homosaurus.org/v3/homoit0000918","skos:related":["https://homosaurus.org/v3/homoit0000119","https://homosaurus.org/v3/homoit0000247","https://homosaurus.org/v3/homoit0000377","https://homosaurus.org/v3/homoit0001053","https://homosaurus.org/v3/homoit0001092","https://homosaurus.org/v3/homoit0003503"],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/legalName"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000713","dc:identifier":"homoit0000713","skos:prefLabel":"Lesbian activism","rdfs:comment":"Direct action and organizing to achieve political or social change and acceptance for lesbians.","skos:broader":"https://homosaurus.org/v3/homoit0000006","skos:related":"https://homosaurus.org/v3/homoit0000763","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianActivism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000714","dc:identifier":"homoit0000714","skos:prefLabel":"African American lesbians","skos:altLabel":"Lesbian African Americans","rdfs:comment":"Lesbians of African descent born in the United States or lesbians born in African countries who live in or have a strong connection to the United States. Use for individuals who self-identity as African American. Follow the individual’s preference for African American or Black whenever possible.","skos:broader":"https://homosaurus.org/v3/homoit0000015","skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85001859"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianAfricanAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000715","dc:identifier":"homoit0000715","skos:prefLabel":"Afro-Canadian lesbians","skos:altLabel":"Lesbian Afro-Canadians","rdfs:comment":"Lesbians of African descent born in Canada or lesbians born in African countries who live in or have a strong connection to Canada. Use for individuals who self-identify as Afro-Canadian.","skos:broader":"https://homosaurus.org/v3/homoit0000016","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianAfroCanadians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-02-23"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"},"skos:changeNote":"Version 3.7.0"},{"@id":"https://homosaurus.org/v4/homoit0000716","dc:identifier":"homoit0000716","skos:prefLabel":"Afro-Caribbean lesbians","skos:altLabel":"Lesbian Afro-Caribbeans","rdfs:comment":"Lesbians of African descent born in the Caribbean or lesbians born in African countries who live in or have a strong connection to the Caribbean. Only use for individuals who self-identify as Afro-Caribbean.","skos:broader":"https://homosaurus.org/v3/homoit0000017","skos:hasTopConcept":{"@id":"https://homosaurus.org/v4/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianAfroCaribbeans"},"dc:is