    "https://homosaurus.org/v3/homoit0000096",
    "https://homosaurus.org/v3/homoit0000098",
    "https://homosaurus.org/v3/homoit0000101",
    "https://homosaurus.org/v3/homoit0000246",
    "https://homosaurus.org/v3/homoit0000384",
    "https://homosaurus.org/v3/homoit0000418",
    "https://homosaurus.org/v3/homoit0000695";
  skos:prefLabel "Slurs";
  skos:related "https://homosaurus.org/v3/homoit0000336",
    "https://homosaurus.org/v3/homoit0000356",
    "https://homosaurus.org/v3/homoit0000611",
    "https://homosaurus.org/v3/homoit0001108",
