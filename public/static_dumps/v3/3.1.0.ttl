<https://homosaurus.org/v4/homoit0001657> a skos:Concept;
  dc:identifier "homoit0001657";
  dc:issued "2021-06-30"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/nestingPartners>;
