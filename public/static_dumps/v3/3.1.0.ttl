<https://homosaurus.org/v4/homoit0000670> a skos:Concept;
  dc:identifier "homoit0000670";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/intersexGenitalMutilation>;
  rdfs:comment "Surgeries or other medical treatments performed, typically on newborn babies or children, to \"normalize\" the patient's reproductive or sexual anatomy and force their body to conform to medical or social expectations for what is male or female. IGM practices can be performed for cultural, social, or religious reasons. Though they are typically justified through a medical lens, IGM practices are medically unnecessary and non-consensual.";
  skos:altLabel "IGM";
  skos:changeNote "Version 3.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000670>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower "https://homosaurus.org/v3/homoit0000281";
  skos:prefLabel "Intersex genital mutilation";
  skos:related "https://homosaurus.org/v3/homoit0000352",
    "https://homosaurus.org/v3/homoit0000618",
    "https://homosaurus.org/v3/homoit0000666",
    "https://homosaurus.org/v3/homoit0000673",
    "https://homosaurus.org/v3/homoit0001268" .

<https://homosaurus.org/v4/homoit0000671> a skos:Concept;
  dc:identifier "homoit0000671";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/intersexIdentity>;
  rdfs:comment "Used to describe the experience of selfhood of intersex people. Intersex identity is not gender identity, sexual identity, nor sexual orientation. For the subject of intersex variations, use \"intersex variations\" or \"intersex\". For the subject of intersex people, use \"intersex people\". Do not use in place of gender-identity-related terms such as non-binary identity or genderfluid identity.";
  skos:changeNote "Version 3.1.0";
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh2007005480>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000671>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Intersex identity";
  skos:related "https://homosaurus.org/v3/homoit0000352",
    "https://homosaurus.org/v3/homoit0000618" .

