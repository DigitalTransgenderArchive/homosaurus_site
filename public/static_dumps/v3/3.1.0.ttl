<https://homosaurus.org/v4/homoit0000687> a skos:Concept;
  dc:identifier "homoit0000687";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/katoey>;
  rdfs:comment "In Thailand, this term refers to a range of people of non-normative gender expressions, including intersex people, transgender women, and effeminate gay men. Some regard this term as outdated and offensive, while others self-identify with it. Only use to describe people who self-identify as katoey.";
  skos:altLabel "Ladyboy",
    "Kathoey";
  skos:broader "https://homosaurus.org/v3/homoit0000322",
    "https://homosaurus.org/v3/homoit0001297";
  skos:changeNote "Version 3.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000560>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Katoey";
  skos:related "https://homosaurus.org/v3/homoit0000340",
    "https://homosaurus.org/v3/homoit0001373" .

