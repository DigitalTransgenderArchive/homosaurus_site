<https://homosaurus.org/v4/homoit0001781> a skos:Concept;
  dc:identifier "homoit0001781";
  dc:issued "2021-12-07"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  rdfs:comment "Slang term for the act of identifying (or clocking) someone in public as trans, crossdressing, or in drag when that person is intending to pass or be read by others as cisgender, typically for their personal safety. Clocking is often understood to be a threat (of violence or public outing) against the person being clocked. Use the term \"Reading (Gender)\" to refer to shared identification or recognized kinship between two individuals who are both gender minorities.";
  skos:altLabel "Clocking (Transgender)",
    "Clocking";
  skos:changeNote "Version 3.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001781>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Clocking (Gender)";
  skos:related "https://homosaurus.org/v3/homoit0000288",
    "https://homosaurus.org/v3/homoit0000316",
    "https://homosaurus.org/v3/homoit0001090",
    "https://homosaurus.org/v3/homoit0001378",
    "https://homosaurus.org/v3/homoit0001381",
    "https://homosaurus.org/v3/homoit0001470" .

