<https://homosaurus.org/v4/homoit0000301> a skos:Concept;
  dc:identifier "homoit0000301";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/congenitalAdrenalHyperplasia>;
  rdfs:comment "Congenital adrenal hyperplasia (CAH) is a group of different but related genetic variations that affect the enzymes that allow the adrenal glands to make hormones that regulate the body’s functions. People with CAH do not consistently produce the amount of cortisol or aldosterone they need, but they may naturally produce higher-than-typical levels of androgens such as testosterone to help the body compensate. Someone with CAH can be born with XX or XY chromosomes. People with CAH and XY chromosomes are usually not considered to have a variation in sex characteristics since an increased amount of androgens will not cause the development of any characteristics that are not considered typical for people assigned male at birth. In people with XX chromosomes and CAH, the increase in androgen production can result in genital differences such as a larger-than-typical clitoris, fused labia, and the fusion of the urethra and vaginal canal to form a single opening. They may also develop some characteristics like body and facial hair or increased muscle mass during childhood or puberty.";
  skos:altLabel "CAH";
  skos:broader "https://homosaurus.org/v3/homoit0000669";
  skos:changeNote "Version 3.1.0";
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85001014>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001269>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Congenital adrenal hyperplasia" .

<https://homosaurus.org/v4/homoit0000303> a skos:Concept;
  dc:identifier "homoit0000303";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/sexualReorientation>;
  rdfs:comment "Efforts to change the sexual or gender identity of an individual who is or is suspected to be LGBTQ+ to meet heterosexual or cisgender norms, typically under the belief that being LGBTQ+ is dangerous and/or the result of mental illness or trauma. The processes involved in conversion therapy include visualization training, spiritual interventions, and other aversion treatments. ";
  skos:altLabel "Reparative therapy",
    "Reorientation therapy",
    "Sexual reorientation therapy";
  skos:broader "https://homosaurus.org/v3/homoit0000106";
  skos:changeNote "Version 3.1.0";
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh2006004076>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001004>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Sexual reorientation" .

<https://homosaurus.org/v4/homoit0000304> a skos:Concept;
  dc:identifier "homoit0000304";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/secondParentAdoption>;
  rdfs:comment "An adoption process by which a legal child-parent relationship is established by granting the “second” parent the same rights as the “first” parent without the “first” or legal parent relinquishing any parental rights. A second or co-parent adoption can be important for LGBTQ+ parents to protect their parental rights as the relationship of the non-biological parent may not be recognized in some jurisdictions without such an adoption.";
  skos:altLabel "Co-parent adoption";
  skos:broader "https://homosaurus.org/v3/homoit0000809";
  skos:changeNote "Version 3.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000864>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Second parent adoption";
  skos:related "https://homosaurus.org/v3/homoit0000918" .

