  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/womensMovement>;
  rdfs:comment "Social and political movement originating in the 1800s for reforms on women’s issues stemming from social, cultural, political, and economic inequality between men and women. Feminist issues include reproductive rights, women’s liberation, and equal pay. This term encompasses the women’s movement in its entirety, including different waves of feminist thought and activism.";
  skos:altLabel "Feminist movement";
  skos:broader "https://homosaurus.org/v3/homoit0001322";
  skos:changeNote "Version 3.1.0";
