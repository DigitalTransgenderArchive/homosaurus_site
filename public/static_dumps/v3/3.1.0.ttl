<https://homosaurus.org/v4/homoit0000685> a skos:Concept;
  dc:identifier "homoit0000685";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/kabuki>;
  rdfs:comment "A form of theatre in Japan that often features crossdressing actors. Historically, female performers played both male and female roles, but women were later banned from performing and were replaced with male performers who played both male and female roles.";
  skos:broader "https://homosaurus.org/v3/homoit0001363";
  skos:changeNote "Version 3.1.0";
