<https://homosaurus.org/v4/homoit0001662> a skos:Concept;
  dc:identifier "homoit0001662";
  dc:issued "2021-06-30"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/paramours>;
  rdfs:comment "In polyamory contexts, paramours are the partners of an individual's partner, typically as part of a relationship the primary partner is unaware of. In other contexts, this term is used broadly as a synonym for lovers.";
  skos:broader "https://homosaurus.org/v3/homoit0001123",
    "https://homosaurus.org/v3/homoit0001660";
