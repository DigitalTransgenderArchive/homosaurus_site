  rdfs:comment "LGBTQ+ people who belong to one or more of the various Indigenous peoples of Australia; do not use to refer to the Indigenous people of the Torres Strait Islands, who are considered ethnically and culturally distinct. Only use to describe people who identify as Aboriginal Australian.";
  skos:altLabel "Aboriginal people (LGBTQ)",
    "Aboriginal Australian people (LGBTQ)",
    "LGBTQ+ Aboriginal Australian people",
    "LGBTQ+ Aboriginal Australians",
    "LGBTQ+ Aboriginal people",
    "LGBTQ+ Aboriginals";
  skos:broader "https://homosaurus.org/v3/homoit0000886";
  skos:changeNote "Version 3.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0001101>;
  skos:inScheme <https://homosaurus.org/v3>;
