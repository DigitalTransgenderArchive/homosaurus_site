<https://homosaurus.org/v4/homoit0001120> a skos:Concept;
  dc:identifier "homoit0001120";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/policeEntrapment>;
  rdfs:comment "A practice in which law enforcement agents or agents of the state coerce an individual to commit a \"crime\" they would have otherwise been unlikely or unwilling to commit. Legal definitions of entrapment vary widely depending on the jurisdiction, but the term is often used colloquially to refer to police acting dishonestly or in bad faith, as well as policing focused on anticipating and inducing crime, rather than responding to reports of crime.";
  skos:broader "https://homosaurus.org/v3/homoit0001121";
  skos:changeNote "Version 3.1.0";
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85044146>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000611>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Police entrapment";
  skos:related "https://homosaurus.org/v3/homoit0000068",
    "https://homosaurus.org/v3/homoit0001119" .

<https://homosaurus.org/v4/homoit0001121> a skos:Concept;
  dc:identifier "homoit0001121";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/policeHarassment>;
  rdfs:comment "Any of various forms of inappropriate conduct, illegal actions, or abuses of power undertaken by law enforcement agents or agents of the state against members of the public. This includes but is not limited to racial, ethnic, and other forms of profiling; unwarranted surveillance, searches, and seizure; selective enforcement; excessive use of force; sexual misconduct; intimidation and witness tampering; falsification of evidence; coerced confessions; false arrests and imprisonment; and bribing or lobbying.";
  skos:altLabel "Harrassment by police",
    "Misconduct by police",
    "Mistreatment by police",
    "Police misconduct",
    "Police mistreatment";
  skos:broader "https://homosaurus.org/v3/homoit0000611";
  skos:changeNote "Version 3.1.0";
  skos:closeMatch <http://id.loc.gov/authorities/subjects/sh95010616>;
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000611>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower "https://homosaurus.org/v3/homoit0001120",
    "https://homosaurus.org/v3/homoit0001122";
  skos:prefLabel "Police harassment" .

<https://homosaurus.org/v4/homoit0001122> a skos:Concept;
  dc:identifier "homoit0001122";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/policeRaids>;
  rdfs:comment "Unexpected and unannounced entry into and searches of residences or establishments by law enforcement officers with the aim of using surprise to seize evidence or arrest suspects. Police raids may be undertaken legally using a search warrant or through exigent circumstances, such as probable cause, though the latter is highly subjective and civilians often have little resources to appeal illegal raids.";
  skos:altLabel "Dawn raids",
    "No-knock raids";
  skos:broader "https://homosaurus.org/v3/homoit0001121";
  skos:changeNote "Version 3.1.0";
  skos:hasTopConcept <https://homosaurus.org/v4/homoit0000611>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Police raids";
  skos:related "https://homosaurus.org/v3/homoit0001119" .

