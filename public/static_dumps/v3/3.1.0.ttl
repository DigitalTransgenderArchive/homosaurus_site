  dc:modified "2025-02-23"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/kaposisSarcoma>;
  rdfs:comment "A type of cancer that causes lesions to grow in the skin, lymph nodes, internal organs, and mucous membranes; often affects people with immune deficiencies, such as AIDS.";
