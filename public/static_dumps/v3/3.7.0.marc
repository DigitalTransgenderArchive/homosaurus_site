  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Creators of written or spoken verse who identify as aromantic.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Creators of written or spoken verse who identify as demisexual.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Creators of written or spoken verse who identify as greyromantic.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Creators of written or spoken verse who identify as megasexual.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">LGBTQ+ people who are well-known to the public through their appearances on television shows, typically as themselves rather than in scripted roles.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Lesbians who are well-known to the public through their appearances on television shows, typically as themselves rather than in scripted roles.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Gay men who are well-known to the public through their appearances on television shows, typically as themselves rather than in scripted roles.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Bisexual people who are well-known to the public through their appearances on television shows, typically as themselves rather than in scripted roles.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Transgender people who are well-known to the public through their appearances on television shows, typically as themselves rather than in scripted roles.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Queer people who are well-known to the public through their appearances on television shows, typically as themselves rather than in scripted roles.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Intersex people who are well-known to the public through their appearances on television shows, typically as themselves rather than in scripted roles.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">Asexual people who are well-known to the public through their appearances on television shows, typically as themselves rather than in scripted roles.</subfield>
