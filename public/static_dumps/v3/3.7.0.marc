  <datafield tag="680" ind1=" " ind2=" ">
    <subfield code="a">LGBTQ+ people who belong to or are descended from those native to Garhwal in Uttarakhand and who speak Garhwali.</subfield>
  </datafield>
  <datafield tag="680" ind1=" " ind2=" ">
