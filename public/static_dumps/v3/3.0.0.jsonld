uction of the clitoris."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000430"},{"@id":"https://homosaurus.org/v3/homoit0000670"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000269"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85027085"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000430"},"dc:replaces":{"@id":"http://homosaurus.org/v2/clitoridectomy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000450","dc:identifier":"homoit0000450","skos:prefLabel":{"@language":"en","@value":"Foreskin restoration"},"skos:altLabel":{"@language":"en","@value":"Uncircumcision"},"rdfs:comment":{"@language":"en","@value":"The process of altering a circumcised penis to reconstruct or restore the foreskin."},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000269"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000450"},"dc:replaces":{"@id":"http://homosaurus.org/v2/foreskinRestoration"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-11-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001481","dc:identifier":"homoit0001481","skos:prefLabel":{"@language":"en","@value":"Uncut men"},"skos:altLabel":{"@language":"en","@value":"Uncircumcised men"},"rdfs:comment":{"@language":"en","@value":"Men whose penises are uncircumcised (i.e., the foreskin of the penis has not been surgically removed)."},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000269"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008004022"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001481"},"dc:replaces":{"@id":"http://homosaurus.org/v2/uncutMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000273","dc:identifier":"homoit0000273","skos:prefLabel":{"@language":"en","@value":"Cissexual people"},"rdfs:comment":{"@language":"en","@value":"Individuals whose sex matches the sex or gender they were assigned at birth. Whereas cisgender refers to people who are not transgender, cissexual refers to people who are not transsexual."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000271"},{"@id":"https://homosaurus.org/v3/homoit0001381"},{"@id":"https://homosaurus.org/v3/homoit0001924"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000273"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cissexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001652","dc:identifier":"homoit0001652","skos:prefLabel":{"@language":"en","@value":"Demigirls"},"skos:altLabel":[{"@language":"en","@value":"Demiwomen"},{"@language":"en","@value":"Demiwoman"},{"@language":"en","@value":"Demigirl"},{"@language":"en","@value":"Demilady"},{"@language":"en","@value":"Demiladies"},{"@language":"en","@value":"Demifemale people"}],"rdfs:comment":{"@language":"en","@value":"People who partially, but not fully, identify women or girls irrespective of their assigned genders. Used by cisgender, transgender, transfeminine, or nonbinary people who feel more strongly aligned with women physically or socially, but not strongly enough to identify solely as one."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000342"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000271"},{"@id":"https://homosaurus.org/v3/homoit0001048"},{"@id":"https://homosaurus.org/v3/homoit0001382"},{"@id":"https://homosaurus.org/v3/homoit0001653"},{"@id":"https://homosaurus.org/v3/homoit0001821"},{"@id":"https://homosaurus.org/v3/homoit0001923"},{"@id":"https://homosaurus.org/v3/homoit0002043"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/demigirls"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-18"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001653","dc:identifier":"homoit0001653","skos:prefLabel":{"@language":"en","@value":"Demiboys"},"skos:altLabel":[{"@language":"en","@value":"Demiguy"},{"@language":"en","@value":"Demiguys"},{"@language":"en","@value":"Demimen"},{"@language":"en","@value":"Demimales"},{"@language":"en","@value":"Demimale people"},{"@language":"en","@value":"Demiboy"}],"rdfs:comment":{"@language":"en","@value":"People who partially, but not fully, identify as men or boys irrespective of their assigned genders. Used by cisgender, transgender, transmasculine, or nonbinary people who feel more aligned with men physically or socially, but not strongly enough to identify solely as one."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000342"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000271"},{"@id":"https://homosaurus.org/v3/homoit0001048"},{"@id":"https://homosaurus.org/v3/homoit0001466"},{"@id":"https://homosaurus.org/v3/homoit0001652"},{"@id":"https://homosaurus.org/v3/homoit0001820"},{"@id":"https://homosaurus.org/v3/homoit0001923"},{"@id":"https://homosaurus.org/v3/homoit0002061"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/demiboys"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-18"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001381","dc:identifier":"homoit0001381","skos:prefLabel":{"@language":"en","@value":"Transsexual people"},"skos:altLabel":[{"@language":"en","@value":"Transexuals"},{"@language":"en","@value":"Transsexuals"}],"rdfs:comment":{"@language":"en","@value":"Individuals who transition from female to male or male to female. Generally refers to individuals who transition their physical bodies to align with their gender identities. Though this term was popular in the 20th century and is still in use today, it has been largely replaced by \"transgender people\" and \"trans people.\" Some but not all people regard this term as outdated and offensive. Only use to describe people who self-identify as transsexual."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001378"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000436"},{"@id":"https://homosaurus.org/v3/homoit0000986"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000273"},{"@id":"https://homosaurus.org/v3/homoit0000561"},{"@id":"https://homosaurus.org/v3/homoit0000572"},{"@id":"https://homosaurus.org/v3/homoit0001047"},{"@id":"https://homosaurus.org/v3/homoit0001049"},{"@id":"https://homosaurus.org/v3/homoit0001073"},{"@id":"https://homosaurus.org/v3/homoit0001129"},{"@id":"https://homosaurus.org/v3/homoit0001131"},{"@id":"https://homosaurus.org/v3/homoit0001380"},{"@id":"https://homosaurus.org/v3/homoit0001464"},{"@id":"https://homosaurus.org/v3/homoit0001465"},{"@id":"https://homosaurus.org/v3/homoit0001468"},{"@id":"https://homosaurus.org/v3/homoit0001781"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85137086"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transsexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000274","dc:identifier":"homoit0000274","skos:prefLabel":{"@language":"en","@value":"Civil unions"},"skos:altLabel":[{"@language":"en","@value":"Civil partnership"},{"@language":"en","@value":"Registered partnership"}],"rdfs:comment":{"@language":"en","@value":"Legally recognized unions with rights similar (but often not identical or equal) to those of marriage, originally created for same-sex couples in jurisdictions where they were not legally allowed to marry."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000973"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000275"},{"@id":"https://homosaurus.org/v3/homoit0000277"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000362"},{"@id":"https://homosaurus.org/v3/homoit0000712"},{"@id":"https://homosaurus.org/v3/homoit0000918"},{"@id":"https://homosaurus.org/v3/homoit0000990"},{"@id":"https://homosaurus.org/v3/homoit0000992"},{"@id":"https://homosaurus.org/v3/homoit0001053"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2003003097"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/civilUnions"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000275","dc:identifier":"homoit0000275","skos:prefLabel":{"@language":"en","@value":"Civil union documents"},"rdfs:comment":{"@language":"en","@value":"Legal documents certifying civil unions established in compliance with the laws of certain jurisdictions."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000274"},{"@id":"https://homosaurus.org/v3/homoit0001053"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/civilUnionDocuments"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"