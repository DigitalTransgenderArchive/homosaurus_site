0"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/marriageLicenses"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001184","dc:identifier":"homoit0001184","skos:prefLabel":{"@language":"en","@value":"Queer masters"},"skos:altLabel":{"@language":"en","@value":"Queer masters"},"rdfs:comment":{"@language":"en","@value":"Queer people who are part of the BDSM scene and assume the dominant role in sexual relationships with a dominant/submissive dynamic."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000999"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerMasters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001420","dc:identifier":"homoit0001420","skos:prefLabel":{"@language":"en","@value":"Transgender masters"},"skos:altLabel":{"@language":"en","@value":"Transgender masters"},"rdfs:comment":{"@language":"en","@value":"Transgender people who are part of the BDSM scene and assume the dominant role in sexual relationships with a dominant/submissive dynamic."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000999"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderMasters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001033","dc:identifier":"homoit0001033","skos:prefLabel":{"@language":"en","@value":"Mutual masturbation"},"rdfs:comment":{"@language":"en","@value":"Sex act in which two or more people simultaneously stimulate their own genitalia."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001000"},{"@id":"https://homosaurus.org/v3/homoit0001267"},{"@id":"https://homosaurus.org/v3/homoit0001299"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mutualMasturbation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001328","dc:identifier":"homoit0001328","skos:prefLabel":{"@language":"en","@value":"Solo sex"},"rdfs:comment":{"@language":"en","@value":"Sexual acts involving only one person, such as masturbation, as opposed to sex with a partner."},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001000"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001328"},"dc:replaces":{"@id":"http://homosaurus.org/v2/soloSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001003","dc:identifier":"homoit0001003","skos:prefLabel":{"@language":"en","@value":"Metropolitan Community Church"},"skos:altLabel":{"@language":"en","@value":"MCC"},"rdfs:comment":{"@language":"en","@value":"Christian church founded in 1968 by Troy Perry as a welcoming spiritual gathering place for LGBT Christians; MCC is now an international denomination"},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000530"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001137"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000530"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000530"},"dc:replaces":{"