osaurus.org/v3/homoit0000376"},{"@id":"https://homosaurus.org/v3/homoit0000546"},{"@id":"https://homosaurus.org/v3/homoit0000788"},{"@id":"https://homosaurus.org/v3/homoit0000816"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000922"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPlays"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000378","dc:identifier":"homoit0000378","skos:prefLabel":{"@language":"en","@value":"Drug abuse"},"skos:altLabel":[{"@language":"en","@value":"Drug addiction"},{"@language":"en","@value":"Drug dependence"}],"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000251"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001536"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000379"},{"@id":"https://homosaurus.org/v3/homoit0000380"},{"@id":"https://homosaurus.org/v3/homoit0001235"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85039675"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000251"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0002226"},"dc:replaces":{"@id":"http://homosaurus.org/v2/drugAbuse"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000379","dc:identifier":"homoit0000379","skos:prefLabel":{"@language":"en","@value":"Drug users"},"skos:altLabel":[{"@language":"en","@value":"Drug users (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ people who drink"},{"@language":"en","@value":"LGBTQ+ people who use drugs"},{"@language":"en","@value":"Substance users (LGBTQ)"}],"rdfs:comment":{"@language":"en","@value":"Umbrella term for LGBTQ+ people who use substances (that are typically deemed harmful or are subject to legal restriction, such as drugs or alcohol) for any reason. Apply more specific terms if possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000915"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001235"},{"@id":"https://homosaurus.org/v3/homoit0001540"},{"@id":"https://homosaurus.org/v3/homoit0001550"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/drugUsers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001540","dc:identifier":"homoit0001540","skos:prefLabel":{"@language":"en","@value":"LGBTQ alcoholics"},"skos:altLabel":[{"@language":"en","@value":"Alcoholics (LGBTQ)"},{"@language":"en","@value":"LGBTQ alcoholics"}],"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who have been diagnosed with or regard themselves as having an alcohol use disorder, a medical condition that involves a pattern of alcohol use that is difficult to control, negatively impacts the individual's life, and results in withdrawal symptoms upon cessation. Only use to refer to individuals who describe themselves as having an alcohol use disorder. Follow the individual's preference for \"use disorder\" or \"addiction\" whenever possible."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000379"},{"@id":"https://homosaurus.org/v3/homoit0001550"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001549"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQAlcoholics"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-09"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001550","dc:identifier":"homoit0001550","skos:prefLabel":{"@language":"en","@value":"LGBTQ people with addictions"},"skos:altLabel":{"@language":"en","@value":"LGBTQ people with addictions"},"rdfs:comment":{"@language":"en","@value":"Umbrella term for LGBTQ+ people experiencing addictions, dependencies, or use disorders of some kind. Only use to refer to individuals who describe themselves as having addictions. Apply more specific terms if possible."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000379"},{"@id":"https://homosaurus.org/v3/homoit0000380"},{"@id":"https://homosaurus.org/v3/homoit0000915"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001283"},{"@id":"https://homosaurus.org/v3/homoit0001540"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPeopleWithAddictions"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001125","dc:identifier":"homoit0001125","skos:prefLabel":{"@language":"en","@value":"Poppers"},"skos:altLabel":{"@language":"en","@value":"Tape head cleaner"},"rdfs:comment":{"@language":"en","@value":"A slang term commonly used in LGBTQ+ subcultures to describe alkyl nitrites, a class of drug that produces a high when inhaled. Poppers are often associated with gay nightlife because they can be used to facilitate anal sex by relaxining the anal muscles."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001317"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000380"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001317"},"dc:replaces":{"@id":"http://homosaurus.org/v2/poppers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-25"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://