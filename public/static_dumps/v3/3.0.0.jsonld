"en","@value":"House-ballroom culture"}],"rdfs:comment":{"@language":"en","@value":"A subculture that emerged in early 20th century New York City in which primarily African-American and Latin American LGBTQ+ people perform and compete for various prizes."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001345"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000094"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000095"},{"@id":"https://homosaurus.org/v3/homoit0000368"},{"@id":"https://homosaurus.org/v3/homoit0000370"},{"@id":"https://homosaurus.org/v3/homoit0001295"},{"@id":"https://homosaurus.org/v3/homoit0001494"},{"@id":"https://homosaurus.org/v3/homoit0001900"},{"@id":"https://homosaurus.org/v3/homoit0003505"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ballCulture"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000094","dc:identifier":"homoit0000094","skos:prefLabel":{"@language":"en","@value":"Ballroom families"},"skos:altLabel":{"@language":"en","@value":"Ballroom houses"},"rdfs:comment":{"@language":"en","@value":"In ball culture, ballroom families (or houses) are chosen families headed by and named after established community members (e.g., the House of Xtravaganza); heads of ballroom families are typically called \"mothers\" or \"fathers,\" while members are termed \"children\" and \"siblings.\""},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000092"},{"@id":"https://homosaurus.org/v3/homoit0000834"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000371"},{"@id":"https://homosaurus.org/v3/homoit0001101"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ballroomFamilies"},"dc:issued":