66"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001047"},{"@id":"https://homosaurus.org/v3/homoit0001049"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85060354"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/herbalTreatments"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000674","dc:identifier":"homoit0000674","skos:prefLabel":{"@language":"en","@value":"Intersex youth"},"skos:altLabel":[{"@language":"en","@value":"Intersex adolescents"},{"@language":"en","@value":"Intersex teenagers"},{"@language":"en","@value":"Intersex teens"}],"rdfs:comment":{"@language":"en","@value":"Intersex people between the age of childhood and adulthood."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000618"},{"@id":"https://homosaurus.org/v3/homoit0001520"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000668"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001521"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexYouth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-18"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000631","dc:identifier":"homoit0000631","skos:prefLabel":{"@language":"en","@value":"Heterosexuality"},"rdfs:comment":{"@language":"en","@value":"Romantic and sexual attraction to members of the opposite sex or gender, typically in a culture that understands sex and gender through the binary opposition of male/female or man/woman."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001298"},{"@id":"https://homosaurus.org/v3/homoit0001556"}],"