":"http://id.loc.gov/authorities/subjects/sh2011002609"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderExpression"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000389","dc:identifier":"homoit0000389","skos:prefLabel":{"@language":"en","@value":"Femininities"},"skos:altLabel":[{"@language":"en","@value":"Effeminacy"},{"@language":"en","@value":"Femininity"}],"rdfs:comment":{"@language":"en","@value":"Culture-specific sets of attributes, behaviors, and roles generally associated with women or girls."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000568"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000047"},{"@id":"https://homosaurus.org/v3/homoit0000440"},{"@id":"https://homosaurus.org/v3/homoit0000577"},{"@id":"https://homosaurus.org/v3/homoit0000995"},{"@id":"https://homosaurus.org/v3/homoit0001382"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85047739"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/femininity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000562","dc:identifier":"homoit0000562","skos:prefLabel":{"@language":"en","@value":"Gender bending"},"rdfs:comment":{"@language":"en","@value":"The practice of transgressing or \"bending\" expected gender roles, which often involves adopting or exaggerating stereotypically feminine or masculine traits to expose them as artificial. Gender bending is similar to drag, though drag is often associated with artistic or stage performances, whereas gender bending is typically enacted in everyday life."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000568"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000047"},{"@id":"https://homosaurus.org/v3/homoit0000577"},{"@id":"https://homosaurus.org/v3/homoit0001756"},{"@id":"https://homosaurus.org/v3/homoit0001816"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderBending"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000577","dc:identifier":"homoit0000577","skos:prefLabel":{"@language":"en","@value":"Gender roles"},"rdfs:comment":{"@language":"en","@value":"Socially-determined rules or standards for gendered behaviors. Some LGBTQ+ people identify with gender roles that exist outside of the gender binary (e.g., butches, femmes, twinks, bears). Use the term \"Gender role stereotypes\" to describe widely held but oversimplified or offensive ideas regarding gender roles."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001241"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000105"},{"@id":"https://homosaurus.org/v3/homoit0000231"},{"@id":"https://homosaurus.org/v3/homoit0000321"},{"@id":"https://homosaurus.org/v3/homoit0000326"},{"@id":"https://homosaurus.org/v3/homoit0000440"},{"@id":"https://homosaurus.org/v3/homoit0000655"},{"@id":"https://homosaurus.org/v3/homoit0001063"},{"@id":"https://homosaurus.org/v3/homoit0001313"},{"@id":"https://homosaurus.org/v3/homoit0001374"},{"@id":"https://homosaurus.org/v3/homoit0001479"},{"@id":"https://homosaurus.org/v3/homoit0001508"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000047"},{"@id":"https://homosaurus.org/v3/homoit0000389"},{"@id":"https://homosaurus.org/v3/homoit0000562"},{"@id":"https://homosaurus.org/v3/homoit0000563"},{"@id