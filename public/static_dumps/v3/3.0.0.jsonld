ms or legs apart."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001238"},{"@id":"https://homosaurus.org/v3/homoit0001266"},{"@id":"https://homosaurus.org/v3/homoit0003059"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0003117"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/spreaderBars"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001287","dc:identifier":"homoit0001287","skos:prefLabel":[{"@language":"en-us","@value":"Sexual behavior change"},{"@language":"en-gb","@value":"Sexual behaviour change"}],"rdfs:comment":{"@language":"en","@value":"Term used to describe changes in behavior related to safer sexual practices (e.g., condom use, STI testing)."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001239"},{"@id":"https://homosaurus.org/v3/homoit0001251"},{"@id":"https://homosaurus.org/v3/homoit0001300"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001287"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualBehaviourChange"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001243","dc:identifier":"homoit0001243","skos:prefLabel":{"@language":"en","@value":"Rope play"},"skos:altLabel":{"@language":"en","@value":"Shibari"},"rdfs:comment":{"@language":"en","@value":"Bondage involving the use of rope for sexual stimulation."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001266"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ropePlay"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@ty