oit0000959"},{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001124"},{"@id":"https://homosaurus.org/v3/homoit0001133"},{"@id":"https://homosaurus.org/v3/homoit0001267"},{"@id":"https://homosaurus.org/v3/homoit0001299"},{"@id":"https://homosaurus.org/v3/homoit0002195"},{"@id":"https://homosaurus.org/v3/homoit0002215"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh98003848"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000302"},"dc:replaces":{"@id":"http://homosaurus.org/v2/consent"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000663","dc:identifier":"homoit0000663","skos:prefLabel":{"@language":"en","@value":"Intergenerational relationships"},"rdfs:comment":{"@language":"en","@value":"Ongoing connections (romantic, sexual, play, or platonic) between two or more people of different age groups or from different generations."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001237"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000020"},{"@id":"https://homosaurus.org/v3/homoit0001295"},{"@id":"https://homosaurus.org/v3/homoit0001636"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85067264"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intergenerationalRelationships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001289","dc:identifier":"homoit0001289","skos:prefLabel":{"@language":"en","@value":"Sexual offences laws"},"skos:altLabel":{"@language":"en","@value":"Sexual criminal codes"},"rdfs:comment":{"@language":"en","@value":"Legislation determining the kinds of sexual behaviors and activities that are legally permissible. Laws vary by jurisdiction but typically address crimes like sexual coercion, sexual assault, incest, and sex trafficking. Historically and in the present day, sexual offenses laws have also served to criminalize consensual but non-normative sexual practices, such as anal sex and homosexuality."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000313"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001326"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000020"},{"@id":"https://homosaurus.org/v3/homoit0002373"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualOffencesLaws"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000021","dc:identifier":"homoit0000021","skos:prefLabel":{"@language":"en","@value":"Agender people"},"rdfs:comment":{"@language":"en","@value":"People who identify as not having a gender, or being genderless."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001817"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000571"},{"@id":"https://homosaurus.org/v3/homoit0001048"},{"@id":"https://homosaurus.org/v3/homoit0001927"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/agenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001378","dc:identifier":"homoit0001378","skos:prefLabel":{"@language":"en","@value":"Transgender people"},"skos:altLa