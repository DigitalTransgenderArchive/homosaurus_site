":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000586","dc:identifier":"homoit0000586","skos:prefLabel":{"@language":"en","@value":"Gerontophilia"},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000442"},{"@id":"https://homosaurus.org/v3/homoit0001300"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000393"},{"@id":"https://homosaurus.org/v3/homoit0000663"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000404"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000442"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gerontophilia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-11-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000623","dc:identifier":"homoit0000623","skos:prefLabel":{"@language":"en","@value":"Heterosexual girls"},"skos:altLabel":{"@language":"en","@value":"Straight girls"},"rdfs:comment":{"@language":"en","@value":"Girls (typically children or youth younger than 18) who are heterosexual."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000590"},{"@id":"https://homosaurus.org/v3/homoit0000630"},{"@id":"https://homosaurus.org/v3/homoit0002285"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexualGirls"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000691","dc:identifier":"homoit0000691","skos:prefLabel":{"@language":"en","@value":"Kissing"},"rdfs:comment":{"@language":"en","@value":"Touching or pressing one's lips to another person or an object to communicate a greeting, affection, reverence, love, or sexual desire."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000593"},{"@id":"https://homosaurus.org/v3/homoit0001112"},{"@id":"https://homosaurus.org/v3/homoit0001267"},{"@id":"https://homosaurus.org/v3/homoit0001299"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85072549"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/kissing"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000703","dc:identifier":"homoit0000703","skos:prefLabel":{"@language":"en","@value":"LBT"},"rdfs:comment":{"@language":"en","@value":"Acronym used to describe lesbians, bisexuals, and transgender people as a group."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000594"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000805"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LBT"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-09"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000596","dc:identifier":"homoit0000596","skos:prefLabel":{"@language":"en","@value":"Goddess movement"},"skos:altLabel":[{"@language":"en","@value":"Goddess movement (Lesbians)"},{"@language":"en","@value":"Goddess religion"}],"rdfs:comment":{"@language":"en","@value":"A spiritual movement that emerged in North America, Western Europe, Australia, and New Zealand in 1970s in response to male-dominated organized religion; involves worshiping the Goddess (or several goddesses), as well as a focus on women, femininity, and feminism; often associated with lesbian communities."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001069"},{"@id":"https://homosaurus.org/v3/homoit0001907"},{"@id":"https://homosaurus.org/v3/homoit0001908"},{"@id":"https://homosaurus.org/v3/homoit0001909"},{"@id":"https://homosaurus.org/v3/homoit0001910"},{"@id":"https://homosaurus.org/v3/homoit0001911"},{"@id":"https://homosaurus.org/v3/homoit0001912"},{"@id":"https://homosaurus.org/v3/homoit0001913"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh89003267"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000596"},"dc:replaces":{"@id":"http://homosaurus.org/v2/goddessMovementLesbian"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000599","dc:identifier":"homoit0000599","skos:prefLabel":{"@language":"en","@value":"Gonadal dysgenesis"},"rdfs:comment":{"@language":"en","@value":"A term that refers to a group of different variations that affect the development of the gonads before birth."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85138930"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gonadalDysgenesis"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000600","dc:identifier":"homoit0000600","skos:prefLabel":{"@language":"en","@value":"Gonads"},"rdfs:comment":{"@language":"en","@value":"A general term used to describe testes, ovaries, or ovotestes."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001269"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001361"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001268"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85055840"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gonads"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000605","dc:identifier":"homoit0000605","skos:prefLabel":{"@language":"en","@value":"Hair"},"rdfs:comment":{"@language":"en","@value":"Threadlike strands of keratin growing out of the skin on the body. Use in reference to hair as a secondary sex characteristic or as a form of self expression."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001259"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85058305"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hair"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000607","dc:identifier":"homoit0000607","skos:prefLabel":{"@language":"en","@value":"Halloween"},"skos:altLabel":[{"@language":"en","@value":"Gay Christmas"},{"@language":"en","@value":"Gay Halloween"}],"rdfs:comment":{"@language":"en","@value":"The celebration of Halloween, often called Gay Christmas, by LGBTQ+ people. Typically involves dressing in drag or elaborate costumes as a form of gender play and attending large parties in LGBTQ+ neighborhoods or establishments."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000861"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001808"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85058475"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000861"},"dc:replaces":{"@id":"http://homosaurus.org/v2/halloween"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-11-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000608","dc:identifier":"homoit0000608","skos:prefLabel":{"@language":"en","@value":"Handcuffs"},"skos:altLabel":{"@language":"en","@value":"Handcuff restraints"},"rdfs:comment":{"@language":"en","@value":"A restraint device designed to secure an individual’s wrists."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0003117"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85058662"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/handcuffs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001121","dc:identifier":"homoit0001121","skos:prefLabel":{"@language":"en","@value":"Police harassment"},"skos:altLabel":[{"@language":"en","@value":"Harrassment by police"},{"@language":"en","@value":"Misconduct by police"},{"@language":"en","@value":"Mistreatment by police"},{"@language":"en","@value":"Police misconduct"},{"@language":"en","@value":"Police mistreatment"}],"rdfs:comment":{"@language":"en","@value":"Any of various forms of inappropriate conduct, illegal actions, or abuses of power undertaken by law enforcement agents or agents of the state against members of the public. This includes but is not limited to racial, ethnic, and other forms of profiling; unwarranted surveillance, searches, and seizure; selective enforcement; excessive use of force; sexual misconduct; intimidation and witness tampering; falsification of evidence; coerced confessions; false arrests and imprisonment; and bribing or lobbying."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000611"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001120"},{"@id":"https://homosaurus.org/v3/homoit0001122"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh95010616"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000611"},"dc:replaces":{"@id":"http://homosaurus.org/v2/policeHarassment"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000792","dc:identifier":"homoit0000792","skos:prefLabel":{"@language":"en","@value":"Lesbian victims of hate crimes"},"rdfs:comment":{"@language":"en","@value":"Lesbians who have experienced hate crimes and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000613"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000782"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianVictimsOfHateCrimes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001221","dc:identifier":"homoit0001221","skos:prefLabel":{"@language":"en","@value":"Queer victims of hate crimes"},"rdfs:comment":{"@language":"en","@value":"Queer people who have experienced hate crimes and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000613"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001211"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerVictimsOfHateCrimes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001456","dc:identifier":"homoit0001456","skos:prefLabel":{"@language":"en","@value":"Transgender victims of hate crimes"},"rdfs:comment":{"@language":"en","@value":"Transgender people who have experienced hate crimes and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000613"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001448"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderVictimsOfHateCrimes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001113","dc:identifier":"homoit0001113","skos:prefLabel":{"@language":"en","@value":"Physical health care for LGBTQ people"},"skos:altLabel":{"@language":"en","@value":"Physical health care for LGBTQ people"},"rdfs:comment":{"@language":"en","@value":"Organized measures taken for the maintenance, treatment, or improvement of physical health or conditions of the body; use in reference to physical health care addressing the particular needs of LGBTQ+ individuals or communities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000614"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000614"},"dc:replaces":{"@id":"http://homosaurus.org/v2/physicalHealthCareForLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id