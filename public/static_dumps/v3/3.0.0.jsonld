{"@language":"en","@value":"Therapeutic techniques and treatments derived from cognitive psychology that are designed to identify and potentially change behaviors perceived as self-destructive or unhealthy. Includes behavioral therapy intended to alter an individual's sexual or gender identity or expression."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001366"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000084"},{"@id":"https://homosaurus.org/v3/homoit0000303"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85012900"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/behaviouralTherapy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000303","dc:identifier":"homoit0000303","skos:prefLabel":{"@language":"en","@value":"Sexual reorientation"},"skos:altLabel":[{"@language":"en","@value":"Reparative therapy"},{"@language":"en","@value":"Reorientation therapy"},{"@language":"en","@value":"Sexual reorientation therapy"}],"rdfs:comment":{"@language":"en","@value":"Efforts to change the sexual or gender identity of an individual who is or is suspected to be LGBTQ+ to meet heterosexual or cisgender norms, typically under the belief that being LGBTQ+ is dangerous and/or the result of mental illness or trauma. The processes involved in conversion therapy include visualization training, spiritual interventions, and other aversion treatments. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000106"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006004076"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualReorientation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000085","dc:identifier":"homoit0000085","skos:prefLabel":{"@language":"he","@value":"Aylonit"},"rdfs:comment":{"@language":"en","@value":"Israeli term referring to a woman with masculine development who is usually infertile."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/aylonit"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000086","dc:identifier":"homoit0000086","skos:prefLabel":{"@language":"en","@value":"Bondage"},"skos:altLabel":[{"@language":"en","@value":"Erotic bondage"},{"@language":"en","@value":"Sexual bondage "}],"rdfs:comment":{"@language":"en","@value":"The act of tying up or restraining the body, usually with rope, cuffs, tape, or other adhesive, for the purposes of erotic enjoyment or aesthetic appreciation."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000442"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001238"},{"@id":"https://homosaurus.org/v3/homoit0003059"},{"@id":"https://homosaurus.org/v3/homoit0003090"},{"@id":"https://homosaurus.org/v3/homoit0003117"},{"@id":"https://homosaurus.org/v3/homoit0003134"},{"@id":"https://homosaurus.org/v3/homoit0003146"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85015498"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bondage"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}}