[{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001521"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001400"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001462"},{"@id":"https://homosaurus.org/v3/homoit0003502"},{"@id":"https://homosaurus.org/v3/homoit0003514"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007003739"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderYouth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001380","dc:identifier":"homoit0001380","skos:prefLabel":{"@language":"en","@value":"Transsexuality"},"skos:altLabel":{"@language":"en","@value":"Transexuality"},"rdfs:comment":{"@language":"en","@value":"Term used to describe the identity of people who transition from female to male or male to female. Generally refers to individuals who transition their physical bodies to align with their gender identities. Though this term was popular in the 20th century and is still in use today, it has been largely replaced by \"transgender identity\" and \"trans identity.\" Some but not all people regard this term as outdated and offensive. Only use to describe people who self-identify as transsexual."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001381"},{"@id":"https://homosaurus.org/v3/homoit0001468"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001380"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transsexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001462","dc:identifier":"homoit000146