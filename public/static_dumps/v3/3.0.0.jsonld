68","dc:identifier":"homoit0000868","skos:prefLabel":{"@language":"en","@value":"LGBTQ film festivals"},"skos:altLabel":{"@language":"en","@value":"LGBTQ film festivals"},"rdfs:comment":{"@language":"en","@value":"Organized presentations of films in a single location, often with prizes awarded in various categories; use in reference to film festivals focusing on films created by LGBTQ+ people or featuring LGBTQ+ characters and themes."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000869"},{"@id":"https://homosaurus.org/v3/homoit0002327"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000868"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQFilmFestivals"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001094","dc:identifier":"homoit0001094","skos:prefLabel":{"@language":"en","@value":"Pederasts"},"rdfs:comment":{"@language":"en","@value":"Adult men who have sexual and mentor/protégé relationships with adolescent boys. This term has historically been used to describe gay men. Only use in historical contexts."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000878"},{"@id":"https://homosaurus.org/v3/homoit0001295"},{"@id":"https://homosaurus.org/v3/homoit0001300"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001095"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pederasts"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001095","dc:identifier":"homoit0001095","skos:prefLabel":{"@language":"en","@value":"Pederasty"},"rdfs:comment":{"@language":"en","@value":"Term used to describe the practices of adult men who engage in sexual and mentor/protégé relationships with adolescent boys. This term has historically been used to describe the practices of gay men. Only use in historical contexts."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000878"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001094"},{"@id":"https://homosaurus.org/v3/homoit0001300"},{"@id":"https://homosaurus.org/v3/homoit0001325"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pederasty"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001484","dc:identifier":"homoit0001484","skos:prefLabel":{"@language":"en","@value":"Uranians"},"skos:altLabel":{"@language":"en","@value":"Urnings"},"rdfs:comment":{"@language":"en","@value":"19th century term used to refer to gender and sexual minorities; use only in historical contexts."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000878"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001297"},{"@id":"https://homosaurus.org/v3/homoit0001564"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/uranians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000879","dc:identifier":"homoit0000879","skos:prefLabel":{"@language":"en","@value":"LGBTQ homeless people"},"skos:altLabel":[{"@language":"en","@value":"LGBTQ homeless people"},{"@language":"en","@value":"LGBTQ houseless people"},{"@language":"en","@value":"LGBTQ unsheltered people"},{"@language":"en","@value":"Unhoused people (LGBT)"}],"rdfs:comment":{"@language":"e