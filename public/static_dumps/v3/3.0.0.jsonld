ice raid that took place on June 28, 1969 at the Stonewall Inn in the Greenwich Village neighborhood of New York City."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000932"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000500"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh92005716"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000932"},"dc:replaces":{"@id":"http://homosaurus.org/v2/stonewallRiots"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000501","dc:identifier":"homoit0000501","skos:prefLabel":{"@language":"en","@value":"Gay libraries"},"rdfs:comment":{"@language":"en","@value":"Libraries that hold materials primarily pertaining to gay men or intended for use by gay men."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000968"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh89000080"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayLibraries"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000502","dc:identifier":"homoit0000502","skos:prefLabel":{"@language":"en","@value":"Gay literature"},"rdfs:comment":{"@language":"en","@value":"Written literary works about gay men, gay characters, or gay themes."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000972"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001725"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayLiterature"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd