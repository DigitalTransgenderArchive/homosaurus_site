{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dc":"http://purl.org/dc/terms/","rdfs":"http://www.w3.org/2000/01/rdf-schema#","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@id":"https://homosaurus.org/v3/homoit0000001","dc:identifier":"homoit0000001","skos:prefLabel":{"@language":"en","@value":"5-alpha reductase deficiency"},"skos:altLabel":{"@language":"en","@value":"5-ARD"},"rdfs:comment":{"@language":"en","@value":"People with 5-alpha reductase deficiency, abbreviated as 5-ARD, have XY chromosomes, testes, and typical levels of testosterone, but their bodies do not have the enzyme responsible for converting testosterone to the more powerful androgen dihydrotestosterone (DHT). This affects how an individual's external sex characteristics develop, and people born with 5-ARD often have genital differences that are noticed at birth. In adolescence, people with 5-ARD typically develop some features associated with testosterone puberty, and they may experience genital growth at this point."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/5AlphaReductaseDeficiency"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000669","dc:identifier":"homoit0000669","skos:prefLabel":{"@language":"en","@value":"Intersex conditions"},"skos:altLabel":{"@language":"en","@value":"Intersex conditions"},"rdfs:comment":{"@language":"en","@value":"Term used to refer to a wide range of variations in sex characteristics. The term \"intersex conditions\" is a pathologizing term used to mean people born with variations in their physical sex characteristics also known as intersex traits."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000352"},{"@id":"https://homosaurus.org/v3/homoit0001006"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000001"},{"@id":"https://homosaurus.org/v3/homoit0000044"},{"@id":"https://homosaurus.org/v3/homoit0000064"},{"@id":"https://homosaurus.org/v3/homoit0000283"},{"@id":"https://homosaurus.org/v3/homoit0000301"},{"@id":"https://homosaurus.org/v3/homoit0000599"},{"@id":"https://homosaurus.org/v3/homoit0000657"},{"@id":"https://homosaurus.org/v3/homoit0000692"},{"@id":"https://homosaurus.org/v3/homoit0001014"},{"@id":"https://homosaurus.org/v3/homoit0001020"},{"@id":"https://homosaurus.org/v3/homoit0001066"},{"@id":"https://homosaurus.org/v3/homoit0001079"},{"@id":"https://homosaurus.org/v3/homoit0001134"},{"@id":"https://homosaurus.org/v3/homoit0001354"},{"@id":"https://homosaurus.org/v3/homoit0001478"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000618"},{"@id":"https://homosaurus.org/v3/homoit0001268"},{"@id":"https://homosaurus.org/v3/homoit0001646"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85060401"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexConditions"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001269","dc:identifier":"homoit0001269","skos:prefLabel":{"@language":"en","@value":"Sex (Body)"},"rdfs:comment":{"@language":"en","@value":"The category assigned to an individual to describe their body and its role in sexual reproduction, usually based on external anatomy, but also including chromosomes, gene expression, hormones, and internal and external reproductive/sexual organs. Although sex is often described as binary, it exists as a spectrum with significant variation in the biological attributes that comprise sex and the way it is defined in different cultural contexts."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000266"},{"@id":"https://homosaurus.org/v3/homoit0000352"},{"@id":"https://homosaurus.org/v3/homoit0000585"},{"@id":"https://homosaurus.org/v3/homoit0000600"},{"@id":"https://homosaurus.org/v3/homoit0000651"},{"@id":"https://homosaurus.org/v3/homoit0001259"},{"@id":"https://homosaurus.org/v3/homoit0001648"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000560"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120560"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexBody"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000002","dc:identifier":"homoit0000002","skos:prefLabel":{"@language":"en","@value":"LGBTQ Aboriginal people"},"skos:altLabel":[{"@language":"en","@value":"Aboriginal people (LGBTQ)"},{"@language":"en","@value":"Aboriginal Australian people (LGBTQ)"},{"@language":"en","@value":"LGBTQ Aboriginal Australian people"},{"@language":"en","@value":"LGBTQ Aboriginal Australians"},{"@language":"en","@value":"LGBTQ Aboriginal people"},{"@language":"en","@value":"LGBTQ Aboriginals"}],"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who belong to one or more of the various Indigenous peoples of Australia; do not use to refer to the Indigenous people of the Torres Strait Islands, who are considered ethnically and culturally distinct. Only use to describe people who identify as Aboriginal Australian."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000886"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001314"},{"@id":"https://homosaurus.org/v3/homoit0001809"},{"@id":"https://homosaurus.org/v3/homoit0001810"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQAboriginalPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000886","dc:identifier":"homoit0000886","skos:prefLabel":{"@language":"en","@value":"LGBTQ indigenous people"},"skos:altLabel":[{"@language":"en","@value":"Indigenous people (LGBTQ)"},{"@language":"en","@value":"LGBTQ Indigenous people"}],"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who are part of an Indigenous people, or culturally distinct ethnic group whose members are directly descended from the earliest known inhabitants of a particular region and, to some extent, maintain the language and culture of those people. Only use to describe people who identify as Indigenous; use more specific terms whenever possible."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001101"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000002"},{"@id":"https://homosaurus.org/v3/homoit0000676"},{"@id":"https://homosaurus.org/v3/homoit0000898"},{"@id":"https://homosaurus.org/v3/homoit0000913"},{"@id":"https://homosaurus.org/v3/homoit0001037"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000098"},{"@id":"https://homosaurus.org/v3/homoit0000860"},{"@id":"https://homosaurus.org/v3/homoit0001240"},{"@id":"https://homosaurus.org/v3/homoit0001480"},{"@id":"https://homosaurus.org/v3/homoit0001812"},{"@id":"https://homosaurus.org/v3/homoit0001914"},{"@id":"https://homosaurus.org/v3/homoit0001928"},{"@id":"https://homosaurus.org/v3/homoit0001961"},{"@id":"https://homosaurus.org/v3/homoit0002377"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQIndigenousPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001314","dc:identifier":"homoit0001314","skos:prefLabel":{"@language":"en","@value":"Sistergirls"},"skos:altLabel":{"@language":"en","@value":"Sistagirls"},"rdfs:comment":{"@language":"en","@value":"Indigenous Australian term for people who transition from male to female."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000002"},{"@id":"https://homosaurus.org/v3/homoit0000224"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sistergirls"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000915","dc:identifier":"homoit0000915","skos:prefLabel":{"@language":"en","@value":"LGBTQ people"},"skos:altLabel":[{"@language":"en","@value":"Gay people"},{"@language":"en","@value":"LGBTQ people"},{"@language":"en","@value":"People (LGBTQ)"}],"rdfs:comment":{"@language":"en","@value":"Self-identified lesbians, gay men, bisexual people, transgender people, queer people, and other sexual and gender minorities."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000007"},{"@id":"https://homosaurus.org/v3/homoit0000008"},{"@id":"https://homosaurus.org/v3/homoit0000070"},{"@id":"https://homosaurus.org/v3/homoit0000082"},{"@id":"https://homosaurus.org/v3/homoit0000108"},{"@id":"https://homosaurus.org/v3/homoit0000170"},{"@id":"https://homosaurus.org/v3/homoit0000312"},{"@id":"https://homosaurus.org/v3/homoit0000330"},{"@id":"https://homosaurus.org/v3/homoit0000379"},{"@id":"https://homosaurus.org/v3/homoit0000393"},{"@id":"https://homosaurus.org/v3/homoit0000506"},{"@id":"https://homosaurus.org/v3/homoit0000556"},{"@id":"https://homosaurus.org/v3/homoit0000618"},{"@id":"https://homosaurus.org/v3/homoit0000860"},{"@id":"https://homosaurus.org/v3/homoit0000862"},{"@id":"https://homosaurus.org/v3/homoit0000879"},{"@id":"https://homosaurus.org/v3/homoit0000887"},{"@id":"https://homosaurus.org/v3/homoit0000895"},{"@id":"https://homosaurus.org/v3/homoit0000902"},{"@id":"https://homosaurus.org/v3/homoit0000908"},{"@id":"https://homosaurus.org/v3/homoit0000927"},{"@id":"https://homosaurus.org/v3/homoit0000961"},{"@id":"https://homosaurus.org/v3/homoit0001009"},{"@id":"https://homosaurus.org/v3/homoit0001073"},{"@id":"https://homosaurus.org/v3/homoit0001195"},{"@id":"https://homosaurus.org/v3/homoit0001329"},{"@id":"https://homosaurus.org/v3/homoit0001352"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001482"},{"@id":"https://homosaurus.org/v3/homoit0001510"},{"@id":"https://homosaurus.org/v3/homoit0001549"},{"@id":"https://homosaurus.org/v3/homoit0001550"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001297"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2004003385"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000003","dc:identifier":"homoit0000003","skos:prefLabel":{"@language":"en","@value":"Acault"},"rdfs:comment":{"@language":"en","@value":"A commonly mistranslated Burmese term for people assigned male at birth who exhibit feminine behaviors while serving as spiritual mediums; there is some question over the legitimacy of term."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/acault"},"dc:issued":{"@typ