homoit0000202"},{"@id":"https://homosaurus.org/v3/homoit0000285"},{"@id":"https://homosaurus.org/v3/homoit0001054"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000117"},{"@id":"https://homosaurus.org/v3/homoit0000133"},{"@id":"https://homosaurus.org/v3/homoit0000134"},{"@id":"https://homosaurus.org/v3/homoit0000136"},{"@id":"https://homosaurus.org/v3/homoit0000139"},{"@id":"https://homosaurus.org/v3/homoit0000143"},{"@id":"https://homosaurus.org/v3/homoit0000144"},{"@id":"https://homosaurus.org/v3/homoit0000150"},{"@id":"https://homosaurus.org/v3/homoit0000153"},{"@id":"https://homosaurus.org/v3/homoit0000173"},{"@id":"https://homosaurus.org/v3/homoit0000204"},{"@id":"https://homosaurus.org/v3/homoit0001073"},{"@id":"https://homosaurus.org/v3/homoit0001103"},{"@id":"https://homosaurus.org/v3/homoit0001531"},{"@id":"https://homosaurus.org/v3/homoit0002150"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93003390"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001073","dc:identifier":"homoit0001073","skos:prefLabel":{"@language":"en","@value":"Pansexual people"},"skos:altLabel":{"@language":"en","@value":"Omnisexual"},"rdfs:comment":{"@language":"en","@value":"Individuals who self-identify as pansexual, meaning that they are sexually attracted to people of all genders. Some but not all pansexual people also identify as \"gender-blind\" because gender is insignificant or irrelevant in determining their attraction."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000108"},{"@id":"https://homosaurus.org/v3/homoit0000915"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000170"},{"@id":"https://homosaurus.org/v3/homoit0001381"},{"@id":"https://homosaurus.org/v3/homoit0001531"},{"@id":"https://homosaurus.org/v3/homoit0001926"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pansexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001195","dc:identifier":"homoit0001195","skos:prefLabel":{"@language":"en","@value":"Queer people"},"rdfs:comment":{"@language":"en","@value":"Individuals who identify with non-normative gender and/or sexual identities, typically people who are not heterosexual and/or are not cisgender. Only use for people who identify as queer."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000108"},{"@id":"https://homosaurus.org/v3/homoit0000915"},{"@id":"https://homosaurus.org/v3/homoit0001559"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000582"},{"@id":"https://homosaurus.org/v3/homoit0001185"},{"@id":"https://homosaurus.org/v3/homoit0001215"},{"@id":"https://homosaurus.org/v3/homoit0001220"},{"@id":"https://homosaurus.org/v3/homoit0001227"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001077"},{"@id":"https://homosaurus.org/v3/homoit0001106"},{"@id":"https://homosaurus.org/v3/homoit0001166"},{"@id":"https://homosaurus.org/v3/homoit0001176"},{"@id":"https://homosaurus.org/v3/homoit0001178"},{"@id":"https://homosaurus.org/v3/homoit0001194"},{"@id":"https://homosaurus.org/v3/homoit0001229"},{"@id":"https://homosaurus.org/v3/homoit0001921"},{"@id":"https://homosaurus.org/v3/homoit0002193"},{"@id":"https://homosaurus.org/v3/homoit0002577"},{"@id":"https://homosaurus.org/v3/homoit0002588"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000112","dc:identifier":"homoit0000112","skos:prefLabel":{"@language":"en","@value":"Intolerance towards LGBTQ people"},"skos:altLabel":[{"@language":"en","@value":"Bigotry towards LGBTQ people"},{"@language":"en","@value":"Prejudice towards LGBTQ people"},{"@language":"en","@value":"Intolerance towards LGBTQ people"}],"rdfs:comment":{"@language":"en","@value":"Unwillingness to accept or affirm LGBTQ+ people or their identities in attitude or practice."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000109"},{"@id":"https://homosaurus.org/v3/homoit0000341"},{"@id":"https://homosaurus.org/v3/homoit0000356"},{"@id":"https://homosaurus.org/v3/homoit0000643"},{"@id":"https://homosaurus.org/v3/homoit0001015"},{"@id":"https://homosaurus.org/v3/homoit0001017"},{"@id":"https://homosaurus.org/v3/homoit0001561"},{"@id":"https://homosaurus.org/v3/homoit0001885"},{"@id":"https://homosaurus.org/v3/homoit0001892"},{"@id":"https://homosaurus.org/v3/homoit0001893"},{"@id":"https://homosaurus.org/v3/homoit0001903"},{"@id":"https://homosaurus.org/v3/homoit0002899"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000112"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intoleranceTowardsLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-07-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000341","dc:identifier":"homoit0000341","skos:prefLabel":{"@language":"en","@value":"Hate speech"},"skos:altLabel":[{"@language":"en","@value":"Defamation against groups"},{"@language":"en","@value":"Group defamation"},{"@language":"en","@value":"Group libel"}],"rdfs:comment":{"@language":"en","@value":"Any form of expression (written or verbal) with the intention to vilify, humiliate, or incite hatred against a individual or group of people on the basis of their actual or perceived race, religion, nationality, sexual identity, gender identity, or ability status."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000109"},{"@id":"https://homosaurus.org/v3/homoit0000112"},{"@id":"https://homosaurus.org/v3/homoit0000850"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93004962"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000341"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hateSpeech"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000110","dc:identifier":"homoit0000110","skos:prefLabel":{"@language":"en","@value":"Bigender identity"},"rdfs:comment":{"@language":"en","@value":"Term used to describe the identities of people who have two genders."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000571"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000111"},{"@id":"https://homosaurus.org/v3/homoit0000569"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bigenderIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000111","dc:identifier":"homoit0000111","skos:prefLabel":{"@language":"en","@value":"Bigender people"},"rdfs:comment":{"@language":"en","@value":"People who identify as any two genders, either simultaneously or more fluidly."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001378"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000110"},{"@id":"https://homosaurus.org/v3/homoit0000570"}],"skos:h