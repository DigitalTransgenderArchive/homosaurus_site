oit0001323"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000004"},{"@id":"https://homosaurus.org/v3/homoit0000071"},{"@id":"https://homosaurus.org/v3/homoit0000343"},{"@id":"https://homosaurus.org/v3/homoit0000344"},{"@id":"https://homosaurus.org/v3/homoit0000356"},{"@id":"https://homosaurus.org/v3/homoit0001531"},{"@id":"https://homosaurus.org/v3/homoit0001650"},{"@id":"https://homosaurus.org/v3/homoit0001917"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001323"},"dc:replaces":{"@id":"http://homosaurus.org/v2/compulsorySexuality"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-18"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001644","dc:identifier":"homoit0001644","skos:prefLabel":{"@language":"en","@value":"Aromanticism"},"skos:altLabel":{"@language":"en","@value":"Aromantic"},"rdfs:comment":{"@language":"en","@value":"A romantic orientation generally characterized by a lack of romantic attraction or desire."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001828"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000004"},{"@id":"https://homosaurus.org/v3/homoit0000067"},{"@id":"https://homosaurus.org/v3/homoit0001791"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001828"},"dc:replaces":{"@id":"http://homosaurus.org/v2/aromanticism"},"dc:issued":{"@type":"xsd:date","@value":"2021-03-04"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000005","dc:identifier":"homoit0000005","skos:prefLabel":{"@language":"en","@value":"HIV/AIDS"},"skos:altLabel":[{"@language":"en","@value":"Acquired immune deficiency syndrome"},{"@language":"en","@value":"AIDS"},{"@language":"en","@value":"Acquired immunodeficiency syndrome"},{"@language":"en","@value":"HIV"},{"