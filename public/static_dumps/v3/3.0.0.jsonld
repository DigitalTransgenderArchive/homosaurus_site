efLabel":{"@language":"en","@value":"Lesbian identity"},"rdfs:comment":{"@language":"en","@value":"Term used to describe the sexual identity of women and femmes who are romantically and/or sexually attracted to other women and femmes. However, not all lesbians are women, and gender non-conforming people who belong to lesbian communities have often identified as lesbian."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001295"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000556"},{"@id":"https://homosaurus.org/v3/homoit0000786"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh94004083"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000802","dc:identifier":"homoit0000802","skos:prefLabel":{"@language":"en","@value":"Parents of lesbians"},"skos:altLabel":{"@language":"en","@value":"Lesbians' parents"},"rdfs:comment":{"@language":"en","@value":"People who act as parents to one or more lesbian. For parents who are themselves lesbians, use the term \"Lesbian parents.\""},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002224"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000556"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/parentsOfLesbians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001105","dc:identifier":"homoit0001105","skos:prefLabel":{"@language":"en","@value":"Persecution of lesbians"},"rdfs:comment":{"@language":"en","@value":"Systematic mistreatment of lesbians on the basis of their sexual identity."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001108"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000556"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001108"},"dc:replaces":{"@id":"http://homosaurus.org/v2/persecutionOfLesbians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001227","dc:identifier":"homoit0001227","skos:prefLabel":{"@language":"en","@value":"Queer women"},"rdfs:comment":{"@language":"en","@value":"Women who identify as queer."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001195"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000556"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerWomen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001472","dc:identifier":"homoit0001472","skos:prefLabel":{"@language":"en","@value":"Tribades"},"rdfs:comment":{"@language":"en","@value":"Historical term for individuals who engage in the sexual practice of tribadism; use only in historical contexts."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000878"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000556"},{"@id":"https://homosaurus.org/v3/homoit0001669"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tribades"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000559","dc:identifier":"homoit0000559","skos:prefLabel":{"@language":"en","@value":"Gaydar"},"rdfs:comment":{"@language":"en","@value":"Term describing a person's intuitive ability to identify others' sexual orientations."},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001298"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000559"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gaydar"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000561","dc:identifier":"homoit0000561","skos:prefLabel":{"@language":"en","@value":"Gender confirming surgery"},"skos:altLabel":[{"@language":"en","@value":"Gender affirmation surgery"},{"@language":"en","@value":"Gender confirmation surgery"},{"@language":"en","@value":"Gender realignment surgery"},{"@language":"en","@value":"Gender reassignment surgery"},{"@language":"en","@value":"Sex reassignment surgery"},{"@language":"en","@value":"SRS"}],"rdfs:comment":{"@language":"en","@value":"Any of various surgeries undertaken to affirm an individual's gender. Most often applied to transgender people, but may also refer to certain procedures undergone by cisgender and intersex people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001004"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000584"},{"@id":"https://homosaurus.org/v3/homoit0001040"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000560"},{"@id":"https://homosaurus.org/v3/homoit0001049"},{"@id":"https://homosaurus.org/v3/homoit0001129"},{"@id":"https://homosaurus.org/v3/homoit0001131"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001381"},{"@id":"https://homosaurus.org/v3/homoit0001464"},{"@id":"https://homosaurus.org/v3/homoit0001465"},{"@id":"https://homosaurus.org/v3/homoit0003504"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2020000651"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderConfirmingSurgery"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000565","dc:identifier":"homoit0000565","skos:prefLabel":{"@language":"en","@value":"Genderism"},"skos:altLabel":{"@language":"en","@value":"Gender discrimination"},"rdfs:comment":{"@language":"en","@value":"The systematic belief that there are only two genders (men and women) and that individuals must conform to the gender they were assigned at or shortly after birth."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000920"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000560"},{"@id":"https://homosaurus.org/v3/homoit0000571"},{"@id":"https://homosaurus.org/v3/homoit0001278"},{"@id":"https://homosaurus.org/v3/homoit0003519"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000578","dc:identifier":"homoit0000578","skos:prefLabel":{"@language":"en","@value":"Gender segregation"},"rdfs:comment":{"@language":"en","@value":"Physical, legal, cultural, or rhetorical separation of people according to their gender."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000560"},{"@id":"https://homosaurus.org/v3/homoit0000563"},{"@id":"https://homosaurus.org/v3/homoit0000575"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000578"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderSegregation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-11-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000580","dc:identifier":"homoit0000580","skos:prefLabel":{"@language":"en","@value":"Gendercide"},"rdfs:comment":{"@language":"en","@value":"The systematic killing of members of a specific gender for their gender."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000560"},{"@id":"https://homosaurus.org/v3/homoit0000571"},{"@id":"https://homosaurus.org/v3/homoit0001108"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000580"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gendercide"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000584","dc:identifier":"homoit0000584","skos:prefLabel":{"@language":"en","@value":"Bottom surgery"},"skos:altLabel":{"@language":"en","@value":"Genital reconstruction surgery"},"rdfs:comment":{"@language":"en","@value":"Colloquial term for gender-affirming surgical alterations of the genitalia and/or reproductive organs."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000561"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000658"},{"@id":"https://homosaurus.org/v3/homoit0001060"},{"@id":"https://homosaurus.org/v3/homoit0001097"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001465"},{"@id":"https://homosaurus.org/v3/homoit0001840"},{"@id":"https://homosaurus.org/v3/homoit0002847"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genitalReconstructionSurgery"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001040","dc:identifier":"homoit0001040","skos:prefLabel":{"@language":"en","@value":"Neovagina"},"rdfs:comment":{"@language":"en","@value":"A surgically constructed vagina; typically made using tissue grafted from other parts of the body."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000561"},{"@id":"https://homosaurus.org/v3/homoit0001488"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001844"},{"@id":"https://homosaurus.org/v3/homoit0001845"},{"@id":"https://homosaurus.org/v3/homoit0001851"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/neovagina"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001049","dc:identifier":"homoit0001049","skos:prefLabel":{"@language":"en","@value":"Non-operative"},"rdfs:comment":{"@language":"en","@value":"The medical status of individuals who do not plan to undertake a surgical procedure. Commonly used to describe trans people who have not and do not plan to undertake gender affirming surgery."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001464"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000561"},{"@id":"https://homosaurus.org/v3/homoit0000617"},{"@id":"https://homosaurus.org/v3/homoit0001047"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001381"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001465"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nonOperative"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001129","dc:identifier":"homoit0001129","skos:prefLabel":{"@language":"en","@value":"Post-operative"},"rdfs:comment":{"@language":"en","@value":"Individuals who have recently undergone a surgical operation; commonly used to describe trans people who have undergone gender affirming surgery."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001464"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000561"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001381"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85105563"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001465"},"dc:replaces":{"@id":"http://homosaurus.org/v2/postOperative"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001131","dc:identifier":"homoit0001131","skos:prefLabel":{"@language":"en","@value":"Pre-operative"},"rdfs:comment":{"@language":"en","@value":"The medical status of individuals who plan to undertake a surgical procedure but have not yet done so. Commonly used to describe trans people who have not yet undergone gender affirming surgery but plan to do so."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001464"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000561"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001381"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85106377"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001465"},"dc:replaces":{"@id":"http://homosaurus.org/v2/preOperative"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001464","dc:identifier":"homoit0001464","skos:prefLabel":{"@language":"en","@value":"Transitioning status"},"rdfs:comment":{"@language":"en","@value":"Term used to describe a person’s current status in their gender transition."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001465"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001047"},{"@id":"https://homosaurus.org/v3/homoit0001049"},{"@id":"https://homosaurus.org/v3/homoit0001129"},{"@id":"https://homosaurus.org/v3/homoit0001131"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000561"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001381"},{"@id":"https://homosaurus.org/v3/homoit0001834"},{"@id":"https://homosaurus.org/v3/homoit0001835"},{"@id":"https://homosaurus.org/v3/homoit0001836"},{"@id":"https://homosaurus.org/v3/homoit0001837"},{"@id":"https://homosaurus.org/v3/homoit0001838"},{"@id":"https://homosaurus.org/v3/homoit0001839"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001465"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transitioningStatus"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000564","dc:identifier":"homoit0000564","skos:prefLabel":{"@language":"en","@value":"Gender blending"},"rdfs:comment":{"@language":"en","@value":"Gender expression that involves blending dress and behaviors associated with different genders. Do not use to describe the identities of genderqueer or non-binary people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000568"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderBlending"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001278","dc:identifier":"homoit0001278","skos:prefLabel":{"@language":"en","@value":"Sexism"},"rdfs:comment":{"@language":"en","@value":"Discrimination, prejudice, or bias directed against a particular sex or gender based on the assumption that this sex or gender is intrinsically inferior to another."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000565"},{"@id":"https://homosaurus.org/v3/homoit0000619"},{"@id":"https://homosaurus.org/v3/homoit0001293"},{"@id":"https://homosaurus.org/v3/homoit0002183"},{"@id":"https://homosaurus.org/v3/homoit0002259"},{"@id":"https://homosaurus.org/v3/homoit0003519"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120678"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001278"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000572","dc:identifier":"homoit0000572","skos:prefLabel":{"@language":"en","@value":"Gender identity disorder"},"rdfs:comment":{"@language":"en","@value":"An obsolete psychological diagnosis that medicalizes trans identities and practices; only use in historical contexts."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001006"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000567"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001381"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85053731"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderIdentityDisorder"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000576","dc:identifier":"homoit0000576","skos:prefLabel":{"@language":"en","@value":"Gender swapping"},"skos:altLabel":{"@language":"en","@value":"Gender roleplay"},"rdfs:comment":{"@language":"en","@value":"A media trope (commonly used in fanfiction and fanart) in which one or more characters switch binary sexes (e.g., a cisgender man transforms into a cisgender woman), often temporarily."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0001242"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000577"},{"@id":"https://homosaurus.org/v3/homoit0002160"},{"@id":"https://homosaurus.org/v3/homoit0002162"},{"@id":"https://homosaurus.org/v3/homoit0002171"},{"@id":"https://homosaurus.org/v3/homoit0002184"},{"@id":"https://homosaurus.org/v3/homoit0002210"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderSwapping"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000606","dc:identifier":"homoit0000606","skos:prefLabel":{"@language":"en","@value":"Hair removal"},"skos:altLabel":[{"@language":"en","@value":"Shaving"},{"@language":"en","@value":"Waxing"}],"rdfs:comment":{"@language":"en","@value":"The process of removing hair from the body through shaving, waxing, depilatories, laser hair removal, etc. May have a social component related to gender identity and/or have an erotic component."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000568"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001465"},{"@id":"https://homosaurus.org/v3/homoit0003049"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85058312"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hairRemoval"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001476","dc:identifier":"homoit0001476","skos:prefLabel":{"@language":"en","@value":"Tucking (Phallus)"},"skos:altLabel":{"@language":"en","@value":"Tucking"},"rdfs:comment":{"@language":"en","@value":"Slang term describing various methods used to visually conceal the penis to give a flatter appearance in clothing."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000568"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001099"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tucking"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001496","dc:identifier":"homoit0001496","skos:prefLabel":{"@language":"en","@value":"Voice therapy (Gender)"},"skos:altLabel":[{"@language":"en","@value":"Voice therapy (Transgender)"},{"@language":"en","@value":"Voice therapy"}],"rdfs:comment":{"@language":"en","@value":"Any non-surgical technique used to make the human voice sound either more feminine or masculine."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0001366"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001465"},{"@id":"https://homosaurus.org/v3/homoit0001468"},{"@id":"https://homosaurus.org/v3/homoit0001842"},{"@id":"https://homosaurus.org/v3/homoit0001843"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/voiceTherapyTransgender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000581","dc:identifier":"homoit0000581","skos:prefLabel":{"@language":"en","@value":"Genderfuck"},"rdfs:comment":{"@language":"en","@value":"A form of gender expression that seeks to subvert the gender binary or gender roles by mixing and messing with (or \"fucking with\") traditionally masculine and feminine components. Typically used to describe gender practices and presentation, though some people identify as \"genderfuck\" or as \"genderfuckers.\" Only use to describe people and the practices of people who self-identify with genderfuck."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0001816"},{"@id":"https://homosaurus.org/v3/homoit0001817"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000581"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderfuck"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001071","dc:identifier":"homoit0001071","skos:prefLabel":{"@language":"en","@value":"Pangender identity"},"rdfs:comment":{"@language":"en","@value":"Gender identity that encompasses multiple or all genders."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000571"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001072"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pangenderIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001415","dc:identifier":"homoit0001415","skos:prefLabel":{"@language":"en","@value":"Transgender identity"},"rdfs:comment":{"@language":"en","@value":"Identity term used to describe people who cross or transgress the  gender they were assigned at birth."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000571"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001400"},{"@id":"https://homosaurus.org/v3/homoit0001563"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007005095"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001473","dc:identifier":"homoit0001473","skos:prefLabel":{"@language":"en","@value":"Trigender identity"},"rdfs:comment":{"@language":"en","@value":"Gender identity including three genders, typically male, female, and a third (often non-binary) gender."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000571"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001474"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/trigenderIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001670","dc:identifier":"homoit0001670","skos:prefLabel":{"@language":"en","@value":"Xenogender identity"},"rdfs:comment":{"@language":"en","@value":"Non-binary gender identity that is not defined in relation to human understandings of gender (i.e., female or male, woman or man), but instead in relation to animals, plants, or other things"},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000571"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001048"},{"@id":"https://homosaurus.org/v3/homoit0001671"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/xenogender"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001563","dc:identifier":"homoit0001563","skos:prefLabel":{"@language":"en","@value":"Trans"},"skos:altLabel":{"@language":"en","@value":"Trans*"},"rdfs:comment":{"@language":"en","@value":"Umbrella term used to describe individuals who \"trans\" gender regardless of their identification; sometimes used as a way to historicize non-binary identities."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000571"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001415"},{"@id":"https://homosaurus.org/v3/homoit0001463"},{"@id":"https://homosaurus.org/v3/homoit0001468"},{"@id":"https://homosaurus.org/v3/homoit0001469"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001563"},"dc:replaces":{"@id":"http://homosaurus.org/v2/trans"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001671","dc:identifier":"homoit0001671","skos:prefLabel":{"@language":"en","@value":"Xenogender people"},"rdfs:comment":{"@language":"en","@value":"A person who identifies their gender in relation to non-human understandings of gender and relates to animals, plants, or other things."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000571"},{"@id":"https://homosaurus.org/v3/homoit0001048"},{"@id":"https://homosaurus.org/v3/homoit0001670"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001671"},"dc:replaces":{"@id":"http://homosaurus.org/v2/xenogenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000574","dc:identifier":"homoit0000574","skos:prefLabel":{"@language":"en","@value":"Gender non-conforming people"},"rdfs:comment":{"@language":"en","@value":"People who identify outside, transgress, or do not conform to a given culture's gender roles or expectations. Only use in reference to people who self-identity as gender non-conforming. Do not use to describe cisgender people whose dress or behaviors do not conform to gender roles or expectations."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001817"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001756"},{"@id":"https://homosaurus.org/v3/homoit0001922"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2017004882"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001817"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderNonConformingPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000778","dc:identifier":"homoit0000778","skos:prefLabel":{"@language":"en","@value":"Lesbian separatism"},"rdfs:comment":{"@language":"en","@value":"Ideological, social, cultural, and physical separation between men and women or between lesbians and heterosexual women."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000746"},{"@id":"https://homosaurus.org/v3/homoit0000757"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000575"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2009003403"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000778"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianSeparatism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000655","dc:identifier":"homoit0000655","skos:prefLabel":{"@language":"en","@value":"Machismo"},"rdfs:comment":{"@language":"en","@value":"Term originating in the early 1930s and 40s to describe a man's responsibility and pride in providing for, protecting, and defending his family. It is unclear whether the term originates in Spain or Portugal. Though there are positive sides of machismo and it remains an important part of Iberian and Latin American cultures, the concept has also been criticized for its perceived role in perpetuating misogyny, harmful gender roles, and domestic and sexual violence."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000577"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000978"},{"@id":"https://homosaurus.org/v3/homoit0000995"},{"@id":"https://homosaurus.org/v3/homoit0001377"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88006590"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001241"},"dc:replaces":{"@id":"http://homosaurus.org/v2/machismo"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001149","dc:identifier":"homoit0001149","skos:prefLabel":{"@language":"en","@value":"Queer (Verb)"},"rdfs:comment":{"@language":"en","@value":"A term commonly used in academic disciplines to describe actions that address sexual and gender normativity, expose systems of oppression, and attempt to undermine those systems."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000579"},{"@id":"https://homosaurus.org/v3/homoit0000972"},{"@id":"https://homosaurus.org/v3/homoit0001156"},{"@id":"https://homosaurus.org/v3/homoit0001219"},{"@id":"https://homosaurus.org/v3/homoit0001891"},{"@id":"https://homosaurus.org/v3/homoit0002042"},{"@id":"https://homosaurus.org/v3/homoit0002577"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001149"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerVerb"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000582","dc:identifier":"homoit0000582","skos:prefLabel":{"@language":"en","@value":"Genderqueer people"},"rdfs:comment":{"@language":"en","@value":"Individuals who self-identify as genderqueer, an umbrella term for queer or non-normative gender identities and gender expressions."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001195"},{"@id":"https://homosaurus.org/v3/homoit0001817"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001668"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001921"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderqueerPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001668","dc:identifier":"homoit0001668","skos:prefLabel":{"@language":"en","@value":"Transgenderqueer people"},"rdfs:comment":{"@language":"en","@value":"Someone who is both trans and genderqueer and who identifies a