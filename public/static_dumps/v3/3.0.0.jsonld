orce empowered by the state to enforce the law and maintain public order."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001120"},{"@id":"https://homosaurus.org/v3/homoit0001122"},{"@id":"https://homosaurus.org/v3/homoit0002390"},{"@id":"https://homosaurus.org/v3/homoit0002391"},{"@id":"https://homosaurus.org/v3/homoit0002397"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85104183"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001119"},"dc:replaces":{"@id":"http://homosaurus.org/v2/police"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001122","dc:identifier":"homoit0001122","skos:prefLabel":{"@language":"en","@value":"Police raids"},"skos:altLabel":[{"@language":"en","@value":"Dawn raids"},{"@language":"en","@value":"No-knock raids"}],"rdfs:comment":{"@language":"en","@value":"Unexpected and unannounced entry into and searches of residences or establishments by law enforcement officers with the aim of using surprise to seize evidence or arrest suspects. Police raids may be undertaken legally using a search warrant or through exigent circumstances, such as probable cause, though the latter is highly subjective and civilians often have little resources to appeal illegal raids."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001121"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001119"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000611"},"dc:replaces":{"@id":"http://homosaurus.org/v2/policeRaids"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001651","dc:identifier":"homoit0001651","skos:prefLabel":{"@language":"en","@value":"Consensual non-monogamy"},"skos:altLabel":{"@language":"en","@value":"Ethical Non-monogamy"},"rdfs:comment":{"@language":"en","@value":"Practice of romantic or sexual relationships with more than one person simultaneously and with all the consent of all partners involved."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001659"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001625"},{"@id":"https://homosaurus.org/v3/homoit0001641"},{"@id":"https://homosaurus.org/v3/homoit0001665"},{"@id":"https://homosaurus.org/v3/homoit0001666"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001554"},{"@id":"https://homosaurus.org/v3/homoit0001649"},{"@id":"https://homosaurus.org/v3/homoit0001662"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/consensualNonMonogamy"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001554","dc:identifier":"homoit0001554","skos:prefLabel":{"@language":"en","@value":"Metamours"},"rdfs:comment":{"@language":"en","@value":"In polyamory or open relationships, metamours are the partners of an individual's partner, with whom the individual does not have a direct sexual or romantic relationship."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001660"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001638"},{"@id":"https://homosaurus.org/v3/homoit0001651"},{"@id":"https://homosaurus.org/v3/homoit0001662"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/metamours"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001629","dc:identifier":"homoit0001629","skos:prefLabel":{"@language":"en","@value":"Hierarchical non-monogamy"},"skos:altLabel":[{"@language":"en","@value":"Hierarchical polyamory"},{"@language":"en","@value":"Hierarchical nonmonogamy"}],"rdfs:comment":{"@language":"en","@value":"A form of consensual non-monogamy in which a person has multiple partners who are not \"equal\" to one another in terms of time, emotional intensity, financial, or scheduling matters."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001659"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001641"},{"@id":"https://homosaurus.org/v3/homoit0001656"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001625"},{"@id":"https://homosaurus.org/v3/homoit0001635"},{"@id":"https://homosaurus.org/v3/homoit0001638"},{"@id":"https://homosaurus.org/v3/homoit0001645"},{"@id":"https://homosaurus.org/v3/homoit0001657"},{"@id":"https://homosaurus.org/v3/homoit0001664"},{"@id":"https://homosaurus.org/v3/homoit0002255"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hierarchicalNonmonogamy"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001662","dc:identifier":"homoit0001662","skos:prefLabel":{"@language":"en","@value":"Paramours"},"rdfs:comment":{"@language":"en","@value":"In polyamory contexts, paramours are the partners of an individual's partner, typically as part of a relationship the primary partner is unaware of. In other contexts, this term is used broadly as a synonym for lovers."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001660"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001554"},{"@id":"https://homosaurus.org/v3/homoit0001638"},{"@id":"https://homosaurus.org/v3/homoit0001651"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006001642"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/paramours"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001645","dc:identifier":"homoit0001645","skos:prefLabel":{"@language":"en","@value":"Anchor partners"},"rdfs:comment":{"@language":"en","@value":"A term used in non-monogamous communities to refer to a long-term partner with multiple commitments. Often used in place of language that is seen as hierarchical (e.g., primary/secondary partner)."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001660"},{"@id":"https://homosaurus.org/v3/homoit0002365"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001629"},{"@id":"https://homosaurus.org/v3/homoit0001657"},{"@id":"https://homosaurus.org/v3/homoit0001663"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001637"},"dc:replaces":{"@id":"http://homosaurus.org/v2/anchorPartners"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001657","dc:identifier":"homoit0001657","skos:prefLabel":{"@language":"en","@value":"Nesting partners"},"rdfs:comment":{"@language":"en","@value":"A term used in non-monogamous communities to refer to partners an individual lives with. Often used in place of language that is seen as hierarchical (e.g., primary partner, secondary partner)."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001660"},{"@id":"https://homosaurus.org/v3/homoit0002365"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001629"},{"@id":"https://homosaurus.org/v3/homoit0001645"},{"@id":"https://homosaurus.org/v3/homoit0001663"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001637"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nestingPartners"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001661","dc:identifier":"homoit0001661","skos:prefLabel":{"@language":"en","@value":"NRE (New Relationship Energy)"},"rdfs:comment":{"@language":"en","@value":"A strong, almost giddy feeling of excitement and infatuation common in the beginning of a new romantic relationship. Often used in polyamory contexts."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001655"},{"@id":"https://homosaurus.org/v3/homoit0001663"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001661"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nre"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001663","dc:identifier":"homoit0001663","skos:prefLabel":{"@language":"en","@value":"Polyamorous people"},"rdfs:comment":{"@language":"en","@value":"People who engage in romantic, sexual, or play relationships with more than one person simultaneously, with the knowledge and consent of all parties involved."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001637"},{"@id":"https://homosaurus.org/v3/homoit0001660"}],"skos:related":[{