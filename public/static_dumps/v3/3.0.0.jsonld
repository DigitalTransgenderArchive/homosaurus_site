5"},{"@id":"https://homosaurus.org/v3/homoit0001900"},{"@id":"https://homosaurus.org/v3/homoit0001906"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragCommunity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001494","dc:identifier":"homoit0001494","skos:prefLabel":{"@language":"en","@value":"Voguing"},"skos:altLabel":{"@language":"en","@value":"Vogueing"},"rdfs:comment":{"@language":"en","@value":"A highly stylized form of dance originating in the Harlem ballroom scene in the 1980s and 1990s."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000092"},{"@id":"https://homosaurus.org/v3/homoit0000367"},{"@id":"https://homosaurus.org/v3/homoit0000368"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002691"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001494"},"dc:replaces":{"@id":"http://homosaurus.org/v2/voguing"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000093","dc:identifier":"homoit0000093","skos:prefLabel":{"@language":"en","@value":"Ballgags"},"rdfs:comment":{"@language":"en","@value":"Silicone, rubber, or other types of balls that are strapped in a person’s mouth to prevent them from speaking, typically during sex."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001266"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ballgags"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000834","dc:identifier":"homoit0000834","skos:prefLabel":{"@language":"en","@value":"LGBTQ chosen families"},"skos:altLabel":{"@language":"en","@value":"LGBTQ chosen families"},"rdfs:comment":{"@language":"en","@value":"Groups of LGBTQ+ people who have intentionally chosen to nurture, support, and love one another as family, whether or not they have biological or legal relationships."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000420"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000094"},{"@id":"https://homosaurus.org/v3/homoit0000371"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQChosenFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000371","dc:identifier":"homoit0000371","skos:prefLabel":{"@language":"en","@value":"Drag families"},"rdfs:comment":{"@language":"en","@value":"Groups of drag performers who share a community and typically live in close quarters with one another. Drag families are headed by drag mothers or drag fathers, with other members termed drag daughters and sons. Members of a drag family typically use the same last name as their drag mother or father (e.g., Xtravaganza) in social contexts or while performing."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000370"},{"@id":"https://homosaurus.org/v3/homoit0000420"},{"@id":"https://homosaurus.org/v3/homoit0000834"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000372"},{"@id":"https://homosaurus.org/v3/homoit0000374"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000094"},{"@id":"https://homosaurus.org/v3/homoit0000373"},{"@id":"https://homosaurus.org/v3/homoit0000375"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000878","dc:identifier":"homoit0000878","skos:prefLabel":{"@language":"en","@value":"LGBTQ historical terms"},"skos:altLabel":{"@language":"en","@value":"LGBTQ historical terms"},"rdfs:comment":{"@language":"en","@value":"Historical terms for LGBTQ+ people, identities, and practices that are now considered outdated and/or offensive."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000095"},{"@id":"https://homosaurus.org/v3/homoit0000098"},{"@id":"https://homosaurus.org/v3/homoit0000218"},{"@id":"https://homosaurus.org/v3/homoit0000227"},{"@id":"https://homosaurus.org/v3/homoit0000284"},{"@id":"https://homosaurus.org/v3/homoit0000326"},{"@id":"https://homosaurus.org/v3/homoit0000395"},{"@id":"https://homosaurus.org/v3/homoit0000396"},{"@id":"https://homosaurus.org/v3/homoit0000418"},{"@id":"https://homosaurus.org/v3/homoit0000436"},{"@id":"https://homosaurus.org/v3/homoit0000454"},{"@id":"https://homosaurus.org/v3/homoit0000645"},{"@id":"https://homosaurus.org/v3/homoit0000648"},{"@id":"https://homosaurus.org/v3/homoit0000677"},{"@id":"https://homosaurus.org/v3/homoit0000986"},{"@id":"https://homosaurus.org/v3/homoit0001094"},{"@id":"https://homosaurus.org/v3/homoit0001095"},{"@id":"https://homosaurus.org/v3/homoit0001258"},{"@id":"https://homosaurus.org/v3/homoit0001296"},{"@id":"https://homosaurus.org/v3/homoit0001325"},{"@id":"https://homosaurus.org/v3/homoit0001470"},{"@id":"https://homosaurus.org/v3/homoit0001472"},{"@id":"https://homosaurus.org/v3/homoit0001484"},{"@id":"https://homosaurus.org/v3/homoit0001564"},{"@id":"https://homosaurus.org/v3/homoit0001669"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002260"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQHistoricalTerms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-28"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000978","dc:identifier":"homoit0000978","skos:prefLabel":{"@language":"en","@value":"Macho men"},"skos:altLabel":{"@language":"en","@value":"Machos"},"rdfs:comment":{"@language":"en","@value":"Subculture of gay men who display characteristics associated with machismo (e.g., masculine pride, self-reliance, physical strength). Though \"macho men\" can be used more broadly, this term refers to gay men who embrace machismo and traditional masculinity through their dress and behavior."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000506"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000095"},{"@id":"https://homosaurus.org/v3/homoit0000655"},{"@id":"https://homosaurus.org/v3/homoit0000995"},{"@id":"https://homosaurus.org/v3/homoit0002148"},{"@id":"https://homosaurus.org/v3/homoit0002149"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/machoMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001009","dc:identifier":"homoit0001009","skos:prefLabel":{"@language":"en","@value":"Men who have sex with men"},"skos:altLabel":{"@language":"en","@value":"MSM"},"rdfs:comment":{"@language":"en","@value":"Men who engage in sexual activity with other men, whether or not they identify as gay or bisexual."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000915"},{"@id":"https://homosaurus.org/v3/homoit0001008"}],"skos:related":[{"@id":"https://homosa