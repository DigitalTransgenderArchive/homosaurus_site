urus.org/v2/medicalCare"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000614","dc:identifier":"homoit0000614","skos:prefLabel":{"@language":"en","@value":"Health care for LGBTQ people"},"skos:altLabel":[{"@language":"en","@value":"Medical care for LGBTQ people"},{"@language":"en","@value":"Health care for LGBTQ people"}],"rdfs:comment":{"@language":"en","@value":"Organized measures taken for the maintenance or improvement of health via the prevention, diagnosis, treatment, and/or cure of disease, illness, injury, or other conditions; use in reference to health care addressing the particular needs of LGBTQ+ individuals or communities."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000226"},{"@id":"https://homosaurus.org/v3/homoit0001012"},{"@id":"https://homosaurus.org/v3/homoit0001113"},{"@id":"https://homosaurus.org/v3/homoit0001360"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000030"},{"@id":"https://homosaurus.org/v3/homoit0000876"},{"@id":"https://homosaurus.org/v3/homoit0003504"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000614"},"dc:replaces":{"@id":"http://homosaurus.org/v2/healthCareForLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001132","dc:identifier":"homoit0001132","skos:prefLabel":{"@language":"en","@value":"Press (LGBTQ)"},"skos:altLabel":{"@language":"en","@value":"Press (LGBTQ)"},"rdfs:comment":{"@language":"en","@value":"Newspapers, magazines, or other publishing outlets aimed at LGBTQ+ audiences and/or operated by LGBTQ+ people."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000177"},{"@id":"https://homosaurus.o