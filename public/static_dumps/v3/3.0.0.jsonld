l":{"@language":"en","@value":"Relationships (LGBTQ)"},"skos:altLabel":{"@language":"en","@value":"Relationships (LGBTQ)"},"rdfs:comment":{"@language":"en","@value":"Ongoing connections (romantic, sexual, or platonic) between two or more LGBTQ+ people."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000182"},{"@id":"https://homosaurus.org/v3/homoit0000230"},{"@id":"https://homosaurus.org/v3/homoit0000310"},{"@id":"https://homosaurus.org/v3/homoit0000315"},{"@id":"https://homosaurus.org/v3/homoit0000455"},{"@id":"https://homosaurus.org/v3/homoit0000529"},{"@id":"https://homosaurus.org/v3/homoit0000628"},{"@id":"https://homosaurus.org/v3/homoit0000663"},{"@id":"https://homosaurus.org/v3/homoit0000773"},{"@id":"https://homosaurus.org/v3/homoit0001205"},{"@id":"https://homosaurus.org/v3/homoit0001302"},{"@id":"https://homosaurus.org/v3/homoit0001442"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000067"},{"@id":"https://homosaurus.org/v3/homoit0000362"},{"@id":"https://homosaurus.org/v3/homoit0000894"},{"@id":"https://homosaurus.org/v3/homoit0000937"},{"@id":"https://homosaurus.org/v3/homoit0001083"},{"@id":"https://homosaurus.org/v3/homoit0001311"},{"@id":"https://homosaurus.org/v3/homoit0001636"},{"@id":"https://homosaurus.org/v3/homoit0002189"},{"@id":"https://homosaurus.org/v3/homoit0002722"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/relationshipsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001532","dc:identifier":"homoit0001532","skos:prefLabel":{"@language":"en","@value":"Amatonormativity"},"rdfs:comment":{"@language":"en","@value":"The assumption that all people share a desire for romantic relationships and that this is a preferential life goal."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001323"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000067"},{"@id":"https://homosaurus.org/v3/homoit0000356"},{"@id":"https://homosaurus.org/v3/homoit0001650"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001323"},"dc:replaces":{"@id":"http://homosaurus.org/v2/amatonormativity"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000068","dc:identifier":"homoit0000068","skos:prefLabel":{"@language":"en","@value":"Arrests of LGBTQ people"},"skos:altLabel":{"@language":"en","@value":"Arrests of LGBTQ people"},"rdfs:comment":{"@language":"en","@value":"Apprehension and detention of LGBTQ+ people by an institution or authority in order to deprive them of their freedom of movement."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000348"},{"@id":"https://homosaurus.org/v3/homoit0002373"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000835"},{"@id":"https://homosaurus.org/v3/homoit0001108"},{"@id":"https://homosaurus.org/v3/homoit0001120"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000348"},"dc:replaces":{"@id":"http://homosaurus.org/v2/arrestsOfLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000348","dc:identifier":"homoit0000348","skos:prefLabel":{"@language":"en","@value":"Detention of LGBTQ people"},"skos:altLabel":{"@language":"en","@value":"Detention of LGBTQ people"},"rdfs:comment":{"@language":"en","@value":"Temporary physical and legal confinement of LGBTQ+ people by an institution or authority, typically pending criminal charges or deportation. Can also be used to describe individuals held in custody for political purposes or within the context of war."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000068"},{"@id":"https://homosaurus.org/v3/homoit0000349"},{"@id":"https://homosaurus.org/v3/homoit0000884"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000712"},{"@id":"https://homosaurus.org/v3/homoit0000883"},{"@id":"https://homosaurus.org/v3/homoit0000887"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000348"},"dc:replaces":{"@id":"http://homosaurus.org/v2/detentionOfLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000835","dc:identifier":"homoit0000835","skos:prefLabel":{"@language":"en","@value":"LGBTQ civil disobedience"},"skos:altLabel":{"@language":"en","@value":"LGBTQ civil disobedience"},"rdfs:comment":{"@language":"en","@value":"The active, professed refusal of LGBTQ+ people to obey certain laws or governmental orders as a form of activism and resistance."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000853"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000068"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQCivilDisobedience"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001120","dc:identifier":"homoit0001120","skos:prefLabel":{"@language":"en","@value":"Police entrapment"},"rdfs:comment":{"@language":"en","@value":"A practice in which law enforcement agents or agents of the state coerce an individual to commit a \"crime\" they would have otherwise been unlikely or unwilling to commit. Legal definitions of entrapment vary widely depending on the jurisdiction, but the term is often used colloquially to refer to police acting dishonestly or in bad faith, as well as policing focused on anticipating and inducing crime, rather than responding to reports of crime."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001121"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000068"},{"@id":"https://homosaurus.org/v3/homoit0001119"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85044146"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000611"},"dc:replaces":{"@id":"http://homosaurus.org/v2/policeEntrapment"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000069","dc:identifier":"homoit0000069","skos:prefLabel":{"@language":"en","@value":"Insemination"},"skos:altLabel":[{"@language":"en","@value":"Fertilisation"},{"@language":"en","@value":"Fertilization"}],"rdfs:comment":{"@language":"en","@value":"The act of using sperm to induce pregnancy by natural or artificial means, especially in the context of LGBTQ+ family planning with sperm donors."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000843"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001265"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001336"},{"@id":"https://homosaurus.org/v3/homoit0002618"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85008176"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000864"},"dc:replaces":{"@id":"http://homosaurus.org/v2/insemination"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-10-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000843","dc:identifier":"homoit0000843","skos:prefLabel":{"@language":"en","@value":"Conception by LGBTQ people"},"skos:altLabel":{"@language":"en","@value":"Conception by LGBTQ people"},"rdfs:comment":{"@language":"en","@value":"Umbrella term used to describe the processes by which LGBTQ+ people conceive children, including an LGBTQ+ person, their partner, or a third party becoming pregnant with a child that will be raised by an LGBTQ+ person, as well as LGBTQ+ people conceiving children that will be raised by other parents."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000864"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000069"},{"@id":"https://homosaurus.org/v3/homoit0000659"},{"@id":"https://homosaurus.org/v3/homoit0001265"},{"@id":"https://homosaurus.org/v3/homoit0001347"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000121"},{"@id":"https://homosaurus.org/v3/homoit0000347"},{"@id":"https://homosaurus.org/v3/homoit0000364"},{"@id":"https://homosaurus.org/v3/homoit0001075"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000864"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ConceptionByLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001265","dc:identifier":"homoit0001265","skos:prefLabel":{"@language":"en","@value":"Self-insemination"},"rdfs:comment":{"@language":"en","@value":"The practice of using collected sperm to induce one's own pregnancy outside of a clinical environment."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000069"},{"@id":"https://homosaurus.org/v3/homoit0000843"},{"@id":"https://homosaurus.org/v3/homoit0002618"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97001526"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000864"},"dc:replaces":{"@id":"http://homosaurus.org/v2/self-insemination"},"dc:issued":{"@ty