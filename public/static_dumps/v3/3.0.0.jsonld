unities. Predominately used to describe men who are exclusively or primarily romantically and/or sexually attracted to other men. While \"gay\" is often used as an identifier by people of all genders, this term specifically refers to gay men."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000915"},{"@id":"https://homosaurus.org/v3/homoit0001008"},{"@id":"https://homosaurus.org/v3/homoit0001297"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000089"},{"@id":"https://homosaurus.org/v3/homoit0000105"},{"@id":"https://homosaurus.org/v3/homoit0000284"},{"@id":"https://homosaurus.org/v3/homoit0000286"},{"@id":"https://homosaurus.org/v3/homoit0000492"},{"@id":"https://homosaurus.org/v3/homoit0000978"},{"@id":"https://homosaurus.org/v3/homoit0001055"},{"@id":"https://homosaurus.org/v3/homoit0001063"},{"@id":"https://homosaurus.org/v3/homoit0001145"},{"@id":"https://homosaurus.org/v3/homoit0001148"},{"@id":"https://homosaurus.org/v3/homoit0001479"},{"@id":"https://homosaurus.org/v3/homoit0001508"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000418"},{"@id":"https://homosaurus.org/v3/homoit0000479"},{"@id":"https://homosaurus.org/v3/homoit0000481"},{"@id":"https://homosaurus.org/v3/homoit0000485"},{"@id":"https://homosaurus.org/v3/homoit0000496"},{"@id":"https://homosaurus.org/v3/homoit0000499"},{"@id":"https://homosaurus.org/v3/homoit0000509"},{"@id":"https://homosaurus.org/v3/homoit0000544"},{"@id":"https://homosaurus.org/v3/homoit0000646"},{"@id":"https://homosaurus.org/v3/homoit0000647"},{"@id":"https://homosaurus.org/v3/homoit0001009"},{"@id":"https://homosaurus.org/v3/homoit0001104"},{"@id":"https://homosaurus.org/v3/homoit0001185"},{"@id":"https://homosaurus.org/v3/homoit0001258"},{"@id":"https://homosaurus.org/v3/homoit0002170"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85061798"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayMen"