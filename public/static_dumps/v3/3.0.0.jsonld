0"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/livingArrangements"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000159","dc:identifier":"homoit0000159","skos:prefLabel":{"@language":"en","@value":"Bisexual masters"},"skos:altLabel":{"@language":"en","@value":"Bisexual masters"},"rdfs:comment":{"@language":"en","@value":"Bisexual people who are part of the BDSM scene and assume the dominant role in sexual relationships with a dominant/submissive dynamic."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000999"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualMasters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000160","dc:identifier":"homoit0000160","skos:prefLabel":{"@language":"en","@value":"Bisexual men"},"skos:altLabel":{"@language":"en","@value":"Male bisexuals"},"rdfs:comment":{"@language":"en","@value":"Men who identify as bisexual."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000170"},{"@id":"https://homosaurus.org/v3/homoit0001008"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001009"},{"@id":"https://homosaurus.org/v3/homoit0001185"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002510"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://hom