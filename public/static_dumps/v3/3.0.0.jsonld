y poetry"},"rdfs:comment":{"@language":"en","@value":"Literary work, typically written in verse, that focuses on gay characters, themes, or identity."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001118"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001725"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008105069"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayPoetry"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000764","dc:identifier":"homoit0000764","skos:prefLabel":{"@language":"en","@value":"Lesbian political groups"},"rdfs:comment":{"@language":"en","@value":"Organized groups centered on political change and action for lesbian rights; may include advocating for lesbianism as a political and feminist choice against sexism."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000753"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000519"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0003521"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianPoliticalGroups"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000523","dc:identifier":"homoit0000523","skos:prefLabel":{"@language":"en","@value":"Gay pride week"},"skos:altLabel":[{"@language":"en","@value":"Pink Saturday"},{"@language":"en","@value":"Pink week"}],"rdfs:comment":{"@language":"en","@value":"Events celebrating LGBTQ+ social and self acceptance, achievements, and rights, usually organized over the course of a week with local events, parades, marches, and rallies. Occurs at different times during 