1133"},{"@id":"https://homosaurus.org/v3/homoit0001892"},{"@id":"https://homosaurus.org/v3/homoit0001903"},{"@id":"https://homosaurus.org/v3/homoit0001904"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85086002"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001017"},"dc:replaces":{"@id":"http://homosaurus.org/v2/misogyny"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001561","dc:identifier":"homoit0001561","skos:prefLabel":{"@language":"en","@value":"Stigma"},"rdfs:comment":{"@language":"en","@value":"Widespread disapproval of a group of people or set of behaviors based on preconceived ideas."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000112"},{"@id":"https://homosaurus.org/v3/homoit0000356"},{"@id":"https://homosaurus.org/v3/homoit0000534"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85128107"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001561"},"dc:replaces":{"@id":"http://homosaurus.org/v2/stigma"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000113","dc:identifier":"homoit0000113","skos:prefLabel":{"@language":"tl","@value":"Binabae"},"rdfs:comment":{"@language":"en","@value":"Tagalog term for individuals who possess both male and female traits."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/binabae"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000114","dc:identifier":"homoit0000114","skos:prefLabel":{"@language":"en","@value":"Binding (Chest)"},"rdfs:comment":{"@language":"en","@value":"The act of flattening or concealing the chest area with a tight fitting shirt, strap, or similar material; often practiced by transgender men and transmasculine people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000568"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000222"},{"@id":"https://homosaurus.org/v3/homoit0000436"},{"@id":"https://homosaurus.org/v3/homoit0001643"},{"@id":"https://homosaurus.org/v3/homoit0001840"},{"@id":"https://homosaurus.org/v3/homoit0001852"},{"@id":"https://homosaurus.org/v3/homoit0003118"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bindingChest"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000222","dc:identifier":"homoit0000222","skos:prefLabel":{"@language":"en","@value":"Breast"},"skos:altLabel":[{"@language":"en","@value":"Boobs"},{"@language":"en","@value":"Bosoms"},{"@language":"en","@value":"Bosom"},{"@language":"en","@value":"Tits"},{"@language":"en","@value":"Titties"},{"@language":"en","@value":"Boob"},{"@language":"en","@value":"Breasts"},{"@language":"en","@value":"Tit"},{"@language":"en","@value":"Titty"}],"rdfs:comment":{"@language":"en","@value":"One of the two soft, protruding organs on an individual's chest."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000401"},{"@id":"https://homosaurus.org/v3/homoit0001259"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000114"},{"@id":"https://homosaurus.org/v3/homoit0001620"},{"@id":"https://homosaurus.org/v3/homoit0001621"},{"@id":"https://homosaurus.org/v3/homoit0001622"},