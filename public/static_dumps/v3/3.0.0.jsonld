020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001617","dc:identifier":"homoit0001617","skos:prefLabel":{"@language":"en","@value":"Bisexual biographies"},"rdfs:comment":{"@language":"en","@value":"Written accounts of the lives of people known to be bisexual."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001614"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001732"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001614"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualBiographies"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-09"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001618","dc:identifier":"homoit0001618","skos:prefLabel":{"@language":"en","@value":"Transgender biographies"},"rdfs:comment":{"@language":"en","@value":"Written accounts of the lives of individuals known to be transgender."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001614"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001733"},{"@id":"https://homosaurus.org/v3/homoit0002541"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001614"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderBiographies"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001619","dc:identifier":"homoit0001619","skos:prefLabel":{"@language":"en","@value":"Queer biographies"},"rdfs:comment":{"@language":"en","@value":"Written accounts of the lives of individuals known to be queer."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001614"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001734"},{"@id":"https://homosaurus.org/v3/homoit0002541"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001614"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerBiographies"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001625","dc:identifier":"homoit0001625","skos:prefLabel":{"@language":"en","@value":"DADT relationships"},"rdfs:comment":{"@language":"en","@value":"Abbreviation for \"don’t ask don’t tell relationships,\" where partners agree that they have each have multiple romantic and/or sexual relationships as long as they do not discuss it with their primary partner or let it interfere with their partner’s daily life."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001651"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001629"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/DADTRelationships"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001659","dc:identifier":"homoit0001659","skos:prefLabel":{"@language":"en","@value":"Non-monogamy"},"skos:altLabel":[{"@language":"en","@value":"Nonmono"},{"@language":"en","@value":"Nonmonogamy"}],"rdfs:comment":{"@language":"en","@value":"Practice of engaging in romantic or sexual relationships with more than one person simultaneously. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001636"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001629"},{"@id":"https://homosaurus.org/v3/homoit0001651"},{"@id":"https://homosaurus.org/v3/homoit0001658"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002255"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh00003586"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nonMonogamy"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001656","dc:identifier":"homoit0001656","skos:prefLabel":{"@language":"en","@value":"Monogamish"},"rdfs:comment":{"@language":"en","@value":"Term used to describe relationships that are mostly monogamous with occasional exceptions made for sexual play."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001629"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001641"},{"@id":"https://homosaurus.org/v3/homoit0001916"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/monogamish"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001635","dc:identifier":"homoit0001635","skos:prefLabel":{"@language":"en","@value":"Primary partners"},"rdfs:comment":{"@language":"en","@value":"A term used in hierarchical polyamory to refer to the partner whose interests and desires come before those of any secondary partner(s)."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0002365"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001629"},{"@id":"https://homosaurus.org/v3/homoit0001638"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0002365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/primaryPartners"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001665","dc:identifier":"homoit0001665","skos:prefLabel":{"@language":"en","@value":"Relationship anarchists"},"rdfs:comment":{"@language":"en","@value":"People who practice a type of non-monogamy characterized by application of anarchist principles (such as autonomy, anti-normativity, anti-hierarchical practices, refusal of state governance) to relationships. Often contrasted with hierarchical polyamory."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001637"},{"@id":"https://homosaurus.org/v3/homoit0001651"},{"@id":"https://homosaurus.org/v3/homoit0001660"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001666"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001637"},"dc:replaces":{"@id":"http://homosaurus.org/v2/relationshipAnarchists"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001647","dc:identifier":"homoit0001647","skos:prefLabel":{"@language":"en","@value":"Cheating"},"skos:altLabel":[{"@language":"en","@value":"Straying"},{"@language":"en","@value":"Adultery"},{"@language":"en","@value":"Infidelity"},{"@language":"en","@value":"Affairs"},{"@language":"en","@value":"Stepping out"}],"rdfs:comment":{"@language":"en","@value":"A violation of a couple's assumed or stated contract regarding emotional and/or sexual exclusivity. Should not be used to refer to non-monogamy in general, as cheating is possible in both monogamous and non-monogamous relationships."},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85001045"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001647"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001658"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cheating"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2022-10-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001666","dc:identifier":"homoit0001666","skos:prefLabel":{"@language":"en","@value":"Relationship anarchy"},"rdfs:comment":{"@language":"en","@value":"A type of non-monogamy characterized by application of anarchist principles (such as autonomy, anti-normativity, anti-hierarchical practices, refusal of state governance) to relationships. Often contrasted with hierarchical polyamory."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001651"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001665"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/relationshipAnarchy"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001655","dc:identifier":"homoit0001655","skos:prefLabel":{"@language":"en","@value":"Honeymooning"},"rdfs:comment":{"@language":"en","@value":"A period of time in a relationship characterized by passionate love as well as intense feelings of attraction and ecstasy, sometimes accompanied by idealization of a partner or the shared relationship."},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001661"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001655"},"dc:replaces":{"@id":"http://homosaurus.org/v2/honeymooning"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-22"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}}]}