pOrientation"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000373","dc:identifier":"homoit0000373","skos:prefLabel":{"@language":"en","@value":"Drag kings"},"rdfs:comment":{"@language":"en","@value":"Performers, often people assigned female at birth, who dress in stereotypically masculine attire and enact masculine personas for the purpose of entertainment."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000316"},{"@id":"https://homosaurus.org/v3/homoit0000367"},{"@id":"https://homosaurus.org/v3/homoit0000370"},{"@id":"https://homosaurus.org/v3/homoit0000371"},{"@id":"https://homosaurus.org/v3/homoit0000372"},{"@id":"https://homosaurus.org/v3/homoit0000374"},{"@id":"https://homosaurus.org/v3/homoit0000375"},{"@id":"https://homosaurus.org/v3/homoit0000983"},{"@id":"https://homosaurus.org/v3/homoit0001906"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2021001446"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000373"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragKings"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000375","dc:identifier":"homoit0000375","skos:prefLabel":{"@language":"en","@value":"Drag queens"},"rdfs:comment":{"@language":"en","@value":"Performers, often people assigned male at birth, who dress in stereotypically feminine attire and enact feminine personas for the purpose of entertainment."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001148"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000316"},{"@id":"https://homosaurus.org/v3/homoit0000367"},{"@id":"https://homosaurus.org/v3/homoit0000370"},{"@id":"https://