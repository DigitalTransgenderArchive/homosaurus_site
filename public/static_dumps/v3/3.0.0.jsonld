ps://homosaurus.org/v3/homoit0001287"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/saferSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001271","dc:identifier":"homoit0001271","skos:prefLabel":{"@language":"en","@value":"Sex education"},"rdfs:comment":{"@language":"en","@value":"Instruction about sexual health and sexuality, including topics such as consent, safer sex, transmission of STIs, and reproduction."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000661"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000027"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120630"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000661"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexEducation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001294","dc:identifier":"homoit0001294","skos:prefLabel":{"@language":"en","@value":"Sexual health"},"rdfs:comment":{"@language":"en","@value":"State of physical, emotional, mental, and social well being in relation to sexuality. This includes one’s ability to have responsible, satisfying, and safer sex free of violence or coercion. "},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000027"},{"@id":"https://homosaurus.org/v3/homoit0001291"},{"@id":"https://homosaurus.org/v3/homoit0001292"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85063528"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001294"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualHealth"},"dc:issued":{"@type":"xsd:date","@valu