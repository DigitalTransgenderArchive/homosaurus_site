61"},{"@id":"https://homosaurus.org/v3/homoit0001488"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000585"},{"@id":"https://homosaurus.org/v3/homoit0001634"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000401"},"dc:replaces":{"@id":"http://homosaurus.org/v2/erogenousBodyParts"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001259","dc:identifier":"homoit0001259","skos:prefLabel":{"@language":"en","@value":"Secondary sex characteristics"},"rdfs:comment":{"@language":"en","@value":"Features that appear during puberty that are not directly related to reproduction, like changes in the voice and the development of body hair."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001269"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000222"},{"@id":"https://homosaurus.org/v3/homoit0000422"},{"@id":"https://homosaurus.org/v3/homoit0000605"},{"@id":"https://homosaurus.org/v3/homoit0001339"},{"@id":"https://homosaurus.org/v3/homoit0001495"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/secondarySexCharacteristics"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001620","dc:identifier":"homoit0001620","skos:prefLabel":{"@language":"en","@value":"Breast augmentation"},"skos:altLabel":[{"@language":"en","@value":"Augmentation mammaplasty"},{"@language":"en","@value":"Augmentation mammoplasty"},{"@language":"en","@value":"Boob job"}],"rdfs:comment":{"@language":"en","@value":"A surgical procedure aimed at increasing breast size using a prosthetic implant; often undergone by transgender women as a gender affirming surgery."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001840"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000222"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh90001764"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/breastAugmentation"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001621","dc:identifier":"homoit0001621","skos:prefLabel":{"@language":"en","@value":"Breast fetishism"},"skos:altLabel":[{"@language":"en","@value":"Mazophilia"},{"@language":"en","@value":"Breast partialism"},{"@language":"en","@value":"Mastofact"},{"@language":"en","@value":"Breast fetishism"},{"@language":"en","@value":"Breast kink"}],"rdfs:comment":{"@language":"en","@value":"Eroticization of the breasts. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001634"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000222"},{"@id":"https://homosaurus.org/v3/homoit0001046"},{"@id":"https://homosaurus.org/v3/homoit0003118"},{"@id":"https://homosaurus.org/v3/homoit0003130"},{"@id":"https://homosaurus.org/v3/homoit0003132"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/breastFetishism"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001622","dc:identifier":"homoit0001622","skos:prefLabel":{"@language":"en","@value":"Breast reduction"},"skos:altLabel":[{"@language":"en","@value":"Reduction mammaplasty"},{"@language":"en","@value":"Reduction mammoplasty"}],"rdfs:comment":{"@language":"en","@value":"A surgical procedure to decrease breast size. Often undertaken by transgender men or non-binary people as a gender affirming surgery."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000222"},{"@id":"https://homosaurus.org/v3/homoit0001631"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh90001763"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001622"},"dc:replaces":{"@id":"http://homosaurus.org/v2/breastReduction"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-25"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001623","dc:identifier":"homoit0001623","skos:prefLabel":{"@language":"en","@value":"Breast size"},"rdfs:comment":{"@language":"en","@value":"The dimensions of an individual's breast tissue; can be used as an approximation (e.g., large breasts, small breasts) or to reference to standards of measurement for bras and other support garments."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001630"},{"@id":"https://homosaurus.org/v3/homoit0001639"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000222"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001623"},"dc:replaces":{"@id":"http://homosaurus.org/v2/breastSize"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001630","dc:identifier":"homoit0001630","skos:prefLabel":{"@language":"en","@value":"Large breasts"},"skos:altLabel":[{"@language":"en","@value":"Gigantomastia"},{"@language":"en","@value":"Macromastia"},{"@language":"en","@value":"Breast hypertrophy"}],"rdfs:comment":{"@language":"en","@value":"Breasts considered large within a given cultural context. Note that large breasts have various health issues associated with them and may carry stigmatized medical associations (such as terms like gigantomastia and macromastia). These terms have more specific medical meanings but should not be used outside of those specific contexts."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001623"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000222"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001623"},"dc:replaces":{"@id":"http://homosaurus.org/v2/largeBreasts"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001631","dc:identifier":"homoit0001631","skos:prefLabel":{"@language":"en","@value":"Mastectomy"},"skos:altLabel":{"@language":"en","@value":"Breast amputation"},"rdfs:comment":{"@language":"en","@value":"A surgical procedure aimed at removing the breast or as much breast tissue as possible; often undergone as part of \"top surgery\" for transgender men or nonbinary people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001840"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000222"},{"@id":"https://homosaurus.org/v3/homoit0001622"},{"@id":"https://homosaurus.org/v3/homoit0001841"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081984"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mastectomy"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-25"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001639","dc:identifier":"homoit0001639","skos:prefLabel":{"@language":"en","@value":"Small breasts"},"skos:altLabel":[{"@language":"en","@value":"Breast hypoplasia"},{"@language":"en","@value":"Underdeveloped breasts"}],"rdfs:comment":{"@language":"en","@value":"Breasts considered small within a given cultural context. In certain situations, medical professionals may refer to such breasts as \"underdeveloped\" or \"hypoplastic.\" These terms can be considered offensive and should not be used outside of specific medical contexts. The alternate labels included here are intended to aid search tools only and should not be used in other contexts."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001623"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000222"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001623"},"dc:replaces":{"@id":"http://homosaurus.org/v2/smallBreasts"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000223","dc:identifier":"homoit0000223","skos:prefLabel":{"@language":"en","@value":"Brothels"},"skos:altLabel":{"@language":"en","@value":"Bordellos"},"rdfs:comment":{"@language":"en","@value":"Establishments where clients pay to engage in sexual activity with sex workers. Brothels may be illegal, decriminalized, or legal operations."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001276"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005004145"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000223"},"dc:replaces":{"@id":"http://homosaurus.org/v2/brothels"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000224","dc:identifier":"homoit0000224","skos:prefLabel":{"@language":"en","@value":"Brotherboys"},"skos:altLabel":{"@language":"en","@value":"Brothaboys"},"rdfs:comment":{"@language":"en","@value":"Indigenous Australian term for people who transition from female to male."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000436"},{"@id":"https://homosaurus.org/v3/homoit0001314"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/brotherboys"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000480","dc:identifier":"homoit0000480","skos:prefLabel":{"@language":"en","@value":"Gay Buddhists"},"rdfs:comment":{"@language":"en","@value":"Gay men who are Buddhist."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000225"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2011004972"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayBuddhists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-03-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000728","dc:identifier":"homoit0000728","skos:prefLabel":{"@language":"en","@value":"Lesbian Buddhists"},"rdfs:comment":{"@language":"en","@value":"Lesbians who are Buddhist."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000225"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianBuddhists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-09"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001165","dc:identifier":"homoit0001165","skos:prefLabel":{"@language":"en","@value":"Queer Buddhists"},"rdfs:comment":{"@language":"en","@value":"Queer people who are Buddhist."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000225"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerBuddhists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001398","dc:identifier":"homoit0001398","skos:prefLabel":{"@language":"en","@value":"Transgender Buddhists"},"rdfs:comment":{"@language":"en","@value":"Transgender people who are Buddhist."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000225"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderBuddhists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000227","dc:identifier":"homoit0000227","skos:prefLabel":{"@language":"en","@value":"Sodomites"},"skos:altLabel":{"@language":"en","@value":"Buggers"},"rdfs:comment":{"@language":"en","@value":"Pejorative historical term for individuals who engage in sexual activities that are characterized as unnatural or immoral; commonly applied to gay men engaging in anal sex. Only use in historical contexts."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000878"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001297"},{"@id":"https://homosaurus.org/v3/homoit0001325"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sodomites"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3