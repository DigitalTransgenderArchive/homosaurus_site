4"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0003758"},"dc:replaces":{"@id":"http://homosaurus.org/v2/femaleProstitutes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-16"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000434","dc:identifier":"homoit0000434","skos:prefLabel":{"@language":"en","@value":"Female prostitution"},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001136"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000433"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85107626"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000011"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000433"},"dc:replaces":{"@id":"http://homosaurus.org/v2/femaleProstitution"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000435","dc:identifier":"homoit0000435","skos:prefLabel":{"@language":"en","@value":"Females"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000273"},{"@id":"https://homosaurus.org/v3/homoit0001642"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85047734"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000435"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001509"},"dc:replaces":{"@id":"http://homosaurus.org/v2/females"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-10-25"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000457","dc:identifier":"homoit0000457","skos:prefLabel":{"@language":"en","@value":"FtXs"},"rdfs:comment":{"@language":"en","@value":"People who transition from female to unknown or not female."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001378"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000436"},{"@id":"https://homosaurus.org/v3/homoit0000986"},{"@id":"https://homosaurus.org/v3/homoit0001027"},{"@id":"https://homosaurus.org/v3/homoit0001518"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ftxs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001027","dc:identifier":"homoit0001027","skos:prefLabel":{"@language":"en","@value":"MtXs"},"rdfs:comment":{"@language":"en","@value":"People who transition from male to unknown or not male."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001378"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000436"},{"@id":"https://homosaurus.org/v3/homoit0000457"},{"@id":"https://homosaurus.org/v3/homoit0000986"},{"@id":"https://homosaurus.org/v3/homoit0001518"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mtxs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000444","dc:identifier":"homoit0000444","skos:prefLabel":{"@language":"en","@value":"First wave feminism"},"skos:altLabel":{"@language":"en","@value":"First wave feminism"},"rdfs:comment":{"@language":"en","@value":"Period of women's rights activism in the 19th and early 20th centuries that was primarily focused on legal rights such as women's right to vote."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000437"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0003172"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008001557"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000437"},"dc:replaces":{"@id":"http://homosaurus.org/v2/firstWaveFeminism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000622","dc:identifier":"homoit0000622","skos:prefLabel":{"@language":"en","@value":"Heterosexual feminism"},"rdfs:comment":{"@language":"en","@value":"A form of feminism that prioritizes the experiences of heterosexual women and focuses on securing equitable economic, political, and social rights for heterosexual women. Often discussed in juxtaposition to political lesbianism."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000437"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000741"},{"@id":"https://homosaurus.org/v3/homoit0001133"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000437"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexualFeminism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000741","dc:identifier":"homoit0000741","skos:prefLabel":{"@language":"en","@value":"Lesbian feminism"},"rdfs:comment":{"@language":"en","@value":"A cultural movement and critical perspective that arose in the 1970s and 1980s primarily in North America and Western Europe as a result of dissatisfaction with the women's liberation movement and the gay liberation movement. Lesbian feminism encourages women to focus their efforts, activities, and relationships toward other women rather than men, often advocating for lesbianism as the logical result of feminism."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000437"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000622"},{"@id":"https://homosaurus.org/v3/homoit0000753"},{"@id":"https://homosaurus.org/v3/homoit0003169"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93000705"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000437"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianFeminism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001230","dc:identifier":"homoit0001230","skos:prefLabel":{"@language":"en","@value":"Radical feminism"},"rdfs:comment":{"@language":"en","@value":"Perspective within feminism that calls for a radical reordering of society in which male supremacy is eliminated in all social and economic contexts."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000437"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001133"},{"@id":"https://homosaurus.org/v3/homoit0001516"},{"@id":"https://homosaurus.org/v3/homoit0003177"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000437"},"dc:replaces":{"@id":"http://homosaurus.org/v2/radicalFeminism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001260","dc:identifier":"homoit0001260","skos:prefLabel":{"@language":"en","@value":"Second wave feminism"},"skos:altLabel":{"@language":"en","@value":"Second wave feminism"},"rdfs:comment":{"@language":"en","@value":"Period of feminist political activity (also referred to as women’s liberation) beginning in the early 1960s that critiqued male-dominated institutions and cultural practices in society."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000437"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0003158"},{"@id":"https://homosaurus.org/v3/homoit0003173"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008001560"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000437"},"dc:replaces":{"@id":"http://homosaurus.org/v2/secondWaveFeminism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000438","dc:identifier":"homoit0000438","skos:prefLabel":{"@language":"en","@value":"Women's movement"},"skos:altLabel":{"@language":"en","@value":"Feminist movement"},"rdfs:comment":{"@language":"en","@value":"Social and political movement originating in the 1800s for reforms on women’s issues stemming from social, cultural, political, and economic inequality between men and women. Feminist issues include reproductive rights, women’s liberation, and equal pay. This term encompasses the women’s movement in its entirety, including different waves of feminist thought and activism."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001322"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000437"},{"@id":"https://homosaurus.org/v3/homoit0000753"},{"@id":"https://homosaurus.org/v3/homoit0002290"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85047741"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womensMovement"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001505","dc:identifier":"homoit0001505","skos:prefLabel":{"@language":"en","@value":"Wimmin"},"rdfs:comment":{"@language":"en","@value":"A way of spelling \"women\" that is used in certain feminist circles. First used by George P. Krapp (1872-1934) and then appeared in 19th century Black American English renderings before being used by feminists in the 20th century.\r\n"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000437"},{"@id":"https://homosaurus.org/v3/homoit0001509"},{"@id":"https://homosaurus.org/v3/homoit0001516"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001505"},"dc:replaces":{"@id":"http://homosaurus.org/v2/wimmin"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-03-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000753","dc:identifier":"homoit0000753","skos:prefLabel":{"@language":"en","@value":"Lesbian movement"},"skos:altLabel":[{"@language":"en","@value":"Lesbian organisations"},{"@language":"en","@value":"Lesbian organizations"}],"rdfs:comment":{"@language":"en","@value":"Umbrella term for activism focused on the rights of lesbians and issues faced by lesbian communities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001026"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000764"},{"@id":"https://homosaurus.org/v3/homoit0000791"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000438"},{"@id":"https://homosaurus.org/v3/homoit0000500"},{"@id":"https://homosaurus.org/v3/homoit0000734"},{"@id":"https://homosaurus.org/v3/homoit0000737"},{"@id":"https://homosaurus.org/v3/homoit0000741"},{"@id":"https://homosaurus.org/v3/homoit0000746"},{"@id":"https://homosaurus.org/v3/homoit0000757"},{"@id":"https://homosaurus.org/v3/homoit0000766"},{"@id":"https://homosaurus.org/v3/homoit0000772"},{"@id":"https://homosaurus.org/v3/homoit0000787"},{"@id":"https://homosaurus.org/v3/homoit0003169"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianMovement"},"dc:issued":{"@type":"xsd:date","