moit0000414"},{"@id":"https://homosaurus.org/v3/homoit0000419"},{"@id":"https://homosaurus.org/v3/homoit0000441"},{"@id":"https://homosaurus.org/v3/homoit0000461"},{"@id":"https://homosaurus.org/v3/homoit0000604"},{"@id":"https://homosaurus.org/v3/homoit0000616"},{"@id":"https://homosaurus.org/v3/homoit0000632"},{"@id":"https://homosaurus.org/v3/homoit0000654"},{"@id":"https://homosaurus.org/v3/homoit0000678"},{"@id":"https://homosaurus.org/v3/homoit0000684"},{"@id":"https://homosaurus.org/v3/homoit0000687"},{"@id":"https://homosaurus.org/v3/homoit0000688"},{"@id":"https://homosaurus.org/v3/homoit0000689"},{"@id":"https://homosaurus.org/v3/homoit0000690"},{"@id":"https://homosaurus.org/v3/homoit0000693"},{"@id":"https://homosaurus.org/v3/homoit0000694"},{"@id":"https://homosaurus.org/v3/homoit0000695"},{"@id":"https://homosaurus.org/v3/homoit0000697"},{"@id":"https://homosaurus.org/v3/homoit0000898"},{"@id":"https://homosaurus.org/v3/homoit0000966"},{"@id":"https://homosaurus.org/v3/homoit0000979"},{"@id":"https://homosaurus.org/v3/homoit0000980"},{"@id":"https://homosaurus.org/v3/homoit0000987"},{"@id":"https://homosaurus.org/v3/homoit0000996"},{"@id":"https://homosaurus.org/v3/homoit0001013"},{"@id":"https://homosaurus.org/v3/homoit0001029"},{"@id":"https://homosaurus.org/v3/homoit0001034"},{"@id":"https://homosaurus.org/v3/homoit0001035"},{"@id":"https://homosaurus.org/v3/homoit0001043"},{"@id":"https://homosaurus.org/v3/homoit0001044"},{"@id":"https://homosaurus.org/v3/homoit0001070"},{"@id":"https://homosaurus.org/v3/homoit0001072"},{"@id":"https://homosaurus.org/v3/homoit0001147"},{"@id":"https://homosaurus.org/v3/homoit0001253"},{"@id":"https://homosaurus.org/v3/homoit0001256"},{"@id":"https://homosaurus.org/v3/homoit0001263"},{"@id":"https://homosaurus.org/v3/homoit0001264"},{"@id":"https://homosaurus.org/v3/homoit0001309"},{"@id":"https://homosaurus.org/v3/homoit0001314"},{"@id":"https://homosaurus.org/v3/homoit0001316"},{"@id":"https://homosaurus.org/v3/homoit0001338"},{"@id":"https://homosaurus.org/v3/homoit0001368"},{"@id":"https://homosaurus.org/v3/homoit0001370"},{"@id":"https://homosaurus.org/v3/homoit0001371"},{"@id":"https://homosaurus.org/v3/homoit0001372"},{"@id":"https://homosaurus.org/v3/homoit0001373"},{"@id":"https://homosaurus.org/v3/homoit0001471"},{"@id":"https://homosaurus.org/v3/homoit0001474"},{"@id":"https://homosaurus.org/v3/homoit0001475"},{"@id":"https://homosaurus.org/v3/homoit0001477"},{"@id":"https://homosaurus.org/v3/homoit0001480"},{"@id":"https://homosaurus.org/v3/homoit0001499"},{"@id":"https://homosaurus.org/v3/homoit0001501"},{"@id":"https://homosaurus.org/v3/homoit0001502"},{"@id":"https://homosaurus.org/v3/homoit0001506"},{"@id":"https://homosaurus.org/v3/homoit0001517"},{"@id":"https://homosaurus.org/v3/homoit0001518"},{"@id":"https://homosaurus.org/v3/homoit0001519"},{"@id":"https://homosaurus.org/v3/homoit0001523"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000271"},{"@id":"https://homosaurus.org/v3/homoit0001008"},{"@id":"https://homosaurus.org/v3/homoit0001295"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001509"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nonEuroAmericanGenderAndSexualIdentities"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000560","dc:identifier":"homoit0000560","skos:prefLabel":{"@language":"en","@value":"Gender"},"rdfs:comment":{"@language":"en","@value":"A socially constructed system that gives meaning to masculinity and femininity and that unevenly distributes power and opportunity according to cultural interpretations of sex. As an element of personal identity, a gender is developed through the interaction of social roles and expectations, one’s response to those expectations, one’s physiology, and one’s internal sense of self. Gender is culturally specific, meaning that different cultures have different understandings of what gender means and how many genders should be recognized."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000078"},{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0000571"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000288"},{"@id":"https://homosaurus.org/v3/homoit0000561"},{"@id":"https://homosaurus.org/v3/homoit0000563"},{"@id":"https://homosaurus.org/v3/homoit0000565"},{"@id":"https://homosaurus.org/v3/homoit0000566"},{"@id":"https://homosaurus.org/v3/homoit0000575"},{"@id":"https://homosaurus.org/v3/homoit0000578"},{"@id":"https://homosaurus.org/v3/homoit0000579"},{"@id":"https://homosaurus.org/v3/homoit0000580"},{"@id":"https://homosaurus.org/v3/homoit0001090"},{"@id":"https://homosaurus.org/v3/homoit0001269"},{"@id":"https://homosaurus.org/v3/homoit0001463"},{"@id":"https://homosaurus.org/v3/homoit0001816"},{"@id":"https://homosaurus.org/v3/homoit0001817"},{"@id":"https://homosaurus.org/v3/homoit0001899"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000004","dc:identifier":"homoit0000004","skos:prefLabel":{"@language":"en","@value":"Asexuality"},"skos:altLabel":{"@language":"en","@value":"Ace"},"rdfs:comment":{"@language":"en","@value":"A sexual orientation generally characterized by a lack of sexual attraction or desire."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001298"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000067"},{"@id":"https://homosaurus.org/v3/homoit0000071"},{"@id":"https://homosaurus.org/v3/homoit0000807"},{"@id":"https://homosaurus.org/v3/homoit0000882"},{"@id":"https://homosaurus.org/v3/homoit0001282"},{"@id":"https://homosaurus.org/v3/homoit0001493"},{"@id":"https://homosaurus.org/v3/homoit0001535"},{"@id":"https://homosaurus.org/v3/homoit0001644"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2016000238"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/asexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-18"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001298","dc:identifier":"homoit0001298","skos:prefLabel":{"@language":"en","@value":"Sexual orientation"},"rdfs:comment":{"@language":"en","@value":"The direction of an individual's sexual attraction towards other individuals of the same, opposite, or multiple sexes; commonly understood to be biologically and physiologically dictated, rather than sociologically determined."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000004"},{"@id":"https://homosaurus.org/v3/homoit0000204"},{"@id":"https://homosaurus.org/v3/homoit0000343"},{"@id":"https://homosaurus.org/v3/homoit0000631"},{"@id":"https://homosaurus.org/v3/homoit0000647"},{"@id":"https://homosaurus.org/v3/homoit0000799"},{"@id":"https://homosaurus.org/v3/homoit0001292"},{"@id":"https://homosaurus.org/v3/homoit0001531"},{"@id":"https://homosaurus.org/v3/homoit0001556"},{"@id":"https://homosaurus.org/v3/homoit0001558"},{"@id":"https://homosaurus.org/v3/homoit0001626"},{"@id":"https://homosaurus.org/v3/homoit0001632"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000303"},{"@id":"https://homosaurus.org/v3/homoit0000345"},{"@id":"https://homosaurus.org/v3/homoit0000559"},{"@id":"https://homosaurus.org/v3/homoit0001290"},{"@id":"https://homosaurus.org/v3/homoit0001295"},{"@id":"https://homosaurus.org/v3/homoit0001297"},{"@id":"https://homosaurus.org/v3/homoit0001300"},{"@id":"https://homosaurus.org/v3/homoit0001636"},{"@id":"https://homosaurus.org/v3/homoit0001828"},{"@id":"https://homosaurus.org/v3/homoit0001915"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh91005179"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualOrientation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-18"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000067","dc:identifier":"homoit0000067","skos:prefLabel":{"@language":"en","@value":"Aromantic people"},"rdfs:comment":{"@language":"en","@value":"Individuals who do not generally experience romantic attraction or desire."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001829"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000004"},{"@id":"https://homosaurus.org/v3/homoit0001237"},{"@id":"https://homosaurus.org/v3/homoit0001532"},{"@id":"https://homosaurus.org/v3/homoit0001644"},{"@id":"https://homosaurus.org/v3/homoit0001757"},{"@id":"https://homosaurus.org/v3/homoit0001761"},{"@id":"https://homosaurus.org/v3/homoit0001765"},{"@id":"https://homosaurus.org/v3/homoit0001823"},{"@id":"https://homosaurus.org/v3/homoit0001824"},{"@id":"https://homosaurus.org/v3/homoit0001825"},{"@id":"https://homosaurus.org/v3/homoit0001826"},{"@id":"https://homosaurus.org/v3/homoit0001827"},{"@id":"https://homosaurus.org/v3/homoit0002145"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001829"},"dc:replaces":{"@id":"http://homosaurus.org/v2/aromanticPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://ho