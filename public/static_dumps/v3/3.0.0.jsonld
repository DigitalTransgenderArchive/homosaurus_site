/homosaurus.org/v3/homoit0000860"},{"@id":"https://homosaurus.org/v3/homoit0000999"},{"@id":"https://homosaurus.org/v3/homoit0001017"},{"@id":"https://homosaurus.org/v3/homoit0001018"},{"@id":"https://homosaurus.org/v3/homoit0001101"},{"@id":"https://homosaurus.org/v3/homoit0001230"},{"@id":"https://homosaurus.org/v3/homoit0001376"},{"@id":"https://homosaurus.org/v3/homoit0001377"},{"@id":"https://homosaurus.org/v3/homoit0002271"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2017003293"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001133"},"dc:replaces":{"@id":"http://homosaurus.org/v2/socialPrivilege"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-14"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000055","dc:identifier":"homoit0000055","skos:prefLabel":{"@language":"en","@value":"Anti-gay discrimination"},"rdfs:comment":{"@language":"en","@value":"The unjust or prejudicial treatment of gay men due to their sexual identity; may include the denial of legal rights, employment, and housing."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000356"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000646"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88006552"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000356"},"dc:replaces":{"@id":"http://homosaurus.org/v2/antiGayDiscrimination"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000646","dc:identifier":"homoit0000646","skos:prefLabel":{"@language":"en","@value":"Homophobia"},"rdfs:comment":{"@language":"en","@value":"Antagonism or disgust directed towards homosexuality as an identity or men who are perceived to be or are actually gay. Homophobia can include denial of the existence of homosexuality, stereotypes, verbal harassment, and physical violence. This term is often used colloquially to encompass all LGBTQ+ phobia."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000920"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000391"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000055"},{"@id":"https://homosaurus.org/v3/homoit0000056"},{"@id":"https://homosaurus.org/v3/homoit0000506"},{"@id":"https://homosaurus.org/v3/homoit0000619"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88006552"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homophobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-03-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000056","dc:identifier":"homoit0000056","skos:prefLabel":{"@language":"en","@value":"Anti-gay violence"},"skos:altLabel":{"@language":"en","@value":"Gay bashing"},"rdfs:comment":{"@language":"en","@value":"Behavior involving physical force intended to harm or kill gay men on the basis of their identity. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000059"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000449"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000109"},{"@id":"https://homosaurus.org/v3/homoit0000646"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005020376"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/anti-gayViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-03-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000449","dc:identifier":"homoit0000449","skos:prefLabel":{"@language":"en","@value":"Forced castration"},"rdfs:comment":{"@language":"en","@value":"Forced or coerced removal of the testes or use of the testes, typically through surgical or chemical means, enacted by legal authorities or as a hate crime."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000056"},{"@id":"https://homosaurus.org/v3/homoit0000241"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85128028"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/forcedCastration"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-03-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000057","dc:identifier":"homoit0000057","skos:prefLabel":{"@language":"en","@value":"Anti-lesbian discrimination"},"rdfs:comment":{"@language":"en","@value":"The unjust or prejudicial treatment of lesbians due to their sexual identity; may include the denial of legal rights, employment, and housing."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000356"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000803"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000356"},"dc:replaces":{"@id":"http://homosaurus.org/v2/antiLesbianDiscrimination"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000803","dc:identifier":"homoit0000803","skos:prefLabel":{"@language":"en","@value":"Lesbophobia"},"rdfs:comment":{"@language":"en","@value":"Antagonism or disgust directed towards lesbianism as an identity or lesbians due to their sexuality, perceived or actual. Lesbophobia can include denial of the existence of lesbianism, stereotypes, verbal harassment, and physical violence."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000920"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000057"},{"@id":"https://homosaurus.org/v3/homoit0000058"},{"@id":"https://homosaurus.org/v3/homoit0000556"},{"@id":"https://homosaurus.org/v3/homoit0000619"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbophobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000058","dc:identifier":"homoit0000058","skos:prefLabel":{"@language":"en","@value":"Anti-lesbian violence"},"skos:altLabel":{"@language":"en","@value":"Lesbian bashing"},"rdfs:comment":{"@language":"en","@value":"Behavior involving physical force intended to harm or kill lesbians on the basis of their identity. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000059"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000109"},{"@id":"https://homosaurus.org/v3/homoit0000556"},{"@id":"https://homosaurus.org/v3/homoit0000803"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/anti-lesbianViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000061","dc:identifier":"homoit0000061","skos:prefLabel":{"@language":"en","@value":"Anti-queer violence"},"rdfs:comment":{"@language":"en","@value":"Behavior involving physical force intended to harm or kill queer people on the basis of their identity. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000059"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit00