ce (seronegativity) of antibodies in blood serum; commonly used in in reference to HIV testing."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000005"},{"@id":"https://homosaurus.org/v3/homoit0000635"},{"@id":"https://homosaurus.org/v3/homoit0000636"},{"@id":"https://homosaurus.org/v3/homoit0000640"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000639"},"dc:replaces":{"@id":"http://homosaurus.org/v2/serostatus"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000640","dc:identifier":"homoit0000640","skos:prefLabel":{"@language":"en","@value":"HIV-undetectable people"},"rdfs:comment":{"@language":"en","@value":"People who have contracted HIV and received treatment to reduce their HIV antibodies to an amount that can no longer be detected by standard HIV tests."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000636"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000005"},{"@id":"https://homosaurus.org/v3/homoit0000635"},{"@id":"https://homosaurus.org/v3/homoit0000639"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/HIVUndetectablePeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000686","dc:identifier":"homoit0000686","skos:prefLabel":{"@language":"en","@value":"Kaposi's sarcoma"},"rdfs:comment":{"@language":"en","@value":"A type of cancer that causes lesions to grow in the skin, lymph nodes, internal organs, and mucous membranes; often affects people with immune deficiencies, such as AIDS."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000005"},{"@id":"https://homosaurus.o