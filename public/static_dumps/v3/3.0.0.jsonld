le (LGBTQ)"},"skos:altLabel":[{"@language":"en","@value":"Caucasians (LGBTQ)"},{"@language":"en","@value":"Caucasian LGBTQ people"},{"@language":"en","@value":"LGBTQ Caucasian people"},{"@language":"en","@value":"LGBTQ white people"},{"@language":"en","@value":"White people (LGBTQ)"}],"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who are white."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000201"},{"@id":"https://homosaurus.org/v3/homoit0000555"},{"@id":"https://homosaurus.org/v3/homoit0000797"},{"@id":"https://homosaurus.org/v3/homoit0001226"},{"@id":"https://homosaurus.org/v3/homoit0001461"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001133"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000243"},"dc:replaces":{"@id":"http://homosaurus.org/v2/whitePeopleLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001002","dc:identifier":"homoit0001002","skos:prefLabel":{"@language":"srn","@value":"Mati"},"rdfs:comment":{"@language":"en","@value":"Surinamese-Creole women who have sexual relations with other women but also have had or do have relationships with men."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000202"},{"@id":"https://homosaurus.org/v3/homoit0001510"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mati"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001510","dc:identifier":"homoit0001510","skos:prefLabel":{"@language":"en","@value":"Women who have sex with women"},"skos:altLabel":{"@language":"en","@value":"WSW"},"rdfs:comment":{"@language":"en","@value":"Wo