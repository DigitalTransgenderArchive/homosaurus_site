"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001136"},{"@id":"https://homosaurus.org/v3/homoit0001277"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh98005017"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000278"},"dc:replaces":{"@id":"http://homosaurus.org/v2/prostitutesClients"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001136","dc:identifier":"homoit0001136","skos:prefLabel":{"@language":"en","@value":"Prostitution"},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001276"},{"@id":"https://homosaurus.org/v3/homoit0001299"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000434"},{"@id":"https://homosaurus.org/v3/homoit0000494"},{"@id":"https://homosaurus.org/v3/homoit0000769"},{"@id":"https://homosaurus.org/v3/homoit0000984"},{"@id":"https://homosaurus.org/v3/homoit0001438"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000278"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85107626"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000011"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001276"},"dc:replaces":{"@id":"http://homosaurus.org/v2/prostitution"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2025-01-26"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000279","dc:identifier":"homoit0000279","skos:prefLabel":{"@language":"en","@value":"Clit rings"},"rdfs:comment":{"@language":"en","@value":"Genital piercings placed directly through the hood of the clitoris, typically worn for aesthetic purposes or to enhance sexual arousal."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001266"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000282"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/clitRings"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000282","dc:identifier":"homoit0000282","skos:prefLabel":{"@language":"en","@value":"Clitoris"},"rdfs:comment":{"@language":"en","@value":"Erogenous external organ that is capable of erection under sexual stimulation."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000401"},{"@id":"https://homosaurus.org/v3/homoit0000585"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000460"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000279"},{"@id":"https://homosaurus.org/v3/homoit0000280"},{"@id":"https://homosaurus.org/v3/homoit0001844"},{"@id":"https://homosaurus.org/v3/homoit0001848"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85027086"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000401"},"dc:replaces":{"@id":"http://homosaurus.org/v2/clitoris"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000430","dc:identifier":"homoit0000430","skos:prefLabel":{"@language":"en","@value":"Female genital mutilation"},"rdfs:comment":{"@language":"en","@value":"The practice of cutting or removing the female genitals, sometimes to control sexual drive or punish lesbianism."},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000281"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000653"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002781"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000430"},"dc:replaces":{"@id":"http://homosaurus.org/v2/femaleGenitalMutilation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000670","dc:identifier":"homoit0000670","skos:prefLabel":{"@language":"en","@value":"Intersex genital mutilation"},"skos:altLabel":{"@language":"en","@value":"IGM"},"rdfs:comment":{"@language":"en","@value":"Surgeries or other medical treatments performed, typically on newborn babies or children, to \"normalize\" the patient's reproductive or sexual anatomy and force their body to conform to medical or social expectations for what is male or female. IGM practices can be performed for cultural, social, or religious reasons. Though they are typically justified through a medical lens, IGM practices are medically unnecessary and non-consensual."},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000281"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000352"},{"@id":"https://homosaurus.org/v3/homoit0000618"},{"@id":"https://homosaurus.org/v3/homoit0000666"},{"@id":"https://homosaurus.org/v3/homoit0000673"},{"@id":"https://homosaurus.org/v3/homoit0001268"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000670"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexGenitalMutilation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000585","dc:identifier":"homoit0000585","skos:prefLabel":{"@language":"en","@value":"Genitals"},"skos:altLabel":{"@language":"en","@value":"Genitalia"},"rdfs:comment":{"@language":"en","@value":"General term for erogenous and/or reproductive organs (e.g., vagina, clitoris, penis)."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001269"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000282"},{"@id":"https://homosaurus.org/v3/homoit0001099"},{"@id":"https://homosaurus.org/v3/homoit0001361"},{"@id":"https://homosaurus.org/v3/homoit0001488"},{"@id":"https://homosaurus.org/v3/homoit0001497"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000401"},{"@id":"https://homosaurus.org/v3/homoit0001268"},{"@id":"https://homosaurus.org/v3/homoit0003110"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85053822"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genitals"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000460","dc:identifier":"homoit0000460","skos:prefLabel":{"@language":"en","@value":"G-spot"},"rdfs:comment":{"@language":"en","@value":"Commonly characterized as an erogenous area of the front anterior wall of the vagina that, when stimulated, can lead to sexual arousal, orgasms, and/or ejaculation."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000282"},{"@id":"https://homosaurus.org/v3/homoit0001488"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001062"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002802"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000401"},"dc:replaces":{"@id":"http://homosaurus.org/v2/g-spot"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000283","dc:identifier":"homoit0000283","skos:prefLabel":{"@language":"en","@value":"Clitoromegaly"},"skos:altLabel":{"@language":"en","@value":"Enlarged clitoris"},"rdfs:comment":{"@language":"en","@value":"People born with clitoromegaly have a clitoris that is larger than what society considers to be typical. Clitoromegaly is a trait associated with several different intersex variations, including congenital adrenal hyperplasia and progestin-induced virilization."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/clitoromegaly"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000284","dc:identifier":"homoit0000284","skos:prefLabel":{"@language":"en","@value":"Clones (Gay culture)"},"skos:altLabel":[{"@language":"en","@value":"Clones (Gay men)"},{"@language":"en","@value":"Clones"}],"rdfs:comment":{"@language":"en","@value":"Historical term for gay men who dress in a particular masculine fashion; often used in the Castro District of San Francisco."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000506"},{"@id":"https://homosaurus.org/v3/homoit0000878"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/clonesGayMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000286","dc:identifier":"homoit0000286","skos:prefLabel":{"@language":"en","@value":"Closeted gay men"},"rdfs:comment":{"@language":"en","@value":"Gay men who do not identify as such to others."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000506"},{"@id":"https://homosaurus.org/v3/homoit0001783"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000285"},{"@id":"https://homosaurus.org/v3/homoit0000287"},{"@id":"https://homosaurus.org/v3/homoit0000295"},{"@id":"https://homosaurus.org/v3/homoit0000365"},{"@id":"https://homosaurus.org/v3/homoit0001065"},{"@id":"https://homosaurus.org/v3/homoit0001261"},{"@id":"https://homosaurus.org/v3/homoit0001784"},{"@id":"https://homosaurus.org/v3/homoit0001785"},{"@id":"https://homosaurus.org/v3/homoit0002905"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93006732"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/closetedGayMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000287","dc:identifier":"homoit0000287","skos:prefLabel":{"@language":"en","@value":"Closeted lesbians"},"rdfs:comment":{"@language":"en","@value":"Lesbians who do not identify as such to others."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000556"},{"@id":"https://homosaurus.org/v3/homoit0001783"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000285"},{"@id":"https://homosaurus.org/v3/homoit0000286"},{"@id":"https://homosaurus.org/v3/homoit0000295"},{"@id":"https://homosaurus.org/v3/homoit0001065"},{"@id":"https://homosaurus.org/v3/homoit0001261"},{"@id":"https://homosaurus.org/v3/homoit0001784"},{"@id":"https://homosaurus.org/v3/homoit0001785"},{"@id":"https://homosaurus.org/v3/homoit0002905"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/closetedLesbians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001261","dc:identifier":"homoit0001261","skos:prefLabel":{"@language":"en","@value":"Secrecy"},"rdfs:comment":{"@language":"en","@value":"The state of being intentionally withheld, concealed, or kept secret; use in reference to LGBTQ+ individuals who conceal their (or others’) identities, whether out of preference or for safety reasons."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000285"},{"@id":"https://homosaurus.org/v3/homoit0000286"},{"@id":"https://homosaurus.org/v3/homoit0000287"},{"@id":"https://homosaurus.org/v3/homoit0000288"},{"@id":"https://homosaurus.org/v3/homoit0000295"},{"@id":"https://homosaurus.org/v3/homoit0000365"},{"@id":"https://homosaurus.org/v3/homoit0001065"},{"@id":"https://homosaurus.org/v3/homoit0001783"},{"@id":"https://homosaurus.org/v3/homoit0001784"},{"@id":"https://homosaurus.org/v3/homoit0001785"},{"@id":"https://homosaurus.org/v3/homoit0001786"},{"@id":"https://homosaurus.org/v3/homoit0001787"},{"@id":"https://homosaurus.org/v3/homoit0001788"},{"@id":"https://homosaurus.org/v3/homoit0002905"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85119431"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001261"},"dc:replaces":{"@id":"http://homosaurus.org/v2/secrecy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001090","dc:identifier":"homoit0001090","skos:prefLabel":{"@language":"en","@value":"Passing (Gender)"},"rdfs:comment":{"@language":"en","@value":"An individual's ability to \"pass,\" or be accepted or regarded as a member of the gender they identify with. \"Passing\" has historically been used to describe an individual's ability to \"pass\" as a certain race or ethnicity, though the term was later appropriated by the LGBTQ+ community."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000288"},{"@id":"https://homosaurus.org/v3/homoit0000316"},{"@id":"https://homosaurus.org/v3/homoit0000560"},{"@id":"https://homosaurus.org/v3/homoit0001140"},{"@id":"https://homosaurus.org/v3/homoit0001233"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001781"},{"@id":"https://homosaurus.org/v3/homoit0001901"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001090"},"dc:replaces":{"@id":"http://homosaurus.org/v2/passingGender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000289","dc:identifier":"homoit0000289","skos:prefLabel":{"@language":"en","@value":"Clothing"},"rdfs:comment":{"@language":"en","@value":"Items worn on the body for protection, insulation, and self-expression; typically made of fabric or textiles."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000568"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000970"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000316"},{"@id":"https://homosaurus.org/v3/homoit0000318"},{"@id":"https://homosaurus.org/v3/homoit0000366"},{"@id":"https://homosaurus.org/v3/homoit0000367"},{"@id":"https://homosaurus.org/v3/homoit0001895"},{"@id":"https://homosaurus.org/v3/homoit0002169"},{"@id":"https://homosaurus.org/v3/homoit0003063"},{"@id":"https://homosaurus.org/v3/homoit0003066"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh99005081"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/clothing"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000970","dc:identifier":"homoit0000970","skos:prefLabel":{"@language":"en","@value":"Lingerie"},"rdfs:comment":{"@language":"en","@value":"Category of clothing that includes bras, underwear, hosiery, and robes; typically refers to undergarments and sleepwear designed to be sexually appealing and worn in erotic contexts."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000289"},{"@id":"https://homosaurus.org/v3/homoit0000367"},{"@id":"https://homosaurus.org/v3/homoit0001266"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000316"},{"@id":"https://homosaurus.org/v3/homoit0000318"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85077205"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lingerie"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000316","dc:identifier":"homoit0000316","skos:prefLabel":{"@language":"en","@value":"Crossdressers"},"skos:altLabel":{"@language":"en","@value":"Cross-dressers"},"rdfs:comment":{"@language":"en","@value":"Individuals who wear clothes stereotypical to or associated with a gender other than their predominantly-identified gender. Crossdressers often develop a persona while crossdressing. Only use to describe individuals who self-identify as crossdressers."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001817"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000289"},{"@id":"https://homosaurus.org/v3/homoit0000318"},{"@id":"https://homosaurus.org/v3/homoit0000373"},{"@id":"https://homosaurus.org/v3/homoit0000375"},{"@id":"https://homosaurus.org/v3/homoit0000396"},{"@id":"https://homosaurus.org/v3/homoit0000970"},{"@id":"https://homosaurus.org/v3/homoit0001076"},{"@id":"https://homosaurus.org/v3/homoit0001085"},{"@id":"https://homosaurus.org/v3/homoit0001090"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001470"},{"@id":"https://homosaurus.org/v3/homoit0001781"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh89002495"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001817"},"dc:replaces":{"@id":"http://homosaurus.org/v2/crossdressers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000318","dc:identifier":"homoit0000318","skos:prefLabel":{"@language":"en","@value":"Crossdressing"},"rdfs:comment":{"@language":"en","@value":"The practice of wearing clothing stereotypical to a gender other than the individual's predominantly-identified gender."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000568"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000289"},{"@id":"https://homosaurus.org/v3/homoit0000316"},{"@id":"https://homosaurus.org/v3/homoit0000395"},{"@id":"https://homosaurus.org/v3/homoit0000685"},{"@id":"https://homosaurus.org/v3/homoit0000970"},{"@id":"https://homosaurus.org/v3/homoit0001233"},{"@id":"https://homosaurus.org/v3/homoit0001469"},{"@id":"https://homosaurus.org/v3/homoit0001895"},{"@id":"https://homosaurus.org/v3/homoit0003126"},{"@id":"https://homosaurus.org/v3/homoit0003160"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85137104"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/crossdressing"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000366","dc:identifier":"homoit0000366","skos:prefLabel":{"@language":"en","@value":"Drab"},"rdfs:comment":{"@language":"en","@value":"Slang term used to describe people wearing masculine clothing, typically drag queens or crossdressers who also sometimes wear feminine clothing. Drab is a shortened form of the phrase \"dressed as a boy\" or \"dress resembling a boy.\""},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000568"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000289"},{"@id":"https://homosaurus.org/v3/homoit0000367"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/drab"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000290","dc:identifier":"homoit0000290","skos:prefLabel":{"@language":"en","@value":"Party drugs"},"skos:altLabel":{"@language":"en","@value":"Club drugs"},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000380"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002289"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000380"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001235"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partyDrugs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000380","dc:identifier":"homoit0000380","skos:prefLabel":{"@language":"en","@value":"Drugs"},"skos:altLabel":[{"@language":"en","@value":"Alcohol use (LGBTQ)"},{"@language":"en","@value":"Alcohol use in LGBTQ+ communities"},{"@language":"en","@value":"Drug use (LGBTQ)"},{"@language":"en","@value":"Drug use in LGBTQ+ communities"},{"@language":"en","@value":"LGBTQ+ substance use"},{"@language":"en","@value":"Substance use (LGBTQ)"}],"rdfs:comment":{"@language":"en","@value":"The use of substances (that are typically deemed harmful or are subject to legal restriction, such as drugs or alcohol) and discussions surrounding the p