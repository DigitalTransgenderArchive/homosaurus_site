xual identity"},"rdfs:comment":{"@language":"en","@value":"Term used to describe the sexual identity of individuals who are romantically and/or sexually attracted to people assigned the “opposite” sex at birth."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001295"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000627"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexualIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-02-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000625","dc:identifier":"homoit0000625","skos:prefLabel":{"@language":"en","@value":"Heterosexual marriage"},"rdfs:comment":{"@language":"en","@value":"The legally and formally recognized union of a heterosexual man and woman as partners in a personal relationship."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000990"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexualMarriage"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000628","dc:identifier":"homoit0000628","skos:prefLabel":{"@language":"en","@value":"Heterosociality"},"skos:altLabel":[{"@language":"en","@value":"Heterosexual social relationships"},{"@language":"en","@value":"Heterosocial bonds"}],"rdfs:comment":{"@language":"en","@value":"In sociology, this term is used to describe social relations and bonds between members of the opposite sex or gender in a given culture. Typically excludes romantic and sexual relationships."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001237"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000649"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosociality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001556","dc:identifier":"homoit0001556","skos:prefLabel":{"@language":"en","@value":"Monosexuality"},"rdfs:comment":{"@language":"en","@value":"A sexuality that involves attraction to only one gender; includes homosexuality and heterosexuality."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001298"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000631"},{"@id":"https://homosaurus.org/v3/homoit0000647"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001290"},{"@id":"https://homosaurus.org/v3/homoit0001295"},{"@id":"https://homosaurus.org/v3/homoit0001300"},{"@id":"https://homosaurus.org/v3/homoit0001555"},{"@id":"https://homosaurus.org/v3/homoit0001915"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/monosexuality"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2023-02-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000633","dc:identifier":"homoit0000633","skos:prefLabel":{"@language":"en","@value":"LGBTQ Hindus"},"skos:altLabel":[{"@language":"en","@value":"Hindus (LGBTQ)"},{"@language":"en","@value":"LGBTQ Hindus"}],"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who are Hindu."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000928"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQHindus"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000638","dc:identifier":"homoit0000638","skos:prefLabel":{"@language":"en","@value":"Serodiscordant couples"},"skos:altLabel":{"@language":"en","@value":"HIV-serodiscordant couples"},"rdfs:comment":{"@language":"en","@value":"Partnerships in which one person has HIV and the other does not."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000635"},{"@id":"https://homosaurus.org/v3/homoit0000636"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000638"},"dc:replaces":{"@id":"http://homosaurus.org/v2/serodiscordantCouples"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000642","dc:identifier":"homoit0000642","skos:prefLabel":{"@language":"en","@value":"Homomonuments"},"skos:altLabel":[{"@language":"en","@value":"Homomonuments"},{"@language":"en","@value":"Monuments (LGBTQ)"}],"rdfs:comment":{"@language":"en","@value":"Public monuments designed to commemorate LGBTQ+ people who have been persecuted because of their gender and/or sexual identities."},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh99004297"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000642"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000901"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homomonuments"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-09"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001117","dc:identifier":"homoit0001117","skos:prefLabel":{"@language":"en","@value":"Pinkwashing"},"rdfs:comment":{"@language":"en","@value":"A variety of marketing and political strategies aimed at promoting products, countries, people, or entities to LGBTQ+ people; using LGBTQ+-related symbols in order to be perceived as progressive, modern, and tolerant; and/or utilizing concern for LGBTQ+ people and rights to justify or deviate attention from settler-colonialism, genocide, invasion, and intervention in other countries."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000643"},{"@id":"https://homosaurus.org/v3/homoit0000873"},{"@id":"https://homosaurus.org/v3/homoit0000899"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001117"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pinkwashing"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000645","dc:identifier":"homoit0000645","skos:prefLabel":{"@language":"en","@value":"Homophiles"},"rdfs:comment":{"@language":"en","@value":"Outdated term for lesbians and gay men. The use of the word began to disappear with the emergence of the gay liberation movement of the late 1960s and early 1970s."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000878"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001297"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homophiles"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001240","dc:identifier":"homoit0001240","skos:prefLabel":{"@language":"en","@value":"Ritual homosexuality"},"rdfs:comment":{"@language":"en","@value":"Non-reciprocal genital contact, typically fellatio, between younger and older men that takes place during initiation rituals practiced by the Sambari people of Papua New Guinea. This term was developed by Western outsiders and has been strongly criticized by the affected community."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000647"},{"@id":"https://homosaurus.org/v3/homoit0001299"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000886"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ritualHomosexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-02-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000648","dc:identifier":"homoit0000648","skos:prefLabel":{"@language":"en","@value":"Homosexuals"},"rdfs:comment":{"@language":"en","@value":"Outdated term for lesbians and gay men."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000878"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001297"},{"@id":"https://homosaurus.org/v3/homoit0001531"},{"@id":"https://homosaurus.org/v3/homoit0001915"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85061795"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homosexuals"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000981","dc:identifier":"homoit0000981","skos:prefLabel":{"@language":"en","@value":"Male bonding"},"rdfs:comment":{"@language":"en","@value":"Friendship and connection between two or more male-identified people."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000649"},{"@id":"https://homosaurus.org/v3/homoit0000982"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000981"},"dc:replaces":{"@id":"http://homosaurus.org/v2/maleBonding"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001138","dc:identifier":"homoit0001138","skos:prefLabel":{"@language":"en","@value":"Puberty blockers"},"rdfs:comment":{"@language":"en","@value":"Group of medications used to inhibit puberty."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000650"},{"@id":"https://homosaurus.org/v3/homoit0001007"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001400"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pubertyBlockers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001377","dc:identifier":"homoit0001377","skos:prefLabel":{"@language":"en","@value":"Toxic masculinity"},"rdfs:comment":{"@language":"en","@value":"Set of attitudes, behaviors, and cultural norms stereotypically associated with or expected of men and which are regarded as having a negative impact on men and society at large."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000995"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000655"},{"@id":"https://homosaurus.org/v3/homoit0001133"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/toxicMasculinity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000656","dc:identifier":"homoit0000656","skos:prefLabel":{"@language":"en","@value":"Hypersexuality"},"skos:altLabel":[{"@language":"en","@value":"Nymphomania"},{"@language":"en","@value":"Satyriasis"},{"@language":"en","@value":"Andromania"},{"@language":"en","@value":"Clitoromania"},{"@language":"en","@value":"Don Juan syndrome"},{"@language":"en","@value":"Don Juanism"},{"@language":"en","@value":"Estromania"},{"@language":"en","@value":"Excessive sex drive"},{"@language":"en","@value":"Furor amatorius"},{"@language":"en","@value":"Furor uterinus"},{"@language":"en","@value":"Hyper-sexuality"},{"@language":"en","@value":"Hyperactive sexual desire disorder"},{"@language":"en","@value":"Hyperaesthesia"},{"@language":"en","@value":"Hypereroticism"},{"@language":"en","@value":"Hyperlibido"},{"@language":"en","@value":"Hyperphilia"},{"@language":"en","@value":"Hypersensuality"},{"@language":"en","@value":"Hypersexual disorder"},{"@language":"en","@value":"Messalina syndrome"},{"@language":"en","@value":"Œstromania"},{"@language":"en","@value":"Oversexuality"},{"@language":"en","@value":"Satyrism"},{"@language":"en","@value":"Satyromania"},{"@language":"en","@value":"Sexual hyperesthesia"},{"@language":"en","@value":"Sexual hyperversion"}],"rdfs:comment":{"@language":"en","@value":"Term used to describe a level or frequency of sexual desire that is perceived as excessive within a given culture. Though the medical community has not reached a consensus as to whether hypersexuality should be included as a clinical diagnosis, doctors and psychologists have historically diagnosed LGBTQ+ people with hypersexuality (or other related labels) in order to wrongly treat their identities and desires as medical disorders. Should only be used in a historical context or if an individual self-identifies with the term."},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001284"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001283"},{"@id":"https://homosaurus.org/v3/homoit0001306"},{"@id":"https://homosaurus.org/v3/homoit0001538"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000656"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hypersexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001538","dc:identifier":"homoit0001538","skos:prefLabel":{"@language":"en","@value":"Erotomania"},"skos:altLabel":[{"@language":"en","@value":"Clinical erotomania"},{"@language":"en","@value":"De Clérambault syndrome"},{"@language":"en","@value":"De Clérambault's syndrome"},{"@language":"en","@value":"Obsessional erotomania"},{"@language":"en","@value":"Primary erotomania"}],"rdfs:comment":{"@language":"en","@value":"Condition characterized by an individual's persistent and often mistaken belief that another person is infatuated or in love with them. Can also be used to describe a level or frequency of sexual desire perceived as excessive within a given culture. Medical doctors and psychologists have historically diagnosed LGBTQ+ people with erotomania in order to wrongly treat their identities and desires as medical disorders. Should only be used in a historical context or if an individual self-identifies with the term."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000656"},{"@id":"https://homosaurus.org/v3/homoit0001283"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97003456"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001538"},"dc:replaces":{"@id":"http://homosaurus.org/v2/erotomania"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2022-11-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000657","dc:identifier":"homoit0000657","skos:prefLabel":{"@language":"en","@value":"Hypospadias"},"rdfs:comment":{"@language":"en","@value":"People with hypospadias are born with their urinary opening located somewhere other than the tip of the penis. In \"distal hypospadias,\" the urinary opening is elsewhere on the glans (head) of the penis, whereas in \"proximal hypospadias,\" it is on the underside of the penis and sometimes further back near the scrotum. Hypospadias is one of the most common and visible genital variations. People with hypospadias often have additional variations like chordee (a bend in the penis) or cryptorchidism (undescended testicles)."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85063812"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hypospadias"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000659","dc:identifier":"homoit0000659","skos:prefLabel":[{"@language":"en-us","@value":"In vitro fertilization"},{"@language":"en-gb","@value":"In vitro fertilisation"}],"skos:altLabel":{"@language":"en","@value":"IVF"},"rdfs:comment":{"@language":"en","@value":"Medical practice of achieving fertilization by combining sperm and eggs in laboratory settings to induce pregnancy."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000843"},{"@id":"https://homosaurus.org/v3/homoit0002618"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001234"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002629"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85047905"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000864"},"dc:replaces":{"@id":"http://homosaurus.org/v2/inVitroFertilisation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-10-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001234","dc:identifier":"homoit0001234","skos:prefLabel":[{"@language":"en-us","@value":"Reciprocal in vitro fertilization"},{"@language":"en-gb","@value":"Reciprocal in vitro fertilisation"}],"skos:altLabel":{"@language":"en","@value":"Shared motherhood"},"rdfs:comment":{"@language":"en","@value":"A medical procedure in which the egg of one partner is fertilized with donor sperm and then transferred to the uterus of the other partner to bring to term."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000659"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000864"},"dc:replaces":{"@id":"http://homosaurus.org/v2/reciprocalInVitroFertilisation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000737","dc:identifier":"homoit0000737","skos:prefLabel":[{"@language":"en-us","@value":"Lesbian information centers"},{"@language":"en-gb","@value":"Lesbian information centres"}],"rdfs:comment":{"@language":"en","@value":"Institutions providing education, support, and information about lesbian identity and lesbian communities to lesbians."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000660"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000753"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianInformationCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001179","dc:identifier":"homoit0001179","skos:prefLabel":[{"@language":"en-us","@value":"Queer information centers"},{"@language":"en-gb","@value":"Queer information centres"}],"rdfs:comment":{"@language":"en","@value":"Institutions that provide education, support, and information about queerness and queer communities to queer people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000660"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001187"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerInformationCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001409","dc:identifier":"homoit0001409","skos:prefLabel":[{"@language":"en-us","@value":"Transgender information centers"},{"@language":"en-gb","@value":"Transgender information centres"}],"skos:altLabel":{"@language":"en-us","@value":"Transgender documentation centers"},"rdfs:comment":{"@language":"en","@value":"Institutions providing education, support, and information about transgender issues and transgender communities to transgender people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000660"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001423"},{"@id":"https://homosaurus.org/v3/homoit0001463"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderInformationCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000877","dc:identifier":"homoit0000877","skos:prefLabel":{"@language":"en","@value":"LGBTQ health education"},"skos:altLabel":{"@language":"en","@value":"LGBTQ health education"},"rdfs:comment":{"@language":"en","@value":"Instruction about health for LGBTQ+ people, including topics such as gender-affirming healthcare and safer sex practices. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000661"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000661"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQHealthEducation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000665","dc:identifier":"homoit0000665","skos:prefLabel":{"@language":"en","@value":"Internet forums"},"rdfs:comment":{"@language":"en","@value":"Websites designed to facilitate discussion amongst users through posted messages."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001321"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000888"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97004057"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001321"},"dc:replaces":{"@id":"http://homosaurus.org/v2/internetForums"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000888","dc:identifier":"homoit0000888","skos:prefLabel":{"@language":"en","@value":"LGBTQ Internet forums"},"skos:altLabel":{"@language":"en","@value":"LGBTQ Internet forums"},"rdfs:comment":{"@language":"en","@value":"Websites that facilitate online conversations between LGBTQ+ people, often about LGBQ+ issues."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000665"},{"@id":"https://homosaurus.org/v3/homoit0000946"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000962"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001321"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQInternetForums"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000860","dc:identifier":"homoit0000860","skos:prefLabel":{"@language":"en","@value":"LGBTQ ethnic groups"},"skos:altLabel":[{"@language":"en","@value":"Ethnic groups (LGBTQ)"},{"@language":"en","@value":"LGBTQ ethnic groups"},{"@language":"en","@value":"People in ethnic groups (LGBTQ)"}],"rdfs:comment":{"@language":"en","@value":"Groups of people who share an identity based on a common nationality, culture, ancestry, language, religion, etc. and who also identify as LGBTQ+. Do not use to describe migrants."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000915"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000682"},{"@id":"https://homosaurus.org/v3/homoit0000875"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000667"},{"@id":"https://homosaurus.org/v3/homoit0000886"},{"@id":"https://homosaurus.org/v3/homoit0000902"},{"@id":"https://homosaurus.org/v3/homoit0001133"},{"@id":"https://homosaurus.org/v3/homoit0001482"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQEthnicGroups"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000692","dc:identifier":"homoit0000692","skos:prefLabel":{"@language":"en","@value":"Klinefelter syndrome"},"skos:altLabel":{"@language":"en","@value":"47XXY"},"rdfs:comment":{"@language":"en","@value":"People with Klinefelter syndrome develop with an extra copy of the X chromosome, resulting in a 47XXY pattern (instead of the typical 46XY). These individuals might have smaller-than-typical testes that produce lower amounts of testosterone and/or sperm, and they may start puberty later than typical (or may not go through puberty without hormone therapy). They may grow taller than usual, may develop breast tissue, and often experience infertility. This variation often does not cause obvious physical differences, and many people do not realize they have it."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85072641"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/klinefelterSyndrome"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001014","dc:identifier":"homoit0001014","skos:prefLabel":{"@language":"en","@value":"Micropenis"},"skos:altLabel":{"@language":"en","@value":"Microphallus"},"rdfs:comment":{"@language":"en","@value":"A person born with a micropenis has a penis that is smaller than the typical size range for an infant. People may also develop a micropenis as a result of several different intersex variations. The size of a person’s penis does not generally affect its functionality."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/micropenis"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001020","dc:identifier":"homoit0001020","skos:prefLabel":{"@language":"en","@value":"Mosaicism involving \"sex\" chromosomes"},"rdfs:comment":{"@language":"en","@value":"People with mosaic chromosomes have different chromosome patterns in some cells of their body than in others. Mosaicism results from random differences in how cells divide while an embryo is growing, resulting in different numbers of chromosomes in different cells (such as 45X/46XX or 45X/46XY, which are both variants of Turner syndrome, or 46XY/47XXY or 46XX/47XXY, which are both variants of Klinefelter syndrome). If someone specifically has 46XX chromosomes in some cells and 46XY in others, their variation is probably chimerism instead of mosaicism. Having mosaic chromosomes can cause someone to develop variations in their genitals, gonads, or hormone function. For example, if they have at least one Y chromosome, they may have both ovarian and testicular tissue, or genital differences like hypospadias, or they may develop some secondary sex characteristics at puberty that are not expected for the sex they were assigned. People who have mosaicism without a Y chromosome (e.g., 45X/46XX, or 46XX/47XXX) may have streak gonads or ovaries that stop functioning at an earlier age than typical, which can affect development during puberty and fertility. Other people may not have any noticeable signs of their mosaicism at all."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85087417"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mosaicismInvolvingSexChromosomes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001066","dc:identifier":"homoit0001066","skos:prefLabel":{"@language":"en","@value":"Ovo-testes"},"skos:altLabel":[{"@language":"en","@value":"True hermaphroditism"},{"@language":"en","@value":"\"Ovotesticular DSD \""}],"rdfs:comment":{"@language":"en","@value":"People with this variation are born with both ovarian and testicular tissue. A person can develop one testis and one ovary, or they may develop one or more ovo-testes, which means that a single gonad is made up of both ovarian and testicular cells. The levels of hormones they produce can vary and how their genitals and secondary sex characteristics develop will depend partially on the levels of estrogen and testosterone that their bodies make. In adolescence, people with ovo-testes may develop features associated with either a typical estrogen puberty or a typical testosterone puberty, or they may develop some of each. Sometimes a person with an ovary and a testis or with ovo-testes can produce viable sperm and viable eggs."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ovoTestes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001134","dc:identifier":"homoit0001134","skos:prefLabel":{"@language":"en","@value":"Progestin induced virilization"},"rdfs:comment":{"@language":"en","@value":"People born with progestin-induced virilization have XX chromosomes and may have visible genital variations at birth such as a larger-than-typical clitoris, sometimes also with fused or partially fused labia. They usually have a typical uterus, ovaries, and fallopian tubes, though their vagina may or may not have differences. This variation develops in utero as a result of the individual's parent taking progestin medication while pregnant. Being exposed to these additional hormones before birth can change how someone’s genitals develop, but it generally will not change how their own body will produce or respond to hormones later on. This means that someone born with progestin-induced virilization will usually develop features associated with a typical estrogen puberty."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/progestinInducedVirilization"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001354","dc:identifier":"homoit0001354","skos:prefLabel":{"@language":"en","@value":"Swyer syndrome"},"skos:altLabel":{"@language":"en","@value":"XY Gonadal dysgenesis"},"rdfs:comment":{"@language":"en","@value":"Swyer syndrome occurs when a person is born with XY chromosomes, but their gonads have not developed into testes. It is a form of gonadal dysgenesis, meaning that a person with this variation will have streak gonads that do not produce hormones. Since they do not produce testosterone, their body does not develop a penis and usually develops a vulva and vagina instead. Since they do not produce another hormone known as anti-Müllerian hormone (AMH), people with Swyer syndrome often develop a uterus and fallopian tubes as well. They will not usually start puberty or begin menstruating, but some people with Swyer syndrome do menstruate (without ovulating) if they receive estrogen therapy."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/swyerSyndrome"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001478","dc:identifier":"homoit0001478","skos:prefLabel":{"@language":"en","@value":"Turner syndrome"},"rdfs:comment":{"@language":"en","@value":"Turner syndrome is a variation in which a person is born with a 45X chromosome pattern (sometimes called 45XO) rather than the typical 46XX. People with Turner syndrome often share specific physical features such as short stature, a webbed neck and broad chest, and heart issues. They can also develop variations in their other sex characteristics, such as smaller-than-typical ovaries that may stop producing hormones at a younger age than typical, and they might not menstruate or experience pubertal changes."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85138930"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/turnerSyndrome"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001646","dc:identifier":"homoit0001646","skos:prefLabel":{"@language":"en","@value":"Assigned X at birth"},"skos:altLabel":[{"@language":"en","@value":"AXAB"},{"@language":"en","@value":"Designated X at birth"},{"@language":"en","@value":"DXAB"},{"@language":"en","@value":"X assigned at birth"},{"@language":"en","@value":"XAAB"}],"rdfs:comment":{"@language":"en","@value":"The assignment of an \"X\" gender marker or \"X\" sex designation shortly after birth. It is uncommon for intersex people to be assigned intersex or X at birth.\r\n"},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001268"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000669"},{"@id":"https://homosaurus.org/v3/homoit0001646"},{"@id":"https://homosaurus.org/v3/homoit0002884"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/assignedXAtBirth"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000675","dc:identifier":"homoit0000675","skos:prefLabel":{"@language":"en","@value":"Intimate partner violence"},"skos:altLabel":{"@language":"en","@value":"Intimate partner abuse"},"rdfs:comment":{"@language":"en","@value":"Acts of violence or abuse directed against an individual by their current or former partner in a romantic, sexual, or play relationship."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000855"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000918"},{"@id":"https://homosaurus.org/v3/homoit0001133"},{"@id":"https://homosaurus.org/v3/homoit0001293"},{"@id":"https://homosaurus.org/v3/homoit0001311"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2009000032"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intimatePartnerViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000676","dc:identifier":"homoit0000676","skos:prefLabel":{"@language":"en","@value":"LGBTQ Inuit"},"skos:altLabel":[{"@language":"en","@value":"Inuit (LGBTQ)"},{"@language":"en","@value":"Inuit people (LGBTQ)"},{"@language":"en","@value":"LGBTQ Inuit"},{"@language":"en","@value":"LGBTQ Inuit people"}],"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who are Inuit, or part of several Indigenous peoples inhabiting the Inuit homeland in the Arctic and subarctic regions of Greenland, Canada, and Alaska. Only use for people who identify as Inuit."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000886"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001809"},{"@id":"https://homosaurus.org/v3/homoit0001810"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQInuit"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000677","dc:identifier":"homoit0000677","skos:prefLabel":{"@language":"en","@value":"Inverts"},"skos:altLabel":{"@language":"en","@value":"Sexual inverts"},"rdfs:comment":{"@language":"en","@value":"Outdated, historical term used for LGBTQ+ people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000878"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001296"},{"@id":"https://homosaurus.org/v3/homoit0001297"},{"@id":"https://homosaurus.org/v3/homoit0001564"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/inverts"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001564","dc:identifier":"homoit0001564","skos:prefLabel":{"@language":"en","@value":"Uranism"},"skos:altLabel":[{"@language":"en","@value":"Uranismus"},{"@language":"en","@value":"Congenital sexual inversion"},{"@language":"en","@value":"Urningism"},{"@language":"en","@value":"Uraniadism"},{"@language":"en","@value":"Uranianism"}],"rdfs:comment":{"@language":"en","@value":"Historical term originating from the German \"Uranismus\" coined by Karl Heinrich Ulrichs as an umbrella term for what are now referred to as gender and sexual minorities; use only in historical contexts."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000878"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000677"},{"@id":"https://homosaurus.org/v3/homoit0001296"},{"@id":"https://homosaurus.org/v3/homoit0001484"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/uranism"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000679","dc:identifier":"homoit0000679","skos:prefLabel":{"@language":"en","@value":"Jealousy"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000858"},{"@id":"https://homosaurus.org/v3/homoit0001237"},{"@id":"https://homosaurus.org/v3/homoit0001649"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85069852"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000679"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001658"},"dc:replaces":{"@id":"http://homosaurus.org/v2/jealousy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-10-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000858","dc:identifier":"homoit0000858","skos:prefLabel":{"@language":"en","@value":"LGBTQ emotions"},"skos:altLabel":{"@language":"en","@value":"LGBTQ emotions"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000858"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000889"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQEmotions"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-10-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001649","dc:identifier":"homoit0001649","skos:prefLabel":{"@language":"en","@value":"Compersion"},"rdfs:comment":{"@language":"en","@value":"The positive emotion an individual may experience in regards to their partner's relationship with another partner. Often defined as the opposite of jealousy."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001651"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001649"},"dc:replaces":{"@id":"http://homosaurus.org/v2/compersion"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001658","dc:identifier":"homoit0001658","skos:prefLabel":{"@language":"en","@value":"Non-consensual non-monogamy"},"rdfs:comment":{"@language":"en","@value":"Practice of engaging in romantic or sexual relationships with more than one person simultaneously without each partner's consent."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001659"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nonConsensualNonMonogamy"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000681","dc:identifier":"homoit0000681","skos:prefLabel":{"@language":"en","@value":"Jerking off"},"skos:altLabel":[{"@language":"en","@value":"Jacking off"},{"@language":"en","@value":"Jerking it"}],"rdfs:comment":{"@language":"en","@value":"Slang term for masturbation; typically refers to manual stimulation of the penis."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001000"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/jerkingOff"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000745","dc:identifier":"homoit0000745","skos:prefLabel":{"@language":"en","@value":"Jewish lesbians"},"skos:altLabel":{"@language":"en","@value":"Lesbian Jews"},"rdfs:comment":{"@language":"en","@value":"Lesbians who are Jewish."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000682"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh96007024"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianJews"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001180","dc:identifier":"homoit0001180","skos:prefLabel":{"@language":"en","@value":"Jewish queer people"},"skos:altLabel":[{"@language":"en","@value":"Jewish queers"},{"@language":"en","@value":"Queer Jews"}],"rdfs:comment":{"@language":"en","@value":"Queer people who are Jewish."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000682"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerJews"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001416","dc:identifier":"homoit0001416","skos:prefLabel":{"@language":"en","@value":"Jewish transgender people"},"skos:altLabel":{"@language":"en","@value":"Transgender Jews"},"rdfs:comment":{"@language":"en","@value":"Transgender people who are Jewish."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000682"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2009010821"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderJews"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000696","dc:identifier":"homoit0000696","skos:prefLabel":{"@language":"en","@value":"Labrys"},"rdfs:comment":{"@language":"en","@value":"Symbol used to represent lesbianism and feminism."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000954"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000954"},"dc:replaces":{"@id":"http://homosaurus.org/v2/labrys"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000698","dc:identifier":"homoit0000698","skos:prefLabel":{"@language":"en","@value":"Lambda"},"rdfs:comment":{"@language":"en","@value":"Symbol for lesbian and gay rights."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000954"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000954"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lambda"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000700","dc:identifier":"homoit0000700","skos:prefLabel":{"@language":"en","@value":"Latex gloves"},"rdfs:comment":{"@language":"en","@value":"Protective coverings for the hands made from latex, a thin-plastic like material; often used as a barrier to protect against STIs while engaging in safer sex practices."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001266"},{"@id":"https://homosaurus.org/v3/homoit0003111"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001251"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/latexGloves"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000893","dc:identifier":"homoit0000893","skos:prefLabel":{"@language":"en","@value":"LGBTQ lobbying"},"skos:altLabel":{"@language":"en","@value":"LGBTQ lobbying"},"rdfs:comment":{"@language":"en","@value":"Actions taken by individuals or groups to influence legislative action (or non-action), policies, or decisions of government officials in favor of LGBTQ+ people, communities, or issues."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000853"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000702"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQLobbying"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001482","dc:identifier":"homoit0001482","skos:prefLabel":{"@language":"en","@value":"Undocumented LGBTQ residents"},"skos:altLabel":{"@language":"en","@value":"Undocumented LGBTQ residents"},"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who do not have official documentation to remain legal residents of the countries in which they live."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000915"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000702"},{"@id":"https://homosaurus.org/v3/homoit0000712"},{"@id":"https://homosaurus.org/v3/homoit0000860"},{"@id":"https://homosaurus.org/v3/homoit0000883"},{"@id":"https://homosaurus.org/v3/homoit0000902"},{"@id":"https://homosaurus.org/v3/homoit0000927"},{"@id":"https://homosaurus.org/v3/homoit0001108"},{"@id":"https://homosaurus.org/v3/homoit0001815"},{"@id":"https://homosaurus.org/v3/homoit0001853"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/undocumentedLGBTQResidents"},"dc:issued":{"