homoit0000070"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerArtists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001390","dc:identifier":"homoit0001390","skos:prefLabel":{"@language":"en","@value":"Transgender artists"},"rdfs:comment":{"@language":"en","@value":"Artists who are known to be transgender."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000070"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2012003841"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderArtists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001051","dc:identifier":"homoit0001051","skos:prefLabel":{"@language":"en","@value":"Nude photographs"},"skos:altLabel":{"@language":"en","@value":"Nudes"},"rdfs:comment":{"@language":"en","@value":"Images of naked individuals, including those taken by amateurs or professionals; may be produced for aesthetic or erotic purposes."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001052"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000070"},{"@id":"https://homosaurus.org/v3/homoit0000816"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001052"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nudePhotographs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-09-28"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001052","dc:identifier":"homoit000105