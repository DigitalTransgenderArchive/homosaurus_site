aurus.org/v3/homoit0000298"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womensCommunityCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000299","dc:identifier":"homoit0000299","skos:prefLabel":{"@language":"en","@value":"Condoms"},"skos:altLabel":[{"@language":"en","@value":"Prophylactics"},{"@language":"en","@value":"Rubbers"}],"rdfs:comment":{"@language":"en","@value":"Latex contraceptives used to cover penises during sexual activity for the purposes of preventing STIs and/or pregnancy."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001266"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001251"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85030795"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/condoms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000300","dc:identifier":"homoit0000300","skos:prefLabel":{"@language":"en","@value":"LGBTQ Confucianists"},"skos:altLabel":[{"@language":"en","@value":"Confucianists (LGBTQ)"},{"@language":"en","@value":"LGBTQ Confucianists"}],"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who are Confucianists."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000928"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQConfucianists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000301","dc:identifier":"homoit0000301","skos:prefLabel":{"@language":"en","@value":"Congenital adrenal hyperplasia"},"skos:altLabel":{"@language":"en","@value":"CAH"},"rdfs:comment":{"@language":"en","@value":"Congenital adrenal hyperplasia (CAH) is a group of different but related genetic variations that affect the enzymes that allow the adrenal glands to make hormones that regulate the body’s functions. People with CAH do not consistently produce the amount of cortisol or aldosterone they need, but they may naturally produce higher-than-typical levels of androgens such as testosterone to help the body compensate. Someone with CAH can be born with XX or XY chromosomes. People with CAH and XY chromosomes are usually not considered to have a variation in sex characteristics since an increased amount of androgens will not cause the development of any characteristics that are not considered typical for people assigned male at birth. In people with XX chromosomes and CAH, the increase in androgen production can result in genital differences such as a larger-than-typical clitoris, fused labia, and the fusion of the urethra and vaginal canal to form a single opening. They may also develop some characteristics like body and facial hair or increased muscle mass during childhood or puberty."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85001014"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/congenitalAdrenalHyperplasia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000938","dc:identifier":"homoit0000938","skos:prefLabel":{"@language":"en","@value":"LGBTQ sexual abuse"},"skos:altLabel":{"@language":"en","@value":"LGBTQ sexual abuse"},"rdfs:comment":{"@language":"en","@value":"Acts of sexual abuse and violence directed towards LGBTQ+ people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001305"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000302"},{"@id":"https://homosaurus.org/v3/homoit0000855"},{"@id":"https://homosaurus.org/v3/homoit0000959"},{"@id":"https://homosaurus.org/v3/homoit0001351"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001305"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSexualAbuse"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001123","dc:identifier":"homoit0001123","skos:prefLabel":{"@language":"en","@value":"Polyamory"},"rdfs:comment":{"@language":"en","@value":"Practice of engaging in romantic, sexual, or play relationships with more than one person simultaneously, with the knowledge and consent of all parties involved."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001651"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001554"},{"@id":"https://homosaurus.org/v3/homoit0001629"},{"@id":"https://homosaurus.org/v3/homoit0001662"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000302"},{"@id":"https://homosaurus.org/v3/homoit0000603"},{"@id":"https://homosaurus.org/v3/homoit0001124"},{"@id":"https://homosaurus.org/v3/homoit0001295"},{"@id":"https://homosaurus.org/v3/homoit0001558"},{"@id":"https://homosaurus.org/v3/homoit0001645"},{"@id":"https://homosaurus.org/v3/homoit0001649"},{"@id":"https://homosaurus.org/v3/homoit0001657"},{"@id":"https://homosaurus.org/v3/homoit0001661"},{"@id":"https://homosaurus.org/v3/homoit0001663"},{"@id":"https://homosaurus.org/v3/homoit0001664"},{"@id":"https://homosaurus.org/v3/homoit0002255"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/polyamory"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001124","dc:identifier":"homoit0001124","skos:prefLabel":{"@language":"en","@value":"Polygamy"},"rdfs:comment":{"@language":"en","@value":"The practice of engaging in romantic, sexual, or play relationships where the dominant partner has multiple spouses, though these marriages are not always recognized by law or within society."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001081"},{"@id":"https://homosaurus.org/v3/homoit0001302"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000302"},{"@id":"https://homosaurus.org/v3/homoit0000603"},{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001295"},{"@id":"https://homosaurus.org/v3/homoit0002255"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85104627"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001300"},"dc:replaces":{"@id":"http://homosaurus.org/v2/polygamy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-02-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000304","dc:identifier":"homoit0000304","skos:prefLabel":{"@language":"en","@value":"Second parent adoption"},"skos:altLabel":{"@language":"en","@value":"Co-parent adoption"},"rdfs:comment":{"@language":"en","@value":"An adoption process by which a legal child-parent relationship is established by granting the “second” parent the same rights as the “first” parent without the “first” or legal parent relinquishing any parental rights. A second or co-parent adoption can be important for LGBTQ+ parents to protect their parental rights as the relationship of the non-biological parent may not be recognized in some jurisdictions without such an adoption."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000809"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000918"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000864"},"dc:replaces":{"@id":"http://homosaurus.org/v2/secondParentAdoption"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-02-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000597","dc:identifier":"homoit0000597","skos:prefLabel":{"@language":"en","@value":"Urine play"},"skos:altLabel":[{"@language":"en","@value":"Golden showers"},{"@language":"en","@value":"Pissing sex"},{"@language":"en","@value":"Undinism"},{"@language":"en","@value":"Urolagnia"},{"@language":"en","@value":"Clothes wetting"},{"@language":"en","@value":"Omorashi"},{"@language":"en","@value":"Piss play"},{"@language":"en","@value":"Urophilia"},{"@language":"en","@value":"Water sports"},{"@language":"en","@value":"Watersports"}],"rdfs:comment":{"@language":"en","@value":"Use of urine and urination for sexual or erotic pleasure."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000442"},{"@id":"https://homosaurus.org/v3/homoit0001267"},{"@id":"https://homosaurus.org/v3/homoit0001299"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000305"},{"@id":"https://homosaurus.org/v3/homoit0003061"},{"@id":"https://homosaurus.org/v3/homoit0003062"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/waterSports"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000306","dc:identifier":"homoit0000306","skos:prefLabel":{"@language":"en","@value":"Corrective rape"},"rdfs:comment":{"@language":"en","@value":"Criminal practice in which men rape lesbians, sometimes under the supervision of members of the women's families or local communities, with the purported purpose of \"curing\" them of homosexuality."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001305"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000783"},{"@id":"https://homosaurus.org/v3/homoit0000793"},{"@id":"https://homosaurus.org/v3/homoit0003444"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001305"},"dc:replaces":{"@id":"http://homosaurus.org/v2/correctiveRape"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000783","dc:identifier":"homoit0000783","skos:prefLabel":{"@language":"en","@value":"Lesbian survivors of rape"},"rdfs:comment":{"@language":"en","@value":"Lesbians who have experienced and survived rape; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000793"},{"@id":"https://homosaurus.org/v3/homoit0001350"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000306"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianSurvivorsOfRape"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000793","dc:identifier":"homoit0000793","skos:prefLabel":{"@language":"en","@value":"Lesbian victims of rape"},"rdfs:comment":{"@language":"en","@value":"Lesbians who have experienced rape and may or may not have survived; follow 