org/v3/homoit0001626","dc:identifier":"homoit0001626","skos:prefLabel":{"@language":"en","@value":"Greysexuality"},"skos:altLabel":[{"@language":"en","@value":"Graysexuality"},{"@language":"en","@value":"Grey-sexuality"},{"@language":"en","@value":"Gray-sexuality"}],"rdfs:comment":{"@language":"en","@value":"A sexual orientation generally characterized by infrequent, rare, or low-intensity sexual attraction."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001298"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001627"},{"@id":"https://homosaurus.org/v3/homoit0001988"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/greysexuality"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001344","dc:identifier":"homoit0001344","skos:prefLabel":{"@language":"en","@value":"Striptease"},"rdfs:comment":{"@language":"en","@value":"A form of erotic dance during which the performer gradually undresses in a seductive and sexually suggestive manner."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001299"},{"@id":"https://homosaurus.org/v3/homoit0001363"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001343"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85129138"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001299"},"dc:replaces":{"@id":"http://homosaurus.org/v2/striptease"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001628","dc:identifier":"homoit0001628","skos:prefLabel":{"@language":"en","@value":"Hard swap"},"rdfs:comment":{"@language":"en","@value":"A term used in the swinging community to describe a type of partner swapping in which sexual activities happen in different spaces or rooms where partners may not necessarily be in sight of each other."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001299"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001640"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001299"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hardSwap"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001640","dc:identifier":"homoit0001640","skos:prefLabel":{"@language":"en","@value":"Soft swap"},"rdfs:comment":{"@language":"en","@value":"A term used in the swinging community to describe a type of partner swap in which sexual activities happen in the same shared space so that all partners are within sight of one another."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001299"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001628"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001299"},"dc:replaces":{"@id":"http://homosaurus.org/v2/softSwap"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001641","dc:identifier":"homoit0001641","skos:prefLabel":{"@language":"en","@value":"Swinging"},"skos:altLabel":[{"@language":"en","@value":"Wife swapping"},{"@language":"en","@value":"Husband swapping"},{"@language":"en","@value":"Partner swapping"}],"rdfs:comment":{"@language":"en","@value":"An agreement, sexual practice, or relationship in which a couple engages in group sex or the swapping of sexual partners within a group, often on a habitual basis."},"skos:broader":[{"@id":"https://homosaurus.org/v3/ho