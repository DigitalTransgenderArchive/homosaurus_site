0341"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001108"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQDefamationCampaigns"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000342","dc:identifier":"homoit0000342","skos:prefLabel":{"@language":"en","@value":"Demigender people"},"rdfs:comment":{"@language":"en","@value":"People who have a partial connection to a certain gender or concept of gender."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001817"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001652"},{"@id":"https://homosaurus.org/v3/homoit0001653"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000571"},{"@id":"https://homosaurus.org/v3/homoit0001923"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/demigenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000343","dc:identifier":"homoit0000343","skos:prefLabel":{"@language":"en","@value":"Demisexuality"},"rdfs:comment":{"@language":"en","@value":"A sexual orientation generally characterized by the lack of sexual attraction to other people unless or until emotional connections have been formed."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001298"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000344"},{"@id":"https://homosaurus.org/v3/homoit0001535"},{"@id":"https://homosaurus.org/v3/homoit0001923"},{"@id":"https://homosaurus.org/v3/homoit0001986"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/demisexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-18"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000344","dc:identifier":"homoit0000344","skos:prefLabel":{"@language":"en","@value":"Demisexual people"},"rdfs:comment":{"@language":"en","@value":"Individuals who do not experience sexual attraction unless they have first formed a strong emotional connection with a person."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001295"},{"@id":"https://homosaurus.org/v3/homoit0001297"},{"@id":"https://homosaurus.org/v3/homoit0001300"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000343"},{"@id":"https://homosaurus.org/v3/homoit0001302"},{"@id":"https://homosaurus.org/v3/homoit0001535"},{"@id":"https://homosaurus.org/v3/homoit0001985"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/demisexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-29"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000345","dc:identifier":"homoit0000345","skos:prefLabel":{"@language":"en","@value":"Denial of sexual orientation"},"rdfs:comment":{"@language":"en","@value":"Refusal to acknowledge or affirm one's own sexual identity, or the sexual identity of another individual."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000391"},{"@id":"https://homosaurus.org/v3/homoit0000699"},{"@id":"https://homosaurus.org/v3/homoit0000936"},{"@id":"https://homosaurus.org/v3/homoit0001298"},{"@id":"https://homosaurus.org/v3/homoit0002590"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/denialOfSexualOrientation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000391","dc:identifier":"homoit0000391","skos:prefLabel":[{"@language":"en-us","@value":"Internalized homophobia"},{"@language":"en-gb","@value":"Internalised homophobia"}],"skos:altLabel":{"@language":"en","@value":"Ego-dystonic homophobia"},"rdfs:comment":{"@language":"en","@value":"This term is often used to describe internalized oppression held by and about LGBTQ+ people in general. It can also describe the more specific phenomenon in which gay men internalize or adopt homophobic beliefs (i.e., negative perceptions of and intolerance toward gay men and homosexuality) as a result of being raised or socialized within a homophobic environment or culture. "},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000646"},{"@id":"https://homosaurus.org/v3/homoit0002590"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000345"},{"@id":"https://homosaurus.org/v3/homoit0000392"},{"@id":"https://homosaurus.org/v3/homoit0000699"},{"@id":"https://homosaurus.org/v3/homoit0000936"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005020575"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/internalisedHomophobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000699","dc:identifier":"homoit0000699","skos:prefLabel":{"@language":"en","@value":"Latent homosexuality"},"rdfs:comment":{"@language":"en","@value":"Term coined by Sigmund Freud to describe erotic attraction towards members of the same sex or gender that is not (and may never be) consciously experienced or expressed openly."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000345"},{"@id":"https://homosaurus.org/v3/homoit0000391"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000699"},"dc:replaces":{"@id":"http://homosaurus.org/v2/latentHomosexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000936","dc:identifier":"homoit0000936","skos:prefLabel":{"@language":"en","@value":"LGBTQ self-repression"},"skos:altLabel":{"@language":"en","@value":"LGBTQ self-repression"},"rdfs:comment":{"@language":"en","@value":"Restraint or denial of one’s own thoughts, wishes, feelings or identity, as experienced by LGBTQ+ people."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000345"},{"@id":"https://homosaurus.org/v3/homoit0000391"},{"@id":"https://homosaurus.org/v3/homoit0002590"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000936"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSelfRepression"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000346","dc:identifier":"homoit0000346","skos:prefLabel":{"@language":"en","@value":"Dental dams"},"skos:altLabel":{"@language":"en","@value":"Latex barriers"},"rdfs:comment":{"@language":"en","@value":"A square sheet of latex or polyurethane used to create a barrier between the mouth and the vagina or anus during oral sex."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001266"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001251"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85035617"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dentalDams"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000349","dc:identifier":"homoit0000349","skos:prefLabel":{"@language":"en","@value":"Detention of LGBTQ people under a hospital order"},"skos:altLabel":{"@language":"en","@value":"Detention of LGBTQ people under a hospital order"},"rdfs:comment":{"@language":"en","@value":"Physical and legal confinement of LGBTQ+ people in hospitals or medical institutions, typically to receive evaluation and treatment ordered by a court or other such authority. Can be used to describe both short-term or long-term institutionalization."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000348"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000394"},{"@id":"https://homosaurus.org/v3/homoit0001012"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000348"},"dc:replaces":{"@id":"http://homosaurus.org/v2/detentionOfLGBTQPeopleUnderAHospital"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000884","dc:identifier":"homoit0000884","skos:prefLabel":{"@language":"en","@value":"LGBTQ imprisonment"},"skos:altLabel":{"@language":"en","@value":"LGBTQ imprisonment"},"rdfs:comment":{"@language":"en","@value":"Confinement, including physical and/or legal restraint, of LGBTQ+ people by an institution or authority. Typically used to describe confinement to a public or private prison that is sentenced by a court within a penal system."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000348"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000887"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000348"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQImprisonment"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000883","dc:identifier":"homoit0000883","skos:prefLabel":{"@language":"en","@value":"LGBTQ immigration rights"},"skos:altLabel":{"@language":"en","@value":"LGBTQ immigration rights"},"rdfs:comment":{"@language":"en","@value":"Legal and social entitlement to freedom, equality, and protection held by LGBTQ+ immigrants."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000712"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000348"},{"@id":"https://homosaurus.org/v3/homoit0000927"},{"@id":"https://homosaurus.org/v3/homoit0001053"},{"@id":"https://homosaurus.org/v3/homoit0001092"},{"@id":"https://homosaurus.org/v3/homoit0001482"},{"@id":"https://homosaurus.org/v3/homoit0001815"},{"@id":"https://homosaurus.org/v3/homoit0001853"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQImmigrationRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000887","dc:identifier":"homoit0000887","skos:prefLabel":{"@language":"en","@value":"LGBTQ prisoners"},"skos:altLabel":[{"@language":"en","@value":"LGBTQ inmates"},{"@language":"en","@value":"Prisoners (LGBTQ)"},{"@language":"en","@value":"LGBTQ prisoners"}],"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who are deprived of their liberty against their will by an institution or authority. Typically used to describe individuals sentenced to confinement in a public or private prison by a court within a penal system, but may also include people forcibly confined to hospitals and other institutions."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000915"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000924"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000348"},{"@id":"https://homosaurus.org/v3/homoit0000884"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPrisoners"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000394","dc:identifier":"homoit0000394","skos:prefLabel":{"@language":"en","@value":"Electroshock therapy"},"skos:altLabel":[{"@language":"en","@value":"Electric shock therapy"},{"@language":"en","@value":"Electroconvulsive therapy"}],"rdfs:comment":{"@language":"en","@value":"A form of psychiatric treatment for major depression, bipolar depression, and other mental health conditions that usually consists of brief electrical pulses to the brain through electrodes on the head that induce controlled seizures. Electroshock therapy has historically been used as an attempt to \"cure\" homosexuality and other non-normative sexualities and sexual practices."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001366"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000349"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85041999"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/electroshockTherapy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001012","dc:identifier":"homoit0001012","skos:prefLabel":{"@language":"en","@value":"Mental health care for LGBTQ people"},"skos:altLabel":{"@language":"en","@value":"Mental health care for LGBTQ people"},"rdfs:comment":{"@language":"en","@value":"Organized measures taken for the diagnosis, maintenance, treatment, or improvement of mental health or psychological well being; use in reference to mental health care addressing the particular needs of LGBTQ+ individuals or communities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000614"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000953"},{"@id":"https://homosaurus.org/v3/homoit0001551"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000349"},{"@id":"https://homosaurus.org/v3/homoit0000351"},{"@id":"https://homosaurus.org/v3/homoit0000952"},{"@id":"https://homosaurus.org/v3/homoit0001366"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000614"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mentalHealthCareForLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000351","dc:identifier":"homoit0000351","skos:prefLabel":{"@language":"en","@value":"DSM (Diagnostic and Statistical Manual of Mental Disorders)"},"skos:altLabel":[{"@language":"en","@value":"DSM"},{"@language":"en","@value":"Diagnostic and Statistical Manual of Mental Disorders"}],"rdfs:comment":{"@language":"en","@value":"The Diagnostic and Statistical Manual of Mental Disorders, produced by the American Psychiatric Association; can be used in reference to the DSM's historical or present day descriptions of LGBTQ+ identities and practices."},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001012"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000351"},"dc:replaces":{"@id":"http://homosaurus.org/v2/DSM"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000352","dc:identifier":"homoit0000352","skos:prefLabel":{"@language":"en","@value":"Intersex"},"skos:altLabel":[{"@language":"en","@value":"Differences in sex development"},{"@language":"en","@value":"Divergences in sex development"},{"@language":"en","@value":"DSDs"},{"@language":"en","@value":"Hermaphroditism"},{"@language":"en","@value":"Intersexuality"},{"@language":"en","@value":"Variations in sex development"},{"@language":"en","@value":"VSDs"},{"@language":"es","@value":"Intersexual"}],"rdfs:comment":{"@language":"en","@value":"An umbrella term used to refer to people born with variations in their physical sex characteristics--including genitals, gonads, chromosomes, and hormonal factors--that do not fit typical definitions of male or female bodies."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001269"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000357"},{"@id":"https://homosaurus.org/v3/homoit0000669"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000618"},{"@id":"https://homosaurus.org/v3/homoit0000666"},{"@id":"https://homosaurus.org/v3/homoit0000670"},{"@id":"https://homosaurus.org/v3/homoit0000671"},{"@id":"https://homosaurus.org/v3/homoit0000672"},{"@id":"https://homosaurus.org/v3/homoit0001822"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000357","dc:identifier":"homoit0000357","skos:prefLabel":{"@language":"en","@value":"Disorders of sexual development"},"skos:altLabel":{"@language":"en","@value":" Disorders of sex development"},"rdfs:comment":{"@language":"en","@value":"Term used within medical contexts to refer to a wide range of variations in sex characteristics. Many people with intersex variations consider these terms to be stigmatizing and pathologizing, though they often still encounter them in their medical records."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000352"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001006"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120728"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/disordersOfSexualDevelopment"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000666","dc:identifier":"homoit0000666","skos:prefLabel":{"@language":"en","@value":"Intersexphobia"},"skos:altLabel":{"@language":"en","@value":"Interphobia"},"rdfs:comment":{"@language":"en","@value":"Antagonism or disgust directed toward intersex people or intersex variations. Intersexphobia can include the denial of the existence of intersex people, insistence that intersex variations should be forcibly \"corrected,\" stereotypes, verbal harassment, and physical violence."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000920"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000352"},{"@id":"https://homosaurus.org/v3/homoit0000619"},{"@id":"https://homosaurus.org/v3/homoit0000670"},{"@id":"https://homosaurus.org/v3/homoit0001770"},{"@id":"https://homosaurus.org/v3/homoit0001893"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexphobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000671","dc:identifier":"homoit0000671","skos:prefLabel":{"@language":"en","@value":"Intersex identity"},"rdfs:comment":{"@language":"en","@value":"Used to describe the experience of selfhood of intersex people. Intersex identity is not gender identity, sexual identity, nor sexual orientation. For the subject of intersex variations, use \"intersex variations\" or \"intersex\". For the subject of intersex people, use \"intersex people\". Do not use in place of gender-identity-related terms such as non-binary identity or genderfluid identity."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000352"},{"@id":"https://homosaurus.org/v3/homoit0000618"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007005480"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000671"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000672","dc:identifier":"homoit0000672","skos:prefLabel":{"@language":"en","@value":"Intersex movement"},"rdfs:comment":{"@language":"en","@value":"Umbrella term for activism focused on the rights of intersex people and issues faced by intersex communities."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001026"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000352"},{"@id":"https://homosaurus.org/v3/homoit0000618"},{"@id":"https://homosaurus.org/v3/homoit0000805"},{"@id":"https://homosaurus.org/v3/homoit0000807"},{"@id":"https://homosaurus.org/v3/homoit0000882"},{"@id":"https://homosaurus.org/v3/homoit0001322"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexMovement"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000355","dc:identifier":"homoit0000355","skos:prefLabel":{"@language":"en","@value":"Dildos"},"rdfs:comment":{"@language":"en","@value":"A sex toy, often explicitly (although not necessarily) phallic in appearance, intended for sexual penetration or other sexual activity during masturbation or with sex partners."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001266"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000354"},{"@id":"https://homosaurus.org/v3/homoit0001099"},{"@id":"https://homosaurus.org/v3/homoit0001342"},{"@id":"https://homosaurus.org/v3/homoit0001491"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007007162"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dildos"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-09"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001067","dc:identifier":"homoit0001067","skos:prefLabel":{"@language":"en","@value":"Packing (Phallus)"},"rdfs:comment":{"@language":"en","@value":"The act of wearing padding or a phallic object in the front of the pants or underwear to give the appearance of having a bulge."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000568"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000354"},{"@id":"https://homosaurus.org/v3/homoit0001099"},{"@id":"https://homosaurus.org/v3/homoit0001790"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/packingPhallus"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-09"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001342","dc:identifier":"homoit0001342","skos:prefLabel":{"@language":"en","@value":"Strap-on sex"},"rdfs:comment":{"@language":"en","@value":"Sexual intercourse in which a dildo attached to a harness is used for either vaginal or anal penetration."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001267"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000354"},{"@id":"https://homosaurus.org/v3/homoit0000355"},{"@id":"https://homosaurus.org/v3/homoit0000662"},{"@id":"https://homosaurus.org/v3/homoit0001099"},{"@id":"https://homosaurus.org/v3/homoit0001510"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007007163"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/strapOnSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001491","dc:identifier":"homoit0001491","skos:prefLabel":{"@language":"en","@value":"Vibrators"},"rdfs:comment":{"@language":"en","@value":"Electric-powered sex toys that produce different levels of vibrations or pulses to aid in sexual stimulation and pleasure."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001266"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000355"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2002004287"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/vibrators"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-09"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000701","dc:identifier":"homoit0000701","skos:prefLabel":{"@language":"en","@value":"Lavender Scare"},"rdfs:comment":{"@language":"en","@value":"Term used to describe the mid-20th century purge of lesbians and gay men in the U.S. government as a result of moral panic incited by Joseph McCarthy and others."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000356"},{"@id":"https://homosaurus.org/v3/homoit0001108"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000701"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lavenderScare"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001555","dc:identifier":"homoit0001555","skos:prefLabel":{"@language":"en","@value":"Mononormativity"},"rdfs:comment":{"@language":"en","@value":"The belief that all people share a desire for monogamous relationships and that this is a preferential life goal."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001323"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000356"},{"@id":"https://homosaurus.org/v3/homoit0001019"},{"@id":"https://homosaurus.org/v3/homoit0001556"},{"@id":"https://homosaurus.org/v3/homoit0001915"},{"@id":"https://homosaurus.org/v3/homoit0001916"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001323"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mononormativity"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000358","dc:identifier":"homoit0000358","skos:prefLabel":{"@language":"en","@value":"Diversity"},"rdfs:comment":{"@language":"en","@value":"Diversity in characteristics of people in age, gender, religion, ethnicity, sexual orientation, lifestyle, etc."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000566"},{"@id":"https://homosaurus.org/v3/homoit0001290"}],"skos:relat