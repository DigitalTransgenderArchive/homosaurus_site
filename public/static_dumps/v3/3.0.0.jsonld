:"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000076","dc:identifier":"homoit0000076","skos:prefLabel":{"@language":"en","@value":"Ass fucking"},"skos:altLabel":{"@language":"en","@value":"Butt fucking"},"rdfs:comment":{"@language":"en","@value":"The sexual act of penetrating an individual's anus with a penis or dildo."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000043"},{"@id":"https://homosaurus.org/v3/homoit0000459"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000099"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000293"},{"@id":"https://homosaurus.org/v3/homoit0003107"},{"@id":"https://homosaurus.org/v3/homoit0003124"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/assFucking"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000233","dc:identifier":"homoit0000233","skos:prefLabel":{"@language":"en","@value":"Buttplugs"},"skos:altLabel":[{"@language":"en","@value":"Anal dilators"},{"@language":"en","@value":"Anal inserts"},{"@language":"en","@value":"Anal plugs"},{"@language":"en","@value":"Buttplugs"}],"rdfs:comment":{"@language":"en","@value":"A sex toy designed to be inserted into the anus for sexual stimulation or pleasure. Butt plugs tend to be shorter than dildos and have a flared base that prevents them from being lost in the rectum."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001266"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000043"},{"@id":"https://homosaurus.org/v3/homoit0000081"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/buttplugs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000044","dc:identifier":"homoit0000044","skos:prefLabel":{"@language":"en","@value":"Androgen insensitivity syndrome"},"skos:altLabel":[{"@language":"en","@value":"AIS"},{"@language":"en","@value":"Goldberg-Maxwell syndrome"},{"@language":"en","@value":"Male androgen insensitivity syndrome"}],"rdfs:comment":{"@language":"en","@value":"People born with AIS have XY chromosomes and testes, and their bodies have varying levels of insensitivity to androgens (including testosterone). This means that their cells do not respond typically to the testosterone that they produce. Like other variations in sex characteristics, AIS is a spectrum, with the subcategories of complete (CAIS), partial (PAIS), and mild androgen insensitivity (MAIS). The term \"male androgen insensitivity syndrome\" should not be used to describe this variation because many people with AIS are women."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001079"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/androgenInsensitivitySyndrome"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001079","dc:identifier":"homoit0001079","skos:prefLabel":{"@language":"en","@value":"Partial androgen insensitivity syndrome"},"skos:altLabel":{"@language":"en","@value":"PAIS"},"rdfs:comment":{"@language":"en","@value":"People with partial androgen insensitivity (PAIS) have some response to testosterone, but not as much as is typical for people with XY chromosomes without androgen insensitivity. People with PAIS may be born with testes that are undescended or partially descended and with genital differences such as a vaginal opening that is shallower than typical, a phallus that may be perceived as a large clitoris or a small penis, and variations affecting their urethra. They might also be born with genitals that look more like a penis or like a vulva and vagina. In adolescence, people with PAIS may develop some features that are associated with a typical testosterone puberty and others that are associated with a typical estrogen puberty since their body responds to some of the testosterone that their gonads produce while the rest is converted into estrogen."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000044"},{"@id":"https://homosaurus.org/v3/homoit0000669"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partialAndrogenInsensitivitySyndrome"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000045","dc:identifier":"homoit0000045","skos:prefLabel":{"@language":"en","@value":"Androgynous people"},"rdfs:comment":{"@language":"en","@value":"People who have a non-binary gender that includes masculine and feminine traits."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001817"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000047"},{"@id":"https://homosaurus.org/v3/homoit0001048"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/androgynousPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000047","dc:identifier":"homoit0000047","skos:prefLabel":{"@language":"en","@value":"Androgyny"},"rdfs:comment":{"@language":"en","@value":"The combination of masculine and feminine characteristics."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000568"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000045"},{"@id":"https://homosaurus.org/v3/homoit0000389"},{"@id":"https://homosaurus.org/v3/homoit0000562"},{"@id":"https://homosaurus.org/v3/homoit0000577"},{"@id":"https://homosaurus.org/v3/homoit0000995"},{"@id":"https://homosaurus.org/v3/homoit0001756"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85004920"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/androgyny"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000046","dc:identifier":"homoit0000046","skos:prefLabel":{"@language":"he","@value":"Androgynos"},"rdfs:comment":{"@language":"en","@value":"Israeli term used in Rabbinical literature to describe both an intersex mythological creature and refer to a legal condition."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000618"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/androgynos"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000618","dc:identifier":"homoit0000618","skos:prefLabel":{"@language":"en","@value":"Intersex people"},"skos:altLabel":[{"@language":"en","@value":"Hermaphrodites"},{"@language":"en","@value":"Intersexuals"},{"@language":"en","@value":"Hermaphroditic people"},{"@language":"en","@value":"Intersex-identified people"},{"@language":"en","@value":"Intersexual people"}],"rdfs:comment":{"@language":"en","@value":"Individuals born with variations in their genitalia, hormones, internal anatomy, and/or chromosomes that do not fully or exclusively conform to medical or social expectations for males or females. Only use to describe people who describe themselves as intersex."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000915"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000668"},{"@id":"https://homosaurus.org/v3/homoit0000674"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000046"},{"@id":"https://homosaurus.org/v3/homoit0000352"},{"@id":"https://homosaurus.org/v3/homoit0000669"},{"@id":"https://homosaurus.org/v3/homoit0000670"},{"@id":"https://homosaurus.org/v3/homoit0000671"},{"@id":"https://homosaurus.org/v3/homoit0000672"},{"@id":"https://homosaurus.org/v3/homoit0000673"},{"@id":"https://homosaurus.org/v3/homoit0001759"},{"@id":"https://homosaurus.org/v3/homoit0001763"},{"@id":"https://homosaurus.org/v3/homoit0001767"},{"@id":"https://homosaurus.org/v3/homoit0001822"},{"@id":"https://homosaurus.org/v3/homoit0002744"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007003860"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000568","dc:identifier":"homoit0000568","skos:prefLabel":{"@language":"en","@value":"Gender expression"},"rdfs:comment":{"@language":"en","@value":"Term used to describe the way individuals express their gender identity through their appearance and behaviors, including gestures, movement, dress, and grooming."},"skos:broader":{"@id":"