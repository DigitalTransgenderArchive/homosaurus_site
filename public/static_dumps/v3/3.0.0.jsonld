":"https://homosaurus.org/v3/homoit0001885"},{"@id":"https://homosaurus.org/v3/homoit0002590"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPhobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000954","dc:identifier":"homoit0000954","skos:prefLabel":{"@language":"en","@value":"LGBTQ symbols"},"skos:altLabel":{"@language":"en","@value":"LGBTQ symbols"},"rdfs:comment":{"@language":"en","@value":"Characters, signs, or objects used to represent LGBTQ+ people, identities, communities, and/or specific historical events."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000034"},{"@id":"https://homosaurus.org/v3/homoit0000453"},{"@id":"https://homosaurus.org/v3/homoit0000609"},{"@id":"https://homosaurus.org/v3/homoit0000696"},{"@id":"https://homosaurus.org/v3/homoit0000698"},{"@id":"https://homosaurus.org/v3/homoit0001116"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000954"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSymbols"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000035","dc:identifier":"homoit0000035","skos:prefLabel":{"@language":"mi","@value":"Akava'ine"},"rdfs:comment":{"@language":"en","@value":"A Cook Islands Māori word referring to transgender people of Māori descent from the Cook Islands."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000322"},{"@id":"https://homosaurus.org/v3/homoit0002653"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/akavaine"},"dc:issued":{"@type":"xsd:date","@value":"2019-0