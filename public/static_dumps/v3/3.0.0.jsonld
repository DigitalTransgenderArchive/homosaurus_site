"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001477","dc:identifier":"homoit0001477","skos:prefLabel":{"@language":"he","@value":"Tumtum"},"rdfs:comment":{"@language":"en","@value":"Term originating in Rabbinic Judaism to refer to someone with an unknown sex; literally translates to \"hidden.\" Used historically to refer to intersex variations where the genitals were covered by skin. Only use for individuals who are Jewish and who self-identify as Tumtum."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tumtum"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001501","dc:identifier":"homoit0001501","skos:prefLabel":{"@language":"id","@value":"Waria"},"rdfs:comment":{"@language":"en","@value":"Third gender people in Indonesia who are assigned male at birth but who express femininity and may identify as women."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/waria"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001502","dc:identifier":"homoit0001502","skos:prefLabel":{"@language":"en","@value":"Whakawahine"},"skos:altLabel":{"@language":"mi","@value":"Whakawahine"},"rdfs:comment":{"@language":"en","@value":"In Māori culture in New Zealand, this term is used to describe people assigned male at birth who pursue traditionally female roles."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000322"},{"@id":"https://homosaurus.org/v3/homoit0002653"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001499"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/whakawahine"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001506","dc:identifier":"homoit0001506","skos:prefLabel":{"@language":"en","@value":"Winkte"},"skos:altLabel":{"@language":"en","@value":"Winkte"},"rdfs:comment":{"@language":"en","@value":"North American Lakota word referring to people assigned male at birth who adopt feminine roles; translates to \"to be like a woman.\""},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001480"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/winkte"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001517","dc:identifier":"homoit0001517","skos:prefLabel":{"@language":"en","@value":"Xanith"},"skos:altLabel":[{"@language":"ar","@value":"Khanith"},{"@language":"ar","@value":"Xanith"},{"@language":"ar","@value":"Xaniths"}],"rdfs:comment":{"@language":"en","@value":"Arabic word used in Oman for people who assigned male at birth who adopt feminine mannerisms and/or roles."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/xanith"},"dc:issued":