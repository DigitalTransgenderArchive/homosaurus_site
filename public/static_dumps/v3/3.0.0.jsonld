omoit0001362"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/FtMs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000115","dc:identifier":"homoit0000115","skos:prefLabel":{"@language":"en","@value":"Essentialism"},"skos:altLabel":{"@language":"en","@value":"Biological essentialism"},"rdfs:comment":{"@language":"en","@value":"The practice of defining certain categories through a set of supposed universal or fixed characteristics or traits (e.g., defining women in terms of \"female\" genitalia)."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001365"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001219"},{"@id":"https://homosaurus.org/v3/homoit0001295"},{"@id":"https://homosaurus.org/v3/homoit0001320"},{"@id":"https://homosaurus.org/v3/homoit0003519"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85044919"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/essentialism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001219","dc:identifier":"homoit0001219","skos:prefLabel":{"@language":"en","@value":"Queer theory"},"rdfs:comment":{"@language":"en","@value":"Field of critical theory that emerged in the 1990s out of queer studies and women's studies. Queer theory involves the study and theorization of gender and sexual practices and identities that exist outside of heterosexuality and which challenge heteronormativity and essentialism."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001365"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000115"},{"@id":"https://homosaurus.org/v3/homoit0000579"},{"@id":"https://homosaurus.org/v3/homoit0001149"},{"@id":"https://homosaurus.org/v3/homoit0001210"},{"@id":"https://homosaurus.org/v3/homoit0001218"},{"@id":"https://homosaurus.org/v3/homoit0001320"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006001835"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerTheory"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001320","dc:identifier":"homoit0001320","skos:prefLabel":{"@language":"en","@value":"Social constructionism"},"rdfs:comment":{"@language":"en","@value":"Belief or theory that categories of gender, sexual orientation, and ethnicity are cultural constructs rather than intrinsic categories of nature."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001365"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000115"},{"@id":"https://homosaurus.org/v3/homoit0001006"},{"@id":"https://homosaurus.org/v3/homoit0001219"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2009007835"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/socialConstructionism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000116","dc:identifier":"homoit0000116","skos:prefLabel":{"@language":"en","@value":"Biological parenthood"},"rdfs:comment":{"@language":"en","@value":"The experience of being a biological parent to a child. This relationship can be genetic, gestational, or both."},"skos:broader":[{"@id