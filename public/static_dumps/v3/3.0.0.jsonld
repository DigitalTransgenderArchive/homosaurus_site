05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001074","dc:identifier":"homoit0001074","skos:prefLabel":{"@language":"en","@value":"Parental rights"},"rdfs:comment":{"@language":"en","@value":"The legal parent-child relationship that may be established by biological relations, at birth, or through adoption. These rights may include child custody and visitation, decision-making authority, and informational access. "},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000712"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000914"},{"@id":"https://homosaurus.org/v3/homoit0000918"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/parentalRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-02-17"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001082","dc:identifier":"homoit0001082","skos:prefLabel":{"@language":"en","@value":"Partner rights"},"rdfs:comment":{"@language":"en","@value":"Legal, economic, social, and cultural rights afforded to individuals who are in long-term partnerships (e.g., marriage, domestic partnership, civil union) that can include shared health insurance, life insurance benefits, adoption rights, and the authority to make medical and financial decisions on behalf of one's partner."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000712"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001311"},{"@id":"https://homosaurus.org/v3/homoit0002365"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnerRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"}