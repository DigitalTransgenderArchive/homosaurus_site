.org/v3/homoit0000967"},{"@id":"https://homosaurus.org/v3/homoit0000974"},{"@id":"https://homosaurus.org/v3/homoit0001062"},{"@id":"https://homosaurus.org/v3/homoit0001266"},{"@id":"https://homosaurus.org/v3/homoit0001284"},{"@id":"https://homosaurus.org/v3/homoit0001292"},{"@id":"https://homosaurus.org/v3/homoit0001306"},{"@id":"https://homosaurus.org/v3/homoit0001315"},{"@id":"https://homosaurus.org/v3/homoit0001325"},{"@id":"https://homosaurus.org/v3/homoit0002219"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120549"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexAct"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000023","dc:identifier":"homoit0000023","skos:prefLabel":{"@language":"en","@value":"Agi"},"skos:altLabel":{"@language":"hil","@value":"Agi"},"rdfs:comment":{"@language":"en","@value":"Filipino word that translates to both hermaphrodite and a gay slur."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000322"},{"@id":"https://homosaurus.org/v3/homoit0001560"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000091"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/agi"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001560","dc:identifier":"homoit0001560","skos:prefLabel":{"@language":"en","@value":"Slurs"},"rdfs:comment":{"@language":"en","@value":"Insulting or discriminating remarks, innuendos, or names intended to demoralize a person, typically by disparaging that person's identity or social group. Generally, for a term to be considered a slur, it must be derogatory towards a particular person or group, it must be used to subordinate them within some structure of power relations, and the derogated person or group must be defined by an intrinsic property such as their race, sexual orientation, gender identity, etc. This category includes terms considered slurs at any point in their usage. Therefore, some of these terms may no longer be considered universally derogatory, may be in common usage, or may be selectively reclaimed by certain groups."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000023"},{"@id":"https://homosaurus.org/v3/homoit0000037"},{"@id":"https://homosaurus.org/v3/homoit0000090"},{"@id":"https://homosaurus.org/v3/homoit0000091"},{"@id":"https://homosaurus.org/v3/homoit0000096"},{"@id":"https://homosaurus.org/v3/homoit0000098"},{"@id":"https://homosaurus.org/v3/homoit0000101"},{"@id":"https://homosaurus.org/v3/homoit0000246"},{"@id":"https://homosaurus.org/v3/homoit0000384"},{"@id":"https://homosaurus.org/v3/homoit0000418"},{"@id":"https://homosaurus.org/v3/homoit0000695"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000336"},{"@id":"https://homosaurus.org/v3/homoit0000356"},{"@id":"https://homosaurus.org/v3/homoit0000611"},{"@id":"https://homosaurus.org/v3/homoit0001108"},{"@id":"https://homosaurus.org/v3/homoit0001317"},{"@id":"https://homosaurus.org/v3/homoit0001559"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/slurs"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2024-07-25"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000091","dc:identifier":"homoit0000091","skos:prefLabel":{"@language":"fil","@value":"Bakla"},"rdfs:comment":{"@language":"en","@value":"Filipino word for people who are assigned male at birth who adopt feminine mannerisms; often considered a third gender."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000322"},{"@id":"https://homosaurus.org/v3/homoit0001560"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000023"},{"@id":"https://homosaurus.org/v3/homoit0000101"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bakla"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001026","dc:identifier":"homoit0001026","skos:prefLabel":{"@language":"en","@value":"Movement (LGBTQ)"},"skos:altLabel":{"@language":"en","@value":"Movement (LGBTQ)"},"rdfs:comment":{"@language":"en","@value":"Refers to various social and political movements aimed at securing equity and equal representation for LGBTQ+ people."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001322"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000162"},{"@id":"https://homosaurus.org/v3/homoit0000510"},{"@id":"https://homosaurus.org/v3/homoit0000672"},{"@id":"https://homosaurus.org/v3/homoit0000753"},{"@id":"https://homosaurus.org/v3/homoit0001187"},{"@id":"https://homosaurus.org/v3/homoit0001423"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000024"},{"@id":"https://homosaurus.org/v3/homoit0000030"},{"@id":"https://homosaurus.org/v3/homoit0000276"},{"@id":"https://homosaurus.org/v3/homoit0000523"},{"@id":"https://homosaurus.org/v3/homoit0000538"},{"@id":"https://homosaurus.org/v3/homoit0000856"},{"@id":"https://homosaurus.org/v3/homoit0001061"},{"@id":"https://homosaurus.org/v3/homoit0001905"},{"@id":"https://homosaurus.org/v3/homoit0002713"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/movementLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-1