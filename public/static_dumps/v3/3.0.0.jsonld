":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000998","dc:identifier":"homoit0000998","skos:prefLabel":{"@language":"en","@value":"Massage"},"rdfs:comment":{"@language":"en","@value":"Manipulation of the body through techniques like rubbing and kneading muscles and joints with the hands, typically to relieve tension and pain or to provide erotic stimulation."},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000402"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001112"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081957"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000998"},"dc:replaces":{"@id":"http://homosaurus.org/v2/massage"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000988","dc:identifier":"homoit0000988","skos:prefLabel":{"@language":"en","@value":"Manual sex"},"rdfs:comment":{"@language":"en","@value":"Sexual activity involving manual stimulation of erogenous zones using the hands."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001267"},{"@id":"https://homosaurus.org/v3/homoit0001299"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000446"},{"@id":"https://homosaurus.org/v3/homoit0001115"},{"@id":"https://homosaurus.org/v3/homoit0001498"},{"@id":"https://homosaurus.org/v3/homoit0001500"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000402"},{"@id":"https://homosaurus.org/v3/homoit0001000"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/manualSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000403","dc:identifier":"homoit0000403","skos:prefLabel":{"@language":"en","@value":"Erotica"},"rdfs:comment":{"@language":"en","@value":"The portrayal of sexuality with high-art aspirations, typically also focusing on feelings and emotions."},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000859"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000816"},{"@id":"https://homosaurus.org/v3/homoit0001128"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85044718"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000403"},"dc:replaces":{"@id":"http://homosaurus.org/v2/erotica"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000859","dc:identifier":"homoit0000859","skos:prefLabel":{"@language":"en","@value":"Erotic literature (LGBTQ)"},"skos:altLabel":{"@language":"en","@value":"Erotic literature (LGBTQ)"},"rdfs:comment":{"@language":"en","@value":"Literary works that have erotic or sexual elements; use in reference to erotic literature focusing on LGBTQ+ characters or themes."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000403"},{"@id":"https://homosaurus.org/v3/homoit0000443"}],"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0001597"},{"@id":"https://homosaurus.org/v3/homoit0001598"},{"@id":"https://homosaurus.org/v3/homoit0001599"},{"@id":"https://homosaurus.org/v3/homoit0001600"},{"@id":"https://homosaurus.org/v3/homoit0001601"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0002172"},{"@id":"https://homosaurus.org/v3/homoit0002184"},{"@id":"https://homosaurus.org/v3/homoit0002188"},{"@id":"https://homosaurus.org/v3/homoit0002205"},{"@id":"https://homosaurus.org/v3/homoit0002635"},{"@id":"https://homosaurus.org/v3/homoit0002644"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000403"},"dc:replaces":{"@id":"http://homosaurus.org/v2/eroticLiteratureLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-02-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001112","dc:identifier":"homoit0001112","skos:prefLabel":{"@language":"en","@value":"Physical affection"},"rdfs:comment":{"@language":"en","@value":"Touch between two or more people intended to arouse or convey feelings of closeness; can be used to express sexual or non-sexual intimacy and includes actions such as kissing, cuddling, embracing, and holding hands."},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000691"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000404"},{"@id":"https://homosaurus.org/v3/homoit0000998"},{"@id":"https://homosaurus.org/v3/homoit0001806"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001112"},"dc:replaces":{"@id":"http://homosaurus.org/v2/physicalAffection"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000405","dc:identifier":"homoit0000405","skos:prefLabel":{"@language":"en","@value":"Escort services"},"rdfs:comment":{"@language":"en","@value":"Agencies that serve to connect paying clients with escorts offering services by appointment. Escort services may be less stigmatized than other forms of sex work, in part because it tends to be safer for escorts and because some escorts offer a broader range of services, including accompaniment or entertainment without the promise of sexual contact. However, the tendency to frame escorting as separate from or superior to other forms of sex work obscures the labor undertaken by escorts and perpetuates discrimination against the most marginalized and vulnerable sex workers."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001276"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000406"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85044807"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/escortServices"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-06-19"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000406","dc:identifier":"homoit0000406","skos:prefLabel":{"@language":"en","@value":"Escorts"},"skos:altLabel":[{"@language":"en","@value":"Call boys"},{"@language":"en","@value":"Call girls"}],"rdfs:comment":{"@language":"en","@value":"Sex workers whose clients are required to make appointments for their services. Unlike sex workers who solicit clients on the street or in institutions like brothels, escorts typically advertise their services online, whether independently or through agencies. Escorting may be less stigmatized than other forms of sex work, in part because it tends to be safer for escorts and because some escorts offer a broader range of services, including accompaniment or entertainment without the promise of sexual contact. However, the tendency to frame escorting as separate from or superior to other forms of sex work obscures the labor undertaken by escorts and perpetuates discrimination against the most marginalized and vulnerable sex workers."},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000405"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0003758"},"dc:replaces":{"@id":"http://homosaurus.org/v2/escorts"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-06-19"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000651","dc:identifier":"homoit0000651","skos:prefLabel":{"@language":"en","@value":"Hormones"},"rdfs:comment":{"@language":"en","@value":"Regulatory substances produced in organisms and transported throughout the body to stimulate specific cells or tissues into action. Though hormones regulate digestion, respiration, sleep, and many other bodily functions, the term is most commonly used by the general public to describe the \"sex hormones,\" or the hormones involved in puberty and sexual development, reproduction, and sexual desire."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001269"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000407"},{"@id":"https://homosaurus.org/v3/homoit0001362"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0002876"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85061980"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hormones"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000986","dc:identifier":"homoit0000986","skos:prefLabel":{"@language":"en","@value":"MtFs"},"skos:altLabel":[{"@language":"en","@value":"Males transitioning to females"},{"@language":"en","@value":"MtF transsexuals"},{"@language":"en","@value":"Male-to-female"},{"@language":"en","@value":"M2Fs"},{"@language":"en","@value":"Transsexual women"}],"rdfs:comment":{"@language":"en","@value":"MtF (male-to-female) is a mostly historical term that has been largely replaced by \"trans women.\" This is due in part to the term’s connection to the medicalisation of transgender people and its assumption that trans women are \"born\" male and become female (typically through hormones and/or surgery)."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000878"},{"@id":"https://homosaurus.org/v3/homoit0001381"},{"@id":"https://homosaurus.org/v3/homoit0001642"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000407"},{"@id":"https://homosaurus.org/v3/homoit0000436"},{"@id":"https://homosaurus.org/v3/homoit0000457"},{"@id":"https://homosaurus.org/v3/homoit0001027"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006002132"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/MtFs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000408","dc:identifier":"homoit0000408","skos:prefLabel":{"@language":"en","@value":"Etiology"},"rdfs:comment":{"@language":"en","@value":"Inquiries and speculations regarding the causes of sexual behaviors or diseases."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001365"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh00005666"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/etiology"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000409","dc:identifier":"homoit0000409","skos:prefLabel":{"@language":"en","@value":"Eurogames"},"rdfs:comment":{"@language":"en","@value":"The most important gay and lesbian sporting event in Europe, hosted by license of the European Gay and Lesbian Sport Federation (EGLSF)"},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000949"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000861"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000949"},"dc:replaces":{"@id":"http://homosaurus.org/v2/eurogames"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-08-22"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000949","dc:identifier":"homoit0000949","skos:prefLabel":{"@language":"en","@value":"LGBTQ sporting events"},"skos:altLabel":{"@language":"en","@value":"LGBTQ sporting events"},"rdfs:comment":{"@language":"en","@value":"Organized games or sports activities for LGBTQ+ people or communities; includes both competitive and recreational events."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000861"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001929"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000861"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSportingEvents"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000410","dc:identifier":"homoit0000410","skos:prefLabel":{"@language":"en","@value":"Europride"},"rdfs:comment":{"@language":"en","@value":"A pan-European international event dedicated to LGBTQ+ pride that is hosted by a different European city each year"},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000522"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0003653"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000861"},"dc:replaces":{"@id":"http://homosaurus.org/v2/europride"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-10-04"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000411","dc:identifier":"homoit0000411","skos:prefLabel":{"@language":"en","@value":"Ex-gay movement"},"rdfs:comment":{"@language":"en","@value":"People and organizations that encourage people to resist entering or pursuing same-sex relationships, to eliminate homosexual desires, to develop heterosexual desires, and/or to enter into heterosexual relationships."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001322"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000303"},{"@id":"https://homosaurus.org/v3/homoit0000619"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005005425"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ex-gayMovement"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000412","dc:identifier":"homoit0000412","skos:prefLabel":{"@language":"en","@value":"Exhibitionism"},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000442"},{"@id":"https://homosaurus.org/v3/homoit0001267"},{"@id":"https://homosaurus.org/v3/homoit0001299"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001142"},{"@id":"https://homosaurus.org/v3/homoit0001257"},{"@id":"https://homosaurus.org/v3/homoit0001283"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85046353"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/exhibitionism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001257","dc:identifier":"homoit0001257","skos:prefLabel":{"@language":"en","@value":"Voyeurism"},"skos:altLabel":[{"@language":"en","@value":"Scopophilia"},{"@language":"en","@value":"Scoptophilia"}],"rdfs:comment":{"@language":"en","@value":"Practice of watching or listening to others, typically without their awareness or consent. In consensual sexual encounters, voyeurism involves watching or listening to someone undress or engage in sexual activity without actively participating."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000442"},{"@id":"https://homosaurus.org/v3/homoit0001267"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000412"},{"@id":"https://homosaurus.org/v3/homoit0001142"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85118773"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/voyeurism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-05-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001283","dc:identifier":"homoit0001283","skos:prefLabel":{"@language":"en","@value":"Sexual addiction"},"skos:altLabel":{"@language":"en","@value":"LGBTQ+ people with sex addictions"},"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people experiencing addiction to or dependency upon sexual activities. Only use to refer to individuals who describe themselves as having sexual addictions, not individuals whose sexual practices are perceived as promiscuous or unsafe by others."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001550"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001539"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000412"},{"@id":"https://homosaurus.org/v3/homoit0000656"},{"@id":"https://homosaurus.org/v3/homoit0001538"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualAddiction"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":