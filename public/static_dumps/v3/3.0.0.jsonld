//homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000336","dc:identifier":"homoit0000336","skos:prefLabel":{"@language":"en","@value":"Deadnaming"},"rdfs:comment":{"@language":"en","@value":"The act of using or referring to a person’s assigned name rather than their chosen name, commonly with malicious intent."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000062"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000264"},{"@id":"https://homosaurus.org/v3/homoit0000592"},{"@id":"https://homosaurus.org/v3/homoit0001016"},{"@id":"https://homosaurus.org/v3/homoit0001065"},{"@id":"https://homosaurus.org/v3/homoit0001560"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000356"},"dc:replaces":{"@id":"http://homosaurus.org/v2/deadnaming"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001006","dc:identifier":"homoit0001006","skos:prefLabel":[{"@language":"en-us","@value":"Medicalization"},{"@language":"en-gb","@value":"Medicalisation"}],"rdfs:comment":{"@language":"en","@value":"Process by which human conditions and experiences come to be defined and treated as medical conditions and thus become the subject of medical study, diagnosis, prevention, and/or treatment. Use in reference to non-medical problems, such as LGBTQ+ identities and practices, that have been wrongly treated as medical issues."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001004"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000395"},{"@id":"https://homosaurus.org/v3/homoit0000572"},{"@id":"https://homosaurus.org/v3/homoit0000669"},{"@id":"https://homosaurus.org/v3/homoit0001296"},{"@id":"https://homosaurus.org/v3/homoit0001463"},{"@id":"https://homosaurus.org/v3/homoit0001468"},{"@id":"https://homosaurus.org/v3/homoit0001469"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000062"},{"@id":"https://homosaurus.org/v3/homoit0000357"},{"@id":"https://homosaurus.org/v3/homoit0000567"},{"@id":"https://homosaurus.org/v3/homoit0001268"},{"@id":"https://homosaurus.org/v3/homoit0001320"},{"@id":"https://homosaurus.org/v3/homoit0002835"},{"@id":"https://homosaurus.org/v3/homoit0002841"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2016000450"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/medicalisation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001139","dc:identifier":"homoit0001139","skos:prefLabel":{"@language":"en","@value":"Public bathroom bills"},"skos:altLabel":[{"@language":"en","@value":"Changing room bans"},{"@language":"en","@value":"Locker room bans"},{"@language":"en","@value":"Restroom bans"}],"rdfs:comment":{"@language":"en","@value":"Laws or policies instituted to prevent trans and non-binary individuals from using public bathrooms and facilities, such as locker rooms, shower rooms, changing rooms, and other sex-segregated spaces, on the basis of their gender identity."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0003499"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000248"},{"@id":"https://homosaurus.org/v3/homoit0000975"},{"@id":"https://homosaurus.org/v3/homoit0001140"},{"@id":"https://homosaurus.org/v3/homoit0001141"},{"@id":"https://homosaurus.org/v3/homoit0001143"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/publicBathroomBills"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001140","dc:identifier":"homoit0001140","skos:prefLabel":{"@language":"en","@value":"Public bathrooms"},"skos:altLabel":[{"@language":"en","@value":"Public restrooms"},{"@language":"en","@value":"Toilets"}],"rdfs:comment":{"@language":"en","@value":"Rooms or small buildings with one or more toilets (or urinals) available for use by the general public or by customers or employees of a business."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001141"},"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000595"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000062"},{"@id":"https://homosaurus.org/v3/homoit0000308"},{"@id":"https://homosaurus.org/v3/homoit0001090"},{"@id":"https://homosaurus.org/v3/homoit0001139"},{"@id":"https://homosaurus.org/v3/homoit0001358"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85108627"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001141"},"dc:replaces":{"@id":"http://homosaurus.org/v2/publicBathrooms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001467","dc:identifier":"homoit0001467","skos:prefLabel":{"@language":"en","@value":"Transphobia"},"rdfs:comment":{"@language":"en","@value":"Antagonism or disgust directed toward trans individuals (or others perceived to be transgressing gender norms) due to their gender identity and/or expression. Transphobia can include denial of the existence of trans identities, stereotypes, verbal harassment, and physical violence."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000920"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000062"},{"@id":"https://homosaurus.org/v3/homoit0000063"},{"@id":"https://homosaurus.org/v3/homoit0000619"},{"@id":"https://homosaurus.org/v3/homoit0001378"},{"@id":"https://homosaurus.org/v3/homoit0001819"},{"@id":"https://homosaurus.org/v3/homoit0001892"},{"@id":"https://homosaurus.org/v3/homoit0001903"},{"@id":"https://homosaurus.org/v3/homoit0003499"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2010012303"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transphobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-01"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001516","dc:identifier":"homoit0001516","skos:prefLabel":{"@language":"en","@value":"Womyn"},"rdfs:comment":{"@language":"en","@value":"A spelling of \"woman\" or \"women\" that first appeared in print in 1976 and is used in certain feminist circles to avoid having the suffix of \"men.\"  Some contemporary transgender activists have criticized use of the word \"womyn\" due to its prevalence in trans-exclusionary radical feminist (TERF) circles following the exclusion of trans women from the Michigan Womyn’s Music Festival."},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000062"},{"@id":"https://homosaurus.org/v3/homoit0000437"},{"@id":"https://homosaurus.org/v3/homoit0001230"},{"@id":"https://homosaurus.org/v3/homoit0001505"},{"@id":"https://homosaurus.org/v3/homoit0001509"},{"@id":"https://homosaurus.org/v3/homoit0001515"},{"@id":"https://homosaurus.org/v3/homoit0001819"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85147274"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001516"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womyn"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-03-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000064","dc:identifier":"homoit0000064","skos:prefLabel":{"@language":"en","@value":"Aphallia"},"skos:altLabel":{"@language":"en","@value":"Penile agenesis"},"rdfs:comment":{"@language":"en","@value":"People with aphallia have XY chromosomes, testes, and are born without a penis. They produce typical levels of testosterone, and they develop secondary sex characteristics associated with a typical testosterone puberty during adolescence."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/aphallia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000065","dc:identifier":"homoit0000065","skos:prefLabel":{"@language":"ta","@value":"Aravani"},"skos:altLabel":{"@language":"ta","@value":"Aruvani"},"rdfs:comment":{"@language":"en","@value":"Indian term for people who identify as women trapped in male bodies; many prefer other terms, such as hijra or thirunangai."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000632"},{"@id":"https://homosaurus.org/v3/homoit0001370"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/aravani"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000632","dc:identifier":"homoit0000632","skos:prefLabel":{"@language":"en","@value":"Hijra"},"skos:altLabel":{"@language":"en","@value":"Jagappa"},"rdfs:comment":{"@language":"en","@value":"Hindi word used in South Asia to refer to people assigned male at birth who identify as women or “not-men.”"},"skos:broader":{"