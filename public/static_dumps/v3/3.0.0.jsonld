GBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001558","dc:identifier":"homoit0001558","skos:prefLabel":{"@language":"en","@value":"Polysexuality"},"rdfs:comment":{"@language":"en","@value":"Term used to describe the sexual identity of individuals who experience attraction to more than one gender; includes bisexuality and pansexuality."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001290"},{"@id":"https://homosaurus.org/v3/homoit0001295"},{"@id":"https://homosaurus.org/v3/homoit0001298"},{"@id":"https://homosaurus.org/v3/homoit0001300"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000204"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0001123"},{"@id":"https://homosaurus.org/v3/homoit0001919"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000358"},"dc:replaces":{"@id":"http://homosaurus.org/v2/polysexuality"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000647","dc:identifier":"homoit0000647","skos:prefLabel":{"@language":"en","@value":"Homosexuality"},"rdfs:comment":{"@language":"en","@value":"Sexual orientation with sexual and/or romantic attraction to individuals of the same sex."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0001298"},{"@id":"https://homosaurus.org/v3/homoit0001556"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0001240"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000204"},{"@id":"https://homosaurus.org/v3/homoit0000506"},{"@id":"https://homosaurus.org/v3/homoit0000556"},{"@id":"https://homosaurus.org/v3/homoit0000631"},{"@id":"https://homosaurus.org/v3/homoit0000799"}],"skos:exactMatch":{"@i