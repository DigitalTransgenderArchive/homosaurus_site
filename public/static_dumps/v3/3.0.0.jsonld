 pup or puppy role in puppy play, a form of animal roleplay that is often but not always associated with BDSM and kink communities."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000487"},{"@id":"https://homosaurus.org/v3/homoit0000506"},{"@id":"https://homosaurus.org/v3/homoit0000705"},{"@id":"https://homosaurus.org/v3/homoit0001242"},{"@id":"https://homosaurus.org/v3/homoit0001295"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000105"},{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0001063"},{"@id":"https://homosaurus.org/v3/homoit0003083"},{"@id":"https://homosaurus.org/v3/homoit0003086"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pups"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-31"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001508","dc:identifier":"homoit0001508","skos:prefLabel":{"@language":"en","@value":"Wolves (Gay culture)"},"skos:altLabel":{"@language":"en","@value":"Wolves"},"rdfs:comment":{"@language":"en","@value":"U.S. slang term for heavy-set, masculine gay men who are often characterized as having hairy bodies and facial hair; typically used for individuals who are more aggressive and overtly masculine than bears."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000487"},{"@id":"https://homosaurus.org/v3/homoit0000506"},{"@id":"https://homosaurus.org/v3/homoit0000577"},{"@id":"https://homosaurus.org/v3/homoit0001295"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000321"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000105"},{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0000995"},{"@id":"https://homosaurus.org/v3/homoit0001063"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/wolves"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-12-18"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001366","dc:identifier":"homoit0001366","skos:prefLabel":{"@language":"en","@value":"Therapies"},"rdfs:comment":{"@language":"en","@value":"Treatments addressing impairments, illnesses, diseases, or disorders through counseling and rehabilitation."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001004"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000106"},{"@id":"https://homosaurus.org/v3/homoit0000303"},{"@id":"https://homosaurus.org/v3/homoit0000317"},{"@id":"https://homosaurus.org/v3/homoit0000394"},{"@id":"https://homosaurus.org/v3/homoit0000617"},{"@id":"https://homosaurus.org/v3/homoit0001007"},{"@id":"https://homosaurus.org/v3/homoit0001274"},{"@id":"https://homosaurus.org/v3/homoit0001496"}],"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001012"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85085490"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/therapies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000107","dc:identifier":"homoit0000107","skos:prefLabel":{"@language":"en","@value":"Being in love"},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000894"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0001237"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85078519"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000894"},"dc:replaces":{"@id":"http://homosaurus.org/v2/beingInLove"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-10-13"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000894","dc:identifier":"homoit0000894","skos:prefLabel":{"@language":"en","@value":"LGBTQ love"},"skos:altLabel":[{"@language":"en","@value":"LGBTQ love"},{"@language":"en","@value":"Love (LGBTQ)"}],"rdfs:comment":{"@language":"en","@value":"Strong feelings of affection arising out of kinship, personal ties, or intimate relationships between two or more LGBTQ+ people. Can be used to describe the particularities of love as experienced by LGBTQ+ people in a given culture, as well as the ways love is discussed and expressed within LGBTQ+ communities."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000921"},{"@id":"https://homosaurus.org/v3/homoit0000957"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000976"},{"@id":"https://homosaurus.org/v3/homoit0001237"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQLove"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-01-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001365","dc:identifier":"homoit0001365","skos:prefLabel":{"@language":"en","@value":"Theories"},"rdfs:comment":{"@language":"en","@value":"Systems of ideas intended to explain a particular phenomenon."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000115"},{"@id":"https://homosaurus.org/v3/homoit0000408"},{"@id":"https://homosaurus.org/v3/homoit0001219"},{"@id":"https://homosaurus.org/v3/homoit0001320"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/theories"},"dc:issued":{"@type":"xsd:date","@va