":"https://homosaurus.org/v3/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/assignedGender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-04-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001268","dc:identifier":"homoit0001268","skos:prefLabel":{"@language":"en","@value":"Sex assigned at birth"},"skos:altLabel":[{"@language":"en","@value":"Birth sex"},{"@language":"en","@value":"Birth-assigned sex"},{"@language":"en","@value":"Natal sex"},{"@language":"en","@value":"Sex at birth"},{"@language":"en","@value":"Sex reported at birth"},{"@language":"en","@value":"ASAB "},{"@language":"en","@value":"SAAB"}],"rdfs:comment":{"@language":"en","@value":"The process of determining an individual’s sex relatively shortly after birth, usually documented on official records, such as a birth certificate. Determination is usually based on the appearance of external genitalia but may use other methodologies. In practice, sex assigned at birth is often culturally variable; the term “gender assigned at birth” is often more applicable or accurate."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001648"},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000077"},{"@id":"https://homosaurus.org/v3/homoit0000079"},{"@id":"https://homosaurus.org/v3/homoit0001646"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000120"},{"@id":"https://homosaurus.org/v3/homoit0000585"},{"@id":"https://homosaurus.org/v3/homoit0000600"},{"@id":"https://homosaurus.org/v3/homoit0000668"},{"@id":"https://homosaurus.org/v3/homoit0000669"},{"@id":"https://homosaurus.org/v3/homoit0000670"},{"@id":"https://homosaurus.org/v3/homoit0001006"},{"@id":"https://homosaurus.org/v3/homoit0001099"},{"@id":"https://homosaurus.org/v3/homoit0001488"},{"@id":"https://homosaurus.org/v3/homoit0001896"},{"@id":"https://homosaurus.org/v3/homoit0001897"}],"sko