it0000362"},{"@id":"https://homosaurus.org/v3/homoit0000675"},{"@id":"https://homosaurus.org/v3/homoit0000855"},{"@id":"https://homosaurus.org/v3/homoit0000895"},{"@id":"https://homosaurus.org/v3/homoit0001080"},{"@id":"https://homosaurus.org/v3/homoit0001081"},{"@id":"https://homosaurus.org/v3/homoit0001082"},{"@id":"https://homosaurus.org/v3/homoit0001237"},{"@id":"https://homosaurus.org/v3/homoit0001300"},{"@id":"https://homosaurus.org/v3/homoit0002365"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001311"},"dc:replaces":{"@id":"http://homosaurus.org/v2/significantOthers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-21"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000390","dc:identifier":"homoit0000390","skos:prefLabel":{"@language":"en","@value":"Egg donors"},"rdfs:comment":{"@language":"en","@value":"Individuals of any gender who donate their own eggs for the purpose of inducing pregnancy."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000364"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000583"},{"@id":"https://homosaurus.org/v3/homoit0000864"},{"@id":"https://homosaurus.org/v3/homoit0001347"},{"@id":"https://homosaurus.org/v3/homoit0002627"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005007904"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000364"},"dc:replaces":{"@id":"http://homosaurus.org/v2/eggDonors"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000824","dc:identifier":"homoit0000824","skos:prefLabel":{"@language":"en","@value":"LGBTQ blood donors"},"skos:altLabel":{"@language":"en","@value":"LGBTQ blood donors"},"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who give blood for transfusion and medical purposes."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000364"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000364"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQBloodDonors"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000861","dc:identifier":"homoit0000861","skos:prefLabel":{"@language":"en","@value":"LGBTQ events"},"skos:altLabel":{"@language":"en","@value":"LGBTQ events"},"rdfs:comment":{"@language":"en","@value":"Organized public or social occasions for LGBTQ+ people and communities."},"skos:narrower":[{"@id":"https://homosaurus.org/v3/homoit0000368"},{"@id":"https://homosaurus.org/v3/homoit0000383"},{"@id":"https://homosaurus.org/v3/homoit0000522"},{"@id":"https://homosaurus.org/v3/homoit0000607"},{"@id":"https://homosaurus.org/v3/homoit0000767"},{"@id":"https://homosaurus.org/v3/homoit0000949"},{"@id":"https://homosaurus.org/v3/homoit0001379"},{"@id":"https://homosaurus.org/v3/homoit0001515"}],"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000853"},{"@id":"https://homosaurus.org/v3/homoit0000900"},{"@id":"https://homosaurus.org/v3/homoit0002157"},{"@id":"https://homosaurus.org/v3/homoit0002166"},{"@id":"https://homosaurus.org/v3/homoit0002202"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000861"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQEvents"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2024-08-20"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000372","dc:identifier":"homoit0000372","skos:prefLabel":{"@language":"en","@value":"Drag fathers"},"rdfs:comment":{"@language":"en","@value":"More experienced drag kings who support less experienced drag kings as they enter the drag scene as performers."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000371"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000373"},{"@id":"https://homosaurus.org/v3/homoit0000374"},{"@id":"https://homosaurus.org/v3/homoit0000375"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragFathers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-11-04"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000374","dc:identifier":"homoit0000374","skos:prefLabel":{"@language":"en","@value":"Drag mothers"},"rdfs:comment":{"@language":"en","@value":"More experienced drag queens who support less experienced drag queens as they enter the drag scene as performers."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0000371"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000372"},{"@id":"https://homosaurus.org/v3/homoit0000373"},{"@id":"https://homosaurus.org/v3/homoit0000375"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragMothers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-11-04"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000983","dc:identifier":"homoit0000983","skos:prefLabel":{"@language":"en","@value":"Male impersonators"},"rdfs:comment":{"@language":"en","@value":"Historical term used to describe performers, often female-identified people, who enact male personas for the purpose of entertainment, typically for straight audiences. Only use in historical contexts."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001363"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000373"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85064636"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001363"},"dc:replaces":{"@id":"http://homosaurus.org/v2/maleImpersonators"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2022-12-12"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0001148","dc:identifier":"homoit0001148","skos:prefLabel":{"@language":"en","@value":"Queens (Gay culture)"},"skos:altLabel":{"@language":"en","@value":"Queens"},"rdfs:comment":{"@language":"en","@value":"Slang term for effeminate gay men; predominantly used in the United States."},"skos:broader":[{"@id":"https://homosaurus.org/v3/homoit0000487"},{"@id":"https://homosaurus.org/v3/homoit0000506"}],"skos:narrower":{"@id":"https://homosaurus.org/v3/homoit0000375"},"skos:related":[{"@id":"https://homosaurus.org/v3/homoit0000568"},{"@id":"https://homosaurus.org/v3/homoit0001313"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v3/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queens"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2023-06-27"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v3"}},{"@id":"https://homosaurus.org/v3/homoit0000431","dc:identifier":"homoit0000431","skos:prefLabel":{"@language":"en","@value":"Female impersonators"},"rdfs:comment":{"@language":"en","@value":"Historical term describing performers, often male-identified people, who enact female personas for the purpose of entertainment, often for straight audiences. Eclipsed by other terms (such as drag queen) in the late 20th century."},"skos:broader":{"@id":"https://homosaurus.org/v3/homoit0001363"},"skos:related":{"@id":"https://homosaurus.org/v3/homoit0000375"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85064634"},"skos:hasTopConcept"