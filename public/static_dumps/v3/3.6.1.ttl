  dc:modified "2023-06-30"^^xsd:date;
  rdfs:comment "Asexual people who have experienced and survived sexual abuse; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."@en;
  skos:broader <https://homosaurus.org/v3/homoit0001351>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000915>;
  skos:inScheme <https://homosaurus.org/v3>;
