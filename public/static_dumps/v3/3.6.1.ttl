<https://homosaurus.org/v3/homoit0002275> a skos:Concept;
  dc:identifier "homoit0002275";
  dc:issued "2022-11-08"^^xsd:date;
  dc:modified "2024-01-29"^^xsd:date;
  rdfs:comment "Period of feminist political activity beginning in the early 1990s that embraced diversity and individualism in women and sought to redefine what it meant to be a feminist. The third wave is characterized by the emergence of new feminist movements and theories such as intersectionality, sex positivity, ecofeminism, transfeminism, and postmodern feminism."@en;
  skos:altLabel "Third wave feminism"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000437>;
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh2008001561>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000437>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Third-wave feminism"@en;
  skos:related <https://homosaurus.org/v3/homoit0003174> .

<https://homosaurus.org/v3/homoit0002276> a skos:Concept;
  dc:identifier "homoit0002276";
  dc:issued "2022-11-08"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "Sexual identity or sexuality term used to describe women and, in some definitions, non-binary people who are sapphic, or attracted to women. Only use to describe individuals who describe their identity as sapphic."@en;
  skos:altLabel "Sapphist identity"@en;
  skos:broader <https://homosaurus.org/v3/homoit0001295>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001295>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Sapphic identity"@en;
  skos:related <https://homosaurus.org/v3/homoit0002277> .

<https://homosaurus.org/v3/homoit0002287> a skos:Concept;
  dc:identifier "homoit0002287";
  dc:issued "2022-11-10"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "Facial hair on the upper lip. Includes false or drag mustaches as well as naturally grown hair."@en;
  skos:broader <https://homosaurus.org/v3/homoit0000605>;
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85089102>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001269>;
