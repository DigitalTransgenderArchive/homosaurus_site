    <https://homosaurus.org/v3/homoit0002177> .

<https://homosaurus.org/v3/homoit0002189> a skos:Concept;
  dc:identifier "homoit0002189";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "The relationships (primarily romantic or sexual) between characters in fanworks, including relationships that are not present within the canon text."@en;
  skos:altLabel "Fandom pairings"@en;
  skos:broader <https://homosaurus.org/v3/homoit0002199>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0002187>;
  skos:prefLabel "Pairings in fandom"@en;
  skos:related <https://homosaurus.org/v3/homoit0001237> .

<https://homosaurus.org/v3/homoit0002191> a skos:Concept;
  dc:identifier "homoit0002191";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "Marketing tactic in which creators of a piece of media purposefully hint at but do not explicitly depict or follow through with queer relationships or queer representation. Queerbaiting is distinct from queer coding in that queer coding is not typically used as a marketing tactic."@en;
  skos:altLabel "Queer baiting"@en;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0002191>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Queerbaiting"@en;
  skos:related <https://homosaurus.org/v3/homoit0000899>,
    <https://homosaurus.org/v3/homoit0002192> .

<https://homosaurus.org/v3/homoit0002196> a skos:Concept;
  dc:identifier "homoit0002196";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "Fanfiction about real people, such as actors or musicians; often but not always used to describe fanfiction focusing on (real or imagined) same-sex or same-gender relationships between celebrities."@en;
