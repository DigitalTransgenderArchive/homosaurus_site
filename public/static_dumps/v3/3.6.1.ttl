  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000915>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "LGBTQ+ people practicing sobriety"@en;
  skos:related <https://homosaurus.org/v3/homoit0001551> .

<https://homosaurus.org/v3/homoit0002269> a skos:Concept;
  dc:identifier "homoit0002269";
  dc:issued "2022-11-08"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "Umbrella term used to describe a range of ideas, policies, and political actions that are intended to actively challenge, reject, or oppose racism and racial oppression (whether personal or systemic), as well as advocate for racial equity."@en;
  skos:altLabel "Antiracism"@en;
