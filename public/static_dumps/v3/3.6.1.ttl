  dc:issued "2024-01-09"^^xsd:date;
  dc:modified "2024-01-29"^^xsd:date;
  rdfs:comment "Films with significant characters who appear in drag. Not to be confused with films where a principal actor plays a character who identifies as a gender other than what the actor identifies as."@en;
