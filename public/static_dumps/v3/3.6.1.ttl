<https://homosaurus.org/v3/homoit0002654> a skos:Concept;
  dc:identifier "homoit0002654";
  dc:issued "2023-06-26"^^xsd:date;
  dc:modified "2023-10-24"^^xsd:date;
  rdfs:comment "A term coined by the Kānaka Maoli (Native Hawaiian) queer community in the early 2000s that blends the term Māhū (for third gender indigenous people of Hawai'i and Tahiti who blend genders and often hold spiritual roles) and kāne (man)."@en;
  skos:altLabel "Mahukane"@haw;
  skos:broader <https://homosaurus.org/v3/homoit0000979>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000560>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Māhūkāne"@haw .

