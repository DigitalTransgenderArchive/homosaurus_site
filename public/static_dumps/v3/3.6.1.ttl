  dc:modified "2023-12-08"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/intersexIdentity>;
  rdfs:comment "Used to describe the experience of selfhood of intersex people. Intersex identity is not gender identity, sexual identity, nor sexual orientation. For the subject of intersex variations, use \"intersex variations\" or \"intersex\". For the subject of intersex people, use \"intersex people\". Do not use in place of gender-identity-related terms such as non-binary identity or genderfluid identity."@en;
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh2007005480>;
