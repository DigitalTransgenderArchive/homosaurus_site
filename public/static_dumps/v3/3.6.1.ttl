<https://homosaurus.org/v3/homoit0002653> a skos:Concept;
  dc:identifier "homoit0002653";
  dc:issued "2023-06-26"^^xsd:date;
  dc:modified "2024-01-31"^^xsd:date;
  rdfs:comment "Acronym used to describe Pasifika/Pacific Islander gender diverse identities as a group. The acronym includes Māhū (Hawai'i and Tahiti), Vaka sa lewa lewa (Fiji), Palopa (Papua New Guinea), Fa’afafine (Samoa), Akava’ine (Rarotonga), Fakaleitī (Tonga), Fakafifine (Niue), and more."@en;
  skos:broader <https://homosaurus.org/v3/homoit0000322>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000560>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0000035>,
    <https://homosaurus.org/v3/homoit0000413>,
    <https://homosaurus.org/v3/homoit0000419>,
    <https://homosaurus.org/v3/homoit0000979>,
    <https://homosaurus.org/v3/homoit0001499>,
    <https://homosaurus.org/v3/homoit0001502>;
  skos:prefLabel "MVPFAFF+"@en,
    "MVPFAFF+"@fij,
    "MVPFAFF+"@haw,
    "MVPFAFF+"@niu,
    "MVPFAFF+"@pmy,
    "MVPFAFF+"@rar,
    "MVPFAFF+"@smo,
    "MVPFAFF+"@tah,
    "MVPFAFF+"@ton .

