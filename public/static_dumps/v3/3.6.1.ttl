  skos:prefLabel "Mustaches"@en-us,
    "Moustaches"@en-gb .

<https://homosaurus.org/v3/homoit0002288> a skos:Concept;
  dc:identifier "homoit0002288";
  dc:issued "2022-11-10"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "Slang term for mustaches or facial hair on the upper lip, particularly that of lesbians."@en;
