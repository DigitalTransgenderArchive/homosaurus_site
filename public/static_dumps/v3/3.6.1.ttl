  dc:modified "2022-12-13"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/romanticFriendships>;
  rdfs:comment "Very close but non-sexual relationships between friends, often involving a degree of physical closeness beyond that which is common in modern Western societies; this may include, for example, friends holding hands, cuddling, kissing, and/or sharing a bed."@en;
