  dc:issued "2022-06-15"^^xsd:date;
  dc:modified "2024-07-31"^^xsd:date;
  rdfs:comment "The presence of Two-Spirit people in the workplace, including acceptance of and issues faced by Two-Spirit workers."@en;
  skos:broader <https://homosaurus.org/v3/homoit0001480>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000560>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Two-Spirit people in the workplace"@en;
