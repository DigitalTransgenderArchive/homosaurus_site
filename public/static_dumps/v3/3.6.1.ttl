  skos:related <https://homosaurus.org/v3/homoit0001026>,
    <https://homosaurus.org/v3/homoit0000006>,
    <https://homosaurus.org/v3/homoit0003696> .

<https://homosaurus.org/v3/homoit0003706> a skos:Concept;
  dc:identifier "homoit0003706";
  dc:issued "2024-10-23"^^xsd:date;
  dc:modified "2025-01-26"^^xsd:date;
  rdfs:comment "The analysis and evaluation of feminist films and film history, or film criticism from a feminist perspective."@en;
  skos:altLabel "Feminist film critique"@en,
    "Feminist film analysis"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000579>,
