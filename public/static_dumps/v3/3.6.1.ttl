<https://homosaurus.org/v3/homoit0001117> a skos:Concept;
  dc:identifier "homoit0001117";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2024-07-31"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/pinkwashing>;
  rdfs:comment "A variety of marketing and political strategies aimed at promoting products, countries, people, or entities to LGBTQ+ people; using LGBTQ+-related symbols in order to be perceived as progressive, modern, and tolerant; and/or utilizing concern for LGBTQ+ people and rights to justify or deviate attention from settler-colonialism, genocide, invasion, and intervention in other countries."@en;
