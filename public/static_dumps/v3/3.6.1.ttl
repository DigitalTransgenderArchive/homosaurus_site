  skos:altLabel "LGBTQ+ pride parades"@en;
  skos:broader <https://homosaurus.org/v3/homoit0003651>;
  skos:closeMatch <http://id.loc.gov/authorities/subjects/sh2006020042>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000861>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Pride parades"@en .

<https://homosaurus.org/v3/homoit0003658> a skos:Concept;
  dc:identifier "homoit0003658";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-01-26"^^xsd:date;
  rdfs:comment "Social, psychological, behavioral, and medical interventions designed to support and affirm individuals belonging to the intersex community. Intersex-affirming care includes but is not limited to equal access to health care facilities, access to medical records and information about one's intersex status and traits, and informed consent regarding medical procedures or treatments related to intersex traits."@en;
  skos:altLabel "Intersex affirming care"@en;
  skos:broader <https://homosaurus.org/v3/homoit0003657>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000614>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Intersex-affirming care"@en .

<https://homosaurus.org/v3/homoit0003659> a skos:Concept;
  dc:identifier "homoit0003659";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-01-26"^^xsd:date;
  rdfs:comment "Social, psychological, behavioral, and medical interventions designed to support and affirm a transgender individual's gender identity. Transgender-affirming care includes but is not limited to equal access to health care facilities, counseling, puberty blockers, hormone therapy, and gender-affirming surgeries. It can also include resources to aid in social transition, such as affirming policies regarding name and pronoun changes, access to non-gendered restrooms and facilities, etc."@en;
  skos:altLabel "Trans-affirming care"@en,
    "Transgender affirming care"@en,
    "Trans affirming care"@en;
  skos:broader <https://homosaurus.org/v3/homoit0003657>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000614>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Transgender-affirming care"@en .

