<https://homosaurus.org/v3/homoit0002151> a skos:Concept;
  dc:identifier "homoit0002151";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2024-07-31"^^xsd:date;
  rdfs:comment "Japanese word that means \"beautiful boy\" and is used to describe a particular aesthetic of androgynous male beauty. While in Japanese \"bishounen\" refers specifically to youths under the age of twenty and \"biseinen\" is used to describe beautiful adult men, English-speaking anime and manga fan communities often use \"bishounen\" in reference to any good-looking male character, regardless of age."@en;
  skos:broader <https://homosaurus.org/v3/homoit0002144>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Bishounen"@ja;
  skos:related <https://homosaurus.org/v3/homoit0001520>,
    <https://homosaurus.org/v3/homoit0002152>,
    <https://homosaurus.org/v3/homoit0002197>,
    <https://homosaurus.org/v3/homoit0002214> .

