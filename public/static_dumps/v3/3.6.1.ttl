<https://homosaurus.org/v3/homoit0002202> a skos:Concept;
  dc:identifier "homoit0002202";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "Conventions focused on slash, or fanworks depicting same-sex or same-gender couples that are typically erotic or pornographic in nature. Historically used for male-male couples only, but is now used more broadly; includes femslash conventions."@en;
  skos:altLabel "Slash cons"@en;
  skos:broader <https://homosaurus.org/v3/homoit0002157>,
