<https://homosaurus.org/v3/homoit0003504> a skos:Concept;
  dc:identifier "homoit0003504";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2024-08-01"^^xsd:date;
  rdfs:comment "Laws or policies instituted to prevent trans and non-binary individuals from seeking medical treatment or gender-affirming care, including but not limited to surgery, hormone treatment, and mental health care. "@en;
