  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2024-01-30"^^xsd:date;
  rdfs:comment "Criminalization of any expression of gender considered to be cross-dressing in a given sociocultural context."@en;
  skos:broader <https://homosaurus.org/v3/homoit0002388>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000702>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Criminalization of cross-dressing"@en .

