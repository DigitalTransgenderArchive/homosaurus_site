<https://homosaurus.org/v3/homoit0001120> a skos:Concept;
  dc:identifier "homoit0001120";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2024-05-24"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/policeEntrapment>;
  rdfs:comment "A practice in which law enforcement agents or agents of the state coerce an individual to commit a \"crime\" they would have otherwise been unlikely or unwilling to commit. Legal definitions of entrapment vary widely depending on the jurisdiction, but the term is often used colloquially to refer to police acting dishonestly or in bad faith, as well as policing focused on anticipating and inducing crime, rather than responding to reports of crime."@en;
  skos:broader <https://homosaurus.org/v3/homoit0001121>;
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85044146>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000611>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0002374>;
  skos:prefLabel "Police entrapment"@en;
  skos:related <https://homosaurus.org/v3/homoit0000068>,
    <https://homosaurus.org/v3/homoit0001119> .

<https://homosaurus.org/v3/homoit0001121> a skos:Concept;
  dc:identifier "homoit0001121";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2024-05-24"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/policeHarassment>;
  rdfs:comment "Any of various forms of inappropriate conduct, illegal actions, or abuses of power undertaken by law enforcement agents or agents of the state against members of the public. This includes but is not limited to racial, ethnic, and other forms of profiling; unwarranted surveillance, searches, and seizure; selective enforcement; excessive use of force; sexual misconduct; intimidation and witness tampering; falsification of evidence; coerced confessions; false arrests and imprisonment; and bribing or lobbying."@en;
  skos:altLabel "Harrassment by police"@en,
    "Misconduct by police"@en,
    "Mistreatment by police"@en,
    "Police misconduct"@en,
    "Police mistreatment"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000611>;
  skos:closeMatch <http://id.loc.gov/authorities/subjects/sh95010616>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000611>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0001120>,
    <https://homosaurus.org/v3/homoit0001122>,
    <https://homosaurus.org/v3/homoit0002375>;
  skos:prefLabel "Police harassment"@en .

