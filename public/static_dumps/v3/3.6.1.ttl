<https://homosaurus.org/v3/homoit0002659> a skos:Concept;
  dc:identifier "homoit0002659";
  dc:issued "2023-06-26"^^xsd:date;
  dc:modified "2024-01-30"^^xsd:date;
  rdfs:comment "Gay men whose brains process, learn, and/or behave differently from what is considered typical by society. Some of these neurological differences can present as learning disabilities, medical disorders, and other conditions."@en;
