<https://homosaurus.org/v3/homoit0002162> a skos:Concept;
  dc:identifier "homoit0002162";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2024-07-31"^^xsd:date;
  rdfs:comment "A genre of fanworks in which two or more women are placed in a sexual or romantic situation with one another. Works of femslash are commonly erotic or pornographic. In recognition of the fact that the term \"slash\" has recently been broadened to include LGBTQ+ relationships other than those between two men, slash terms (e.g., Slash art, Slash roleplay, Slash vidding) should be used to describe specific types of femslash."@en;
  skos:altLabel "Altfic"@en,
    "F/F slash"@en,
    "Femmeslash"@en,
    "Girlslash"@en,
    "Ladyslash"@en;
  skos:broader <https://homosaurus.org/v3/homoit0002200>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0000742>,
    <https://homosaurus.org/v3/homoit0001597>;
  skos:prefLabel "Femslash"@en;
  skos:related <https://homosaurus.org/v3/homoit0000576>,
    <https://homosaurus.org/v3/homoit0002220>,
    <https://homosaurus.org/v3/homoit0002221> .

