<https://homosaurus.org/v3/homoit0002857> a skos:Concept;
  dc:identifier "homoit0002857";
  dc:issued "2023-06-28"^^xsd:date;
  dc:modified "2023-06-30"^^xsd:date;
  rdfs:comment "Asexual people who have experienced war and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."@en;
  skos:broader <https://homosaurus.org/v3/homoit0000961>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000915>;
