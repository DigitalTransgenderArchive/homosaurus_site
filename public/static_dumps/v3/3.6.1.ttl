<https://homosaurus.org/v3/homoit0003279> a skos:Concept;
  dc:identifier "homoit0003279";
  dc:issued "2024-06-10"^^xsd:date;
  dc:modified "2024-08-01"^^xsd:date;
  rdfs:comment "Books or other resources of information about places designed for the use of LGBTQ+ visitors or tourists, typically to direct travelers to establishments or attractions that are owned by, open to, or frequented by LGBTQ+ people. LGBTQ+ travel guides may also direct travelers to safe houses or businesses in places where LGBTQ+ people are otherwise unsafe or criminalized, as well as locations commonly used for cruising, or picking up casual sex partners."@en;
  skos:altLabel "Guide books (LGBTQ)"@en,
    "LGBTQ+ guide books"@en,
    "LGBTQ+ travel guide books"@en,
    "Travel guide books (LGBTQ)"@en,
    "Travel guides (LGBTQ)"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000956>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000956>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "LGBTQ+ travel guides"@en .

