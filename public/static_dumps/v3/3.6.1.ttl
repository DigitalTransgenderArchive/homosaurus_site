<https://homosaurus.org/v3/homoit0002910> a skos:Concept;
  dc:identifier "homoit0002910";
  dc:issued "2023-06-29"^^xsd:date;
  dc:modified "2023-06-30"^^xsd:date;
  rdfs:comment "People who act as parents to one or more asexual person. For parents who are themselves asexual, use the term \"Asexual parents.\""@en;
