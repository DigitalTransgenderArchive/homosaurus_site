<https://homosaurus.org/v3/homoit0001477> a skos:Concept;
  dc:identifier "homoit0001477";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2024-04-15"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/tumtum>;
  rdfs:comment "Term originating in Rabbinic Judaism to refer to someone with an unknown sex; literally translates to \"hidden.\" Used historically to refer to intersex variations where the genitals were covered by skin. Only use for individuals who are Jewish and who self-identify as Tumtum."@en;
  skos:broader <https://homosaurus.org/v3/homoit0000322>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000560>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Tumtum"@he .

<https://homosaurus.org/v3/homoit0001478> a skos:Concept;
  dc:identifier "homoit0001478";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2024-01-30"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/turnerSyndrome>;
  rdfs:comment "Turner syndrome is a variation in which a person is born with a 45X chromosome pattern (sometimes called 45XO) rather than the typical 46XX. People with Turner syndrome often share specific physical features such as short stature, a webbed neck and broad chest, and heart issues. They can also develop variations in their other sex characteristics, such as smaller-than-typical ovaries that may stop producing hormones at a younger age than typical, and they might not menstruate or experience pubertal changes."@en;
  skos:broader <https://homosaurus.org/v3/homoit0000669>;
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85138930>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001269>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Turner syndrome"@en .

