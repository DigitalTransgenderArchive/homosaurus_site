<https://homosaurus.org/v3/homoit0002205> a skos:Concept;
  dc:identifier "homoit0002205";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2022-12-21"^^xsd:date;
  rdfs:comment "Fanfiction focusing on sexual or romantic relationships between characters of the same sex or gender that is typically erotic or pornographic in nature. Historically used for male-male couples only, but is now used more broadly; includes femslash fiction."@en;
