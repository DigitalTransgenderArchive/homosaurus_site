<https://homosaurus.org/v3/homoit0002909> a skos:Concept;
  dc:identifier "homoit0002909";
  dc:issued "2023-06-29"^^xsd:date;
  dc:modified "2023-06-30"^^xsd:date;
  rdfs:comment "A person who assumes the role of mother to an asexual person; use only for individuals who self-identify as mothers."@en;
  skos:broader <https://homosaurus.org/v3/homoit0002348>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000421>;
  skos:inScheme <https://homosaurus.org/v3>;
