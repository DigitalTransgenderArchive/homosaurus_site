<https://homosaurus.org/v3/homoit0002040> a skos:Concept;
  dc:identifier "homoit0002040";
  dc:issued "2022-06-15"^^xsd:date;
  dc:modified "2022-12-13"^^xsd:date;
  rdfs:comment "A term used to describe the depiction of women in media and the arts as subjects with agency and whose perspective a text may be presented from. Often used in contrast to the male gaze."@en;
  skos:broader <https://homosaurus.org/v3/homoit0002039>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001365>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Female gaze"@en;
  skos:related <https://homosaurus.org/v3/homoit0002042> .

<https://homosaurus.org/v3/homoit0002041> a skos:Concept;
  dc:identifier "homoit0002041";
  dc:issued "2022-06-15"^^xsd:date;
  dc:modified "2022-12-13"^^xsd:date;
  rdfs:comment "A term used to describe the sexualized and objectified depiction of women in media and the arts from the perspective of and for the pleasure of the heterosexual man/male viewer. Originally used solely to describe the heterosexual, cisgender gaze but has since been expanded."@en;
  skos:broader <https://homosaurus.org/v3/homoit0002039>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001365>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Male gaze"@en;
  skos:related <https://homosaurus.org/v3/homoit0002042> .

<https://homosaurus.org/v3/homoit0002153> a skos:Concept;
  dc:identifier "homoit0002153";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2024-02-01"^^xsd:date;
  rdfs:comment "The trope in fiction that requires that LGBTQ+ characters die or meet some other type of unhappy ending. The trope is also known as \"dead lesbian syndrome\" due to the tendency for lesbian characters and bisexual female characters to be the targets. Transgender characters have also often been subjected to this trope."@en;
  skos:altLabel "Dead lesbian syndrome"@en;
  skos:broader <https://homosaurus.org/v3/homoit0002160>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Bury your gays"@en;
  skos:related <https://homosaurus.org/v3/homoit0000443> .

<https://homosaurus.org/v3/homoit0002168> a skos:Concept;
  dc:identifier "homoit0002168";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "Anthropomorphized animal versions of people. Fursonas, which are created by members of the furry fandom, are not necessarily animals with fur; they can also be reptiles, birds, or fictional animals, for example."@en;
  skos:broader <https://homosaurus.org/v3/homoit0002165>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Fursonas"@en;
  skos:related <https://homosaurus.org/v3/homoit0001241> .

<https://homosaurus.org/v3/homoit0002173> a skos:Concept;
  dc:identifier "homoit0002173";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "The fan community that focuses on, incorporates, or details the relationships of characters in hentai, or sexually explicit anime and manga."@en;
  skos:broader <https://homosaurus.org/v3/homoit0002144>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0002172>;
  skos:prefLabel "Hentai fandom"@en,
    "Hentai fandom"@ja .

<https://homosaurus.org/v3/homoit0002190> a skos:Concept;
  dc:identifier "homoit0002190";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2023-10-26"^^xsd:date;
  rdfs:comment "The participation and inclusion of people of color in fan communities."@en;
  skos:altLabel "BIPOC in fandom"@en;
  skos:broader <https://homosaurus.org/v3/homoit0002156>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "People of color in fandom"@en;
  skos:related <https://homosaurus.org/v3/homoit0001101> .

<https://homosaurus.org/v3/homoit0002198> a skos:Concept;
  dc:identifier "homoit0002198";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2024-02-01"^^xsd:date;
  rdfs:comment "Names used to describe common pairings in fandom. Ship names are often portmanteaus of the names of two (or more) characters in the ship (e.g., Spirk for Spock and Kirk)."@en;
  skos:altLabel "Pairing names in fandom"@en;
  skos:broader <https://homosaurus.org/v3/homoit0002199>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0002177>;
  skos:prefLabel "Ship names in fandom"@en .

<https://homosaurus.org/v3/homoit0002200> a skos:Concept;
  dc:identifier "homoit0002200";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "A genre of fanworks in which two or more characters of the same sex or gender are placed in sexual or romantic situations with one another. Slash fanworks are commonly erotic or pornographic. While the term \"slash\" has historically been used for male/male couples only, it has been recently been broadened to include LGBTQ+ relationships other than those between two men."@en;
  skos:broader <https://homosaurus.org/v3/homoit0002203>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0002162>;
  skos:prefLabel "Slash (Genre)"@en .

<https://homosaurus.org/v3/homoit0002209> a skos:Concept;
  dc:identifier "homoit0002209";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "Creating videos about sexual or romantic relationships between same-sex or -gender couples using scenes from television, movies, or video games. Historically used for male-male couples only, but is now used more broadly; includes femslash vidding."@en;
  skos:broader <https://homosaurus.org/v3/homoit0002204>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Slash vidding"@en;
  skos:related <https://homosaurus.org/v3/homoit0003662> .

<https://homosaurus.org/v3/homoit0002214> a skos:Concept;
  dc:identifier "homoit0002214";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2024-07-31"^^xsd:date;
  rdfs:comment "Term used in yaoi and yaoi fan communities to describe the receiving or submissive partner in a fictional male-male relationship."@en;
  skos:broader <https://homosaurus.org/v3/homoit0002217>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Uke (Yaoi)"@ja;
  skos:related <https://homosaurus.org/v3/homoit0002151>,
    <https://homosaurus.org/v3/homoit0002152> .

<https://homosaurus.org/v3/homoit0002216> a skos:Concept;
  dc:identifier "homoit0002216";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "The participation and inclusion of women in fan communities."@en;
  skos:broader <https://homosaurus.org/v3/homoit0002171>;
