<https://homosaurus.org/v3/homoit0002892> a skos:Concept;
  dc:identifier "homoit0002892";
  dc:issued "2023-06-28"^^xsd:date;
  dc:modified "2023-06-30"^^xsd:date;
  rdfs:comment "Asexual people who belong to one or more of the various Indigenous peoples of Australia; do not use to refer to the Indigenous people of the Torres Strait Islands, who are considered ethnically and culturally distinct. Only use to describe people who identify as Aboriginal Australian."@en;
  skos:altLabel "Aboriginal asexual people"@en,
    "Asexual Aboriginal Australian people"@en,
    "Asexual Aboriginal Australians"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000002>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000915>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Aboriginal Australian asexual people"@en .

<https://homosaurus.org/v3/homoit0002895> a skos:Concept;
  dc:identifier "homoit0002895";
  dc:issued "2023-06-29"^^xsd:date;
  dc:modified "2023-06-30"^^xsd:date;
  rdfs:comment "Asexual people who have experienced hate crimes and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."@en;
  skos:broader <https://homosaurus.org/v3/homoit0000613>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000915>;
  skos:inScheme <https://homosaurus.org/v3>;
