  skos:broader <https://homosaurus.org/v3/homoit0000256>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000421>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Lesbian children"@en;
  skos:related <https://homosaurus.org/v3/homoit0000743> .

<https://homosaurus.org/v3/homoit0002363> a skos:Concept;
  dc:identifier "homoit0002363";
  dc:issued "2022-12-13"^^xsd:date;
  dc:modified "2022-12-22"^^xsd:date;
  rdfs:comment "Gay people who have not yet reached the age of adolescence."@en;
  skos:altLabel "Gay kids"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000256>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000421>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Gay children"@en;
  skos:related <https://homosaurus.org/v3/homoit0000479> .

<https://homosaurus.org/v3/homoit0002374> a skos:Concept;
  dc:identifier "homoit0002374";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2024-05-24"^^xsd:date;
  rdfs:comment "A practice in which law enforcement agents or agents of the state coerce an LGBTQ+ person to commit a \"crime\" they would have otherwise been unlikely or unwilling to commit. Legal definitions of entrapment vary widely depending on the jurisdiction, but the term is often used colloquially to refer to police acting dishonestly or in bad faith, as well as policing focused on anticipating and inducing crime, rather than responding to reports of crime."@en;
  skos:broader <https://homosaurus.org/v3/homoit0001120>,
    <https://homosaurus.org/v3/homoit0002373>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000611>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Police entrapment of LGBTQ+ people"@en .

<https://homosaurus.org/v3/homoit0002380> a skos:Concept;
  dc:identifier "homoit0002380";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2023-06-30"^^xsd:date;
  rdfs:comment "Criminalization of acts considered to be sexual or romantic between individuals perceived as being of the same gender category in a given sociocultural context."@en;
  skos:altLabel "Criminalization of same-gender relations"@en,
    "Criminalization of same-sex relations"@en;
  skos:broader <https://homosaurus.org/v3/homoit0002379>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000702>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Criminalization of homosexuality"@en;
  skos:related <https://homosaurus.org/v3/homoit0001326> .

<https://homosaurus.org/v3/homoit0002382> a skos:Concept;
  dc:identifier "homoit0002382";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2024-05-24"^^xsd:date;
  rdfs:comment "Unexpected and unannounced entry into and searches of bathouses, saunas, or spas owned or frequented by LGBTQ+ people by law enforcement officers with the aim of using surprise to seize evidence or arrest suspects. Police raids may be undertaken legally using a search warrant or through exigent circumstances, such as probable cause, though the latter is highly subjective and civilians often have little resources to appeal illegal raids."@en;
  skos:broader <https://homosaurus.org/v3/homoit0002381>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000611>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Police raids on LGBTQ+ bathhouses"@en;
  skos:related <https://homosaurus.org/v3/homoit0000475> .

