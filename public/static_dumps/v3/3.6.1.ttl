<https://homosaurus.org/v3/homoit0001903> a skos:Concept;
  dc:identifier "homoit0001903";
  dc:issued "2022-03-29"^^xsd:date;
  dc:modified "2022-12-21"^^xsd:date;
  rdfs:comment "Term coined by coined by Trudy of the womanist blog Gradient Lair to describe the intersection of transphobia, misogyny, and anti-Black racism as directed toward Black trans women."@en;
