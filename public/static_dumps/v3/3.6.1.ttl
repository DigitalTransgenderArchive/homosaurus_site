<https://homosaurus.org/v3/homoit0001408> a skos:Concept;
  dc:identifier "homoit0001408";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2022-12-13"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/transgenderDayOfRemembrance>;
  rdfs:comment "International day of observance recognized annually on November 20 to honor the memory and lives of trans people who were murdered in the previous 12 months and to draw attention to the continued violence against trans people. Transgender Day of Remembrance (abbreviated TDoR) was founded in 1999 by a small group of trans people, including Gwendolyn Ann Smith, to memorialize Rita Hester, a trans woman murdered in Allston, Massachusetts."@en;
  skos:altLabel "TDOR"@en,
    "TDoR"@en,
    "Trans Day of Remembrance"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000901>;
