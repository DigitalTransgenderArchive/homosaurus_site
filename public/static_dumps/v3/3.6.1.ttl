  skos:narrower <https://homosaurus.org/v3/homoit0002923>,
    <https://homosaurus.org/v3/homoit0002924>,
    <https://homosaurus.org/v3/homoit0002925>,
    <https://homosaurus.org/v3/homoit0002926>,
    <https://homosaurus.org/v3/homoit0002927>;
  skos:prefLabel "Indigenous asexual people"@en .

<https://homosaurus.org/v3/homoit0003082> a skos:Concept;
  dc:identifier "homoit0003082";
