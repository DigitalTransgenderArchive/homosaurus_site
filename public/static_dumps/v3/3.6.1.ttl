<https://homosaurus.org/v3/homoit0002222> a skos:Concept;
  dc:identifier "homoit0002222";
  dc:issued "2022-07-19"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "Non-binary people who have not yet reached the age of adolescence."@en;
  skos:altLabel "Non-binary kids"@en,
