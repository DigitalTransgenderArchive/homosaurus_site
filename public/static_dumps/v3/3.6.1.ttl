    <https://homosaurus.org/v3/homoit0002395>;
  skos:prefLabel "Police violence toward LGBTQ+ people "@en .

<https://homosaurus.org/v3/homoit0002397> a skos:Concept;
  dc:identifier "homoit0002397";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2024-05-24"^^xsd:date;
