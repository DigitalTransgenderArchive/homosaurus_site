  dc:identifier "homoit0003613";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-01-26"^^xsd:date;
  rdfs:comment "Term used to describe the ways in which women experience and express themselves sexually, including the types of people and practices they are sexually interested in."@en;
