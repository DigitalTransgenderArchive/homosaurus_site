<https://homosaurus.org/v3/homoit0003510> a skos:Concept;
  dc:identifier "homoit0003510";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2024-08-01"^^xsd:date;
  rdfs:comment "Laws or policies instituted to prevent trans and non-binary individuals from participating in gendered sports leagues or competitions, typically to force players to compete as their sex assigned at birth rather than as their gender. This ranges from criminalizing schools and programs that allow trans and non-binary youth participation to banning players, particularly trans women, from competing in gendered leagues or competitions."@en;
  skos:altLabel "Sport bans"@en;
  skos:broader <https://homosaurus.org/v3/homoit0003499>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000702>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Sports bans"@en;
  skos:related <https://homosaurus.org/v3/homoit0001933> .

