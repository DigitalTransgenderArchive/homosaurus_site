<https://homosaurus.org/v3/homoit0002918> a skos:Concept;
  dc:identifier "homoit0002918";
  dc:issued "2023-06-30"^^xsd:date;
  dc:modified "2023-06-30"^^xsd:date;
  rdfs:comment "Serialized print or digital periodicals created by or for intersex people, often with the purpose of sharing news and information related to intersex communities and intersex issues."@en;
