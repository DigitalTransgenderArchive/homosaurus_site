<https://homosaurus.org/v3/homoit0002865> a skos:Concept;
  dc:identifier "homoit0002865";
  dc:issued "2023-06-28"^^xsd:date;
  dc:modified "2023-10-27"^^xsd:date;
  rdfs:comment "Mayer-Rokitansky-Küster-Hauser (MRKH) syndrome occurs when a person's Müllerian ducts, which typically become the uterus and upper portion of the vagina during fetal development, do not develop in the typical way. People with MRKH have XX chromosomes and are usually born with a vulva and either a vagina that is shorter than typical or no vagina. They usually do not have a cervix and may have a partial uterus (uterine remnant) or no uterus. They often do not mensturate but may experience cyclic pain if they have a uterine remnant with endometrial lining, and they can develop menstruation-related conditions like endometriosis."@en;
  skos:altLabel "MRKH syndrome "@en,
    "Müllerian agenesis"@en,
    "Müllerian duct anomalies"@en,
    "Müllerian duct variations"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000669>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001269>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0002880>,
    <https://homosaurus.org/v3/homoit0002882>;
  skos:prefLabel "Mayer-Rokitansky-Küster-Hauser syndrome"@en .

