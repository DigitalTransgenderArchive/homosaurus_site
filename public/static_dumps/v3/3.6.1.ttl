    <https://homosaurus.org/v3/homoit0002151>,
    <https://homosaurus.org/v3/homoit0002152> .

<https://homosaurus.org/v3/homoit0002201> a skos:Concept;
  dc:identifier "homoit0002201";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "Artwork depicting same-sex or same-gender couples that is usually erotic or pornographic in nature. Historically used for male-male couples only, but is now used more broadly; includes femslash art."@en;
  skos:broader <https://homosaurus.org/v3/homoit0002155>,
    <https://homosaurus.org/v3/homoit0002204>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Slash art"@en;
  skos:related <https://homosaurus.org/v3/homoit0000816> .

<https://homosaurus.org/v3/homoit0002207> a skos:Concept;
  dc:identifier "homoit0002207";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "The act of pretending to be and behaving as a character in a sexual or romantic relationship with another character of the same sex or gender, sometimes to generate ideas for fanworks. Typically erotic or pornographic in nature. Historically used for male-male couples only, but is now used more broadly; includes femslash roleplay."@en;
  skos:altLabel "Slash role play"@en;
  skos:broader <https://homosaurus.org/v3/homoit0002204>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Slash roleplay"@en;
  skos:related <https://homosaurus.org/v3/homoit0001241>,
    <https://homosaurus.org/v3/homoit0001242> .

<https://homosaurus.org/v3/homoit0002208> a skos:Concept;
  dc:identifier "homoit0002208";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2024-07-25"^^xsd:date;
  rdfs:comment "Slang relating to fanworks about sexual or romantic relationships between characters of the same sex or gender. Historically used for male-male couples only, but is now used more broadly; includes femslash terminology."@en;
  skos:altLabel "Slash terms"@en;
  skos:broader <https://homosaurus.org/v3/homoit0002158>,
    <https://homosaurus.org/v3/homoit0002203>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Slash terminology"@en;
  skos:related <https://homosaurus.org/v3/homoit0001317> .

<https://homosaurus.org/v3/homoit0002215> a skos:Concept;
  dc:identifier "homoit0002215";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "A content warning applied to fanworks to signal the depiction of people under the age of consent in sexual situations, either with other underage people or adults."@en;
