<https://homosaurus.org/v3/homoit0001901> a skos:Concept;
  dc:identifier "homoit0001901";
  dc:issued "2022-02-28"^^xsd:date;
  dc:modified "2022-12-13"^^xsd:date;
  rdfs:comment "The ability of a person who is not heterosexual to \"pass,\" or be accepted or regarded as heterosexual by others. \"Passing\" has historically been used to describe an individual's ability to \"pass\" as a certain race or ethnicity, though the term was later appropriated by the LGBTQ+ community."@en;
  skos:altLabel "Passing (Sexual identity)"@en,
    "Passing (Sexual orientation)"@en;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001901>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Passing (Sexuality)"@en;
  skos:related <https://homosaurus.org/v3/homoit0001090>,
    <https://homosaurus.org/v3/homoit0001295>,
    <https://homosaurus.org/v3/homoit0001306> .

