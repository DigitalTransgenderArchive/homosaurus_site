  dc:modified "2022-12-12"^^xsd:date;
  rdfs:comment "Treatment that involves the use of three or more drugs in combination to treat HIV infection by preventing the virus from making copies of itself in the body; can lessen the damage to the immune system caused by HIV, slow down the development of AIDS, and prevent the transmission of HIV to others."@en;
  skos:altLabel "Combination Anti-Retroviral Therapy"@en,
    "Combination Antiretroviral Therapy"@en,
    "HAART"@en,
    "Highly Active Anti-Retroviral Therapy"@en,
    "Highly Active Antiretroviral Therapy"@en,
    "cART"@en;
  skos:broader <https://homosaurus.org/v3/homoit0001007>;
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh2008003832>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001004>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "HAART (Highly Active Antiretroviral Therapy)"@en;
  skos:related <https://homosaurus.org/v3/homoit0000005> .

