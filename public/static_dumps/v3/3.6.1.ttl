    <https://homosaurus.org/v3/homoit0003244>;
  skos:prefLabel "Two-Spirit children"@en;
  skos:related <https://homosaurus.org/v3/homoit0000256> .

<https://homosaurus.org/v3/homoit0003359> a skos:Concept;
  dc:identifier "homoit0003359";
  dc:issued "2024-06-19"^^xsd:date;
  dc:modified "2024-08-01"^^xsd:date;
  rdfs:comment "Performances by a single drag performer or a group of drag performers, which often include singing or lip syncing, dance routines, and comedy skits."@en;
  skos:altLabel "Drag performances"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000861>;
