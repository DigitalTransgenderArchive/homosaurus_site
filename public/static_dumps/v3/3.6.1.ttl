<https://homosaurus.org/v3/homoit0003609> a skos:Concept;
  dc:identifier "homoit0003609";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-01-26"^^xsd:date;
  rdfs:comment "Religious services, or gatherings of people belonging to the same religious group or belief system, that are accepting and supportive of LGBTQ+ people and their identities. Includes services specifically intended for LGBTQ+ people within a denomination or sect that is otherwise not LGBTQ+-affirming."@en;
