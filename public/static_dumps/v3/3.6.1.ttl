<https://homosaurus.org/v3/homoit0003499> a skos:Concept;
  dc:identifier "homoit0003499";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2024-08-01"^^xsd:date;
  rdfs:comment "Efforts to propose, enact, amend, or strike down laws as a means of restricting the legal rights of transgender people. This includes legislation regarding access to gender-affirming healthcare, participation in sporting events, administrative and judicial procedures such as sex and name registration, and policies affecting the medical treatment, education, and mental health care of transgender youth."@en;
  skos:altLabel "Anti-trans law-making"@en,
    "Anti-trans legislation"@en,
    "Anti-transgender law-making"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000702>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000702>;
  skos:inScheme <https://homosaurus.org/v3>;
