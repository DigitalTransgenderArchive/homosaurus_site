  dc:issued "2024-01-02"^^xsd:date;
  dc:modified "2024-05-15"^^xsd:date;
  rdfs:comment "A variety of practices where someone in a dominant role sets rules for someone in a submissive role that they are expected to obey and the dominant administers punishments, corrections, or rewards."@en;
  skos:broader <https://homosaurus.org/v3/homoit0000442>,
    <https://homosaurus.org/v3/homoit0001267>,
