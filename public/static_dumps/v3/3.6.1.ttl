<https://homosaurus.org/v3/homoit0002584> a skos:Concept;
  dc:identifier "homoit0002584";
  dc:issued "2023-04-14"^^xsd:date;
  dc:modified "2024-07-25"^^xsd:date;
  rdfs:comment "People who have two or more LGBTQ+ parents or caregivers. Includes individuals born to or adopted by people in a heterosexual relationship who later came out as LGBTQ+, as well as individuals born to or adopted by LGBTQ+ people who came together to create their own families, such as lesbian couples who choose to conceive with friends who are gay men. For use in a Canadian and United States context."@en;
  skos:broader <https://homosaurus.org/v3/homoit0000260>,
    <https://homosaurus.org/v3/homoit0001317>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000421>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Bothies"@en;
  skos:related <https://homosaurus.org/v3/homoit0000420>,
    <https://homosaurus.org/v3/homoit0001075> .

<https://homosaurus.org/v3/homoit0002585> a skos:Concept;
  dc:identifier "homoit0002585";
  dc:issued "2023-04-14"^^xsd:date;
  dc:modified "2024-04-05"^^xsd:date;
  rdfs:comment "Term used to describe people who are LGBTQ+ and have at least one LGBTQ+ parent or caregiver."@en;
  skos:altLabel "Second generation (LGBTQ+ families)"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000260>,
    <https://homosaurus.org/v3/homoit0000915>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000421>;
  skos:inScheme <https://homosaurus.org/v3>;
