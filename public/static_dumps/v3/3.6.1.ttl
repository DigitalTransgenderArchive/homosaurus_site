<https://homosaurus.org/v3/homoit0002199> a skos:Concept;
  dc:identifier "homoit0002199";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2024-02-01"^^xsd:date;
  rdfs:comment "Term used to describe fans' desire to see certain characters in sexual or romantic relationships, as well as the practice of pairing those characters in fanworks. The terms \"shipping\" and \"ship\" come from \"relationship.\""@en;
