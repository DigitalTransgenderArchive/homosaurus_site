<https://homosaurus.org/v3/homoit0002854> a skos:Concept;
  dc:identifier "homoit0002854";
  dc:issued "2023-06-28"^^xsd:date;
  dc:modified "2023-06-30"^^xsd:date;
  rdfs:comment "Television shows featuring asexual characters or themes."@en;
  skos:broader <https://homosaurus.org/v3/homoit0001359>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001359>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Asexual television"@en .

<https://homosaurus.org/v3/homoit0002855> a skos:Concept;
  dc:identifier "homoit0002855";
  dc:issued "2023-06-28"^^xsd:date;
  dc:modified "2023-06-30"^^xsd:date;
  rdfs:comment "Asexual people who have experienced rape and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."@en;
  skos:broader <https://homosaurus.org/v3/homoit0000958>;
