<https://homosaurus.org/v3/homoit0002375> a skos:Concept;
  dc:identifier "homoit0002375";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2024-05-24"^^xsd:date;
  rdfs:comment "Any of various forms of inappropriate conduct, illegal actions, or abuses of power undertaken by law enforcement agents or agents of the state against LGBTQ+ members of the public. This includes but is not limited to racial, ethnic, and other forms of profiling; unwarranted surveillance, searches, and seizure; selective enforcement; excessive use of force; sexual misconduct; intimidation and witness tampering; falsification of evidence; coerced confessions; false arrests and imprisonment; and bribing or lobbying."@en;
  skos:altLabel " Mistreatment of LGBTQ+ people by police"@en,
    "Harassment of LGBTQ+ people by police"@en,
    "Police brutality toward LGBTQ+ people"@en,
    "Police misconduct toward LGBTQ+ people"@en,
    "Police mistreatment of LGBTQ+ people"@en;
  skos:broader <https://homosaurus.org/v3/homoit0001121>,
    <https://homosaurus.org/v3/homoit0002373>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000611>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0002376>,
    <https://homosaurus.org/v3/homoit0002377>;
  skos:prefLabel "Police harassment of LGBTQ+ people"@en .

<https://homosaurus.org/v3/homoit0002376> a skos:Concept;
  dc:identifier "homoit0002376";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2024-05-24"^^xsd:date;
  rdfs:comment "Any of various forms of inappropriate conduct, illegal actions, or abuses of power undertaken by law enforcement agents or agents of the state against Black LGBTQ+ members of the public. This includes but is not limited to racial, ethnic, and other forms of profiling; unwarranted surveillance, searches, and seizure; selective enforcement; excessive use of force; sexual misconduct; intimidation and witness tampering; falsification of evidence; coerced confessions; false arrests and imprisonment; and bribing or lobbying."@en;
  skos:broader <https://homosaurus.org/v3/homoit0002375>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000611>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Police harassment of Black LGBTQ+ people"@en;
  skos:related <https://homosaurus.org/v3/homoit0000208>,
    <https://homosaurus.org/v3/homoit0002257>,
    <https://homosaurus.org/v3/homoit0002397> .

