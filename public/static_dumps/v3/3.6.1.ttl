<https://homosaurus.org/v3/homoit0002286> a skos:Concept;
  dc:identifier "homoit0002286";
  dc:issued "2022-11-10"^^xsd:date;
  dc:modified "2024-01-31"^^xsd:date;
  rdfs:comment "Nigerian term that directly translates to \"feminine men\" but cannot be easily understood through Euro-American understandings of gender. The term has been used to describe people who may identify variously as feminine men, gay men, both male and female (or third gender), and/or trans. While some people self-identify as yan daudu, others consider the term a slur. Only use to describe individuals who self-identify as yan daudu."@en;
  skos:broader <https://homosaurus.org/v3/homoit0000322>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000560>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Yan daudu"@mzk .

<https://homosaurus.org/v3/homoit0002293> a skos:Concept;
  dc:identifier "homoit0002293";
  dc:issued "2022-11-10"^^xsd:date;
  dc:modified "2023-02-17"^^xsd:date;
  rdfs:comment "Gender-neutral term used to refer to the siblings or siblings-in-law of one's parents; an alternative to \"aunts\" or \"uncles.\""@en;
  skos:broader <https://homosaurus.org/v3/homoit0000421>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000421>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Piblings"@en .

<https://homosaurus.org/v3/homoit0002294> a skos:Concept;
  dc:identifier "homoit0002294";
  dc:issued "2022-11-10"^^xsd:date;
  dc:modified "2023-02-17"^^xsd:date;
  rdfs:comment "Gender-neutral term used to refer to the children of one's sibling; an alternative to \"nephews\" or \"nieces.\""@en;
  skos:broader <https://homosaurus.org/v3/homoit0000421>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000421>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Niblings"@en .

