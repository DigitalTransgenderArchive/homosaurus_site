<https://homosaurus.org/v3/homoit0003615> a skos:Concept;
  dc:identifier "homoit0003615";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-01-26"^^xsd:date;
  rdfs:comment "A school of ecology that seeks to understand nature, biology, and sexuality through the framing of queer theory. Queer ecology rejects the presumption of heterosexuality and cisgenderedness as natural, as well as notions of human exceptionalism and anthropocentrism."@en;
  skos:altLabel "Queer ecologies"@en;
  skos:broader <https://homosaurus.org/v3/homoit0001219>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001365>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Queer ecology"@en .

<https://homosaurus.org/v3/homoit0003616> a skos:Concept;
  dc:identifier "homoit0003616";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-01-26"^^xsd:date;
  rdfs:comment "A school of thought that rejects Eurocentric knowledge hierarchies and ways of being, including the presumed superiority of white Western culture."@en;
  skos:altLabel "Decoloniality"@en,
    "Decolonizing theory"@en,
    "Postcolonial theory"@en,
    "Postcolonialism"@en;
  skos:broader <https://homosaurus.org/v3/homoit0001365>;
  skos:closeMatch <http://id.loc.gov/authorities/subjects/sh97007835>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001365>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Decolonial theory"@en .

