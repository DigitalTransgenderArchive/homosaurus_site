<https://homosaurus.org/v3/homoit0002228> a skos:Concept;
  dc:identifier "homoit0002228";
  dc:issued "2022-07-19"^^xsd:date;
  dc:modified "2024-04-05"^^xsd:date;
  rdfs:comment "LGBTQ+ people intentionally refraining from substance use (typically drugs or alcohol). Follow the individual's preference for \"sobriety\" or \"recovery\" whenever possible."@en;
