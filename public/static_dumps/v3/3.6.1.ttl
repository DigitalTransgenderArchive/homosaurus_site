<https://homosaurus.org/v3/homoit0002259> a skos:Concept;
  dc:identifier "homoit0002259";
  dc:issued "2022-11-08"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "Language that avoids the use of gender-specific words, either to be inclusive of nonbinary, agender, and other gender diverse peoples, or to avoid gender bias."@en;
