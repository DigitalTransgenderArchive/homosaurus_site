  skos:related <https://homosaurus.org/v3/homoit0000367>,
    <https://homosaurus.org/v3/homoit0000369>,
    <https://homosaurus.org/v3/homoit0001906> .

<https://homosaurus.org/v3/homoit0003360> a skos:Concept;
  dc:identifier "homoit0003360";
  dc:issued "2024-06-19"^^xsd:date;
  dc:modified "2024-08-01"^^xsd:date;
  rdfs:comment "Events styled after traditional beauty pageants or contests in which contestants, typically drag queens, female impersonators, and trans women, compete in a range of categories to win a prize or title."@en;
  skos:broader <https://homosaurus.org/v3/homoit0000861>;
