  skos:related <https://homosaurus.org/v3/homoit0000020>,
    <https://homosaurus.org/v3/homoit0000302> .

<https://homosaurus.org/v3/homoit0002218> a skos:Concept;
  dc:identifier "homoit0002218";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2024-08-01"^^xsd:date;
  rdfs:comment "The fan community that focuses on, incorporates, or details the sexual or romantic relationships between male characters from anime and manga."@en;
