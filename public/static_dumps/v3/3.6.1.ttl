<https://homosaurus.org/v3/homoit0003193> a skos:Concept;
  dc:identifier "homoit0003193";
  dc:issued "2024-01-18"^^xsd:date;
  dc:modified "2024-02-18"^^xsd:date;
  rdfs:comment "A positive feeling connected to queer community, activism, and/or culture that counters the impact of living in a discriminatory society.  Note that queer is used as an umbrella term for the LGBTQ+ community within this phrase."@en;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0003193>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Queer joy"@en;
  skos:related <https://homosaurus.org/v3/homoit0001170>,
    <https://homosaurus.org/v3/homoit0002256>,
    <https://homosaurus.org/v3/homoit0003708> .

<https://homosaurus.org/v3/homoit0003229> a skos:Concept;
  dc:identifier "homoit0003229";
  dc:issued "2024-05-24"^^xsd:date;
  dc:modified "2024-08-01"^^xsd:date;
  rdfs:comment "Networks of polyamorous people who are connected by their or their partners' romantic and/or sexual relationships. Polycule members are not necessarily romantically and/or sexually involved with every member of the group. For example, Member A might be connected to Member B in that Member B is in a relationship with Member A's partner."@en;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0003229>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Polycules"@en;
  skos:related <https://homosaurus.org/v3/homoit0001636>,
    <https://homosaurus.org/v3/homoit0001660>,
    <https://homosaurus.org/v3/homoit0001663> .

