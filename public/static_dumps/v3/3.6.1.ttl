<https://homosaurus.org/v3/homoit0002853> a skos:Concept;
  dc:identifier "homoit0002853";
  dc:issued "2023-06-28"^^xsd:date;
  dc:modified "2023-06-30"^^xsd:date;
  rdfs:comment "Asexual people who have experienced and survived war; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."@en;
  skos:broader <https://homosaurus.org/v3/homoit0001352>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000915>;
  skos:inScheme <https://homosaurus.org/v3>;
