<https://homosaurus.org/v3/homoit0000646> a skos:Concept;
  dc:identifier "homoit0000646";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2024-03-13"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/homophobia>;
  rdfs:comment "Antagonism or disgust directed towards homosexuality as an identity or men who are perceived to be or are actually gay. Homophobia can include denial of the existence of homosexuality, stereotypes, verbal harassment, and physical violence. This term is often used colloquially to encompass all LGBTQ+ phobia."@en;
  skos:broader <https://homosaurus.org/v3/homoit0000920>;
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh88006552>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000920>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0000391>,
    <https://homosaurus.org/v3/homoit0002174>;
  skos:prefLabel "Homophobia"@en;
  skos:related <https://homosaurus.org/v3/homoit0000055>,
    <https://homosaurus.org/v3/homoit0000056>,
    <https://homosaurus.org/v3/homoit0000506>,
    <https://homosaurus.org/v3/homoit0000619> .

<https://homosaurus.org/v3/homoit0000656> a skos:Concept;
  dc:identifier "homoit0000656";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2022-12-13"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/hypersexuality>;
  rdfs:comment "Term used to describe a level or frequency of sexual desire that is perceived as excessive within a given culture. Though the medical community has not reached a consensus as to whether hypersexuality should be included as a clinical diagnosis, doctors and psychologists have historically diagnosed LGBTQ+ people with hypersexuality (or other related labels) in order to wrongly treat their identities and desires as medical disorders. Should only be used in a historical context or if an individual self-identifies with the term."@en;
  skos:altLabel "Nymphomania"@en,
    "Satyriasis"@en,
    "Andromania"@en,
    "Clitoromania"@en,
    "Don Juan syndrome"@en,
    "Don Juanism"@en,
    "Estromania"@en,
    "Excessive sex drive"@en,
    "Furor amatorius"@en,
    "Furor uterinus"@en,
    "Hyper-sexuality"@en,
    "Hyperactive sexual desire disorder"@en,
    "Hyperaesthesia"@en,
    "Hypereroticism"@en,
    "Hyperlibido"@en,
    "Hyperphilia"@en,
    "Hypersensuality"@en,
    "Hypersexual disorder"@en,
    "Messalina syndrome"@en,
    "Œstromania"@en,
    "Oversexuality"@en,
    "Satyrism"@en,
    "Satyromania"@en,
    "Sexual hyperesthesia"@en,
    "Sexual hyperversion"@en;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000656>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0001284>;
  skos:prefLabel "Hypersexuality"@en;
  skos:related <https://homosaurus.org/v3/homoit0001283>,
    <https://homosaurus.org/v3/homoit0001306>,
    <https://homosaurus.org/v3/homoit0001538> .

