<https://homosaurus.org/v3/homoit0003158> a skos:Concept;
  dc:identifier "homoit0003158";
  dc:issued "2024-01-02"^^xsd:date;
  dc:modified "2024-01-30"^^xsd:date;
  rdfs:comment "A transphobic and transantagonistic ideology that rejects trans and gender diverse identities and rights, and believes that recognition of these identities and rights constitutes discrimination and oppression towards cisgender women. Though originally considered a fringe offshoot of feminism, trans-exclusionary radical feminist groups have formed alliances with right-wing, far-right extremists, and anti-feminist organizations in order to spread misinformation and further anti-trans sentiment and legislation. "@en;
  skos:altLabel "Gender critical feminism"@en,
    "TERF ideology"@en,
    "Trans-exclusionary feminism"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000115>,
    <https://homosaurus.org/v3/homoit0000565>,
    <https://homosaurus.org/v3/homoit0001467>,
    <https://homosaurus.org/v3/homoit0001892>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001365>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Trans-exclusionary radical feminism"@en;
  skos:related <https://homosaurus.org/v3/homoit0000062>,
    <https://homosaurus.org/v3/homoit0000437>,
    <https://homosaurus.org/v3/homoit0001260>,
    <https://homosaurus.org/v3/homoit0001885>,
    <https://homosaurus.org/v3/homoit0003157>,
    <https://homosaurus.org/v3/homoit0003737> .

