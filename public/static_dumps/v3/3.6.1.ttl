  dc:modified "2024-01-18"^^xsd:date;
  rdfs:comment "Serialized print or digital publications about intersex issues (and typically produced by intersex people or intersex organizations) that contain news, articles, columns, correspondence, and advertisements."@en;
  skos:broader <https://homosaurus.org/v3/homoit0001042>;
