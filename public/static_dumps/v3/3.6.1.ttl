  dc:modified "2024-01-30"^^xsd:date;
  rdfs:comment "A person who subscribes to a transphobic and transantagonistic ideology that rejects trans and gender diverse identities and rights, and believes that recognition of these identities and rights constitutes discrimination and oppression towards cisgender women. Though originally considered a fringe offshoot of feminism, trans-exclusionary radical feminist groups have formed alliances with right-wing, far-right extremists, and anti-feminist organizations in order to spread misinformation and further anti-trans sentiment and legislation. Use when resources are about trans-exclusionary radical feminists or when an individual identifies as such. "@en;
  skos:altLabel "Gender critical feminists"@en,
    "TERFs"@en,
    "Trans-exclusionary feminist"@en;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0003157>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Trans-exclusionary radical feminists"@en;
  skos:related <https://homosaurus.org/v3/homoit0000437>,
    <https://homosaurus.org/v3/homoit0003158> .

