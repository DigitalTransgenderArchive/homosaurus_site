<https://homosaurus.org/v3/homoit0003172> a skos:Concept;
  dc:identifier "homoit0003172";
  dc:issued "2024-01-11"^^xsd:date;
  dc:modified "2024-01-30"^^xsd:date;
  rdfs:comment "A person who was part of a period of women's rights activism in the 19th and early 20th centuries that was primarily focused on legal rights such as women's right to vote. Use when resources are about first-wave feminists."@en;
  skos:altLabel "First wave feminists"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000439>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000439>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "First-wave feminists"@en;
  skos:related <https://homosaurus.org/v3/homoit0000444> .

<https://homosaurus.org/v3/homoit0003173> a skos:Concept;
  dc:identifier "homoit0003173";
  dc:issued "2024-01-11"^^xsd:date;
  dc:modified "2024-01-30"^^xsd:date;
  rdfs:comment "A person who was part of or subscribes to beliefs developed during a period of feminist political activity (also referred to as women’s liberation) beginning in the early 1960s that critiqued male-dominated institutions and cultural practices in society. Use when resources are about second-wave feminists or when an individual identifies as such."@en;
  skos:altLabel "Second wave feminists"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000439>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000439>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Second-wave feminists"@en;
  skos:related <https://homosaurus.org/v3/homoit0001260> .

<https://homosaurus.org/v3/homoit0003174> a skos:Concept;
  dc:identifier "homoit0003174";
  dc:issued "2024-01-11"^^xsd:date;
  dc:modified "2024-01-29"^^xsd:date;
  rdfs:comment "A person who was part of or subscribes to beliefs developed during a period of feminist political activity beginning in the early 1990s that embraced diversity and individualism in women and sought to redefine what it meant to be a feminist. The third-wave is characterized by the emergence of new feminist movements and theories such as intersectionality, sex positivity, ecofeminism, transfeminism, and postmodern feminism. Use when resources are about third-wave feminists or when an individual identifies as such."@en;
  skos:altLabel "Third wave feminists"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000439>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000439>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Third-wave feminists"@en;
  skos:related <https://homosaurus.org/v3/homoit0002275> .

<https://homosaurus.org/v3/homoit0003175> a skos:Concept;
  dc:identifier "homoit0003175";
  dc:issued "2024-01-11"^^xsd:date;
  dc:modified "2024-01-29"^^xsd:date;
  rdfs:comment "A person who is part of or subscribes to beliefs developed as part of a movement by and for trans woman who view the liberation of trans women as essential to the liberation of all women. Use when resources are about transfeminists or when an individual identifies as such."@en;
  skos:broader <https://homosaurus.org/v3/homoit0000439>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000439>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Transfeminists"@en;
  skos:related <https://homosaurus.org/v3/homoit0002274> .

<https://homosaurus.org/v3/homoit0003177> a skos:Concept;
  dc:identifier "homoit0003177";
  dc:issued "2024-01-11"^^xsd:date;
  dc:modified "2024-01-29"^^xsd:date;
  rdfs:comment "A person who subscribes to a perspective within feminism that calls for a radical reordering of society in which male supremacy is eliminated in all social and economic contexts. Distinct from and not to be confused with trans-exclusionary radical feminists. Use for resources about radical feminists or for individuals who identify as such, unless trans-exclusionary radical feminists is a more appropriate term."@en;
  skos:broader <https://homosaurus.org/v3/homoit0000439>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000439>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Radical feminists"@en;
  skos:related <https://homosaurus.org/v3/homoit0001230> .

