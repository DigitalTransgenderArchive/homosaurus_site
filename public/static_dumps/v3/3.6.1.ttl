<https://homosaurus.org/v3/homoit0002931> a skos:Concept;
  dc:identifier "homoit0002931";
  dc:issued "2023-06-30"^^xsd:date;
  dc:modified "2024-01-31"^^xsd:date;
  rdfs:comment "Groups of people who share the experience of being intersex."@en;
  skos:broader <https://homosaurus.org/v3/homoit0000297>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000297>;
