  skos:narrower <https://homosaurus.org/v3/homoit0002142>,
    <https://homosaurus.org/v3/homoit0002147>;
  skos:prefLabel "Real person fiction"@en .

<https://homosaurus.org/v3/homoit0002197> a skos:Concept;
  dc:identifier "homoit0002197";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2024-07-31"^^xsd:date;
  rdfs:comment "Term used in yaoi or yaoi fan communities to describe the giving or dominant partner in a fictional male-male relationship."@en;
  skos:broader <https://homosaurus.org/v3/homoit0002217>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
