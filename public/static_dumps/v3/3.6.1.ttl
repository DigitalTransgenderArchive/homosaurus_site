  dc:identifier "homoit0001982";
  dc:issued "2022-05-11"^^xsd:date;
  dc:modified "2022-12-13"^^xsd:date;
  rdfs:comment "Short amateur films or videos created primarily to preserve memories; use in reference to home movies created by or featuring LGBTQ+ people."@en;
  skos:altLabel "Home movies (LGBTQ)"@en,
