<https://homosaurus.org/v3/homoit0002907> a skos:Concept;
  dc:identifier "homoit0002907";
  dc:issued "2023-06-29"^^xsd:date;
  dc:modified "2023-06-30"^^xsd:date;
  rdfs:comment "People who assume the role of father to asexual people. Only use to describe individuals who identify as fathers."@en;
  skos:broader <https://homosaurus.org/v3/homoit0002342>;
