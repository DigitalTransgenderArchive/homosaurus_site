    "2S public officials"@en,
    "Two Spirited politicians"@en,
    "Two Spirited public officials"@en,
    "Two-Spirit public officials"@en,
    "Two-Spirited public officials"@en,
    "Two-Spiritied politicians"@en;
  skos:broader <https://homosaurus.org/v3/homoit0001480>;
