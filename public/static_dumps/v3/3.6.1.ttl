    "Pussy dusters"@en,
    "Womb brooms"@en;
  skos:broader <https://homosaurus.org/v3/homoit0002287>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001269>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Cookie dusters"@en;
  skos:related <https://homosaurus.org/v3/homoit0000779> .

<https://homosaurus.org/v3/homoit0002328> a skos:Concept;
  dc:identifier "homoit0002328";
  dc:issued "2022-11-15"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "Term that encompasses lesbian filmmaking, the lesbian film industry, and film as an art form within lesbian culture. For specific movies created by or representing lesbians, use the term \"Lesbian films.\""@en;
  skos:altLabel "Lesbian film"@en;
  skos:broader <https://homosaurus.org/v3/homoit0002327>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0002329>;
  skos:prefLabel "Lesbian cinema"@en .

<https://homosaurus.org/v3/homoit0002330> a skos:Concept;
  dc:identifier "homoit0002330";
  dc:issued "2022-11-15"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "Term that encompasses gay filmmaking, the gay film industry, and film as an art form within gay culture. For specific movies created by or representing gay men, use the term \"Gay films.\""@en;
  skos:altLabel "Gay film"@en;
  skos:broader <https://homosaurus.org/v3/homoit0002327>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0002331>;
  skos:prefLabel "Gay cinema"@en .

<https://homosaurus.org/v3/homoit0002333> a skos:Concept;
  dc:identifier "homoit0002333";
  dc:issued "2022-11-15"^^xsd:date;
  dc:modified "2023-02-24"^^xsd:date;
  rdfs:comment "LGBTQ+ people of native African ancestry living outside of the continent of Africa. While this term is commonly used to describe descendants of Africans who were enslaved and forcibly transported to the Americas via the transatlantic slave trade between the 16th and 19th centuries, it can also be used to refer to descendants of Africans who voluntarily immigrated to other parts of the world. Do not conflate with Black LGBTQ+ people or African American LGBTQ+ people. Follow the individual's preference whenever possible."@en;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0002333>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "LGBTQ+ people of the African diaspora"@en;
  skos:related <https://homosaurus.org/v3/homoit0000015> .

<https://homosaurus.org/v3/homoit0002356> a skos:Concept;
  dc:identifier "homoit0002356";
  dc:issued "2022-12-13"^^xsd:date;
  dc:modified "2024-04-05"^^xsd:date;
  rdfs:comment "LGBTQ+ people who are grandchildren."@en;
  skos:altLabel "Grandchildren (LGBTQ)"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000601>,
    <https://homosaurus.org/v3/homoit0000915>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000421>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "LGBTQ+ grandchildren"@en .

<https://homosaurus.org/v3/homoit0002360> a skos:Concept;
  dc:identifier "homoit0002360";
  dc:issued "2022-12-13"^^xsd:date;
  dc:modified "2024-04-05"^^xsd:date;
  rdfs:comment "Family members who are LGBTQ+."@en;
  skos:altLabel "Family members (LGBTQ)"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000421>,
    <https://homosaurus.org/v3/homoit0000915>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000421>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "LGBTQ+ family members"@en .

<https://homosaurus.org/v3/homoit0002362> a skos:Concept;
  dc:identifier "homoit0002362";
  dc:issued "2022-12-13"^^xsd:date;
  dc:modified "2022-12-22"^^xsd:date;
  rdfs:comment "Lesbians who have not yet reached the age of adolescence."@en;
