<https://homosaurus.org/v3/homoit0003512> a skos:Concept;
  dc:identifier "homoit0003512";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2024-08-01"^^xsd:date;
  rdfs:comment "Efforts to change the gender identity of a transgender or non-binary person to meet cisgender norms, typically under the belief that their identity is dangerous and/or the result of mental illness or trauma. The processes involved in conversion therapy include visualization training, spiritual interventions, and other aversion treatments. "@en;
  skos:altLabel "Conversion therapy for gender"@en,
    "Conversion therapy for trans people"@en,
    "Conversion therapy for transgender people"@en,
    "Gender reorientation therapy"@en,
    "Trans conversion therapy"@en,
    "Transgender conversion therapy"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000303>;
  skos:closeMatch <http://id.loc.gov/authorities/subjects/sh2006004076>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001004>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Gender conversion therapy"@en .

