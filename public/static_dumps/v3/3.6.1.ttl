    <https://homosaurus.org/v3/homoit0002570>,
    <https://homosaurus.org/v3/homoit0002571>;
  skos:prefLabel "Non-binary fiction"@en .

<https://homosaurus.org/v3/homoit0002577> a skos:Concept;
  dc:identifier "homoit0002577";
  dc:issued "2023-04-12"^^xsd:date;
  dc:modified "2023-06-30"^^xsd:date;
  rdfs:comment """A portmanteau of two reclaimed terms (queer and crip) used to indicate that a person or a thing belongs to both queer and crip communities, often used to indicate unity or shared struggles. This term may also appear as \"cripqueer\" to emphasize the crip identity before the queer one.				"""@en;
  skos:altLabel "Cripqueer"@en;
  skos:broader <https://homosaurus.org/v3/homoit0001559>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001317>;
