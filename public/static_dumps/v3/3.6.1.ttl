<https://homosaurus.org/v3/homoit0000406> a skos:Concept;
  dc:identifier "homoit0000406";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2024-06-19"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/escorts>;
  rdfs:comment "Sex workers whose clients are required to make appointments for their services. Unlike sex workers who solicit clients on the street or in institutions like brothels, escorts typically advertise their services online, whether independently or through agencies. Escorting may be less stigmatized than other forms of sex work, in part because it tends to be safer for escorts and because some escorts offer a broader range of services, including accompaniment or entertainment without the promise of sexual contact. However, the tendency to frame escorting as separate from or superior to other forms of sex work obscures the labor undertaken by escorts and perpetuates discrimination against the most marginalized and vulnerable sex workers."@en;
  skos:altLabel "Call boys"@en,
    "Call girls"@en;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0003758>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Escorts"@en;
  skos:related <https://homosaurus.org/v3/homoit0000405> .

