<https://homosaurus.org/v3/homoit0001232> a skos:Concept;
  dc:identifier "homoit0001232";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2024-08-01"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/rainbowFlags>;
  rdfs:comment "Rainbow-striped flags that symbolize LGBTQ+ pride and LGBTQ+ social movements. The first rainbow pride flag, which had eight colors, was created by Gilbert Baker, Lynn Segerblom, and others in San Francisco, California in 1978. Due to difficulties obtaining hot pink fabric and a desire for an even number of stripes, Baker modified his design in 1979 to contain six colors. The six-color version of the flag has been the most popular design since then."@en;
  skos:altLabel "Baker flags"@en;
  skos:broader <https://homosaurus.org/v3/homoit0003246>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000954>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Rainbow flags"@en .

