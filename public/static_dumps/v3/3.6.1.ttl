<https://homosaurus.org/v3/homoit0000303> a skos:Concept;
  dc:identifier "homoit0000303";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2024-08-01"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/sexualReorientation>;
  rdfs:comment "Efforts to change the sexual or gender identity of an individual who is or is suspected to be LGBTQ+ to meet heterosexual or cisgender norms, typically under the belief that being LGBTQ+ is dangerous and/or the result of mental illness or trauma. The processes involved in conversion therapy include visualization training, spiritual interventions, and other aversion treatments. "@en;
  skos:altLabel "Reparative therapy"@en,
    "Reorientation therapy"@en,
    "Sexual reorientation therapy"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000106>;
