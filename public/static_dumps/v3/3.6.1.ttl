<https://homosaurus.org/v3/homoit0002186> a skos:Concept;
  dc:identifier "homoit0002186";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2022-12-21"^^xsd:date;
  rdfs:comment "The alternate universe fanworks trope in which society is divided into three categories of people: alphas, betas, and omegas. Fanworks in the omegaverse often depict characters with genitalia and breeding behaviors (such as heat cycles) similar to wolves. Use to describe fanworks in the omegaverse that focus on LGBTQ+ people and issues."@en;
  skos:altLabel "A/B/O"@en,
    "ABO"@en,
    "Alpha/Beta/Omega"@en;
  skos:broader <https://homosaurus.org/v3/homoit0002143>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0002184>;
  skos:prefLabel "Omegaverse"@en;
  skos:related <https://homosaurus.org/v3/homoit0002176> .

<https://homosaurus.org/v3/homoit0002187> a skos:Concept;
  dc:identifier "homoit0002187";
  dc:issued "2022-07-04"^^xsd:date;
  dc:modified "2022-12-16"^^xsd:date;
  rdfs:comment "Slang term referring to a fan's primary \"ship\" or preferred relationship within a fandom."@en;
  skos:altLabel "OTP"@en;
