<https://homosaurus.org/v3/homoit0000064> a skos:Concept;
  dc:identifier "homoit0000064";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2024-01-30"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/aphallia>;
  rdfs:comment "People with aphallia have XY chromosomes, testes, and are born without a penis. They produce typical levels of testosterone, and they develop secondary sex characteristics associated with a typical testosterone puberty during adolescence."@en;
  skos:altLabel "Penile agenesis"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000669>;
