<https://homosaurus.org/v3/homoit0002377> a skos:Concept;
  dc:identifier "homoit0002377";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2024-05-24"^^xsd:date;
  rdfs:comment "Any of various forms of inappropriate conduct, illegal actions, or abuses of power undertaken by law enforcement agents or agents of the state against Indigenous LGBTQ+ members of the public. This includes but is not limited to racial, ethnic, and other forms of profiling; unwarranted surveillance, searches, and seizure; selective enforcement; excessive use of force; sexual misconduct; intimidation and witness tampering; falsification of evidence; coerced confessions; false arrests and imprisonment; and bribing or lobbying."@en;
  skos:broader <https://homosaurus.org/v3/homoit0002375>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000611>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Police harassment of Indigenous LGBTQ+ people"@en;
  skos:related <https://homosaurus.org/v3/homoit0000886>,
    <https://homosaurus.org/v3/homoit0002397> .

<https://homosaurus.org/v3/homoit0002379> a skos:Concept;
  dc:identifier "homoit0002379";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2023-06-30"^^xsd:date;
  rdfs:comment "Criminalization of existing or identifying as an LGBTQ+ person, being perceived as LGBTQ+, or engaging in any of various actions considered to be linked to LGBTQ+ status."@en;
  skos:altLabel "Criminalization of LGBTQ+ people"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000314>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000702>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0002380>;
  skos:prefLabel "LGBTQ+ criminalization"@en;
  skos:related <https://homosaurus.org/v3/homoit0000356> .

<https://homosaurus.org/v3/homoit0002386> a skos:Concept;
  dc:identifier "homoit0002386";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2023-06-30"^^xsd:date;
  rdfs:comment "Primarily Canadian and U.S. American movement wherein police officers were banned from LGBTQ+ pride events in some locations, due to historical and contemporary mistreatment of LGBTQ+ persons, especially Black and Indigenous LGBTQ+ persons. In recent years acted as a response to the 2010-2017 Toronto serial homicides and the mishandling of the investigation by the Toronto Police Service."@en;
  skos:altLabel "No Cops at Pride movement"@en,
    "No Cops at Pride"@en,
    "No Police at Pride movement"@en;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0002386>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "No Police at Pride"@en;
  skos:related <https://homosaurus.org/v3/homoit0003651>,
    <https://homosaurus.org/v3/homoit0003653> .

<https://homosaurus.org/v3/homoit0002388> a skos:Concept;
  dc:identifier "homoit0002388";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2024-01-30"^^xsd:date;
  rdfs:comment "Criminalization of any expression of gender considered to be nonconforming in a given sociocultural context."@en;
  skos:broader <https://homosaurus.org/v3/homoit0000314>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000702>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0002389>;
  skos:prefLabel "Criminalization of gender non-conformity"@en;
  skos:related <https://homosaurus.org/v3/homoit0001922> .

<https://homosaurus.org/v3/homoit0002390> a skos:Concept;
  dc:identifier "homoit0002390";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2024-05-24"^^xsd:date;
  rdfs:comment "Primarily a U.S. American and Canadian movement which supports divesting funds from, or abolition of, police departments (and often police structures generally) and reallocating them to non-policing forms of public safety and community support, such as social services, youth services, housing, education, healthcare and other community resources."@en;
  skos:altLabel "Defund the Police"@en,
    "Movement to defund police"@en;
  skos:broader <https://homosaurus.org/v3/homoit0001322>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001322>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Defund the police movement"@en;
  skos:related <https://homosaurus.org/v3/homoit0001119>,
    <https://homosaurus.org/v3/homoit0002391> .

<https://homosaurus.org/v3/homoit0002391> a skos:Concept;
  dc:identifier "homoit0002391";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2024-05-24"^^xsd:date;
  rdfs:comment "A primarily U.S. American and Canadian political movement that advocates replacing policing with other systems of public safety. Police abolitionists believe that policing, as a system, is inherently flawed and cannot be reformed—a view that rejects the ideology of police reformists. While reformists seek to address the ways in which policing occurs, abolitionists seek to transform policing altogether through a process of disbanding, disempowering, and disarming the police. Abolitionists argue that the institution of policing is deeply rooted in a history of white supremacy and settler colonialism and that it is inseparable from a pre-existing racial capitalist order, and thus believe a reformist approach to policing will always fail."@en;
  skos:altLabel "Abolishing the police movement"@en;
  skos:broader <https://homosaurus.org/v3/homoit0001322>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001322>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Police abolitionist movement"@en;
  skos:related <https://homosaurus.org/v3/homoit0001119>,
    <https://homosaurus.org/v3/homoit0002390> .

<https://homosaurus.org/v3/homoit0002392> a skos:Concept;
  dc:identifier "homoit0002392";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2024-01-30"^^xsd:date;
  rdfs:comment "Identification of LGBTQ+ people, or people believed to be LGBTQ+, by police using any of various tools and mechanisms, many of which are pseudoscientific in nature. Such data is then used to entrap and prosecute LGBTQ+ persons, especially in areas where being LGBTQ+ is still criminalized."@en;
  skos:broader <https://homosaurus.org/v3/homoit0002373>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0002373>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0002393>;
  skos:prefLabel "Identification of LGBTQ+ people by police"@en;
  skos:related <https://homosaurus.org/v3/homoit0001065> .

<https://homosaurus.org/v3/homoit0002393> a skos:Concept;
  dc:identifier "homoit0002393";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2024-01-30"^^xsd:date;
  rdfs:comment "Identification of LGBTQ+ people, or people believed to be LGBTQ+, by police using digital tools, such as phone records, mobile applications, facial identification algorithms, and artificial intelligence technologies. Such data is then used to entrap and prosecute LGBTQ+ persons, especially in areas where being LGBTQ+ is still criminalized."@en;
  skos:altLabel "Digital stop and search to identify LGBTQ+ people"@en,
    "Identification of LGBTQ+ people by police using phone data"@en,
    "Police use of digital tools to identify LGBTQ+ people"@en;
  skos:broader <https://homosaurus.org/v3/homoit0002392>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0002373>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Digital identification of LGBTQ+ people by police"@en;
  skos:related <https://homosaurus.org/v3/homoit0000846>,
    <https://homosaurus.org/v3/homoit0000847> .

<https://homosaurus.org/v3/homoit0002398> a skos:Concept;
  dc:identifier "homoit0002398";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2024-01-30"^^xsd:date;
  rdfs:comment "A primarily U.S. American and Canadian decentralized political and social movement advocating for non-violent civil disobedience in protest against incidents of police brutality and all racially motivated violence against Black people. The broader movement and its related organizations typically advocate against police violence towards Black people, as well as for various other policy changes considered to be related to Black liberation."@en;
  skos:altLabel "BLM"@en,
    "Black Lives Matter"@en,
    "BlackLivesMatter"@en,
    "Movement for Black Lives"@en;
  skos:broader <https://homosaurus.org/v3/homoit0001322>;
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh2016001442>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001322>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0002399>;
  skos:prefLabel "Black Lives Matter movement "@en;
  skos:related <https://homosaurus.org/v3/homoit0000208> .

<https://homosaurus.org/v3/homoit0002399> a skos:Concept;
  dc:identifier "homoit0002399";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2024-01-30"^^xsd:date;
  rdfs:comment "A part of the Black Lives Matter movement which specifically advocates for Black trans people (especially Black trans women) and fights for racial equity and Black liberation."@en;
  skos:altLabel "BTLM Movement"@en,
    "BTLM"@en;
  skos:broader <https://homosaurus.org/v3/homoit0002398>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001322>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Black Trans Lives Matter movement "@en;
  skos:related <https://homosaurus.org/v3/homoit0000208>,
    <https://homosaurus.org/v3/homoit0001396> .

