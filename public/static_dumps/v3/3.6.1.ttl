    <https://homosaurus.org/v3/homoit0000369>,
    <https://homosaurus.org/v3/homoit0001906> .

<https://homosaurus.org/v3/homoit0003367> a skos:Concept;
  dc:identifier "homoit0003367";
  dc:issued "2024-06-19"^^xsd:date;
  dc:modified "2024-08-01"^^xsd:date;
  rdfs:comment "An individual's right to make informed decisions about their own body without external influence or coercion."@en;
  skos:altLabel "Right to bodily autonomy"@en;
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh2022006327>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0003367>;
  skos:inScheme <https://homosaurus.org/v3>;
