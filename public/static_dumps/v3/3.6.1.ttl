  skos:related <https://homosaurus.org/v3/homoit0003366>,
    <https://homosaurus.org/v3/homoit0003369>,
    <https://homosaurus.org/v3/homoit0003593> .

<https://homosaurus.org/v3/homoit0003444> a skos:Concept;
  dc:identifier "homoit0003444";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2024-08-01"^^xsd:date;
  rdfs:comment "A term used in gender studies and feminist writing to describe a setting or culture in which sexual violence is pervasive and normalized due to attitudes about gender and sexuality."@en;
  skos:altLabel "Rape-supportive culture"@en;
  skos:broader <https://homosaurus.org/v3/homoit0002039>;
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh2019103596>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001365>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Rape culture"@en;
  skos:related <https://homosaurus.org/v3/homoit0000306>,
    <https://homosaurus.org/v3/homoit0001285>,
    <https://homosaurus.org/v3/homoit0001305> .

<https://homosaurus.org/v3/homoit0003445> a skos:Concept;
  dc:identifier "homoit0003445";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2024-08-01"^^xsd:date;
  rdfs:comment "A term used to describe the phenomena of heterosexual or hetero-presenting individuals expressing curiosity about exploring sexual relationships or experiences with other people of the same gender."@en;
  skos:altLabel "Bi-curiosity"@en,
    "Bi-curious"@en,
    "Bicurious"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000204>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001298>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Bicuriosity"@en;
  skos:related <https://homosaurus.org/v3/homoit0000620>,
    <https://homosaurus.org/v3/homoit0000631>,
    <https://homosaurus.org/v3/homoit0003509> .

<https://homosaurus.org/v3/homoit0003487> a skos:Concept;
  dc:identifier "homoit0003487";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2024-08-01"^^xsd:date;
  rdfs:comment "Two Spirit youth between the ages of 12-18 who have experienced bullying due to their gender or sexual identity and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."@en;
  skos:altLabel "2S youth victims of bullying"@en,
    "Two Spirited youth victims of bullying"@en,
    "Two-Spirit youth victims of bullying"@en,
    "Two-Spirited youth victims of bullying"@en;
  skos:broader <https://homosaurus.org/v3/homoit0001997>,
    <https://homosaurus.org/v3/homoit0002711>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000560>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Two-Spirit youth victims of bullying"@en;
  skos:related <https://homosaurus.org/v3/homoit0001989>,
    <https://homosaurus.org/v3/homoit0003474> .

<https://homosaurus.org/v3/homoit0003502> a skos:Concept;
  dc:identifier "homoit0003502";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2024-08-01"^^xsd:date;
  rdfs:comment "Laws or policies instituted that prevent trans and non-binary youth and children from seeking and/or obtaining medical treatment or gender-affirming care, including but not limited to surgery, hormone treatment, and mental health care. "@en;
  skos:broader <https://homosaurus.org/v3/homoit0003499>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000702>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Transgender health care bans for children and youth"@en;
  skos:related <https://homosaurus.org/v3/homoit0001400>,
    <https://homosaurus.org/v3/homoit0001452>,
    <https://homosaurus.org/v3/homoit0003514> .

<https://homosaurus.org/v3/homoit0003503> a skos:Concept;
  dc:identifier "homoit0003503";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2024-08-01"^^xsd:date;
  rdfs:comment "Laws or policies instituted to prevent trans and non-binary people from changing the gender marker on their birth certificate, driver's license, passport, or other legal documents."@en;
  skos:altLabel "Legal documents change ban"@en;
  skos:broader <https://homosaurus.org/v3/homoit0003499>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000702>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Gender marker change bans"@en;
  skos:related <https://homosaurus.org/v3/homoit0000247>,
    <https://homosaurus.org/v3/homoit0000573>,
    <https://homosaurus.org/v3/homoit0000711> .

<https://homosaurus.org/v3/homoit0003507> a skos:Concept;
  dc:identifier "homoit0003507";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2024-08-01"^^xsd:date;
  rdfs:comment "A genre focusing on the romantic or sexual relationships between female characters in anime, dramas, comics, novels, and movies. The term is usually used to describe media originating from Asia."@en;
  skos:altLabel "GL (Genre)"@en;
  skos:broader <https://homosaurus.org/v3/homoit0002144>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001345>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0002221>,
    <https://homosaurus.org/v3/homoit0003508>;
  skos:prefLabel "Girls’ Love (Genre)"@en;
  skos:related <https://homosaurus.org/v3/homoit0000742> .

<https://homosaurus.org/v3/homoit0003514> a skos:Concept;
  dc:identifier "homoit0003514";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2024-08-01"^^xsd:date;
  rdfs:comment "Organized measures taken for the maintenance or improvement of health via the prevention, diagnosis, and/or treatment of physical and mental health issues faced by transgender children and youth. This includes but is not limited to access to safe, legal therapy and counseling, hormone treatment, and gender-affirming surgery."@en;
  skos:altLabel "Health care for trans children and youth"@en,
    "Trans health care for children and youth"@en,
    "Transgender health care for children and youth"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000614>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000614>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Health care for transgender children and youth"@en;
  skos:related <https://homosaurus.org/v3/homoit0001400>,
    <https://homosaurus.org/v3/homoit0001452>,
    <https://homosaurus.org/v3/homoit0003502> .

<https://homosaurus.org/v3/homoit0003519> a skos:Concept;
  dc:identifier "homoit0003519";
  dc:issued "2024-07-31"^^xsd:date;
  dc:modified "2024-08-01"^^xsd:date;
  rdfs:comment "A cultural system in which positions of dominance and privilege are held by men, while women and other gender minorities are largely excluded from access to power."@en;
  skos:altLabel "Andocracy"@en;
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85098727>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0003519>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Patriarchy"@en;
  skos:related <https://homosaurus.org/v3/homoit0000115>,
    <https://homosaurus.org/v3/homoit0000565>,
    <https://homosaurus.org/v3/homoit0001278> .

<https://homosaurus.org/v3/homoit0003593> a skos:Concept;
  dc:identifier "homoit0003593";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-01-26"^^xsd:date;
  rdfs:comment "Organized efforts to secure reproductive rights, including the legal, social, and ethical principles of freedom around reproductive healthcare and decision-making."@en;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0003593>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Reproductive justice"@en;
  skos:related <https://homosaurus.org/v3/homoit0003369>,
    <https://homosaurus.org/v3/homoit0003361>,
    <https://homosaurus.org/v3/homoit0003367> .

<https://homosaurus.org/v3/homoit0003607> a skos:Concept;
  dc:identifier "homoit0003607";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-01-26"^^xsd:date;
  rdfs:comment "Organized public or social occasions for women."@en;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0003607>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0001515>;
  skos:prefLabel "Women's events"@en;
  skos:related <https://homosaurus.org/v3/homoit0000861> .

<https://homosaurus.org/v3/homoit0003619> a skos:Concept;
  dc:identifier "homoit0003619";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-01-26"^^xsd:date;
  rdfs:comment "Two-Spirit people whose profession involves managing information by collecting, organizing, storing and disseminating it. This can include but is not limited to librarians, archivists, metadata and IT workers, web developers, and chief information officers. Use more specific terms when possible."@en;
  skos:altLabel "Two Spirit information professionals"@en,
    "Two-Spirited information professionals"@en,
    "Two Spirited information professionals"@en,
    "2s information professionals"@en;
  skos:broader <https://homosaurus.org/v3/homoit0001480>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000560>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0003556>,
    <https://homosaurus.org/v3/homoit0003627>;
  skos:prefLabel "Two-Spirit information professionals"@en;
  skos:related <https://homosaurus.org/v3/homoit0003617> .

<https://homosaurus.org/v3/homoit0003654> a skos:Concept;
  dc:identifier "homoit0003654";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-01-26"^^xsd:date;
  rdfs:comment "A period of public recognition and celebration of LGBTQ+ people and culture, usually organized over the course of a month with local events, parades, marches, and rallies. Pride occurs at different times during the year in different places but is typically held in June in the United States to commemorate the Stonewall uprising."@en;
  skos:altLabel "LGBTQ+ Pride Month"@en;
  skos:broader <https://homosaurus.org/v3/homoit0003653>,
    <https://homosaurus.org/v3/homoit0003651>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0003653>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0000523>;
  skos:prefLabel "Pride Month"@en;
  skos:related <https://homosaurus.org/v3/homoit0003656> .

<https://homosaurus.org/v3/homoit0003657> a skos:Concept;
  dc:identifier "homoit0003657";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-01-26"^^xsd:date;
  rdfs:comment "Social, psychological, behavioral, and medical interventions designed to support and affirm an individual's gender identity. Gender-affirming care includes but is not limited to equal access to health care facilities, counseling, puberty blockers, hormone therapy, and gender-affirming surgeries. It can also include resources to aid in social transition, such as affirming policies regarding name and pronoun changes, access to non-gendered restrooms and facilities, etc."@en;
  skos:altLabel "Gender affirming care"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000614>;
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh2023000451>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000614>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:narrower <https://homosaurus.org/v3/homoit0000561>,
    <https://homosaurus.org/v3/homoit0003658>,
    <https://homosaurus.org/v3/homoit0003659>;
  skos:prefLabel "Gender-affirming care"@en .

<https://homosaurus.org/v3/homoit0003692> a skos:Concept;
  dc:identifier "homoit0003692";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-01-26"^^xsd:date;
  rdfs:comment "A discriminatory practice in which financial services are withheld from neighborhoods that have significant numbers of racial and ethnic minorities. Redlining includes but is not limited to denial of credit, insurance, and healthcare; inflated mortgage and interest rates; and the development of food deserts. The term has its roots in the New Deal when color-coded maps were made of metropolitan areas in the United States to indicate where it was considered safe to insure mortgages. Black neighborhoods and surrounding areas were colored red to indicate mortgages should not be insured there."@en;
  skos:altLabel "Red lining"@en,
    "Credit card redlining"@en;
  skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85038399>,
    <http://id.loc.gov/authorities/subjects/sh85038383>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0003692>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Redlining"@en;
  skos:related <https://homosaurus.org/v3/homoit0002257>,
    <https://homosaurus.org/v3/homoit0002038>,
    <https://homosaurus.org/v3/homoit0003691> .

<https://homosaurus.org/v3/homoit0003693> a skos:Concept;
  dc:identifier "homoit0003693";
  dc:issued "2024-10-22"^^xsd:date;
  dc:modified "2025-01-26"^^xsd:date;
  rdfs:comment "Public spaces designated as safe for, or accepting and affirming of, LGBTQ+ people, often by allies. LGBTQ+ safe spaces are sometimes identified through the display of stickers or placards."@en;
  skos:altLabel "Safe spaces (LGBTQ)"@en,
    "Safe places (LGBTQ)"@en,
    "LGBTQ+ safe places"@en,
    "LGBTQ+ safe zones"@en,
    "Safe zones (LGBTQ)"@en;
  skos:broader <https://homosaurus.org/v3/homoit0003699>;
  skos:closeMatch <http://id.loc.gov/authorities/subjects/sh2023000011>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000900>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "LGBTQ+ safe spaces"@en;
  skos:related <https://homosaurus.org/v3/homoit0000038>,
    <https://homosaurus.org/v3/homoit0000538>,
    <https://homosaurus.org/v3/homoit0000873> .

<https://homosaurus.org/v3/homoit0003695> a skos:Concept;
  dc:identifier "homoit0003695";
  dc:issued "2024-10-23"^^xsd:date;
  dc:modified "2025-01-26"^^xsd:date;
  rdfs:comment "Efforts to improve the welfare of LGBTQ+ people and communities, especially by the donation of money or resources to charitable causes."@en;
  skos:altLabel "Philanthropy (LGBTQ)"@en,
