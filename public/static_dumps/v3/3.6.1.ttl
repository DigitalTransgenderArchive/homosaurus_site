<https://homosaurus.org/v3/homoit0000394> a skos:Concept;
  dc:identifier "homoit0000394";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2022-12-13"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/electroshockTherapy>;
  rdfs:comment "A form of psychiatric treatment for major depression, bipolar depression, and other mental health conditions that usually consists of brief electrical pulses to the brain through electrodes on the head that induce controlled seizures. Electroshock therapy has historically been used as an attempt to \"cure\" homosexuality and other non-normative sexualities and sexual practices."@en;
  skos:altLabel "Electric shock therapy"@en,
    "Electroconvulsive therapy"@en;
  skos:broader <https://homosaurus.org/v3/homoit0001366>;
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85041999>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001004>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Electroshock therapy"@en;
  skos:related <https://homosaurus.org/v3/homoit0000349> .

<https://homosaurus.org/v3/homoit0000405> a skos:Concept;
  dc:identifier "homoit0000405";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2024-06-19"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/escortServices>;
  rdfs:comment "Agencies that serve to connect paying clients with escorts offering services by appointment. Escort services may be less stigmatized than other forms of sex work, in part because it tends to be safer for escorts and because some escorts offer a broader range of services, including accompaniment or entertainment without the promise of sexual contact. However, the tendency to frame escorting as separate from or superior to other forms of sex work obscures the labor undertaken by escorts and perpetuates discrimination against the most marginalized and vulnerable sex workers."@en;
  skos:broader <https://homosaurus.org/v3/homoit0001276>;
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85044807>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000011>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Escort services"@en;
  skos:related <https://homosaurus.org/v3/homoit0000406> .

