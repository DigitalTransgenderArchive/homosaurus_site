  skos:related <https://homosaurus.org/v3/homoit0000420>,
    <https://homosaurus.org/v3/homoit0000752> .

<https://homosaurus.org/v3/homoit0002588> a skos:Concept;
  dc:identifier "homoit0002588";
  dc:issued "2023-04-14"^^xsd:date;
  dc:modified "2023-06-30"^^xsd:date;
  rdfs:comment "Term used to describe the feeling shared by many people with queer parents or caregivers that they grew up immersed in queer culture, including queer traditions, celebrations, media, and language."@en;
  skos:broader <https://homosaurus.org/v3/homoit0001832>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001345>;
