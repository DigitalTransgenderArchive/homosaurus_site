<https://homosaurus.org/v3/homoit0001516> a skos:Concept;
  dc:identifier "homoit0001516";
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2023-03-13"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/womyn>;
  rdfs:comment "A spelling of \"woman\" or \"women\" that first appeared in print in 1976 and is used in certain feminist circles to avoid having the suffix of \"men.\"  Some contemporary transgender activists have criticized use of the word \"womyn\" due to its prevalence in trans-exclusionary radical feminist (TERF) circles following the exclusion of trans women from the Michigan Womyn’s Music Festival."@en;
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85147274>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0001516>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Womyn"@en;
  skos:related <https://homosaurus.org/v3/homoit0000062>,
    <https://homosaurus.org/v3/homoit0000437>,
    <https://homosaurus.org/v3/homoit0001230>,
    <https://homosaurus.org/v3/homoit0001505>,
    <https://homosaurus.org/v3/homoit0001509>,
    <https://homosaurus.org/v3/homoit0001515>,
    <https://homosaurus.org/v3/homoit0001819> .

<https://homosaurus.org/v3/homoit0001540> a skos:Concept;
  dc:identifier "homoit0001540";
  dc:issued "2020-06-03"^^xsd:date;
  dc:modified "2022-12-09"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/LGBTQAlcoholics>;
  rdfs:comment "LGBTQ+ people who have been diagnosed with or regard themselves as having an alcohol use disorder, a medical condition that involves a pattern of alcohol use that is difficult to control, negatively impacts the individual's life, and results in withdrawal symptoms upon cessation. Only use to refer to individuals who describe themselves as having an alcohol use disorder. Follow the individual's preference for \"use disorder\" or \"addiction\" whenever possible."@en;
  skos:altLabel "Alcoholics (LGBTQ)"@en,
    "LGBTQ+ alcoholics"@en;
  skos:broader <https://homosaurus.org/v3/homoit0000379>,
    <https://homosaurus.org/v3/homoit0001550>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000915>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "LGBTQ+ people with alcohol use disorders"@en;
  skos:related <https://homosaurus.org/v3/homoit0001549> .

