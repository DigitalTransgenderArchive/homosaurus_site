<https://homosaurus.org/v3/homoit0002383> a skos:Concept;
  dc:identifier "homoit0002383";
  dc:issued "2023-01-13"^^xsd:date;
  dc:modified "2024-05-24"^^xsd:date;
  rdfs:comment "Unexpected and unannounced entry into and searches of meeting places owned or frequented by LGBTQ+ people, including individuals' residences, businesses, and other institutions, by law enforcement officers with the aim of using surprise to seize evidence or arrest suspects. Police raids may be undertaken legally using a search warrant or through exigent circumstances, such as probable cause, though the latter is highly subjective and civilians often have little resources to appeal illegal raids."@en;
  skos:broader <https://homosaurus.org/v3/homoit0002381>;
  skos:hasTopConcept <https://homosaurus.org/v3/homoit0000611>;
  skos:inScheme <https://homosaurus.org/v3>;
  skos:prefLabel "Police raids on LGBTQ+ meeting places"@en .

