  dc:modified "2022-10-13"^^xsd:date;
  dc:replaces <http://homosaurus.org/v2/cheating>;
  rdfs:comment "A violation of a couple's assumed or stated contract regarding emotional and/or sexual exclusivity. Should not be used to refer to non-monogamy in general, as cheating is possible in both monogamous and non-monogamous relationships."@en;
