aurus.org/v2/femaleProstitutes","dc:identifier":"femaleProstitutes","skos:prefLabel":{"@language":"en","@value":"Female prostitutes"},"skos:broader":{"@id":"http://homosaurus.org/v2/sexWorkersLGBTQ"},"skos:related":{"@id":"http://homosaurus.org/v2/femaleProstitution"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85107622"},"skos:hasTopConcept":{"@id":"http://homosaurus.org/v2/sexWorkersLGBTQ"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000433"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2021-09-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"http://homosaurus.org/v2"}},{"@id":"http://homosaurus.org/v2/femaleProstitution","dc:identifier":"femaleProstitution","skos:prefLabel":{"@language":"en","@value":"Female prostitution"},"skos:broader":{"@id":"http://homosaurus.org/v2/prostitution"},"skos:related":{"@id":"http://homosaurus.org/v2/femaleProstitutes"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85107626"},"skos:hasTopConcept":{"@id":"http://homosaurus.org/v2/sexualPractices"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000434"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2021-09-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"http://homosaurus.org/v2"}},{"@id":"http://homosaurus.org/v2/MtFs","dc:identifier":"MtFs","skos:prefLabel":{"@language":"en","@value":"MtFs"},"skos:altLabel":[{"@language":"en","@value":"Males transitioning to females"},{"@language":"en","@value":"MtF transsexuals"},{"@language":"en","@value":"Male-to-female"},{"@language":"en","@value":"M2Fs"},{"@language":"en","@value":"Transsexual women"}],"rdfs:comment":{"@language":"en","@value":"MtF (male-to-female) is a mostly historical term that has been largely replaced by \"trans women.\" This is due in part to the term’s connection to the medicalisation of transgender people and its assumption that trans women are \"born\" male and become female (typically through hormones and/or surgery)."},"skos:broader":[{"@id":"http://homosaurus.org/v2/females"},{"@id":"http://homosaurus.org/v2/LGBTQHistoricalTerms"},{"@id":"http://homosaurus.org/v2/transsexualPeople"},{"@id":"http://homosaurus.org/v2/transWomen"},{"@id":"http://homosaurus.org/v2/women"}],"skos:related":[{"@id":"http://homosaurus.org/v2/FtMs"},{"@id":"http://homosaurus.org/v2/ftxs"},{"@id":"http://homosaurus.org/v2/mtxs"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006002132"},"skos:hasTopConcept":{"@id":"http://homosaurus.org/v2/females"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000986"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2021-09-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"http://homosaurus.org/v2"}},{"@id":"http://homosaurus.org/v2/FtMs","dc:identifier":"FtMs","skos:prefLabel":{"@language":"en","@value":"FtMs"},"skos:altLabel":[{"@language":"en","@value":"Females transitioning to males"},{"@language":"en","@value":"FtM transsexuals"},{"@language":"en","@value":"F2Ms"},{"@language":"en","@value":"Transsexual men"},{"@language":"en","@value":"Female-to-male"}],"rdfs:comment":{"@language":"en","@value":"FtM (female-to-male) is a mostly historical term which has been largely replaced by “trans men.” This is due in part to the term’s connection to medicalization of transgender persons and its assumption that a trans man was “female” and has become “male” (typically through hormones and/or surgery)"},"skos:broader":[{"@id":"http://homosaurus.org/v2/LGBTQHistoricalTerms"},{"@id":"http://homosaurus.org/v2/males"},{"@id":"http://homosaurus.org/v2/men"},{"@id":"http://homosaurus.org/v2/transMen"},{"@id":"http://homosaurus.org/v2/transsexualPeople"}],"skos:related":[{"@id":"http://homosaurus.org/v2/FtMs"},{"@id":"http://homosaurus.org/v2/ftxs"},{"@id":"http://homosaurus.org/v2/MtFs"},{"@id":"http://homosaurus.o