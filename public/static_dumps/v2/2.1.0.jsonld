"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2021-09-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"http://homosaurus.org/v2"}},{"@id":"http://homosaurus.org/v2/kteuy","dc:identifier":"kteuy","skos:prefLabel":{"@language":"en","@value":"Kteuy"},"rdfs:comment":{"@language":"en","@value":"Cambodian term for third sex; can be considered outdated and offensive"},"skos:broader":[{"@id":"http://homosaurus.org/v2/nonEuroAmericanGenderAndSexualIdentities"},{"@id":"http://homosaurus.org/v2/slurs"}],"skos:related":[{"@id":"http://homosaurus.org/v2/sakVeng"},{"@id":"http://homosaurus.org/v2/sreySros"}],"skos:hasTopConcept":{"@id":"http://homosaurus.org/v2/gender"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000695"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2021-09-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"http://homosaurus.org/v2"}},{"@id":"http://homosaurus.org/v2/lakinOn","dc:identifier":"lakinOn","skos:prefLabel":{"@language":"en","@value":"Lakin-on"},"rdfs:comment":{"@language":"en","@value":"Filipino term for women who are attracted to women and who take on male personas and cultural work"},"skos:broader":{"@id":"http://homosaurus.org/v2/nonEuroAmericanGenderAndSexualIdentities"},"skos:hasTopConcept":{"@id":"http://homosaurus.org/v2/gender"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0000697"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2021-09-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"http://homosaurus.org/v2"}},{"@id":"http://homosaurus.org/v2/lhamana","dc:identifier":"lhamana","skos:prefLabel":{"@language":"en","@value":"Lhamana"},"rdfs:comment":{"@language":"en","@value":"Native American Zuni people assigned male at birth who exhibit mixed gender traits"},"skos:broader":{"@id":"http://homosaurus.org/v2/nonEuroAmericanGenderAndSexualIdentities"},"s