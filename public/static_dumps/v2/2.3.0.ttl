    "F2Ms"@en,
    "Transsexual men"@en,
    "Female-to-male"@en;
  skos:broader <http://homosaurus.org/v2/LGBTQHistoricalTerms>,
    <http://homosaurus.org/v2/males>,
    <http://homosaurus.org/v2/men>,
    <http://homosaurus.org/v2/transMen>,
