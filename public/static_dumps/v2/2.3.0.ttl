    "MtF transsexuals"@en,
    "Male-to-female"@en,
    "M2Fs"@en,
    "Transsexual women"@en;
  skos:broader <http://homosaurus.org/v2/females>,
    <http://homosaurus.org/v2/LGBTQHistoricalTerms>,
    <http://homosaurus.org/v2/transsexualPeople>,
    <http://homosaurus.org/v2/transWomen>,
    <http://homosaurus.org/v2/women>;
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh2006002132>;
  skos:hasTopConcept <http://homosaurus.org/v2/females>;
  skos:inScheme <http://homosaurus.org/v2>;
  skos:prefLabel "MtFs"@en;
  skos:related <http://homosaurus.org/v2/FtMs>,
    <http://homosaurus.org/v2/ftxs>,
    <http://homosaurus.org/v2/mtxs> .

