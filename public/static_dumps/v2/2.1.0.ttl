  dc:modified "2021-09-24"^^xsd:date;
  rdfs:comment "MtF (male-to-female) is a mostly historical term that has been largely replaced by \"trans women.\" This is due in part to the term’s connection to the medicalisation of transgender people and its assumption that trans women are \"born\" male and become female (typically through hormones and/or surgery).";
  skos:altLabel "Males transitioning to females",
    "MtF transsexuals",
    "Male-to-female",
    "M2Fs",
    "Transsexual women";
  skos:broader "https://homosaurus.org/v2/females",
    "https://homosaurus.org/v2/LGBTQHistoricalTerms",
    "https://homosaurus.org/v2/transsexualPeople",
    "https://homosaurus.org/v2/[]",
    "https://homosaurus.org/v2/women";
  skos:changeNote "Version 2.1.0";
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh2006002132>;
  skos:hasTopConcept <http://homosaurus.org/v2/females>;
  skos:inScheme <http://homosaurus.org/v2>;
  skos:prefLabel "MtFs";
  skos:related "https://homosaurus.org/v2/FtMs",
