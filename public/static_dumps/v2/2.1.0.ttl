<http://homosaurus.org/v2/womyn> a skos:Concept;
  dc:identifier "womyn";
  dc:isReplacedBy <https://homosaurus.org/v3/homoit0001516>;
  dc:issued "2019-05-14"^^xsd:date;
  dc:modified "2021-09-24"^^xsd:date;
  rdfs:comment "A feminist spelling of “woman” or “women” first appearing in print in 1976. Note that some contemporary transgender activists have criticized use of the word  “womyn\" due to its prevalence in trans-exclusionary radical feminist (TERF) circles following the exclusion of trans women from the Michigan Womyn’s Music Festival. Based on an Older Scots spelling of woman.";
  skos:changeNote "Version 2.1.0";
  skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85147274>;
  skos:hasTopConcept <http://homosaurus.org/v2/womyn>;
