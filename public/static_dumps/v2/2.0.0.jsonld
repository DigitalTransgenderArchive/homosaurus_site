us.org/v3/homoit0001515"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2021-09-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"http://homosaurus.org/v2"},"skos:changeNote":"Version 2.0.0"},{"@id":"http://homosaurus.org/v2/womyn","dc:identifier":"womyn","skos:prefLabel":"Womyn","rdfs:comment":"A feminist spelling of “woman” or “women” first appearing in print in 1976. Note that some contemporary transgender activists have criticized use of the word  “womyn\" due to its prevalence in trans-exclusionary radical feminist (TERF) circles following the exclusion of trans women from the Michigan Womyn’s Music Festival. Based on an Older Scots spelling of woman.","skos:related":["https://homosaurus.org/v2/antiTransgenderDiscrimination","https://homosaurus.org/v2/feminism","https://homosaurus.org/v2/radicalFeminism","https://homosaurus.org/v2/wimmin","https://homosaurus.org/v2/women","https://homosaurus.org/v2/womensMusicFestivals"],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85147274"},"skos:hasTopConcept":{"@id":"http://homosaurus.org/v2/womyn"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001516"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2021-09-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"http://homosaurus.org/v2"},"skos:changeNote":"Version 2.0.0"},{"@id":"http://homosaurus.org/v2/xanith","dc:identifier":"xanith","skos:prefLabel":"Xanith","rdfs:comment":"Arabic word used in Oman for people who assigned male at birth who adopt feminine mannerisms and/or roles","skos:broader":"https://homosaurus.org/v2/culturallySpecificGenderIdentities","skos:hasTopConcept":{"@id":"http://homosaurus.org/v2/gender"},"dc:isReplacedBy":{"@id":"https://homosaurus.org/v3/homoit0001517"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2021-09-24"},"@type":"skos:Concept","skos:inScheme":{