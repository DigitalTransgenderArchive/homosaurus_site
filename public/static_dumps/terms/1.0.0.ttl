<https://homosaurus.org/terms/bullying> a skos:Concept;
  dc:identifier "bullying";
  dc:issued "2015-11-25"^^xsd:date;
  dc:modified "2015-11-25"^^xsd:date;
  rdfs:comment "a form of aggressive behaviour manifested by the use of force or coercion to affect others, particularly when the behaviour is habitual and involves an imbalance of power; it can include verbal harassment, physical assault or coercion and may be directed repeatedly towards particular victims, perhaps on grounds of race, religion, gender, sexuality, or ability";
  skos:broader <https://homosaurus.org/terms/aggression>;
  skos:changeNote "Version 1.0.0";
  skos:hasTopConcept <https://homosaurus.org/terms/aggression>;
