<%= form_tag(reveal_emails_path, :id => 'captcha_form', :class => 'form-horizontal') do %>
  <%= recaptcha_v3(action: 'about', site_key: Settings.recaptcha_site_key_v3) %>

<div id="about" class="col-sm-12 col-md-12">

  <% unless @errors.empty? %>
    <div id="error_explanation" class="alert alert-danger">
      <ul class="errors">
        <% @errors.each do |msg| %>
          <li style="font-size: 18px;"><%= msg %></li>
        <% end %>
        <% if  @show_captcha_v2 %>
          <li>
                <%= recaptcha_tags %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @reveal_emails %>
    <div id="error_explanation" class="alert alert-success">
      <ul class="errors">
          <li style="font-size: 18px;"><%= t("about_page.emails_revealed") %></li>
      </ul>
    </div>
    <% end %>

