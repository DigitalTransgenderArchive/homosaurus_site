<script>
  (function () {
    var memoriam = document.querySelector('.memoriam');
    var photo = memoriam.querySelector('img');
    var paragraphs = memoriam.querySelectorAll('p');
    var ratio = photo.getAttribute('width') / photo.getAttribute('height');
    var lastWidth = 0;
    function textHeight() {
      return paragraphs[1].getBoundingClientRect().bottom - paragraphs[0].getBoundingClientRect().top - parseFloat(getComputedStyle(photo).marginTop);
    }
    function fit(force) {
      if (!force && memoriam.clientWidth === lastWidth) return;
      lastWidth = memoriam.clientWidth;
      memoriam.classList.remove('memoriam-stacked');
      photo.style.width = '';
      if (getComputedStyle(memoriam).display !== 'grid') return;
      var width = photo.getBoundingClientRect().width;
      for (var i = 0; i < 12; i++) {
        var next = textHeight() * ratio;
        if (next > memoriam.clientWidth * 0.4) {
          photo.style.width = '';
          memoriam.classList.add('memoriam-stacked');
          return;
        }
        if (Math.abs(next - width) < 0.5) return;
        width = next;
        photo.style.width = width + 'px';
      }
    }
    fit(true);
    new ResizeObserver(function () { fit(false); }).observe(memoriam);
    document.fonts.ready.then(function () { fit(true); });
  })();
</script>
