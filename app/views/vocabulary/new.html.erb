<div class="term-form-page">
  <h1 class="page-title"><%= current_user.contributor? ? t('vocab.admin.new_term') : t('vocab.admin.suggest_term') %></h1>
  <div>
    <%= simple_form_for(@term, :url => vocabulary_term_create_path(vocab_id: @vocab_id), :as => :term) do |f| %>
      <div class="term-form-version">
	<label class="form-label" for="version_release">Version</label>
	<%= select_tag "version_release", options_for_select(VersionRelease.where(status: "Pending", vocabulary_identifier: @vocab_id).pluck(:release_identifier, :id), @release_id_num), class: "form-select", onchange: "window.location.href='#{request.original_url.split('new_term')[0] + 'new_term/'}' + $(this).find('option:selected').text()" %>
      </div>
      <%= render :partial => "form_id", :locals => {:f => f, :key=>:identifier} %>
      <%= render :partial => "form", locals: {f: f, vr_exists: @vr_exists} %>
      <div class="term-form-submit">
        <%= button_tag class: 'btn btn-primary term-form-save', id: "upload_submit", name: "update_descriptions", data: { disable_with: "Please wait..." }, disabled: (not @vr_exists) do %>
        <%= t('term.save_term') %>
        <% end %>
      </div>
      <% end %>
  </div>
</div>
