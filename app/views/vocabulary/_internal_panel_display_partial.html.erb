<%  if current_user.present? && (current_user.superuser? || current_user.contributor? || current_user.admin?) %>
  <%
    title ||= ''
    values ||= []
  %>
  <% if values[0].present? %>
    <div class="term-field term-field-internal">
      <dt><%= title.html_safe %></dt>
      <% values.each do |value| %>
        <dd><%= value %></dd>
      <% end %>
    </div>
  <% end %>
<% end %>
