<div class="history-page">
  <div class="page-title-row">
    <h1 class="page-title"><%= t('term.history') %>: <%= @homosaurus_obj.pref_label_localized.data %> <span class="title-id"><%= @homosaurus_obj.identifier %></span></h1>
    <%= button_to t('discussion.back_to_term'), vocabulary_show_path(vocab_id: @vocab_id, id: @homosaurus_obj.identifier), :method => "get", form_class: "btn p-0 page-title-action", class: 'btn btn-outline-secondary' %>
  </div>
  <% if @homosaurus_obj.visibility == "deleted" %>
    <div class="alert alert-danger" role="alert">
      This term has been removed from the vocabulary and is no longer in use.<br />
      Apologies for the inconvenience.
    </div>
  <% elsif @homosaurus_obj.visibility == "pending" %>
    <div class="alert alert-danger" role="alert">
      This term is a pending object set to be in the next release.
    </div>
  <% end %>
  <% relations = Relation.all.to_a %>
  <div class="history-cards">
    <% @edit_requests.each do |er| %>
      <%= render partial: "partials/edit_request_partial", locals: {edit_request: er, relations: relations} %>
    <% end %>
  </div>
</div>
