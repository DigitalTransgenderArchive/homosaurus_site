<%
  values ||= []
  inline ||= false
%>
<% if values[0].present? %>
  <%
    groups = values.group_by { |value| value[0] }.each_with_index
                   .sort_by { |(code, _), index| [code.to_s == I18n.locale.to_s ? 0 : 1, index] }
                   .map(&:first)
  %>
  <div class="term-field">
    <dt><a href="<%= Relation.find_by(id: rel_id).description_url %>"><%= t("relations.#{rel_id}") %></a></dt>
    <% groups.each do |code, group| %>
      <% language = code.nil? ? nil : Language.find_by(id: code) %>
      <dd<% if language %> class="term-lang-group"<% end %>>
        <% if language %><span class="term-lang"><%= language.supported ? I18n.translate("languages.#{code}") : language.name %></span><% end %>
        <ul class="term-values<%= ' term-values-inline' if inline %>"<% if code.present? %> lang="<%= code %>"<% end %>>
          <% group.each do |value| %>
            <li><%= value[1] %></li>
          <% end %>
        </ul>
      </dd>
    <% end %>
  </div>
<% end %>
