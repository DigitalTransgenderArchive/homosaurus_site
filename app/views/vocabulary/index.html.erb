<h1><%= t("vocab.label") %></h1>
<% if current_user.present? && current_user.contributor? && (request.original_url.include?('/v3') || request.original_url.include?('/v4') || request.original_url.include?('/v5')) %>
  <h4><%= t("vocab.admin.actions") %></h4>
  <%= button_to t("vocab.admin.new_term"), vocabulary_term_new_path(vocab_id: @vocab_identifier), :method => "get", class: 'btn btn-primary', style:"float:left;" %>
  <%= button_to t("vocab.admin.show_visible"), vocabulary_index_path(vocab_id: @vocab_identifier), :method => "get", class: 'btn btn-primary', style:"float:left; margin-left:20px;", params: { display_mode: "visible" } %>
  <%= button_to t("vocab.admin.show_next"), vocabulary_index_path(vocab_id: @vocab_identifier), :method => "get", class: 'btn btn-primary', style:"float:left; margin-left:20px;", params: { display_mode: "pending" } %>
  <%= button_to t("vocab.admin.show_deleted"), vocabulary_index_path(vocab_id: @vocab_identifier), :method => "get", class: 'btn btn-primary', style:"float:left; margin-left:20px;", params: { display_mode: "deleted" } %>
  <%= button_to t("vocab.admin.show_redirects"), vocabulary_index_path(vocab_id: @vocab_identifier), :method => "get", class: 'btn btn-primary', style:"float:left; margin-left:20px;", params: { display_mode: "redirect" }  %>
  <div style="clear:both"></div>
<% end %>

<h4><%= t("download.formats") %></h4>
<ul>
  <li><%= link_to "N-Triples", request.original_url.split('?').first + '.nt'  %></li>
  <li><%= link_to "JSON-LD", request.original_url.split('?').first + '.jsonld' %></li>
  <li><%= link_to "TTL", request.original_url.split('?').first + '.ttl' %></li>
  <li><%= link_to "XML", request.original_url.split('?').first + '.xml' %></li>
</ul>

<h4><%= t("download.graphical_views") %></h4>
<% if !request.original_url.include? '/v2' and !request.original_url.include? '/terms' %>
  <ul>
    <li><%= link_to t("download.tree_view"), tree_path %></li>
    <li><%= link_to t("download.indented_view"), indented_tree_path %></li>
  </ul>
<% end %>

<h4><%= t("vocab.current_terms") %></h4>
<ul>
  <% @terms.each do |term| %>
      <li>
        <% label = @pref_label_for[term.id].presence %>
        <% if label.blank? %>
          <%= link_to "(EMPTY)", vocabulary_show_path(vocab_id: @vocab_identifier, :id => term.identifier) %>
        <% else %>
          <%= link_to label, vocabulary_show_path(vocab_id: @vocab_identifier, :id => term.identifier) %>
        <% end %>
	<% if current_user.present? && (@translation_exists_for[term.id] == 0) %>
	  <span class="badge text-bg-danger"><%= t("misc.translation_needed") %></span>
	<% end %>
      </li>
  <% end %>
</ul>

<p><br/><strong><%= t('term.other_formats') %>:</strong> <%= link_to "N-Triples", request.original_url.split('?').first + '.nt'  %>, <%= link_to "JSON-LD", request.original_url.split('?').first + '.jsonld' %>, <%= link_to "TTL", request.original_url.split('?').first + '.ttl' %>, <%= link_to t("download.csv_tabs"), request.original_url.split('?').first + '.csv' %>, <%= link_to "XML", request.original_url.split('?').first + '.xml' %>
<p><br/><strong><%= t('term.other_formats_legacy') %>:</strong> <%= link_to "N-Triples", request.original_url.split('?').first + '.ntV2'  %>, <%= link_to "JSON-LD", request.original_url.split('?').first + '.jsonldV2' %>, <%= link_to "TTL", request.original_url.split('?').first + '.ttlV2' %>


