<% required = true if required.nil? %>

<%= f.label label_val, required: required %>
<%=
    if local_assigns[:include_help]
      help_label = local_assigns[:help_label] || label_val
      render partial: "partials/help_icon", locals: { help_label: help_label, help_content: local_assigns[:include_help] }
  end
%>
